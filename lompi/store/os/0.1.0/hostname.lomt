// os/hostname.lomt — 主机名: 读、写、校验、拼 FQDN
//
// 为什么需要它: 日志的一行、证书的 CN、临时文件名的一部分, 都要"这台机器叫什么"。
// 读它是 `uname` 的第 2 个字段（nodename）; 写它是单独的 `sethostname`; 而**写之前
// 校验**是这一层真正的价值 —— 一个带下划线或末尾连字符的名字会被 DNS / TLS 拒绝,
// 而内核**不会**替你检查（它只限长度）。
//
// 校验规则（RFC 1123 的 hostname 子集, 加 253 字节总长上限）:
//   * 字符只有 A-Z a-z 0-9 与 `-`, 标签之间用 `.`;
//   * 每个标签 1..63 字符, **不以 `-` 开头或结尾**;
//   * 总长 1..253。
//   注意: 主机名（hostname）允许的字符比**域名**更窄; 下划线在这里是**不合法**的,
//   尽管很多内网机器用了它 —— 那是错误配置, 这里不跟着放宽。
//
// 边界: 号是 x86-64 Linux 的。`hn_set` 收 C 串（内核要的就是这个）; 其余函数收 str。
// 自检只验纯逻辑（校验与拼接）, 系统调用那一半由 `tools/loment_os_test.py` 判。
//
// 命名: 公开 hn_*, 内部 hnq_*。自检 test_hostname_*。

module hostname

const HNQ_SYS_UNAME: u64 = 63;
const HNQ_SYS_SETHOSTNAME: u64 = 170;
const HNQ_UTS_LEN: u32 = 65;
const HNQ_UTS_NODENAME: u32 = 1;

fn hnq_put(out: ptr, cap: u32, pos: u32, s: str) -> u32 {
    let p: u32 = pos;
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        if p < cap {
            store8(out, p, str_byte(s, i) as u8);
        }
        p = p + 1;
        i = i + 1;
    }
    return p;
}

/// 读主机名写进 buf（str 形式，不带结尾 NUL），返回长度；失败返回 0。
/// 成功时空串也是可能的？不会 —— 内核保证非空, 但这里不替它断言。
pub fn hn_get(buf: ptr, cap: u32) -> u32 {
    let u: ptr = alloc(390);
    let r: i64 = syscall4(HNQ_SYS_UNAME, u as u64, 0, 0);
    if r != 0 {
        return 0;
    }
    let off: u32 = HNQ_UTS_NODENAME * HNQ_UTS_LEN;
    let n: u32 = 0;
    while n < HNQ_UTS_LEN && load8(u, off + n) != 0 {
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n {
        if i < cap {
            store8(buf, i, load8(u, off + i) as u8);
        }
        i = i + 1;
    }
    return n;
}

/// 设置主机名。`name` 是 C 串（NUL 结尾），`len` 是**不含 NUL** 的字节数。
/// 成功返回 0。需要 CAP_SYS_ADMIN —— 普通用户会拿到 -1（EPERM）。
pub fn hn_set(name: ptr, len: u32) -> i64 {
    return syscall4(HNQ_SYS_SETHOSTNAME, name as u64, len as u64, 0);
}

/// 名字是否是一个合法主机名（规则见文件头）。
pub fn hn_validate(name: str) -> bool {
    let n: u32 = str_len(name);
    if n == 0 || n > 253 {
        return false;
    }
    let i: u32 = 0;
    let label: u32 = 0;
    let prev_dash: u32 = 0;
    let ok: u32 = 1;
    while i < n {
        let c: u32 = str_byte(name, i) as u32;
        if c == 46 {
            if label == 0 || prev_dash == 1 {
                ok = 0;
            }
            label = 0;
            prev_dash = 0;
        } else {
            if c == 45 {
                if label == 0 {
                    ok = 0;
                }
                prev_dash = 1;
            } else if (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || (c >= 48 && c <= 57) {
                prev_dash = 0;
            } else {
                ok = 0;
            }
            label = label + 1;
            if label > 63 {
                ok = 0;
            }
        }
        i = i + 1;
    }
    if label == 0 || prev_dash == 1 {
        ok = 0;
    }
    return ok == 1;
}

/// 拼 FQDN: `host` + "." + `domain`。`domain` 为空时只拷 `host`
/// （这是"本机没有域名"的常见情况，不要拼出一个尾点）。
pub fn hn_fqdn_join(host: str, domain: str, out: ptr, cap: u32) -> u32 {
    let pos: u32 = hnq_put(out, cap, 0, host);
    if str_len(domain) == 0 {
        return pos;
    }
    pos = hnq_put(out, cap, pos, ".");
    return hnq_put(out, cap, pos, domain);
}

/// 第一个标签（短名）—— 日志里通常要这个，它才是机器自己的名字。
pub fn hn_short(name: str, out: ptr, cap: u32) -> u32 {
    let n: u32 = str_len(name);
    let i: u32 = 0;
    while i < n && str_byte(name, i) != 46 {
        i = i + 1;
    }
    let k: u32 = 0;
    while k < i {
        if k < cap {
            store8(out, k, str_byte(name, k) as u8);
        }
        k = k + 1;
    }
    return i;
}

// ---------------------------------------------------------------- 自检

fn test_hostname_validate() -> bool {
    return hn_validate("box1") && hn_validate("box-1.example.com")
        && hn_validate("a.b.c") && hn_validate("x")
        && !hn_validate("") && !hn_validate("-box") && !hn_validate("box-")
        && !hn_validate("a..b") && !hn_validate("my_box") && !hn_validate("a b");
}

fn test_hostname_label_length() -> bool {
    let t: ptr = alloc(80);
    let ok63: bool = hn_validate(
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    let bad64: bool = hn_validate(
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    return ok63 && !bad64 && hn_short("alpha.beta", t, 80) == 5
        && load8(t, 4) == 97;
}

fn test_hostname_fqdn() -> bool {
    let o: ptr = alloc(64);
    let n: u32 = hn_fqdn_join("box1", "example.com", o, 64);
    let a: u32 = load8(o, 4) as u32;
    let b: u32 = hn_fqdn_join("box1", "", o, 64);
    return n == 16 && a == 46 && b == 4;
}
