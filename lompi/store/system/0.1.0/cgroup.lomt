// system/cgroup.lomt — cgroup v2 的控制文件与它们的文本值
//
// 为什么系统工具需要它: cgroup v2 的**全部**控制面就是一组普通文本文件
// (`cpu.max`、`memory.max`、`pids.max` …)，没有 ioctl。所以"给容器限 2 核 /
// 限 512 MiB"在代码里最后都变成"往哪个文件写什么字符串"和"从哪个文件读出
// 什么数字"。这两件事都容易写错，而且**写错了不报错**：`max` 当数字解析会得到
// 0（等于禁掉），配额与周期两个字段调换会让限速差三个数量级。
//
// 覆盖:
//   * 控制器文件名的表（下标是稳定的，别按名字 hash）;
//   * `cg_parse_u64` —— ASCII 十进制，带**溢出**保护（返回 0 表示不是合法数字）;
//   * `cg_parse_max` —— 字面量 `max` 的内核语义是"无限制"，这里落成 U64_MAX;
//   * `cg_parse_cpu_max` —— `"<quota> <period>"` 两字段，quota 可以是 `max`;
//   * `cg_key_match` —— `key value` 行的键匹配（`cpu.max` 里那一行）。
//
// 不做: 挂载 cgroup 文件系统、创建/移动 cgroup（那是 syscall 与路径拼接）、
// 控制器是否启用（读 `cgroup.controllers` 是调用方的事）。
//
// 命名: 公开 cg_*, 内部 cqq_*。自检 test_cgroup_*。

module cgroup

/// `cgroup.procs` —— 这个 cgroup 里的进程号，一行一个。
pub const CG_PROCS: u32 = 0;
/// `cgroup.threads` —— 线程号（`cgroup.type` 为 threaded 时才分开）。
pub const CG_THREADS: u32 = 1;
/// `cpu.max` —— `"<quota> <period>"`，单位微秒。
pub const CG_CPU_MAX: u32 = 2;
/// `cpu.weight` —— 1..10000，默认 100。
pub const CG_CPU_WEIGHT: u32 = 3;
/// `memory.max` —— 硬上限，字节；`max` 表示不限制。
pub const CG_MEMORY_MAX: u32 = 4;
/// `memory.high` —— 软上限，超过会被限速而不是 OOM。
pub const CG_MEMORY_HIGH: u32 = 5;
/// `memory.current` —— 当前用量（只读）。
pub const CG_MEMORY_CURRENT: u32 = 6;
/// `memory.swap.max` —— swap 上限。
pub const CG_MEMORY_SWAP_MAX: u32 = 7;
/// `io.max` —— `"MAJ:MIN rbps=… wbps=…"` 的定宽行。
pub const CG_IO_MAX: u32 = 8;
/// `pids.max` —— 进程数上限；`max` 表示不限制。
pub const CG_PIDS_MAX: u32 = 9;
/// `cgroup.freeze` —— 写 1 冻结整个 cgroup（含后代）。
pub const CG_FREEZE: u32 = 10;
/// `cgroup.events` —— `populated 1` / `frozen 0` 两行。
pub const CG_EVENTS: u32 = 11;

/// 控制器文件名的条数。
pub fn cg_file_count() -> u32 {
    return 12;
}

fn cqq_put(out: ptr, cap: u32, pos: u32, s: str) -> u32 {
    let p: u32 = pos;
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        if p < cap {
            store8(out, p, str_byte(s, i) as u8);
        }
        p = p + 1;
        i = i + 1;
    }
    return p;
}

fn cqq_st64(out: ptr, v: u64) -> u32 {
    let b: u32 = 0;
    while b < 8 {
        store8(out, b, ((v >> ((8 * b) as u64)) & (255 as u64)) as u8);
        b = b + 1;
    }
    return 8;
}

fn cqq_ld64(p: ptr) -> u64 {
    let v: u64 = 0 as u64;
    let b: u32 = 0;
    while b < 8 {
        v = v | ((load8(p, b) as u64) << ((8 * b) as u64));
        b = b + 1;
    }
    return v;
}

fn cqq_lit(out: ptr, pos: u32, s: str) -> u32 {
    return cqq_put(out, 4096, pos, s);
}

/// 文件名表: 下标 -> 文本。越界返回 `""`。
pub fn cg_file_name(i: u32, out: ptr, cap: u32) -> u32 {
    if i == CG_PROCS { return cqq_put(out, cap, 0, "cgroup.procs"); }
    if i == CG_THREADS { return cqq_put(out, cap, 0, "cgroup.threads"); }
    if i == CG_CPU_MAX { return cqq_put(out, cap, 0, "cpu.max"); }
    if i == CG_CPU_WEIGHT { return cqq_put(out, cap, 0, "cpu.weight"); }
    if i == CG_MEMORY_MAX { return cqq_put(out, cap, 0, "memory.max"); }
    if i == CG_MEMORY_HIGH { return cqq_put(out, cap, 0, "memory.high"); }
    if i == CG_MEMORY_CURRENT { return cqq_put(out, cap, 0, "memory.current"); }
    if i == CG_MEMORY_SWAP_MAX { return cqq_put(out, cap, 0, "memory.swap.max"); }
    if i == CG_IO_MAX { return cqq_put(out, cap, 0, "io.max"); }
    if i == CG_PIDS_MAX { return cqq_put(out, cap, 0, "pids.max"); }
    if i == CG_FREEZE { return cqq_put(out, cap, 0, "cgroup.freeze"); }
    if i == CG_EVENTS { return cqq_put(out, cap, 0, "cgroup.events"); }
    return cqq_put(out, cap, 0, "");
}

fn cqq_is_max(p: ptr, n: u32) -> bool {
    if n != 3 {
        return false;
    }
    return load8(p, 0) == 109 && load8(p, 1) == 97 && load8(p, 2) == 120;
}

/// 内核里 `max` 那个字面量的数值哨兵（U64_MAX，按两段算避免超大字面量）。
fn cqq_umax() -> u64 {
    return (1844674407370955161 as u64) * (10 as u64) + (5 as u64);
}

fn cqq_val(p: ptr, n: u32, ok: ptr) -> u64 {
    if n == 0 {
        store8(ok, 0, 0 as u8);
        return 0 as u64;
    }
    let v: u64 = 0 as u64;
    let i: u32 = 0;
    store8(ok, 0, 1 as u8);
    while i < n {
        let b: u32 = load8(p, i) as u32;
        if b < 48 || b > 57 {
            store8(ok, 0, 0 as u8);
            return 0 as u64;
        }
        let d: u32 = b - 48;
        if v > (1844674407370955161 as u64) {
            store8(ok, 0, 0 as u8);
            return 0 as u64;
        }
        if v == (1844674407370955161 as u64) && d > 5 {
            store8(ok, 0, 0 as u8);
            return 0 as u64;
        }
        v = v * (10 as u64) + (d as u64);
        i = i + 1;
    }
    return v;
}

/// 解析一个 ASCII 无符号十进制（`memory.current` 那种）。返回吃掉的字节数；
/// 不是合法数字（含空串、溢出）返回 0，并且**不写** `out`。
pub fn cg_parse_u64(p: ptr, n: u32, out: ptr) -> u32 {
    let ok: ptr = alloc(1);
    let v: u64 = cqq_val(p, n, ok);
    if load8(ok, 0) == 0 {
        return 0;
    }
    cqq_st64(out, v);
    return n;
}

/// 解析 `max` 或十进制。`max` 落成 U64_MAX（调用方自己决定怎么显示）。
pub fn cg_parse_max(p: ptr, n: u32, out: ptr) -> u32 {
    if cqq_is_max(p, n) {
        cqq_st64(out, cqq_umax());
        return n;
    }
    return cg_parse_u64(p, n, out);
}

/// 解析 `cpu.max` 的 `"<quota> <period>"`。quota 可以是 `max`。
/// 成功返回 1，格式不对返回 0（两个输出都不写）。
pub fn cg_parse_cpu_max(p: ptr, n: u32, quota: ptr, period: ptr) -> u32 {
    let sp: u32 = n;
    let i: u32 = 0;
    while i < n {
        if sp == n && load8(p, i) == 32 {
            sp = i;
        }
        i = i + 1;
    }
    if sp == n || sp == 0 || sp + 1 >= n {
        return 0;
    }
    let ok1: ptr = alloc(1);
    let ok2: ptr = alloc(1);
    let q: u64 = 0 as u64;
    if cqq_is_max(p, sp) {
        q = cqq_umax();
        store8(ok1, 0, 1 as u8);
    } else {
        q = cqq_val(p, sp, ok1);
    }
    let pl: u32 = n - sp - 1;
    let pd: u64 = cqq_val(ptr_add(p, sp + 1), pl, ok2);
    if load8(ok1, 0) == 0 || load8(ok2, 0) == 0 || pd == (0 as u64) {
        return 0;
    }
    cqq_st64(quota, q);
    cqq_st64(period, pd);
    return 1;
}

/// `key value` 行里键是不是 `key`（允许行尾直接结束，也允许后面跟一个空格）。
pub fn cg_key_match(p: ptr, n: u32, key: str) -> bool {
    let kl: u32 = str_len(key);
    if n < kl {
        return false;
    }
    let i: u32 = 0;
    while i < kl {
        if load8(p, i) != str_byte(key, i) {
            return false;
        }
        i = i + 1;
    }
    if n == kl {
        return true;
    }
    return load8(p, kl) == 32;
}

fn cqq_u64(out: ptr, cap: u32, pos0: u32, v0: u64) -> u32 {
    let tmp: ptr = alloc(24);
    let v: u64 = v0;
    let n: u32 = 0;
    if v == (0 as u64) {
        store8(tmp, 0, 48 as u8);
        n = 1;
    }
    while v > (0 as u64) {
        let d: u32 = (v % (10 as u64)) as u32;
        store8(tmp, n, (48 + d) as u8);
        n = n + 1;
        v = v / (10 as u64);
    }
    let pos: u32 = pos0;
    let i: u32 = 0;
    while i < n {
        if pos < cap {
            store8(out, pos, load8(tmp, n - 1 - i) as u8);
        }
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

/// 字节数 -> `"512M"` 这种文本（K/M/G 二进制档）。小于 1K 落到字节。
pub fn cg_mem_text(bytes: u64, out: ptr, cap: u32) -> u32 {
    let pos: u32 = 0;
    if bytes >= (1073741824 as u64) {
        pos = cqq_u64(out, cap, pos, bytes / (1073741824 as u64));
        pos = cqq_put(out, cap, pos, "G");
        return pos;
    }
    if bytes >= (1048576 as u64) {
        pos = cqq_u64(out, cap, pos, bytes / (1048576 as u64));
        pos = cqq_put(out, cap, pos, "M");
        return pos;
    }
    if bytes >= (1024 as u64) {
        pos = cqq_u64(out, cap, pos, bytes / (1024 as u64));
        pos = cqq_put(out, cap, pos, "K");
        return pos;
    }
    return cqq_u64(out, cap, pos, bytes);
}

// ---------------------------------------------------------------- 自检

fn test_cgroup_file_names() -> bool {
    let b: ptr = alloc(64);
    let n: u32 = cg_file_name(CG_CPU_MAX, b, 64);
    let w: str = "cpu.max";
    if n != str_len(w) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(b, i) != str_byte(w, i) {
            return false;
        }
        i = i + 1;
    }
    return cg_file_count() == 12;
}

fn test_cgroup_parse_u64() -> bool {
    let b: ptr = alloc(32);
    let o: ptr = alloc(8);
    cqq_lit(b, 0, "8388608");
    if cg_parse_u64(b, 7, o) != 7 {
        return false;
    }
    return cqq_ld64(o) == (8388608 as u64);
}

fn test_cgroup_parse_rejects_overflow_and_junk() -> bool {
    let b: ptr = alloc(32);
    let o: ptr = alloc(8);
    cqq_lit(b, 0, "99999999999999999999999");
    if cg_parse_u64(b, 23, o) != 0 {
        return false;
    }
    cqq_lit(b, 0, "12a");
    if cg_parse_u64(b, 3, o) != 0 {
        return false;
    }
    return cg_parse_u64(b, 0, o) == 0;
}

fn test_cgroup_cpu_max() -> bool {
    let b: ptr = alloc(32);
    let q: ptr = alloc(8);
    let p: ptr = alloc(8);
    cqq_lit(b, 0, "20000 100000");
    if cg_parse_cpu_max(b, 12, q, p) != 1 {
        return false;
    }
    if cqq_ld64(q) != (20000 as u64) || cqq_ld64(p) != (100000 as u64) {
        return false;
    }
    cqq_lit(b, 0, "max 100000");
    if cg_parse_cpu_max(b, 10, q, p) != 1 {
        return false;
    }
    return cqq_ld64(q) == cqq_umax() && cqq_ld64(p) == (100000 as u64);
}

fn test_cgroup_key_match_and_mem_text() -> bool {
    let b: ptr = alloc(32);
    cqq_lit(b, 0, "populated 1");
    if cg_key_match(b, 11, "populated") == false {
        return false;
    }
    if cg_key_match(b, 3, "pop") == true {
        return false;
    }
    let o: ptr = alloc(32);
    let n: u32 = cg_mem_text(536870912 as u64, o, 32);
    let w: str = "512M";
    if n != str_len(w) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(o, i) != str_byte(w, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
