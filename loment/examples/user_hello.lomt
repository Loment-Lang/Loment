module user_hello

// M67: 第一个 Loment 用户程序 —— 在 FujoOS 用户态跑起来, 经 Linux ABI 打印。
// 编译 (docs/149):
//   python tools/lomentc.py loment/examples/user_hello.lomt \
//          --emit-llvm loment/build/user_hello.ll \
//          --emit-potato loment/build/user_hello.potato.json
//   clang --target=x86_64-unknown-linux-gnu -nostdlib -static -fno-pie -no-pie \
//         -fuse-ld=lld -Wl,-e,_start loment/build/user_hello.ll \
//         -o loment/build/user_hello.elf

// 一个**用户函数**调用：DAP 的 `next`/`stepIn` 判据要靠它区分"跨过"与"钻进去"
// （`print` 是内建、直接内联，没有函数体可钻）。
fn write_line(s: str) {
    print(s);
}

fn _start() {
    write_line("M67 RESULT: PASS loment-user\n");
    syscall4(60, 0, 0, 0);
}
