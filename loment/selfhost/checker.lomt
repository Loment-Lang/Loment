module checker
choose runtime

// M81 (子集): Loment 版类型/符号检查 —— 消费 M79 token 流, 判定程序是否合法。
// 覆盖规则 (与 Python 版 lomentc.check 的判定对照):
//   E-DUP-NAME    : 顶层名字重复 (fn/struct/enum/const) + 字段/变体/形参重名
//   E-UTYPE       : 类型位置上的**未知名** (参数/返回/字段/变体载荷/数组元素/let) —— E030
//   E-UNKNOWN-FN  : 调用未声明的函数
//   E-ARITY       : 实参个数与声明/内建签名不符
//   E-DEF         : 类型名为基类型 / 结构体或枚举为空
//   E-CAP         : 能力重复声明 / 域 lo>hi / 占用 excluded 空间 / guard 未声明或越界
//   E-CONST-TYPE  : 常量类型不是整型
// 批次 1 = **声明级**规则 (只吃 token 流, 不需要表达式类型推断);
// 表达式类型那一批 (E001 的各种"两侧类型对不上") 还没搬过来 —— 见 docs/150 缺口表。
// 输出: 每条错误 8 字节 (code u32 | tok u32); 返回错误条数。
use bytes
use lexer
use switches

// ---------------------------------------------------------------- 渠道（`docs/231` §2.2）
//
// 这份工具链是**发行版**还是**开发版**。**打包期由 `loment_dist.py` 替换下面这一行**，
// 参考实现侧那份是 `tools/loment_channel.py`（`RELEASE = False`），两边由判据钉住同值。
//
// **为什么是一个常量、而不是新开一个模块**：新开模块会把一条空单元塞进语料，而
// "空单元的 IR 收尾"这件事两个实现本来就**不一致**（参考实现末尾有一次 `rstrip()`，
// 自举侧没有）—— 于是新模块会**引出一个与渠道无关的红**。常量放这里，注入面同样是
// **一行**，"包里除这一行之外逐字节等于仓库"这条判据一样精确（`docs/231` §5 判据 F）。
//
// **它是临时的**：`vm` 一兑现（第一个可用的 LVM 诞生），这一档就该在发行版里放开 ——
// 届时这套闸要么拆掉、要么留给下一个还没兑现的维（`docs/231` §6 第 2 条）。
//
//: 0 = 开发版（默认）；1 = 发行版。**打包期由 `loment_dist.py` 替换这一行。**
//
//: **`pub` 是因为渠道闸现在有两处**（2026-10-12）：`vm` 那条在本文件（`check()` 读它），
//: `libl` 那条在**名字解析**处（`driver.lomt` 的 `use <名字>` 分支），那在另一个模块里 ——
//: 它 `use checker`，要读得到这条常量就得是 `pub`。
//: **"一行常量"这条形状没变**：打包仍只替换这一行的文本（`tools/loment_seed.py` 的
//: `CHANNEL_LINE_DEV`/`CHANNEL_LINE_RELEASE` 跟着这一行走），判据 F 照旧成立。
pub const LOMENT_CHANNEL: u32 = 0;

const K_FN: u32 = 1;
const K_STRUCT: u32 = 2;
const K_ENUM: u32 = 3;
const K_CONST: u32 = 4;
const K_TPARAM: u32 = 5;   // 泛型形参 (`fn f<T>` 里的 T): 只当类型名用
const K_METHOD: u32 = 6;   // impl 方法: 名字与接收者类型一起构成身份 (静态派发)

// 错误码 = 项目统一口径 `loment_diag.RULES` (E001–E017) 的**数字部分**。
// 自举 checker 与参考实现的对照判据 = 两边**码集相等**, 所以码值必须取自同一张表 ——
// 以前这里自定义 1..4, 与 loment_diag 的分类对不上 (E_DUP=1 vs E013=13 之类)。
const E_DUP: u32 = 13;     // E013 重名
const E_TYPE: u32 = 2;     // E002 符号未声明 (变量 / 函数)
// E030 **类型位置上的未知名**（`#323`）。与 E_TYPE 分开的理由与参考实现同一条
// （`lomentc._no_such_type`）：E002 的修法是"声明那个名字"，这一条的修法是"这门语言
// 没有这个类型"—— 最常撞的是 `f64`，而 Loment 没有浮点。
const E_UTYPE: u32 = 30;
const E_FN: u32 = 2;
const E_ARITY: u32 = 3;    // E003 实参数量不符
const E_CAP: u32 = 4;      // E004 能力域非法
const E_DEF: u32 = 9;      // E009 类型名非法 (与基类型同名 / 类型为空)
const E_TMISMATCH: u32 = 1;  // E001 类型不匹配 (常量"类型必须是整型"也归这一码)
const E_LVAL: u32 = 14;    // E014 赋值目标不是左值
const E_ACCESS: u32 = 15;  // E015 字段/下标/取址目标非法
const E_ARR: u32 = 16;     // E016 数组字面量非法 (长度/元素类型)
const E_AS: u32 = 17;      // E017 `as` 转换非法
const E_SLICE: u32 = 11;   // E011 只读切片不能写 / 形参要求可变切片
const E_PATTERN: u32 = 8;  // E008 match/变体用法非法
const E_BORROW: u32 = 7;   // E007 借用冲突 (同一变量既借又可变借 / 可变借两次)
const E_Q: u32 = 10;       // E010 `?` 误用
const E_MOVE: u32 = 6;     // E006 移动后使用
const E_DANGLE: u32 = 12;  // E012 悬垂借用 (返回局部变量的借用)
const E_MODE: u32 = 22;    // E022 项目模式 `choose` 用法不对 (docs/143 §3.2)
const E_RT: u32 = 31;      // E031 这一档是 `no_runtime`，而这个构造要运行期 (issue #321)
const E_PARSE: u32 = 19;   // E019 期望表达式 —— 参考实现 `parse_primary` 的口径 (issue #49)
const E_DEEP: u32 = 23;    // E023 源码太深 —— 嵌套超过 64 层 (issue #44)

/// 拖运行期的构造**有几个** —— 检查器数好放这儿，驱动取来拼报文的"另有 N 处"那半句
/// （与参考实现 `_runtime_sites` 的 `len(_sites) - 1` 同口径）。见 issue #321。
/// 槽位在 tyt 块的**最后一个 16 字节**里：`[4096..4100)` 是诊断偏移格（`chk_pub` 专用），
/// `[4100..4112)` 空着 —— `chk_arena_tyt() = 95856`、下一块 99968，合计 4112 字节。
pub const RT_N_SITES: u32 = 4100;
// E005 = 使用了 excluded 的空间。**与 E_CAP(4) 分开**：参考实现的 `loment_diag` 按消息
// 分码 —— "能力…域/重复" 归 E004、"使用了 excluded 的空间" 归 E005。原先那两条分支
// 都发 E_CAP，而参考侧同一条消息归类成 5，码集对不上（`loment_rule_parity` 里没有探针，
// 所以一直没露头）。2026-10-11 加"行为轴"那一条时一并分开。
const E_EXCL: u32 = 5;
// E028 = **LMS 第 1 级检查器**（`docs/253` §5.1）：`lms` 开着时，**字面量下标越过定长
// 数组的界**是编译期的一个诊断，不是运行期的一种可能。
// ⚠ 码值取自 `loment_diag.RULES` 的数字部分（与上面那批同一条纪律），现行最高是 E027
// ⇒ 这条是 **28**。**码号比行号硬**：`docs/253` 初稿按旧检出写的 E024–E026 全被占了。
const E_BOUND: u32 = 28;
// E029 = **LMS 第 1 级检查器**（`docs/253` §5.1）：**用完再放**（use-after-free）——
// `free(p)` 之后再用 `p`。与 E006（已被移动）**分开**：移走是所有权的事，释放是合法性的事。
const E_BOUND_FREE: u32 = 29;

// 类型编码 (批次 2): 一个 u32 —— 0 = 未知, 其它按 (kind << TY_KIND_SHIFT) + payload。
//   kind 1 = 基类型 (payload = 1..11 的内码)
//   kind 2 = 具名类型 (payload = 名字 token 下标)
// 为什么用 token 下标而不是字符串: 声明处的类型与推断出来的类型**都是同一份源码里的
// 同一个 token**, 所以"相等"退化成"同一个 token"或"同一段 token 文本" —— 不需要造
// 字符串缓冲, 也不会踩到规范化(空格/分号后空格)的两套写法。
// 复合类型 (数组/切片/泛型实例) 一律记 0 = 未知: 保守方向**只可能少报**, 不会假阳性,
// 而假阳性会被语料测试 (40/40 零诊断) 立刻抓住。
const TY_KIND_SHIFT: u32 = 28;
const TY_K_NAMED: u32 = 2;
const TY_BOOL: u32 = 268435465;   // (1 << 28) + 9
const TY_U32: u32 = 268435459;    // (1 << 28) + 3
const K_INT_MIN: u32 = 1;   // 内码 1..8 = u8..i64
const K_INT_MAX: u32 = 8;

/// 基类型名 -> 内码 (非基类型 -> 0)。
fn chk_base_code(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "u8") {
        return 1;
    }
    if chk_tok_is(src, t, i, "u16") {
        return 2;
    }
    if chk_tok_is(src, t, i, "u32") {
        return 3;
    }
    if chk_tok_is(src, t, i, "u64") {
        return 4;
    }
    if chk_tok_is(src, t, i, "i8") {
        return 5;
    }
    if chk_tok_is(src, t, i, "i16") {
        return 6;
    }
    if chk_tok_is(src, t, i, "i32") {
        return 7;
    }
    if chk_tok_is(src, t, i, "i64") {
        return 8;
    }
    if chk_tok_is(src, t, i, "bool") {
        return 9;
    }
    if chk_tok_is(src, t, i, "str") {
        return 10;
    }
    if chk_tok_is(src, t, i, "ptr") {
        return 11;
    }
    return 0;
}

/// 类型位置的首 token -> 类型编码 (见 TY_* 说明)。
///
/// 两个"不建模"的出口, 都是为了**不假阳性**:
///   - `Name<...>` (泛型实例): 类型是复合的, 而且参考实现跑在**单态化之后**的模块上
///     (`mod.funcs` 里的泛型已被实例替换、调用点的名字也改写了), 所以它的类型串里
///     不会出现 `T`。token 版够不着单态化, 一律记未知。
///   - 类型形参 `T` (符号表里 K_TPARAM): 同一个 `T` 在不同函数里含义不同, 记未知。
fn chk_ty_of_tok(src: ptr, t: ptr, s: ptr, n: u32, i: u32) -> u32 {
    if chk_tok_kind(t, i) != 0 {
        return 0;
    }
    let b: u32 = chk_base_code(src, t, i);
    if b != 0 {
        return (1 << TY_KIND_SHIFT) + b;
    }
    if chk_tok_is(src, t, i + 1, "<") {
        return 0;
    }
    let slot: u32 = chk_lookup_slot(src, t, s, n, i);
    if slot == 0 {
        return (TY_K_NAMED << TY_KIND_SHIFT) + i;   // 未声明名字: 用 token 本身当身份
    }
    if load32(s, (slot - 1) * 20 + 4) == K_TPARAM {
        return 0;
    }
    return (TY_K_NAMED << TY_KIND_SHIFT) + (slot - 1);
}

fn chk_ty_is_int(v: u32) -> u32 {
    if v >> TY_KIND_SHIFT != 1 {
        return 0;
    }
    let c: u32 = v % (1 << TY_KIND_SHIFT);
    if c >= K_INT_MIN && c <= K_INT_MAX {
        return 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 复合类型表 (TY_ARRAY/TY_SLICE)
//
// 数组/切片没法内联进 u32 (要带元素类型与长度/可变性两个分量), 所以指向一张小表:
// 表头 4 字节是条数, 之后 8 字节一条 (分量 a, 分量 b)。表放在 arena 里 (见 chk_arena_tyt),
// 容量 128 条 —— 一轮表达式只造个位数的新类型, 够用。
//
// 为什么必须真建复合类型 (而不是继续用 0 = 未知): 参考实现在 `下标` 与 `&` 这两条上的
// 判定方向是"类型未知/不是数组也要报", 所以"未知 -> 跳过"的策略**必然少报**, 而照搬
// "未知就报"又会让任何我算不出类型的数组变成假阳性。见 docs/150 下一段那节。
const TY_ARRAY: u32 = 3;
const TY_SLICE: u32 = 4;

fn chk_ty_new(t: ptr, kind: u32, a: u32, b: u32) -> u32 {
    let n: u32 = load32(t, 0);
    store32(t, 4 + n * 8, a);
    store32(t, 4 + n * 8 + 4, b);
    store32(t, 0, n + 1);
    return (kind << TY_KIND_SHIFT) + n;
}

fn chk_ty_arr(t: ptr, elem: u32, len: u32) -> u32 {
    return chk_ty_new(t, TY_ARRAY, elem, len);
}

fn chk_ty_slc(t: ptr, elem: u32, mut: u32) -> u32 {
    return chk_ty_new(t, TY_SLICE, elem, mut);
}

fn chk_ty_kind(v: u32) -> u32 {
    return v >> TY_KIND_SHIFT;
}

fn chk_ty_a(t: ptr, v: u32) -> u32 {
    return load32(t, 4 + (v % (1 << TY_KIND_SHIFT)) * 8);
}

fn chk_ty_b(t: ptr, v: u32) -> u32 {
    return load32(t, 4 + (v % (1 << TY_KIND_SHIFT)) * 8 + 4);
}

fn chk_ty_is_arr(t: ptr, v: u32) -> u32 {
    if v != 0 && chk_ty_kind(v) == TY_ARRAY {
        return 1;
    }
    return 0;
}

fn chk_ty_is_slc(t: ptr, v: u32) -> u32 {
    if v != 0 && chk_ty_kind(v) == TY_SLICE {
        return 1;
    }
    return 0;
}

/// 结构相等 (两个都是非 0 时才有意义; 参考实现比的是类型串, 这里是结构)。
fn chk_ty_eq(t: ptr, a: u32, b: u32) -> u32 {
    if a == b {
        return 1;
    }
    if a == 0 || b == 0 {
        return 0;
    }
    if chk_ty_kind(a) != chk_ty_kind(b) {
        return 0;
    }
    let k: u32 = chk_ty_kind(a);
    if k == TY_ARRAY || k == TY_SLICE {
        // bool 不能参与算术 (`x * (a == b)` 会被 clang 拒: i32 * i1), 所以拆成 if
        if chk_ty_b(t, a) != chk_ty_b(t, b) {
            return 0;
        }
        return chk_ty_eq(t, chk_ty_a(t, a), chk_ty_a(t, b));
    }
    return 0;   // 基类型/具名类型的编码本身就是身份, 到不了这里
}

/// 从**类型 token 区间**建类型 (声明处/`as` 目标/字段/形参都用它)。
///   `[T; N]` -> 数组(T, N)   `[T]` -> 切片(T, 只读)   `mut [T]` -> 切片(T, 可变)
///   `Name<...>` -> 0 (泛型实例, 见 chk_ty_of_tok 的说明)   单 token -> 基类型/具名
fn chk_ty_range(src: ptr, t: ptr, s: ptr, n: u32, tyt: ptr, lo: u32, hi: u32) -> u32 {
    if lo >= hi {
        return 0;
    }
    let mut: u32 = 0;
    let i: u32 = lo;
    if chk_tok_is(src, t, i, "mut") {
        mut = 1;
        i = i + 1;
    }
    if chk_tok_is(src, t, i, "[") {
        let close: u32 = chk_match_bracket(src, t, i);
        if close >= hi {
            return 0;
        }
        let sep: u32 = chk_find_at(src, t, i + 1, close, ";");
        if sep < close {
            let e: u32 = chk_ty_range(src, t, s, n, tyt, i + 1, sep);
            if e == 0 {
                return 0;
            }
            return chk_ty_arr(tyt, e, chk_dec(src, t, sep + 1));
        }
        let e2: u32 = chk_ty_range(src, t, s, n, tyt, i + 1, close);
        if e2 == 0 {
            return 0;
        }
        return chk_ty_slc(tyt, e2, mut);
    }
    if mut == 1 {
        return 0;   // `mut X` 且 X 不是切片: 形状非法, 记未知
    }
    return chk_ty_of_tok(src, t, s, n, i);
}

/// 类型区间 -> 该类型是不是"整型" (for 边界/`as` 用)。
fn chk_ty_range_is_int(src: ptr, t: ptr, s: ptr, n: u32, tyt: ptr, lo: u32, hi: u32) -> u32 {
    return chk_ty_is_int(chk_ty_range(src, t, s, n, tyt, lo, hi));
}

/// 内建函数的返回类型编码 (镜像 lomentc.BUILTINS 的第二项); 非内建 -> 0。
/// 表写错 = 语料上立刻出假阳性 (这是拿语料测试当护栏的地方之一)。
fn chk_builtin_ret(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "str_eq") {
        return (1 << TY_KIND_SHIFT) + 9;          // bool
    }
    if chk_tok_is(src, t, i, "str_concat") {
        return (1 << TY_KIND_SHIFT) + 10;         // str
    }
    if chk_tok_is(src, t, i, "alloc") || chk_tok_is(src, t, i, "str_ptr")
            || chk_tok_is(src, t, i, "ptr_add") || chk_tok_is(src, t, i, "ptr_sub") {
        return (1 << TY_KIND_SHIFT) + 11;         // ptr
    }
    if chk_tok_is(src, t, i, "get_bits") || chk_tok_is(src, t, i, "set_bits") {
        return (1 << TY_KIND_SHIFT) + 1;          // u8
    }
    if chk_tok_is(src, t, i, "syscall4") || chk_tok_is(src, t, i, "syscall6")
        || chk_tok_is(src, t, i, "syscall7") || chk_tok_is(src, t, i, "thread_spawn") {
        return (1 << TY_KIND_SHIFT) + 8;          // i64
    }
    // 其余内建 (str_len/str_byte/panic/free/load8/store8/atomic_add/inb/outb/slice_len)
    // 参考实现里都返回 u32; 非内建返回 0。
    if chk_builtin_arity(src, t, i) != 999999 {
        return (1 << TY_KIND_SHIFT) + 3;
    }
    return 0;
}

// 符号表条目 (20 字节): 名字 tok | kind | 参数个数 | 返回类型编码 | aux
//   aux 的语义按 kind: 函数 -> 形参表的 '(' ; struct/enum -> 声明体的 '{' ; 其余 0。
// 为什么要 aux: 字段类型、形参类型这些**都不建表**, 改成"按需重扫" —— 一张
// "每函数 10 个形参类型"的二维表要 40B x 函数数 (语料 200+ 个函数 = 8 KiB 以上),
// 而 checker 的 arena 只有 ~14 KiB。存一个下标再扫一遍, 空间是 O(1), 时间只在
// 调用点/字段访问点付。这也是本文件里 `chk_enum_body`/`chk_struct_body` 一贯的做法。
// stride 从 16 改成 20 时**所有字段偏移都要一起改** —— 漏一处就会读到相邻条目的字节,
// 症状是"码偶尔对偶尔错"(地址相关)。
fn sym_get(t: ptr, s: ptr, n: u32, i: u32) -> u32 {
    return load32(s, i * 20);
}

fn sym_pub(src: ptr, t: ptr, p: ptr, o: u32, code: u32, tok: u32) -> u32 {
    store32(p, o, code);
    store32(p, o + 4, tok);
    return o + 8;
}

fn chk_tok_kind(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20);
}

fn tok_start(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 4);
}

fn tok_len(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 8);
}

/// token 原文是否等于 s。
///
/// **字符串字面量不算** (kind 2 -> false): 字符串 token 的原文就是它**里面的内容**, 所以
/// `chk_tok_is(i, "fn")` 会匹配源码里的字符串 `"fn"`。本文件里到处都是这种字符串
/// (关键字表/内建名表), 因此不加这一条时, 检查自己或任何编译器的源码都会误触发关键字
/// 判断。codegen.lomt 的同名判断也补了同一守卫 (见那边 `tok_is` 的说明)。
fn chk_tok_is(src: ptr, t: ptr, i: u32, s: str) -> bool {
    if chk_tok_kind(t, i) == 2 {
        return false;
    }
    if tok_len(t, i) != str_len(s) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(s) {
        if load8(src, tok_start(t, i) + k) != str_byte(s, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// 语句起点的 token 能不能**开始一个表达式** —— 与参考实现 `parse_primary` / `parse_unary`
/// 的口径逐条对齐：kind 为 ident(0) / number(1) / string(2)，或 punct 为 `(` `[` `-` `!` `&`。
///
/// 为什么要这一条：`@` 在**词法上是合法 punct**（L0 的布局语法用它），但在 L1 里它哪一处都
/// 不是表达式。原先检查器走到"赋值或表达式语句"那支时对首 token 不作判断，于是 `@` 被
/// 静默咽掉 —— 编译通过、退出码 0、什么都不说（issue #49，实测 0.1.4.5 发布版同）。
/// 参考实现自 2026-09-09 起就报 E019，两侧因此一直分叉。
fn chk_expr_start(src: ptr, t: ptr, i: u32) -> bool {
    let k: u32 = chk_tok_kind(t, i);
    if k == 0 || k == 1 || k == 2 {
        return true;
    }
    if k != 3 {
        return false;
    }
    if chk_tok_is(src, t, i, "(") || chk_tok_is(src, t, i, "[") {
        return true;
    }
    if chk_tok_is(src, t, i, "-") || chk_tok_is(src, t, i, "!") {
        return true;
    }
    return chk_tok_is(src, t, i, "&");
}

/// 数值字面量后面**紧跟的原始字节**是不是构成了一个语言不支持的形式（issue #12）。
///
/// **判原始字节，不判 token 相邻** —— 按 token 相邻去认（"数字后面跟标识符"）会把
/// `48 as u32` 误判（`as` 是 ident token），实测全仓 **1843 处**误报；按原始字节判是
/// **0 处**。区别就在 `48 as` 的 `48` 后面是空格，而 `0b1010` 的 `0` 后面就是 `b`。
///
/// 认出三种：`0b…` / `0o…`（`0` 后面直接跟 `b`/`o`）、`1_000`（数字后面跟 `_`）、
/// `1.5`（数字后面跟 `.` + 数字 —— 点后面跟 `.` 的 `0..8` 范围不算）。
fn chk_bad_num_suffix(src: ptr, t: ptr, i: u32) -> bool {
    if chk_tok_kind(t, i) != 1 {
        return false;
    }
    let e: u32 = tok_start(t, i) + tok_len(t, i);
    let b: u32 = load8(src, e);
    if b == 95 {
        return true;
    }
    if tok_len(t, i) == 1 && load8(src, tok_start(t, i)) == 48 {
        if b == 98 || b == 66 || b == 111 || b == 79 {
            return true;
        }
    }
    if b == 46 {
        let c: u32 = load8(src, e + 1);
        if c >= 48 && c <= 57 {
            return true;
        }
    }
    return false;
}


/// 核心模式的取值属于**哪一维**（`docs/175` §3.0/§3.4）。
///   0 = `mode`（`std` / `no_std`）；1 = `gc`（`gc_manual` / `gc_auto`）；
///   2 = `runtime`（`runtime` / `no_runtime`）；3 = `port`（`sealed` / `hosted`）；
///   4 = **不是核心模式** —— 那是开关那一套（`docs/182` §1.3），这一层不管。
///
/// 与参考实现的 `CORE_DIM_OF` 是同一张表；加一维两边一起动。
fn chk_core_dim(src: ptr, t: ptr, k: u32) -> u32 {
    if chk_tok_is(src, t, k, "std") || chk_tok_is(src, t, k, "no_std") {
        return 0;
    }
    if chk_tok_is(src, t, k, "gc_manual") || chk_tok_is(src, t, k, "gc_auto")
            || chk_tok_is(src, t, k, "gc_auto_alpha") {
        return 1;
    }
    if chk_tok_is(src, t, k, "runtime") || chk_tok_is(src, t, k, "no_runtime") {
        return 2;
    }
    // 第四维（`docs/222` §4）：`port`。
    if chk_tok_is(src, t, k, "sealed") || chk_tok_is(src, t, k, "hosted") {
        return 3;
    }
    // 第五维（`docs/231`）：`vm`。取值**只说"有没有"**，与 `runtime` 同一条纪律。
    if chk_tok_is(src, t, k, "vm") || chk_tok_is(src, t, k, "no_vm") {
        return 4;
    }
    // 第六维（`docs/253`，用户 2026-10-15）：`lms`。与 `gc` **正交**。
    if chk_tok_is(src, t, k, "lms_close") || chk_tok_is(src, t, k, "lms_open") {
        return 5;
    }
    return 6;
}

/// token `i` 是不是**会把运行期拖进产物**的构造（`docs/217`）。1 = 是。
///
/// 表与参考实现的 `_RUNTIME_SITES` **同一条**：punct 的 `/` `%`，ident 的 `alloc` /
/// `free` / `str_concat` / `str_eq` / `panic` / `guard`。两边都长在 token 流上，
/// 所以能数的必须是同一个东西（`docs/210` §2.2 那条理由）。
///
/// kind 3 = punct（`codegen.runtime_needed` 判除法用的是同一个常量）。
/// `chk_tok_is` 自己跳过 kind 2（字符串），所以 `"/"` 不会撞上字符串里的斜杠。
fn chk_rt_site(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_kind(t, i) == 3 {
        if chk_tok_is(src, t, i, "/") || chk_tok_is(src, t, i, "%") {
            return 1;
        }
        return 0;
    }
    // **只有"用"才触发，名字本身不触发**（参考实现 `_runtime_sites` 同一条，理由见那里）：
    // `fn` 后面的名字是**声明**；五个内建要**紧跟 `(`**（调用）；`guard` 是**语句**，
    // 要**紧跟一个名字**（`guard c(0);`）。kind 0 = ident（`lexer.lomt:202`）。
    if i > 0 && chk_tok_is(src, t, i - 1, "fn") {
        return 0;
    }
    if chk_tok_is(src, t, i, "guard") {
        if chk_tok_kind(t, i + 1) == 0 {
            return 1;
        }
        return 0;
    }
    if chk_tok_is(src, t, i, "alloc") || chk_tok_is(src, t, i, "free")
            || chk_tok_is(src, t, i, "str_concat") || chk_tok_is(src, t, i, "str_eq")
            || chk_tok_is(src, t, i, "panic") {
        if chk_tok_is(src, t, i + 1, "(") {
            return 1;
        }
        return 0;
    }
    return 0;
}

/// 两维里**较后**出现的那个行号（0 = 那一维没写过）。报冲突时的锚点。
fn later_line(a: u32, b: u32) -> u32 {
    if a == 0 {
        return b;
    }
    if b == 0 {
        return a;
    }
    if a > b {
        return a;
    }
    return b;
}

/// 取值在**它那一维**里的序号（1 起）。0 = 不认识。
/// 只用来判"两档不能同时选"（`docs/175` §3.4 ⚠）—— 所以序号是**维内**编的。
fn chk_core_val(src: ptr, t: ptr, k: u32) -> u32 {
    if chk_tok_is(src, t, k, "std") {
        return 1;
    }
    if chk_tok_is(src, t, k, "no_std") {
        return 2;
    }
    if chk_tok_is(src, t, k, "gc_manual") {
        return 1;
    }
    if chk_tok_is(src, t, k, "gc_auto") {
        return 2;
    }
    if chk_tok_is(src, t, k, "gc_auto_alpha") {
        return 3;
    }
    if chk_tok_is(src, t, k, "runtime") {
        return 1;
    }
    if chk_tok_is(src, t, k, "no_runtime") {
        return 2;
    }
    if chk_tok_is(src, t, k, "sealed") {
        return 1;
    }
    if chk_tok_is(src, t, k, "hosted") {
        return 2;
    }
    if chk_tok_is(src, t, k, "vm") {
        return 1;
    }
    if chk_tok_is(src, t, k, "no_vm") {
        return 2;
    }
    // 第六维（`docs/253`）：`lms_close` / `lms_open`。
    if chk_tok_is(src, t, k, "lms_close") {
        return 1;
    }
    if chk_tok_is(src, t, k, "lms_open") {
        return 2;
    }
    return 0;
}

/// 名字 token 是否等于 s。
fn same(src: ptr, t: ptr, i: u32, j: u32) -> bool {
    if chk_tok_kind(t, i) != 0 || chk_tok_kind(t, j) != 0 {
        return false;
    }
    if tok_len(t, i) != tok_len(t, j) {
        return false;
    }
    let k: u32 = 0;
    while k < tok_len(t, i) {
        if load8(src, tok_start(t, i) + k) != load8(src, tok_start(t, j) + k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn is_base_type(src: ptr, t: ptr, i: u32) -> bool {
    if chk_tok_kind(t, i) != 0 {
        return false;
    }
    if chk_tok_is(src, t, i, "u8") || chk_tok_is(src, t, i, "u16") || chk_tok_is(src, t, i, "u32")
        || chk_tok_is(src, t, i, "u64") || chk_tok_is(src, t, i, "i8") || chk_tok_is(src, t, i, "i16")
        || chk_tok_is(src, t, i, "i32") || chk_tok_is(src, t, i, "i64") || chk_tok_is(src, t, i, "bool")
        || chk_tok_is(src, t, i, "str") || chk_tok_is(src, t, i, "ptr") {
        return true;
    }
    return false;
}

fn is_builtin(src: ptr, t: ptr, i: u32) -> bool {
    let k: u32 = 0;
    let names: str = "str_len str_eq str_concat str_byte slice_len panic alloc free load8 store8 atomic_add inb outb get_bits set_bits str_ptr ptr_add ptr_sub syscall4 syscall6 syscall7 thread_spawn";
    // 逐词比较 (内建名用空格分隔的常量表); 新增内建要同步这里, 否则调用点报假 E-UNKNOWN-FN
    let off: u32 = 0;
    while off < str_len(names) {
        let b: u32 = 0;
        let n: u32 = 0;
        while off + n < str_len(names) && str_byte(names, off + n) != 32 {
            n = n + 1;
        }
        if n > 0 && tok_len(t, i) == n {
            let j: u32 = 0;
            let ok: u32 = 1;
            while j < n {
                if load8(src, tok_start(t, i) + j) != str_byte(names, off + j) {
                    ok = 0;
                }
                j = j + 1;
            }
            if ok == 1 {
                return true;
            }
        }
        off = off + n + 1;
        k = k + 1;
    }
    return false;
}

/// 登记 impl 方法 (身份 = 接收者类型编码 + 名字); **不查重** —— 参考实现按
/// `Type_method` 命名, 不同接收者上的同名方法本来就该共存。
fn chk_decl_method(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32,
                   argc: u32, ret: u32, recv: u32) -> u32 {
    store32(s, n * 20, name_tok);
    store32(s, n * 20 + 4, K_METHOD);
    store32(s, n * 20 + 8, argc);
    store32(s, n * 20 + 12, ret);
    store32(s, n * 20 + 16, recv);
    return n + 1;
}

/// 顶层名字查表: 返回槽位+1 (0 = 未找到)。调用方按 stride 20 读各字段。
fn chk_lookup_slot(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        // 方法不参与普通名字查找: 参考实现把 impl 方法改名成 `Type_method` 放进函数表,
        // 所以裸 `measure(...)` 在那边也是"未定义的函数"。
        if load32(s, i * 20 + 4) != K_METHOD && same(src, t, sym_get(t, s, n, i), name_tok) {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 顶层名字查表, 但键是**字符串字面量的正文** (M84): `thread_spawn("worker", …)` 的入口
/// 写在字面量里, 不是名字 token —— 所以走不了 `chk_lookup_slot` 那条"两个 token 比正文"的路。
///
/// 字面量 token 的 `tok_start` 指着**开引号**、`tok_len` **含两侧引号** (lexer 里是
/// `emit(..., 2, s, i - s, ...)`, `i` 已经越过收尾引号), 所以正文是 `[start+1, start+len-1)`。
/// 返回槽位+1 (0 = 未找到)。
fn chk_lookup_lit_name(src: ptr, t: ptr, s: ptr, n: u32, lit_tok: u32) -> u32 {
    if chk_tok_kind(t, lit_tok) != 2 || tok_len(t, lit_tok) < 2 {
        return 0;
    }
    let lo: u32 = tok_start(t, lit_tok) + 1;
    let ln: u32 = tok_len(t, lit_tok) - 2;
    let i: u32 = 0;
    while i < n {
        let nt: u32 = sym_get(t, s, n, i);
        if load32(s, i * 20 + 4) != K_METHOD && tok_len(t, nt) == ln {
            let k: u32 = 0;
            let hit: u32 = 1;
            while k < ln && hit == 1 {
                if load8(src, lo + k) != load8(src, tok_start(t, nt) + k) {
                    hit = 0;
                }
                k = k + 1;
            }
            if hit == 1 {
                return i + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 登记顶层名字; 重复 -> 产出 E-DUP。aux 见 sym_get 的说明 (声明体的起止 token)。
///
/// `ka` = kind * 256 + 参数个数: 两个小字段**打包**进一个 u32, 因为自举 codegen 的形参
/// 上限是 10 (形参类型表步长 80 = 10 槽) —— 这里原来有 11 个形参, 一加 `aux` 就撞上限,
/// 自举驱动直接 `panic(10)` (测试 `test_m85_codegen_arg_arity_is_loud` 抓到的)。
fn declare(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32, ka: u32,
           ret: u32, aux: u32, p: ptr, o: u32) -> u64 {
    if chk_lookup_slot(src, t, s, n, name_tok) != 0 {
        return (n as u64) * 4294967296 + (sym_pub(src, t, p, o, E_DUP, name_tok) as u64);
    }
    store32(s, n * 20, name_tok);
    store32(s, n * 20 + 4, ka / 256);
    store32(s, n * 20 + 8, ka % 256);
    store32(s, n * 20 + 12, ret);
    store32(s, n * 20 + 16, aux);
    return ((n + 1) as u64) * 4294967296 + (o as u64);
}

/// 类型位置检查: 支持 [T]/[T; N]/mut [T] 或已声明名字; 未知名 -> E-UTYPE。
///
/// **`[` 要钻进去**（`#323`）：原先见到 `[` 就**直接返回**，于是 `[f64; 4]` 这类
/// **元素类型**从来没被检查过 —— 参考实现会报（`_type_ok` 对数组/切片是递归的），
/// 自举侧一条不报，也就是**静默放行**一个不存在的类型。
fn check_type(src: ptr, t: ptr, s: ptr, n: u32, i: u32, p: ptr, o: u32) -> u64 {
    if chk_tok_is(src, t, i, "mut") {
        return check_type(src, t, s, n, i + 1, p, o);
    }
    if chk_tok_is(src, t, i, "[") {
        // `[T]` 与 `[T; N]` 同形: `[` 后面第一个 token 就是元素类型, 长度在 `;` 之后。
        return check_type(src, t, s, n, i + 1, p, o);
    }
    if is_base_type(src, t, i) {
        return (i as u64) * 4294967296 + (o as u64);
    }
    if chk_tok_kind(t, i) == 0 {
        if chk_lookup_slot(src, t, s, n, i) != 0 {
            return (i as u64) * 4294967296 + (o as u64);
        }
    }
    return (i as u64) * 4294967296 + (sym_pub(src, t, p, o, E_UTYPE, i) as u64);
}

/// 从 i 起找下一个 '(' 的下标 (处理泛型 `<T>` 前缀)。
/// 注意前缀 `chk_`: 本编译器的符号表是**全单元扁平**的, `codegen.lomt` 里也有同名的
/// 私有函数 —— 同单元里两处定义会撞名 (函数撞名会连带撞字符串全局名, 直接是非法 IR)。
fn chk_find_paren(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "(") && !chk_tok_is(src, t, j, "{") {
        j = j + 1;
    }
    return j;
}

/// 跳过完整类型 (含 `[T]` / `[T; N]` / `mut [T]` / `Pair<u32>`), 返回类型之后的下标。
/// 泛型实参必须一起跳掉: 只吃下 `Pair` 的话, 后面的 `<` `u32` `>` 会被当成下一个形参,
/// 于是一串假 E-TYPE (codegen 的 `skip_type` 当初也是漏了 `<...>` 才踩同一个坑)。
/// 前缀 `chk_` 的理由同 `chk_find_paren` (扁平符号表)。
fn chk_skip_type(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    if chk_tok_is(src, t, j, "mut") {
        j = j + 1;
    }
    if chk_tok_is(src, t, j, "[") {
        j = j + 1;
        while !chk_tok_is(src, t, j, "]") && chk_tok_kind(t, j) != 4 {
            j = j + 1;
        }
        return j + 1;
    }
    j = j + 1;
    if chk_tok_is(src, t, j, "<") {
        while !chk_tok_is(src, t, j, ">") && chk_tok_kind(t, j) != 4 {
            j = j + 1;
        }
        j = j + 1;
    }
    return j;
}

/// `fn f<T, U>` / `struct S<T>` / `enum E<T>`: 把 `<...>` 里的名字登记成类型名,
/// 返回新的符号个数。**不能走 declare** —— 它会报 E-DUP, 而"两个声明各用 T"是合法的。
fn decl_tparams(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32) -> u32 {
    let j: u32 = name_tok + 1;
    if !chk_tok_is(src, t, j, "<") {
        return n;
    }
    let k: u32 = j + 1;
    let c: u32 = n;
    while chk_tok_kind(t, k) != 4 && !chk_tok_is(src, t, k, ">") {
        if chk_tok_kind(t, k) == 0 {
            store32(s, c * 20, k);
            store32(s, c * 20 + 4, K_TPARAM);
            store32(s, c * 20 + 8, 0);
            store32(s, c * 20 + 12, 0);
            store32(s, c * 20 + 16, 0);
            c = c + 1;
        }
        k = k + 1;
    }
    return c;
}

/// 关键字: 后面就算跟 `(` 也不是函数调用 (`return (a)`、`if (b)`、`return (x, y)`)。
fn chk_is_kw(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "return") || chk_tok_is(src, t, i, "if")
            || chk_tok_is(src, t, i, "while") || chk_tok_is(src, t, i, "for")
            || chk_tok_is(src, t, i, "match") || chk_tok_is(src, t, i, "guard")
            || chk_tok_is(src, t, i, "let") || chk_tok_is(src, t, i, "fn")
            || chk_tok_is(src, t, i, "struct") || chk_tok_is(src, t, i, "enum")
            || chk_tok_is(src, t, i, "const") || chk_tok_is(src, t, i, "use")
            || chk_tok_is(src, t, i, "as") || chk_tok_is(src, t, i, "mut")
            || chk_tok_is(src, t, i, "pub") || chk_tok_is(src, t, i, "interrupt")
            || chk_tok_is(src, t, i, "trait") || chk_tok_is(src, t, i, "impl")
            || chk_tok_is(src, t, i, "else") || chk_tok_is(src, t, i, "break")
            || chk_tok_is(src, t, i, "continue") {
        return 1;
    }
    return 0;
}

/// 从 `struct`/`enum`/`trait` 这类声明处的 `{` 跳到匹配的 `}` 之后。
fn chk_skip_body(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "{") {
        j = j + 1;
    }
    let d: u32 = 0;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "{") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, "}") {
            d = d - 1;
            if d == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 整型基类型 (镜像 lomentc.INT_TYPES; **bool 不算** —— 常量的类型必须是整型)。
fn chk_is_int(src: ptr, t: ptr, i: u32) -> u32 {
    if chk_tok_is(src, t, i, "u8") || chk_tok_is(src, t, i, "u16") || chk_tok_is(src, t, i, "u32")
        || chk_tok_is(src, t, i, "u64") || chk_tok_is(src, t, i, "i8") || chk_tok_is(src, t, i, "i16")
        || chk_tok_is(src, t, i, "i32") || chk_tok_is(src, t, i, "i64") {
        return 1;
    }
    return 0;
}

/// 十进制字面量 token -> 数值 (能力域上下界用; 参考实现的 int_lit 只吃 number,
/// 所以这里不必处理负号/进制前缀)。
fn chk_dec(src: ptr, t: ptr, i: u32) -> u32 {
    let n: u32 = tok_len(t, i);
    let v: u32 = 0;
    let k: u32 = 0;
    while k < n {
        let c: u32 = load8(src, tok_start(t, i) + k) as u32;
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
        }
        k = k + 1;
    }
    return v;
}

/// name_tab 里有没有跟 i 同文的 token (表项 = token 下标, 4 字节一项)。
/// 字段/变体/形参的重名判定都用它 —— 参考实现是 set[str], 这里等价于 set[token 文本]。
fn chk_tab_has(src: ptr, t: ptr, tab: ptr, n: u32, i: u32) -> u32 {
    let k: u32 = 0;
    while k < n {
        if same(src, t, load32(tab, k * 4), i) {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

/// 从 i 起找 `{` 的下标。
fn chk_find_brace(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "{") {
        j = j + 1;
    }
    return j;
}

/// `struct S { ... }` 的字段: 重名 -> E-DUP; 类型未声明 -> E-TYPE; 没有字段 -> E-DEF。
/// lb = `{` 的下标; 返回 (后一项下标 << 32) | o。
fn chk_struct_body(src: ptr, t: ptr, s: ptr, n: u32, lb: u32, name_tok: u32,
                   tab: ptr, p: ptr, o: u32) -> u64 {
    let j: u32 = lb + 1;
    let c: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if chk_tab_has(src, t, tab, c, j) == 1 {
            o = sym_pub(src, t, p, o, E_DUP, j);
        }
        store32(tab, c * 4, j);
        c = c + 1;
        j = j + 1;
        if chk_tok_is(src, t, j, ":") {
            j = j + 1;
            let r: u64 = check_type(src, t, s, n, j, p, o);
            o = (r % 4294967296) as u32;
            j = chk_skip_type(src, t, j);
        }
        if chk_tok_is(src, t, j, ",") {
            j = j + 1;
        }
    }
    if c == 0 {
        o = sym_pub(src, t, p, o, E_DEF, name_tok);
    }
    return ((j + 1) as u64) * 4294967296 + (o as u64);
}

/// `enum E { ... }` 的变体: 重名 -> E-DUP; 载荷类型未声明 -> E-TYPE; 没有变体 -> E-DEF。
fn chk_enum_body(src: ptr, t: ptr, s: ptr, n: u32, lb: u32, name_tok: u32,
                 tab: ptr, p: ptr, o: u32) -> u64 {
    let j: u32 = lb + 1;
    let c: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if chk_tok_kind(t, j) == 0 {
            if chk_tab_has(src, t, tab, c, j) == 1 {
                o = sym_pub(src, t, p, o, E_DUP, j);
            }
            store32(tab, c * 4, j);
            c = c + 1;
            j = j + 1;
            if chk_tok_is(src, t, j, "(") {
                let r: u64 = check_type(src, t, s, n, j + 1, p, o);
                o = (r % 4294967296) as u32;
                j = chk_skip_type(src, t, j + 1);
                if chk_tok_is(src, t, j, ")") {
                    j = j + 1;
                }
            }
        } else {
            j = j + 1;
        }
        if chk_tok_is(src, t, j, ",") {
            j = j + 1;
        }
    }
    if c == 0 {
        o = sym_pub(src, t, p, o, E_DEF, name_tok);
    }
    return ((j + 1) as u64) * 4294967296 + (o as u64);
}

/// `capability NAME : SPACE [ LO .. HI ] (revocable)?` —— **只登记不判错**。
/// 判错必须等整个单元扫完: 参考实现是在 parse 完成后拿 mod.caps / mod.excluded
/// 一起比的, 所以"先写能力再用 excluded 声明同一空间"也必须报 (顺序无关)。
/// token 布局是**定长**的 (parser 的形状固定): NAME=i+1, ':'=i+2, SPACE=i+3,
/// '['=i+4, LO=i+5, '.'=i+6, '.'=i+7, HI=i+8, ']'=i+9。返回后一项下标。
fn chk_cap_collect(src: ptr, t: ptr, ctab: ptr, nc: ptr, i: u32) -> u32 {
    let n0: u32 = load32(nc, 0);
    store32(ctab, n0 * 16, i + 1);                    // 名字 token
    store32(ctab, n0 * 16 + 4, chk_dec(src, t, i + 5));   // lo
    store32(ctab, n0 * 16 + 8, chk_dec(src, t, i + 8));   // hi
    store32(ctab, n0 * 16 + 12, i + 3);               // 空间 token
    store32(nc, 0, n0 + 1);
    i = i + 10;
    if chk_tok_is(src, t, i, "revocable") {
        i = i + 1;
    }
    return i;
}

/// 能力表判错 (参考实现 2094-2107): 重复声明 / LO>HI / 占用 excluded 空间 -> E-CAP。
fn chk_caps_verify(src: ptr, t: ptr, ctab: ptr, n0: u32, exs: ptr, nexs: u32, p: ptr, o: u32) -> u32 {
    let k: u32 = 0;
    while k < n0 {
        let nt: u32 = load32(ctab, k * 16);
        if load32(ctab, k * 16 + 4) > load32(ctab, k * 16 + 8) {
            o = sym_pub(src, t, p, o, E_CAP, nt);
        }
        // 与**之前**的每个能力比名字: 每个重复项各报一次 (与 set 的"每项都报"同口径)
        let k2: u32 = 0;
        while k2 < k {
            if same(src, t, load32(ctab, k2 * 16), nt) {
                o = sym_pub(src, t, p, o, E_CAP, nt);
            }
            k2 = k2 + 1;
        }
        // excluded "<space>: ..." —— 取 ':' 之前的部分跟能力空间比
        let e: u32 = 0;
        while e < nexs {
            let es: u32 = load32(exs, e * 4);
            let el: u32 = tok_len(t, es);
            let ep: u32 = tok_start(t, es) + 1;      // 跳过开引号
            let k3: u32 = 0;
            let colon: u32 = 0;
            while k3 < el && colon == 0 {
                if load8(src, ep + k3) == 58 {
                    colon = k3;
                }
                k3 = k3 + 1;
            }
            if colon > 0 && colon == tok_len(t, load32(ctab, k * 16 + 12)) {
                let ok: u32 = 1;
                let k4: u32 = 0;
                while k4 < colon {
                    if load8(src, ep + k4) != load8(src, tok_start(t, load32(ctab, k * 16 + 12)) + k4) {
                        ok = 0;
                    }
                    k4 = k4 + 1;
                }
                if ok == 1 {
                    o = sym_pub(src, t, p, o, E_EXCL, nt);
                }
            }
            e = e + 1;
        }
        k = k + 1;
    }
    return o;
}

/// 源码里 `[off, off+len)` 这一段是不是正好 `s`（**不带引号定界**的裸比较）。
/// `chk_tok_is` 不能用来比"一个 token 的一段" —— 它比的是整个 token。
fn chk_slice_is(src: ptr, off: u32, len: u32, s: str) -> u32 {
    if str_len(s) != len {
        return 0;
    }
    let k: u32 = 0;
    while k < len {
        if load8(src, off + k) != str_byte(s, k) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// 联网面的号 —— **照 `lomentc.SURFACE_NUMBERS` 里 `net` 那几个抄**（两边逐条一致由
/// `loment_rule_parity` 的 `excl-net-*` 案例钉着：那边拼错一个号，探针就红）。
fn chk_num_is_net(n: u32) -> u32 {
    if n == 7 || n == 23 || n == 41 || n == 42 || n == 43 || n == 288 || n == 44 || n == 45
            || n == 48 || n == 49 || n == 50 || n == 51 || n == 52 || n == 54 || n == 55
            || n == 46 || n == 47 || n == 53 || n == 232 || n == 233 || n == 291 {
        return 1;
    }
    return 0;
}

/// 这个单元 `excluded` 过**网络空间**吗 —— 空间名取 `:` 之前那一段（前后空格去掉），
/// 认 `net` / `network` 两个写法（与参考实现的 `EXCLUDED_NET_SPACES` 同一份口径；
/// `loment/examples/demo.lomt` 写的是 `network`）。
fn chk_excl_net(src: ptr, t: ptr, exs: ptr, nexs: u32) -> u32 {
    let e: u32 = 0;
    while e < nexs {
        let es: u32 = load32(exs, e * 4);
        // 字符串 token 的原文**含引号**：跳过开引号、末尾的闭引号不算进前缀。
        let el: u32 = tok_len(t, es);
        if el > 2 {
            let ep: u32 = tok_start(t, es) + 1;
            let body: u32 = el - 2;
            let colon: u32 = body;
            let k: u32 = 0;
            while k < body && colon == body {
                if load8(src, ep + k) == 58 {
                    colon = k;
                }
                k = k + 1;
            }
            // 前后空格去掉（参考实现是 `.strip()`）
            let lo: u32 = 0;
            let hi: u32 = colon;
            while lo < hi && load8(src, ep + lo) == 32 {
                lo = lo + 1;
            }
            while hi > lo && load8(src, ep + hi - 1) == 32 {
                hi = hi - 1;
            }
            if chk_slice_is(src, ep + lo, hi - lo, "net") == 1
                    || chk_slice_is(src, ep + lo, hi - lo, "network") == 1 {
                return 1;
            }
        }
        e = e + 1;
    }
    return 0;
}

/// 这个调用点是不是"**联网面的机调用**"：名字是 `syscall4/6/7`、紧跟 `(`、
/// 而第一个实参写成联网号的字面量。`i` 指向名字。
fn chk_syscall_net(src: ptr, t: ptr, i: u32) -> u32 {
    if !(chk_tok_is(src, t, i, "syscall4") || chk_tok_is(src, t, i, "syscall6")
            || chk_tok_is(src, t, i, "syscall7")) {
        return 0;
    }
    if !chk_tok_is(src, t, i + 1, "(") {
        return 0;
    }
    return chk_num_is_net(chk_dec(src, t, i + 2));
}


/// guard 的能力与索引: 未声明 -> E-CAP; 字面量索引越界 -> E-CAP。
/// i 指向 `guard`, i+1 = 能力名, i+2 = '(' , i+3 = 索引 (可选)。
fn chk_guard(src: ptr, t: ptr, ctab: ptr, nc: u32, i: u32, p: ptr, o: u32) -> u32 {
    let nt: u32 = i + 1;
    let k: u32 = 0;
    let found: u32 = 0;
    while k < nc {
        if same(src, t, load32(ctab, k * 16), nt) {
            found = 1;
            if chk_tok_kind(t, i + 3) == 1 {
                let v: u32 = chk_dec(src, t, i + 3);
                if v < load32(ctab, k * 16 + 4) || v > load32(ctab, k * 16 + 8) {
                    o = sym_pub(src, t, p, o, E_CAP, nt);
                }
            }
        }
        k = k + 1;
    }
    if found == 0 {
        o = sym_pub(src, t, p, o, E_CAP, nt);
    }
    return o;
}

/// 内建函数的形参个数 (镜像 lomentc.BUILTINS 的 arity); 不是内建 -> 999999。
/// 这张表必须与 `is_builtin` 的名字清单**同增同减** —— `test_m81_builtin_table_matches`
/// 会逐名比对两边, 漏改一边就红。
fn chk_builtin_arity(src: ptr, t: ptr, i: u32) -> u32 {
    // slice_len 也是内建 (参考实现里它单列一条, 不在 BUILTINS 表里), 但 arity 同口径
    if chk_tok_is(src, t, i, "str_len") || chk_tok_is(src, t, i, "panic")
            || chk_tok_is(src, t, i, "alloc") || chk_tok_is(src, t, i, "free")
            || chk_tok_is(src, t, i, "inb") || chk_tok_is(src, t, i, "str_ptr")
            || chk_tok_is(src, t, i, "slice_len") {
        return 1;
    }
    if chk_tok_is(src, t, i, "str_eq") || chk_tok_is(src, t, i, "str_concat")
            || chk_tok_is(src, t, i, "str_byte") || chk_tok_is(src, t, i, "load8")
            || chk_tok_is(src, t, i, "atomic_add") || chk_tok_is(src, t, i, "outb")
            || chk_tok_is(src, t, i, "ptr_add") || chk_tok_is(src, t, i, "ptr_sub") {
        return 2;
    }
    if chk_tok_is(src, t, i, "store8") || chk_tok_is(src, t, i, "get_bits") {
        return 3;
    }
    if chk_tok_is(src, t, i, "set_bits") || chk_tok_is(src, t, i, "syscall4") {
        return 4;
    }
    if chk_tok_is(src, t, i, "syscall6") {
        return 6;
    }
    if chk_tok_is(src, t, i, "syscall7") {
        return 7;
    }
    if chk_tok_is(src, t, i, "thread_spawn") {
        return 4;                                 // M84: 入口名、栈顶、实参、完成通知地址
    }
    return 999999;
}

/// 参数表: '('<i..>')' —— 检查类型与形参重名, 返回结束下标。
fn scan_params(src: ptr, t: ptr, s: ptr, n: u32, i: u32, p: ptr, o: u32, tab: ptr) -> u64 {
    i = i + 1;
    let c: u32 = 0;
    while !chk_tok_is(src, t, i, ")") && chk_tok_kind(t, i) != 4 {
        // 方法接收者: `&self` / `&mut self` / 裸 `self` (trait 块里写作 `fn m(self) -> u32;`)。
        // 它没有类型注解 —— 不排掉就会把后面的 `)` 或 `-` 当成类型, 报一串假 E-TYPE。
        if chk_tok_is(src, t, i, "&") {
            i = i + 1;
            if chk_tok_is(src, t, i, "mut") {
                i = i + 1;
            }
            i = i + 1;              // self
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else if chk_tok_is(src, t, i, "self") {
            i = i + 1;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else {
            // 形参重名 -> E-DUP (`fn f(a: u32, a: u32)`; 参考实现的口径是 E013)
            if chk_tab_has(src, t, tab, c, i) == 1 {
                o = sym_pub(src, t, p, o, E_DUP, i);
            }
            store32(tab, c * 4, i);
            c = c + 1;
            i = i + 1;              // 参数名
            i = i + 1;              // ':'
            let r: u64 = check_type(src, t, s, n, i, p, o);
            o = (r % 4294967296) as u32;
            i = chk_skip_type(src, t, i);
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
    }
    return ((i + 1) as u64) * 4294967296 + (o as u64);
}

/// 形参个数。前缀 `chk_` 的理由同 `chk_find_paren` —— 而且这两个 `count_args`
/// **语义恰好不同** (这里数形参, codegen 那边数实参), 撞名会静默算错。
pub fn chk_count_args(src: ptr, t: ptr, i: u32) -> u32 {
    // 从 '(' 之后开始, 数顶层逗号: 空表按 0
    let depth: u32 = 0;
    let argc: u32 = 0;
    let any: u32 = 0;
    let j: u32 = i + 1;
    while !(chk_tok_is(src, t, j, ")") && depth == 0) && chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            depth = depth + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            depth = depth - 1;
        }
        if chk_tok_is(src, t, j, ",") && depth == 0 {
            argc = argc + 1;
        }
        any = 1;
        j = j + 1;
    }
    if any == 0 {
        return 0;
    }
    return argc + 1;
}

/// 名字是否**声明过** (类型未知也算)。与 `chk_env_get` 分开是因为类型编码 0 既表示
/// "未知"也表示"这里的类型是泛型形参 T" —— 判"未声明"必须看"在不在表里", 不是"类型是不是 0"。
fn chk_env_has(src: ptr, t: ptr, env: ptr, envc: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < envc {
        if same(src, t, load32(env, i * 8), name_tok) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 局部环境 (形参 + let) 查类型: 条目 = 名字 token | 类型编码 (8 字节)。
fn chk_env_get(src: ptr, t: ptr, env: ptr, envc: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < envc {
        if same(src, t, load32(env, i * 8), name_tok) {
            return load32(env, i * 8 + 4);
        }
        i = i + 1;
    }
    return 0;
}

fn chk_env_add(t: ptr, env: ptr, envc: u32, name_tok: u32, ty: u32) -> u32 {
    store32(env, envc * 8, name_tok);
    store32(env, envc * 8 + 4, ty);
    return envc + 1;
}

/// 一个 **number** token 的整数值（十进制 / `0x` 十六进制）。**与 `codegen.lomt` 的
/// `tok_int` 同口径，但本模块不依赖它** —— `checker.lomt` 是零依赖模块，与
/// `switches.lomt` 的 `sw_tok_is` 同一条理由。
fn chk_tok_int(src: ptr, t: ptr, i: u32) -> u32 {
    let st: u32 = load32(t, i * 20 + 4);
    let n: u32 = load32(t, i * 20 + 8);
    if n >= 2 && load8(src, st) == 48 && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        let v: u32 = 0;
        let k: u32 = 2;
        while k < n {
            let c: u32 = load8(src, st + k);
            let d: u32 = 0;
            if c >= 48 && c <= 57 {
                d = c - 48;
            } else if c >= 97 && c <= 102 {
                d = c - 87;
            } else if c >= 65 && c <= 70 {
                d = c - 55;
            }
            v = v * 16 + d;
            k = k + 1;
        }
        return v;
    }
    let r: u32 = 0;
    let j: u32 = 0;
    while j < n {
        r = r * 10 + (load8(src, st + j) - 48);
        j = j + 1;
    }
    return r;
}

/// `lms` 开着吗（`docs/253`） —— 第 1 级检查器（E028）的开关。
///
/// **扫 token 流**，与 `codegen.lomt` 的 `gc_alpha_tier` 同一个形状（那边扫
/// `choose gc_auto_alpha`）—— 两边读的都是**根单元源码里那个词**，那是同一条纪律。
///
/// ⚠ **为什么在这里自己扫一遍，而不是让调用方传进来**：`chk_tex` 已经有八个参数，
/// 再加一个要把**所有递归调用点**都改一遍。而这个判断只在「**定长数组 + 裸字面量下标**」
/// 那一格才被问到 —— 那是稀有形状，一遍扫描的代价落在那里可以接受。
fn chk_lms_on(src: ptr, t: ptr) -> u32 {
    let i: u32 = 0;
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "choose") && chk_tok_is(src, t, i + 1, "lms_open") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 名字对应的类型: 局部环境优先, 再看顶层符号表 (模块级常量在函数体内可见,
/// 参考实现是 `scope = dict(const_scope)` 起手)。
fn chk_name_ty(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32, name_tok: u32) -> u32 {
    let v: u32 = chk_env_get(src, t, env, envc, name_tok);
    if v != 0 {
        return v;
    }
    let slot: u32 = chk_lookup_slot(src, t, syms, n, name_tok);
    if slot != 0 && load32(syms, (slot - 1) * 20 + 4) == K_CONST {
        // 常量的类型编码存在**返回类型那一格** (常量没有返回类型, 那格空着)
        return load32(syms, (slot - 1) * 20 + 12);
    }
    return 0;
}

/// 词法器把多字符运算符拆成**单字符 token** (`!=` -> `!` `=`, `<<` -> `<` `<`,
/// `==` -> `=` `=`), 所以比较/算术运算符必须在 token 层按相邻字符重新组装。
/// 这一条踩过一次: 按 `chk_tok_is(j, "==")` 判定的话**永远不匹配**, 于是
/// `return a != b;` 被算成"非 bool", 在语料上立刻变成假阳性。
fn chk_is_cmp(src: ptr, t: ptr, j: u32) -> u32 {
    if chk_tok_is(src, t, j, "=") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // ==
    }
    if chk_tok_is(src, t, j, "!") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // !=
    }
    if chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // <=
    }
    if chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, "=") {
        return 1;                                       // >=
    }
    if chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<") {
        return 0;                                       // << 是移位, 不是比较
    }
    if chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">") {
        return 0;
    }
    if chk_tok_is(src, t, j, "<") || chk_tok_is(src, t, j, ">") {
        return 1;                                       // <  >
    }
    if chk_tok_is(src, t, j, "&") && chk_tok_is(src, t, j + 1, "&") {
        return 1;                                       // &&
    }
    if chk_tok_is(src, t, j, "|") && chk_tok_is(src, t, j + 1, "|") {
        return 1;                                       // ||
    }
    return 0;
}

fn chk_is_binop(src: ptr, t: ptr, j: u32) -> u32 {
    if chk_tok_is(src, t, j, "+") || chk_tok_is(src, t, j, "-")
            || chk_tok_is(src, t, j, "*") || chk_tok_is(src, t, j, "/")
            || chk_tok_is(src, t, j, "%") || chk_tok_is(src, t, j, "^") {
        return 1;
    }
    if chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<") {
        return 1;                                       // <<
    }
    if chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">") {
        return 1;                                       // >>
    }
    if chk_tok_is(src, t, j, "&") && !chk_tok_is(src, t, j + 1, "&") {
        return 1;                                       // 位与 (排除 &&)
    }
    if chk_tok_is(src, t, j, "|") && !chk_tok_is(src, t, j + 1, "|") {
        return 1;
    }
    return 0;
}

/// 把 (lo, hi) 打包成一个 u64 传参 —— 自举 codegen 的**形参上限是 10**, 而
/// 遍历器的形参是 (src,t,syms,n,env,envc,lo,hi,tyt,p,oc) 11 个。拆掉一个只能打包。
fn chk_lh(a: u32, b: u32) -> u64 {
    return (a as u64) * 4294967296 + (b as u64);
}
fn chk_lhlo(v: u64) -> u32 {
    return (v / 4294967296) as u32;
}
fn chk_lhhi(v: u64) -> u32 {
    return (v % 4294967296) as u32;
}
/// 三字段版 (多一个 token 下标, 如字段访问的 '.'): base 2^21。
fn chk_lh3(a: u32, b: u32, c: u32) -> u64 {
    return ((a as u64) * 2097152 + (b as u64)) * 2097152 + (c as u64);
}
fn chk_lh3a(v: u64) -> u32 {
    return (v / 4398046511104) as u32;
}
fn chk_lh3b(v: u64) -> u32 {
    return ((v / 2097152) % 2097152) as u32;
}
fn chk_lh3c(v: u64) -> u32 {
    return (v % 2097152) as u32;
}

/// 表达式遍历 + 类型推断 (对照 lomentc 的 `_walk_expr` + `expr_type`, token 版)。
///
/// 返回类型编码 (0 = 未知); 同时把子表达式里的错误写进 p/o。`lh` = (lo << 32) | hi ——
/// 两个下标打包进一个 u64 是为了守住自举 codegen 的 **10 形参上限**
/// (src,t,syms,n,env,envc,lh,tyt,p,o 正好 10 个)。
///
/// 类型语义 (与参考实现的 `expr_type` 对齐):
///   - 整型字面量 -> 0 (参考实现里 IntLit 也是 None, 让上下文定宽)
///   - `true`/`false` -> bool, 字符串字面量 -> str
///   - 深度 0 有比较/逻辑运算符 -> bool (比较**优先于**算术: `v % 2 == 0` 是 bool)
///   - 算术/位运算 -> **最左**操作数的类型 (参考实现的 `Bin` 返回 `lt or rt`)
///   - `as T` -> T; `&arr` -> 切片(元素, 只读); `&mut arr` -> 切片(元素, 可变)
///   - 数组字面量 -> 数组(首元素类型, 个数); 下标 -> 元素类型; 字段 -> 字段类型
///   - `f(...)` -> 返回类型; `x.m(...)` -> 方法返回类型; `E::V`/`E::V(x)` -> 枚举类型
///   - 复合类型/泛型实例/形参 T -> 0 (见 chk_ty_of_tok 与 TY_* 的说明)
fn chk_tex(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
           lh: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    // 诊断偏移格是**形参** oc (调用方从 tyt 块尾拿到) —— 这里再 `let oc = ...` 会把它
    // 遮住, 而且**同一个函数里声明两次同名局部**会让自举 codegen 发出两条
    // `%oc.addr = alloca`, 与参考实现 (按名字复用槽位, 只发一条) 逐字节不一致。
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    if lo >= hi {
        return 0;
    }
    // ---- `expr ?` (M9 错误传播): 参考实现只在 `let x: T = <Result 实例>?;` 里解糖,
    // 其余位置一律 E010。这里**只在能确定"不是 Result"时**报, 免得假阳性:
    //   - 内层是整型字面量 (`1?`) -> 一定不是 Result
    //   - 内层是调用且被调函数的返回类型 token 不是 `Result` -> 一定不是
    // 其它形状 (变量/字段/…的类型我算不准) 保守放过。
    if hi > lo + 1 && chk_tok_is(src, t, hi - 1, "?") {
        let ok: u32 = chk_q_ok(src, t, syms, n, lo, hi - 1);
        if ok == 0 {
            chk_pub(src, t, oc, p, E_Q, hi - 1);
        }
        return chk_tex(src, t, syms, n, env, envc, chk_lh(lo, hi - 1), tyt, p, oc);
    }
    // ---- 单 token 快路径
    if hi == lo + 1 {
        if chk_tok_kind(t, lo) == 1 {
            return 0;
        }
        if chk_tok_kind(t, lo) == 2 {
            return (1 << TY_KIND_SHIFT) + 10;
        }
        if chk_tok_is(src, t, lo, "true") || chk_tok_is(src, t, lo, "false") {
            return (1 << TY_KIND_SHIFT) + 9;
        }
        if chk_tok_kind(t, lo) == 0 {
            let v1: u32 = chk_name_ty(src, t, syms, n, env, envc, lo);
            // 使用未声明的变量 -> E002。三个排除:
            //   - 关键字与 `_`/`self` (`self` 是方法接收者, 参考实现改名 __self 入作用域)
            //   - **在环境里声明过但类型未知**的变量: `fn f<T>(a: T)` 的 `a`, 它的类型
            //     编码就是 0 (形参 T), 只看 v1 == 0 会把每个泛型形参都当成未声明
            if v1 == 0 && chk_env_has(src, t, env, envc, lo) == 0
                    && chk_lookup_slot(src, t, syms, n, lo) == 0
                    && chk_is_kw(src, t, lo) == 0
                    && !chk_tok_is(src, t, lo, "_") && !chk_tok_is(src, t, lo, "self") {
                chk_pub(src, t, oc, p, E_TYPE, lo);
            }
            return v1;
        }
        return 0;
    }
    // ---- 深度 0 扫描 (用**更新前**的深度判 j 是不是顶层运算符/分隔符)
    let d: u32 = 0;
    let j: u32 = lo;
    let bin_at: u32 = 0;
    let as_at: u32 = 0;
    let dot_at: u32 = 0;
    let idx_at: u32 = 0;
    let iscmp: u32 = 0;
    while j < hi {
        if d == 0 {
            if chk_is_cmp(src, t, j) == 1 {
                iscmp = 1;
            }
            if chk_tok_is(src, t, j, "as") {
                as_at = j;
            }
            if chk_is_binop(src, t, j) == 1 && j > lo && bin_at == 0 {
                bin_at = j;
            }
            // `<<` / `>>` 是两个 token: 第二个字符不能再被当成运算符 (`1 << n` 里的
            // 第二个 `<` 会被读成"小于", 整段被算成 bool —— 踩过)
            if (chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<"))
                    || (chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">")) {
                j = j + 1;
            } else {
                if chk_tok_is(src, t, j, ".") {
                    dot_at = j;
                }
                if chk_tok_is(src, t, j, "[") && j > lo {
                    idx_at = j;
                }
            }
        }
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        }
        j = j + 1;
    }
    // ---- 比较/逻辑 -> bool。**必须排在 `as` 前面**: `as` 的结合力比比较/逻辑紧
    // (参考实现里 `as` 在 parse_unary 一层, 而 `&&`/`==` 在更低层), 所以
    // `i < n as u64 && ...` 的顶节点是 `&&` 而不是那个 `as`。顺序反了的话整段会被当成
    // 转换表达式, 返回目标类型 (u64), 于是每个"带 as 的条件"都被报成非 bool
    // (driver.lomt 的 1@61206:while 假报)。
    if iscmp != 0 {
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo, hi), tyt, p, oc);
        return (1 << TY_KIND_SHIFT) + 9;
    }
    // ---- 算术/位运算 -> 最左操作数 (`as` 若排在后面就属于右操作数)
    if bin_at != 0 && (as_at == 0 || bin_at < as_at) {
        let roff: u32 = 1;
        if (chk_tok_is(src, t, bin_at, "<") && chk_tok_is(src, t, bin_at + 1, "<"))
                || (chk_tok_is(src, t, bin_at, ">") && chk_tok_is(src, t, bin_at + 1, ">")) {
            roff = 2;
        }
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo, bin_at), tyt, p, oc);
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(bin_at + roff, hi), tyt, p, oc);
        return chk_tex(src, t, syms, n, env, envc,
                       chk_lh(lo, bin_at), tyt, p, oc);
    }
    // ---- `as T`: 目标合法性 + 左操作数类型 (参考实现 1810-1821)
    if as_at != 0 && as_at > lo {
        let tgt: u32 = chk_ty_range(src, t, syms, n, tyt, as_at + 1, hi);
        let lt: u32 = chk_tex(src, t, syms, n, env, envc,
                              chk_lh(lo, as_at), tyt, p, oc);
        if chk_base_code(src, t, as_at + 1) == 0 {
            chk_pub(src, t, oc, p, E_AS, as_at + 1);         // as 目标类型非法
            return 0;
        }
        // 两条**合法**的整数-指针互转 (参考实现 1810-1814, M67/M83): 少了这两条,
        // `p as u64` / `(n as u64) as ptr` 会被报成"as 只能作用于整型/布尔" —— 这也是
        // 自举驱动自己编译不过的原因 (driver/checker 里到处是 `x as u64`)。
        let tgtc: u32 = chk_base_code(src, t, as_at + 1);
        let lt_ptr: u32 = 0;
        if chk_ty_kind(lt) == 1 && lt % (1 << TY_KIND_SHIFT) == 11 {
            lt_ptr = 1;
        }
        let tg_ptr: u32 = 0;
        if tgtc == 11 {
            tg_ptr = 1;
        }
        let tg_u64: u32 = 0;
        if tgtc == 4 || tgtc == 8 {
            tg_u64 = 1;
        }
        if lt_ptr == 1 && tg_u64 == 1 {
            return tgt;
        }
        if tg_ptr == 1 && chk_ty_is_int(lt) == 1 {
            return tgt;
        }
        if lt != 0 && chk_ty_is_int(lt) == 0 && lt != TY_BOOL {
            chk_pub(src, t, oc, p, E_AS, as_at);             // as 只能作用于整型/布尔
        }
        return tgt;
    }
    // ---- 整体外层括号
    if chk_tok_is(src, t, lo, "(") && chk_match_paren(src, t, lo) == hi - 1 {
        return chk_tex(src, t, syms, n, env, envc,
                       chk_lh(lo + 1, hi - 1), tyt, p, oc);
    }
    // ---- 一元 & / &mut -> 切片 (参考实现: 只作用于数组)
    // 源码顺序是 `&` 然后 `mut` (`&mut a`), 解析器据此把 op 记成 "&mut"。原来写成
    // `mut &`, 于是 inner 落在 `mut a` 上、类型推不出来, 每个 `&mut 数组` 都被误报成
    // "只能作用于数组" (native_mut 的 15@96 假报)。
    if chk_tok_is(src, t, lo, "&") {
        let mutf: u32 = 0;
        let a0: u32 = lo + 1;
        if chk_tok_is(src, t, lo + 1, "mut") {
            mutf = 1;
            a0 = lo + 2;
        }
        let inner: u32 = chk_tex(src, t, syms, n, env, envc,
                                 chk_lh(a0, hi), tyt, p, oc);
        if chk_ty_is_arr(tyt, inner) == 0 {
            chk_pub(src, t, oc, p, E_ACCESS, lo);         // 只能作用于数组
            return 0;
        }
        return chk_ty_slc(tyt, chk_ty_a(tyt, inner), mutf);
    }
    if chk_tok_is(src, t, lo, "!") {
        return chk_tex(src, t, syms, n, env, envc,
                       chk_lh(lo + 1, hi), tyt, p, oc);
    }
    // ---- 数组字面量
    if chk_tok_is(src, t, lo, "[") && chk_match_bracket(src, t, lo) == hi - 1 {
        return chk_tex_atom_arr(src, t, syms, n, env, envc, chk_lh(lo, hi), tyt, p, oc);
    }
    // ---- 枚举构造/路径 `E::V` / `E::V(x)`
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo + 1, ":")
            && chk_tok_is(src, t, lo + 2, ":") {
        return chk_tex_atom_enum(src, t, syms, n, env, envc, chk_lh(lo, hi), tyt, p, oc);
    }
    // ---- 方法调用 `x.m(...)` / 字段访问 `x.f`
    if dot_at != 0 && dot_at > lo {
        return chk_tex_atom_dot(src, t, syms, n, env, envc, chk_lh3(lo, hi, dot_at), tyt, p, oc);
    }
    // ---- 下标 `x[i]`
    if idx_at != 0 {
        let br: u32 = chk_match_bracket(src, t, idx_at);
        let ot: u32 = chk_tex(src, t, syms, n, env, envc,
                              chk_lh(lo, idx_at), tyt, p, oc);
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(idx_at + 1, br), tyt, p, oc);
        if ot != 0 && chk_ty_is_arr(tyt, ot) == 0 && chk_ty_is_slc(tyt, ot) == 0 {
            // 参考实现在"类型未知"时也报这条; 这里**只在类型已知且确定不是数组/切片时**报
            // —— 否则任何算不出类型的数组都会变成假阳性 (docs/150 记过这条偏离)。
            chk_pub(src, t, oc, p, E_ACCESS, idx_at);
        }
        let it: u32 = chk_tex(src, t, syms, n, env, envc,
                              chk_lh(idx_at + 1, br), tyt, p, oc);
        if it != 0 && chk_ty_is_int(it) == 0 {
            chk_pub(src, t, oc, p, E_TMISMATCH, idx_at);   // 下标类型，应为整型
        }
        // **E028**：**字面量下标越过定长数组的界**当场拒。
        //
        // **2026-10-16 起它不再看 `lms`**（issue #18）。原先只在 `choose lms_open` 时发，
        // 而 `lms` 是**开发通道的中间态**（`docs/253` §14.2：不进发行版）—— 发行版的用户
        // 拿不到。可它本来就不是一条 LMS 检查：`docs/205` §1.1 C5 早把「越界访问在
        // **字面量**时编译期拒」写成语言规则，那一格只覆盖 `guard`（`docs/146` §3：
        // `guard cap(9)` 对域 `[0..4]` 是编译错误）。同一个"字面量越界"两个答案，正是
        // issue #18 点名的那处不一致。参考实现那一侧同步改了（`_walk_expr` 的 Index 支）。
        //
        // 实测来路（`docs/253` §4.4）：`a[10]` 配 `[u32; 4]` 发出来的是
        // `getelementptr inbounds ... i32 10`，而 `inbounds` 在 LLVM IR 里恰是"越界即 UB"。
        // 两条收窄，缺一不可：
        //   * 只对**定长数组**（`chk_ty_is_arr` 排除了切片 —— 后者的长度是运行期的；
        //     那一半见 `docs/205` §1.1 C5：默认档不检查，用 `slice_len` + 一个 `if` 自己挡）；
        //   * 下标必须是**裸字面量**（`[ N ]` 恰好三个 token）—— 与参考实现判 `IntLit`
        //     同口径；写成 `[10 + 0]` 就不报，两边一致。
        if chk_ty_is_arr(tyt, ot) == 1 && chk_match_bracket(src, t, idx_at) == idx_at + 2
                && chk_tok_kind(t, idx_at + 1) == 1 {
            if chk_tok_int(src, t, idx_at + 1) >= chk_ty_b(tyt, ot) {
                chk_pub(src, t, oc, p, E_BOUND, idx_at);
            }
        }
        if chk_ty_is_arr(tyt, ot) == 1 || chk_ty_is_slc(tyt, ot) == 1 {
            return chk_ty_a(tyt, ot);
        }
        return 0;
    }
    // ---- 调用 `f(...)` / 结构体字面量 `S { ... }`
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo + 1, "(")
            && chk_match_paren(src, t, lo + 1) == hi - 1 {
        return chk_tex_atom_call(src, t, syms, n, env, envc, chk_lh(lo, hi), tyt, p, oc);
    }
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo + 1, "{")
            && chk_match_brace(src, t, lo + 1) == hi - 1 {
        return chk_tex_atom_struct(src, t, syms, n, env, envc, chk_lh(lo, hi), tyt, p, oc);
    }
    // ---- 其余形状 (未建模) -> 只看**内部**的括号组, 免得漏掉里面的错误。
    // 注意必须收窄一格: 对同一区间再走一遍会让 chk_tex <-> chk_tex_sub 互相递归,
    // 直接栈溢出 (探针 `cap-unknown-guard` 的 `guard nope(0)` 就踩到了)。
    chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo + 1, hi), tyt, p, oc);
    return 0;
}

/// 把 [lo,hi) 按"深度 0 运算符"切成若干**操作数段**逐个遍历 (只为发现错误, 不看类型)。
/// 段的类型由调用方自己算 —— 这样"比较返回 bool / 二元取最左"这些规则不必在每个
/// 分支里重复一遍。
fn chk_tex_sub(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
               lh: u64, tyt: ptr, p: ptr, oc: ptr) {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    if lo < hi {
    let d: u32 = 0;
    let j: u32 = lo;
    let seg: u32 = lo;
    let cuts: u32 = 0;
    while j < hi {
        let cut: u32 = 0;
        if d == 0 && j > lo {
            if chk_is_cmp(src, t, j) == 1 || chk_is_binop(src, t, j) == 1
                    || chk_tok_is(src, t, j, "as") {
                cut = 1;
            }
        }
        if cut == 1 {
            cuts = cuts + 1;
            chk_tex(src, t, syms, n, env, envc,
                        (seg as u64) * 4294967296 + (j as u64), tyt, p, oc);
            if chk_tok_is(src, t, j, "as") {
                // `as T` 右边的 T 是**类型**不是表达式: 整段跳过。当成操作数段递归进去
                // 会把 `u32` 这样的类型名当标识符查 (报"使用未声明的变量 u32")。
                seg = chk_skip_type(src, t, j + 1);
                j = seg - 1;
            } else {
                seg = j + 1;
                // 两字符运算符 (`<<` `>>`) 的第二个字符不属于任何操作数段
                if (chk_tok_is(src, t, j, "<") && chk_tok_is(src, t, j + 1, "<"))
                        || (chk_tok_is(src, t, j, ">") && chk_tok_is(src, t, j + 1, ">")) {
                    j = j + 1;
                    seg = j + 1;
                }
            }
        }
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        }
        j = j + 1;
    }
    if cuts > 0 && seg < hi {
        chk_tex(src, t, syms, n, env, envc,
                    (seg as u64) * 4294967296 + (hi as u64), tyt, p, oc);
    }
    }
}

/// 数组字面量: 空 -> E016; 元素类型不一致 -> E016; 返回 数组(首元素类型, 个数)。
fn chk_tex_atom_arr(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
                    lh: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    let cnt: u32 = chk_arr_count(src, t, lo);
    if cnt == 0 {
        chk_pub(src, t, oc, p, E_ARR, lo);                // 数组字面量不能为空
        return 0;
    }
    // 逐元素遍历 + 收集: 首元素类型(非未知)、是否出现过未知元素、是否出现过非整型的实类型
    let i1: u32 = 0;
    let first: u32 = 0;
    let has_unk: u32 = 0;
    let all_int: u32 = 1;
    while i1 < cnt {
        let er: u64 = chk_arr_elem(src, t, lo, i1);
        let elo: u32 = (er / 4294967296) as u32;
        let ehi: u32 = (er % 4294967296) as u32;
        let et: u32 = chk_tex(src, t, syms, n, env, envc, er, tyt, p, oc);
        if et == 0 {
            has_unk = 1;
        } else {
            if first == 0 {
                first = et;
            }
            if chk_ty_is_int(et) == 0 && et != TY_BOOL {
                all_int = 0;
            }
        }
        i1 = i1 + 1;
        if elo >= ehi {
            i1 = cnt;                                        // 形状异常: 收工 (别死循环)
        }
    }
    // 一致性 (参考实现 1919-1923): 去重后的实类型多于 1 种 -> 报; 只有 1 种且混了未知
    // 元素而那种类型又不是整型 -> 报。
    let i2: u32 = 1;
    let nd: u32 = 0;
    if first != 0 {
        nd = 1;
    }
    while i2 < cnt {
        let er2: u64 = chk_arr_elem(src, t, lo, i2);
        let et2: u32 = chk_tex(src, t, syms, n, env, envc, er2, tyt, p, oc);
        if et2 != 0 {
            let dup: u32 = 0;
            let i3: u32 = 0;
            while i3 < i2 {
                let er3: u64 = chk_arr_elem(src, t, lo, i3);
                let et3: u32 = chk_tex(src, t, syms, n, env, envc, er3, tyt, p, oc);
                if chk_ty_eq(tyt, et3, et2) == 1 {
                    dup = 1;
                }
                i3 = i3 + 1;
            }
            if dup == 0 {
                nd = nd + 1;
            }
        }
        i2 = i2 + 1;
    }
    if nd > 1 {
        chk_pub(src, t, oc, p, E_ARR, lo);                // 元素类型不一致
    } else if nd == 1 && has_unk == 1 && all_int == 0 {
        chk_pub(src, t, oc, p, E_ARR, lo);                // 整型字面量混入非整型
    }
    if first == 0 {
        return 0;
    }
    return chk_ty_arr(tyt, first, cnt);
}

/// 枚举构造/路径 `E::V` / `E::V(x)`: 存在性/载荷 -> E002/E008/E001; 返回枚举类型。
fn chk_tex_atom_enum(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
                     lh: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    let etok: u32 = lo;
    let vtok: u32 = lo + 3;
    let slot: u32 = chk_lookup_slot(src, t, syms, n, etok);
    if slot == 0 || load32(syms, (slot - 1) * 20 + 4) != K_ENUM {
        chk_pub(src, t, oc, p, E_TYPE, etok);             // 未知枚举
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo + 4, hi), tyt, p, oc);
        return 0;
    }
    let brc: u32 = load32(syms, (slot - 1) * 20 + 16);
    let vi: u32 = chk_evariant_idx(src, t, brc, vtok);
    if vi == 0 {
        chk_pub(src, t, oc, p, E_PATTERN, vtok);          // 枚举 E 无变体 V
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo + 4, hi), tyt, p, oc);
        return (TY_K_NAMED << TY_KIND_SHIFT) + (slot - 1);
    }
    let pr: u64 = chk_epayload_range(src, t, brc, vtok);
    let ctor: u32 = 0;
    if chk_tok_is(src, t, lo + 4, "(") {
        ctor = 1;
    }
    if ctor == 1 {
        if pr == 0 {
            chk_pub(src, t, oc, p, E_PATTERN, vtok);      // 无载荷，不能带参数
            chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo + 5, hi), tyt, p, oc);
            return (TY_K_NAMED << TY_KIND_SHIFT) + (slot - 1);
        }
        let plo: u32 = (pr / 4294967296) as u32;
        let phi: u32 = (pr % 4294967296) as u32;
        let br: u32 = chk_match_paren(src, t, lo + 4);
        let at: u32 = chk_tex(src, t, syms, n, env, envc,
                              chk_lh(lo + 5, br), tyt, p, oc);
        if at != 0 {
            let pt: u32 = chk_ty_range(src, t, syms, n, tyt, plo, phi);
            if pt != 0 && chk_ty_eq(tyt, at, pt) == 0 {
                chk_pub(src, t, oc, p, E_TMISMATCH, vtok);   // 载荷类型，声明为
            }
        }
    } else {
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo + 4, hi), tyt, p, oc);
    }
    return (TY_K_NAMED << TY_KIND_SHIFT) + (slot - 1);
}

/// `x.m(...)` 方法调用 或 `x.f` 字段访问。
fn chk_tex_atom_dot(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
                    lh3: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    let lo: u32 = chk_lh3a(lh3);
    let hi: u32 = chk_lh3b(lh3);
    let dot_at: u32 = chk_lh3c(lh3);
    let ot: u32 = chk_tex(src, t, syms, n, env, envc,
                          chk_lh(lo, dot_at), tyt, p, oc);
    let ftok: u32 = dot_at + 1;
    // 方法调用: `name ( ... )` 且右括号正好收到区间末尾
    if chk_tok_kind(t, ftok) == 0 && chk_tok_is(src, t, ftok + 1, "(")
            && chk_match_paren(src, t, ftok + 1) == hi - 1 {
        let mslot: u32 = chk_lookup_method(src, t, syms, n, ot, ftok);
        if mslot == 0 {
            chk_pub(src, t, oc, p, E_TYPE, ftok);         // 类型 X 没有方法 m
            chk_tex_sub(src, t, syms, n, env, envc, chk_lh(ftok + 2, hi - 1), tyt, p, oc);
            return 0;
        }
        let want: u32 = load32(syms, (mslot - 1) * 20 + 8);
        let got: u32 = chk_count_args(src, t, ftok + 1);
        if want != got {
            chk_pub(src, t, oc, p, E_ARITY, ftok);
        }
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(ftok + 2, hi - 1), tyt, p, oc);
        return load32(syms, (mslot - 1) * 20 + 12);
    }
    // 字段访问: 对象类型已知时判"是不是结构体/有没有这个字段"
    if ot != 0 {
        if chk_ty_kind(ot) != TY_K_NAMED {
            chk_pub(src, t, oc, p, E_ACCESS, dot_at);     // 对非结构体类型取字段
            return 0;
        }
        let s0: u32 = ot % (1 << TY_KIND_SHIFT);
        if load32(syms, s0 * 20 + 4) != K_STRUCT {
            chk_pub(src, t, oc, p, E_ACCESS, dot_at);     // 具名但不是结构体
            return 0;
        }
        let brc: u32 = load32(syms, s0 * 20 + 16);
        if chk_sfield_exists(src, t, brc, ftok) == 0 {
            chk_pub(src, t, oc, p, E_ACCESS, ftok);       // 结构体 X 无字段 f
            return 0;
        }
        // 字段在, 但类型可能未知 (泛型形参字段) -> 返回 0 而不是报错
        return chk_sfield_ty(src, t, syms, n, tyt, brc, ftok);
    }
    return 0;
}

/// 实参区间是不是 `& ident` / `&mut ident` 形状; 是的话返回
/// ((名字 token 下标 + 1) << 32) | kind (1 = `&`, 2 = `&mut`), 否则 0。
fn chk_arg_borrow(src: ptr, t: ptr, lh: u64) -> u64 {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    if !chk_tok_is(src, t, lo, "&") {
        return 0;
    }
    let off: u32 = 1;
    let mf: u32 = 0;
    if chk_tok_is(src, t, lo + 1, "mut") {
        off = 2;
        mf = 1;
    }
    if lo + off + 1 != hi {
        return 0;
    }
    if chk_tok_kind(t, lo + off) != 0 {
        return 0;
    }
    return ((lo + off + 1) as u64) * 4294967296 + ((mf + 1) as u64);
}

/// 调用 `f(args)` —— 元数与实参类型 (内建走内建签名表); 返回返回类型。
fn chk_tex_atom_call(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
                     lh: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    let got: u32 = chk_count_args(src, t, lo + 1);
    let bin: u32 = chk_builtin_arity(src, t, lo);
    if bin != 999999 {
        // 内建: 元数 (参考实现另有一条 slice_len 的实参类型规则)
        if bin != got {
            chk_pub(src, t, oc, p, E_ARITY, lo);
        }
        let k: u32 = 0;
        while k < got {
            let er: u64 = chk_arr_elem(src, t, lo + 1, k);
            let elo: u32 = (er / 4294967296) as u32;
            let ehi: u32 = (er % 4294967296) as u32;
            let at: u32 = chk_tex(src, t, syms, n, env, envc, er, tyt, p, oc);
            let wt: u32 = chk_builtin_arg(src, t, lo, k);
            if chk_tok_is(src, t, lo, "slice_len") {
                if at != 0 && chk_ty_is_arr(tyt, at) == 0 && chk_ty_is_slc(tyt, at) == 0 {
                    chk_pub(src, t, oc, p, E_TMISMATCH, lo);   // 不是数组或切片
                }
            } else if wt != 0 {
                if at == 0 {
                    if chk_ty_is_int(wt) == 0 {
                        chk_pub(src, t, oc, p, E_TMISMATCH, lo);   // 期望 X, 得到整型字面量
                    }
                } else if chk_ty_eq(tyt, at, wt) == 0 {
                    chk_pub(src, t, oc, p, E_TMISMATCH, lo);       // 实参类型 X, 期望 W
                }
            }
            k = k + 1;
            if elo >= ehi {
                k = got;
            }
        }
        // M84 (docs/245): 入口那三条 —— **是字面量**、**名字合法**、**是本单元里恰好一个
        // 形参的函数**。`chk_lookup_lit_name` 一趟同时判了前两条 (名字不合法就查不到)。
        // 元数不对时上面已经报过 E_ARITY, 这里只在 `got >= 1` 时判, 免得叠一条噪音。
        if got >= 1 && chk_tok_is(src, t, lo, "thread_spawn") {
            let er0: u64 = chk_arr_elem(src, t, lo + 1, 0);
            let t0: u32 = (er0 / 4294967296) as u32;
            if er0 != 0 {
                if chk_tok_kind(t, t0) != 2 {
                    chk_pub(src, t, oc, p, E_TMISMATCH, lo);       // 不是字符串字面量
                } else {
                    let sl0: u32 = chk_lookup_lit_name(src, t, syms, n, t0);
                    if sl0 == 0 {
                        chk_pub(src, t, oc, p, E_FN, lo);          // 未定义的函数
                    } else if load32(syms, (sl0 - 1) * 20 + 8) != 1 {
                        chk_pub(src, t, oc, p, E_ARITY, lo);       // 形参不是一个
                    }
                }
            }
        }
        return chk_builtin_ret(src, t, lo);
    }
    let slot: u32 = chk_lookup_slot(src, t, syms, n, lo);
    if slot == 0 {
        chk_pub(src, t, oc, p, E_FN, lo);                 // 未定义的函数
        chk_tex_sub(src, t, syms, n, env, envc, chk_lh(lo + 2, hi - 1), tyt, p, oc);
        return 0;
    }
    let s0: u32 = slot - 1;
    let want: u32 = load32(syms, s0 * 20 + 8);
    // M5 借用检查: 同一次调用里同一变量不得既 `&mut` 又 `&`, 也不得 `&mut` 两次
    // (参考实现 `_check_borrows`; 每个名字只报一次, 所以按"首次出现"判)。
    let i1: u32 = 0;
    while i1 < got {
        let b1: u64 = chk_arg_borrow(src, t, chk_arr_elem(src, t, lo + 1, i1));
        if b1 != 0 {
            let n1: u32 = ((b1 / 4294967296) as u32) - 1;
            let k1: u32 = (b1 % 4294967296) as u32;
            let first: u32 = 1;
            let j1: u32 = 0;
            while j1 < i1 {
                let b2: u64 = chk_arg_borrow(src, t, chk_arr_elem(src, t, lo + 1, j1));
                if b2 != 0 && same(src, t, ((b2 / 4294967296) as u32) - 1, n1) {
                    first = 0;
                }
                j1 = j1 + 1;
            }
            if first == 1 {
                let nmut: u32 = 0;
                let nsha: u32 = 0;
                let j2: u32 = 0;
                while j2 < got {
                    let b3: u64 = chk_arg_borrow(src, t, chk_arr_elem(src, t, lo + 1, j2));
                    if b3 != 0 && same(src, t, ((b3 / 4294967296) as u32) - 1, n1) {
                        if (b3 % 4294967296) as u32 == 2 {
                            nmut = nmut + 1;
                        } else {
                            nsha = nsha + 1;
                        }
                    }
                    j2 = j2 + 1;
                }
                if k1 == 2 && nmut >= 1 && nsha >= 1 {
                    chk_pub(src, t, oc, p, E_BORROW, lo);      // 既被可变借用又被借用
                } else if nmut > 1 {
                    chk_pub(src, t, oc, p, E_BORROW, lo);      // 被可变借用两次
                }
            }
        }
        i1 = i1 + 1;
    }
    if want != got {
        chk_pub(src, t, oc, p, E_ARITY, lo);
    } else {
        let k2: u32 = 0;
        while k2 < got {
            let er2: u64 = chk_arr_elem(src, t, lo + 1, k2);
            let at2: u32 = chk_tex(src, t, syms, n, env, envc, er2, tyt, p, oc);
            let pt: u32 = chk_param_ty(src, t, syms, n, tyt, s0, k2);
            if pt != 0 {
                if at2 == 0 {
                    if chk_ty_is_int(pt) == 0 && chk_ty_is_slc(tyt, pt) == 0 {
                        chk_pub(src, t, oc, p, E_TMISMATCH, lo);   // 期望 X, 得到整型字面量
                    }
                } else if chk_ty_eq(tyt, at2, pt) == 1 {
                    // 相等
                } else if chk_ty_is_slc(tyt, pt) == 1 && chk_ty_is_arr(tyt, at2) == 1
                        && chk_ty_eq(tyt, chk_ty_a(tyt, pt), chk_ty_a(tyt, at2)) == 1 {
                    // 数组 -> 切片 协变 (M3)
                } else if chk_ty_is_slc(tyt, pt) == 1 && chk_ty_is_slc(tyt, at2) == 1
                        && chk_ty_eq(tyt, chk_ty_a(tyt, pt), chk_ty_a(tyt, at2)) == 1 {
                    if chk_ty_b(tyt, pt) == 1 && chk_ty_b(tyt, at2) == 0 {
                        chk_pub(src, t, oc, p, E_SLICE, lo);      // 形参要求可变切片
                    }
                } else {
                    chk_pub(src, t, oc, p, E_TMISMATCH, lo);      // 实参类型 X, 期望 P
                }
            }
            k2 = k2 + 1;
        }
    }
    return load32(syms, s0 * 20 + 12);
}

/// 结构体字面量 `S { f: e, ... }`: 未知结构体 -> E002; 字段 -> E015。
fn chk_tex_atom_struct(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
                       lh: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    let slot: u32 = chk_lookup_slot(src, t, syms, n, lo);
    if slot == 0 || load32(syms, (slot - 1) * 20 + 4) != K_STRUCT {
        chk_pub(src, t, oc, p, E_TYPE, lo);               // 未知结构体
        return 0;
    }
    let s0: u32 = slot - 1;
    let brc: u32 = load32(syms, s0 * 20 + 16);
    // 初始化项: 名字 ':' 表达式 (逗号分隔)
    let j: u32 = lo + 2;
    while j < hi && chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        // "字段名位置" = 紧跟 '{' 或前一个 token 是 ','。以前用一个 fstart 标志位记录,
        // 但它在每轮末尾按当前 token 重算 —— 轮到逗号那轮会把标志置 1、再下一轮(真正的
        // 字段名)又被置 0, 于是第二个字段永远查不到 (structlit-dup-field 少报就是这么来的)。
        if chk_tok_kind(t, j) == 0 && chk_tok_is(src, t, j + 1, ":")
                && (j == lo + 2 || chk_tok_is(src, t, j - 1, ",")) {
            if chk_sfield_exists(src, t, brc, j) == 0 {
                chk_pub(src, t, oc, p, E_ACCESS, j);      // 结构体 X 无字段 f
            } else {
                // 重复初始化: 前面出现过同名字段
                let k: u32 = lo + 2;
                let dup: u32 = 0;
                while k < j && chk_tok_kind(t, k) != 4 {
                    if chk_tok_kind(t, k) == 0 && same(src, t, k, j)
                            && chk_tok_is(src, t, k + 1, ":") {
                        dup = 1;
                    }
                    k = k + 1;
                }
                if dup == 1 {
                    chk_pub(src, t, oc, p, E_ACCESS, j);  // 字段 f 重复初始化
                }
            }
            // 走一遍初始化表达式, 直到下一个顶层的 ',' 或 '}'
            let ve: u32 = chk_find_at(src, t, j + 2, hi, ",");
            chk_tex_sub(src, t, syms, n, env, envc, chk_lh(j + 2, ve), tyt, p, oc);
            j = ve;
        } else {
            j = j + 1;
        }
    }
    // 缺字段: 结构体每个字段都要在初始化项里出现
    let fj: u32 = brc + 1;
    let fnames: u32 = 1;
    while chk_tok_kind(t, fj) != 4 && !chk_tok_is(src, t, fj, "}") {
        if fnames == 1 && chk_tok_kind(t, fj) == 0 {
            let hit: u32 = 0;
            let kj: u32 = lo + 2;
            while kj < hi && chk_tok_kind(t, kj) != 4 {
                if chk_tok_kind(t, kj) == 0 && same(src, t, kj, fj)
                        && chk_tok_is(src, t, kj + 1, ":") {
                    hit = 1;
                }
                kj = kj + 1;
            }
            if hit == 0 {
                chk_pub(src, t, oc, p, E_ACCESS, fj);     // 缺字段 f
            }
            fnames = 0;
        }
        if chk_tok_is(src, t, fj, ",") {
            fnames = 1;
        }
        fj = fj + 1;
    }
    return (TY_K_NAMED << TY_KIND_SHIFT) + s0;
}

/// 从 '(' 出发找匹配的 ')' (只按圆括号计数)。
fn chk_match_paren(src: ptr, t: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "(") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 从 '[' 出发找匹配的 ']'。
fn chk_match_bracket(src: ptr, t: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, "]") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 从 '{' 出发找匹配的 '}'; 返回 '}' 的下标。
fn chk_match_brace(src: ptr, t: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "{") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, "}") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 结构体有没有这个字段 (只看名字位置)。**必须与类型分开**: 字段类型可能是泛型形参
/// `T`, 那时 `chk_ty_range` 返回 0 (未知) —— 把"类型未知"当成"没有这个字段"就是假阳性
/// (native_gen 的 `Pair { a: 7 }` 与 `p.a` 正是这么被误报的)。
fn chk_sfield_exists(src: ptr, t: ptr, brc: u32, fname: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if at_name == 1 && chk_tok_kind(t, j) == 0 {
            if same(src, t, j, fname) {
                return 1;
            }
            at_name = 0;
        }
        if chk_tok_is(src, t, j, "<") || chk_tok_is(src, t, j, "[")
                || chk_tok_is(src, t, j, "(") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ">") || chk_tok_is(src, t, j, "]")
                || chk_tok_is(src, t, j, ")") {
            d = d - 1;
        }
        if d == 0 && chk_tok_is(src, t, j, ",") {
            at_name = 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 结构体字段类型 (0 = 未知或没有这个字段); brc = 声明体的 '{'。
/// 「有没有」用 `chk_sfield_exists` 判, 这个函数只管类型。
/// 只在"字段名位置"上比 (紧跟 '{' 或字段分隔的 ','), 否则字段**类型**里出现的同名 token
/// 会被误判成字段。`<...>` / `[...]` / `(...)` 里的逗号不是字段分隔。
fn chk_sfield_ty(src: ptr, t: ptr, s: ptr, n: u32, tyt: ptr, brc: u32, fname: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if at_name == 1 && chk_tok_kind(t, j) == 0 {
            if same(src, t, j, fname) {
                if chk_tok_is(src, t, j + 1, ":") {
                    let tl: u32 = j + 2;
                    let te: u32 = chk_skip_type(src, t, tl);
                    return chk_ty_range(src, t, s, n, tyt, tl, te);
                }
            }
            at_name = 0;
        }
        if chk_tok_is(src, t, j, "<") || chk_tok_is(src, t, j, "[")
                || chk_tok_is(src, t, j, "(") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ">") || chk_tok_is(src, t, j, "]")
                || chk_tok_is(src, t, j, ")") {
            d = d - 1;
        }
        if d == 0 && chk_tok_is(src, t, j, ",") {
            at_name = 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 枚举变体序号+1 (0 = 无此变体); brc = 声明体的 '{'。
fn chk_evariant_idx(src: ptr, t: ptr, brc: u32, vname: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let idx: u32 = 0;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if at_name == 1 && chk_tok_kind(t, j) == 0 {
            idx = idx + 1;
            if same(src, t, j, vname) {
                return idx;
            }
            at_name = 0;
        }
        if chk_tok_is(src, t, j, ",") {
            at_name = 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 枚举变体的载荷类型区间 ((plo<<32)|phi); 0 = 无载荷或无此变体。
fn chk_epayload_range(src: ptr, t: ptr, brc: u32, vname: u32) -> u64 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "}") {
        if at_name == 1 && chk_tok_kind(t, j) == 0 {
            if same(src, t, j, vname) {
                if chk_tok_is(src, t, j + 1, "(") {
                    let plo: u32 = j + 2;
                    let phi: u32 = chk_skip_type(src, t, plo);
                    return (plo as u64) * 4294967296 + (phi as u64);
                }
                return 0;
            }
            at_name = 0;
        }
        if chk_tok_is(src, t, j, ",") {
            at_name = 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 函数第 k 个形参的类型编码 (从 aux 记的 '(' 重扫); 越界 -> 0。
/// **不建二维表**的理由见 sym_get 的注释 (每函数 10 个形参类型要 40B x 函数数)。
fn chk_param_ty(src: ptr, t: ptr, s: ptr, n: u32, tyt: ptr, slot0: u32, k: u32) -> u32 {
    let lp: u32 = load32(s, slot0 * 20 + 16);
    let i: u32 = lp + 1;
    let idx: u32 = 0;
    while chk_tok_kind(t, i) != 4 && !chk_tok_is(src, t, i, ")") {
        let tl: u32 = i + 2;
        let te: u32 = chk_skip_type(src, t, tl);
        if idx == k {
            return chk_ty_range(src, t, s, n, tyt, tl, te);
        }
        idx = idx + 1;
        i = te;
        if chk_tok_is(src, t, i, ",") {
            i = i + 1;
        }
    }
    return 0;
}

/// 方法表查表: 接收者类型编码 + 方法名 -> 槽位+1 (0 = 没有)。
/// 参考实现把 impl 方法改名成 `Type_method` 放进同一张函数表; 这里用
/// (接收者编码, 名字) 两元组当身份, 不造合成名字 (符号表没有合成 token 的位置)。
fn chk_lookup_method(src: ptr, t: ptr, s: ptr, n: u32, recv: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if load32(s, i * 20 + 4) == K_METHOD && load32(s, i * 20 + 16) == recv
                && same(src, t, load32(s, i * 20), name_tok) {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 按名字找方法 (不看接收者) —— 第三遍给方法体找返回类型用
/// (方法体里也要查 `return` 的类型, 而 `chk_lookup_slot` 刻意跳过方法)。
fn chk_lookup_method_any(src: ptr, t: ptr, s: ptr, n: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if load32(s, i * 20 + 4) == K_METHOD && same(src, t, load32(s, i * 20), name_tok) {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 内建函数第 k 个形参的期望类型 (镜像 lomentc.BUILTINS 的第一项); 未知 -> 0。
fn chk_builtin_arg(src: ptr, t: ptr, i: u32, k: u32) -> u32 {
    if k == 0 {
        if chk_tok_is(src, t, i, "str_len") || chk_tok_is(src, t, i, "str_eq")
                || chk_tok_is(src, t, i, "str_concat") || chk_tok_is(src, t, i, "str_byte")
                || chk_tok_is(src, t, i, "str_ptr")
                || chk_tok_is(src, t, i, "thread_spawn") {
            return (1 << TY_KIND_SHIFT) + 10;          // str
        }
        if chk_tok_is(src, t, i, "free") || chk_tok_is(src, t, i, "load8")
                || chk_tok_is(src, t, i, "store8") || chk_tok_is(src, t, i, "atomic_add")
                || chk_tok_is(src, t, i, "ptr_add") || chk_tok_is(src, t, i, "ptr_sub") {
            return (1 << TY_KIND_SHIFT) + 11;          // ptr
        }
        if chk_tok_is(src, t, i, "inb") || chk_tok_is(src, t, i, "outb") {
            return (1 << TY_KIND_SHIFT) + 2;           // u16
        }
        if chk_tok_is(src, t, i, "get_bits") || chk_tok_is(src, t, i, "set_bits") {
            return (1 << TY_KIND_SHIFT) + 1;           // u8
        }
        if chk_tok_is(src, t, i, "syscall4") || chk_tok_is(src, t, i, "syscall6")
            || chk_tok_is(src, t, i, "syscall7") {
            return (1 << TY_KIND_SHIFT) + 4;           // u64
        }
        return (1 << TY_KIND_SHIFT) + 3;               // 其余 (panic/alloc) = u32
    }
    if chk_tok_is(src, t, i, "str_eq") || chk_tok_is(src, t, i, "str_concat") {
        if k == 1 {
            return (1 << TY_KIND_SHIFT) + 10;
        }
    }
    if chk_tok_is(src, t, i, "str_byte") && k == 1 {
        return (1 << TY_KIND_SHIFT) + 3;               // u32
    }
    if (chk_tok_is(src, t, i, "load8") || chk_tok_is(src, t, i, "atomic_add")
            || chk_tok_is(src, t, i, "ptr_add") || chk_tok_is(src, t, i, "ptr_sub"))
            && k == 1 {
        return (1 << TY_KIND_SHIFT) + 3;
    }
    if chk_tok_is(src, t, i, "store8") {
        if k == 1 {
            return (1 << TY_KIND_SHIFT) + 3;
        }
        if k == 2 {
            return (1 << TY_KIND_SHIFT) + 1;           // u8
        }
    }
    if chk_tok_is(src, t, i, "outb") && k == 1 {
        return (1 << TY_KIND_SHIFT) + 1;               // u8
    }
    if chk_tok_is(src, t, i, "get_bits") {
        if k == 1 || k == 2 {
            return (1 << TY_KIND_SHIFT) + 3;
        }
    }
    if chk_tok_is(src, t, i, "set_bits") {
        if k == 1 || k == 2 {
            return (1 << TY_KIND_SHIFT) + 3;
        }
        if k == 3 {
            return (1 << TY_KIND_SHIFT) + 1;
        }
    }
    if chk_tok_is(src, t, i, "syscall4") || chk_tok_is(src, t, i, "syscall6")
        || chk_tok_is(src, t, i, "syscall7") || chk_tok_is(src, t, i, "thread_spawn") {
        return (1 << TY_KIND_SHIFT) + 4;
    }
    return 0;
}

/// 数组字面量第 k 个元素的 [lo,hi) 区间 (ni = '[' 下标); 越界 -> 0。
fn chk_arr_elem(src: ptr, t: ptr, ni: u32, k: u32) -> u64 {
    let d: u32 = 0;
    let j: u32 = ni;
    let idx: u32 = 0;
    let lo: u32 = 0;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "[") || chk_tok_is(src, t, j, "(") {
            d = d + 1;
            if d == 1 {
                lo = j + 1;
            }
        } else if (chk_tok_is(src, t, j, "]") || chk_tok_is(src, t, j, ")")) && d == 1 {
            // 最后一个元素: 数组字面量以 ']' 收尾, 调用实参以 ')' 收尾 —— 只认 ']' 的话
            // 实参区间永远取不到 (call-arg-type / slice-len-arg-type 都因此少报)
            if idx == k {
                return (lo as u64) * 4294967296 + (j as u64);
            }
            return 0;
        } else if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        } else if d == 1 && chk_tok_is(src, t, j, ",") {
            if idx == k {
                return (lo as u64) * 4294967296 + (j as u64);
            }
            idx = idx + 1;
            lo = j + 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 从 i 起找深度 0 的目标 token (用于切语句边界); eof/越界返回 hi。
fn chk_find_at(src: ptr, t: ptr, i: u32, hi: u32, what: str) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while j < hi && chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        }
        if d == 0 && chk_tok_is(src, t, j, what) {
            return j;
        }
        j = j + 1;
    }
    return hi;
}

/// 形参表 -> 局部环境 (只记类型, 不报错: 类型检查已在第一遍做过)。
fn chk_env_params(src: ptr, t: ptr, s: ptr, n: u32, env: ptr, envc: u32,
                  lp: u32, hi: u32, oc2: ptr) -> u32 {
    let i: u32 = lp + 1;
    let c: u32 = envc;
    while i < hi && chk_tok_kind(t, i) != 4 && !chk_tok_is(src, t, i, ")") {
        if chk_tok_is(src, t, i, "&") {
            i = i + 1;
            if chk_tok_is(src, t, i, "mut") {
                i = i + 1;
            }
            i = i + 1;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else if chk_tok_is(src, t, i, "self") {
            i = i + 1;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        } else {
            let nm: u32 = i;
            i = i + 2;              // 名字 ':'
            let te: u32 = chk_skip_type(src, t, i);
            c = chk_env_add(t, env, c, nm,
                            chk_ty_range(src, t, s, n, chk_tyt_of(oc2), i, te));
            i = te;
            if chk_tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
    }
    return c;
}

/// 数组字面量 `[a, b, c]` 的元素个数 (空 -> 0); ni = `[` 的下标。
fn chk_arr_count(src: ptr, t: ptr, ni: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = ni;
    let c: u32 = 0;
    let any: u32 = 0;
    while chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "[") || chk_tok_is(src, t, j, "(") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, "]") || chk_tok_is(src, t, j, ")") {
            d = d - 1;
            if d == 0 {
                if any == 0 {
                    return 0;
                }
                return c + 1;
            }
        }
        if d == 1 && chk_tok_is(src, t, j, ",") {
            c = c + 1;
        }
        any = 1;
        j = j + 1;
    }
    return 0;
}

/// 追加一条诊断 (错误缓冲 + **偏移格**)。偏移用一格内存回传, 而不是让每一层递归都
/// 多回传一个 u32 —— Loment 没有 out 参数, 返回值只有一个。
fn chk_pub(src: ptr, t: ptr, oc: ptr, p: ptr, code: u32, tok: u32) {
    store32(oc, 0, sym_pub(src, t, p, load32(oc, 0), code, tok));
}

/// 偏移格 -> 类型表块基址 (两者在同一个块里, 见 chk_arena_tyt)。
fn chk_tyt_of(oc: ptr) -> ptr {
    return ptr_sub(oc, 4096);
}

/// 找语句里第一个"赋值号": 深度 0 的 `=` 且不是 `==` 的第二个字符、也不是 `=>`。
/// 找不到 -> 0 (语句起点不会是 token 0, 所以 0 可以当"没有")。
fn chk_find_assign(src: ptr, t: ptr, i: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while j < hi && chk_tok_kind(t, j) != 4 {
        if d == 0 && chk_tok_is(src, t, j, "=") {
            if !chk_tok_is(src, t, j + 1, "=") && !chk_tok_is(src, t, j + 1, ">") {
                return j;
            }
        }
        if chk_tok_is(src, t, j, "(") || chk_tok_is(src, t, j, "[") {
            d = d + 1;
        }
        if chk_tok_is(src, t, j, ")") || chk_tok_is(src, t, j, "]") {
            d = d - 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 名字在不在"已移动"表里 (表在 tyt 块尾: [3576] 条数, [3584..) 每个名字 token 8 字节)。
/// 按**名字文本**比, 不是 token 下标 —— 同一个变量在每条语句里都是不同的 token。
fn chk_mv_has(src: ptr, t: ptr, tyt: ptr, name_tok: u32) -> u32 {
    let n: u32 = load32(tyt, 3576);
    let i: u32 = 0;
    while i < n {
        if same(src, t, load32(tyt, 3584 + i * 8), name_tok) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn chk_mv_add(src: ptr, t: ptr, tyt: ptr, name_tok: u32) {
    // 不用 `return;` 提前退出 —— Loment 的 return 必须带表达式
    if chk_mv_has(src, t, tyt, name_tok) == 0 {
        let n: u32 = load32(tyt, 3576);
        if n < 63 {
            store32(tyt, 3584 + n * 8, name_tok);
            store32(tyt, 3576, n + 1);
        }
    }
}

// ------------------------------------------------ E029 已释放表（`docs/253` §5.1）
//
// **与 `moved` 分开的第二张表**：移走是**所有权**的事（E006），释放是**合法性**的事
// （E029）—— 两回事，两张表同构（条数 + 8 字节一条的名字 token）。
//
// ⚠ **偏移 2048 是挑出来的**：`tyt` 块 4112 字节（`chk_arena_tyt` / `chk_arena_bytes`），
// 而 `moved` 那族从 3520 起；类型表用 0..1028（128 条）。**1028..3520 这一段是空的** ——
// 新表放中间最安全（离两头都远，将来任一张表扩容都不会撞上）。
// ⚠ **它必须与类型表一起按函数清零**（见 `check_arena` 里 `chk_body` 之前那三行）——
// 不清就是整单元单调 bump。
const CHK_FR_ON: u32 = 2044;   // 0 = 还没算, 1 = `lms` 开着, 2 = 关着 (缓存)
const CHK_FR_N: u32 = 2048;    // 条数
const CHK_FR_T: u32 = 2056;    // 表项起始

fn chk_fr_has(src: ptr, t: ptr, tyt: ptr, name_tok: u32) -> u32 {
    let n: u32 = load32(tyt, CHK_FR_N);
    let i: u32 = 0;
    while i < n {
        if same(src, t, load32(tyt, CHK_FR_T + i * 8), name_tok) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn chk_fr_add(src: ptr, t: ptr, tyt: ptr, name_tok: u32) {
    if chk_fr_has(src, t, tyt, name_tok) == 0 {
        let n: u32 = load32(tyt, CHK_FR_N);
        if n < 63 {
            store32(tyt, CHK_FR_T + n * 8, name_tok);
            store32(tyt, CHK_FR_N, n + 1);
        }
    }
}

/// 重新绑定（`let` / 赋值）= 这个名字不再指那块死掉的块 ⇒ 从表里拿掉。
/// **与参考实现同口径**（那边是 `freed.discard`，`tools/lomentc.py` 的 `_move_check`）——
/// 少了它，"`free` 之后重新 `alloc` 再读"会**假阳性**，而假阳性正是这张表最该避免的
/// （`loment_rule_parity` 判 `EXTRA`）。
///
/// 用"最后一个补上这一格"删 —— 顺序对这张表不重要（它只做成员判定）。
/// ⚠ **不用裸 `return`**：Loment 的 `return` 必须带表达式。
fn chk_fr_del(src: ptr, t: ptr, tyt: ptr, name_tok: u32) {
    let n: u32 = load32(tyt, CHK_FR_N);
    let i: u32 = 0;
    let done: u32 = 0;
    while i < n && done == 0 {
        if same(src, t, load32(tyt, CHK_FR_T + i * 8), name_tok) {
            store32(tyt, CHK_FR_T + i * 8, load32(tyt, CHK_FR_T + (n - 1) * 8));
            store32(tyt, CHK_FR_N, n - 1);
            done = 1;
        }
        i = i + 1;
    }
}

/// `lms` 开着吗（`docs/253`）—— **带缓存**：`chk_use` 会对每一个标识符问一次，
/// 每次都扫一遍 token 流是 O(n²)。算一次存在 `CHK_FR_ON`，按函数清零。
fn chk_lms_c(src: ptr, t: ptr, tyt: ptr) -> u32 {
    let v: u32 = load32(tyt, CHK_FR_ON);
    if v == 0 {
        v = 2;
        if chk_lms_on(src, t) == 1 {
            v = 1;
        }
        store32(tyt, CHK_FR_ON, v);
    }
    if v == 1 {
        return 1;
    }
    return 0;
}

/// 局部环境里第 idx 个名字 (0 = 不在; 否则 下标+1)。
fn chk_env_idx(src: ptr, t: ptr, env: ptr, envc: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < envc {
        if same(src, t, load32(env, i * 8), name_tok) {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 类型是不是**非 Copy** (struct / 数组) —— 参考实现的 `_is_copy_type` 取反。
fn chk_ty_noncopy(s: ptr, tyt: ptr, v: u32) -> u32 {
    if v == 0 {
        return 0;
    }
    if chk_ty_is_arr(tyt, v) == 1 {
        return 1;
    }
    if chk_ty_kind(v) == TY_K_NAMED {
        let s0: u32 = v % (1 << TY_KIND_SHIFT);
        if load32(s, s0 * 20 + 4) == K_STRUCT {
            return 1;
        }
    }
    return 0;
}

/// 表达式区间里的**使用**检查: 已经移动过的变量不能再用 (E006)。
/// 借用的位置 (`&x` / `&mut x`) 不算使用 —— 参考实现的 `use(Un)` 对 `&`/`&mut` 不递归。
fn chk_use(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
           lh: u64, tyt: ptr, p: ptr, oc: ptr) {
    let lo: u32 = chk_lhlo(lh);
    let hi: u32 = chk_lhhi(lh);
    let j: u32 = lo;
    while j < hi && chk_tok_kind(t, j) != 4 {
        if chk_tok_kind(t, j) == 0 {
            let borrowed: u32 = 0;
            if j > lo && chk_tok_is(src, t, j - 1, "&") {
                borrowed = 1;
            }
            if j > lo + 1 && chk_tok_is(src, t, j - 1, "mut")
                    && chk_tok_is(src, t, j - 2, "&") {
                borrowed = 1;
            }
            if borrowed == 0 && chk_mv_has(src, t, tyt, j) == 1 {
                chk_pub(src, t, oc, p, E_MOVE, j);      // 变量 X 已被移动, 不能再用
            } else if borrowed == 0 && chk_fr_has(src, t, tyt, j) == 1
                    && chk_lms_c(src, t, tyt) == 1 {
                chk_pub(src, t, oc, p, E_BOUND_FREE, j);   // 指向的块已经被 `free`, 不能再用
            }
        }
        j = j + 1;
    }
}

/// 移动检查 (M13/M17, 对照参考实现的 `_move_check`):
///   - 非 Copy 类型的变量"传出去"后就已移动, 再用 -> E006
///   - `return &局部` -> E012 (悬垂; 形参不算局部)
/// 逐语句顺序走; 分支体里的移动会**泄漏**出来 —— 与参考实现一致 (保守方向)。
fn chk_moves(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
             b: u32, e: u32, p: ptr, oc: ptr) {
    let tyt: ptr = chk_tyt_of(oc);
    let mv: u32 = 0;
    let j: u32 = b + 1;
    while j < e && chk_tok_kind(t, j) != 4 {
        if chk_tok_is(src, t, j, "{") || chk_tok_is(src, t, j, "}")
                || chk_tok_is(src, t, j, ";") || chk_tok_is(src, t, j, "else")
                || chk_tok_is(src, t, j, "=>") {
            j = j + 1;
        } else if chk_tok_is(src, t, j, "let") {
            let k: u32 = j + 2;
            let dty: u32 = 0;
            if chk_tok_is(src, t, k, ":") {
                let tl: u32 = k + 1;
                let te: u32 = chk_skip_type(src, t, tl);
                dty = chk_ty_range(src, t, syms, n, tyt, tl, te);
                k = te;
            }
            let eq: u32 = chk_find_at(src, t, k, e, "=");
            let semi: u32 = chk_find_at(src, t, eq + 1, e, ";");
            if eq < e && semi <= e {
                chk_use(src, t, syms, n, env, envc, chk_lh(eq + 1, semi), tyt, p, oc);
                // `let t: T = s;` 且 s 是非 Copy -> s 被移动
                if semi == eq + 2 {
                    let rt: u32 = chk_name_ty(src, t, syms, n, env, envc, eq + 1);
                    if chk_ty_noncopy(syms, tyt, rt) == 1 {
                        chk_mv_add(src, t, tyt, eq + 1);
                    }
                } else {
                    chk_mark_call_moves(src, t, syms, n, env, envc, tyt, eq + 1, semi);
                }
            }
            // **E029**：`let` 重新绑定这个名字 ⇒ 它不再指那块死掉的块（参考实现同口径）。
            chk_fr_del(src, t, tyt, j + 1);
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "return") {
            let semi: u32 = chk_find_at(src, t, j + 1, e, ";");
            chk_use(src, t, syms, n, env, envc, chk_lh(j + 1, semi), tyt, p, oc);
            chk_mark_call_moves(src, t, syms, n, env, envc, tyt, j + 1, semi);
            // 悬垂: `return &x` / `return &mut x`, 且 x 是**局部** (不是形参)。
            // 形参占环境的前 envc 个槽位, 所以"下标+1 > envc"就是局部。
            if chk_tok_is(src, t, j + 1, "&") {
                let o1: u32 = j + 2;
                if chk_tok_is(src, t, o1, "mut") {
                    o1 = o1 + 1;
                }
                if chk_tok_kind(t, o1) == 0 && o1 + 1 == semi {
                    let ei: u32 = chk_env_idx(src, t, env, envc, o1);
                    // 形参占环境前 npar 个槽位: `下标+1 > npar` 才是**局部**变量
                    if ei > load32(tyt, 3528) {
                        chk_pub(src, t, oc, p, E_DANGLE, o1);
                    }
                }
            }
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "if") || chk_tok_is(src, t, j, "while") {
            let lb: u32 = chk_find_at(src, t, j + 1, e, "{");
            chk_use(src, t, syms, n, env, envc, chk_lh(j + 1, lb), tyt, p, oc);
            j = lb;
        } else if chk_tok_is(src, t, j, "for") {
            let lb2: u32 = chk_find_at(src, t, j + 2, e, "{");
            chk_use(src, t, syms, n, env, envc, chk_lh(j + 3, lb2), tyt, p, oc);
            j = lb2;
        } else if chk_tok_is(src, t, j, "match") {
            let lb3: u32 = chk_find_at(src, t, j + 1, e, "{");
            chk_use(src, t, syms, n, env, envc, chk_lh(j + 1, lb3), tyt, p, oc);
            j = lb3;
        } else {
            let eq2: u32 = chk_find_assign(src, t, j, e);
            let semi2: u32 = chk_find_at(src, t, j, e, ";");
            if eq2 != 0 && eq2 < semi2 {
                chk_use(src, t, syms, n, env, envc, chk_lh(eq2 + 1, semi2), tyt, p, oc);
                // 给已移动的变量赋值 -> E006
                if eq2 == j + 1 && chk_mv_has(src, t, tyt, j) == 1 {
                    chk_pub(src, t, oc, p, E_MOVE, j);
                }
                if semi2 == eq2 + 2 {
                    let rt2: u32 = chk_name_ty(src, t, syms, n, env, envc, eq2 + 1);
                    if chk_ty_noncopy(syms, tyt, rt2) == 1 {
                        chk_mv_add(src, t, tyt, eq2 + 1);
                    }
                } else {
                    chk_mark_call_moves(src, t, syms, n, env, envc, tyt, eq2 + 1, semi2);
                }
                // **E029**：给这个名字**重新赋值** ⇒ 它不再指那块死掉的块 —— 从"已释放"
                // 表里拿掉（与参考实现的 `freed.discard` 同口径）。少了它，
                // "`free` 之后重新 `alloc` 又读"会**假阳性**。
                if eq2 == j + 1 && chk_tok_kind(t, j) == 0 {
                    chk_fr_del(src, t, tyt, j);
                }
            } else {
                chk_use(src, t, syms, n, env, envc, chk_lh(j, semi2), tyt, p, oc);
                chk_mark_call_moves(src, t, syms, n, env, envc, tyt, j, semi2);
            }
            if semi2 <= e {
                j = semi2 + 1;
            } else {
                j = e;
            }
        }
    }
}

/// 调用实参里的**移动**: 非 Copy 的单个标识符实参, 且形参不是切片 -> 该变量被移动。
fn chk_mark_call_moves(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
                       tyt: ptr, lo: u32, hi: u32) {
    let slot: u32 = 0;
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo + 1, "(")
            && chk_match_paren(src, t, lo + 1) == hi - 1 {
        slot = chk_lookup_slot(src, t, syms, n, lo);
    }
    let got: u32 = chk_count_args(src, t, lo + 1);
    let k: u32 = 0;
    while k < got && slot != 0 {
        let er: u64 = chk_arr_elem(src, t, lo + 1, k);
        let a1: u32 = chk_lhlo(er);
        let a2: u32 = chk_lhhi(er);
        if a1 + 1 == a2 && chk_tok_kind(t, a1) == 0 {
            let pt: u32 = chk_param_ty(src, t, syms, n, tyt, slot - 1, k);
            if chk_ty_is_slc(tyt, pt) == 0 {
                let at: u32 = chk_name_ty(src, t, syms, n, env, envc, a1);
                if chk_ty_noncopy(syms, tyt, at) == 1 {
                    chk_mv_add(src, t, tyt, a1);
                }
            }
        }
        k = k + 1;
    }
    // **E029**（`docs/253` §5.1）：`free(p)` 之后 `p` 指向的块没了 —— 记进"已释放"表。
    // ⚠ **放在这里而不是调用方**：调用顺序是 `chk_use` 先跑（"用"的检查）、本函数后跑 ——
    // 而 `free` 自己那个实参**是一次合法的用**，先登记就会把 `free(p)` 本身报成
    // "用了已经释放的块"。
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo, "free")
            && chk_tok_is(src, t, lo + 1, "(") && chk_tok_kind(t, lo + 2) == 0
            && chk_lms_c(src, t, tyt) == 1 {
        chk_fr_add(src, t, tyt, lo + 2);
    }
}


/// 参考实现在 `_ds_stmts` 里按"内层表达式的类型是 `Result_*` 单态实例"解糖, 所以
/// 判据就是"内层的类型是 Result"。我这边类型算不到实例 (泛型实例一律记未知), 于是
/// 反着来: 只在**能确定不是** Result 时返回 0 —— 整型字面量, 或者一个被调函数的返回
/// 类型 token 不是 `Result`。
fn chk_q_ok(src: ptr, t: ptr, s: ptr, n: u32, lo: u32, hi: u32) -> u32 {
    if hi == lo + 1 && chk_tok_kind(t, lo) == 1 {
        return 0;                                  // 整型字面量 `1?`
    }
    if chk_tok_kind(t, lo) == 0 && chk_tok_is(src, t, lo + 1, "(")
            && chk_match_paren(src, t, lo + 1) == hi - 1 {
        let slot: u32 = chk_lookup_slot(src, t, s, n, lo);
        if slot != 0 {
            if chk_fn_ret_is_result(src, t, s, slot - 1) == 1 {
                return 1;
            }
            return 0;                              // 调用但返回类型不是 Result
        }
        return 0;
    }
    return 1;                                      // 判不了 -> 保守放过
}

/// 被调函数的返回类型 token 是不是 `Result` (从形参表的 ')' 往后找 `->`)。
fn chk_fn_ret_is_result(src: ptr, t: ptr, s: ptr, slot0: u32) -> u32 {
    let lp: u32 = load32(s, slot0 * 20 + 16);
    let rp: u32 = chk_match_paren(src, t, lp);
    let j: u32 = rp + 1;
    while chk_tok_kind(t, j) != 4 && !chk_tok_is(src, t, j, "{")
            && !chk_tok_is(src, t, j, ";") {
        if chk_tok_is(src, t, j, "-") {
            if chk_tok_is(src, t, j + 2, "Result") {
                return 1;
            }
            return 0;
        }
        j = j + 1;
    }
    return 0;
}


/// 绑定正确; 不给通配就必须穷尽。所有情形都归 E008。
/// `lh` = (j << 32) | e —— j = `match` 下标, e = 函数体结束 (找边界用)。
fn chk_match(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
             lh: u64, tyt: ptr, p: ptr, oc: ptr) -> u32 {
    let j: u32 = chk_lhlo(lh);
    let e: u32 = chk_lhhi(lh);
    let lb: u32 = chk_find_at(src, t, j + 1, e, "{");
    if lb >= e {
        return e;
    }
    let eb: u32 = chk_match_brace(src, t, lb);
    let st: u32 = chk_tex(src, t, syms, n, env, envc, chk_lh(j + 1, lb), tyt, p, oc);
    // 主体枚举: 具名类型且 kind == K_ENUM 才算
    let eslot: u32 = 0;
    if chk_ty_kind(st) == TY_K_NAMED {
        let s0: u32 = st % (1 << TY_KIND_SHIFT);
        if load32(syms, s0 * 20 + 4) == K_ENUM {
            eslot = s0 + 1;
        }
    }
    // "不是枚举"：已知的非枚举类型要报; 字面量主体 (整型/字符串/bool) 也知道不是枚举。
    // 其余 (类型未知) 保守跳过 —— 参考实现在未知时也报, 但我们会假阳性 (docs/150)。
    let lit: u32 = 0;
    if chk_tok_kind(t, j + 1) == 1 || chk_tok_kind(t, j + 1) == 2 {
        lit = 1;
    }
    if chk_tok_is(src, t, j + 1, "true") || chk_tok_is(src, t, j + 1, "false") {
        lit = 1;
    }
    if eslot == 0 && (lit == 1 || (st != 0 && chk_ty_kind(st) != TY_K_NAMED)) {
        chk_pub(src, t, oc, p, E_PATTERN, j);
    }
    let brc: u32 = 0;
    if eslot != 0 {
        brc = load32(syms, (eslot - 1) * 20 + 16);
    }
    let has_wild: u32 = 0;
    let k: u32 = lb + 1;
    while k < eb && chk_tok_kind(t, k) != 4 {
        if chk_tok_is(src, t, k, "_") {
            has_wild = 1;
            k = k + 1;
        } else if chk_tok_kind(t, k) == 0 && chk_tok_is(src, t, k + 1, ":")
                && chk_tok_is(src, t, k + 2, ":") {
            let ptok: u32 = k;
            let vtok: u32 = k + 3;
            let bnd: u32 = 0;
            if chk_tok_is(src, t, k + 4, "(") {
                bnd = k + 5;
            }
            if eslot != 0 {
                let pslot: u32 = chk_lookup_slot(src, t, syms, n, ptok);
                if pslot != eslot {
                    chk_pub(src, t, oc, p, E_PATTERN, ptok);      // 模式与主体枚举不符
                } else if chk_evariant_idx(src, t, brc, vtok) == 0 {
                    chk_pub(src, t, oc, p, E_PATTERN, vtok);      // 无此变体
                } else {
                    let pr: u64 = chk_epayload_range(src, t, brc, vtok);
                    if pr != 0 && bnd == 0 {
                        chk_pub(src, t, oc, p, E_PATTERN, vtok);  // 有载荷需绑定变量
                    }
                    if pr == 0 && bnd != 0 {
                        chk_pub(src, t, oc, p, E_PATTERN, vtok);  // 无载荷不能绑定
                    }
                    let cbind: u32 = envc;
                    if pr != 0 && bnd != 0 {
                        // 绑定的变量按载荷类型进环境 (臂体里要用)
                        let plo: u32 = chk_lhlo(pr);
                        let phi: u32 = chk_lhhi(pr);
                        let pty: u32 = chk_ty_range(src, t, syms, n, tyt, plo, phi);
                        cbind = chk_env_add(t, env, envc, bnd, pty);
                    }
                    // 臂体: '=>' 之后的块。**无论有没有载荷都要走** —— 少了这一步,
                    // `E::A(x) => { return x; }` (A 无载荷, x 其实没绑定) 里的 `x`
                    // 就不会被查, 参考实现那条"使用未声明的变量"(E002) 会漏报。
                    let ar: u32 = chk_find_at(src, t, vtok + 1, eb, "{");
                    if ar < eb {
                        let ae: u32 = chk_match_brace(src, t, ar);
                        chk_body(src, t, syms, n, env, cbind, chk_lh(ar, ae), 0, p, oc);
                        k = ae;
                    }
                    // 重复模式: 前面某个臂用过同样的 (枚举, 变体)
                    let k3: u32 = lb + 1;
                    while k3 < ptok {
                        if chk_tok_kind(t, k3) == 0 && chk_tok_is(src, t, k3 + 1, ":")
                                && chk_tok_is(src, t, k3 + 2, ":")
                                && same(src, t, k3, ptok) && same(src, t, k3 + 3, vtok) {
                            chk_pub(src, t, oc, p, E_PATTERN, vtok);
                        }
                        k3 = k3 + 1;
                    }
                }
            }
            if k < eb {
                k = k + 1;
            }
        } else {
            k = k + 1;
        }
    }
    // 穷尽性: 没有通配时, 枚举的每个变体都要在某个臂里出现过
    if eslot != 0 && has_wild == 0 {
        let vj: u32 = brc + 1;
        let at_name: u32 = 1;
        while chk_tok_kind(t, vj) != 4 && !chk_tok_is(src, t, vj, "}") {
            if at_name == 1 && chk_tok_kind(t, vj) == 0 {
                let hit: u32 = 0;
                let k4: u32 = lb + 1;
                while k4 < eb && chk_tok_kind(t, k4) != 4 {
                    if chk_tok_is(src, t, k4, ":") && chk_tok_is(src, t, k4 + 1, ":") {
                        if same(src, t, k4 + 2, vj) {
                            hit = 1;
                        }
                    }
                    k4 = k4 + 1;
                }
                if hit == 0 {
                    chk_pub(src, t, oc, p, E_PATTERN, vj);        // match 不穷尽
                }
                at_name = 0;
            }
            if chk_tok_is(src, t, vj, ",") {
                at_name = 1;
            }
            vj = vj + 1;
        }
    }
    return eb;
}

/// 语句级检查 (批次 2/3): let / return / 赋值 / if / while / for / match。
///
/// 形参压到 10 个: 自举 codegen 的实参上限是 10 (形参类型表步长 80 = 10 槽), 超限会
/// `panic`。所以函数体的区间用 u64 **打包**传 (b << 32 | e), 诊断偏移走**一格内存**
/// (`oc`, 由 tyt 块 +1024 得到) 而不是返回值 —— 否则每一层递归都要多回传一个 u32。
/// ret = 函数的返回类型编码。
fn chk_body(src: ptr, t: ptr, syms: ptr, n: u32, env: ptr, envc: u32,
            be: u64, ret: u32, p: ptr, oc: ptr) {
    let b: u32 = (be / 4294967296) as u32;
    let e: u32 = (be % 4294967296) as u32;
    let tyt: ptr = chk_tyt_of(oc);
    let j: u32 = b + 1;
    let c: u32 = envc;
    // 数值字面量的**不支持形式**（`0b1010` / `1_000` / `1.5`，issue #12）—— 走一遍 token
    // 报到字面量自己身上，而不是等它被切成两个 token 后在下游出洋相。
    let q: u32 = b;
    while q < e && chk_tok_kind(t, q) != 4 {
        if chk_bad_num_suffix(src, t, q) {
            chk_pub(src, t, oc, p, E_PARSE, q);
        }
        q = q + 1;
    }
    while j < e && chk_tok_kind(t, j) != 4 {
        // 结构 token 直接跳过: `while x {` 的 `{` 若落到"赋值"分支, 会一路扫到体内第一个
        // `=` 并把它当成赋值语句, 报出"赋值目标不是左值"(ok.lomt 的 `14@84:{` 假报)。
        if chk_tok_is(src, t, j, "{") || chk_tok_is(src, t, j, "}")
                || chk_tok_is(src, t, j, ";") || chk_tok_is(src, t, j, "else")
                || chk_tok_is(src, t, j, "=>") {
            j = j + 1;
        } else if chk_tok_is(src, t, j, "match") {
            j = chk_match(src, t, syms, n, env, c, chk_lh(j, e), tyt, p, oc);
            if j < e {
                j = j + 1;
            }
        } else if chk_tok_is(src, t, j, "let") && !(j > 0 && chk_tok_is(src, t, j - 1, "if")) {
            let nm: u32 = j + 1;
            let dty: u32 = 0;
            let dlo: u32 = 0;
            let dhi: u32 = 0;
            let k: u32 = j + 2;
            if chk_tok_is(src, t, k, ":") {
                k = k + 1;
                dlo = k;
                k = chk_skip_type(src, t, k);
                dhi = k;
                dty = chk_ty_range(src, t, syms, n, tyt, dlo, dhi);
            }
            let eq: u32 = chk_find_at(src, t, k, e, "=");
            let semi: u32 = chk_find_at(src, t, eq + 1, e, ";");
            if eq < e && semi <= e {
                // `=` 后面必须能开始一个表达式 (`let v: u32 = @ 1;`，issue #395/#49 的表达式那半)
                if !chk_expr_start(src, t, eq + 1) {
                    chk_pub(src, t, oc, p, E_PARSE, eq + 1);
                }
                let t2: u32 = chk_tex(src, t, syms, n, env, c,
                                      ((eq + 1) as u64) * 4294967296 + (semi as u64), tyt, p, oc);
                if t2 != 0 && dty != 0 && chk_ty_eq(tyt, t2, dty) == 0 {
                    chk_pub(src, t, oc, p, E_TMISMATCH, nm);
                }
                // 数组长度 (参考实现只在"声明是数组 且 字面量是数组"时比)
                if chk_ty_is_arr(tyt, dty) == 1 && chk_tok_is(src, t, eq + 1, "[") {
                    if chk_ty_b(tyt, dty) != chk_arr_count(src, t, eq + 1) {
                        chk_pub(src, t, oc, p, E_ARR, nm);
                    }
                }
            }
            c = chk_env_add(t, env, c, nm, dty);
            store32(tyt, 3520, c);   // 最新环境条数 (chk_moves 在 chk_body 之后跑, 读这个)
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "return") {
            let semi: u32 = chk_find_at(src, t, j + 1, e, ";");
            let t3: u32 = chk_tex(src, t, syms, n, env, c,
                                  ((j + 1) as u64) * 4294967296 + (semi as u64), tyt, p, oc);
            if t3 != 0 && ret != 0 && chk_ty_eq(tyt, t3, ret) == 0 {
                chk_pub(src, t, oc, p, E_TMISMATCH, j);
            }
            if semi <= e {
                j = semi + 1;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "if") && chk_tok_is(src, t, j + 1, "let") {
            // `if let E::V(x) = e { ... }` —— 参考实现把 `let` 换成 `=` 再按已解糖的
            // 形式检查。这里: 走一遍被匹配的表达式, 并把绑定的载荷变量放进环境
            // (不绑的话块里用到 `x` 会变成"未知"; 将来加"未声明变量"规则时还会假报)。
            let eq3: u32 = chk_find_at(src, t, j + 2, e, "=");
            let lb3: u32 = chk_find_at(src, t, eq3 + 1, e, "{");
            chk_tex(src, t, syms, n, env, c, chk_lh(eq3 + 1, lb3), tyt, p, oc);
            if chk_tok_kind(t, j + 2) == 0 && chk_tok_is(src, t, j + 3, ":")
                    && chk_tok_is(src, t, j + 4, ":") {
                let vslot: u32 = chk_lookup_slot(src, t, syms, n, j + 2);
                if vslot != 0 && load32(syms, (vslot - 1) * 20 + 4) == K_ENUM {
                    let vbrc: u32 = load32(syms, (vslot - 1) * 20 + 16);
                    let pr2: u64 = chk_epayload_range(src, t, vbrc, j + 5);
                    if pr2 != 0 && chk_tok_is(src, t, j + 6, "(") {
                        let pty2: u32 = chk_ty_range(src, t, syms, n, tyt,
                                                     chk_lhlo(pr2), chk_lhhi(pr2));
                        c = chk_env_add(t, env, c, j + 7, pty2);
                    }
                }
            }
            if lb3 < e {
                j = lb3;
            } else {
                j = e;
            }
        } else if chk_tok_is(src, t, j, "if") || chk_tok_is(src, t, j, "while") {
            // `if let ...` 是模式, 不是条件表达式
            if !(chk_tok_is(src, t, j, "if") && chk_tok_is(src, t, j + 1, "let")) {
                let lb: u32 = chk_find_at(src, t, j + 1, e, "{");
                let ct: u32 = chk_tex(src, t, syms, n, env, c,
                                      ((j + 1) as u64) * 4294967296 + (lb as u64), tyt, p, oc);
                if ct != 0 && ct != TY_BOOL {
                    chk_pub(src, t, oc, p, E_TMISMATCH, j);
                }
                j = lb;
            } else {
                j = j + 1;
            }
        } else if chk_tok_is(src, t, j, "for") {
            let var: u32 = j + 1;
            let lo_t: u32 = 0;
            let hi_t: u32 = 0;
            let d1: u32 = chk_find_at(src, t, j + 2, e, ".");
            let lb2: u32 = chk_find_at(src, t, d1 + 1, e, "{");
            if d1 < e {
                lo_t = chk_tex(src, t, syms, n, env, c,
                               ((j + 3) as u64) * 4294967296 + (d1 as u64), tyt, p, oc);
                hi_t = chk_tex(src, t, syms, n, env, c,
                               ((d1 + 2) as u64) * 4294967296 + (lb2 as u64), tyt, p, oc);
            }
            if lo_t != 0 && chk_ty_is_int(lo_t) == 0 {
                chk_pub(src, t, oc, p, E_TMISMATCH, j);
            }
            if hi_t != 0 && chk_ty_is_int(hi_t) == 0 {
                chk_pub(src, t, oc, p, E_TMISMATCH, j);
            }
            let vt: u32 = lo_t;
            if vt == 0 {
                vt = hi_t;
            }
            if vt == 0 {
                vt = TY_U32;
            }
            c = chk_env_add(t, env, c, var, vt);
            if lb2 < e {
                j = lb2;
            } else {
                j = e;
            }
        } else {
            // 语句起点的 token 必须能开始一个表达式。`@` 这类词法上合法、L1 里却哪一处都不是
            // 表达式的 token，原先在这里被静默咽掉（issue #49）。参考实现是同一条判断，报 E019。
            if !chk_expr_start(src, t, j) {
                chk_pub(src, t, oc, p, E_PARSE, j);
            }
            // 赋值或表达式语句: 找深度 0 的 `=` (排除 `==` 的第二个字符与 `=>`)
            let eq2: u32 = chk_find_assign(src, t, j, e);
            let semi2: u32 = chk_find_at(src, t, j, e, ";");
            if eq2 != 0 && eq2 < semi2 {
                // 参考实现: 先走 target/expr, 再判左值/只读切片/未声明/类型
                let tt: u32 = chk_tex(src, t, syms, n, env, c,
                                      (j as u64) * 4294967296 + (eq2 as u64), tyt, p, oc);
                let et: u32 = chk_tex(src, t, syms, n, env, c,
                                      ((eq2 + 1) as u64) * 4294967296 + (semi2 as u64),
                                      tyt, p, oc);
                let is_ident: u32 = 0;
                let is_index: u32 = 0;
                if eq2 == j + 1 && chk_tok_kind(t, j) == 0 {
                    is_ident = 1;
                }
                if chk_tok_kind(t, j) == 0 && chk_tok_is(src, t, j + 1, "[") {
                    if chk_match_bracket(src, t, j + 1) == eq2 - 1 {
                        is_index = 1;
                    }
                }
                if is_index == 1 {
                    // 只读切片不能写 (形参需声明 mut [T]): 判的是**对象**类型
                    // (`xs[0]` 里 xs 的类型), 不是下标表达式的类型。
                    let ot: u32 = chk_tex(src, t, syms, n, env, c,
                                          (j as u64) * 4294967296 + ((j + 1) as u64),
                                          tyt, p, oc);
                    if chk_ty_is_slc(tyt, ot) == 1 && chk_ty_b(tyt, ot) == 0 {
                        chk_pub(src, t, oc, p, E_SLICE, j);
                    }
                }
                if is_ident == 1 {
                    if chk_env_get(src, t, env, c, j) == 0 {
                        chk_pub(src, t, oc, p, E_TYPE, j);        // 赋值未声明的变量
                    }
                } else if is_index == 0 {
                    chk_pub(src, t, oc, p, E_LVAL, j);            // 赋值目标不是左值
                }
                if tt != 0 && et != 0 && chk_ty_eq(tyt, tt, et) == 0 {
                    chk_pub(src, t, oc, p, E_TMISMATCH, j);
                }
            } else {
                // 表达式语句: 遍历它 (调用里的实参/字段/下标错误都在里面)
                chk_tex(src, t, syms, n, env, c,
                        (j as u64) * 4294967296 + (semi2 as u64), tyt, p, oc);
                // 一个**孤零零的标识符**当语句 (`break;`) 是最容易漏的一格: 参考实现把它当
                // 表达式求值, 于是"未声明的变量"当场就报; 这里原先一声不吭 —— 已发布编译器
                // 对 `break;` 完全静默、退出码 0 (issue #322)。词法上 `break` 就是 ident,
                // 所以判据就是"声明过没有"。
                if semi2 == j + 1 && chk_tok_kind(t, j) == 0 {
                    if chk_env_get(src, t, env, c, j) == 0 {
                        chk_pub(src, t, oc, p, E_TYPE, j);
                    }
                }
            }
            if semi2 <= e {
                j = semi2 + 1;
            } else {
                j = e;
            }
        }
    }
}


/// 主入口: 返回错误条数 (错误记录写在 p)。
/// 检查器的工作缓冲**由调用方提供** (arena): 这样自举驱动可以把它们放在 `brk` 内存里,
/// 不必和 codegen 抢语言自带的 64 KiB bump 堆。
///
/// 为什么值得单开一个入口: `alloc` 的 OOM 边界检查走 `@__loment_abort`, 在**无 libc 的
/// 自举驱动**里就是一条非法指令 (SIGILL) —— 输出上看起来像"编译器崩了"。批次 2 期间
/// checker 与 codegen 的分配之和越过 64 KiB 就是这么炸的 (codegen 的 `emit_module`
/// 一次就要 49152B)。驱动现在按 `check_arena` 的约定把这一整块从 `brk` 拿, 语言堆里
/// 只剩 codegen 自己的需求; `check` 保留为"从语言堆开 arena"的薄包装, 给 C 夹具用。
///
/// 各缓冲的尺寸按**语料实测**定 (字段≤2, 变体≤3, 形参≤11, 每函数 let≤152, 能力≤1,
/// 各缓冲的尺寸按**语料实测**定 (字段≤2, 变体≤3, 形参≤11, 每函数 let≤152, 能力≤1,
/// excluded≤2); 整块 `chk_arena_bytes()` 字节 —— 驱动按这几个 `chk_arena_*()` 切片。
/// **语法前置趟** —— 把"**解析错就中止**"这条分界补回来。
///
/// 参考实现是**先解析、再检查**：源不成立（E019）它当场停，一行业务检查都不跑。自举侧没有
/// 解析器，检查器直接对着 token 流跑，于是一个语法错之后它还会接着报**下游的伤** ——
/// `let x = 1;` 会去解类型槽里的下一个 token、`let a: f64 = 1.0;` 还会额外说 `f64` 不是类型，
/// 码集永远比参考**多一个**（issue #7 / #323 的 EXTRA）。
///
/// 这一趟只认**语法层**的形状，报出 E019；调用方看到非零就**不再跑任何检查趟** ——
/// 于是"语法错了就不谈语义"这条分界恢复了，不是靠一条条补检查去凑。
///
/// 只收三类在这里能判定的（它们都不需要语句边界）：
///   * `let NAME :` 的冒号不在（`if let` 是模式不是绑定，排除）
///   * `=`（不是 `==` / `=>`）后面接不上一个表达式
///   * 不支持的数值字面量形式（`0b1010` / `1_000` / `1.5`）
/// 语句**起点**那一条要在走查里判（要边界），留在 `chk_body`，不在这儿重复。
fn chk_syntax_prepass(src: ptr, t: ptr, out: ptr, o: u32) -> u32 {
    let i: u32 = 0;
    let depth: u32 = 0;
    let deep_done: u32 = 0;
    while chk_tok_kind(t, i) != 4 {
        // **裸块不是语句**（`#44`）：Loment 没有"单独一层花括号"这回事，参考实现在解析期
        // 就在**第一个**这种 `{` 上报 E019（`期望表达式，得到 '{'`）。合法块的开头永远跟着
        // `)`、标识符（`else` / `struct S` / `match x` …）、`]`、`=>`、`to`，**不会是**
        // `{` / `}` / `;`。不判这一条的话，下面那道深度上限会先开火，于是同一份源两边给出
        // **不同的码**（参考 19 / 自举 23）—— 400 层裸块那正是 issue #44 的复现。
        // `o == 0`：参考实现是"**第一个**解析错就中止"，所以只报第一条 —— 400 层裸块
        // 若每层都报，用户会看到几十条一模一样的诊断。
        if chk_tok_is(src, t, i, "{") && i > 0 && o == 0
                && (chk_tok_is(src, t, i - 1, "{") || chk_tok_is(src, t, i - 1, "}")
                    || chk_tok_is(src, t, i - 1, ";")) {
            o = sym_pub(src, t, out, o, E_PARSE, i);
        }
        // **太深了要当场说**（issue #44）：参考实现在解析期就设 64 层的上限并报 E023；自举侧
        // 原先一路走到 codegen 才在递归里把栈用穿 —— **段错误、零输出**。这一趟跑到 codegen
        // 之前，报出来就整趟不跑，正好把那边的段错误也挡在门外。
        // 只报**第一次**越界：再往上每层都报一遍对读者没意义（参考实现也只报一条）。
        // **已经报过语法错就不再报它**：参考实现是"第一个解析错就中止"，两条一起报会让
        // 码集比它多一个。
        if chk_tok_is(src, t, i, "{") {
            depth = depth + 1;
            if depth > 64 && deep_done == 0 && o == 0 {
                o = sym_pub(src, t, out, o, E_DEEP, i);
                deep_done = 1;
            }
        }
        if chk_tok_is(src, t, i, "}") && depth > 0 {
            depth = depth - 1;
        }
        // 裸 `return;`（不带值）**不是合法构造** —— `loment syntax` 明说它必须带值。
        // 参考实现报 E019 "期望表达式，得到 ';'"；自举侧原先**段错误、什么都不印**
        // （issue #335）。
        if chk_tok_kind(t, i) == 0 && chk_tok_is(src, t, i, "return")
                && chk_tok_is(src, t, i + 1, ";") {
            o = sym_pub(src, t, out, o, E_PARSE, i + 1);
        }
        // **字符串里的未知转义**（`#33` / `#36`）：参考实现在**词法期**就拒，而自举词法器没有
        // 失败通道 —— 那一档并进这一趟，码与它一致（E019），且"报了就不再往下跑"。
        // 认的六个与 `lomc._ESCAPES` 同一份：`n` `t` `r` `0` `\\` `"`。原先的兜底是"取原
        // 字符"，于是 `"\r"` 静默变成字母 `r`、`"\x41"` 静默变成 `x41` 三个字符。
        if chk_tok_kind(t, i) == 2 {
            let est: u32 = load32(t, i * 20 + 4);
            let eln: u32 = load32(t, i * 20 + 8);
            let ek: u32 = 1;
            while ek + 1 < eln {
                if load8(src, est + ek) == 92 {
                    let ee: u32 = load8(src, est + ek + 1);
                    if !(ee == 110 || ee == 116 || ee == 114 || ee == 48
                         || ee == 92 || ee == 34) {
                        o = sym_pub(src, t, out, o, E_PARSE, i);
                    }
                    ek = ek + 2;
                } else {
                    ek = ek + 1;
                }
            }
        }
        if chk_tok_kind(t, i) == 0 && chk_tok_is(src, t, i, "let")
                && !(i > 0 && (chk_tok_is(src, t, i - 1, "if")
                               || chk_tok_is(src, t, i - 1, "comefor"))) {
            // 只在真是 `let NAME …` 时判。`comefor let "def" to {` 里那个 `let` 是**宏声明
            // 的关键字**、`let c {` 是**外部代码块声明**（`c` 是 `command c` 声明的语言名）
            // —— 两者都不是变量绑定，误判会让整个文件**一趟检查都不跑**。
            if chk_tok_kind(t, i + 1) == 0 && !chk_tok_is(src, t, i + 2, ":")
                    && !chk_tok_is(src, t, i + 2, "{") && chk_tok_kind(t, i + 2) != 5 {
                o = sym_pub(src, t, out, o, E_PARSE, i + 2);
            }
        }
        if chk_tok_kind(t, i) == 3 && chk_tok_is(src, t, i, "=") {
            if !chk_tok_is(src, t, i + 1, "=") && !chk_tok_is(src, t, i + 1, ">") {
                // `{` 也算能开头: 外来表层里 `String[] NAMES = { … }` 是合法的
                // （`loment/examples/multilang/03-java/`）。
                if !chk_tok_is(src, t, i + 1, "{") && !chk_expr_start(src, t, i + 1) {
                    o = sym_pub(src, t, out, o, E_PARSE, i + 1);
                }
            }
        }
        if chk_bad_num_suffix(src, t, i) {
            o = sym_pub(src, t, out, o, E_PARSE, i);
        }
        // **语句之间少一个 `;`**（`#48`）：`let` 只能**起头** —— 前面是 `{` `}` `;` `if`
        // `comefor` `else` `=>`。前面是个**值**（标识符 / 字面量 / `)` / `]`）就说明上一句
        // 没写完；参考实现在解析期报「期望 ;」，而自举侧原先**一声不吭**，于是
        // `loment check` 退出 0、零输出。
        // **例外**：`command c` / `foruse py` 之后那个词是**语言名**，紧跟的 `let c {` 是
        // 外部代码块声明（`loment/extblock/evil.lomt` 就是这一格），不是变量绑定 —— 全仓
        // 扫过，这是唯一一处。
        if chk_tok_kind(t, i) == 0 && chk_tok_is(src, t, i, "let") && i > 0 && o == 0 {
            let ok: u32 = 0;
            if chk_tok_is(src, t, i - 1, "{") || chk_tok_is(src, t, i - 1, "}")
                    || chk_tok_is(src, t, i - 1, ";") || chk_tok_is(src, t, i - 1, "if")
                    || chk_tok_is(src, t, i - 1, "comefor")
                    || chk_tok_is(src, t, i - 1, "else")
                    || chk_tok_is(src, t, i - 1, "=>") {
                ok = 1;
            }
            if i >= 2 && (chk_tok_is(src, t, i - 2, "command")
                          || chk_tok_is(src, t, i - 2, "foruse")) {
                ok = 1;
            }
            if ok == 0 {
                o = sym_pub(src, t, out, o, E_PARSE, i);
            }
        }
        i = i + 1;
    }
    // **块没闭合**（`#48`）：参考实现在解析期就报「的块没闭合」；自举侧原先一路数到结束、
    // 一声不吭 —— `loment check` 于是退出 0、零输出。
    if depth != 0 && o == 0 {
        o = sym_pub(src, t, out, o, E_PARSE, i);
    }
    return o;
}

pub fn check_arena(src: ptr, t: ptr, out: ptr, syms: ptr, scr: ptr, ctab: ptr,
                   nc: ptr, exs: ptr, env: ptr, tyt: ptr) -> u32 {
    let oc: ptr = ptr_add(tyt, 4096);   // 诊断偏移格 (见 chk_arena_tyt)
    store32(nc, 0, 0);
    store32(tyt, 0, 0);                 // 复合类型表: 条数清零
    store32(oc, 0, 0);
    let n: u32 = 0;
    let o: u32 = 0;
    // **语法前置趟**：报出任何 E019 就直接收工 —— 参考实现是"解析错就中止"，一条业务检查
    // 都不跑；自举侧没有解析器，得把这条分界显式补上，否则下游会多报（issue #7 / #323）。
    o = chk_syntax_prepass(src, t, out, 0);
    if o != 0 {
        store32(oc, 0, o);
        return o / 8;
    }
    let nexs: u32 = 0;
    let i: u32 = 0;
    // 核心模式**按维**各见过几次（`docs/175` §3.0 / §3.4）。声明的是**整个程序**的取值，
    // 所以**每一维**只许一次 —— 从 2026-09-23 起核心模式不止一维（`mode` + `gc`），
    // 原先那个"总共只许一次"的计数会把"两维各一份"误判成重复。
    // 存在栈上而不是 arena 里: 它只在这一遍的循环里用, 没有跨调用要留的东西。
    let nch_mode: u32 = 0;
    let nch_gc: u32 = 0;
    let nch_rt: u32 = 0;
    let nch_port: u32 = 0;
    let nch_vm: u32 = 0;        // 第五维（`docs/231`）：执行模型
    let nch_lms: u32 = 0;       // 第六维（`docs/253`）：内存安全 —— ⚠ **只数重复**：
                                // `lms` 今天**没有冲突对**（它不引入运行期组件，`docs/253` §11.2），
                                // 所以不像上面五维那样还要 `v_*` / `ln_*` 来判冲突。
    // 生效的取值（0 = 没写），用来判"两档不能同时选"（`docs/175` §3.4 ⚠）。
    // **要等这一遍走完才判** —— 两行谁先写是不定的。
    let v_mode: u32 = 0;        // 1 = std, 2 = no_std
    let v_gc: u32 = 0;          // 1 = gc_manual, 2 = gc_auto, 3 = gc_auto_alpha
    let v_rt: u32 = 0;          // 1 = runtime, 2 = no_runtime
    let v_port: u32 = 0;        // 1 = sealed, 2 = hosted
    let v_vm: u32 = 0;          // 1 = vm, 2 = no_vm
    // 每一维**最后一次**出现的行号（0 = 这一维从没写过）。报冲突时锚在**这两维里较后**
    // 的那一行上 —— 与参考实现"取 choose_lines 里最后一个命中的"同口径。原先只有一个
    // 共享的 `ch_line`，第三维一进来它就不够了：写齐三维时它指的是**最后一条**，
    // 而冲突那两维未必是它。
    let ln_mode: u32 = 0;
    let ln_gc: u32 = 0;
    let ln_rt: u32 = 0;
    let ln_port: u32 = 0;
    let ln_vm: u32 = 0;
    // 名表清理: 逐声明复用同一块暂存, 每次用都要"清零条数" —— 但 chk_* 系列用
    // 显式计数 (c) 而不是查找长度, 所以只需不读旧值即可, 无需 memclr。
    // ---- 第零遍: 先把**类型名**收齐再查签名。
    // 单元里的引用可能出现在声明之前 —— 最典型的是预置枚举: `lomentc.load` 把
    // `Option`/`Result` append 到单元**末尾**, 而 `-> Result<u32, u32>` 在文件开头,
    // 单趟扫描会报一串假 E-TYPE。
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "struct") || chk_tok_is(src, t, i, "enum") {
            let k0: u32 = K_STRUCT;
            if chk_tok_is(src, t, i, "enum") {
                k0 = K_ENUM;
            }
            let r0a: u64 = declare(src, t, syms, n, i + 1, k0 * 256, 0,
                                   chk_find_brace(src, t, i + 1), out, o);
            n = (r0a / 4294967296) as u32;
            o = (r0a % 4294967296) as u32;
            n = decl_tparams(src, t, syms, n, i + 1);
            i = i + 1;
        } else if chk_tok_is(src, t, i, "impl") {
            i = chk_skip_body(src, t, i);   // impl 块不在子集内 (理由见第一遍)
        } else {
            i = i + 1;
        }
    }
    // ---- 第一遍: 其余顶层声明 + 类型检查
    i = 0;
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "fn") {
            let lp: u32 = chk_find_paren(src, t, i + 2);
            let argc: u32 = chk_count_args(src, t, lp);
            // 返回类型 (可选 ->)。签名式方法 (`trait` 里 `fn m(self) -> u32;`) 没有函数体,
            // 所以 `;` 也要当作终止 —— 否则会一路走到下一个 `{` (那是 impl 块的), 把游标
            // 拽进别人的块里, 后面全错位。
            // 位置必须先扫出来: `declare` 要把返回类型编码记进符号表 (批次 2 的 return 比对)。
            let j: u32 = i + 2;
            let rtok: u32 = 0;
            while !chk_tok_is(src, t, j, "{") && !chk_tok_is(src, t, j, ";")
                    && chk_tok_kind(t, j) != 4 {
                if chk_tok_is(src, t, j, "-") {
                    rtok = j + 2;
                }
                j = j + 1;
            }
            let rcode: u32 = 0;
            if rtok != 0 {
                rcode = chk_ty_of_tok(src, t, syms, n, rtok);
            }
            let r0: u64 = declare(src, t, syms, n, i + 1, K_FN * 256 + argc, rcode, lp, out, o);
            n = (r0 / 4294967296) as u32;
            o = (r0 % 4294967296) as u32;
            n = decl_tparams(src, t, syms, n, i + 1);   // `fn f<T>`: T 是类型名
            let r1: u64 = scan_params(src, t, syms, n, lp, out, o, scr);
            o = (r1 % 4294967296) as u32;
            if rtok != 0 {
                let r2: u64 = check_type(src, t, syms, n, rtok, out, o);
                o = (r2 % 4294967296) as u32;
            }
            // 复合类型表按**函数**清零 —— 与 impl 方法那条路 (2932) 同一件事。
            // 漏了这一步, 表就是**整单元**单调 bump: 大单元 (lomc.lomt 有 357 个 let)
            // 写穿 448 条上限, 越过 tyt 块踩进借用名表, 而后整条扫描游标错位 ——
            // 表现是一堆莫名其妙的 E002 (把 `let` 的变量名当成类型)。见 docs/150 的账。
            store32(tyt, 0, 0);
            i = j;
        } else if chk_tok_is(src, t, i, "struct") || chk_tok_is(src, t, i, "enum") {
            // 名字已在第零遍登记过 (这里不能再 declare, 否则自己跟自己报 E-DUP)。
            // 声明体这一遍**真正解析** (字段/变体重名与类型、空类型), 不再整块跳过。
            let is_enum: bool = chk_tok_is(src, t, i, "enum");
            if is_base_type(src, t, i + 1) == 1 {
                o = sym_pub(src, t, out, o, E_DEF, i + 1);   // 与基类型同名 (参考实现 E009)
            }
            let lb: u32 = chk_find_brace(src, t, i + 1);
            if is_enum {
                let rb: u64 = chk_enum_body(src, t, syms, n, lb, i + 1, scr, out, o);
                o = (rb % 4294967296) as u32;
                i = (rb / 4294967296) as u32;
            } else {
                let rb2: u64 = chk_struct_body(src, t, syms, n, lb, i + 1, scr, out, o);
                o = (rb2 % 4294967296) as u32;
                i = (rb2 / 4294967296) as u32;
            }
        } else if chk_tok_is(src, t, i, "impl") {
            // impl Trait for Type { fn m(self, ...) -> R { ... } ... }
            // 参考实现 (parser 791 行) 把方法改名成 `Type_m` 做静态派发, 于是
            // `funcs["Small_measure"]` 存在而裸 `measure` 不存在。这里用
            // (接收者类型编码, 方法名) 当身份登记成 K_METHOD —— 不造合成名字 (符号表
            // 没有合成 token 的位置), 但查表口径与那边一致: 普通调用查不到方法名。
            // 方法体内的语句检查在第三遍照做。
            let rty: u32 = chk_ty_of_tok(src, t, syms, n, i + 3);
            let mbody: u32 = chk_find_brace(src, t, i + 3);
            let mbodye: u32 = chk_skip_body(src, t, mbody);
            let mk: u32 = mbody + 1;
            while mk < mbodye && chk_tok_kind(t, mk) != 4 {
                if chk_tok_is(src, t, mk, "fn") {
                    let mlp: u32 = chk_find_paren(src, t, mk + 2);
                    let margc: u32 = chk_count_args(src, t, mlp);
                    let mbrace: u32 = chk_find_brace(src, t, mk + 2);
                    let mj: u32 = mk + 2;
                    let mrt: u32 = 0;
                    while mj < mbrace && chk_tok_kind(t, mj) != 4 {
                        if chk_tok_is(src, t, mj, "-") {
                            mrt = mj + 2;
                        }
                        mj = mj + 1;
                    }
                    let mrc: u32 = 0;
                    if mrt != 0 {
                        mrc = chk_ty_range(src, t, syms, n, tyt, mrt,
                                           chk_skip_type(src, t, mrt));
                    }
                    let mac: u32 = margc;
                    if margc > 0 {
                        mac = margc - 1;         // 接收者 self 不计入实参
                    }
                    n = chk_decl_method(src, t, syms, n, mk + 1, mac, mrc, rty);
                    mk = chk_skip_body(src, t, mbrace);
                } else {
                    mk = mk + 1;
                }
            }
            i = mbodye;
        } else if chk_tok_is(src, t, i, "capability") {
            i = chk_cap_collect(src, t, ctab, nc, i);
        } else if chk_tok_is(src, t, i, "excluded") {
            // excluded "space: ..." —— 只记字符串 token, 等能力表齐了再比 (顺序无关)
            if chk_tok_kind(t, i + 1) == 2 {
                store32(exs, nexs * 4, i + 1);
                nexs = nexs + 1;
            }
            i = i + 2;
        } else if chk_tok_is(src, t, i, "const") {
            // 常量的类型编码记在 ret 格里 (供 `chk_name_ty` 在函数体里查常量类型用)
            let cty: u32 = 0;
            if chk_tok_is(src, t, i + 2, ":") {
                cty = chk_ty_of_tok(src, t, syms, n, i + 3);
            }
            let r4: u64 = declare(src, t, syms, n, i + 1, K_CONST * 256, cty, 0, out, o);
            n = (r4 / 4294967296) as u32;
            o = (r4 % 4294967296) as u32;
            if chk_tok_is(src, t, i + 2, ":") {
                // 常量**不做** check_type: 参考实现的常量只查"类型必须是整型"
                // (`const C: Foo = 1;` 只报 E001, 不报"类型未声明") —— 多报就是假阳性。
                if chk_is_int(src, t, i + 3) == 0 {
                    o = sym_pub(src, t, out, o, E_TMISMATCH, i + 3);
                }
            }
            i = i + 4;
        } else if chk_tok_is(src, t, i, "choose") {
            // 项目模式 (docs/143 §3.2)。**只跟一条 token 前进** —— `choose` 是最后一个
            // token 时 i+2 会越过 EOF 哨兵, 主循环就再也退不出来 (读到缓冲区外的字节)。
            // 模式名让它下一轮当普通标识符扫过去, 反正没有别的分支接它。
            // 这里只管两条**检查器**规则; "库不许 choose" 是装载器规则, 在 driver 的
            // load_file 里 —— 与 E018 同构, 那边也是装载器规则进不了这一层。
            let dim: u32 = chk_core_dim(src, t, i + 1);
            if dim == 0 {
                nch_mode = nch_mode + 1;
                v_mode = chk_core_val(src, t, i + 1);
                ln_mode = i;
                if nch_mode > 1 {
                    // **按维**判重复: 参考实现也是逐维说的 —— 两维各一份是合法的。
                    // 锚在第二次出现的那一行上 (第一次的行号写进消息里)。
                    o = sym_pub(src, t, out, o, E_MODE, i);
                }
            } else if dim == 1 {
                nch_gc = nch_gc + 1;
                v_gc = chk_core_val(src, t, i + 1);
                ln_gc = i;
                if nch_gc > 1 {
                    o = sym_pub(src, t, out, o, E_MODE, i);
                }
            } else if dim == 2 {
                nch_rt = nch_rt + 1;
                v_rt = chk_core_val(src, t, i + 1);
                ln_rt = i;
                if nch_rt > 1 {
                    o = sym_pub(src, t, out, o, E_MODE, i);
                }
            } else if dim == 3 {
                nch_port = nch_port + 1;
                v_port = chk_core_val(src, t, i + 1);
                ln_port = i;
                if nch_port > 1 {
                    o = sym_pub(src, t, out, o, E_MODE, i);
                }
            } else if dim == 4 {
                nch_vm = nch_vm + 1;
                v_vm = chk_core_val(src, t, i + 1);
                ln_vm = i;
                if nch_vm > 1 {
                    o = sym_pub(src, t, out, o, E_MODE, i);
                }
            } else if dim == 5 {
                // 第六维（`docs/253`）：`lms`。**只有重复要判** —— 它没有冲突对。
                nch_lms = nch_lms + 1;
                if nch_lms > 1 {
                    o = sym_pub(src, t, out, o, E_MODE, i);
                }
            } else {
                // 不是核心模式的取值 —— 与改之前那条同形
                // (锚在 `choose` 上而不是取值上: 参考实现也是报 choose_lines 那一行)。
                o = sym_pub(src, t, out, o, E_MODE, i);
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    // **两档不能同时选**（`docs/175` §3.4 ⚠）：`no_std` + `gc_auto`。
    // 判的是**生效值** —— 某一维没写就是那一维的默认档（`mode` 默认 `std`、
    // `gc` 默认 `gc_manual`），所以"缺这一项"不等于"可以随便配"。
    // 放在这一遍**之后**: 两行谁先写是不定的。
    let eff_mode: u32 = 1;          // 1 = std（默认档）
    if v_mode != 0 {
        eff_mode = v_mode;
    }
    let eff_gc: u32 = 1;            // 1 = gc_manual（默认档）
    if v_gc != 0 {
        eff_gc = v_gc;
    }
    let eff_rt: u32 = 2;            // 2 = no_runtime（默认档）
    if v_rt != 0 {
        eff_rt = v_rt;
    }
    let eff_port: u32 = 1;          // 1 = sealed（默认档）
    if v_port != 0 {
        eff_port = v_port;
    }
    let eff_vm: u32 = 2;            // 2 = no_vm（默认档）
    if v_vm != 0 {
        eff_vm = v_vm;
    }
    // **两两查**，顺序照参考实现的 `CORE_DIM_ORDER`（mode, gc, runtime, port）走 ——
    // 门禁比的是码集、不比文本，但顺序仍照抄：将来真去比文本时，这里不该是第一个要改的
    // 地方。**顺序要与那份表的 i<j 枚举一致**，否则两条冲突同时命中时码的次序会反
    // （自举侧是逐个 if 写的，没有那张表可循）。
    // 锚点 = 这两维里**较后**写的那一行（某维没写就是另一维那行）。
    if eff_mode == 2 && eff_gc >= 2 {
        o = sym_pub(src, t, out, o, E_MODE, later_line(ln_mode, ln_gc));
    }
    // (mode, port)：`no_std` 说"底下没有东西"，`hosted` 说"往下链东西"（`docs/222` §4.2）。
    if eff_mode == 2 && eff_port == 2 {
        o = sym_pub(src, t, out, o, E_MODE, later_line(ln_mode, ln_port));
    }
    // (mode, runtime) 那一对今天没有冲突 —— 留个位置说明它被想过，不是漏了。
    if eff_gc >= 2 && eff_rt == 2 {
        o = sym_pub(src, t, out, o, E_MODE, later_line(ln_gc, ln_rt));
    }
    // ---- **运行期维的强保证**（`docs/217`）：`no_runtime`（默认）说"产物里没有运行期"，
    // 所以凡是会把那段运行期拖进产物的构造，在**这一档下**编译期点名拒。
    //
    // **码是 E031，不是 E022**（issue #321，2026-10-16 改判）：原先并进 E022，理由是
    // "码按修法分，这一条也要去改 `choose`"。实测那条理由数错了读者 —— 报的是用户写的
    // **那个构造**，而他那一行 `choose` 是对的；而 E022 的标题说的正是"`choose` 写错了"。
    // 码是用户最先读到的那个词，指错子系统就是误导。参考实现那一侧同步改了
    // （`tools/loment_diag.py` 的 `RULES`）。
    // **锚在第一个这样的 token 上**，与参考实现 `_runtime_sites` 取首项同判。
    if eff_rt == 2 {
        let jr: u32 = 0;
        let hit: u32 = 4294967295;
        let nsites: u32 = 0;
        while chk_tok_kind(t, jr) != 4 {
            if chk_rt_site(src, t, jr) == 1 {
                if nsites == 0 {
                    hit = jr;
                }
                nsites = nsites + 1;
            }
            jr = jr + 1;
        }
        // 报的还是**第一个**站点（与参考取首项 `_sites[0]` 同判），但**总数**要交给驱动 ——
        // 报文的"这一类构造本单元另有 N 处"用它（issue #321）。
        store32(tyt, RT_N_SITES, nsites);
        if nsites > 0 {
            o = sym_pub(src, t, out, o, E_RT, hit);
        }
    }
    // (gc, port)：混合档的 L2 是前沿回卷，C 库手里的指针在 Loment 的栈之外（`docs/219` §6.1）。
    if eff_gc == 3 && eff_port == 2 {
        o = sym_pub(src, t, out, o, E_MODE, later_line(ln_gc, ln_port));
    }
    // (runtime, port) 那一对今天没有冲突 —— 同上，留个位置。`hosted` 要不要运行期是
    // 另一件事：端口表量的是**产物通到哪**，不是"里面装了什么"。
    //
    // (vm, runtime) 那一对**也不写在这里**：VM 今天确实要用运行期，但那条由参考实现
    // `docs/227` 那条**既有的**检查接住（"声明了 no_runtime 但它会让产物带上运行期"）——
    // 它读的是**源码里用没用到运行期构造**，这一层只有 token 流判不了。少写一条判不了的
    // 冲突，比写一条判不准的强（`docs/188` 的"宁拒勿猜"）。
    //
    // ---- **渠道闸**（`docs/231` §2）：发行版里 `choose vm` 与 `choose hosted` 都是编译错误。
    // 用户 2026-10-11（vm）：「不要在发行版 Loment 里被调用，所有调用 VM 的都是非法的，
    // 只能 dev 可以被调用，直到第一个可使用的 LVM 诞生」。2026-10-12（libc）：
    // 「锁掉 LibC，在 0.1.4.5（即将发布）中不可调用 LibC，因为这尚未完工」。
    // `LOMENT_CHANNEL` 就是**本文件顶上那一行常量** —— 打包期只换那一行，
    // 于是"包里除那一行之外逐字节等于仓库"仍可判（`docs/231` §5 判据 F）。
    // （⚠ 第一版曾把它做成独立模块 `channel.lomt`；那样会往语料里塞一份**空单元**，
    // 而空单元的 IR 收尾两个实现本来就不同 —— 改回一行常量，见 `docs/231` §2.2。）
    //
    // ⚠ **两个闸共用这一个局部量**（不是各写一个 `let`）：常量在 IR 里是**按使用点内联**的，
    // 每多一处使用，发行版种子与 dev 种子就多差一个字节 —— 而 `loment_channel_test` 那条
    // "两个种子只差**一处**"正是拿这个当判据的（`docs/231` §5 判据 F）。各写一个是错的：
    // 判据会红，且红的原因看起来像"注入改歪了"。
    //
    // **先落到一个局部变量，再比** —— 直接写 `if LOMENT_CHANNEL == 1` 两边都是
    // **字面量**，那会踩到 **issue #224**：`tools/lomentc.py` 把上下文的 `bool` 期望
    // 类型渗进整数运算，参考实现发 `icmp eq i1 0, 1`、自举侧发 `icmp eq i32 0, 1` ——
    // 差**恰好一个字符**，`loment_p8_test` 的语料对照当场红 1 字节。
    // **那不是自举侧的错，是参考实现已登记的缺陷**（故不在这里顺手修）；
    // 过一次局部变量，操作数就不是字面量了，两个实现于是又逐字节一致。
    //
    // **不再包成一个函数**：这一层加函数会**真的**慢下去 —— 自举编译器的符号查找是
    // 线性扫（`docs/225` §3.3），而那条 60s 护栏本来就只剩 ~1% 余量（实测 59.33s）。
    // 实测同条件 A/B：加函数那版 62.9s（红）、纯净树 58.24s（过）。
    let rel: u32 = LOMENT_CHANNEL;
    if eff_vm == 1 {
        if rel == 1 {
            o = sym_pub(src, t, out, o, E_MODE, ln_vm);
        }
    }
    // ---- **对外端口那一维 2026-10-17 放开**（`#406`）：静态（`#359`）与运行期（`#360`）
    // 两半都落齐了，所以发行版里 `choose hosted` 不再是"一句拿不到的承诺"，闸拆掉。
    // 用户 2026-10-12 那句「锁掉 LibC … 因为这尚未完工」的前提**已经不成立**。
    // **`vm` 那条照旧**（引擎还没写，承诺仍然落空）—— 两扇门是**两件事**，只开这一扇。
    // ---- 第一遍半: 能力表判错 (等 caps 与 excluded 都收齐, 顺序无关)
    o = chk_caps_verify(src, t, ctab, load32(nc, 0), exs, nexs, out, o);
    // ---- 第二遍: 函数体里的调用检查
    i = 0;
    while chk_tok_kind(t, i) != 4 {
        // 声明体不是代码: `enum Option<T> { Some(T), None }` 里的 `Some(T)` 长得像调用,
        // `struct S { a: u32 }` 同理。整块跳过 (含预置枚举 —— 它是注入进单元的尾巴)。
        // 跳过之后**这一轮不能再 +1**: 跳完正好落在下一个声明的关键字上, 再前进一步
        // 就会把它整个略过 (s2 那样的 "struct 后面紧跟 enum" 就是这么漏的)。
        let skipped: u32 = 0;
        if chk_tok_is(src, t, i, "enum") || chk_tok_is(src, t, i, "struct")
                || chk_tok_is(src, t, i, "trait") {
            i = chk_skip_body(src, t, i);
            skipped = 1;
        }
        if skipped == 0 {
            // guard NAME(idx) —— 能力未声明或字面量索引越界 -> E-CAP。
            // 排在调用检查之前, 并靠 `i-1 != "guard"` 把随后的 `NAME(` 排除掉。
            if chk_tok_is(src, t, i, "guard") {
                o = chk_guard(src, t, ctab, load32(nc, 0), i, out, o);
            }
            // `if let E::V(x) = e` 里的 `let` 是**模式**不是带类型的绑定 (它的 `Result`
            // 后面跟的是 `::` 而不是 `:`) —— 不排掉就会把 `::` 里的第二个 `:` 当类型报 E-TYPE。
            if chk_tok_is(src, t, i, "let") && !(i > 0 && chk_tok_is(src, t, i - 1, "if")) {
                // let NAME ':' TYPE —— TYPE 未声明 -> E-TYPE
                let r6: u64 = check_type(src, t, syms, n, i + 3, out, o);
                o = (r6 % 4294967296) as u32;
            }
            // 调用检查: `ident (` 才算, 且要排掉四类**看起来像调用其实不是**的东西 ——
            // 关键字 (`return (a)` / `if (b)`) / 枚举构造 (`E::V(x)`) / 域检查
            // (`guard NAME(idx)`) / 方法调用 (`x.m(...)`)。
            // i>0 是必须的: i-1 在下溢时会变成巨大的下标, 读出缓冲区外的垃圾。
            if i > 0 && chk_tok_kind(t, i) == 0 && chk_tok_is(src, t, i + 1, "(")
                    && chk_is_kw(src, t, i) == 0
                    && !chk_tok_is(src, t, i - 1, ":")
                    && !chk_tok_is(src, t, i - 1, ".")
                    && !chk_tok_is(src, t, i - 1, "guard") {
                let nl: u32 = tok_len(t, i);
                if nl > 0 {
                    // **行为轴**（`docs/218` §7 第 2 件，2026-10-11）：声明了不碰网络的
                    // 单元里调联网号 -> E005。参考实现那半在 `lomentc.check` 里（同一个
                    // 判据名）。**两轴必须分开**：这是**权威**读法（"这个门不开"），
                    // 与 `docs/208` 那条**保密**读法（"我不会把数据送出去"，由 M41 那一族管）
                    // 不是一件事 —— 这里只判"开了没有"。
                    if chk_syscall_net(src, t, i) == 1 && chk_excl_net(src, t, exs, nexs) == 1 {
                        o = sym_pub(src, t, out, o, E_EXCL, i);
                    }
                    let want_b: u32 = chk_builtin_arity(src, t, i);
                    if want_b != 999999 {
                        // 内建: 只查实参个数 (形参类型那一半属于表达式类型批次)
                        if want_b != chk_count_args(src, t, i + 1) {
                            o = sym_pub(src, t, out, o, E_ARITY, i);
                        }
                    } else {
                        let slot: u32 = chk_lookup_slot(src, t, syms, n, i);
                        if slot == 0 {
                            o = sym_pub(src, t, out, o, E_FN, i);
                        } else {
                            let want: u32 = load32(syms, (slot - 1) * 20 + 8);
                            let got: u32 = chk_count_args(src, t, i + 1);
                            if want != got {
                                o = sym_pub(src, t, out, o, E_ARITY, i);
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
    // ---- 第三遍: 语句级类型比对 (批次 2) —— let / return / 赋值 / if / while / for。
    // 每个函数重建一次局部环境; 函数体的范围用花括号匹配切出来。
    i = 0;
    while chk_tok_kind(t, i) != 4 {
        if chk_tok_is(src, t, i, "fn") {
            let lp2: u32 = chk_find_paren(src, t, i + 2);
            let slot2: u32 = chk_lookup_slot(src, t, syms, n, i + 1);
            // 名字不能叫 `rb`: 第一遍的 struct/enum 分支已经有一个 u64 的 `rb` ——
            // 局部表按名字存类型, 重名会让新 let 的 i32 值按 i64 读回来 (clang 报
            // "%t defined with type i64 but expected i32")。批次 3 的局部名统一 f 前缀。
            let fbra: u32 = chk_find_brace(src, t, i + 2);
            // impl 方法的返回类型不在 `chk_lookup_slot` 里 (它刻意跳过方法), 用
            // `chk_lookup_method_any` 补一次 —— 否则方法体里的一句不查。
            let fslot: u32 = slot2;
            if slot2 == 0 {
                fslot = chk_lookup_method_any(src, t, syms, n, i + 1);
            }
            // 签名式方法 (`fn m(self) -> u32;`) 没有函数体: 不能把后面的 impl 块当自己的
            if chk_tok_is(src, t, fbra, "{") && fslot != 0 {
                let retc: u32 = load32(syms, (fslot - 1) * 20 + 12);
                let fend: u32 = chk_skip_body(src, t, fbra);
                let envc: u32 = chk_env_params(src, t, syms, n, env, 0, lp2, fbra, oc);
                store32(oc, 0, o);
                store32(tyt, 0, 0);          // 类型表按**函数**清零 (见 chk_arena_tyt)
                // E029 的"已释放"表与 `lms` 档的缓存 —— **也必须按函数清零**：
                // 不清就是整单元单调 bump，而这张表的容量只有 63（`CHK_FR_N`）。
                store32(tyt, CHK_FR_N, 0);
                store32(tyt, CHK_FR_ON, 0);
                store32(tyt, 3528, envc);    // 形参数 (E012 判"局部 vs 形参")
                store32(tyt, 3520, envc);
                chk_body(src, t, syms, n, env, envc,
                         (fbra as u64) * 4294967296 + (fend as u64), retc, out, oc);
                o = load32(oc, 0);
                // 移动/悬垂检查放在 chk_body **之后**: 那时环境里已经有全部 let 的类型
                // (chk_body 边扫边登记), chk_moves 只读环境, 不必再维护一份。
                // 走完必须**再读一次偏移格** —— 本地 o 是 chk_body 之前/之后拍的快照,
                // 不回读的话 chk_moves 写的诊断在 `return o / 8` 时会被整条丢掉。
                store32(tyt, 3576, 0);
                chk_moves(src, t, syms, n, env, load32(tyt, 3520), fbra, fend, out, oc);
                o = load32(oc, 0);
                i = fend;
            } else {
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    // ---- 最后一趟: 命令声明（`docs/223` 形态 B）。
    // **单独一趟**：它只看两样东西（`loment_command` 的标签、`command_main` / `_start`
    // 的存在），与上面那几趟的游标状态一件都不共用 —— 塞进主扫描反而要跟着它们的规则走。
    o = chk_command(src, t, out, o, scr);
    return o / 8;
}

// ---------------------------------------------------------------- 命令声明 (docs/223)

//: E024 命令声明不合法（形状 / 名字 / 撞官方名）、E025 两个进程入口、
//: E026 `command_main` 与声明对不上。**与参考实现同一批码**（`tools/loment_diag.py`
//: 的 RULES）—— 码集是判据比的那一样东西（`loment_rule_parity`）。
const E_CMD_DECL: u32 = 24;
const E_CMD_ENTRY: u32 = 25;
const E_CMD_BODY: u32 = 26;

/// 一段字节（不是 token）是否等于字面量 —— 名字已经剥掉引号抄进暂存了。
fn cmd_span_is(src: ptr, p: u32, n: u32, s: str) -> bool {
    if n != str_len(s) {
        return false;
    }
    let q: u32 = 0;
    while q < n {
        if load8(src, p + q) != str_byte(s, q) {
            return false;
        }
        q = q + 1;
    }
    return true;
}

/// `loment` 官方的命令名（`docs/223` §3.3）—— **与参考实现的 `RESERVED_COMMANDS`
/// 同一份表，两处一起改**。手抄的第二份必然漂，所以 `tools/loment_register_test.py`
/// 有一条判据把两边逐条钉在 `loment commands` 打出来的那批上。
fn cmd_reserved(src: ptr, p: u32, n: u32) -> bool {
    if cmd_span_is(src, p, n, "about") { return true; }
    if cmd_span_is(src, p, n, "build") { return true; }
    if cmd_span_is(src, p, n, "builtins") { return true; }
    if cmd_span_is(src, p, n, "caps") { return true; }
    if cmd_span_is(src, p, n, "cat") { return true; }
    if cmd_span_is(src, p, n, "check") { return true; }
    if cmd_span_is(src, p, n, "cheat") { return true; }
    if cmd_span_is(src, p, n, "codes") { return true; }
    if cmd_span_is(src, p, n, "color") { return true; }
    if cmd_span_is(src, p, n, "commands") { return true; }
    if cmd_span_is(src, p, n, "count") { return true; }
    if cmd_span_is(src, p, n, "doc") { return true; }
    if cmd_span_is(src, p, n, "doctor") { return true; }
    if cmd_span_is(src, p, n, "env") { return true; }
    if cmd_span_is(src, p, n, "example") { return true; }
    if cmd_span_is(src, p, n, "examples") { return true; }
    if cmd_span_is(src, p, n, "explain") { return true; }
    if cmd_span_is(src, p, n, "fmt") { return true; }
    if cmd_span_is(src, p, n, "fns") { return true; }
    if cmd_span_is(src, p, n, "grep") { return true; }
    if cmd_span_is(src, p, n, "hash") { return true; }
    if cmd_span_is(src, p, n, "help") { return true; }
    if cmd_span_is(src, p, n, "ir") { return true; }
    if cmd_span_is(src, p, n, "keywords") { return true; }
    if cmd_span_is(src, p, n, "ls") { return true; }
    if cmd_span_is(src, p, n, "lsp") { return true; }
    if cmd_span_is(src, p, n, "new") { return true; }
    if cmd_span_is(src, p, n, "run") { return true; }
    if cmd_span_is(src, p, n, "skill") { return true; }
    if cmd_span_is(src, p, n, "stat") { return true; }
    if cmd_span_is(src, p, n, "syntax") { return true; }
    if cmd_span_is(src, p, n, "todo") { return true; }
    if cmd_span_is(src, p, n, "tokens") { return true; }
    if cmd_span_is(src, p, n, "tools") { return true; }
    if cmd_span_is(src, p, n, "tree") { return true; }
    if cmd_span_is(src, p, n, "types") { return true; }
    if cmd_span_is(src, p, n, "version") { return true; }
    if cmd_span_is(src, p, n, "where") { return true; }
    return false;
}

/// 命令名合不合法（`docs/223` §3.4）：只收 `[A-Za-z0-9_-]`、长度 1..64。
/// 启动器按**文件名**找命令（`loment <名>` -> `loment-<名>`），所以带路径分隔符、
/// 空格或非 ASCII 的名字拼不出一个可靠的路径。
fn cmd_name_ok(src: ptr, p: u32, n: u32) -> bool {
    if n == 0 || n > 64 {
        return false;
    }
    let q: u32 = 0;
    while q < n {
        let c: u32 = load8(src, p + q);
        let ok: bool = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            || c == 45 || c == 95;
        if !ok {
            return false;
        }
        q = q + 1;
    }
    return true;
}

/// 入口签名是不是 `fn command_main(argv: ptr, argc: u32) -> u32`（`docs/223` §3.2）。
/// 签名是**固定的**（不是用户可选的），所以逐 token 比就够 —— 再写一个小 parser 不值。
fn cmd_main_sig_ok(src: ptr, t: ptr, itok: u32) -> bool {
    let lp: u32 = itok + 1;
    if !chk_tok_is(src, t, lp, "(") { return false; }
    if chk_tok_kind(t, lp + 1) != 0 { return false; }        // 形参名
    if !chk_tok_is(src, t, lp + 2, ":") { return false; }
    if !chk_tok_is(src, t, lp + 3, "ptr") { return false; }
    if !chk_tok_is(src, t, lp + 4, ",") { return false; }
    if chk_tok_kind(t, lp + 5) != 0 { return false; }        // 形参名
    if !chk_tok_is(src, t, lp + 6, ":") { return false; }
    if !chk_tok_is(src, t, lp + 7, "u32") { return false; }
    if !chk_tok_is(src, t, lp + 8, ")") { return false; }
    if !chk_tok_is(src, t, lp + 9, "-") { return false; }
    if !chk_tok_is(src, t, lp + 10, ">") { return false; }
    return chk_tok_is(src, t, lp + 11, "u32");
}

/// 命令声明的三条检查。返回诊断缓冲的新偏移（`o` 进 `o` 出）。
fn chk_command(src: ptr, t: ptr, out: ptr, o: u32, scr: ptr) -> u32 {
    let pk: u64 = lex_cmd_label(src, t, scr);
    let lt: u32 = (pk / 4294967296) as u32;      // 标签 token 下标 + 1
    let nl: u32 = (pk % 4294967296) as u32;      // 名字长度（0 = 形状不对）
    // `command_main` / `_start` 只认**顶层 `fn` 声明**那一处 —— 名字出现在调用点不算
    // （参考实现查的是模块的函数表）。`fn` 在这里也是 ident token。
    let cm: u32 = 0;
    let st: u32 = 0;
    let n: u32 = 0;
    while load32(t, n * 20) != 4 {
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n {
        if i >= 1 && load32(t, i * 20) == 0 && load32(t, (i - 1) * 20) == 0
                && chk_tok_is(src, t, i - 1, "fn") {
            if cm == 0 && chk_tok_is(src, t, i, "command_main") { cm = i + 1; }
            if st == 0 && chk_tok_is(src, t, i, "_start") { st = i + 1; }
        }
        i = i + 1;
    }
    // 1) 声明本身不合法：形状不对 / 名字不合法 / 撞官方名。
    // 锚在**标签那一行**（参考实现也是报 command_lines 那一行）。
    if lt > 0 {
        // 名字已经抄进 `scr`（`lex_cmd_label` 剥了引号），所以这两条读的是**暂存**不是
        // 源文件 —— 读源文件等于拿文件开头那几十个字节当名字（实测：`module m` 被当成
        // 名字，于是"非法名字"漏报、合法名字反而报）。
        if nl == 0 || !cmd_name_ok(scr, 0, nl) || cmd_reserved(scr, 0, nl) {
            o = sym_pub(src, t, out, o, E_CMD_DECL, lt - 1);
        }
    }
    // 2) `command_main` 却没有声明 —— 死代码（静默失效）。
    if cm > 0 && lt == 0 {
        o = sym_pub(src, t, out, o, E_CMD_BODY, cm - 1);
    }
    // 3) 两个入口 / 签名不对。**互斥**（与参考实现同顺序：有 `_start` 报入口冲突，
    //    没 `_start` 才轮到签名）。
    if cm > 0 {
        if st > 0 {
            o = sym_pub(src, t, out, o, E_CMD_ENTRY, cm - 1);
        } else if !cmd_main_sig_ok(src, t, cm - 1) {
            o = sym_pub(src, t, out, o, E_CMD_BODY, cm - 1);
        }
    }
    // 4) 反向那一半：**声明了**却没有 `command_main` —— 工具链生成的 `_start` 要调它，
    //    没有它就只能等到**链接**（未定义符号）才炸。码用同一个（两半少一半，修法都是
    //    把两半凑齐）—— 与参考实现那一条逐字对齐。
    if lt > 0 && cm == 0 {
        o = sym_pub(src, t, out, o, E_CMD_BODY, lt - 1);
    }
    return o;
}

/// arena 一块里的分段布局 (驱动按这几个常量切片; 单位: 字节)。
/// 顺序与 `check_arena` 的形参顺序一致, 驱动侧一个 `sys_alloc(CHK_ARENA)` 就够。
/// syms 从 8192 涨到 10240 是批次 2 第二段: 符号表条目加了一格 aux (stride 20)。
pub fn chk_arena_syms() -> u32 { return 0; }
pub fn chk_arena_scr() -> u32 { return 92000; }
pub fn chk_arena_ctab() -> u32 { return 93024; }
pub fn chk_arena_nc() -> u32 { return 93536; }
pub fn chk_arena_exs() -> u32 { return 93552; }
pub fn chk_arena_env() -> u32 { return 93808; }
/// 类型表块: [0..3584) = 复合类型表 (表头 4 字节条数 + 8 字节/条, **每函数开头清零**),
/// [3584..4096) = 借用检查的名字表, [4096..4112) = 诊断偏移格 (chk_pub 写进这里,
/// 免得每层递归都回传偏移)。
///
/// 为什么表要每函数清零: 它是**单调 bump**, 而 `chk_ty_range`/`chk_tex` 每次调用都会
/// 登记元素/切片类型 —— 一个 150 条 let 的函数能开出几百条。不清零就会写穿到后面的
/// 区 (静默改坏别人), 所以条数是"每函数上限"而不是"整单元上限"。
/// 448 条/函数对语料最重的函数 (152 let) 仍有 3 倍余量。
pub fn chk_arena_tyt() -> u32 { return 95856; }
pub fn chk_arena_bytes() -> u32 { return 99968; }

// 原先这里有个 `check(src, t, out)` 薄包装 (自己开 arena)。**去掉了**: arena 现在 ~100 KB,
// 语言自带的 64 KiB bump 堆放不下, 而"在调用方进程里改 brk"这条路对 C 夹具是**危险**的
// —— 那里的 brk 与 CRT 的 malloc 共用同一个程序断点, 互相踩 (实测: 夹具崩了, 判据只看到
// "自举 checker 一个码都没报")。调用方现在自己开一块并按 `chk_arena_*()` 切片, 与驱动器
// 同一个口径。
