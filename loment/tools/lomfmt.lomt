// loment/tools/lomfmt.lomt — Loment 版格式化器 (无 Python, docs/159 §4)
//
// 与 tools/lomfmt.py 的**行为逐字节相同**是判据 (tools/loment_fmt_test.py):
// 同一份源码喂两个实现, stdout 必须一模一样。
//
// 这一版只用到词法层 (与 Python 版一样复用词法器), 所以不需要 parser —— 自举 parser
// 目前还是子集, 但格式化器不吃这一层。
//
// 语义**逐条镜像** Python 版 (包括它把 tok.val 当字符串比较的那些地方):
//   * 多字符运算符按**相邻 token**合并 (不看源码里是否连着), 12 对;
//   * 集合成员判断用的是 **val**: 字符串字面量的 val 是**转义解码后**的内容,
//     所以源码里 `"("` 这样的字符串会被当成真的左括号 —— Python 版就是这样, 这里也一样
//     (语料里到处是 `tok_is(src,t,i,"(")`, 不镜像就逐字节不一致);
//   * `_render` 对字符串做**解转义再重转义** (`\q` -> `q`, 制表符原样, 换行写成 `\n`)。
//
// 无 Python 自举: 用参考实现 + clang 链出 ELF, 或用种子链 (/loment/bootstrap.sh)。
//
//   ./fujofmt <文件.lomt> > 格式化后

module lomfmt
choose runtime

use lexer

const SRC_CAP: u32 = 1048576;      // 源文件 (语料最大 ~100 KiB, 留足)
const LINE_CAP: u32 = 262144;      // 当前行渲染缓冲
const LTOK_CAP: u32 = 8192;        // 当前行的 token 下标表 (按行存, 缩进要用)
const MEM_CAP: u32 = 3145728;      // 状态 + 行表 + 行缓冲 + 输出区
const OFF_STACK: u32 = 64;         // 16 格块类型栈
const OFF_LTOK: u32 = 128;         // u32[LTOK_CAP]
const OFF_LINE: u32 = 32896;       // 行渲染缓冲 (OFF_LTOK + LTOK_CAP*4)
const OFF_OUT: u32 = 295040;       // 输出区 (OFF_LINE + LINE_CAP)

// 状态格 (全部 u32)
const S_DEPTH: u32 = 0;            // 当前缩进深度
const S_ACLOSE: u32 = 4;           // 上一个 token 是 `}` -> 下一条语句另起一行
const S_LASTTOP: u32 = 8;          // 上一个顶层关键字 id (0 = 无)
const S_LLEN: u32 = 12;            // 行缓冲长度
const S_LTN: u32 = 16;             // 行 token 表长度
const S_OLEN: u32 = 20;            // 输出长度
const S_NL: u32 = 24;              // 已输出行数
const S_LBLANK: u32 = 28;          // 最后输出的是空行 (Python: out[-1] == "")
const S_LBRACE: u32 = 32;          // 最后输出行正好是 `}` (Python: out[-1] == "}")
const S_STOP: u32 = 36;            // 块类型栈顶
// `#46`: 这一行**到现在为止**的记号是不是全是声明行首的修饰词
//（`pub` / `extern`）。下一个顶层关键字要接在它后面，不另起一行。
const S_LHEAD: u32 = 40;

// ---------------------------------------------------------------- 成员表
// 每个集合用 "\n" 分隔。L1 的 `const` 只收**整数字面量** (parse_const 走 int_lit),
// 所以表用"返回 str 的函数"表达; 这样"val 相等"依然只有一处实现 (v_eq/val_eq)。

fn T_NSB() -> str { return ",\n;\n)\n]\n}\n:\n.\n::\n.."; }                         // 前不留空格
fn T_NSA() -> str { return "(\n[\n.\n::\n!\n.."; }                                 // 后不留空格
fn T_BIN() -> str { return "+\n-\n*\n/\n%\n=\n==\n!=\n<\n<=\n>\n>=\n&&\n||\n&\n|\n^\n<<\n>>\n->\n=>"; }
fn T_LPAR_LBR() -> str { return "(\n["; }
fn T_RPAR_RBR() -> str { return ")\n]"; }
fn T_PMA() -> str { return "+\n-\n&"; }
fn T_BANG() -> str { return "!"; }
fn T_LBRACE() -> str { return "{"; }
fn T_RBRACE() -> str { return "}"; }
fn T_SEMI() -> str { return ";"; }
fn T_COMMA() -> str { return ","; }
fn T_CLOSE_OK() -> str { return ";\n,\nelse\n)\n]\n.\n}"; }
fn T_VEND_KW() -> str { return "let\nreturn\nif\nelse\nwhile\nfor\nin\nmatch\nmut\nfn\nconst\nguard\nas\npub"; }
fn T_CONTROL() -> str { return "if\nwhile\nmatch\nfor\nin\nreturn\nguard\nas"; }
fn T_TYPE_BODY() -> str { return "struct\nenum\ntrait\nmatch"; }
fn T_BRACE_KW() -> str { return "struct\nenum\ntrait\nimpl\nfn\nif\nwhile\nfor\nmatch\nelse\ncapability"; }
// **`choose` 原先就不在这张表里**（既有缺口, 与 `tools/lomfmt.py` 的 TOP_KW 同一处）:
// 没有它, `choose std` 会被揉进上一行; 加开关之后 `set choose X { … }` 更是整块贴上去。
// `register`（`docs/223` 形态 A）同理：它是**顶层**声明, 不进这张表就会被揉进上一行。
fn T_TOP_KW() -> str { return "module\nuse\ncapability\nconst\nstruct\nenum\ntrait\nimpl\nfn\nexcluded\npub\ninterrupt\nchoose\nset\naddin\ncomefor\nbyuse\nregister"; }

/// 声明行首的**修饰词**（`#46`）：它们不单独占一行，要与后面那一项连在一起。
fn T_HEAD_MODS() -> str { return "pub
extern"; }

/// 单独一个 `pub`（`#46`：它不参与"顶层声明之间插空行"那一套分组）。
fn T_PUB() -> str { return "pub"; }

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let n: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if n <= 0 {
            return off;
        }
        off = off + (n as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

/// 面向用户的失败消息: `loment: <msg>` 换行。前缀是 **`loment`**(用户敲的那个命令),
/// 不是 `fujofmt`/`lomfmt`(这个包里的格式化器组件名) —— issue #8。
fn fail(msg: str) -> u32 {
    write_all(2, str_ptr("loment: "), str_len("loment: ") as u64);
    write_all(2, str_ptr(msg), str_len(msg) as u64);
    write_all(2, str_ptr("\n"), str_len("\n") as u64);
    return die(1);
}

/// 同 `fail`, 消息后面接一段**已经量好的字节** (路径)。
fn failp(msg: str, tail: ptr, n: u32) -> u32 {
    write_all(2, str_ptr("loment: "), str_len("loment: ") as u64);
    write_all(2, str_ptr(msg), str_len(msg) as u64);
    write_all(2, tail, n as u64);
    write_all(2, str_ptr("\n"), str_len("\n") as u64);
    return die(1);
}

fn open_ro(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    return syscall4(257, (0 as u64) - 100, scr as u64, 0);
}

/// 从 /proc/self/cmdline 取 argv[1]: 返回 (start << 32) | len, 0 = 没有。
fn argv1(buf: ptr, cap: u64, scr: ptr) -> u64 {
    let fd: i64 = open_ro(str_ptr("/proc/self/cmdline"), 18, scr);
    if fd < 0 {
        return 0;
    }
    let n: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if n <= 0 {
        return 0;
    }
    let m: u32 = n as u32;
    let i: u32 = 0;
    while i < m && load8(buf, i) != 0 {
        i = i + 1;                     // 跳过 argv[0]
    }
    i = i + 1;
    let s: u32 = i;
    while i < m && load8(buf, i) != 0 {
        i = i + 1;
    }
    let alen: u32 = i - s;
    if alen == 0 {
        return 0;
    }
    return (s as u64) * 4294967296 + (alen as u64);
}

/// 参考实现用 read_text (通用换行): CRLF -> LF。词法器按原始字节走, 不归一化就会
/// 把 \r 当成源码字节 (自举 codegen 抓过这个 bug)。
fn strip_cr(buf: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    while i < n {
        let c: u32 = load8(buf, i);
        if c == 13 && i + 1 < n && load8(buf, i + 1) == 10 {
            i = i + 1;
        } else {
            store8(buf, o, c as u8);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

// ---------------------------------------------------------------- token 访问

fn tk_kind(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20);
}

fn tk_start(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 4);
}

fn tk_len(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 8);
}

fn tk_line(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 12);
}

/// token 文本等于字面量。字符串 token 直接不算 (原文含引号, 会与关键字撞车)。
fn tk_is(src: ptr, t: ptr, i: u32, s: str) -> bool {
    if tk_kind(t, i) == 2 {
        return false;
    }
    if tk_len(t, i) != str_len(s) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(s) {
        if load8(src, tk_start(t, i) + k) != str_byte(s, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// token 的 val 与表成员 [off, off+len) 相等?
/// 非字符串: val 就是原文切片; 字符串: val 是**转义解码后**的内容 (镜像 Python)。
fn val_eq(src: ptr, t: ptr, i: u32, tbl: str, off: u32, len: u32) -> bool {
    if tk_kind(t, i) != 2 {
        if tk_len(t, i) != len {
            return false;
        }
        let s: u32 = tk_start(t, i);
        let q: u32 = 0;
        while q < len {
            if load8(src, s + q) != str_byte(tbl, off + q) {
                return false;
            }
            q = q + 1;
        }
        return true;
    }
    let s: u32 = tk_start(t, i) + 1;
    let e: u32 = tk_start(t, i) + tk_len(t, i) - 1;   // 不含右引号
    let j: u32 = s;
    let q: u32 = 0;
    while j < e {
        let c: u32 = load8(src, j);
        if c == 92 && j + 1 < e {
            let x: u32 = load8(src, j + 1);
            c = x;                  // Python: _ESCAPES.get(x, x) —— 引号/反斜杠/未知都取原字符
            if x == 110 { c = 10; }
            if x == 116 { c = 9; }
            if x == 114 { c = 13; }   // `#36`: `\r` 原先不在表里, 被吃成字母 `r`
            if x == 48 { c = 0; }     // `#33`: `\0` 仓库自己在用 (`proc.lomt` 的 "/bin/sh\0")
            j = j + 2;
        } else {
            j = j + 1;
        }
        if q >= len {
            return false;
        }
        if c != str_byte(tbl, off + q) {
            return false;
        }
        q = q + 1;
    }
    return q == len;
}

/// 值比较, 带合并: mg != 0 时 val 是相邻两个单字符 punct 拼起来的两个字 (Python 的 merge)。
fn v_eq(src: ptr, t: ptr, i: u32, mg: u32, tbl: str, off: u32, len: u32) -> bool {
    if mg == 0 {
        return val_eq(src, t, i, tbl, off, len);
    }
    if len != 2 {
        return false;
    }
    if load8(src, tk_start(t, i)) != str_byte(tbl, off) {
        return false;
    }
    if load8(src, tk_start(t, i + 1)) != str_byte(tbl, off + 1) {
        return false;
    }
    return true;
}

/// 集合里第一个相等的成员的**表内偏移 + 1** (0 = 不在集合里)。偏移可直接当 id 用
/// (判"是不是同一个顶层关键字"只需要相等性)。
fn v_find(src: ptr, t: ptr, i: u32, mg: u32, tbl: str) -> u32 {
    let n: u32 = str_len(tbl);
    let j: u32 = 0;
    while j <= n {
        let e: u32 = j;
        while e < n && str_byte(tbl, e) != 10 {
            e = e + 1;
        }
        if v_eq(src, t, i, mg, tbl, j, e - j) {
            return j + 1;
        }
        j = e + 1;
    }
    return 0;
}

/// 值是否在集合（表）里。
fn v_in(src: ptr, t: ptr, i: u32, mg: u32, tbl: str) -> bool {
    return v_find(src, t, i, mg, tbl) != 0;
}

/// 多字符运算符合并 id (0 = 不合并)。Python 版只看**相邻 token** 的 val, 不看源码是否连着。
fn merg_id(src: ptr, t: ptr, i: u32, n: u32) -> u32 {
    if i + 1 >= n {
        return 0;
    }
    if tk_kind(t, i) != 3 || tk_kind(t, i + 1) != 3 {
        return 0;
    }
    let a: u32 = load8(src, tk_start(t, i));
    let b: u32 = load8(src, tk_start(t, i + 1));
    if a == 45 && b == 62 {
        return 1;                          // ->
    }
    if a == 58 && b == 58 {
        return 2;                          // ::
    }
    if a == 61 && b == 61 {
        return 3;                          // ==
    }
    if a == 33 && b == 61 {
        return 4;                          // !=
    }
    if a == 60 && b == 61 {
        return 5;                          // <=
    }
    if a == 62 && b == 61 {
        return 6;                          // >=
    }
    if a == 38 && b == 38 {
        return 7;                          // &&
    }
    if a == 124 && b == 124 {
        return 8;                          // ||
    }
    if a == 60 && b == 60 {
        return 9;                          // <<
    }
    if a == 62 && b == 62 {
        return 10;                         // >>
    }
    if a == 46 && b == 46 {
        return 11;                         // ..
    }
    if a == 61 && b == 62 {
        return 12;                         // =>
    }
    return 0;
}

/// 值 token 编码: (idx+1)*2 + 合并标志; 0 = 无 (对应 Python 的 None)。
/// 注意存的是**标志**不是合并 id —— 解码方只需要知道"这是个双字符", 具体是哪对靠源码字节判。
fn enc(i: u32, mg: u32) -> u32 {
    let f: u32 = 0;
    if mg != 0 {
        f = 1;
    }
    return (i + 1) * 2 + f;
}

fn enc_idx(v: u32) -> u32 {
    return v / 2 - 1;
}

fn enc_mg(v: u32) -> u32 {
    return v % 2;
}

/// 顶层关键字 id (表内偏移 + 1), 0 = 不是; 镜像 Python 的 `t.kind == "ident" and v in TOP_KW`。
fn top_id(src: ptr, t: ptr, i: u32) -> u32 {
    if tk_kind(t, i) != 0 {
        return 0;
    }
    return v_find(src, t, i, 0, T_TOP_KW());
}

// ---------------------------------------------------------------- 输出缓冲

fn out_push_byte(mem: ptr, c: u32) {
    store8(mem, OFF_OUT + load32(mem, S_OLEN), c as u8);
    store32(mem, S_OLEN, load32(mem, S_OLEN) + 1);
}

fn out_push(mem: ptr, p: ptr, n: u32) {
    let q: u32 = 0;
    while q < n {
        out_push_byte(mem, load8(p, q) as u32);
        q = q + 1;
    }
}

fn line_push_byte(mem: ptr, c: u32) {
    if load32(mem, S_LLEN) < LINE_CAP {
        store8(mem, OFF_LINE + load32(mem, S_LLEN), c as u8);
        store32(mem, S_LLEN, load32(mem, S_LLEN) + 1);
    }
}

fn line_push(mem: ptr, p: ptr, n: u32) {
    let q: u32 = 0;
    while q < n {
        line_push_byte(mem, load8(p, q) as u32);
        q = q + 1;
    }
}

fn line_tok(mem: ptr, i: u32) {
    if load32(mem, S_LTN) < LTOK_CAP {
        store32(mem, OFF_LTOK + load32(mem, S_LTN) * 4, i);
        store32(mem, S_LTN, load32(mem, S_LTN) + 1);
    }
}

/// Python 的 flush(): 有内容就按当前深度缩进输出一行。
fn flush_line(mem: ptr) -> u32 {
    let n: u32 = load32(mem, S_LLEN);
    if n == 0 {
        return 0;
    }
    let d: u32 = load32(mem, S_DEPTH);
    let q: u32 = 0;
    while q < d * 4 {
        out_push_byte(mem, 32);
        q = q + 1;
    }
    out_push(mem, ptr_add(mem, OFF_LINE), n);
    out_push_byte(mem, 10);
    // out[-1] == "}" 只在"这一行恰好只有一个 }"时为真
    let one: u32 = 0;
    if n == 1 {
        if load8(mem, OFF_LINE) == 125 {
            one = 1;
        }
    }
    store32(mem, S_LBRACE, one);
    store32(mem, S_LBLANK, 0);
    store32(mem, S_NL, load32(mem, S_NL) + 1);
    store32(mem, S_LLEN, 0);
    store32(mem, S_LTN, 0);
    return 1;
}

/// Python 的 out.append("")。
fn out_blank(mem: ptr) {
    out_push_byte(mem, 10);
    store32(mem, S_LBLANK, 1);
}

// ---------------------------------------------------------------- 块类型栈

fn stack_push(mem: ptr, k: u32) {
    let n: u32 = load32(mem, S_STOP);
    if n < 16 {
        store32(mem, OFF_STACK + n * 4, k);
        store32(mem, S_STOP, n + 1);
    }
}

fn stack_pop(mem: ptr) {
    let n: u32 = load32(mem, S_STOP);
    if n > 0 {
        store32(mem, S_STOP, n - 1);
    }
}

fn stack_top(mem: ptr) -> u32 {
    let n: u32 = load32(mem, S_STOP);
    if n == 0 {
        return 0;
    }
    return load32(mem, OFF_STACK + (n - 1) * 4);
}

/// Python 的 _brace_kind: 从当前行的 token 倒着找, 第一个 type/match 类关键字定类型。
fn brace_kind(mem: ptr, src: ptr, t: ptr) -> u32 {
    let n: u32 = load32(mem, S_LTN);
    let q: u32 = n;
    while q > 0 {
        q = q - 1;
        let i: u32 = load32(mem, OFF_LTOK + q * 4);
        if tk_kind(t, i) == 0 {
            if v_in(src, t, i, 0, T_TYPE_BODY()) {
                if v_eq(src, t, i, 0, T_TYPE_BODY(), 18, 5) {
                    return 2;              // match (表内偏移 18)
                }
                return 1;                  // type: struct/enum/trait
            }
            if v_in(src, t, i, 0, T_BRACE_KW()) {
                return 0;                  // code
            }
        }
    }
    return 0;
}

// ---------------------------------------------------------------- 渲染

/// Python 的 _render: 字符串按"解码后重编码"写回, 其它原样。
fn emit_tok(mem: ptr, src: ptr, t: ptr, i: u32, mg: u32) -> u32 {
    if mg != 0 {
        line_push_byte(mem, load8(src, tk_start(t, i)) as u32);
        line_push_byte(mem, load8(src, tk_start(t, i + 1)) as u32);
        return 0;
    }
    if tk_kind(t, i) != 2 {
        line_push(mem, ptr_add(src, tk_start(t, i)), tk_len(t, i));
        return 0;
    }
    line_push_byte(mem, 34);
    let s: u32 = tk_start(t, i) + 1;
    let e: u32 = tk_start(t, i) + tk_len(t, i) - 1;
    let j: u32 = s;
    while j < e {
        let c: u32 = load8(src, j);
        if c == 92 && j + 1 < e {
            let x: u32 = load8(src, j + 1);
            c = x;                  // Python: _ESCAPES.get(x, x)
            if x == 110 { c = 10; }
            if x == 116 { c = 9; }
            if x == 114 { c = 13; }   // `#36`
            if x == 48 { c = 0; }     // `#33`
            j = j + 2;
        } else {
            j = j + 1;
        }
        if c == 92 {
            line_push_byte(mem, 92);
            line_push_byte(mem, 92);
        } else {
            if c == 34 {
                line_push_byte(mem, 92);
                line_push_byte(mem, 34);
            } else {
                if c == 10 {
                    line_push_byte(mem, 92);
                    line_push_byte(mem, 110);
                } else {
                    line_push_byte(mem, c);
                }
            }
        }
    }
    line_push_byte(mem, 34);
    return 0;
}

// ---------------------------------------------------------------- 空白规则

/// Python 的 _is_value_end(编码值) —— 0 (None) 也返回 0。
fn value_end(src: ptr, t: ptr, v: u32) -> bool {
    if v == 0 {
        return false;
    }
    let i: u32 = enc_idx(v);
    let mg: u32 = enc_mg(v);
    let k: u32 = tk_kind(t, i);
    if k == 0 || k == 1 || k == 2 {
        if v_in(src, t, i, mg, T_VEND_KW()) {
            return false;
        }
        return true;
    }
    if v_in(src, t, i, mg, T_RPAR_RBR()) {
        return true;
    }
    if v_in(src, t, i, mg, T_RBRACE()) {
        return true;
    }
    return false;
}

/// Python 的 _needs_space(pp, prev, cur)。
fn needs_space(src: ptr, t: ptr, pp: u32, prev: u32, i: u32, mg: u32) -> bool {
    if prev == 0 {
        return false;
    }
    let pi: u32 = enc_idx(prev);
    let pm: u32 = enc_mg(prev);
    if v_in(src, t, i, mg, T_NSB()) {
        return false;
    }
    if v_in(src, t, pi, pm, T_NSA()) {
        return false;
    }
    if v_in(src, t, i, mg, T_LPAR_LBR()) {
        let k: u32 = tk_kind(t, pi);
        if (k == 0 || k == 1 || k == 2) && !v_in(src, t, pi, pm, T_CONTROL()) {
            return false;
        }
        if v_in(src, t, pi, pm, T_RPAR_RBR()) {
            return false;
        }
    }
    if v_in(src, t, i, mg, T_BANG()) {
        return false;
    }
    if v_in(src, t, pi, pm, T_BANG()) {
        return false;
    }
    if v_in(src, t, i, mg, T_BIN()) || v_in(src, t, pi, pm, T_BIN()) {
        if v_in(src, t, i, mg, T_PMA()) && !value_end(src, t, prev) {
            return false;
        }
        if v_in(src, t, pi, pm, T_PMA()) && !value_end(src, t, pp) {
            return false;
        }
        return true;
    }
    return true;
}

// ---------------------------------------------------------------- 主流程

/// 格式化: 返回输出长度 (输出在 mem + OFF_OUT)。
pub fn format_src(src: ptr, t: ptr, n: u32, mem: ptr) -> u32 {
    store32(mem, S_DEPTH, 0);
    store32(mem, S_ACLOSE, 0);
    store32(mem, S_LASTTOP, 0);
    store32(mem, S_LLEN, 0);
    store32(mem, S_LTN, 0);
    store32(mem, S_OLEN, 0);
    store32(mem, S_NL, 0);
    store32(mem, S_LBLANK, 0);
    store32(mem, S_LBRACE, 0);
    store32(mem, S_STOP, 0);
    store32(mem, S_LHEAD, 0);
    let i: u32 = 0;
    let pp: u32 = 0;
    let prev: u32 = 0;
    while i < n && tk_kind(t, i) != 4 {
        let mg: u32 = merg_id(src, t, i, n);
        let step: u32 = 1;
        if mg != 0 {
            step = 2;
        }
        // ---- 上一个是 `}`: 下一条语句另起一行
        if load32(mem, S_ACLOSE) == 1 {
            store32(mem, S_ACLOSE, 0);
            if !v_in(src, t, i, mg, T_CLOSE_OK()) {
                flush_line(mem);
            }
        }
        // ---- 顶层声明之间插空行
        if load32(mem, S_DEPTH) == 0 && top_id(src, t, i) != 0 {
            // **修饰词不是声明本身的首词**（`#46`）：`pub fn f()` / `pub extern fn f()`
            // 要待在**同一行**，起头的是 `fn` / `struct` …（空行与分组也按那一个算）。
            // 判据是"这一行到现在**只有**修饰词"，而不是"刚看见 `pub`" —— 只认 `pub`
            // 的话 `pub extern fn` 仍会被劈开（`extern` 不是顶层关键字，不触发这一支）。
            let mods_only: u32 = 0;
            if load32(mem, S_LTN) > 0 && load32(mem, S_LHEAD) == 1 {
                mods_only = 1;
            }
            if mods_only == 0 {
                flush_line(mem);
            }
            if !v_in(src, t, i, mg, T_PUB()) {
                if load32(mem, S_NL) > 0 {
                    if load32(mem, S_LBLANK) == 0 {
                        if load32(mem, S_LASTTOP) != 0 {
                            if load32(mem, S_LASTTOP) != top_id(src, t, i) {
                                out_blank(mem);
                            } else {
                                if load32(mem, S_LBRACE) == 1 {
                                    out_blank(mem);
                                }
                            }
                        }
                    }
                }
                store32(mem, S_LASTTOP, top_id(src, t, i));
            }
        }
        // 推这一格之前，这一行已经有几个记号 —— 下面那道 `S_LHEAD` 的更新要用它。
        let head_was: u32 = load32(mem, S_LTN);
        let is_brace: u32 = 0;
        let is_close: u32 = 0;
        let is_semi: u32 = 0;
        let is_comma: u32 = 0;
        if v_in(src, t, i, mg, T_LBRACE()) {
            is_brace = 1;
        } else {
            if v_in(src, t, i, mg, T_RBRACE()) {
                is_close = 1;
            } else {
                if v_in(src, t, i, mg, T_SEMI()) {
                    is_semi = 1;
                } else {
                    if v_in(src, t, i, mg, T_COMMA()) {
                        is_comma = 1;
                    }
                }
            }
        }
        if is_brace == 1 {
            let k: u32 = brace_kind(mem, src, t);
            if needs_space(src, t, pp, prev, i, mg) {
                line_push_byte(mem, 32);
            }
            line_push_byte(mem, 123);
            flush_line(mem);
            stack_push(mem, k);
            store32(mem, S_DEPTH, load32(mem, S_DEPTH) + 1);
            pp = prev;
            prev = enc(i, mg);
        } else {
            if is_close == 1 {
                flush_line(mem);
                let d: u32 = load32(mem, S_DEPTH);
                if d > 0 {
                    store32(mem, S_DEPTH, d - 1);
                }
                stack_pop(mem);
                line_push_byte(mem, 125);
                line_tok(mem, i);
                pp = prev;
                prev = enc(i, mg);
                store32(mem, S_ACLOSE, 1);
            } else {
                if is_semi == 1 {
                    line_push_byte(mem, 59);
                    flush_line(mem);
                    pp = prev;
                    prev = enc(i, mg);
                } else {
                    if is_comma == 1 {
                        line_push_byte(mem, 44);
                        let st: u32 = stack_top(mem);
                        if st == 1 || st == 2 {
                            flush_line(mem);
                        }
                        pp = prev;
                        prev = enc(i, mg);
                    } else {
                        if load32(mem, S_LLEN) > 0 && needs_space(src, t, pp, prev, i, mg) {
                            line_push_byte(mem, 32);
                        }
                        emit_tok(mem, src, t, i, mg);
                        line_tok(mem, i);
                        pp = prev;
                        prev = enc(i, mg);
                    }
                }
            }
        }
        // **这一行到现在是不是只有修饰词**（`#46`）：空行起步的修饰词记 1，
        // 之后**每个**记号都得还是修饰词才保持 1，否则归 0（括号/分号/逗号当然归 0）。
        let hmod: u32 = 0;
        if tk_kind(t, i) == 0 && v_in(src, t, i, 0, T_HEAD_MODS()) {
            hmod = 1;
        }
        if head_was == 0 {
            store32(mem, S_LHEAD, hmod);
        } else {
            if load32(mem, S_LHEAD) == 1 && hmod == 1 {
                store32(mem, S_LHEAD, 1);
            } else {
                store32(mem, S_LHEAD, 0);
            }
        }
        i = i + step;
    }
    flush_line(mem);
    // Python: while out and out[-1] == "": out.pop() —— 只清尾部的空行
    let olen: u32 = load32(mem, S_OLEN);
    let cut: u32 = olen;
    while cut >= 2 && load8(mem, OFF_OUT + cut - 1) == 10 && load8(mem, OFF_OUT + cut - 2) == 10 {
        cut = cut - 1;
    }
    if cut == 0 {
        // Python 的 `"\n".join([]) + "\n"` = 一个换行 (空文件/只有注释的文件)
        store8(mem, OFF_OUT, 10 as u8);
        cut = 1;
    }
    store32(mem, S_OLEN, cut);
    return cut;
}

// ---------------------------------------------------------------- 别的写法要拦住

/// 文件头是不是**别的表层写法**（`docs/182` §1.9 / `#115`）？是就返回 1。
///
/// `lomfmt` 是**独立入口**：它拿词法层直接读原文、**不走前门** —— 而一份 `.lomt`
/// 里可以装六种写法的任何一种。对 C 那门后果很重：
///
///     choose write grammar c unsigned int f(unsigned int x) {   ← 声明与函数头揉成一行
///
/// 声明那一行整个是"**怎么读**"：前门按它定读法、再抹成等长空白 ⇒ **那一行上的
/// 函数跟着一起消失**，单元变空，而这里**退 0** 把一份删掉了函数的源交出去 ——
/// 而 `--write` 是**原地写回**，用户那份源就这么被改坏了（`#115` 的实测）。
/// 同一份文件 `loment check` 是**响亮地拒**的 —— 一套工具链两个答案。
///
/// 所以与参考实现 `potato_from.refuse_foreign_grammar` 同一条：**认出非原生写法就拒**。
/// `loment` / `rust` 是原生（`NATIVE_GRAMMARS`），照旧放行。
///
/// 找法与报错器的 `decl_at` 同一个形状：**只找那一行**（`choose write grammar <别名>`
/// 三个词同行、别名紧跟着），而且它必须在 `module` 之前（`docs/188` §1）。
fn foreign_grammar(src: ptr, t: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if tk_is(src, t, i, "module") == true {
            return 0;                       // 声明必须写在 `module` 之前
        }
        if tk_is(src, t, i, "choose") == true && i + 3 < n
                && tk_is(src, t, i + 1, "write") == true
                && tk_is(src, t, i + 2, "grammar") == true
                && tk_line(t, i) == tk_line(t, i + 1)
                && tk_line(t, i) == tk_line(t, i + 2)
                && tk_line(t, i) == tk_line(t, i + 3) {
            if tk_is(src, t, i + 3, "loment") == true
                    || tk_is(src, t, i + 3, "rust") == true {
                return 0;                   // 原生写法，照旧放行
            }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 入口

fn _start() -> u32 {
    let memv: u64 = sys_alloc(MEM_CAP as u64);
    let srcv: u64 = sys_alloc(SRC_CAP as u64);
    let tokv: u64 = sys_alloc((SRC_CAP as u64) * 20 + 4096);
    let argv_buf: u64 = sys_alloc(65536);
    let scrv: u64 = sys_alloc(8192);
    if memv == 0 || srcv == 0 || tokv == 0 || argv_buf == 0 || scrv == 0 {
        return fail("out of memory (brk failed)");
    }
    let mem: ptr = memv as ptr;
    let src: ptr = srcv as ptr;
    let toks: ptr = tokv as ptr;
    let scr: ptr = scrv as ptr;
    let av: u64 = argv1(argv_buf as ptr, 65536, scr);
    if av == 0 {
        return fail("usage: loment fmt <file.lomt>");
    }
    let ap: ptr = ptr_add(argv_buf as ptr, (av >> 32) as u32);
    let an: u32 = (av % 4294967296) as u32;
    let fd: i64 = open_ro(ap, an, scr);
    if fd < 0 {
        return failp("cannot open the input file: ", ap, an);
    }
    let raw: u64 = read_all(fd as u64, src, SRC_CAP as u64);
    syscall4(3, fd as u64, 0, 0);
    let len: u32 = strip_cr(src, raw as u32);
    store8(src, len, 0 as u8);
    let cnt: u32 = lex(src, len, toks);
    // **别的写法在这里拦住**（`#115`）—— 必须在**拿到词法流、动手重排之前**。
    // `--write` 是**原地写回**：声明那一行一旦被当成正文重排，前门会把它抹成等长空白，
    // 那一行上的函数跟着消失，而这里照旧退 0 —— 用户的源就这么被改坏了。
    if foreign_grammar(src, toks, cnt) == 1 {
        return fail("this source is written in another grammar (its header has `choose write grammar`) and this formatter takes the native spelling only -- hand the file to the compiler instead: `loment check <file>`");
    }
    let m: u32 = format_src(src, toks, cnt, mem);
    write_all(1, ptr_add(mem, OFF_OUT), m as u64);
    return die(0);
}
