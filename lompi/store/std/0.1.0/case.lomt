// std/case.lomt — Unicode 简单大小写映射与不区分大小写比较
//
// 为什么不能只做 ASCII: 只把 'a'..'z' 减 32 是**错**的 —— 土耳其语、希腊语、
// 西里尔、全角字母、以及星形平面的 Deseret 都各有各的 delta, 而且同一段里还会
// 断开 (拉丁小写 0x61..0x7A 是 -32, 但 0xF7 '÷' 没有映射, 所以 0xE0..0xFE 要分成
// 两段)。手写这些区间必错, 所以这张表由 `tools/gen_case_tables.py` 从 Python 的
// str.upper()/str.lower() 生成, 压缩成"码点连续 + delta 相同"的区间。
//
// 表在源码里是十六进制串, 每段 17 个字符: 起 6 位 + 止 6 位 + (delta+65536) 5 位。
// **delta 要 5 位不是 4 位**: 切罗基文 (U+13A0..U+13F5 大写 与 U+AB70..U+ABBF 小写)
// 的 delta 是 ±38864, 16 位装不下 —— 第一版我按 4 位编, 生成的表直接把切罗基文
// 悄悄截断成了别的码点 (不报错, 查出来是错的)。读表时 delta = 字段 - 65536,
// 在 u32 下加法回绕, 负数自动正确。
//
// 范围: 只扫到 0x20000。Unicode 全部单字符大小写映射都在这之下 (最高是 Adlam
// U+1E900 一带), 但**这不是全部 Unicode**: 下面是明确的取舍清单。
//
// 诚实清单 (不做什么, 为什么):
//   - **只做 simple case mapping**, 不做 full: 'ß'.upper() 在真实 Unicode 里是
//     "SS" 两个字符, 'İ'.lower() 是 "i"+组合点。这里都**不做** —— 那是"一变多",
//     会改变字符串长度结构, 属于 case folding 的上层。于是 case_upper_cp(0xDF) == 0xDF
//     (原样返回), 这是取舍不是 bug。
//   - **不做 full case folding**: 比较用**小写折叠**, 不是 Unicode 的 CaseFolding.txt。
//     于是 'K'(Kelvin U+212A) 与 'k' 相等 (两者小写都是 'k'), 但 'ß' 与 "SS" 不等,
//     'ſ'(U+017F) 与 's' 不等。要做精确折叠得再引一张 CaseFolding 表。
//   - **不做 locale 敏感的大写**: 土耳其语的 'i'/'I' 无点/有点规则不在这里 ——
//     那需要运行时知道 locale, 而这一层没有那个信息。
//   - **非法 UTF-8 原样拷字节**, 不当成 U+FFFD: 转换的最常见用途就是"原样透传用户
//     文本再动其中几个字母", 把坏字节替换掉会悄悄改变数据。
//
// 命名: 公开 case_*, 内部 c_*。自检 test_case_*。

module case

use "mem.lomt"
use "utf8.lomt"

/// 码点在本表里没有映射。**公开 API 不用它**: `case_upper_cp` 等无映射时原样返回
/// 输入。它只对 `c_seg_find` 这一层的"没查到"有意义, 暴露出来是为了让调用方在
/// 需要区分"改了"和"没改"时有个哨兵 (对比: 没有映射是正常情况, 不是错误, 所以
/// 和 `CASE_ERR` 分开; 本模块根本没有"坏输入"这一类, 故没有 CASE_ERR)。
pub const CASE_NONE: u32 = 4294967295;

// ---------------------------------------------------------------- 映射表 (生成)

fn c_up_hex() -> str {
    return "";
}
fn c_up_hex_1() -> str {
    return "";
}
fn c_up_hex_2() -> str {
    return "";
}
fn c_up_hex_3() -> str {
    return "";
}
fn c_up_hex_4() -> str {
    return "";
}
fn c_up_hex_5() -> str {
    return "";
}
fn c_up_hex_6() -> str {
    return "";
}
fn c_up_hex_7() -> str {
    return "";
}
fn c_up_hex_8() -> str {
    return "";
}
fn c_up_hex_9() -> str {
    return "";
}

fn c_lo_hex() -> str {
    return "";
}
fn c_lo_hex_1() -> str {
    return "";
}
fn c_lo_hex_2() -> str {
    return "";
}
fn c_lo_hex_3() -> str {
    return "";
}
fn c_lo_hex_4() -> str {
    return "";
}
fn c_lo_hex_5() -> str {
    return "";
}
fn c_lo_hex_6() -> str {
    return "";
}
fn c_lo_hex_7() -> str {
    return "";
}
fn c_lo_hex_8() -> str {
    return "";
}
fn c_lo_hex_9() -> str {
    return "";
}

// ---------------------------------------------------------------- 查表

fn c_hv(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return c - 55;
}

/// 从 s 的第 i 个字符起读 k 个十六进制位。
fn c_hex(s: str, i: u32, k: u32) -> u32 {
    let v: u32 = 0;
    let j: u32 = 0;
    while j < k {
        v = (v << 4) | c_hv(str_byte(s, i + j));
        j = j + 1;
    }
    return v;
}

/// 在一段表里查 cp。查不到给 CASE_NONE。
/// 区间按**起点排序**, 所以"当前段起点已经比 cp 大"就能停 —— 后面只会更大。
fn c_seg_find(s: str, cp: u32) -> u32 {
    let n: u32 = str_len(s) / 17;
    let i: u32 = 0;
    while i < n {
        let lo: u32 = c_hex(s, i * 17, 6);
        if cp < lo {
            return CASE_NONE;
        }
        if cp <= c_hex(s, i * 17 + 6, 6) {
            // delta = 字段 - 65536; 负数时 u32 回绕, cp + delta 仍正确
            return cp + (c_hex(s, i * 17 + 12, 5) - 65536);
        }
        i = i + 1;
    }
    return CASE_NONE;
}

fn c_up_find(cp: u32) -> u32 {
    let v: u32 = c_seg_find(c_up_hex(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_1(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_2(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_3(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_4(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_5(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_6(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_7(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_8(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_up_hex_9(), cp);
    if v != CASE_NONE { return v; }
    return CASE_NONE;
}

fn c_lo_find(cp: u32) -> u32 {
    let v: u32 = c_seg_find(c_lo_hex(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_1(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_2(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_3(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_4(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_5(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_6(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_7(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_8(), cp);
    if v != CASE_NONE { return v; }
    v = c_seg_find(c_lo_hex_9(), cp);
    if v != CASE_NONE { return v; }
    return CASE_NONE;
}

// ---------------------------------------------------------------- 单码点

/// 大写映射; 没有映射原样返回。
pub fn case_upper_cp(cp: u32) -> u32 {
    let v: u32 = c_up_find(cp);
    if v == CASE_NONE {
        return cp;
    }
    return v;
}

/// 小写映射; 没有映射原样返回。
pub fn case_lower_cp(cp: u32) -> u32 {
    let v: u32 = c_lo_find(cp);
    if v == CASE_NONE {
        return cp;
    }
    return v;
}

/// 是不是大写字母。判据是"小写会改变它" —— 这是**近似**: 对 Lu/Lt 都算真,
/// 而 Unicode 的严格判据还看类别 (比如某些符号不是字母却有小写映射)。
pub fn case_is_upper_cp(cp: u32) -> bool {
    return case_lower_cp(cp) != cp;
}

pub fn case_is_lower_cp(cp: u32) -> bool {
    return case_upper_cp(cp) != cp;
}

// ---------------------------------------------------------------- 整段转换

/// 一段 UTF-8 转换后要几字节。up==1 转大写, 否则转小写。
fn c_map_len(d: ptr, so: u32, n: u32, up: u32) -> u32 {
    let end: u32 = so + n;
    let i: u32 = so;
    let w: u32 = 0;
    while i < end {
        let t: u64 = utf8_get(d, i, end);
        let k: u32 = utf8_used(t);
        if k == 0 {
            w = w + 1;
            i = i + 1;
        } else {
            let cp: u32 = utf8_cp(t);
            let m: u32 = case_lower_cp(cp);
            if up == 1 {
                m = case_upper_cp(cp);
            }
            w = w + utf8_len_of(m);
            i = i + k;
        }
    }
    return w;
}

/// 一段 UTF-8 转换后需要几字节 (不写输出)。
pub fn case_upper_len(d: ptr, so: u32, n: u32) -> u32 {
    return c_map_len(d, so, n, 1);
}

pub fn case_lower_len(d: ptr, so: u32, n: u32) -> u32 {
    return c_map_len(d, so, n, 0);
}

/// 转换一段 UTF-8 写进 out[oo..], 返回写的字节数。长度可能**变**:
/// 0x131 (ı, 2 字节) 的大写是 'I' (1 字节), 0xB5 (µ, 2 字节) 的大写是
/// U+039C (Μ, 2 字节, 不变), 0x212A (K, 3 字节) 的小写是 'k' (1 字节)。
/// 输出缓冲要按 `case_upper_len`/`case_lower_len` 留够。
fn c_map(d: ptr, so: u32, n: u32, out: ptr, oo: u32, up: u32) -> u32 {
    let end: u32 = so + n;
    let i: u32 = so;
    let w: u32 = oo;
    while i < end {
        let t: u64 = utf8_get(d, i, end);
        let k: u32 = utf8_used(t);
        if k == 0 {
            store8(out, w, load8(d, i) as u8);
            w = w + 1;
            i = i + 1;
        } else {
            let cp: u32 = utf8_cp(t);
            let m: u32 = case_lower_cp(cp);
            if up == 1 {
                m = case_upper_cp(cp);
            }
            w = utf8_put(out, w, m);
            i = i + k;
        }
    }
    return w - oo;
}

pub fn case_upper(d: ptr, so: u32, n: u32, out: ptr, oo: u32) -> u32 {
    return c_map(d, so, n, out, oo, 1);
}

pub fn case_lower(d: ptr, so: u32, n: u32, out: ptr, oo: u32) -> u32 {
    return c_map(d, so, n, out, oo, 0);
}

pub fn case_upper_str(out: ptr, oo: u32, s: str) -> u32 {
    return c_map(str_ptr(s), 0, str_len(s), out, oo, 1);
}

pub fn case_lower_str(out: ptr, oo: u32, s: str) -> u32 {
    return c_map(str_ptr(s), 0, str_len(s), out, oo, 0);
}

// ---------------------------------------------------------------- 不区分大小写比较

/// 两段 UTF-8 不区分大小写是否相等。
/// 折叠方式是**小写折叠** (两边各取 `case_lower_cp` 再比), 不是 full case folding ——
/// 这让 'K'(U+212A) 等于 'k', 但 'ß' 不等于 "SS" (见文件头诚实清单)。
/// 字节长度可以不同 (K 是 3 字节, 'k' 是 1 字节, 这条路径是活的)。
/// 任一侧出现非法 UTF-8 时退化成**逐字节**比较那一步 (不做替换, 不越界)。
pub fn case_eq_ignore_case(ap: ptr, ao: u32, an: u32, bp: ptr, bo: u32, bn: u32) -> bool {
    let ae: u32 = ao + an;
    let be: u32 = bo + bn;
    let ai: u32 = ao;
    let bi: u32 = bo;
    let done: u32 = 0;
    let eq: u32 = 1;
    while done == 0 {
        if ai >= ae && bi >= be {
            done = 1;
        } else if ai >= ae || bi >= be {
            eq = 0;
            done = 1;
        } else {
            let x: u64 = utf8_get(ap, ai, ae);
            let y: u64 = utf8_get(bp, bi, be);
            let ux: u32 = utf8_used(x);
            let uy: u32 = utf8_used(y);
            if ux == 0 || uy == 0 {
                if load8(ap, ai) != load8(bp, bi) {
                    eq = 0;
                }
                ai = ai + 1;
                bi = bi + 1;
            } else {
                if case_lower_cp(utf8_cp(x)) != case_lower_cp(utf8_cp(y)) {
                    eq = 0;
                }
                ai = ai + ux;
                bi = bi + uy;
            }
        }
    }
    return eq == 1;
}

/// 传 str 的便利版。
pub fn case_eq_ignore_case_str(a: str, b: str) -> bool {
    return case_eq_ignore_case(str_ptr(a), 0, str_len(a), str_ptr(b), 0, str_len(b));
}

// ---------------------------------------------------------------- 自检

fn test_case_ascii_upper() -> bool {
    let out: ptr = alloc(32);
    let n: u32 = case_upper(str_ptr("hello world"), 0, 11, out, 0);
    let want: str = "HELLO WORLD";
    return n == 11 && mem_eq(out, 0, str_ptr(want), 0, 11);
}

fn test_case_ascii_lower() -> bool {
    let out: ptr = alloc(32);
    let src: str = "Hello, World!";
    let n: u32 = case_lower(str_ptr(src), 0, str_len(src), out, 0);
    let want: str = "hello, world!";
    return n == str_len(src) && mem_eq(out, 0, str_ptr(want), 0, str_len(want));
}

fn test_case_ascii_non_letters_untouched() -> bool {
    // 数字与标点没有映射 -> 原样。
    let out: ptr = alloc(32);
    let src: str = "a1 B2-c3";
    let n: u32 = case_upper(str_ptr(src), 0, str_len(src), out, 0);
    let want: str = "A1 B2-C3";
    return n == 8 && mem_eq(out, 0, str_ptr(want), 0, 8);
}

fn test_case_latin1_upper() -> bool {
    // é (C3 A9) -> É (C3 89)
    let out: ptr = alloc(16);
    let src: str = "é";
    let n: u32 = case_upper(str_ptr(src), 0, str_len(src), out, 0);
    let want: str = "É";
    return n == 2 && mem_eq(out, 0, str_ptr(want), 0, 2);
}

fn test_case_latin1_lower() -> bool {
    // ẞ (U+1E9E) -> ß (U+00DF). 这条盯着"简单映射里 ẞ 有小写", 而反过来 ß 无大写。
    return case_lower_cp(0x1E9E) == 0xDF && case_upper_cp(0xDF) == 0xDF;
}

fn test_case_greek_roundtrip() -> bool {
    let up: ptr = alloc(16);
    let down: ptr = alloc(16);
    let src: str = "αβγ";
    let n: u32 = case_upper(str_ptr(src), 0, str_len(src), up, 0);
    let want: str = "ΑΒΓ";
    let m: u32 = case_lower(up, 0, n, down, 0);
    return n == 6 && mem_eq(up, 0, str_ptr(want), 0, 6) && m == 6 && mem_eq(down, 0, str_ptr(src), 0, 6);
}

fn test_case_cyrillic() -> bool {
    let out: ptr = alloc(32);
    let src: str = "привет";
    let n: u32 = case_upper(str_ptr(src), 0, str_len(src), out, 0);
    let want: str = "ПРИВЕТ";
    return n == 12 && mem_eq(out, 0, str_ptr(want), 0, 12);
}

fn test_case_fullwidth() -> bool {
    // 全角 ａ(U+FF41) -> Ａ(U+FF21), 小写区与大写区相隔 0xFF20。
    let out: ptr = alloc(16);
    let d: ptr = alloc(16);
    let a: u32 = utf8_put(d, 0, 65345); // ａ
    let b: u32 = utf8_put(d, a, 65346); // ｂ
    let n: u32 = case_upper(d, 0, b, out, 0);
    let e: ptr = alloc(16);
    let c: u32 = utf8_put(e, 0, 65313); // Ａ (0xFF21)
    let g: u32 = utf8_put(e, c, 65314); // Ｂ (0xFF22)
    return n == g && mem_eq(out, 0, e, 0, g);
}

fn test_case_deseret_astral() -> bool {
    // 𐐨 U+10428 -> 𐐀 U+10400。星形平面, 4 字节 UTF-8 —— 走的是 4 字节分支。
    let d: ptr = alloc(8);
    let out: ptr = alloc(8);
    let e: ptr = alloc(8);
    let n: u32 = utf8_put(d, 0, 66600);
    let m: u32 = case_upper(d, 0, n, out, 0);
    let k: u32 = utf8_put(e, 0, 66560);
    return n == 4 && m == 4 && mem_eq(out, 0, e, 0, 4) && case_upper_cp(66600) == 66560;
}

fn test_case_cherokee_big_delta() -> bool {
    // 切罗基文: 大小写块相距 ±38864 —— 表里 delta 字段必须是 5 个十六进制位。
    // 第一版我按 4 位编, 这条会挂 (而且不报错, 只是给出错的码点)。
    return case_upper_cp(0xAB70) == 0x13A0 && case_lower_cp(0x13A0) == 0xAB70;
}

fn test_case_micro_sign() -> bool {
    // µ (U+00B5) 的大写是希腊 Μ (U+039C) —— 不是 ASCII, 且 delta 是正的 743。
    return case_upper_cp(0xB5) == 0x39C && case_lower_cp(0x39C) == 0x3BC;
}

fn test_case_identity_when_no_mapping() -> bool {
    // 汉字、数字、符号都没有大小写 —— 原样返回。
    return case_upper_cp(0x4E2D) == 0x4E2D && case_lower_cp(0x4E2D) == 0x4E2D
        && case_upper_cp(0x30) == 0x30 && case_upper_cp(0x2603) == 0x2603;
}

fn test_case_is_upper_lower() -> bool {
    return case_is_lower_cp(0x61) && case_is_upper_cp(0x41)
        && case_is_lower_cp(0x3B1) && case_is_upper_cp(0x391)
        && !case_is_upper_cp(0x30) && !case_is_lower_cp(0x30)
        && !case_is_upper_cp(0x4E2D);
}

fn test_case_upper_len_shrinks() -> bool {
    // ı (U+0131) 是 2 字节, 大写是 'I' (1 字节) —— 长度真的会变。
    // 输出缓冲按 case_upper_len 留的话不会溢出。
    let d: ptr = alloc(8);
    let out: ptr = alloc(8);
    let n: u32 = utf8_put(d, 0, 305);
    let l: u32 = case_upper_len(d, 0, n);
    let w: u32 = case_upper(d, 0, n, out, 0);
    return n == 2 && l == 1 && w == 1 && load8(out, 0) == 73;
}

fn test_case_upper_len_ascii() -> bool {
    let s: str = "abc";
    return case_upper_len(str_ptr(s), 0, 3) == 3 && case_lower_len(str_ptr(s), 0, 3) == 3
        && case_upper_len(str_ptr(s), 0, 0) == 0;
}

fn test_case_eq_ignore_case_ascii() -> bool {
    let a: str = "HeLLo";
    let b: str = "hello";
    let c: str = "hellp";
    let d: str = "hell";
    return case_eq_ignore_case_str(a, b) && !case_eq_ignore_case_str(a, c)
        && !case_eq_ignore_case_str(a, d) && case_eq_ignore_case_str(a, a);
}

fn test_case_eq_ignore_case_latin_greek() -> bool {
    let e1: str = "É";
    let e2: str = "é";
    let g1: str = "ΑΒΓ";
    let g2: str = "αβγ";
    return case_eq_ignore_case_str(e1, e2) && case_eq_ignore_case_str(g1, g2)
        && !case_eq_ignore_case_str(g1, "ΑΒΔ");
}

fn test_case_eq_ignore_case_diff_byte_len() -> bool {
    // Kelvin K (U+212A, 3 字节) 与 ASCII 'k' (1 字节) —— 折叠后相等, 但两侧
    // 推进的字节数不同。这条路走岔了会死循环或越界。
    let d: ptr = alloc(8);
    let n: u32 = utf8_put(d, 0, 8490);
    let k: str = "k";
    let yes: bool = case_eq_ignore_case(d, 0, n, str_ptr(k), 0, 1);
    let no: bool = case_eq_ignore_case(d, 0, n, str_ptr(k), 0, 0);
    return n == 3 && yes && !no;
}

fn test_case_eq_ignore_case_bad_bytes() -> bool {
    // 非法 UTF-8: 退化成逐字节比较, 不替换、不越界。
    // 第一版我把 b 的首字节也写成 'A', 结果 a/b 在前几字节就折叠相等了 ——
    // 那条断言恒真, 等于没测。改成 'b' 才真的走到"不相等"。
    let a: ptr = alloc(8);
    let b: ptr = alloc(8);
    store8(a, 0, 97 as u8);  // 'a'
    store8(a, 1, 255 as u8); // 坏字节
    store8(b, 0, 98 as u8);  // 'b' —— 与 'a' 不折叠相等
    store8(b, 1, 255 as u8);
    let same: bool = case_eq_ignore_case(a, 0, 2, a, 0, 2);
    let diff: bool = case_eq_ignore_case(a, 0, 2, b, 0, 2) == false;
    // 坏字节本身不同也要判不等 (不能因为"解不出码点"就跳过这一段)
    let c: ptr = alloc(8);
    store8(c, 0, 97 as u8);
    store8(c, 1, 254 as u8);
    let diff2: bool = case_eq_ignore_case(a, 0, 2, c, 0, 2) == false;
    return same && diff && diff2;
}

fn test_case_table_shape() -> bool {
    // 每段 17 个十六进制字符; 首段第一个区间是 'a'..'z' (上表) / 'A'..'Z' (下表)。
    let u: str = c_up_hex();
    let l: str = c_lo_hex();
    return (str_len(u) % 17) == 0 && (str_len(l) % 17) == 0
        && c_hex(u, 0, 6) == 0x61 && c_hex(u, 6, 6) == 0x7A
        && c_hex(u, 12, 5) == 65504 // delta -32 -> 65536-32
        && c_hex(l, 0, 6) == 0x41 && c_hex(l, 6, 6) == 0x5A
        && c_up_find(0x61) == 0x41 && c_up_find(0x4E2D) == CASE_NONE;
}
