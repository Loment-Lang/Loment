// std/mst.lomt — 最小生成树: Kruskal 与 Prim
//
// 为什么两个都要: 它们是最小生成树的**两条独立证明** (割性质 / 环性质), 也是两种工程取舍:
//   * Kruskal —— 边排序 + 并查集, 稀疏图友好, 天然给出**森林** (不连通时每棵树一条)。
//   * Prim    —— 从一点长开 + 堆, 稠密图友好, 需要邻接表。
// 本模块把两个都实现, 并在同一张图上交叉验证总权相等 —— 这比"对着答案数"值钱, 因为两条
// 路径的实现几乎不共享代码, 同时错成一样的概率极低。
//
// 输入用 graph.lomt 的表示。两种喂法:
//   Kruskal —— 吃 eb (每条无向边**一次**), 内部会**就地按权重把它排序**。
//   Prim    —— 吃 csr, 用 gr_build_undirected 从同一个 eb 铺 (自动补反向边)。
//
// 内存布局 (调用方 alloc):
//   uf  —— 并查集: [0]n, 然后 parent[n], 然后 rank[n]。mst_uf_bytes(n) 给大小。
//   (Kruskal 的 eb 原地排序, 不需要额外排序缓冲)
//   out_idx —— u32[n-1]: 选中的边在 eb 里的下标 (排序后的下标)。
//   out_total —— 任意 >=8 字节: 本函数把总权 i64 写在偏移 0。
//   visited/heap —— Prim 的 0/1 标记与最小堆 (std/heap.lomt)。
//
// 返回值:
//   Kruskal / Prim 都返回**选中的边数** (连通用 n-1; 森林小于 n-1, 分量数 = n - 边数);
//   出错返回 MST_ERR (点号越界 / out 缓冲不够 / Prim 遇负权或堆满)。
//
// 诚实清单:
//   * **Prim 要求边权非负且 < 2^32**: 它把 (权, 点) 编码成一个 u64 塞进 std/heap.lomt 的堆
//     (那个堆只比裸 u64)。负权会被 MST_ERR 拦下, 不是静默算错。Kruskal 没有这个限制 ——
//     负权图请用 Kruskal。
//   * Kruskal 就地排序 eb。想要保留原顺序就先拷一份。(顺序不影响 Prim 的正确性, 只影响
//     邻接表里邻居的先后。)
//   * 不处理自环以外的重边去重: 平行边都进排序, 并查集自然只采纳成环前那条最小的。
//   * 并查集是**内联**的: std/unionfind.lomt 在本批里尚不存在 (mst 是第一个需要它的),
//     内联一份最小实现胜过为一个 40 行的东西再造一个跨模块依赖。若日后 unionfind.lomt 出现,
//     这里应改成 use。
//
// 命名: 公开 mst_*, 内部 ms_* / mu_*。自检 test_mst_*。

module mst

use "mem.lomt"
use "graph.lomt"
use "heap.lomt"

pub const MST_ERR: u32 = 4294967295;
pub const MST_NONE: u32 = 4294967294;

// ---------------------------------------------------------------- 并查集 (内联)

pub fn mst_uf_bytes(n: u32) -> u32 {
    return 4 + 8 * n;
}

fn mu_n(uf: ptr) -> u32 {
    return mem_load32(uf, 0);
}

fn mu_parent(uf: ptr, x: u32) -> u32 {
    return mem_load32(uf, 4 + 4 * x);
}

fn mu_set_parent(uf: ptr, x: u32, v: u32) {
    mem_store32(uf, 4 + 4 * x, v);
}

fn mu_rank(uf: ptr, x: u32) -> u32 {
    return mem_load32(uf, 4 + 4 * mu_n(uf) + 4 * x);
}

fn mu_set_rank(uf: ptr, x: u32, v: u32) {
    mem_store32(uf, 4 + 4 * mu_n(uf) + 4 * x, v);
}

pub fn mst_uf_init(uf: ptr, n: u32) {
    mem_store32(uf, 0, n);
    let i: u32 = 0;
    while i < n {
        mu_set_parent(uf, i, i);
        mu_set_rank(uf, i, 0);
        i = i + 1;
    }
}

/// 找根 + 路径压缩 (迭代两遍: 先走到根, 再把路上每个直接挂到根上)。
/// 带步数上限 —— 万一并查集被写坏 (parent 成环), 在这里停住而不是死循环。
pub fn mst_uf_find(uf: ptr, x: u32) -> u32 {
    let n: u32 = mu_n(uf);
    let r: u32 = x;
    let go: u32 = 1;
    let steps: u32 = 0;
    while go == 1 {
        let p: u32 = mu_parent(uf, r);
        if p == r || steps > n {
            go = 0;
        } else {
            r = p;
            steps = steps + 1;
        }
    }
    let c: u32 = x;
    let steps2: u32 = 0;
    while mu_parent(uf, c) != r && steps2 <= n {
        let nx: u32 = mu_parent(uf, c);
        mu_set_parent(uf, c, r);
        c = nx;
        steps2 = steps2 + 1;
    }
    return r;
}

/// 合并两个集合。已经在同一个集合里返回 false (**不静默**: 调用方靠它判环)。
pub fn mst_uf_union(uf: ptr, a: u32, b: u32) -> bool {
    let ra: u32 = mst_uf_find(uf, a);
    let rb: u32 = mst_uf_find(uf, b);
    if ra == rb {
        return false;
    }
    let sa: u32 = mu_rank(uf, ra);
    let sb: u32 = mu_rank(uf, rb);
    if sa < sb {
        mu_set_parent(uf, ra, rb);
    } else if sa > sb {
        mu_set_parent(uf, rb, ra);
    } else {
        mu_set_parent(uf, rb, ra);
        mu_set_rank(uf, ra, sa + 1);
    }
    return true;
}

pub fn mst_uf_same(uf: ptr, a: u32, b: u32) -> bool {
    return mst_uf_find(uf, a) == mst_uf_find(uf, b);
}

/// 分量数 (数有多少个根)。
pub fn mst_uf_components(uf: ptr, n: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    while i < n {
        if mst_uf_find(uf, i) == i {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

// ---------------------------------------------------------------- Kruskal

fn ms_rec_swap(eb: ptr, i: u32, j: u32) {
    let ui: u32 = gr_edge_u(eb, i);
    let vi: u32 = gr_edge_v(eb, i);
    let wi: i64 = gr_edge_w(eb, i);
    let uj: u32 = gr_edge_u(eb, j);
    let vj: u32 = gr_edge_v(eb, j);
    let wj: i64 = gr_edge_w(eb, j);
    gr_set_edge(eb, i, uj, vj, wj);
    gr_set_edge(eb, j, ui, vi, wi);
}

/// 就地按权重升序排 eb。希尔排序 (步长折半): 原地、无额外缓冲、对中等规模足够,
/// 不需要再引一个排序模块。
pub fn mst_sort_edges(eb: ptr, m: u32) {
    let gap: u32 = m / 2;
    while gap > 0 {
        let i: u32 = gap;
        while i < m {
            let j: u32 = i;
            let go: u32 = 1;
            while j >= gap && go == 1 {
                let a: u32 = j - gap;
                if gr_edge_w(eb, j) < gr_edge_w(eb, a) {
                    ms_rec_swap(eb, j, a);
                    j = j - gap;
                } else {
                    go = 0;
                }
            }
            i = i + 1;
        }
        gap = gap / 2;
    }
}

/// Kruskal。返回选中边数, 出错 MST_ERR。总权写到 out_total 偏移 0。
/// out_idx 至少要 n-1 个槽 (u32)。
pub fn mst_kruskal(eb: ptr, n: u32, uf: ptr, out_idx: ptr, out_cap: u32, out_total: ptr) -> u32 {
    let m: u32 = gr_len(eb);
    // 先验点号, 再动任何东西 (越界写会静默踩坏别的缓冲)。
    let c: u32 = 0;
    while c < m {
        if gr_edge_u(eb, c) >= n || gr_edge_v(eb, c) >= n {
            return MST_ERR;
        }
        c = c + 1;
    }
    mst_sort_edges(eb, m);
    mst_uf_init(uf, n);
    let total: i64 = 0;
    let cnt: u32 = 0;
    let over: u32 = 0;
    let e: u32 = 0;
    while e < m {
        let u: u32 = gr_edge_u(eb, e);
        let v: u32 = gr_edge_v(eb, e);
        if mst_uf_union(uf, u, v) {
            if cnt >= out_cap {
                over = 1;
            } else {
                mem_store32(out_idx, 4 * cnt, e);
            }
            total = total + gr_edge_w(eb, e);
            cnt = cnt + 1;
        }
        e = e + 1;
    }
    if over == 1 {
        return MST_ERR;
    }
    mem_store64(out_total, 0, total as u64);
    return cnt;
}

// ---------------------------------------------------------------- Prim

/// Prim。从 src 起把能到的点长成一棵树。返回收进树的点数 (森林时小于 n), 出错 MST_ERR。
/// 总权写到 out_total 偏移 0。visited[n] 是 0/1 标记, heap 要 heap_bytes(cap) 大小,
/// cap 至少 m+1 (每次扩张最多压入它的未访问邻居)。
pub fn mst_prim(csr: ptr, src: u32, visited: ptr, heap: ptr, cap: u32, out_total: ptr) -> u32 {
    let n: u32 = gr_n(csr);
    if src >= n {
        return MST_ERR;
    }
    let i: u32 = 0;
    while i < n {
        mem_store32(visited, 4 * i, 0);
        i = i + 1;
    }
    heap_init(heap);
    let total: i64 = 0;
    let cnt: u32 = 0;
    let bad: u32 = 0;
    // 起点用权重 0 入堆; 编码 = (权 << 32) | 点。
    if heap_push(heap, cap, (0 as u64) << 32 | (src as u64)) == false {
        return MST_ERR;
    }
    while heap_len(heap) > 0 {
        let k: u64 = heap_pop(heap);
        let node: u32 = (k & 4294967295) as u32;
        let w: i64 = ((k >> 32) as u32) as i64;
        if mem_load32(visited, 4 * node) == 0 {
            mem_store32(visited, 4 * node, 1);
            cnt = cnt + 1;
            total = total + w;
            let d: u32 = gr_degree(csr, node);
            let j: u32 = 0;
            while j < d {
                let v: u32 = gr_to(csr, node, j);
                let we: i64 = gr_w(csr, node, j);
                if we < 0 as i64 || we > 4294967295 as i64 {
                    bad = 1;
                } else {
                    if mem_load32(visited, 4 * v) == 0 {
                        if heap_push(heap, cap, ((we as u64) << 32) | (v as u64)) == false {
                            bad = 1;
                        }
                    }
                }
                j = j + 1;
            }
        }
    }
    if bad == 1 {
        return MST_ERR;
    }
    mem_store64(out_total, 0, total as u64);
    return cnt;
}

// ---------------------------------------------------------------- 自检

fn ts_total(p: ptr) -> i64 {
    return mem_load64(p, 0) as i64;
}

fn ts_edges4() -> ptr {
    // 经典 4 点: MST = 0-1(1)+1-2(2)+2-3(3) = 6。
    let eb: ptr = alloc(gr_edges_bytes(6));
    gr_edges_init(eb, 6);
    gr_add_edge(eb, 0, 1, 1);
    gr_add_edge(eb, 1, 2, 2);
    gr_add_edge(eb, 2, 3, 3);
    gr_add_edge(eb, 0, 3, 4);
    gr_add_edge(eb, 0, 2, 5);
    gr_add_edge(eb, 1, 3, 6);
    return eb;
}

fn ts_edges5() -> ptr {
    // 5 点 7 边: 手工推得 MST 总权 16 (2+3+5+6)。
    let eb: ptr = alloc(gr_edges_bytes(8));
    gr_edges_init(eb, 8);
    gr_add_edge(eb, 0, 1, 2);
    gr_add_edge(eb, 0, 3, 6);
    gr_add_edge(eb, 1, 2, 3);
    gr_add_edge(eb, 1, 3, 8);
    gr_add_edge(eb, 1, 4, 5);
    gr_add_edge(eb, 2, 4, 7);
    gr_add_edge(eb, 3, 4, 9);
    return eb;
}

fn test_mst_kruskal_classic4() -> bool {
    let eb: ptr = ts_edges4();
    let uf: ptr = alloc(mst_uf_bytes(4));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 4, uf, idx, 8, tot);
    return c == 3 && ts_total(tot) == 6 && mst_uf_components(uf, 4) == 1;
}

fn test_mst_kruskal_5node_total() -> bool {
    let eb: ptr = ts_edges5();
    let uf: ptr = alloc(mst_uf_bytes(5));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 5, uf, idx, 8, tot);
    return c == 4 && ts_total(tot) == 16;
}

fn test_mst_kruskal_total_is_sum_of_selected() -> bool {
    // 总权必须等于所选中边权之和 —— 抓"选了 A 却加了 B 的权"这类错。
    let eb: ptr = ts_edges5();
    let uf: ptr = alloc(mst_uf_bytes(5));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 5, uf, idx, 8, tot);
    let s: i64 = 0;
    let i: u32 = 0;
    while i < c {
        s = s + gr_edge_w(eb, mem_load32(idx, 4 * i));
        i = i + 1;
    }
    return c == 4 && s == ts_total(tot);
}

fn test_mst_kruskal_prim_same_total() -> bool {
    // 交叉验证: 同一张图, 两条独立实现, 总权必须一致。
    let eb: ptr = ts_edges5();
    let uf: ptr = alloc(mst_uf_bytes(5));
    let idx: ptr = alloc(32);
    let tk: ptr = alloc(16);
    let ck: u32 = mst_kruskal(eb, 5, uf, idx, 8, tk);
    let csr: ptr = alloc(gr_csr_bytes(5, 14));
    let built: bool = gr_build_undirected(eb, csr, 5);
    let vis: ptr = alloc(32);
    let heap: ptr = alloc(heap_bytes(10));
    let tp: ptr = alloc(16);
    let cp: u32 = mst_prim(csr, 0, vis, heap, 10, tp);
    return built && ck == 4 && cp == 5 && ts_total(tk) == 16 && ts_total(tp) == 16
        && ts_total(tk) == ts_total(tp);
}

fn test_mst_prim_from_every_start_same_total() -> bool {
    // 最小生成树与起点无关 —— 换个起点跑 Prim, 总权不该变。
    let eb: ptr = ts_edges5();
    let csr: ptr = alloc(gr_csr_bytes(5, 14));
    gr_build_undirected(eb, csr, 5);
    let s: u32 = 0;
    let ok: u32 = 1;
    while s < 5 {
        let vis: ptr = alloc(32);
        let heap: ptr = alloc(heap_bytes(10));
        let tp: ptr = alloc(16);
        let cp: u32 = mst_prim(csr, s, vis, heap, 10, tp);
        if cp != 5 || ts_total(tp) != 16 {
            ok = 0;
        }
        s = s + 1;
    }
    return ok == 1;
}

fn test_mst_forest_disconnected() -> bool {
    // 两个分量 {0,1,2} 与 {3,4}: Kruskal 选 3 条边, 分量数 = 5-3 = 2, 与 graph 一致。
    let eb: ptr = alloc(gr_edges_bytes(4));
    gr_edges_init(eb, 4);
    gr_add_edge(eb, 0, 1, 1);
    gr_add_edge(eb, 1, 2, 2);
    gr_add_edge(eb, 3, 4, 3);
    let uf: ptr = alloc(mst_uf_bytes(5));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 5, uf, idx, 8, tot);
    let comp: ptr = alloc(32);
    let q: ptr = alloc(32);
    let csr: ptr = alloc(gr_csr_bytes(5, 6));
    gr_build_undirected(eb, csr, 5);
    let nc: u32 = gr_components(csr, comp, q);
    return c == 3 && ts_total(tot) == 6 && mst_uf_components(uf, 5) == 2 && nc == 2
        && (5 - c) == nc;
}

fn test_mst_single_node() -> bool {
    let eb: ptr = alloc(gr_edges_bytes(2));
    gr_edges_init(eb, 2);
    let uf: ptr = alloc(mst_uf_bytes(1));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 1, uf, idx, 8, tot);
    return c == 0 && ts_total(tot) == 0 && mst_uf_components(uf, 1) == 1;
}

fn test_mst_two_nodes_one_edge() -> bool {
    let eb: ptr = alloc(gr_edges_bytes(2));
    gr_edges_init(eb, 2);
    gr_add_edge(eb, 0, 1, 7);
    let uf: ptr = alloc(mst_uf_bytes(2));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 2, uf, idx, 8, tot);
    return c == 1 && ts_total(tot) == 7;
}

fn test_mst_parallel_edges_pick_min() -> bool {
    // 0-1 两条 (9 与 2): 只能选小的那条。
    let eb: ptr = alloc(gr_edges_bytes(4));
    gr_edges_init(eb, 4);
    gr_add_edge(eb, 0, 1, 9);
    gr_add_edge(eb, 0, 1, 2);
    let uf: ptr = alloc(mst_uf_bytes(2));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 2, uf, idx, 8, tot);
    return c == 1 && ts_total(tot) == 2;
}

fn test_mst_kruskal_negative_weight() -> bool {
    // Kruskal 吃负权: 0-1(-5), 1-2(1), 0-2(3) => MST = -5+1 = -4。
    let eb: ptr = alloc(gr_edges_bytes(4));
    gr_edges_init(eb, 4);
    gr_add_edge(eb, 0, 1, 0 as i64 - 5);
    gr_add_edge(eb, 1, 2, 1);
    gr_add_edge(eb, 0, 2, 3);
    let uf: ptr = alloc(mst_uf_bytes(3));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    let c: u32 = mst_kruskal(eb, 3, uf, idx, 8, tot);
    return c == 2 && ts_total(tot) == 0 as i64 - 4;
}

fn test_mst_prim_rejects_negative_weight() -> bool {
    // Prim 编码塞不下负权, 必须报错而不是静默给错答案。
    let eb: ptr = alloc(gr_edges_bytes(2));
    gr_edges_init(eb, 2);
    gr_add_edge(eb, 0, 1, 0 as i64 - 3);
    let csr: ptr = alloc(gr_csr_bytes(2, 2));
    gr_build_undirected(eb, csr, 2);
    let vis: ptr = alloc(32);
    let heap: ptr = alloc(heap_bytes(4));
    let tp: ptr = alloc(16);
    return mst_prim(csr, 0, vis, heap, 4, tp) == MST_ERR;
}

fn test_mst_output_buffer_too_small_err() -> bool {
    let eb: ptr = ts_edges4();
    let uf: ptr = alloc(mst_uf_bytes(4));
    let idx: ptr = alloc(4);
    let tot: ptr = alloc(16);
    // 4 点连通要 3 条边, 但只给 1 个槽 -> 必须报错, 不许溢出。
    return mst_kruskal(eb, 4, uf, idx, 1, tot) == MST_ERR;
}

fn test_mst_rejects_bad_node() -> bool {
    let eb: ptr = alloc(gr_edges_bytes(2));
    gr_edges_init(eb, 2);
    gr_add_edge(eb, 0, 9, 1);
    let uf: ptr = alloc(mst_uf_bytes(3));
    let idx: ptr = alloc(32);
    let tot: ptr = alloc(16);
    return mst_kruskal(eb, 3, uf, idx, 8, tot) == MST_ERR;
}

fn test_mst_uf_union_and_components() -> bool {
    let uf: ptr = alloc(mst_uf_bytes(6));
    mst_uf_init(uf, 6);
    let a: bool = mst_uf_union(uf, 0, 1);
    let b: bool = mst_uf_union(uf, 1, 2);
    let c: bool = mst_uf_union(uf, 0, 2);   // 已同集 -> false
    let comps: u32 = mst_uf_components(uf, 6);
    return a && b && c == false && comps == 4 && mst_uf_same(uf, 0, 2)
        && !mst_uf_same(uf, 0, 3);
}

fn test_mst_uf_path_compression_find() -> bool {
    // 0-1-2-3-4 串成一条长链再找 4 的根, 压缩后根应当直接指向 0 一侧的代表。
    let uf: ptr = alloc(mst_uf_bytes(5));
    mst_uf_init(uf, 5);
    mst_uf_union(uf, 0, 1);
    mst_uf_union(uf, 1, 2);
    mst_uf_union(uf, 2, 3);
    mst_uf_union(uf, 3, 4);
    let r: u32 = mst_uf_find(uf, 4);
    // 压缩不变量: 找过的点其 parent 直接在根上 (或就是根)。
    let ok: u32 = 1;
    let i: u32 = 0;
    while i < 5 {
        let p: u32 = mem_load32(uf, 4 + 4 * i);
        if p != r && p != i {
            ok = 0;
        }
        i = i + 1;
    }
    return mst_uf_components(uf, 5) == 1 && ok == 1;
}

fn test_mst_sort_edges_ascending() -> bool {
    let eb: ptr = alloc(gr_edges_bytes(5));
    gr_edges_init(eb, 5);
    gr_add_edge(eb, 0, 1, 9);
    gr_add_edge(eb, 1, 2, 1);
    gr_add_edge(eb, 2, 0, 5);
    gr_add_edge(eb, 0, 3, 3);
    gr_add_edge(eb, 3, 1, 7);
    mst_sort_edges(eb, 5);
    return gr_edge_w(eb, 0) == 1 && gr_edge_w(eb, 1) == 3 && gr_edge_w(eb, 2) == 5
        && gr_edge_w(eb, 3) == 7 && gr_edge_w(eb, 4) == 9;
}
