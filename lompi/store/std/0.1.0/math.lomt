// std/math.lomt — 整数数学
//
// 为什么要它: `fib` / `gcd` / `popcount` 这类东西在 examples 里各被写了三四遍。
// 更实际的动机是自举侧 —— 编译器要算哈希、对齐、容量, 而**这门语言没有浮点**
// (docs/158 §4.4 #4: 发射面 0 处 fadd/fcmp), 所以开方、对数、幂全得在整数域里做。
// 本模块就是那套整数域工具。
//
// 命名: 公开一律 math_*, 内部一律 ma_*。自检 test_math_*。
//
// 溢出: `math_ipow` 与 C 一样按回绕算, 不报错 —— 调用方要判界自己判。
// 这不是偷懒: 语言里 `+` `*` 本来就是回绕的 (docs/158: "+ - * 为回绕运算"),
// 这里保持同一语义, 免得同一门语言里两套算术规则。

module math

/// 最大公约数 (辗转相除)。math_gcd(0, 0) == 0。
pub fn math_gcd(a: u64, b: u64) -> u64 {
    let x: u64 = a;
    let y: u64 = b;
    while y != 0 {
        let t: u64 = x % y;
        x = y;
        y = t;
    }
    return x;
}

/// 最小公倍数。任一为 0 时返回 0。
pub fn math_lcm(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 {
        return 0;
    }
    let g: u64 = math_gcd(a, b);
    return (a / g) * b;
}

/// 整数平方根 (向下取整)。用牛顿迭代, 不做浮点。
///
/// 初值写成 `x / 2 + 1` 而**不是** `(x + 1) / 2`: 后者在 x = 2^64-1 时 x+1 回绕成 0,
/// 于是 y = 0, 下一轮 `v / x` 就是除零。这条是大数自检逼出来的, 不是推导出来的。
pub fn math_isqrt(v: u64) -> u64 {
    if v == 0 {
        return 0;
    }
    if v < 4 {
        return 1;
    }
    let x: u64 = v;
    let y: u64 = x / 2 + 1;
    while y < x {
        x = y;
        y = (x + v / x) / 2;
    }
    return x;
}

/// 整数幂 (回绕)。exp == 0 返回 1。
pub fn math_ipow(base: u64, exp: u32) -> u64 {
    let r: u64 = 1;
    let b: u64 = base;
    let e: u32 = exp;
    while e > 0 {
        if (e & 1) != 0 {
            r = r * b;
        }
        b = b * b;
        e = e >> 1;
    }
    return r;
}

/// 十进制位数: math_ilog10(0) == 1, ilog10(9) == 1, ilog10(10) == 2。
/// 叫 ilog10 但语义是**位数** —— 因为调用方要的全是"够不够放"。
pub fn math_ilog10(v: u64) -> u32 {
    if v == 0 {
        return 1;
    }
    let n: u32 = 0;
    let x: u64 = v;
    while x > 0 {
        x = x / 10;
        n = n + 1;
    }
    return n;
}

/// 向下取整的 log2 (64 位)。v == 0 返回 0。
pub fn math_ilog2(v: u64) -> u32 {
    if v == 0 {
        return 0;
    }
    let n: u32 = 0;
    let x: u64 = v;
    while x > 1 {
        x = x >> 1;
        n = n + 1;
    }
    return n;
}

/// 向上取整到 a 的倍数 (a == 0 时原样返回)。
pub fn math_ceil_to(v: u64, a: u64) -> u64 {
    if a == 0 {
        return v;
    }
    let r: u64 = v % a;
    if r == 0 {
        return v;
    }
    return v + (a - r);
}

// ---------------------------------------------------------------- 自检

fn test_math_gcd() -> bool {
    return math_gcd(12, 18) == 6 && math_gcd(18, 12) == 6 && math_gcd(7, 13) == 1
        && math_gcd(0, 5) == 5 && math_gcd(0, 0) == 0;
}

fn test_math_lcm() -> bool {
    return math_lcm(4, 6) == 12 && math_lcm(3, 5) == 15 && math_lcm(0, 7) == 0;
}

fn test_math_isqrt() -> bool {
    return math_isqrt(0) == 0 && math_isqrt(1) == 1 && math_isqrt(3) == 1
        && math_isqrt(4) == 2 && math_isqrt(99) == 9 && math_isqrt(100) == 10;
}

fn test_math_isqrt_large() -> bool {
    // 12345^2 = 152399025 —— 精确可验; 再验一个夹在两平方之间的。
    return math_isqrt(152399025) == 12345 && math_isqrt(152399026) == 12345;
}

fn test_math_isqrt_u64_max() -> bool {
    // 4294967295^2 = 18446744065119617025 < 2^64-1, 所以 sqrt(u64 最大值) = 4294967295。
    // 这条逼着牛顿迭代在满位宽上收敛 —— 我第一版这里写的常量是错的, 是它抓出来的。
    return math_isqrt(18446744073709551615) == 4294967295;
}

fn test_math_ipow() -> bool {
    return math_ipow(2, 0) == 1 && math_ipow(2, 10) == 1024 && math_ipow(3, 3) == 27
        && math_ipow(10, 6) == 1000000;
}

fn test_math_ilog10() -> bool {
    return math_ilog10(0) == 1 && math_ilog10(9) == 1 && math_ilog10(10) == 2
        && math_ilog10(999) == 3 && math_ilog10(1000) == 4;
}

fn test_math_ilog2() -> bool {
    return math_ilog2(0) == 0 && math_ilog2(1) == 0 && math_ilog2(7) == 2 && math_ilog2(8) == 3;
}

fn test_math_ceil_to() -> bool {
    return math_ceil_to(0, 8) == 0 && math_ceil_to(1, 8) == 8 && math_ceil_to(8, 8) == 8
        && math_ceil_to(9, 8) == 16 && math_ceil_to(5, 0) == 5;
}
