    if k == 417 { return "路径存在、是普通文件、非空、可读"; }
    if k == 418 { return "explicit `as` (integer<->integer, integer<->bool, pointer<->integer); scalar / string / slice / array / struct / enum as types"; }
    if k == 419 { return "显式 `as`（整数⇄整数、整数⇄布尔、指针⇄整数）；标量/字符串/切片/数组/结构体/枚举作为类型"; }
    if k == 420 { return "the five core-mode dimensions (`mode` / `gc` / `runtime` / `port` / `vm`), values above; up to 500 switches per file; `addin` to carry switch settings across files (root unit only); empty switch bodies (purely to drive compiler behaviour); capability domains declared by a library; a library declaring a core mode (read as a requirement the root must satisfy)"; }
    if k == 421 { return "五维核心模式（`mode` / `gc` / `runtime` / `port` / `vm`），每维取值见上；单文件最多 500 条开关；`addin` 跨文件带开关设定（只有根单元能写）；空体开关（只驱动编译器行为）；库声明能力域；库声明核心模式（视作需求，根须满足）"; }
    if k == 422 { return "explicit `as` (integer<->integer, integer<->bool, pointer<->integer); scalar / string / slice / array / struct / enum as types"; }
    if k == 423 { return "显式 `as`（整数⇄整数、整数⇄布尔、指针⇄整数）；标量/字符串/切片/数组/结构体/枚举作为类型"; }
    if k == 424 { return "explicit `as` (integer<->integer, integer<->bool, pointer<->integer); scalar / string / slice / array / struct / enum as types"; }
    if k == 425 { return "显式 `as`（整数⇄整数、整数⇄布尔、指针⇄整数）；标量/字符串/切片/数组/结构体/枚举作为类型"; }
    if k == 426 { return "explicit `as` (integer<->integer, integer<->bool, pointer<->integer); scalar / string / slice / array / struct / enum as types"; }
    if k == 427 { return "显式 `as`（整数⇄整数、整数⇄布尔、指针⇄整数）；标量/字符串/切片/数组/结构体/枚举作为类型"; }
    if k == 428 { return "returning a borrow of a parameter; freeing after the borrow ends"; }
    if k == 429 { return "返回借自形参的引用；在借用结束后再释放"; }
    if k == 430 { return "`u32` / `i64` / `bool` / `ptr` / `str` / `()`; a `struct`/`enum` you declared; arrays and slices of those, `[T; N]` / `[T]`"; }
    if k == 431 { return "`u32` / `i64` / `bool` / `ptr` / `str` / `()`；你声明的 `struct`/`enum` 名；它们的数组与切片 `[T; N]` / `[T]`"; }
    if k == 1800 { return "a tool exits 0 (no diagnostics) or 1 (diagnostics, and it left a record)"; }
    if k == 1801 { return "工具链以 0 退出（无诊断）或 1 退出（有诊断并留下了记录）"; }
    if k == 1998 { return "classified messages after a report lands"; }
    if k == 1999 { return "报告之后有专属分类的消息"; }
    return "";
}

pub fn code_no(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "implicit promotion and implicit conversion (`u32` -> `i64` also needs `as`); using an integer where a bool is expected"; }
    if k == 3 { return "隐式提升与隐式转换（`u32` → `i64` 也必须写 `as`）；整数与布尔互用"; }
    if k == 4 { return "type inference / implicit globals / forward references inside one module / implicit numeric conversion"; }
    if k == 5 { return "类型推断／隐式全局／同一模块内的前向引用／隐式数值转换"; }
    if k == 6 { return "default arguments / variadic arguments / function overloading"; }
    if k == 7 { return "默认参数／可变参数／函数重载"; }
    if k == 8 { return "**authorization** - `guard` only constrains the index to the domain, it does not check whether the current subject holds this capability (that binding lives in the kernel)"; }
    if k == 9 { return "**授权** —— `guard` 只约束索引落在域内，不检查“当前主体有没有这个能力”（主体-能力的绑定在内核侧）"; }
    if k == 10 { return "local exemptions (there is no \"allow it just here\"); both excluding a space and using it"; }
    if k == 11 { return "局部豁免（“只在这一处放行”做不到）；对同一个空间既排除又使用"; }
    if k == 12 { return "implicitly copying aggregates; using a value after it has been moved"; }
    if k == 13 { return "隐式复制聚合；移动后再使用同一个值"; }
    if k == 14 { return "a mutable borrow alive next to any other borrow; two mutable borrows of the same variable"; }
    if k == 15 { return "可变借用与任何其它借用并存；同一变量的两次可变借用"; }
    if k == 16 { return "expression arm bodies; multi-payload variants; non-exhaustive without `_`; comparing enums with `==` (the checker allows it but the native backend rejects it)"; }
    if k == 17 { return "臂体是表达式；多载荷变体；非穷尽且没有 `_`；`==` 直接比较枚举（checker 放行但原生后端会拒）"; }
    if k == 18 { return "a name that collides with a base type; an empty `struct`; an empty `enum`"; }
    if k == 19 { return "与基类型重名；空 `struct`；空 `enum`"; }
    if k == 20 { return "`?` outside a `let` binding; `?` inside a function that does not return `Result`/`Option`"; }
    if k == 21 { return "在非 `let` 位置用 `?`；在返回非 `Result`/`Option` 的函数里用 `?`"; }
    if k == 22 { return "writing through a read-only slice; borrowing `&arr` as writable"; }
    if k == 23 { return "在只读切片上写；把 `&arr` 借成可写的"; }
    if k == 24 { return "returning a reference or slice that points at a local variable"; }
    if k == 25 { return "返回指向局部变量的引用或切片"; }
    if k == 26 { return "two top-level items sharing a name; two libraries exporting the same name"; }
    if k == 27 { return "同名顶层项共存；两个库同时导出同一个名字"; }
    if k == 28 { return "assignment to an expression or a literal (`1 = x`, `f() = x`)"; }
    if k == 29 { return "给表达式或字面量赋值（`1 = x`、`f() = x`）"; }
    if k == 30 { return "a struct literal passed straight as an argument; a struct literal written in a condition; literals with missing or extra fields"; }
    if k == 31 { return "结构体字面量直接当实参；条件位置直接写结构体字面量；缺字段/多字段字面量"; }
    if k == 32 { return "an empty literal; inferring the length from the literal; an array with mismatched element types"; }
    if k == 33 { return "空字面量；按字面量推断长度；元素类型不一致的数组"; }
    if k == 34 { return "`as` between aggregates; `as` between a string and a number (write the parse yourself)"; }
    if k == 35 { return "聚合之间的 `as`；字符串与数字之间的 `as`（要自己写解析）"; }
    if k == 36 { return "ambiguity in layer 3; circular imports; more than 300 uses (that is E020)"; }
    if k == 37 { return "第 ③ 层的歧义；循环导入；超过 300 条（那是 E020）"; }
    if k == 38 { return "single-quoted character literals; value-less `return;`; expression-style match arms; `let mut x: T` (`mut` is not a keyword)"; }
    if k == 39 { return "单引号字符字面量；无值 `return;`；表达式式 match 臂；`let mut x: T`（`mut` 不是关键字）"; }
    if k == 40 { return "more than 300 (going over is an **error**, not a truncation)"; }
    if k == 41 { return "超过 300 条（超限是**报错**，不是截断）"; }
    if k == 42 { return "`str` parameters / returns (that is a pointer plus a length, not a C string); structs / enums / arrays **by value**; an `extern fn` with type parameters; FFI on the PE target; `.a` archives and `.so` / `.dll` dynamic libraries"; }
    if k == 43 { return "`str` 形参/返回（那是“指针+长度”，不是 C 字符串）；结构体/枚举/数组**按值**；`extern fn` 带类型参数；PE 目标的 FFI；`.a` 归档与 `.so`/`.dll` 动态库"; }
    if k == 44 { return "one dimension written twice, or written outside the root unit; two dimensions whose values contradict (`gc_auto` with `no_runtime`); `choose vm`, or a path carrying an outward port, in a release build (the channel gate); setting a value before declaring it; two settings for one name; nested declarations; a library that uses a runtime-dragging construct without declaring it"; }
    if k == 45 { return "同一维写两次、或写在根单元之外不一致；两维取值互相矛盾（`gc_auto` 与 `no_runtime`）；发行版里写 `choose vm`、或让路径带对外端口（渠道闸）；取值前没定义；同名两个取值；嵌套声明；库用了会拖运行期的构造却不声明"; }
    if k == 46 { return "**this message itself is the \"not supported\"** - the exact scope is the milestone table in `docs/145`, not anything on your side of the source"; }
    if k == 47 { return "**这条消息本身就是“不支持”** —— 具体范围以 `docs/145` 的里程碑表为准，不在源码那一侧"; }
    if k == 48 { return "computing the name from a variable; a name with `/`, a space or non-ASCII; a name from the official 38; a library declaring a command"; }
    if k == 49 { return "命令名从变量里算出来；名字含 `/`、空格或非 ASCII；用官方那 38 条里的名字；库声明命令"; }
    if k == 50 { return "both at once; keeping a copy of the `_start` body while also writing `command_main`"; }
    if k == 51 { return "两个都写；把 `_start` 里的东西原样留着一份又写 `command_main`"; }
    if k == 52 { return "`command_main` with no declaration; `command_main(a: u32, b: u32)`; returning `()`; the two parameters swapped"; }
    if k == 53 { return "只有 `command_main` 没有声明；`command_main(a: u32, b: u32)`；返回 `()`；两个参数顺序反了"; }
    if k == 54 { return "the last statement is `while` / `for` (these end normally), an expression statement, or an `if` **without** an `else`"; }
    if k == 55 { return "末尾是 `while` / `for`（会正常结束）、末尾是表达式语句、末尾是**没有** `else` 的 `if`"; }
    if k == 56 { return "the index is a variable or an expression (this rule can only compare two compile-time-known numbers); an index into a slice `[T]` (its length is a runtime value)"; }
    if k == 57 { return "下标是变量或表达式（这一条只能在编译期判已知的两个数，算出来的界不是它能管的）；切片 `[T]` 的下标（长度是运行期的）"; }
    if k == 58 { return "use before the `free`; reassignment followed by use after the `free`"; }
    if k == 59 { return "`free` 之前的使用；`free` 之后重新赋值再使用"; }
    if k == 60 { return "`f32` / `f64` (there is no floating point); a generic container name; an identifier that is not a type (a variable name, say)"; }
    if k == 61 { return "`f32` / `f64`（没有浮点）；泛型容器名；不是类型的标识符（如变量名）"; }
    if k == 62 { return "a misspelt path; a directory; a 0-byte file; a file you may not read"; }
    if k == 63 { return "写错的路径；目录；0 字节的文件；没有读权限的文件"; }
    if k == 64 { return "a directory that does not exist; a read-only directory; a path held by a running exe"; }
    if k == 65 { return "不存在的目录；只读目录；正在运行的 exe 占着的路径"; }
    if k == 66 { return "a whole library in one source file; hundreds of `use`; hundreds of top-level declarations"; }
    if k == 67 { return "单个源文件里塞一整个库；几百个 `use`；几百个顶层声明"; }
    if k == 68 { return "an allow with neither a source nor a ledger entry"; }
    if k == 69 { return "无来源、也不在台账里的放行"; }
    if k == 70 { return "an unknown site kind"; }
    if k == 71 { return "未知的站点种类"; }
    if k == 72 { return "a ledger that fails self-audit"; }
    if k == 73 { return "自检失败的台账"; }
    if k == 74 { return "an artifact that does not"; }
