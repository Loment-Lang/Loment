// loment/tools/lomenterr.lomt — 报错器 (docs/182 §6)
//
// 吃编译器吐的**结构化诊断** (JSONL, 由 `--diag-out` 写出), 查 `surface_data` 补上
// 中文标题与修复建议, 按
//
//     error[E022]: `choose` / `addin` 用法不对
//       --> app.lomt:4
//        |
//      4 | choose no_std
//        | ^^^^^^^^^^^^^
//        | = 建议: ...
//
// 渲染给人看。退出码: 0 = 无诊断 / 1 = 有诊断 / 2 = 用法或读取失败。
//
// **为什么它是独立程序, 而不是编译器里的一段**: 两个实现的消息文本本来就不同
// (参考实现吐整句中文, 自举手里只有码 + token 索引; 见 `docs/158` §4)。硬凑"两侧逐字节
// 一致"只会造出一堆假一致 (`docs/182` §5.3)。诚实的靶子是**码一致 + 形状一致** ——
// 于是"渲染"这件事归报错器: 编译器只报"是什么、在哪", 标题与建议到这里才查表补上。
// 好处是自举驱动**根本不需要那张表**, "同一份码表抄第二份"从设计上就不存在。
//
// 输出走 **fd 2**: 它渲染的是错误, 而编译器的 `[ERR]` 也在 stderr (同一处给用户看)。
//
// **已知代价 (如实记)**: 标题/建议是中文, 而 Windows 控制台按 936 代码页解 UTF-8 ⇒ 乱码
// (`docs/169` §3a; PE 垫片没有 `WriteConsoleW`, 程序侧无从补救)。诊断这条路上本来就是
// 中文的 (`loment diag` 与编译器的 `[ERR]` 都是), 所以这里不另做处理, 也不因此把标题
// 换成英文 —— 那是**另一个受众**的事, 由 `loment codes` 走 `surface_data.code_ascii` 提供。
//
//   lomenterr <诊断.jsonl>

module lomenterr
choose runtime

use json
use surface_data

// ---------------------------------------------------------------- 内存布局

const DIAG_CAP: u32 = 1048576;   // 诊断文件 (JSONL)
const SRC_CAP: u32 = 1048576;    // 源文件 (按 file 字段读, 同一份只读一次)
const SCR_CAP: u32 = 8192;       // 路径 NUL 暂存 (open_ro 用)
const ARENA_CAP: u32 = 65536;    // 一行 JSON 的 DOM (每行重置)
const DENT_CAP: u32 = 32768;     // getdents64 缓冲（E018 列 `./deps` 用；也当路径暂存）

// ctx: 一条诊断的全部暂存。**一条渲染完立刻写出去**, 所以它只要能装下**一条**。
// 偏移全是手算的字面量 (L1 的 const 只收整数字面量, 不能是表达式 —— 与 lomdoc 同)。
const CTX_CAP: u32 = 65536;
const C_OB: u32 = 0;             // 渲染缓冲 0..32767
const OB_CAP: u32 = 32768;
const C_PATH: u32 = 32768;       // 当前记录的 file 路径 32768..36863
const PATH_CAP: u32 = 4096;
const C_PREV: u32 = 36864;       // 已加载源文件的那个路径 (缓存键)
const C_CODE: u32 = 40960;       // 码字符串 "E022"
const CODE_CAP: u32 = 16;
const C_MSG: u32 = 40976;        // 消息原文 40976..57359
const MSG_CAP: u32 = 16384;
const C_NUM: u32 = 57360;        // 十进制暂存 (倒着拼再正着写)
const C_PREVLEN: u32 = 57376;
const C_SRCLEN: u32 = 57380;
const C_TRUNC: u32 = 57384;     // 这一条渲染时撞到了缓冲上沿 (0/1)
const C_TOK: u32 = 57408;       // 语言特征词的暂存 (一段 <= 60 字节)
const C_FPREV: u32 = 57472;      // 已经给过外源提示的那个文件路径
const C_FPREVLEN: u32 = 61568;
const C_COLOR: u32 = 61572;      // 1 = 上色（默认开，见 §颜色）
const C_WHY: u32 = 61576;        // 认语言的依据: 1=声明 2=后缀 3=内容 (见 sniff_lang)
const C_LANG: u32 = 61580;       // 说哪种语言: 0=英文(**默认**) 1=中文 (errconfig 切, §语言)
const C_MODE: u32 = 61584;       // 输出模式: 0=完整 1=--short 2=--json
// 汇总: 出现过的码 + 各自的条数。**按码去重**, 所以定长 64 就够 (码是 E1..E23 那一段,
// 未知码另算一格 —— 见 sum_add)。
const C_SUMK: u32 = 61600;       // 64 个 u32: 码号
const C_SUMV: u32 = 61856;       // 64 个 u32: 条数
const C_SUMN: u32 = 62112;       // 已经记了几个不同的码
const SUM_CAP: u32 = 64;
//: 默认最多渲染几条（0 = 全部）。**这不是随手定的**：clang 默认 `-ferror-limit=20`，
//: 然后打 `fatal error: too many errors emitted, stopping now`；Go 卡在 10 条后打
//: `too many errors`；javac 默认 `-Xmaxerrs 100`。三家都**默认设上限**，理由一样：
//: 生成的代码一错就是几百条，逐条渲染几十行会把第一条真正要看的东西顶出屏幕。
//: 抄这个默认值，但**上限不许静默**（结尾说清还剩几条，见 S_CAPPED_*）。
const MAX_DEFAULT: u32 = 20;
const C_CFG: u32 = 62144;        // errconfig 读进来的原文
const CFG_CAP: u32 = 2048;
//: 「你是不是想写」的**候选表**。一次收几个而不是只收一个，是抄 Ruby 的 `did_you_mean`
//: 与 rustc 的 children：并列时**不必二选一**（要么抛硬币、要么闭嘴）—— 列出来让用户挑，
//: 还顺手说清每个候选是什么、在哪一行。这几张并行数组按 `(距离, 源码先后)` 排好序。
const C_CAND: u32 = 64192;       // 候选名的字节（CAND_CAP × CAND_NAME）
const SUG_CAP: u32 = 3;
const SUG_NAME: u32 = 96;
const C_CANDNL: u32 = 64480;     // 每个候选名的长度
const C_CANDLN: u32 = 64492;     // 它在第几行声明
const C_CANDKD: u32 = 64504;     // 它的种类（`decl_kw` 的下标 + 1；0 = 不知道）
const C_CANDDS: u32 = 64516;     // 它的距离（排序用，也让“最近的先出”是有据的）
const C_CANDN: u32 = 64528;      // 收了几条（0 = 一个都不像，不说）
const C_KIND: u32 = 64532;       // `decl_kw_at` 刚认出来的那个关键字（下标 + 1）
const C_TOKOFF: u32 = 64536;     // 那个词在**源文件**里的字节偏移（0xFFFFFFFF = 不唯一/找不到）
const C_TOKLEN: u32 = 64540;     // 它的字节长度
const C_MAX: u32 = 64928;        // 最多渲染几条（0 = 全部；默认 MAX_DEFAULT）
const C_WANTVER: u32 = 64932;    // 命令行上要的是 `version` 而不是一份诊断（见 parse_args）
//: 编辑距离的两行滚动数组（第 0 行 0..191、第 1 行 192..383）。名字上限 47 个字符 →
//: 48 个格子 × 4 字节正好一行 192。**超过 47 的名字不参与比较**（见 edit_dist）——
//: 那种长度的标识符拼错与否不是"想写哪一个"能回答的问题。
const C_ROW: u32 = 64544;
const ROW_STRIDE: u32 = 192;
const NAME_MAX: u32 = 47;

//: `scr` 里留给"扫 argv 扫出来的那个路径"的一段。open_ro 自己用 scr[0..4001]，
//: 所以这一段必须从它后面起 —— 扫完再调 open_ro 把它抄到前面去。
const SCR_DIAG: u32 = 4096;
//: `scr` 里留给"工具链旁边那份 errconfig 的路径"的一段（`<工具目录>/../share/loment/errconfig`）。
//: 同样在 open_ro 的 4001 字节之外。
const SCR_TOOLCFG: u32 = 6144;

// 字符常量走数字, 免得每处都要 `as u8`
const NL: u32 = 10;
const CR: u32 = 13;
const SP: u32 = 32;
const TAB: u32 = 9;
const COLON: u32 = 58;
const QUOTE: u32 = 34;
const LPAREN: u32 = 40;
const COMMA: u32 = 44;
const DOT: u32 = 46;
const CARET: u32 = 94;
const LBRACE: u32 = 123;
const RBRACE: u32 = 125;
const RBRACK: u32 = 93;
const SEMI: u32 = 59;

// ---------------------------------------------------------------- 界面字串
//
// 骨架字串（标签、说明句、用法）留在这里，散文（说明卡、语言卡）在 `surface_data` 里 ——
// 但两者走**同一个语言槽**（`C_LANG`）。分成两处只是因为受众不同：这些字串 lomcli 看不见，
// 没必要进表面数据表；而卡片必须进，因为 `loment codes` 也读它。
//
// **两个语言槽都不许空**（`loment_err_test::test_every_ui_string_has_both_languages` 钉着）：
// 漏一条的症状是某种语言下渲染出一个**空标签**（`": 值"`），看着像渲染坏了。
//
// 键的编号是**契约**：判据按 `1..=S_SUG` 遍历，跳号会被抓出来（这样"加了键忘了写"
// 与"写了一个谁都读不到的键"都藏不住）。

const S_UNKNOWN_CODE: u32 = 1;   // 表里没有这个码
const S_NOSRC_OPEN: u32 = 2;     // "(读不到源文件: "
const S_NO_LINE: u32 = 3;        // "(源文件里没有这一行)"
const S_MSG: u32 = 4;            // "消息: "
const S_WHAT: u32 = 5;           // "错了什么"
const S_WHY: u32 = 6;            // "为什么错"
const S_HOWFIX: u32 = 7;         // "怎么改:"
const S_YES: u32 = 8;            // "支持"
const S_NO: u32 = 9;             // "不支持"
const S_NOCARD1: u32 = 10;       // 没有说明卡（第一句）
const S_NOCARD2: u32 = 11;       // 没有说明卡（怎么办）
const S_FOREIGN1: u32 = 12;      // "这个文件看起来不是 Loment"
const S_FOREIGN2: u32 = 13;      // " —— 看内容像 "
const S_OPEN_PAREN: u32 = 14;    // "（"
const S_WHY_DECL: u32 = 15;      // 依据: 文件头声明
const S_WHY_EXT: u32 = 16;       // 依据: 后缀
const S_WHY_TOK: u32 = 17;       // 依据: 内容特征词
const S_FOREIGN3: u32 = 18;      // "）。它有三条路进来（都不动 Loment 内核）:"
const S_ROUTE_A: u32 = 19;       // 路 A
const S_ROUTE_B: u32 = 20;       // 路 B
const S_ROUTE_C: u32 = 21;       // 路 C
const S_ROUTE_C2: u32 = 22;      // 路 C 的补充（只在 ELF 上可用）
const S_LANG_EDGE: u32 = 23;     // "这门语言的边界"
const S_LANG_ABI: u32 = 24;      // "调用约定"
const S_FOREIGN4: u32 = 25;      // "语言以 --lang auto 为准"
const S_USAGE: u32 = 26;         // 用法
const S_BADLINE: u32 = 27;       // 这一行不是合法 JSON
const S_BROKEN: u32 = 28;        // 有几行不是合法 JSON
const S_OK: u32 = 29;            // 没有诊断
const S_TRUNC: u32 = 30;         // 这一条太长被截断
const S_NERR: u32 = 31;          // " 条错误"（跟在数字后面）
const S_SUM: u32 = 32;           // " 条错误："（汇总行的头）
const S_SUM_X: u32 = 33;         // 汇总里 " x2" 那个 x
// 候选**是什么** —— 抄 rustc 的 "a local variable with a similar name exists"。
// 只说一个名字，用户还得自己去找它在哪、是干什么的；说了种类，一眼就知道该不该照它改。
const S_KIND_FN: u32 = 38;
const S_KIND_LET: u32 = 39;
const S_KIND_CONST: u32 = 40;
const S_KIND_STRUCT: u32 = 41;
const S_KIND_ENUM: u32 = 42;
const S_KIND_TRAIT: u32 = 43;
const S_KIND_CAP: u32 = 44;
// help 块：`标签 + 前置词 + 种类 + 尾句`。**拆成三段是为了中文语序**（“有一个函数名字很接近”
// 里那个“有一个”在种类**前面**），而 JSON 那侧只要后半句（不要 `help: ` 这个给人看的标签）。
const S_HELP: u32 = 45;          // "help: "（两门语言同形）
const S_SUG_ONE_A: u32 = 46;     // en 空 / zh "有一个"
const S_SUG_ONE_B: u32 = 47;     // " with a similar name exists" / "名字很接近"（不带换行）
const S_SUG_MANY: u32 = 48;      // 多个候选时的头（不带换行）
const S_SUG_ITEM_PRE: u32 = 49;  // 列表项：名字前
const S_SUG_ITEM_OPEN: u32 = 50; // 名字后、种类前
const S_SUG_ITEM_LINE: u32 = 51; // 种类后、行号前
const S_SUG_ITEM_CLOSE: u32 = 52; // 行号后（不带换行）
const S_NODEPS: u32 = 35;        // E018: 这里没有 `./deps`
const S_CANDS: u32 = 36;         // E018: `./deps` 里最接近的名字
const S_CANDS_NONE: u32 = 37;    // E018: `./deps` 在，但没有接近的
const S_NOOPEN: u32 = 34;
// 结尾的 explain 指针：抄 rustc 的「For more information about an error, try
// `rustc --explain E0318`.」—— 它把「这一条还有详解」变成一条**能敲的命令**。
// 子代理实测：8 门语言里**没有一门**在给人看的输出里给出可点的文档入口
// （rustc 只给命令，C# 的 helpUri 只进 SARIF），所以这一格是照最好的那个抄的。
const S_MORE: u32 = 53;          // more: loment explain
const S_CAPPED_A: u32 = 54;      // note: 
const S_CAPPED_B: u32 = 55;      // 后面接「还有几条没显示」
// `version` 那一行前面那半句。**两门语言同形** —— 它是**程序名**，不是可翻译的散文；
// 放进这张表只是为了让"打这一行"与别处一样走 `ui()`（一处组装、判据一处能扫到）。
const S_VER: u32 = 56;           // "lomenterr "

/// 当前语言槽（0 = 英文 / 1 = 中文）。
fn lg(ctx: ptr) -> u32 {
    return load32(ctx, C_LANG);
}

/// 界面字串。**语言由 `C_LANG` 选，调用方不传** —— 传了就会有"这里忘了传"的漏口。
fn ui(ctx: ptr, k: u32) -> str {
    if load32(ctx, C_LANG) == 1 {
        return ui_zh(k);
    }
    return ui_en(k);
}

/// 英文（**默认**）。这一份**全 ASCII** —— 判据钉着（`loment_err_test` 直接跑一遍真渲染，
/// 逐字节查有没有 >=0x80 的字节）。理由不是洁癖：它存在的一半目的正是"默认输出在 936
/// 代码页的控制台上不是乱码"（`docs/169` §3a），夹一个 `…` 或 `——` 进来就把这一半毁掉。
///
/// **另一半不在这一层**：编译器给的消息原文仍是它自己的语言（现在还是中文）。所以"默认
/// 输出不再是乱码"这话要分开说 —— 渲染器自己那一部分修好了，消息那一行没有（`docs/182` §5.3）。
fn ui_en(k: u32) -> str {
    if k == 1 { return "unknown error code\n"; }
    if k == 2 { return "(cannot read the source file: "; }
    if k == 3 { return "(no such line in the source file)\n"; }
    if k == 4 { return "message: "; }
    if k == 5 { return "what went wrong"; }
    if k == 6 { return "why"; }
    if k == 7 { return "how to fix:"; }
    if k == 8 { return "supported"; }
    if k == 9 { return "not supported"; }
    if k == 10 { return "no card for this code - it is not in the surface data table.\n"; }
    if k == 11 { return "the toolchain versions may not match (an older renderer meeting a newer compiler). Judge by the message above; if this really is a new code, please report it.\n"; }
    if k == 12 { return "this file does not look like Loment"; }
    if k == 13 { return " - by its content it looks like "; }
    if k == 14 { return " ("; }
    if k == 15 { return "per the `choose write grammar` declaration in the file header"; }
    if k == 16 { return "per the file extension"; }
    if k == 17 { return "per the content's marker words"; }
    if k == 18 { return "). There are three ways in, none of which touches the Loment kernel:\n"; }
    if k == 19 { return "  A. interface unit only (the implementation stays on the source language's side, linked against an object file built outside):\n"; }
    if k == 20 { return "  B. translate the body into a Loment implementation:\n"; }
    if k == 21 { return "  C. run-time bridge, when that interpreter is on the machine: `use proc` + `proc_sh(\"...\")`\n"; }
    if k == 22 { return "       - Linux/ELF only (the PE shim has no fork/pipe).\n"; }
    if k == 23 { return "this language's boundary"; }
    if k == 24 { return "calling convention"; }
    if k == 25 { return "`--lang auto` decides the language - the above is only a hint from the content, do not treat it as a conclusion.\n"; }
    if k == 26 { return "lomenterr: usage: lomenterr [--no-color] [--short|--json] [--max N] <diagnostics.jsonl>\n  the diagnostics file is written by the compiler's --diag-out PATH (loment check FILE --diag-out d.jsonl).\n  --max N caps how many are rendered (default 20; 0 = all).\n  lomenterr version            print this reporter's own version (not the language's).\n"; }
    if k == 27 { return "[lomenterr] this line in the diagnostics file is not valid JSON, printing it as is:\n  "; }
    if k == 28 { return " lines are not valid JSON (the diagnostics file is corrupt, or it is not from this compiler build)\n"; }
    if k == 29 { return "[OK] no diagnostics\n"; }
    if k == 30 { return "[lomenterr] this one is too long, the rendering above was truncated\n"; }
    if k == 31 { return " errors\n"; }
    if k == 32 { return " errors: "; }
    if k == 33 { return " x"; }
    if k == 34 { return "lomenterr: cannot open the diagnostics file\n"; }
    if k == 35 { return "there is no `./deps` directory here, so layer 1 cannot find anything: layer 1 is `<project root>/deps/<name>/<name>.lomt`. Create that file, or name the location with the path form `use \"./x.lomt\"`.\n"; }
    if k == 36 { return "`./deps` is here; the closest names in it are:\n"; }
    if k == 37 { return "`./deps` is here, but it holds nothing close to this name.\n"; }
    if k == 38 { return "a function"; }
    if k == 39 { return "a local variable"; }
    if k == 40 { return "a constant"; }
    if k == 41 { return "a struct"; }
    if k == 42 { return "an enum"; }
    if k == 43 { return "a trait"; }
    if k == 44 { return "a capability domain"; }
    if k == 45 { return "help: "; }
    if k == 46 { return ""; }
    if k == 47 { return " with a similar name exists"; }
    if k == 48 { return "names that are close:"; }
    if k == 49 { return "  `"; }
    if k == 50 { return "` ("; }
    if k == 51 { return ", line "; }
    if k == 52 { return ")"; }
    if k == 53 { return "more: loment explain "; }
    if k == 54 { return "note: "; }
    if k == 55 { return " more not shown (--max 0 for all)"; }
    if k == 56 { return "lomenterr "; }
    return "";
}

/// 中文。想读它就写一份 `errconfig`（`docs/182` §14）—— **不是**把这份删掉。
fn ui_zh(k: u32) -> str {
    if k == 1 { return "未知错误码\n"; }
    if k == 2 { return "(读不到源文件: "; }
    if k == 3 { return "(源文件里没有这一行)\n"; }
    if k == 4 { return "消息: "; }
    if k == 5 { return "错了什么"; }
    if k == 6 { return "为什么错"; }
    if k == 7 { return "怎么改:"; }
    if k == 8 { return "支持"; }
    if k == 9 { return "不支持"; }
    if k == 10 { return "这一条没有说明卡 —— 这个码不在表面数据表里。\n"; }
    if k == 11 { return "工具链的版本可能不一致（旧报错器遇上新编译器）。按上面的消息原文判断；若确属新码，请报告。\n"; }
    if k == 12 { return "这个文件看起来**不是 Loment**"; }
    if k == 13 { return " —— 看内容像 "; }
    if k == 14 { return "（"; }
    if k == 15 { return "据文件头 `choose write grammar` 声明"; }
    if k == 16 { return "据后缀"; }
    if k == 17 { return "据内容特征词"; }
    if k == 18 { return "）。它有三条路进来（都不动 Loment 内核）:\n"; }
    if k == 19 { return "  A. 只出接口单元（实现在源语言那一侧，配外面编好的目标文件用）:\n"; }
    if k == 20 { return "  B. 把正文翻成 Loment 实现:\n"; }
    if k == 21 { return "  C. 运行期桥（机器上有那个解释器时）: `use proc` + `proc_sh(\"...\")`\n"; }
    if k == 22 { return "       —— 只在 Linux/ELF 上可用（PE 垫片没有 fork/pipe）。\n"; }
    if k == 23 { return "这门语言的边界"; }
    if k == 24 { return "调用约定"; }
    if k == 25 { return "语言以 `--lang auto` 为准 —— 上面只是按内容给的提示，别拿它当结论。\n"; }
    if k == 26 { return "lomenterr: 用法: lomenterr [--no-color] [--short|--json] [--max N] <诊断.jsonl>\n  诊断文件由编译器的 --diag-out PATH 写出 (loment check FILE --diag-out d.jsonl)。\n  --max N 限制渲染几条（默认 20；0 = 全部）。\n  lomenterr version            打出报错器自己的版本（不是语言版本）。\n"; }
    if k == 27 { return "[lomenterr] 诊断文件里这一行不是合法 JSON, 原样输出:\n  "; }
    if k == 28 { return " 行不是合法 JSON (诊断文件损坏, 或与本次编译器不是同一版)\n"; }
    if k == 29 { return "[OK] 无诊断\n"; }
    if k == 30 { return "[lomenterr] 这一条太长, 上面的渲染被截断了\n"; }
    if k == 31 { return " 条错误\n"; }
    if k == 32 { return " 条错误："; }
    if k == 33 { return " ×"; }
    if k == 34 { return "lomenterr: 打不开诊断文件\n"; }
    if k == 35 { return "这里没有 `./deps` 目录 —— 第 1 层找的是「项目根」下的 `deps/<名字>/<名字>.lomt`，所以它找不到任何东西。补那个文件，或者用路径形式 `use \"./x.lomt\"` 指明位置。\n"; }
    if k == 36 { return "`./deps` 在这里，里面最接近的名字有:\n"; }
    if k == 37 { return "`./deps` 在这里，但里面没有与这个名字接近的。\n"; }
    if k == 38 { return "函数"; }
    if k == 39 { return "局部变量"; }
    if k == 40 { return "常量"; }
    if k == 41 { return "结构体"; }
    if k == 42 { return "枚举"; }
    if k == 43 { return "trait"; }
    if k == 44 { return "能力域"; }
    if k == 45 { return "help: "; }
    if k == 46 { return "有一个"; }
    if k == 47 { return "名字很接近"; }
    if k == 48 { return "名字接近的有:"; }
    if k == 49 { return "  `"; }
    if k == 50 { return "`（"; }
    if k == 51 { return "，第 "; }
    if k == 52 { return " 行）"; }
    if k == 53 { return "更多: loment explain "; }
    if k == 54 { return "note: "; }
    if k == 55 { return " 条诊断没显示（--max 0 看全部）"; }
    if k == 56 { return "lomenterr "; }
    return "";
}

// ---------------------------------------------------------------- errconfig
//
// **说哪种语言的开关是一份独立的文件 `errconfig`**（不是 `loment.conf` 里多一个键，
// 也不是命令行开关）。这条分界是 `docs/182` §7 那条的延伸：`loment.conf` 管
// 「**工具链怎么读源码**」（后缀那类，词法器要读），而"报错器说哪种语言"是**渲染层**
// 的口味，与怎么读源码无关。混进 `loment.conf` 会让一个"语言怎么认"的文件里出现一条
// 与源码识别毫无关系的设置。
//
// 形状**照抄 `loment.conf`**（一个标签 + 一个字符串字面量），因为仓库里已经有一个人人
// 认得的配置文件长这样；但**读者只有这一个**（Python 那边不读它）——
// 所以这里没有"同一份契约抄两遍"，只有"长得像"。
//
// 三个值/两份文件：
//   * 值 `"en"`（英） / `"zh"`（中）；大小写不敏感，`english` / `chinese` / `cn` 也认；
//   * 找两份，**项目那份优先**（与 `loment.conf` 同一条）：`./errconfig` 然后是
//     `<工具目录>/../share/loment/errconfig`；
//   * **读不出来就当没配**，退回英文默认。坏配置退回默认，比编出一串看不懂的错好 ——
//     这条也是从 `loment.conf` 抄的纪律。

/// `buf[i..]` 是不是就是 `s`。
fn at_word(buf: ptr, n: u32, i: u32, s: str) -> u32 {
    let sn: u32 = str_len(s);
    if i + sn > n {
        return 0;
    }
    let j: u32 = 0;
    while j < sn {
        if load8(buf, i + j) != str_byte(s, j) {
            return 0;
        }
        j = j + 1;
    }
    return 1;
}

/// 在配置原文里找 `error_lang(`，返回它后面**第一个字符串字面量**的内容
/// `(起点 << 32) | 长度`；0 = 没有这一项 / 读不出来。
///
/// **标签后面必须紧跟 `(`**：这是"这是一条配置项"与"这只是提到一个词"的分界。
/// 少了这一条，注释里写一句 `error_lang` 就能把语言悄悄改掉。
/// （**它拦不住的是**注释里恰好也写了 `error_lang(` —— 那要认注释，得有个词法器，
/// 而这里读的是一份两行的配置。如实记着：这一格比"任何位置出现就算"强很多，但不是无懈可击。）
/// 值里出现换行、没有闭合引号、整份文件没有这一项 —— 一律 0（调用方退回默认）。
fn cfg_lang(cfg: ptr, n: u32) -> u64 {
    let key: str = "error_lang";
    let i: u32 = 0;
    let res: u64 = 0;
    let go: u32 = 1;
    while i < n && go == 1 {
        if at_word(cfg, n, i, key) == 1 {
            let p: u32 = skip_blank(cfg, i + str_len(key), n);
            if p < n && load8(cfg, p) == LPAREN {
                let q: u32 = p;
                let hunt: u32 = 1;
                while q < n && hunt == 1 {
                    if load8(cfg, q) == QUOTE {
                        let a: u32 = q + 1;
                        let r: u32 = a;
                        let scan: u32 = 1;
                        while r < n && scan == 1 {
                            let c: u32 = load8(cfg, r);
                            if c == QUOTE {
                                res = (a as u64) * 4294967296 + (r - a) as u64;
                                scan = 0;
                            } else {
                                if c == NL {
                                    scan = 0;
                                } else {
                                    r = r + 1;
                                }
                            }
                        }
                        hunt = 0;
                    } else {
                        q = q + 1;
                    }
                }
            }
            go = 0;
        } else {
            i = i + 1;
        }
    }
    return res;
}

/// 值 -> 语言槽：`0` = 英文、`1` = 中文、**`2` = 认不出来**（不是"默认值"，见 `cfg_try`）。
///
/// **一律大小写不敏感**（`ZH` / `Zh` / `chinese` / `Chinese` 都算）：配置是手写的，
/// 逼用户记住大小写只会换来一次次"配了没生效" —— 而那种失败**没有任何提示**。
/// （第一版只让长写法不敏感、`en`/`zh` 是逐字节比的 —— 实测 `"ZH"` 静默退回默认。
/// 这类"文档说 A、代码做 B"只有判据能抓，所以下面那 5 个拼法各有一条。）
fn lang_of_val(v: ptr, n: u32) -> u32 {
    if lower_at(v, n, "en") == 1 || lower_at(v, n, "english") == 1 {
        return 0;
    }
    if lower_at(v, n, "zh") == 1 || lower_at(v, n, "cn") == 1 || lower_at(v, n, "chinese") == 1 {
        return 1;
    }
    return 2;
}

/// `s` 的小写形式是不是就是 `buf[0..]`（大小写不敏感的比较，长度也一并比）。
fn lower_at(v: ptr, n: u32, s: str) -> u32 {
    if n != str_len(s) {
        return 0;
    }
    let i: u32 = 0;
    while i < n {
        if lower_c(load8(v, i)) != lower_c(str_byte(s, i)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 把 `<工具目录>/../share/loment/errconfig` 拼进 `sc + SCR_TOOLCFG`，返回长度（0 = 拼不出）。
/// 形状与 `lomcli` 的 `share_dir` 同一件事：取 argv[0] 里最后一个分隔符之前的部分。
fn tool_cfg_path(ab: ptr, sc: ptr) -> u32 {
    let a: u64 = argv_at(ab, 65536, sc, 0);
    if a == 0 {
        return 0;
    }
    let p: ptr = ptr_add(ab, (a >> 32) as u32);
    let n: u32 = (a % 4294967296) as u32;
    let i: u32 = 0;
    let last: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c == 47 || c == 92 {
            last = i + 1;
        }
        i = i + 1;
    }
    if last == 0 {
        return 0;
    }
    let k: u32 = 0;
    while k < last && k < 1024 {
        store8(sc, SCR_TOOLCFG + k, load8(p, k) as u8);
        k = k + 1;
    }
    let tail: str = "../share/loment/errconfig";
    let j: u32 = 0;
    while j < str_len(tail) && k < 2000 {
        store8(sc, SCR_TOOLCFG + k, str_byte(tail, j) as u8);
        k = k + 1;
        j = j + 1;
    }
    return k;
}

/// 读一份 errconfig（`p[0..n)`）：**真的定下了语言**才返回 1。
///
/// "文件在、标签在、但值认不出来"返回 **0**，不是"用默认值" —— 差别在 `cfg_load` 那里：
/// 返回 0 才会**继续找下一份**。这是从 `loment.conf` 抄来的纪律（"读不出来就当没配"）：
/// 项目里写错一个字母，不该把用户**系统级**的那份设置悄悄作废。
fn cfg_try(ctx: ptr, p: ptr, n: u32, sc: ptr) -> u32 {
    if n == 0 {
        return 0;
    }
    let fd: i64 = open_ro(p, n, sc);
    if fd < 0 {
        return 0;
    }
    let got: u32 = read_all(fd as u64, ptr_add(ctx, C_CFG), CFG_CAP as u64) as u32;
    syscall4(3, fd as u64, 0, 0);
    let v: u64 = cfg_lang(ptr_add(ctx, C_CFG), got);
    if v == 0 {
        return 0;
    }
    let vo: u32 = (v >> 32) as u32;
    let vn: u32 = (v % 4294967296) as u32;
    let lv: u32 = lang_of_val(ptr_add(ctx, C_CFG + vo), vn);
    if lv == 2 {
        return 0;
    }
    store32(ctx, C_LANG, lv);
    return 1;
}

/// 决定说哪种语言：**项目那份优先，工具链旁边那份兜底**，都没有就是英文。
/// 两份都读了也只认第一份 —— 这与 `loment.conf` 的"项目那份优先"是同一条。
fn cfg_load(ctx: ptr, ab: ptr, sc: ptr) -> u32 {
    let proj: str = "./errconfig";
    if cfg_try(ctx, str_ptr(proj), str_len(proj), sc) == 1 {
        return 1;
    }
    let n: u32 = tool_cfg_path(ab, sc);
    if n == 0 {
        return 0;
    }
    return cfg_try(ctx, ptr_add(sc, SCR_TOOLCFG), n, sc);
}

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let n: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if n <= 0 {
            return off;
        }
        off = off + (n as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

/// 用法 / 环境失败一律退 **2** —— 与"有诊断"(1)分开: 调用方要能分清"你的源码错了"
/// 和"报错器自己没起来"。混成一个码, 那条区分就没了。
fn fail(msg: str) -> u32 {
    write_all(2, str_ptr(msg), str_len(msg) as u64);
    return die(2);
}

fn open_ro(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    return syscall4(257, (0 as u64) - 100, scr as u64, 0);
}

/// 第 `idx` 个 argv（0 = 程序名）的 `(起点 << 32) | 长度`；0 = 没有。
/// PE 上这条路是运行库合成的 (`lomelf.py` 的 `PE_CMDLINE`), 两边读法一致。
///
/// **每次调用都重写 `buf`** —— 所以调用方要么当场比完，要么先把要留的那段抄走。
/// 与自举驱动的 `argv_at` 同一形状。
fn argv_at(buf: ptr, cap: u64, scr: ptr, idx: u32) -> u64 {
    let fd: i64 = open_ro(str_ptr("/proc/self/cmdline"),
                          str_len("/proc/self/cmdline"), scr);
    if fd < 0 {
        return 0;
    }
    let n: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if n <= 0 {
        return 0;
    }
    let i: u64 = 0;
    let k: u32 = 0;
    while k < idx {
        while i < n as u64 && load8(buf, i as u32) != 0 {
            i = i + 1;
        }
        if i >= n as u64 {
            return 0;
        }
        i = i + 1;
        k = k + 1;
    }
    let s: u64 = i;
    while i < n as u64 && load8(buf, i as u32) != 0 {
        i = i + 1;
    }
    if i == s {
        return 0;
    }
    return (s << 32) | (i - s);
}

/// `p[0..n]` 是不是 `s`。
fn arg_is(p: ptr, n: u32, s: str) -> u32 {
    if n != str_len(s) {
        return 0;
    }
    let i: u32 = 0;
    while i < n {
        if load8(p, i) != str_byte(s, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 扫一遍 argv：认 `--no-color` / `-C`（**与 `lomcli` 同一套开关、同一个默认值**），
/// 并把**第一个不是开关的那个参数**（诊断文件）抄进 `scr + SCR_DIAG`。
/// 返回它的 `(SCR_DIAG << 32) | len`，0 = 没给。
///
/// **为什么不直接取 argv[1]**：启动器会把用户的 `--no-color` **原样**带进来，
/// 而它在文件名前面还是后面都合法 —— 与 `lomcli` 那条"开关位置任意、且不吞命令"
/// 是同一条纪律（`docs/169` §6 有一格判据专门钉它）。
/// `p[0..n)` 是不是以 `s` 开头。给 `--max=N` 那种"一个开关带值"的写法用
/// （`arg_is` 是整串相等，认不出带值的）。
fn arg_pre(p: ptr, n: u32, s: str) -> u32 {
    let sn: u32 = str_len(s);
    if n < sn {
        return 0;
    }
    let i: u32 = 0;
    while i < sn {
        if load8(p, i) != str_byte(s, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// `p[0..n)` 当十进制读（全是数字才算，否则 0 —— **不会**悄悄当成别的数）。
fn dec_at(p: ptr, n: u32) -> u32 {
    if n == 0 {
        return 0;
    }
    let v: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c < 48 || c > 57 {
            return 0;
        }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

fn parse_args(ctx: ptr, ab: ptr, sc: ptr) -> u64 {
    let found: u32 = 0;
    let k: u32 = 1;
    let go: u32 = 1;
    // `--max N` 是**两个**参数，而 `argv_at` 每调一次就把 `ab` 重写一遍（当前参数那几字节
    // 就在 `ab` 里）—— 所以不能"先看看下一个再回来"：记一个"下一个参数是数字"的状态。
    let wantmax: u32 = 0;
    // **没有 `break`**（Loment 里没有这个关键字）—— 用一个"还走不走"的变量收尾。
    while k < 64 && go == 1 {
        let a: u64 = argv_at(ab, 65536, sc, k);
        if a == 0 {
            go = 0;
        } else {
            let p: ptr = ptr_add(ab, (a >> 32) as u32);
            let n: u32 = (a % 4294967296) as u32;
            if arg_is(p, n, "--no-color") == 1 || arg_is(p, n, "-C") == 1 {
                store32(ctx, C_COLOR, 0);
            } else {
                // `version` / `--version` / `-V` —— **这是要报错器报自己的版本，不是一份诊断**。
                // 三个写法都收：裸词与 `loment version` 一致，两个带横杠的与别处一致
                // （`lomcli` 也是 `version` 与 `--version` 都认）。
                if arg_is(p, n, "version") == 1 || arg_is(p, n, "--version") == 1 || arg_is(p, n, "-V") == 1 {
                    store32(ctx, C_WANTVER, 1);
                } else {
                // `--short` / `--json` **顺带关色**：它们存在的意义就是给管道与编辑器读
                // （`docs/182` §15），一条带 ANSI 转义的"机器可读行"没人能 grep。
                if arg_is(p, n, "--short") == 1 {
                    store32(ctx, C_MODE, 1);
                    store32(ctx, C_COLOR, 0);
                } else {
                    if arg_is(p, n, "--json") == 1 {
                        store32(ctx, C_MODE, 2);
                        store32(ctx, C_COLOR, 0);
                    } else {
                        if arg_is(p, n, "--max") == 1 {
                            wantmax = 1;
                        } else {
                            if arg_pre(p, n, "--max=") == 1 {
                                store32(ctx, C_MAX, dec_at(ptr_add(p, 6), n - 6));
                            } else {
                                if wantmax == 1 {
                                    store32(ctx, C_MAX, dec_at(p, n));
                                    wantmax = 0;
                                } else {
                                    if found == 0 {
                                        let i: u32 = 0;
                                        while i < n && i < 4000 {
                                            store8(sc, SCR_DIAG + i, load8(p, i) as u8);
                                            i = i + 1;
                                        }
                                        found = i;
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
            k = k + 1;
        }
    }
    if found == 0 {
        return 0;
    }
    return (SCR_DIAG as u64) * 4294967296 + (found as u64);
}

fn strip_cr(buf: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    while i < n {
        let c: u32 = load8(buf, i);
        if c == CR && i + 1 < n && load8(buf, i + 1) == NL {
            i = i + 1;
        } else {
            store8(buf, o, c as u8);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

// ---------------------------------------------------------------- 输出

/// 留 128 字节余量给"撞上沿"这个信号 —— 撞了就置位, 由调用方在 flush 之后**另起一行**
/// 说明, 而不是让输出**静默截断** (截断看着像"这条就到这儿", 是本仓最反对的那种
/// 悄悄改内容)。
fn em_byte(ctx: ptr, o: u32, c: u32) -> u32 {
    if o + 128 >= OB_CAP {
        store32(ctx, C_TRUNC, 1);
        return o;
    }
    store8(ctx, C_OB + o, c as u8);
    return o + 1;
}

fn em(ctx: ptr, o: u32, s: str) -> u32 {
    let k: u32 = 0;
    while k < str_len(s) {
        o = em_byte(ctx, o, str_byte(s, k));
        k = k + 1;
    }
    return o;
}

fn em_pad(ctx: ptr, o: u32, n: u32) -> u32 {
    let k: u32 = 0;
    while k < n {
        o = em_byte(ctx, o, SP);
        k = k + 1;
    }
    return o;
}

fn em_u32(ctx: ptr, o: u32, v: u32) -> u32 {
    if v == 0 {
        return em_byte(ctx, o, 48);
    }
    let d: u32 = 0;
    let x: u32 = v;
    while x > 0 {
        store8(ctx, C_NUM + d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        o = em_byte(ctx, o, load8(ctx, C_NUM + d - 1 - q));
        q = q + 1;
    }
    return o;
}

/// 写一段可能**内嵌换行**的文字 (修复建议里有 `\n`)。续行补 gutter 前缀, 不然第二行
/// 会顶到最左边、看着像另一条诊断。
// ---------------------------------------------------------------- 颜色
//
// **跟着 `lomcli` 那一套走，不另发明约定**（`docs/169` §6 有一格判据钉着它的观感）：
// `ESC [ <码> m`、**默认开**、`--no-color` / `-C` 关掉、关掉之后**一个字节都不剩**。
//
// 为什么可以默认开：`lomcli` 已经这么发了，两个工具的开关行为不一致才是更坏的事。
// 管道里要干净输出就 `--no-color` —— 这和 `loment help | less` 是同一个用法。
//
// **不敢多做的一件**：看不出 fd 是不是终端（PE 垫片没实现 ioctl，也没有
// `SetConsoleMode` 去开 VT），所以做不到 rustc 那种"tty 才上色"。默认开 + 显式关，
// 是在这个约束下唯一自洽的选择。

/// 往渲染缓冲里追加 `ESC [ <code> m`。关着时**一个字节都不写**（判据钉着）。
fn em_col(ctx: ptr, o: u32, code: str) -> u32 {
    if load32(ctx, C_COLOR) == 0 {
        return o;
    }
    o = em_byte(ctx, o, 27);
    o = em_byte(ctx, o, 91);
    let i: u32 = 0;
    while i < str_len(code) {
        o = em_byte(ctx, o, str_byte(code, i));
        i = i + 1;
    }
    return em_byte(ctx, o, 109);
}

fn em_rst(ctx: ptr, o: u32) -> u32 {
    return em_col(ctx, o, "0");
}

/// gutter 前缀：`<w+1 个空格>| `。诊断正文的每一行都从它起头，视觉上挂在源码那一段下面。
fn em_gut(ctx: ptr, o: u32, w: u32) -> u32 {
    o = em_pad(ctx, o, w + 1);
    o = em_col(ctx, o, "1;30");
    o = em(ctx, o, "| ");
    return em_rst(ctx, o);
}

/// 写一段可能**内嵌换行**的文字（说明卡与语言卡里都有）。
/// **续行补 gutter + `extra` 个空格** —— 不然第二行会顶到最左边，看着像另一条诊断；
/// 列表项（`1. …`）还要多缩两格，续行才对得齐。
fn em_wrap(ctx: ptr, o: u32, s: str, w: u32, extra: u32) -> u32 {
    let k: u32 = 0;
    while k < str_len(s) {
        let c: u32 = str_byte(s, k);
        if c == NL {
            o = em(ctx, o, "\n");
            o = em_gut(ctx, o, w);
            o = em_pad(ctx, o, extra);
        } else {
            o = em_byte(ctx, o, c);
        }
        k = k + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 小工具

fn dig_w(v: u32) -> u32 {
    let w: u32 = 1;
    let x: u32 = v;
    while x >= 10 {
        x = x / 10;
        w = w + 1;
    }
    return w;
}

fn bytes_eq(a: ptr, an: u32, b: ptr, bn: u32) -> bool {
    if an != bn {
        return false;
    }
    let i: u32 = 0;
    while i < an {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn is_blank(c: u32) -> bool {
    return c == SP || c == TAB || c == CR || c == NL;
}

/// 从 `s` 到 `e` 全是空白则 1 (空行不算诊断)。
fn line_blank(buf: ptr, s: u32, e: u32) -> u32 {
    let i: u32 = s;
    while i < e {
        if is_blank(load8(buf, i)) == false {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 第 `want` 行的区间 (1 起): (start << 32) | len。**没有这一行**返回 u64 最大值。
/// 行尾的 `\r` 去掉; 行首缩进**保留** —— 插入符要按原列算。
fn line_span(src: ptr, len: u32, want: u32) -> u64 {
    if want == 0 {
        return 18446744073709551615 as u64;
    }
    let i: u32 = 0;
    let cur: u32 = 1;
    while i < len && cur < want {
        if load8(src, i) == NL {
            cur = cur + 1;
        }
        i = i + 1;
    }
    if cur != want {
        return 18446744073709551615 as u64;
    }
    let s: u32 = i;
    while i < len && load8(src, i) != NL {
        i = i + 1;
    }
    let e: u32 = i;
    if e > s && load8(src, e - 1) == CR {
        e = e - 1;
    }
    return (s as u64) * 4294967296 + (e - s) as u64;
}

/// 首个非空白距行首的偏移。
fn first_visible(src: ptr, s: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if is_blank(load8(src, s + i)) == false {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

/// 最后一个非空白**之后**的偏移 (画下划线用, 不含尾随空白)。
fn after_visible(src: ptr, s: u32, n: u32) -> u32 {
    let i: u32 = n;
    while i > 0 {
        if is_blank(load8(src, s + i - 1)) == false {
            return i;
        }
        i = i - 1;
    }
    return 0;
}

/// "E022" -> 22。取不出数字就是 0 (调用方据此走"未知码"那条,**不静默**)。
fn code_num(ctx: ptr, off: u32, n: u32) -> u32 {
    let v: u32 = 0;
    let got: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(ctx, off + i);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            got = 1;
        } else {
            if got == 1 {
                return v;
            }
        }
        i = i + 1;
    }
    if got == 0 {
        return 0;
    }
    return v;
}

// ---------------------------------------------------------------- JSON 取值

/// object 里的字符串字段 -> ctx 的 `off`, 返回长度。不是字符串节点就当没有。
fn str_field(js: ptr, ar: ptr, n: u32, ctx: ptr, off: u32, cap: u32) -> u32 {
    if n == 4294967295 {
        return 0;
    }
    if json_nkind(ar, n) != 3 {
        return 0;
    }
    return json_str_into(js, ar, n, ptr_add(ctx, off), cap);
}

/// object 里的数字字段 -> u32。**不是数字节点就是 0** (line/col 缺失 = 没位置,
/// 而不是某个看着正常的位置)。
fn num_raw(js: ptr, ar: ptr, n: u32) -> u32 {
    if n == 4294967295 {
        return 0;
    }
    if json_nkind(ar, n) != 4 {
        return 0;
    }
    return json_as_u32(js, ar, n);
}

// ---------------------------------------------------------------- 源文件

/// 保证 `ctx` 里的源缓冲是 `C_PATH` 那一份。同一个文件只读一次。
/// 返回 1 = 有源可用, 0 = 打不开 (头/位置/建议照出, 只是没有源码那两行)。
fn src_ensure(ctx: ptr, sr: ptr, sc: ptr, plen: u32) -> u32 {
    let pv: u32 = load32(ctx, C_PREVLEN);
    if pv == plen && bytes_eq(ptr_add(ctx, C_PREV), pv, ptr_add(ctx, C_PATH), plen) == true {
        return 1;
    }
    let fd: i64 = open_ro(ptr_add(ctx, C_PATH), plen, sc);
    if fd < 0 {
        store32(ctx, C_SRCLEN, 0);
        store32(ctx, C_PREVLEN, 0);
        return 0;
    }
    let n: u32 = read_all(fd as u64, sr, SRC_CAP as u64) as u32;
    syscall4(3, fd as u64, 0, 0);
    // **不剥 CR**：`sr` 里的偏移要能直接给编辑器去切片（`--json` 的 `byte_start`），
    // 而就地剥掉 CR 会让每个 CRLF 文件**从第二行起每行偏一个字节** —— Windows 上
    // 那就是常态。CR 由各个读源的地方自己容忍（`line_span` 会切掉行尾那个 CR，
    // `is_blank` 也认它）。诊断那份（`dg`）照旧剥 —— 那是按行切 JSON 的缓冲。
    store32(ctx, C_SRCLEN, n);
    let k: u32 = 0;
    while k < plen {
        store8(ctx, C_PREV + k, load8(ctx, C_PATH + k) as u8);
        k = k + 1;
    }
    store32(ctx, C_PREVLEN, plen);
    return 1;
}

// ---------------------------------------------------------------- 渲染

fn h_head(ctx: ptr, o: u32, cnum: u32, clen: u32) -> u32 {
    o = em_col(ctx, o, "1;31");
    o = em(ctx, o, "error[");
    let k: u32 = 0;
    while k < clen {
        o = em_byte(ctx, o, load8(ctx, C_CODE + k));
        k = k + 1;
    }
    o = em(ctx, o, "]: ");
    o = em_rst(ctx, o);
    // 判据是**查出来的标题空不空**, 不是"码号解出来没有" —— 解得出 42 而表里没有 42,
    // 也是一样的处境 (表是工具链自带的, 另一个版本可能多发了一个码)。
    let t: str = code_title(cnum, lg(ctx));
    if str_len(t) == 0 {
        return em(ctx, o, ui(ctx, S_UNKNOWN_CODE));
    }
    o = em_col(ctx, o, "1");
    o = em(ctx, o, t);
    o = em_rst(ctx, o);
    return em(ctx, o, "\n");
}

/// 源文件读不到时也要说一句 —— 否则"没有源码那两行"看起来像渲染坏了。
fn h_nosrc(ctx: ptr, o: u32, w: u32, plen: u32) -> u32 {
    o = em_gut(ctx, o, w);
    o = em(ctx, o, ui(ctx, S_NOSRC_OPEN));
    let k: u32 = 0;
    while k < plen {
        o = em_byte(ctx, o, load8(ctx, C_PATH + k));
        k = k + 1;
    }
    return em(ctx, o, ")\n");
}

fn h_loc(ctx: ptr, o: u32, line: u32, col: u32, w: u32, plen: u32) -> u32 {
    o = em_pad(ctx, o, w + 1);
    o = em_col(ctx, o, "1;36");
    o = em(ctx, o, "--> ");
    let k: u32 = 0;
    while k < plen {
        o = em_byte(ctx, o, load8(ctx, C_PATH + k));
        k = k + 1;
    }
    // **`line == 0` = 编译器没有位置可指**（文件读不到 / 写不出去 / 单元太大 ——
    // `E031`..`E033` 那几条）。那时**连冒号都不印** —— `file:` 后面空着的样子比
    // `file:0` 更像坏了。与本文件 `h_snip` 的 `col == 0` 同一条口径：
    // **只印确实知道的那部分**。
    if line > 0 {
        o = em_byte(ctx, o, COLON);
        o = em_u32(ctx, o, line);
    }
    if col > 0 {
        o = em_byte(ctx, o, COLON);
        o = em_u32(ctx, o, col);
    }
    o = em_rst(ctx, o);
    o = em(ctx, o, "\n");
    o = em_pad(ctx, o, w + 1);
    o = em_col(ctx, o, "1;30");
    o = em(ctx, o, "|");
    o = em_rst(ctx, o);
    return em(ctx, o, "\n");
}

/// 源码那两行。`col == 0` 表示**编译器只给了行号** (check() 的语义诊断都是这样):
/// 那时划整行的可见部分 —— 位置确实就是"这一行", 不是猜一个列出来。
fn h_snip(ctx: ptr, o: u32, sr: ptr, srl: u32, line: u32, col: u32, w: u32, mlen: u32) -> u32 {
    let sp: u64 = line_span(sr, srl, line);
    if sp == 18446744073709551615 as u64 {
        o = em_gut(ctx, o, w);
        return em(ctx, o, ui(ctx, S_NO_LINE));
    }
    let st: u32 = (sp / 4294967296) as u32;
    let ln: u32 = (sp % 4294967296) as u32;
    o = em_u32(ctx, o, line);
    o = em(ctx, o, " | ");
    let k: u32 = 0;
    while k < ln {
        o = em_byte(ctx, o, load8(sr, st + k));
        k = k + 1;
    }
    o = em(ctx, o, "\n");
    o = em_gut(ctx, o, w);
    if col > 0 {
        let t: u32 = 1;
        while t < col {
            o = em_byte(ctx, o, SP);
            t = t + 1;
        }
        o = em_col(ctx, o, "1;31");
        o = em(ctx, o, "^");
        o = em_rst(ctx, o);
        return em(ctx, o, "\n");
    }
    let a: u32 = first_visible(sr, st, ln);
    let b: u32 = after_visible(sr, st, ln);
    return h_snip_nocol(ctx, o, sr, st, a, b, mlen);
}

/// `col == 0`（编译器只给了行号）时**指哪一段**。三条路，从准到宽：
///
/// 1. **消息里点名的那个名字**（`使用未声明的变量 leftover` → `leftover`）在**这一行里
///    恰好出现一次** —— 那就点它。这正是 rustc 的 `^^^` 位置，而它是**可证伪的近似**：
///    出现两次以上就不猜（点错位置比划整行更坏）；
/// 2. 否则划整行的**可见部分**，但**停在行注释之前** —— 编译器的位置说的是代码，
///    把行尾那句 `// 注释` 一起划进去会拉出一条上百字符的插入符（实测过，很糙）；
/// 3. 连可见部分都没有（空行）就只留一条 `| `。
fn h_snip_nocol(ctx: ptr, o: u32, sr: ptr, st: u32, a: u32, b: u32, mlen: u32) -> u32 {
    // **右端 = 代码段里最后一个可见字符**：先切在行注释之前，再去掉注释前的那些空格。
    // 两条都是被自己的样例教会的：`let s: S = S { id: 1 };   // 缺 weight` 这条，
    // 只切注释会连那三个空格一起划（插入符比代码长），而**只搜代码段**则是因为消息点名的
    // `weight` 在注释里也"恰好出现一次"，于是插入符指到了我自己的注释上 —— 比划整行还坏。
    let cc: u32 = trim_comment(sr, st + a, st + b) - st;
    let w2: u32 = after_visible(sr, st + a, cc - a);
    if w2 == 0 {
        w2 = cc - a;
    }
    let hint: u64 = msg_hint(sr, st + a, st + a + w2, ptr_add(ctx, C_MSG), mlen);
    if hint != 18446744073709551615 as u64 {
        let at: u32 = (hint / 4294967296) as u32;
        let hn: u32 = (hint % 4294967296) as u32;
        let t: u32 = 0;
        while t < at - st {
            o = em_byte(ctx, o, SP);
            t = t + 1;
        }
        o = em_col(ctx, o, "1;31");
        let q: u32 = 0;
        while q < hn {
            o = em_byte(ctx, o, CARET);
            q = q + 1;
        }
        o = em_rst(ctx, o);
        return em_byte(ctx, o, NL);
    }
    let t1: u32 = 0;
    while t1 < a {
        o = em_byte(ctx, o, SP);
        t1 = t1 + 1;
    }
    o = em_col(ctx, o, "1;31");
    let t2: u32 = a;
    while t2 < a + w2 {
        o = em_byte(ctx, o, 94);
        t2 = t2 + 1;
    }
    o = em_rst(ctx, o);
    return em(ctx, o, "\n");
}

/// 标识符字符（ASCII 那套）。**只认 ASCII** —— Loment 的标识符就是这套，而消息里的中文
/// 是说明文字，不是名字。
fn is_word(c: u32) -> bool {
    if c >= 48 && c <= 57 {
        return true;
    }
    if c >= 65 && c <= 90 {
        return true;
    }
    if c >= 97 && c <= 122 {
        return true;
    }
    return c == 95;
}

/// 消息里**最后一个**长度 >= 2 的标识符（`(起点 << 32) | 长度`；没有就是 u64 最大值）。
///
/// "最后一个"是有理由的：这批消息的写法是"<说明> <名字>"（`使用未声明的变量 leftover`、
/// `结构体 Job 缺字段 weight`），名字在末尾。长度门槛 2 是为了躲开 `return z;` 那种单字母
/// —— 单字母在整行里到处都是，定位它没有信息量。
fn msg_hint(sr: ptr, from: u32, to: u32, mp: ptr, mlen: u32) -> u64 {
    let best: u64 = 18446744073709551615 as u64;
    let i: u32 = 0;
    while i < mlen {
        if is_word(load8(mp, i)) == true {
            let s: u32 = i;
            while i < mlen && is_word(load8(mp, i)) == true {
                i = i + 1;
            }
            if i - s >= 2 {
                let at: u32 = sole_word_at(sr, from, to, ptr_add(mp, s), i - s);
                if at != 4294967295 {
                    best = (at as u64) * 4294967296 + (i - s) as u64;
                }
            }
        } else {
            i = i + 1;
        }
    }
    return best;
}

/// `[from, to)` 里**整词**等于 `needle` 的位置，**且只出现一次**；否则 `0xFFFFFFFF`。
/// 词边界两边都要查（`leftover` 不能命中 `leftover_x`）。
fn sole_word_at(sr: ptr, from: u32, to: u32, np: ptr, nn: u32) -> u32 {
    let found: u32 = 4294967295;
    let n: u32 = 0;
    let i: u32 = from;
    while i + nn <= to {
        let k: u32 = 0;
        let same: u32 = 1;
        while k < nn && same == 1 {
            if load8(sr, i + k) != load8(np, k) {
                same = 0;
            } else {
                k = k + 1;
            }
        }
        if same == 1 {
            let ok: u32 = 1;
            if i > from && is_word(load8(sr, i - 1)) == true {
                ok = 0;
            }
            if i + nn < to && is_word(load8(sr, i + nn)) == true {
                ok = 0;
            }
            if ok == 1 {
                n = n + 1;
                found = i;
            }
        }
        i = i + 1;
    }
    if n == 1 {
        return found;
    }
    return 4294967295;
}

/// 划线的右端：**停在行注释之前**（`//`，且它前面是空白或就在可见段开头）。
/// 要求"前面是空白"是为了不把 `a//b` 这种（虽然 Loment 里不合法）当成注释。
fn trim_comment(sr: ptr, from: u32, to: u32) -> u32 {
    let i: u32 = from;
    while i + 1 < to {
        if load8(sr, i) == 47 && load8(sr, i + 1) == 47 {
            if i == from || is_blank(load8(sr, i - 1)) == true {
                return i;
            }
        }
        i = i + 1;
    }
    return to;
}

/// 编译器那句话说一遍。check() 的消息自带 `"4: "` 行号前缀, 而位置已经单独渲染了 ——
/// 去掉它 (只去呈现层那一个前缀, 正文一个字不动)。
fn h_msg(ctx: ptr, o: u32, off: u32, n: u32, w: u32) -> u32 {
    let a: u32 = 0;
    let d: u32 = 0;
    while d < n && load8(ctx, off + d) >= 48 && load8(ctx, off + d) <= 57 {
        d = d + 1;
    }
    if d > 0 && d + 1 < n && load8(ctx, off + d) == COLON && load8(ctx, off + d + 1) == SP {
        a = d + 2;
    }
    if a >= n {
        return o;
    }
    o = em_gut(ctx, o, w);
    o = em_col(ctx, o, "1");
    o = em(ctx, o, ui(ctx, S_MSG));
    o = em_rst(ctx, o);
    let k: u32 = a;
    while k < n {
        o = em_byte(ctx, o, load8(ctx, off + k));
        k = k + 1;
    }
    return em(ctx, o, "\n");
}

/// 一条诊断的说明卡：错了什么 / 为什么错 / 怎么改 / 支持与不支持。
///
/// **判据是"查出来的文字空不空"**：表里没有这个码时四段一起缺席，由 `h_unknown` 顶上，
/// 而不是渲染出一条"只有标题"的残件 —— 残件会让用户以为"这条没有更多可说的了"。
fn h_card(ctx: ptr, o: u32, cnum: u32, w: u32) -> u32 {
    let nfix: u32 = code_nfix(cnum);
    if nfix == 0 {
        return h_unknown(ctx, o, w);
    }
    o = h_sect(ctx, o, w, ui(ctx, S_WHAT), code_what(cnum, lg(ctx)), "1");
    o = h_sect(ctx, o, w, ui(ctx, S_WHY), code_why(cnum, lg(ctx)), "1");
    o = em_gut(ctx, o, w);
    o = em_col(ctx, o, "1");
    o = em(ctx, o, ui(ctx, S_HOWFIX));
    o = em_rst(ctx, o);
    o = em(ctx, o, "\n");
    let i: u32 = 0;
    while i < nfix {
        o = em_gut(ctx, o, w);
        o = em(ctx, o, "  ");
        o = em_u32(ctx, o, i + 1);
        o = em(ctx, o, ". ");
        o = em_wrap(ctx, o, code_fix(cnum, i, lg(ctx)), w, 2);
        o = em(ctx, o, "\n");
        i = i + 1;
    }
    o = h_sect(ctx, o, w, ui(ctx, S_YES), code_yes(cnum, lg(ctx)), "1;32");
    o = h_sect(ctx, o, w, ui(ctx, S_NO), code_no(cnum, lg(ctx)), "1;31");
    return o;
}

/// 表里没有这个码：**明说**，并把"该用什么判断"交代清楚。
fn h_unknown(ctx: ptr, o: u32, w: u32) -> u32 {
    o = em_gut(ctx, o, w);
    o = em(ctx, o, ui(ctx, S_NOCARD1));
    o = em_gut(ctx, o, w);
    return em(ctx, o, ui(ctx, S_NOCARD2));
}

/// 一段"标签: 值"，值里内嵌的换行按 gutter 缩进。值为空就整段不印。
/// `cl` 是**标签那一小段**的颜色码 —— 值不上色（正文上色会把中文压得看不清）。
fn h_sect(ctx: ptr, o: u32, w: u32, label: str, s: str, cl: str) -> u32 {
    if str_len(s) == 0 {
        return o;
    }
    o = em_gut(ctx, o, w);
    o = em_col(ctx, o, cl);
    o = em(ctx, o, label);
    o = em(ctx, o, ":");
    o = em_rst(ctx, o);
    o = em(ctx, o, " ");
    o = em_wrap(ctx, o, s, w, 0);
    return em(ctx, o, "\n");
}

// ---------------------------------------------------------------- 外源语言 (docs/188 §7.1)

/// 在 `[0,hn)` 里找 `needle` 的第一次出现。**-1 = 没有**（u32 表达不了"比 0 还小"）。
fn sub_find(hay: ptr, hn: u32, np: ptr, nn: u32) -> i64 {
    if nn == 0 || nn > hn {
        return 0 as i64 - 1;
    }
    let i: u32 = 0;
    while i + nn <= hn {
        let j: u32 = 0;
        let ok: u32 = 1;
        while j < nn && ok == 1 {
            if load8(hay, i + j) != load8(np, j) {
                ok = 0;
            } else {
                j = j + 1;
            }
        }
        if ok == 1 {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 as i64 - 1;
}

/// `lang_tokens(i)` / `lang_exts(i)` 都是**分隔串**（`|` 与空格）。这一段抄进暂存区 ——
/// `sub_find` 要的是指针，而源串在字面量里、没法直接切片。
fn seg_copy(ctx: ptr, s: str, off: u32, len: u32) -> u32 {
    let k: u32 = 0;
    while k < len && k < 60 {
        store8(ctx, C_TOK + k, str_byte(s, off + k) as u8);
        k = k + 1;
    }
    return k;
}

/// 命中点是不是在**行首**（前面只有空白）？
///
/// **为什么要这一条**：特征词是给"这个文件根本不是 Loment"用的, 而注释里写一句
/// `def ` / `use std::` 太容易了 —— 一份正经 Loment 文件只要有一条语法错, 就会
/// 被自己的注释带成"这看起来是 Python", 然后在真正的诊断后面挂一段几百字的建议。
/// 真实的签名行（`#include` / `def ` / `func ` / `public class` / `use std::`）**都在行首**,
/// 所以这一条几乎不损失命中率。**`/` 不算空白** —— 正是为了把 `// def ...` 这种注释挡掉。
fn line_lead_ok(sr: ptr, k: u32) -> u32 {
    let i: u32 = k;
    while i > 0 {
        let c: u32 = load8(sr, i - 1);
        if c == NL {
            return 1;
        }
        if is_blank(c) == false {
            return 0;
        }
        i = i - 1;
    }
    return 1;
}

/// 源里有没有出现这个语言的特征词（特征词之间用 `|` 分）。
fn tok_hit(ctx: ptr, sr: ptr, srl: u32, toks: str) -> u32 {
    let n: u32 = str_len(toks);
    let s: u32 = 0;
    let i: u32 = 0;
    while i <= n {
        if i == n || str_byte(toks, i) == 124 {
            if i > s {
                let m: u32 = seg_copy(ctx, toks, s, i - s);
                let at: i64 = sub_find(sr, srl, ptr_add(ctx, C_TOK), m);
                if at >= 0 && line_lead_ok(sr, at as u32) == 1 {
                    return 1;
                }
            }
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 逐门语言问"内容里有没有它的特征词"。返回语言下标，`0xFFFFFFFF` = 认不出。
fn lang_by_tokens(ctx: ptr, sr: ptr, srl: u32) -> u32 {
    let i: u32 = 0;
    while i < lang_count() {
        if tok_hit(ctx, sr, srl, lang_tokens(i)) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 文件路径里的后缀区间 `(start << 32) | len`（相对 `C_PATH`）。没有 `.` 就是 u64 最大值。
fn ext_of(ctx: ptr, plen: u32) -> u64 {
    let i: u32 = plen;
    while i > 0 {
        let c: u32 = load8(ctx, C_PATH + i - 1);
        if c == DOT {
            return ((i - 1) as u64) * 4294967296 + (plen - (i - 1)) as u64;
        }
        if c == 47 || c == 92 {
            return 18446744073709551615 as u64;
        }
        i = i - 1;
    }
    return 18446744073709551615 as u64;
}

/// 后缀命中哪门语言（`lang_exts(i)` 是空格分隔的）。没有就是 `0xFFFFFFFF`。
fn lang_by_ext(ctx: ptr, so: u32, sl: u32) -> u32 {
    let li: u32 = 0;
    while li < lang_count() {
        let exts: str = lang_exts(li);
        let n: u32 = str_len(exts);
        let s: u32 = 0;
        let i: u32 = 0;
        while i <= n {
            if i == n || str_byte(exts, i) == 32 {
                if i - s == sl && sl > 0 {
                    let k: u32 = 0;
                    let same: u32 = 1;
                    while k < sl && same == 1 {
                        if load8(ctx, C_PATH + so + k) != str_byte(exts, s + k) {
                            same = 0;
                        } else {
                            k = k + 1;
                        }
                    }
                    if same == 1 {
                        return li;
                    }
                }
                s = i + 1;
            }
            i = i + 1;
        }
        li = li + 1;
    }
    return 4294967295;
}

/// ASCII 小写（别名比较用 —— 作者写 `C#` 还是 `c#` 都该认）。
fn lower_c(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

/// 语言名 -> 下标（`lang_key(i)` 那套）。没有就是 `0xFFFFFFFF`。
fn lang_index_of(s: str) -> u32 {
    let i: u32 = 0;
    while i < lang_count() {
        let k: str = lang_key(i);
        if str_len(k) == str_len(s) {
            let j: u32 = 0;
            let same: u32 = 1;
            while j < str_len(s) && same == 1 {
                if str_byte(k, j) != str_byte(s, j) {
                    same = 0;
                } else {
                    j = j + 1;
                }
            }
            if same == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 别名 -> 语言下标（走 `surface_data` 的**出厂锁**表，不另抄一份）。
fn lang_by_alias(sr: ptr, off: u32, len: u32) -> u32 {
    let i: u32 = 0;
    while i < alias_count() {
        let w: str = alias_word(i);
        if str_len(w) == len {
            let k: u32 = 0;
            let same: u32 = 1;
            while k < len && same == 1 {
                if lower_c(load8(sr, off + k)) != str_byte(w, k) {
                    same = 0;
                } else {
                    k = k + 1;
                }
            }
            if same == 1 {
                return lang_index_of(alias_lang(i));
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

fn skip_blank(sr: ptr, p: u32, e: u32) -> u32 {
    let i: u32 = p;
    let go: u32 = 1;
    while i < e && go == 1 {
        if load8(sr, i) == SP || load8(sr, i) == TAB {
            i = i + 1;
        } else {
            go = 0;
        }
    }
    return i;
}

/// `[p,e)` 从 `p` 起是不是词 `w`（后面必须断在空白或 `;`）。返回词后位置，0 = 不是。
fn eat_word(sr: ptr, p: u32, e: u32, w: str) -> u32 {
    let n: u32 = str_len(w);
    if p + n > e {
        return 0;
    }
    let k: u32 = 0;
    let same: u32 = 1;
    while k < n && same == 1 {
        if load8(sr, p + k) != str_byte(w, k) {
            same = 0;
        } else {
            k = k + 1;
        }
    }
    if same == 0 {
        return 0;
    }
    if p + n < e && is_blank(load8(sr, p + n)) == false && load8(sr, p + n) != 59 {
        return 0;
    }
    return p + n;
}

/// 文件头有没有 `choose write grammar <别名>`？返回语言下标，`0xFFFFFFFF` = 没有/认不出。
///
/// **与工具链同一条次序**（`potato_from.resolve_lang`：**声明 > 后缀 > 内容**）。声明是
/// **作者对这份文件说的**，而后缀是命名习惯、会说谎 —— 所以它压过后缀。渲染器看不到
/// 工具链的解析结果，只能自己找这一行；**语言名仍取自 `surface_data` 的别名表与
/// `lang_key`**，所以"支持哪些语言"还是一处真源。
///
/// **为什么非要有它**：实测一份 `choose write grammar python` 的 `.lomt`，工具链知道是
/// Python，而报错器因为内容里没有 Python 特征词而**一个字都不说** —— 工具链知道、
/// 渲染器沉默，是最坏的一种。
///
/// 工具链那边还有"必须在 `module` 之前""只许写一次"两条规矩 —— 那是**它该报的错**，
/// 这里只管找到那一行；找不到就退回嗅探（判据钉着"语法变了就红"，不会静默漂）。
/// 从行首起依次吃 `decl_word(0..n)`（`choose` / `write` / `grammar` —— **词序读
/// `surface_data`，不在这儿写死**），再读别名。返回 `(别名起点 << 32) | 长度`，
/// u64 最大值 = 这一行不是声明。
///
/// 词序走导出管线（与别名表同一条）：在渲染器里写死那三个字面量，就是**同一份契约抄两遍**
/// —— 而这一节反复要治的就是那个。共享常量**防**漂；判据只能**事后抓**。
fn decl_at(sr: ptr, s: u32, e: u32) -> u64 {
    let p: u32 = skip_blank(sr, s, e);
    let i: u32 = 0;
    let bad: u64 = 18446744073709551615 as u64;
    while i < decl_word_count() {
        let q: u32 = eat_word(sr, p, e, decl_word(i));
        if q == 0 {
            return bad;
        }
        p = skip_blank(sr, q, e);
        i = i + 1;
    }
    let a: u32 = p;
    let go: u32 = 1;
    while p < e && go == 1 {
        if is_blank(load8(sr, p)) == true || load8(sr, p) == SEMI {
            go = 0;
        } else {
            p = p + 1;
        }
    }
    if p == a {
        return bad;
    }
    return (a as u64) * 4294967296 + (p - a) as u64;
}

/// 文件头有没有 `choose write grammar <别名>`？返回语言下标，`0xFFFFFFFF` = 没有/认不出。
///
/// **与工具链同一条次序**（`potato_from.resolve_lang`：**声明 > 后缀 > 内容**）。声明是
/// **作者对这份文件说的**，而后缀是命名习惯、会说谎 —— 所以它压过后缀。渲染器看不到
/// 工具链的解析结果，只能自己找这一行；**词序与语言名都取自 `surface_data`**，所以
/// 两边仍是同一份契约。
///
/// **为什么非要有它**：实测一份 `choose write grammar python` 的 `.lomt`，工具链知道是
/// Python，而报错器因为内容里没有 Python 特征词而**一个字都不说** —— 工具链知道、
/// 渲染器沉默，是最坏的一种；而"指到另一门上"比不说还坏。
///
/// 工具链那边还有"必须在 `module` 之前""只许写一次""别名要在出厂锁里"三条规矩 ——
/// 那都是**它该报的错**（重复判会出两条措辞不同的话）。这里只管找到那一行；
/// 找不到就退回嗅探，而"声明的语法真变了"由判据钉着，不会静默漂。
fn decl_lang(sr: ptr, srl: u32) -> u32 {
    let i: u32 = 0;
    while i < srl {
        let s: u32 = i;
        while i < srl && load8(sr, i) != NL {
            i = i + 1;
        }
        let e: u32 = i;
        if i < srl {
            i = i + 1;
        }
        let d: u64 = decl_at(sr, s, e);
        if d != 18446744073709551615 as u64 {
            return lang_by_alias(sr, (d / 4294967296) as u32, (d % 4294967296) as u32);
        }
    }
    return 4294967295;
}

/// 这个文件看起来是哪门源语言？`0xFFFFFFFF` = 认不出（多半本来就是 Loment）。
///
/// **三条路，次序与 `potato_from.resolve_lang` 一模一样**（声明 > 后缀 > 内容）——
/// 两处口径不同的话，报错器会说出与工具链**相反**的一句话，而用户只能信一个：
///   * **声明**（文件头 `choose write grammar <别名>`）最硬 —— 那是**作者对这份文件
///     说的**，而后缀只是命名习惯、会说谎；
///   * **后缀**其次 —— 一份 `.java` 无论里面写了什么，都该按 Java 说；
///   * **内容**兜底，**且只用在语法错上** —— 那才是"它可能根本不是 Loment"的信号。
///     一份语法正确的 Loment 文件报语义错时按内容闻，会被注释里的一句 `import` 带跑。
///
/// 依据落在 `C_WHY` 上，由 `h_foreign` 说给用户听 —— 他要能判断这句话有多硬。
fn sniff_lang(ctx: ptr, sr: ptr, srl: u32, cnum: u32, plen: u32) -> u32 {
    if srl > 0 {
        let d: u32 = decl_lang(sr, srl);
        if d != 4294967295 {
            store32(ctx, C_WHY, 1);
            return d;
        }
    }
    let ex: u64 = ext_of(ctx, plen);
    if ex != 18446744073709551615 as u64 {
        let li: u32 = lang_by_ext(ctx, (ex / 4294967296) as u32, (ex % 4294967296) as u32);
        if li != 4294967295 {
            store32(ctx, C_WHY, 2);
            return li;
        }
    }
    if srl == 0 || cnum != 19 {
        return 4294967295;
    }
    let lt: u32 = lang_by_tokens(ctx, sr, srl);
    if lt != 4294967295 {
        store32(ctx, C_WHY, 3);
    }
    return lt;
}

/// 打印文件路径的**主干**（去掉后缀）—— 给 `--out <主干>.iface.lomt` 用。
fn em_stem(ctx: ptr, o: u32, plen: u32) -> u32 {
    let ex: u64 = ext_of(ctx, plen);
    let n: u32 = plen;
    if ex != 18446744073709551615 as u64 {
        n = (ex / 4294967296) as u32;
    }
    let k: u32 = 0;
    while k < n {
        o = em_byte(ctx, o, load8(ctx, C_PATH + k));
        k = k + 1;
    }
    return o;
}

/// 文件路径原样打一遍（两侧带引号，命令里能直接照抄）。
fn em_qpath(ctx: ptr, o: u32, plen: u32) -> u32 {
    o = em_byte(ctx, o, 34);
    let k: u32 = 0;
    while k < plen {
        o = em_byte(ctx, o, load8(ctx, C_PATH + k));
        k = k + 1;
    }
    return em_byte(ctx, o, 34);
}

/// 外源语言那一段：**这门语言是什么、三条进来路、它的边界、调用约定**。
///
/// **语言是提示不是结论**：判定权在翻译器的 `--lang auto`（它跑 `potato_from.detect_lang`），
/// 所以命令一律带 `--lang auto`，最后一行也把这句话说明。说死一句错的语言，用户会拿着
/// 错的命令去试 —— 那比不说还坏。
fn h_foreign(ctx: ptr, o: u32, li: u32, w: u32, plen: u32) -> u32 {
    o = em_gut(ctx, o, w);
    o = em_col(ctx, o, "1;31");
    o = em(ctx, o, ui(ctx, S_FOREIGN1));
    o = em_rst(ctx, o);
    o = em(ctx, o, ui(ctx, S_FOREIGN2));
    o = em(ctx, o, lang_name(li));
    o = em(ctx, o, ui(ctx, S_OPEN_PAREN));
    let why: u32 = load32(ctx, C_WHY);
    if why == 1 {
        o = em(ctx, o, ui(ctx, S_WHY_DECL));
    } else {
        if why == 2 {
            o = em(ctx, o, ui(ctx, S_WHY_EXT));
        } else {
            o = em(ctx, o, ui(ctx, S_WHY_TOK));
        }
    }
    o = em(ctx, o, ui(ctx, S_FOREIGN3));

    o = em_gut(ctx, o, w);
    o = em(ctx, o, ui(ctx, S_ROUTE_A));
    o = em_gut(ctx, o, w);
    o = em(ctx, o, "       python tools/lomt_from.py ");
    o = em_qpath(ctx, o, plen);
    o = em(ctx, o, " --lang auto --out ");
    o = em_stem(ctx, o, plen);
    o = em(ctx, o, ".iface.lomt\n");

    o = em_gut(ctx, o, w);
    o = em(ctx, o, ui(ctx, S_ROUTE_B));
    o = em_gut(ctx, o, w);
    o = em(ctx, o, "       python tools/lomt_from.py ");
    o = em_qpath(ctx, o, plen);
    o = em(ctx, o, " --lang auto --impl --out ");
    o = em_stem(ctx, o, plen);
    o = em(ctx, o, ".impl.lomt\n");

    o = em_gut(ctx, o, w);
    o = em(ctx, o, ui(ctx, S_ROUTE_C));
    o = em_gut(ctx, o, w);
    o = em(ctx, o, ui(ctx, S_ROUTE_C2));

    o = h_sect(ctx, o, w, ui(ctx, S_LANG_EDGE), lang_edge(li, lg(ctx)), "1");
    o = h_sect(ctx, o, w, ui(ctx, S_LANG_ABI), lang_abi(li, lg(ctx)), "1");
    o = em_gut(ctx, o, w);
    return em(ctx, o, ui(ctx, S_FOREIGN4));
}

/// 这个文件已经给过外源提示了吗（**一个文件只给一次** —— 一段几百字的建议重复 N 遍
/// 会把真正的诊断挤没）。
fn foreign_seen(ctx: ptr, plen: u32) -> u32 {
    let pv: u32 = load32(ctx, C_FPREVLEN);
    if pv == plen && bytes_eq(ptr_add(ctx, C_FPREV), pv, ptr_add(ctx, C_PATH), plen) == true {
        return 1;
    }
    return 0;
}

fn foreign_remember(ctx: ptr, plen: u32) {
    let k: u32 = 0;
    while k < plen && k < PATH_CAP {
        store8(ctx, C_FPREV + k, load8(ctx, C_PATH + k) as u8);
        k = k + 1;
    }
    store32(ctx, C_FPREVLEN, plen);
}

// ---------------------------------------------------------------- 另外两种输出
//
// `--short` 与 `--json`（`docs/182` §15）是**同一份渲染的另外两个出口**，不是另做一套
// 判断：它们读的还是 `C_CODE` / `C_MSG` / `C_PATH` 那几格，查的还是同一张 `surface_data`。
// 所以"总结给谁看"变了，"说什么"没变 —— 三者不会各说各话。
//
// **为什么两个都要**：`--short` 是给人 grep 的（CI 日志里一眼扫过），`--json` 是给**程序**
// 读的（编辑器把 `what` / `why` / `fixes` 放进 quickfix 面板，或 CI 按码做统计）。
// 只有 `--short` 的话，下游还得自己解析那一行文本 —— 那正是"同一件事抄两遍"的另一副面孔。

fn hexd(h: u32) -> u32 {
    if h < 10 {
        return 48 + h;
    }
    return 87 + h;
}

/// `\u00XX`（**只给控制字符用**）。消息是编译器给的、卡片是表里的，理论上都不该有控制字符，
/// 但 `--json` 的消费者是程序：一个坏 JSON 在编辑器那边表现为"报错器坏了"，
/// 而不是"这条消息有点怪"。边界上的东西宁可多写四行。
fn em_u00(ctx: ptr, o: u32, v: u32) -> u32 {
    o = em_byte(ctx, o, 92);
    o = em_byte(ctx, o, 117);
    o = em_byte(ctx, o, 48);
    o = em_byte(ctx, o, 48);
    o = em_byte(ctx, o, hexd((v >> 4) & 15));
    return em_byte(ctx, o, hexd(v & 15));
}

/// 把一段裸字节 `p[0..n)` 按 JSON 字符串的规则**转义写出**（**不含引号**）。
///
/// 这一层单独拆出来，是为了让 `json_str`（一个 `str`）与 `json_add`（往同一个 JSON 字符串
/// 里再塞一段）共用**同一套转义** —— 给两种入参各写一遍就是"同一件事抄两遍"，
/// 而这两份迟早会不一样（本仓那条老账）。
fn json_body(ctx: ptr, o: u32, p: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c == QUOTE {
            o = em(ctx, o, "\\\"");
        } else {
            if c == 92 {
                o = em(ctx, o, "\\\\");
            } else {
                if c == NL {
                    o = em(ctx, o, "\\n");
                } else {
                    if c == CR {
                        o = em(ctx, o, "\\r");
                    } else {
                        if c == TAB {
                            o = em(ctx, o, "\\t");
                        } else {
                            if c < 32 {
                                o = em_u00(ctx, o, c);
                            } else {
                                o = em_byte(ctx, o, c);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return o;
}

/// 带引号的 `json_body`：把一段**裸字节**（诊断里的码/路径/消息都住在 `ctx` 的暂存格上，
/// 而 Loment 没有从裸指针造 `str` 的办法）当 JSON 字符串写出来。
fn json_span(ctx: ptr, o: u32, p: ptr, n: u32) -> u32 {
    o = em_byte(ctx, o, QUOTE);
    o = json_body(ctx, o, p, n);
    return em_byte(ctx, o, QUOTE);
}

fn json_str(ctx: ptr, o: u32, s: str) -> u32 {
    return json_span(ctx, o, str_ptr(s), str_len(s));
}

/// 往**当前这个** JSON 字符串里再塞一段（不带引号、带转义）。
/// 消息是"前置词 + 种类 + 尾句"三段，而它们各自是 `str` 字面量 ——
/// 用 `str_concat` 拼会往 bump 堆上堆（那堆不回收），几千条诊断就是几千次分配。
fn json_add(ctx: ptr, o: u32, s: str) -> u32 {
    return json_body(ctx, o, str_ptr(s), str_len(s));
}

/// 码号写成 `E002` 那种三位补零的样子。**与 `--short` 里那条不同**：那里照抄编译器原样的
/// 码字符串（`C_CODE`），这里归口重写 —— 汇总是一列，一列里混两种写法很难看。
/// 解不出数字的码（`code_num` 给 0）写 `E?`：**不许写成 `E000`**，那是一个看着像真码的假码。
fn em_code(ctx: ptr, o: u32, cnum: u32) -> u32 {
    o = em_byte(ctx, o, 69);
    if cnum == 0 {
        return em_byte(ctx, o, 63);
    }
    if cnum < 10 {
        o = em_byte(ctx, o, 48);
        o = em_byte(ctx, o, 48);
        return em_u32(ctx, o, cnum);
    }
    if cnum < 100 {
        o = em_byte(ctx, o, 48);
        return em_u32(ctx, o, cnum);
    }
    return em_u32(ctx, o, cnum);
}

/// `--short`：**一行一条**，形状 `file:line:col: error[E002]: message` —— 与 GCC / clang
/// 那一族同一个惯例，所以编辑器不用任何配置就能按 `文件:行:列` 跳过去。
/// 消息里的换行**折成一个空格**：不折的话一条诊断变成两三行，"一行一条"这个承诺就破了。
fn rec_short(ctx: ptr, line: u32, col: u32, mlen: u32, plen: u32, clen: u32) -> u32 {
    let o: u32 = 0;
    let k: u32 = 0;
    while k < plen {
        o = em_byte(ctx, o, load8(ctx, C_PATH + k));
        k = k + 1;
    }
    // `line == 0` = 编译器没有位置（`E031`..`E033`：文件读不到 / 写不出去 / 单元太大）。
    // 那时只印文件名 —— `x.lomt:0: error[...]` 里那个 0 会被编辑器当成第 0 行。
    // 与 `h_loc` 同一条口径。
    if line > 0 {
        o = em_byte(ctx, o, COLON);
        o = em_u32(ctx, o, line);
    }
    // `col == 0` = 编译器只给了行号（`check()` 的语义诊断都是这样）。**那时不印列** ——
    // 与 `h_loc` 同一条纪律：`x.lomt:9:0:` 会让编辑器按第 0 列跳，那是编出来的位置。
    if col > 0 {
        o = em_byte(ctx, o, COLON);
        o = em_u32(ctx, o, col);
    }
    o = em(ctx, o, ": error[");
    let j: u32 = 0;
    while j < clen {
        o = em_byte(ctx, o, load8(ctx, C_CODE + j));
        j = j + 1;
    }
    o = em(ctx, o, "]: ");
    let m: u32 = 0;
    while m < mlen {
        let c: u32 = load8(ctx, C_MSG + m);
        if c == NL {
            o = em_byte(ctx, o, SP);
        } else {
            o = em_byte(ctx, o, c);
        }
        m = m + 1;
    }
    return em_byte(ctx, o, NL);
}

/// `--json`：**一行一个对象**（JSONL，与编译器 `--diag-out` 吐进来的形状同族，只是多了
/// 卡片那几个字段）。逐行而不是一个大数组：调用方可以流式读，也不必为逗号记账。
fn rec_json(ctx: ptr, cnum: u32, clen: u32, line: u32, col: u32, mlen: u32, plen: u32) -> u32 {
    let o: u32 = em(ctx, 0, "{\"code\":");
    o = json_span(ctx, o, ptr_add(ctx, C_CODE), clen);
    o = em(ctx, o, ",\"title\":");
    o = json_str(ctx, o, code_title(cnum, lg(ctx)));
    o = em(ctx, o, ",\"file\":");
    o = json_span(ctx, o, ptr_add(ctx, C_PATH), plen);
    o = em(ctx, o, ",\"line\":");
    o = em_u32(ctx, o, line);
    o = em(ctx, o, ",\"col\":");
    o = em_u32(ctx, o, col);
    o = em(ctx, o, ",\"message\":");
    o = json_span(ctx, o, ptr_add(ctx, C_MSG), mlen);
    o = em(ctx, o, ",\"what\":");
    o = json_str(ctx, o, code_what(cnum, lg(ctx)));
    o = em(ctx, o, ",\"why\":");
    o = json_str(ctx, o, code_why(cnum, lg(ctx)));
    o = em(ctx, o, ",\"fixes\":[");
    let n: u32 = code_nfix(cnum);
    let i: u32 = 0;
    while i < n {
        if i > 0 {
            o = em_byte(ctx, o, 44);
        }
        o = json_str(ctx, o, code_fix(cnum, i, lg(ctx)));
        i = i + 1;
    }
    o = em(ctx, o, "],\"yes\":");
    o = json_str(ctx, o, code_yes(cnum, lg(ctx)));
    o = em(ctx, o, ",\"no\":");
    o = json_str(ctx, o, code_no(cnum, lg(ctx)));
    // 建议也进 JSON —— 这是 `--json` 存在的理由：给编辑器一份**能直接应用**的东西。
    // 形状抄 rustc 的 `--error-format=json`：`message` 说这是什么、`replacement` 给换成什么、
    // `byte_start`/`byte_end` 圈住换哪儿、`applicability` 说这个建议有多可信
    // （`MaybeIncorrect` = 按编辑距离猜的，与 rustc 对同类建议的判定同名同义）。
    o = em(ctx, o, ",\"suggestions\":[");
    let cn: u32 = load32(ctx, C_CANDN);
    let k: u32 = 0;
    while k < cn {
        if k > 0 {
            o = em_byte(ctx, o, COMMA);
        }
        o = em_byte(ctx, o, LBRACE);
        o = em(ctx, o, "\"message\":");
        o = em_byte(ctx, o, QUOTE);
        o = json_add(ctx, o, ui(ctx, S_SUG_ONE_A));
        o = json_add(ctx, o, kind_name(ctx, load32(ctx, C_CANDKD + k * 4)));
        o = json_add(ctx, o, ui(ctx, S_SUG_ONE_B));
        o = em_byte(ctx, o, QUOTE);
        o = em(ctx, o, ",\"kind\":");
        o = json_str(ctx, o, kind_key(load32(ctx, C_CANDKD + k * 4)));
        // **换成什么**：只有位置（`byte_*`）没有内容，编辑器没法应用 —— 它得知道往那片字节里
        // 写什么。这一格与 `byte_*` 是一对（rustc 那边叫 `suggested_replacement`）。
        o = em(ctx, o, ",\"replacement\":");
        o = json_span(ctx, o, ptr_add(ctx, C_CAND + k * SUG_NAME),
                      load32(ctx, C_CANDNL + k * 4));
        o = em(ctx, o, ",\"line\":");
        o = em_u32(ctx, o, load32(ctx, C_CANDLN + k * 4));
        // **字节偏移只在那个词于本文件里全局唯一时才给**：给一个指错位置的偏移，
        // 编辑器会照着它去改用户的代码 —— 那比不给坏得多。字段缺席 = "这一条别自动应用"，
        // 与 rustc 那边 `applicability: Unspecified` 是同一个意思。
        if cn == 1 && load32(ctx, C_TOKOFF) != 4294967295 {
            o = em(ctx, o, ",\"byte_start\":");
            o = em_u32(ctx, o, load32(ctx, C_TOKOFF));
            o = em(ctx, o, ",\"byte_end\":");
            o = em_u32(ctx, o, load32(ctx, C_TOKOFF) + load32(ctx, C_TOKLEN));
        }
        o = em(ctx, o, ",\"applicability\":");
        o = json_str(ctx, o, "MaybeIncorrect");
        o = em_byte(ctx, o, RBRACE);
        k = k + 1;
    }
    o = em_byte(ctx, o, RBRACK);
    o = em_byte(ctx, o, RBRACE);
    return em_byte(ctx, o, NL);
}

// ---------------------------------------------------------------- 汇总

/// 汇总记一笔。**按码去重**，同一个码只占一格、条数累加。
/// 表满（64 格）就不再记新的：码只有 E1..E23 这一段，64 格够；真满了顶多少列一个码，
/// 不会把条数算错（总数是另外数的）。
fn sum_add(ctx: ptr, cnum: u32) {
    let n: u32 = load32(ctx, C_SUMN);
    let i: u32 = 0;
    let hit: u32 = 0;
    while i < n {
        if load32(ctx, C_SUMK + i * 4) == cnum {
            store32(ctx, C_SUMV + i * 4, load32(ctx, C_SUMV + i * 4) + 1);
            hit = 1;
            i = n;
        } else {
            i = i + 1;
        }
    }
    if hit == 0 && n < SUM_CAP {
        store32(ctx, C_SUMK + n * 4, cnum);
        store32(ctx, C_SUMV + n * 4, 1);
        store32(ctx, C_SUMN, n + 1);
    }
}

/// 打汇总行：`12 errors: E002 x9, E019 x2, E023 x1`。
///
/// **按条数降序**（并列时码号小的在前）——它回答的是"**先修哪个**"。这正是汇总比总数
/// 多出来的那点信息：`12 条错误` 不告诉你 12 条里有 9 条是同一个原因（那种时候改一处
/// 就消掉九条，而按出现顺序修会白改八次）。
/// 选择排序，直接在汇总表上换 —— 表最多 64 格，而这段跑一次。
fn sum_print(ctx: ptr, total: u32) -> u32 {
    let n: u32 = load32(ctx, C_SUMN);
    let i: u32 = 0;
    while i < n {
        let best: u32 = i;
        let j: u32 = i + 1;
        while j < n {
            let vj: u32 = load32(ctx, C_SUMV + j * 4);
            let vb: u32 = load32(ctx, C_SUMV + best * 4);
            if vj > vb {
                best = j;
            } else {
                if vj == vb && load32(ctx, C_SUMK + j * 4) < load32(ctx, C_SUMK + best * 4) {
                    best = j;
                }
            }
            j = j + 1;
        }
        if best != i {
            let tk: u32 = load32(ctx, C_SUMK + i * 4);
            let tv: u32 = load32(ctx, C_SUMV + i * 4);
            store32(ctx, C_SUMK + i * 4, load32(ctx, C_SUMK + best * 4));
            store32(ctx, C_SUMV + i * 4, load32(ctx, C_SUMV + best * 4));
            store32(ctx, C_SUMK + best * 4, tk);
            store32(ctx, C_SUMV + best * 4, tv);
        }
        i = i + 1;
    }
    let o: u32 = em_u32(ctx, 0, total);
    let o1: u32 = em_col(ctx, o, "1;31");
    let o2: u32 = em(ctx, o1, ui(ctx, S_SUM));
    // 复位在**展开明细之前**：明细是要拿去比的（`E002` 与条数），整段染红会把它们压得
    // 看不清 —— 上色只给"总数"那一下。
    let head: u32 = em_rst(ctx, o2);
    let k: u32 = 0;
    let acc: u32 = head;
    while k < n {
        if k > 0 {
            acc = em_byte(ctx, acc, COMMA);
            acc = em_byte(ctx, acc, SP);
        }
        acc = em_code(ctx, acc, load32(ctx, C_SUMK + k * 4));
        acc = em(ctx, acc, ui(ctx, S_SUM_X));
        acc = em_u32(ctx, acc, load32(ctx, C_SUMV + k * 4));
        k = k + 1;
    }
    return em_byte(ctx, acc, NL);
}

// ---------------------------------------------------------------- 「你是不是想写 X」
//
// E002 最常见的成因就是**拼错一个名字**，而通用建议（"补类型标注 / 改拼写"）帮不到
// 具体这一个。所以这里扫一遍**本文件里已声明的名字**，给一个近似候选。
//
// 四条门槛，**全都在"宁可不猜"这一侧**：
//
//   * 距离 ≤ 2（打错一个字符、或者漏/多一个）；
//   * 候选**必须唯一** —— 有两个一样近的就不说。**说错比不说坏得多**：用户会照着它改，
//     而那是把一份本来能编的代码改坏；
//   * 线索短于 3 个字符不猜（`aa` 与 `ab` 只差一个字符，猜了等于没猜）；
//   * 候选名本身也要 ≥3 个字符（1-2 个字符的名字几乎不可能是"想写的那一个"）。
//
// 已知的粗糙处（如实记）：扫的是**词法形状**，不认注释与字符串 —— 注释里写一句
// `// let util2 be zero` 会多出一个候选。影响是双向的，而**两个方向都是保守的**：
// 噪声候选要成为建议，得**恰好唯一**地落在距离 ≤2 上（那意味着注释里那个名字与线索
// 本来就极像）；更多时候它只是制造一个并列，于是我们不说。为这点噪声写一个词法器不值。

const DECL_KW: u32 = 7;

/// 会**引入一个新名字**的那几个关键字。`pub` / `use` / `impl` 故意不收：它们后面跟的
/// 不是新名字（`impl M for S` 引入的是既有类型），收进来就是把噪声当候选。
fn decl_kw(i: u32) -> str {
    if i == 0 { return "fn"; }
    if i == 1 { return "let"; }
    if i == 2 { return "const"; }
    if i == 3 { return "struct"; }
    if i == 4 { return "enum"; }
    if i == 5 { return "trait"; }
    if i == 6 { return "capability"; }
    return "";
}

/// `i` 处正好是一个**整词**的关键字吗？是就返回它**后面**的位置，不是返回 `0xFFFFFFFF`。
/// 左边界也要查：`leftover` 里那个 `let` 不是 `let`。
fn decl_kw_at(ctx: ptr, sr: ptr, srl: u32, i: u32) -> u32 {
    if i > 0 && is_word(load8(sr, i - 1)) == true {
        return 4294967295;
    }
    let k: u32 = 0;
    while k < DECL_KW {
        let w: str = decl_kw(k);
        let wn: u32 = str_len(w);
        if i + wn <= srl {
            let same: u32 = 1;
            let j: u32 = 0;
            while j < wn && same == 1 {
                if load8(sr, i + j) != str_byte(w, j) {
                    same = 0;
                }
                j = j + 1;
            }
            if same == 1 && (i + wn == srl || is_word(load8(sr, i + wn)) == false) {
                store32(ctx, C_KIND, k + 1);
                return i + wn;
            }
        }
        k = k + 1;
    }
    return 4294967295;
}

/// 编辑距离，超过 `NAME_MAX` 的名字直接给 99（= "差得远"）。
/// 两行滚动数组：第 0 行在 `row+0`、第 1 行在 `row+ROW_STRIDE`。
fn edit_dist(a: ptr, an: u32, b: ptr, bn: u32, row: ptr) -> u32 {
    if an > NAME_MAX || bn > NAME_MAX {
        return 99;
    }
    let j: u32 = 0;
    while j <= bn {
        store32(row, j * 4, j);
        j = j + 1;
    }
    let i: u32 = 1;
    while i <= an {
        store32(row, ROW_STRIDE, i);
        let jj: u32 = 1;
        while jj <= bn {
            let sub: u32 = load32(row, (jj - 1) * 4) + 1;
            if load8(a, i - 1) == load8(b, jj - 1) {
                sub = load32(row, (jj - 1) * 4);
            }
            let del: u32 = load32(row, jj * 4) + 1;
            let ins: u32 = load32(row, ROW_STRIDE + (jj - 1) * 4) + 1;
            let m: u32 = sub;
            if del < m {
                m = del;
            }
            if ins < m {
                m = ins;
            }
            store32(row, ROW_STRIDE + jj * 4, m);
            jj = jj + 1;
        }
        jj = 0;
        while jj <= bn {
            store32(row, jj * 4, load32(row, ROW_STRIDE + jj * 4));
            jj = jj + 1;
        }
        i = i + 1;
    }
    return load32(row, bn * 4);
}

/// 偏移在第几行（从 1 数）。
fn line_of(sr: ptr, off: u32) -> u32 {
    let n: u32 = 1;
    let i: u32 = 0;
    while i < off {
        if load8(sr, i) == NL {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 在候选表里挪一格（`dst <- src`）：名字 + 四个标量一起搬。
fn sug_copy(ctx: ptr, dst: u32, src: u32) -> u32 {
    let k: u32 = 0;
    while k < SUG_NAME {
        store8(ctx, C_CAND + dst * SUG_NAME + k, load8(ctx, C_CAND + src * SUG_NAME + k) as u8);
        k = k + 1;
    }
    store32(ctx, C_CANDNL + dst * 4, load32(ctx, C_CANDNL + src * 4));
    store32(ctx, C_CANDLN + dst * 4, load32(ctx, C_CANDLN + src * 4));
    store32(ctx, C_CANDKD + dst * 4, load32(ctx, C_CANDKD + src * 4));
    store32(ctx, C_CANDDS + dst * 4, load32(ctx, C_CANDDS + src * 4));
    return dst;
}

/// 把一个候选插进那张小表：表按 `(距离, 源码先后)` 升序，**有界**（`SUG_CAP` 格）。
/// 表满了而新来的更差就丢掉 —— 所以"最近的三条"是排出来的，不是碰巧捡到的三条。
/// **同名只收一次**（不同作用域可以有同名局部变量，那不是另一个候选）。
fn sug_put(ctx: ptr, sr: ptr, off: u32, len: u32, d: u32, n: u32) -> u32 {
    if len > SUG_NAME {
        return n;
    }
    let t: u32 = 0;
    while t < n {
        if load32(ctx, C_CANDNL + t * 4) == len {
            if bytes_eq(ptr_add(ctx, C_CAND + t * SUG_NAME), len, ptr_add(sr, off), len) == true {
                return n;
            }
        }
        t = t + 1;
    }
    let ins: u32 = n;
    let t2: u32 = 0;
    let stop: u32 = 0;
    while t2 < n && stop == 0 {
        if d < load32(ctx, C_CANDDS + t2 * 4) {
            ins = t2;
            stop = 1;
        } else {
            t2 = t2 + 1;
        }
    }
    if ins >= SUG_CAP {
        return n;
    }
    let hi: u32 = n;
    if hi > SUG_CAP - 1 {
        hi = SUG_CAP - 1;
    }
    let mv: u32 = hi;
    while mv > ins {
        sug_copy(ctx, mv, mv - 1);
        mv = mv - 1;
    }
    let k: u32 = 0;
    while k < len {
        store8(ctx, C_CAND + ins * SUG_NAME + k, load8(sr, off + k) as u8);
        k = k + 1;
    }
    store32(ctx, C_CANDNL + ins * 4, len);
    store32(ctx, C_CANDLN + ins * 4, line_of(sr, off));
    store32(ctx, C_CANDKD + ins * 4, load32(ctx, C_KIND));
    store32(ctx, C_CANDDS + ins * 4, d);
    if n < SUG_CAP {
        return n + 1;
    }
    return n;
}

/// 扫本文件已声明的名字，按**距离近的在前**收最多 `SUG_CAP` 个候选（距离 <= 2），
/// 结果落在 `C_CAND*` 那几张表里，条数进 `C_CANDN`。
///
/// 一趟扫完、边扫边插（见 `sug_put`）：两趟要多做一遍词法扫描加一遍 `edit_dist`，
/// 而在一张 3 格的表上排序插入就是挪两下。
///
/// **与旧版（只留最优、并列就闭嘴）的差别是有意的**：抄了 Ruby 的 `did_you_mean` 与
/// rustc 的 children 之后，并列**不必**二选一（抛硬币 or 闭嘴）—— 列出来让用户挑，
/// 还顺手说清每个候选是什么、在哪一行。闭嘴只在"一个都不像"时才是对的。
///
/// 已知的粗糙处（与旧版同一处，如实记）：扫的是**词法形状**，不认注释与字符串。
/// 影响是双向的、而且两个方向都偏保守：噪声要成为候选得真的落在距离 <= 2 上。
fn sug_collect(ctx: ptr, sr: ptr, srl: u32, hp: ptr, hn: u32) -> u32 {
    store32(ctx, C_CANDN, 0);
    if hn < 3 || hn > NAME_MAX {
        return 0;
    }
    let row: ptr = ptr_add(ctx, C_ROW);
    let n: u32 = 0;
    let i: u32 = 0;
    while i < srl {
        let kw: u32 = decl_kw_at(ctx, sr, srl, i);
        if kw == 4294967295 {
            i = i + 1;
        } else {
            let s: u32 = skip_blank(sr, kw, srl);
            let p: u32 = s;
            while p < srl && is_word(load8(sr, p)) == true {
                p = p + 1;
            }
            if p - s >= 3 {
                let d: u32 = edit_dist(ptr_add(sr, s), p - s, hp, hn, row);
                if d <= 2 {
                    n = sug_put(ctx, sr, s, p - s, d, n);
                }
            }
            if p > i {
                i = p;
            } else {
                i = i + 1;
            }
        }
    }
    store32(ctx, C_CANDN, n);
    return n;
}

/// 候选**是什么**（存的是 `decl_kw` 的下标 + 1；0 = 不知道）。
/// 抄 rustc 的 "a local variable with a similar name exists"：只说一个名字，用户还得自己去
/// 找它在哪、是干什么的；说了种类，一眼就知道该不该照它改。
fn kind_name(ctx: ptr, kd: u32) -> str {
    if kd == 1 { return ui(ctx, S_KIND_FN); }
    if kd == 2 { return ui(ctx, S_KIND_LET); }
    if kd == 3 { return ui(ctx, S_KIND_CONST); }
    if kd == 4 { return ui(ctx, S_KIND_STRUCT); }
    if kd == 5 { return ui(ctx, S_KIND_ENUM); }
    if kd == 6 { return ui(ctx, S_KIND_TRAIT); }
    if kd == 7 { return ui(ctx, S_KIND_CAP); }
    return "";
}

/// 候选的**机器可读**写法（JSON 的 `kind`）：存的是关键字本身（`fn` / `let` / ...），
/// 不是给人看的那句译文 —— 程序不该去认"一个函数"这种叙述。0 = 不知道。
fn kind_key(kd: u32) -> str {
    if kd >= 1 && kd <= DECL_KW {
        return decl_kw(kd - 1);
    }
    return "";
}

/// 印**改好的那一行**：行号 + ` | ` + 前缀 + 候选名 + 后缀，下面再用插入符点在**新名字**上。
///
/// 这是抄 rustc 的 `help:` —— 它连那个 `+` 都画出来。人拿到的是一行**能抄的代码**，
/// 而不是一句"你是不是想写 X"：后者还得自己在脑子里做替换，而替换正是最容易再错一次的地方。
///
/// **只在那名字于本文件里恰好出现一次时印**（`C_TOKOFF` 不是 0xFFFFFFFF）：出现两次以上
/// 就指不准该改哪一处，那时只按名字给候选（见 `h_sug` 的分支）。宁可少给一行，
/// 也不给一行改错地方的建议。
fn h_fixline(ctx: ptr, o: u32, sr: ptr, srl: u32, w: u32) -> u32 {
    let off: u32 = load32(ctx, C_TOKOFF);
    if off == 4294967295 {
        return o;
    }
    let tl: u32 = load32(ctx, C_TOKLEN);
    if tl == 0 || off + tl > srl {
        return o;
    }
    let line: u32 = line_of(sr, off);
    let sp: u64 = line_span(sr, srl, line);
    if sp == 18446744073709551615 as u64 {
        return o;
    }
    let ls: u32 = (sp / 4294967296) as u32;
    let ln: u32 = (sp % 4294967296) as u32;
    if off < ls || off + tl > ls + ln {
        return o;
    }
    let col: u32 = off - ls;
    let nl: u32 = load32(ctx, C_CANDNL);
    if nl == 0 {
        return o;
    }
    o = em_u32(ctx, o, line);
    o = em(ctx, o, " | ");
    let k: u32 = 0;
    while k < col {
        o = em_byte(ctx, o, load8(sr, ls + k));
        k = k + 1;
    }
    let j: u32 = 0;
    while j < nl {
        o = em_byte(ctx, o, load8(ctx, C_CAND + j));
        j = j + 1;
    }
    let m: u32 = col + tl;
    while m < ln {
        o = em_byte(ctx, o, load8(sr, ls + m));
        m = m + 1;
    }
    o = em_byte(ctx, o, NL);
    o = em_gut(ctx, o, w);
    let q: u32 = 0;
    while q < col {
        o = em_byte(ctx, o, SP);
        q = q + 1;
    }
    o = em_col(ctx, o, "1;32");
    let r: u32 = 0;
    while r < nl {
        o = em_byte(ctx, o, CARET);
        r = r + 1;
    }
    o = em_rst(ctx, o);
    return em_byte(ctx, o, NL);
}

/// 把候选打出来。**只有 `sug_collect` 收了东西才会被调到** —— 一个都不像就不出声，
/// 而不是打一句"没猜出来"（那种句子只会占地方）。
///
/// **恰好一个** → 印改好的那一行（`h_fixline`）；**多个** → 一行一个列出来，
/// 并说清每个是什么、在哪一行。第二条是这一轮加的：旧版并列就闭嘴，那是**我没有更好的
/// 办法**时的保守；有了候选表之后，更好的路是**列出来让用户挑** —— 既不抛硬币，
/// 也不把"有两个可能"这个事实瞒掉。
fn h_sug(ctx: ptr, o: u32, sr: ptr, srl: u32, w: u32) -> u32 {
    let n: u32 = load32(ctx, C_CANDN);
    if n == 0 {
        return o;
    }
    o = em_gut(ctx, o, w);
    o = em_col(ctx, o, "1;36");
    o = em(ctx, o, ui(ctx, S_HELP));
    o = em_rst(ctx, o);
    if n == 1 {
        o = em(ctx, o, ui(ctx, S_SUG_ONE_A));
        o = em(ctx, o, kind_name(ctx, load32(ctx, C_CANDKD)));
        o = em(ctx, o, ui(ctx, S_SUG_ONE_B));
        o = em_byte(ctx, o, NL);
        return h_fixline(ctx, o, sr, srl, w);
    }
    o = em(ctx, o, ui(ctx, S_SUG_MANY));
    o = em_byte(ctx, o, NL);
    let k: u32 = 0;
    while k < n {
        o = em_gut(ctx, o, w);
        o = em(ctx, o, ui(ctx, S_SUG_ITEM_PRE));
        let ln: u32 = load32(ctx, C_CANDNL + k * 4);
        let j: u32 = 0;
        while j < ln {
            o = em_byte(ctx, o, load8(ctx, C_CAND + k * SUG_NAME + j));
            j = j + 1;
        }
        o = em(ctx, o, ui(ctx, S_SUG_ITEM_OPEN));
        o = em(ctx, o, kind_name(ctx, load32(ctx, C_CANDKD + k * 4)));
        o = em(ctx, o, ui(ctx, S_SUG_ITEM_LINE));
        o = em_u32(ctx, o, load32(ctx, C_CANDLN + k * 4));
        o = em(ctx, o, ui(ctx, S_SUG_ITEM_CLOSE));
        o = em_byte(ctx, o, NL);
        k = k + 1;
    }
    return o;
}


// ---------------------------------------------------------------- E018: 手上有什么
//
// `use <名字>` 解析不出来时，**光说"补文件"没有用** —— 用户不知道补到哪，也不知道自己
// 手上已经有什么。所以这里把**真实情况**说出来：
//
//   * `./deps` 打不开（单文件项目最常见的那种）→ 明说"这里没有 deps/"，并把第 1 层找的
//     是什么路径写清楚。这条**不需要 getdents64**：`openat` 失败本身就是答案。
//   * `./deps` 打得开 → 把里面**名字接近**的那几个列出来（距离 ≤2，最多 5 个）。
//
// **为什么不列"诊断文件所在的那个目录"**：`use <名字>` 从来不在文件旁边找东西 ——
// 按层搜的第 1 层是**项目根**下的 `deps/<名字>/<名字>.lomt`。列文件旁边的目录会给出一个
// 看着相关、其实无关的清单，那比不说更坏。项目根 = **当前工作目录**（启动器就是这样
// 进来的），与 `errconfig`、`loment.conf` 用的是同一个"哪算项目根"。

const DEPS_CAP: u32 = 5;

/// NUL 结尾字符串的长度（`getdents64` 的 `d_name` 是 NUL 结尾的，没有长度字段）。
fn nlen(p: ptr) -> u32 {
    let i: u32 = 0;
    while load8(p, i) != 0 {
        i = i + 1;
    }
    return i;
}

/// 名字里第一个 `.` 之前有多长（后缀不算名字的一部分）。
fn stem_n(p: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let go: u32 = 1;
    while i < n && go == 1 {
        if load8(p, i) == DOT {
            go = 0;
        } else {
            i = i + 1;
        }
    }
    return i;
}

/// 列一个候选。第一个自带"最接近的有:"那句，其余各占一行 ——
/// **不用逗号分隔**：最后一个后面会多出一个逗号，那种尾巴一看就是程序硬拼的。
fn h_cand_one(ctx: ptr, o: u32, w: u32, first: u32, np: ptr, nl: u32) -> u32 {
    if first == 1 {
        o = em_gut(ctx, o, w);
        o = em_col(ctx, o, "1");
        o = em(ctx, o, ui(ctx, S_CANDS));
        o = em_rst(ctx, o);
    }
    o = em_gut(ctx, o, w);
    o = em(ctx, o, "    ");
    let i: u32 = 0;
    while i < nl {
        o = em_byte(ctx, o, load8(np, i));
        i = i + 1;
    }
    return em_byte(ctx, o, NL);
}

/// 找 `./deps` 里与线索接近的名字。`dn` 是 32 KB 暂存（既当路径暂存又当 `getdents64` 缓冲）。
/// `hp` / `hn` 是线索（指向 `C_MSG`）。
fn h_cands(ctx: ptr, o: u32, w: u32, dn: ptr, hp: ptr, hn: u32) -> u32 {
    let name: str = "./deps";
    let fd: i64 = open_ro(str_ptr(name), str_len(name), dn);
    if fd < 0 {
        o = em_gut(ctx, o, w);
        return em(ctx, o, ui(ctx, S_NODEPS));
    }
    let row: ptr = ptr_add(ctx, C_ROW);
    let n: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        let rn: i64 = syscall4(217, fd as u64, dn as u64, DENT_CAP as u64);
        if rn <= 0 {
            going = 0;
        } else {
            let total: u32 = rn as u32;
            let off: u32 = 0;
            while off < total {
                let reclen: u32 = load16(dn, off + 16);
                if reclen == 0 {
                    off = total;
                } else {
                    let np: ptr = ptr_add(dn, off + 19);
                    let nl: u32 = nlen(np);
                    // 前导 `.` 把 `.` / `..` / 隐藏项一起排除（没有哪个模块叫 `.foo`）。
                    if nl > 1 && load8(np, 0) != DOT && n < DEPS_CAP {
                        if edit_dist(np, stem_n(np, nl), hp, hn, row) <= 2 {
                            n = n + 1;
                            o = h_cand_one(ctx, o, w, n, np, nl);
                        }
                    }
                    off = off + reclen;
                }
            }
            if n >= DEPS_CAP {
                going = 0;
            }
        }
    }
    syscall4(3, fd as u64, 0, 0);
    if n == 0 {
        o = em_gut(ctx, o, w);
        return em(ctx, o, ui(ctx, S_CANDS_NONE));
    }
    return o;
}

/// 结尾那一行 explain 指针（抄 rustc 的「For more information about an error, try
/// `rustc --explain E0318`.」）。
///
/// **它把"这一条还有详解"变成一条能敲的命令** —— 而且这条命令是真的：`loment explain E4`
/// 早就在 `lomcli` 里（23 个码各有一句话说清"要你做什么"）。所以这一行不是画饼，
/// 是**接上一件已经存在的东西**；文档里那一句"把 `--json` 接到 `explain`"也就落了地。
///
/// 子代理实测 8 门语言：**没有一门**在给人看的输出里给出能点的文档入口 —— rustc 只给命令，
/// C# 的 `helpUri` 只进 SARIF（机器才看得到）。所以这一格是照**最好**的那个抄的。
fn h_more(ctx: ptr) -> u32 {
    let n: u32 = load32(ctx, C_SUMN);
    if n == 0 {
        return 0;
    }
    let acc: u32 = em(ctx, 0, ui(ctx, S_MORE));
    let k: u32 = 0;
    while k < n {
        if k > 0 {
            acc = em_byte(ctx, acc, SP);
        }
        acc = em_code(ctx, acc, load32(ctx, C_SUMK + k * 4));
        k = k + 1;
    }
    return em_byte(ctx, acc, NL);
}

// ---------------------------------------------------------------- 入口

fn _start() -> u32 {
    let ctxv: u64 = sys_alloc(CTX_CAP as u64);
    let dgv: u64 = sys_alloc(DIAG_CAP as u64);
    let srv: u64 = sys_alloc(SRC_CAP as u64);
    let arv: u64 = sys_alloc(ARENA_CAP as u64);
    let scv: u64 = sys_alloc(SCR_CAP as u64);
    let abv: u64 = sys_alloc(65536);
    let dnv: u64 = sys_alloc(DENT_CAP as u64);
    if ctxv == 0 || dgv == 0 || srv == 0 || arv == 0 || scv == 0 || abv == 0 || dnv == 0 {
        return fail("lomenterr: brk failed\n");
    }
    let ctx: ptr = ctxv as ptr;
    let dg: ptr = dgv as ptr;
    let sr: ptr = srv as ptr;
    let ar: ptr = arv as ptr;
    let sc: ptr = scv as ptr;
    let ab: ptr = abv as ptr;
    let dn: ptr = dnv as ptr;
    store32(ctx, C_PREVLEN, 0);
    store32(ctx, C_SRCLEN, 0);
    store32(ctx, C_FPREVLEN, 0);
    store32(ctx, C_TRUNC, 0);
    store32(ctx, C_CANDN, 0);
    store32(ctx, C_SUMN, 0);
    // 颜色**默认开**（与 `lomcli` 同一个默认值）；`--no-color` / `-C` 把它关掉，
    // 而 `parse_args` 同时把诊断文件那个参数抄进 `scr + SCR_DIAG`。
    store32(ctx, C_COLOR, 1);
    // **语言默认英文**。写死在这里而不是靠 `cfg_load` —— 没配 errconfig 时那条路根本
    // 不会走到，默认值也就没有第二处可写（两处迟早不同）。
    store32(ctx, C_LANG, 0);
    store32(ctx, C_MODE, 0);
    // 渲染条数的上限：**在 `parse_args` 之前**写下默认值，`--max` 才有东西可覆盖
    // （顺序反了就是"没给 --max 时读到一个没初始化的格子"）。
    store32(ctx, C_MAX, MAX_DEFAULT);

    let av: u64 = parse_args(ctx, ab, sc);
    // `lomenterr version` —— 打完就退 0。**趁早**：它压根没有诊断文件，不在这儿收，
    // 就会一路走到下面的用法报错（而"用法不对"不是用户此刻的处境）。
    // 也**故意不先读 errconfig**：这一行是程序名 + 版本号，两门语言同形，与语言无关。
    if load32(ctx, C_WANTVER) == 1 {
        let o: u32 = em(ctx, 0, ui(ctx, S_VER));
        let o2: u32 = em(ctx, o, lomenterr_version());
        // **走 stdout**（这个程序别处一律 fd 2）：这一行**不是诊断**，是"你是谁"。
        // 脚本要 `v=$(lomenterr version)` 拿它，而 fd 2 抓不到 —— 报错器把唯一一条
        // "给程序读"的输出放 stdout，这是一个**有意的例外**，不是漏改。
        write_all(1, ctx, em_byte(ctx, o2, NL) as u64);
        return die(0);
    }
    // 语言在**用法报错之前**定下来：否则 `lomenterr` 自己用法写错时那句提示是一种语言、
    // 而诊断是另一种，"同一份输出里两种语言"就是这么来的。
    cfg_load(ctx, ab, sc);
    if av == 0 {
        return fail(ui(ctx, S_USAGE));
    }
    let ap: ptr = ptr_add(sc, (av >> 32) as u32);
    let an: u32 = (av % 4294967296) as u32;
    let fd: i64 = open_ro(ap, an, sc);
    if fd < 0 {
        return fail(ui(ctx, S_NOOPEN));
    }
    let dlen: u32 = strip_cr(dg, read_all(fd as u64, dg, DIAG_CAP as u64) as u32);
    syscall4(3, fd as u64, 0, 0);

    let total: u32 = 0;
    // `total` 是"一共几条"、`shown` 是"渲染了几条"、`skipped` 是"到上限后还剩几条没渲染"。
    // 三个都要真：汇总行说的是**一共**（用户要知道总量），而"没渲染"这件事得**说出来**。
    let shown: u32 = 0;
    let skipped: u32 = 0;
    let broken: u32 = 0;
    let i: u32 = 0;
    while i < dlen {
        let s: u32 = i;
        while i < dlen && load8(dg, i) != NL {
            i = i + 1;
        }
        let e: u32 = i;
        if i < dlen {
            i = i + 1;
        }
        if line_blank(dg, s, e) == 0 {
            let js: ptr = ptr_add(dg, s);
            let root: u32 = json_parse(js, e - s, ar);
            if root == 4294967295 {
                // **不静默**: 解析不了就原样吐出来 —— 悄悄跳过会让"报错器什么都没说"
                // 看起来像"没有错误"。
                broken = broken + 1;
                let o1: u32 = em(ctx, 0, ui(ctx, S_BADLINE));
                let k: u32 = s;
                let o2: u32 = o1;
                while k < e {
                    o2 = em_byte(ctx, o2, load8(dg, k));
                    k = k + 1;
                }
                write_all(2, ctx, em(ctx, o2, "\n") as u64);
            } else {
                let clen: u32 = str_field(js, ar, json_get(js, ar, root, "code"),
                                          ctx, C_CODE, CODE_CAP);
                let cnum: u32 = code_num(ctx, C_CODE, clen);
                let line: u32 = num_raw(js, ar, json_get(js, ar, root, "line"));
                let col: u32 = num_raw(js, ar, json_get(js, ar, root, "col"));
                let mlen: u32 = str_field(js, ar, json_get(js, ar, root, "message"),
                                          ctx, C_MSG, MSG_CAP);
                let plen: u32 = str_field(js, ar, json_get(js, ar, root, "file"),
                                          ctx, C_PATH, PATH_CAP);
                // **建议与位置都在模式分岔之前算**：`--json` 也要它们（编辑器要的是能直接
                // 切片的偏移），而那是"这条诊断的事实"，不是"哪个出口在渲染"的性质。
                // `--short` 例外 —— 它连源文件都不读（见下）。
                sum_add(ctx, cnum);
                let mode: u32 = load32(ctx, C_MODE);
                let have: u32 = 0;
                if mode != 1 {
                    have = src_ensure(ctx, sr, sc, plen);
                }
                let srl: u32 = load32(ctx, C_SRCLEN);
                store32(ctx, C_CANDN, 0);
                store32(ctx, C_TOKOFF, 4294967295);
                store32(ctx, C_TOKLEN, 0);
                let hint: u64 = 18446744073709551615 as u64;
                if have == 1 {
                    // 名字从**源文件**里取（`msg_hint` 现在拿源当裁判，见它自己的说明）：
                    // 一个词在本文件里整词恰好出现一次，我们才知道"该改哪一处"。
                    // 那条规则同时管住了插入符与建议：它俩找的是同一个词。
                    hint = msg_hint(sr, 0, srl, ptr_add(ctx, C_MSG), mlen);
                }
                if hint != 18446744073709551615 as u64 {
                    let at: u32 = (hint >> 32) as u32;
                    let hlen: u32 = (hint % 4294967296) as u32;
                    store32(ctx, C_TOKOFF, at);
                    store32(ctx, C_TOKLEN, hlen);
                    if cnum == 2 {
                        sug_collect(ctx, sr, srl, ptr_add(sr, at), hlen);
                    }
                }
                // **到了上限就不再渲染，但照样数**（见循环末尾）：上限抄的是 clang 的
                // `-ferror-limit` / Go 的 10 条 / javac 的 `-Xmaxerrs` —— 三家都默认设上限，
                // 理由一样：生成的代码一错就是几百条，逐条渲染几十行会把要看的东西顶出屏幕。
                let cap: u32 = load32(ctx, C_MAX);
                let draw: u32 = 1;
                // **`--json` 不受上限管**：上限是"别把人的屏幕顶爆"的装置，而机器出口
                // 没有屏幕 —— 那里少一条记录就是**静默丢数据**（下游按条数算的东西全错，
                // 而且它在 stderr 上看不到任何提示，因为 JSON 模式压根不打汇总与说明）。
                // clang 的 `-ferror-limit` 对 SARIF 也生效，但它是**编译器**停手、并且
                // 会打一条 fatal —— 我们这里没有那条路可走，所以宁可让 JSON 全给。
                if cap != 0 && shown >= cap && mode != 2 {
                    draw = 0;
                }
                if draw == 0 {
                    skipped = skipped + 1;
                } else {
                    shown = shown + 1;
                if mode == 1 {
                    // 一行一条：**不读源文件**（短输出只用到码/路径/消息），
                    // 所以 CI 里几万条诊断也不会有额外 I/O。
                    write_all(2, ctx, rec_short(ctx, line, col, mlen, plen, clen) as u64);
                } else {
                    if mode == 2 {
                        write_all(2, ctx, rec_json(ctx, cnum, clen, line, col, mlen, plen) as u64);
                    } else {
                        let w: u32 = dig_w(line);
                        store32(ctx, C_TRUNC, 0);
                        let o: u32 = h_head(ctx, 0, cnum, clen);
                        let o2: u32 = h_loc(ctx, o, line, col, w, plen);
                        let o3: u32 = o2;
                        // **没有位置就没有源码那一段**（`E031`..`E033` 全是这一类）。
                        // 三条都不要：不去源里找第 0 行 —— 那会印 "(no such line in the
                        // source file)"，读者会以为源码有问题；也不印 "(cannot read the
                        // source file)" —— `E032`/`E033` 的 `file` 正是一个**不该**被当成
                        // 源码读的产物路径。位置确实知道时才去源里切。
                        if line > 0 {
                            if have == 1 {
                                o3 = h_snip(ctx, o2, sr, load32(ctx, C_SRCLEN), line, col, w, mlen);
                            } else {
                                o3 = h_nosrc(ctx, o2, w, plen);
                            }
                        }
                        let o4: u32 = h_msg(ctx, o3, C_MSG, mlen, w);
                        // **外源那条提示顶到卡片前面，而且卡片整块不渲染**（`#29`）。
                        // 卡片那四段（what / why / 怎么改 / supported）讲的**全是 Loment 的
                        // 规矩**，而这份文件根本不是 Loment —— 原先它排在**最后**，读的人先
                        // 照着一屏不适用的"修法"把一份好 C 改坏，翻到底才看见那句
                        // "这个文件不是 Loment"。**说的那句才是对的**，所以它先出来，
                        // 而那四段**不再出现**（`h_foreign` 自带这门语言的边界与调用约定）。
                        let f_li: u32 = 4294967295;
                        if have == 1 && foreign_seen(ctx, plen) == 0 {
                            f_li = sniff_lang(ctx, sr, srl, cnum, plen);
                        }
                        let o6: u32 = 0;
                        if f_li != 4294967295 {
                            o6 = h_foreign(ctx, o4, f_li, w, plen);
                            foreign_remember(ctx, plen);
                        } else {
                            let o5: u32 = h_card(ctx, o4, cnum, w);
                            // 两条**码专属**的补充，排在卡片**之后** —— 先给通用的四段，
                            // 再给这一条的专属信息（它们的计算在模式分岔之前，见上）。
                            let o5b: u32 = o5;
                            if load32(ctx, C_CANDN) > 0 {
                                o5b = h_sug(ctx, o5, sr, srl, w);
                            } else {
                                if cnum == 18 && load32(ctx, C_TOKOFF) != 4294967295 {
                                    o5b = h_cands(ctx, o5, w, dn,
                                                  ptr_add(sr, load32(ctx, C_TOKOFF)),
                                                  load32(ctx, C_TOKLEN));
                                }
                            }
                            o6 = o5b;
                        }
                        write_all(2, ctx, em(ctx, o6, "\n") as u64);
                        if load32(ctx, C_TRUNC) == 1 {
                            let cut: str = ui(ctx, S_TRUNC);
                            write_all(2, str_ptr(cut), str_len(cut) as u64);
                        }
                    }
                }
                }
                total = total + 1;
            }
        }
    }
    if broken > 0 {
        let o: u32 = em(ctx, 0, "lomenterr: ");
        let o2: u32 = em_u32(ctx, o, broken);
        write_all(2, ctx, em(ctx, o2, ui(ctx, S_BROKEN)) as u64);
    }
    // 一条也没有 = 编译其实是好的 (调用方通常在失败时才起它, 但单独跑也要说清)。
    if total == 0 {
        if broken == 0 {
            let ok: str = ui(ctx, S_OK);
            write_all(2, str_ptr(ok), str_len(ok) as u64);
            return die(0);
        }
        return die(1);
    }
    // 汇总只在**给人看**的两个模式下打：`--json` 是一行一个对象，插一行汇总进去会让
    // 下游解析器当场坏掉 —— 那是把"给程序读"这个承诺自己破掉。
    if load32(ctx, C_MODE) != 2 {
        write_all(2, ctx, sum_print(ctx, total) as u64);
        // 上限**不许静默**：还剩几条、怎么全看，一句话说完。
        // （clang 打 `fatal error: too many errors emitted, stopping now`、Go 打
        // `too many errors`、javac 打完 `N errors` 就没了 —— 前两家说了，这家也照说。）
        if skipped > 0 {
            let a: u32 = em(ctx, 0, ui(ctx, S_CAPPED_A));
            let b: u32 = em_u32(ctx, a, skipped);
            write_all(2, ctx, em_byte(ctx, em(ctx, b, ui(ctx, S_CAPPED_B)), NL) as u64);
        }
        // 最后一行是 explain 指针 —— 放在**最末**（与 rustc 同一个位置：那一行是"读完之后
        // 想知道更多该敲什么"，把别的提示压在它后面就没人看得见它了）。
        let mo: u32 = h_more(ctx);
        if mo > 0 {
            write_all(2, ctx, mo as u64);
        }
    }
    return die(1);
}
