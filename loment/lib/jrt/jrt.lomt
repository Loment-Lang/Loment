// loment/lib/jrt/jrt.lomt — the minimal Java runtime, written in Loment.
//
// This is `jrt`: the code a javac-compiled class calls into when it prints,
// allocates or throws. It is compiled to `jrt.ll` (generated, next to this
// file) and linked **once** per closure by the build wrapper, through a
// `runtime jrt <version>` line in `deps/*/link.txt`.
//
// The rules this file follows (docs/282 §7):
//
//   * no libc, no JVM: the only syscalls are `write` (1) and, in a later
//     slice, the heap/scalar ones behind `jrt/sys`;
//   * the PE shim and ELF use the same numbers — `lomelf` maps them;
//   * nothing here knows about javac; the AOT side declares these functions
//     by their `jrt_*` names and calls them like any other IR function.
//
// Layout of a Java `String` as emitted by tools/lomjava.py:
//
//   +0   (unused header)
//   +8   ptr  — the UTF-16LE code units
//   +16  i32  — the length, in code units
//
// So `println(String)` walks code units, encodes each as UTF-8 and writes it.

module jrt
choose runtime

// ---------------------------------------------------------------- memory

/// brk bump: the sealed `alloc` heap is 64 KiB and never frees, which a
/// printing path would exhaust in a few thousand lines. The PE shim gives
/// this one 64 MiB and ELF's `brk` is the same syscall number (12).
fn jrt_alloc(n: u32) -> ptr {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0 as ptr;
    }
    let want: u64 = (((cur as u64) + (n as u64) + 15) / 16) * 16;
    let got: i64 = syscall4(12, want, 0, 0);
    if got < 0 {
        return 0 as ptr;
    }
    return cur as ptr;
}

/// Little-endian loads over the `load8` builtin (there is no `load32`).
fn ld32(p: ptr, off: u32) -> u32 {
    return load8(p, off) | (load8(p, off + 1) << 8)
         | (load8(p, off + 2) << 16) | (load8(p, off + 3) << 24);
}

fn ld64(p: ptr, off: u32) -> u64 {
    let lo: u64 = ld32(p, off) as u64;
    let hi: u64 = ld32(p, off + 4) as u64;
    return lo | (hi << 32);
}

// ---------------------------------------------------------------- output

/// One write(2) for the whole buffer. The PE shim maps syscall 1 to WriteFile
/// on a file/stdout handle, so the same number works on both targets.
fn wr(fd: i64, p: ptr, n: u32) {
    syscall4(1, fd as u64, p as u64, n as u64);
}

/// Decimal digits of `v` into `buf` (no sign). Returns the length.
fn dec(buf: ptr, v: u64) -> u32 {
    if v == 0 {
        store8(buf, 0, 48 as u8);
        return 1;
    }
    let x: u64 = v;
    let n: u32 = 0;
    while x > 0 {
        store8(buf, n, (48 + (x % 10)) as u8);
        x = x / 10;
        n = n + 1;
    }
    // reverse
    let i: u32 = 0;
    while i < n / 2 {
        let a: u32 = load8(buf, i);
        let b: u32 = load8(buf, n - 1 - i);
        store8(buf, i, b as u8);
        store8(buf, n - 1 - i, a as u8);
        i = i + 1;
    }
    return n;
}

/// Print a signed 64-bit value, then optionally a newline.
fn num64(fd: i64, v: i64, nl: u32) {
    let buf: ptr = jrt_alloc(40);
    let neg: u32 = 0;
    let x: u64 = v as u64;
    if v < 0 {
        neg = 1;
        x = (0 - v) as u64;
    }
    let n: u32 = dec(buf, x);
    let o: u32 = 0;
    let out: ptr = jrt_alloc(48);
    if neg == 1 {
        store8(out, 0, 45 as u8);
        o = 1;
    }
    let i: u32 = 0;
    while i < n {
        store8(out, o + i, load8(buf, i) as u8);
        i = i + 1;
    }
    o = o + n;
    if nl == 1 {
        store8(out, o, 10 as u8);
        o = o + 1;
    }
    wr(fd, out, o);
}

/// The UTF-8 bytes of one UTF-16 code unit. Returns the count.
fn utf8(buf: ptr, c: u32) -> u32 {
    if c < 128 {
        store8(buf, 0, c as u8);
        return 1;
    }
    if c < 2048 {
        store8(buf, 0, (192 + (c >> 6)) as u8);
        store8(buf, 1, (128 + (c % 64)) as u8);
        return 2;
    }
    // BMP. Surrogate pairs are written as their two 3-byte halves (CESU-8);
    // printing emoji correctly needs the 4-byte form, which is a later slice.
    store8(buf, 0, (224 + (c >> 12)) as u8);
    store8(buf, 1, (128 + ((c >> 6) % 64)) as u8);
    store8(buf, 2, (128 + (c % 64)) as u8);
    return 3;
}

fn jstr(fd: i64, s: ptr, nl: u32) {
    if s == (0 as ptr) {
        // A null String would be a bug in the caller; print `null` so the
        // failure is visible instead of a silent nothing.
        let nb: ptr = jrt_alloc(8);
        store8(nb, 0, 110 as u8);
        store8(nb, 1, 117 as u8);
        store8(nb, 2, 108 as u8);
        store8(nb, 3, 108 as u8);
        if nl == 1 {
            store8(nb, 4, 10 as u8);
            wr(fd, nb, 5);
        } else {
            wr(fd, nb, 4);
        }
    } else {
        let data: ptr = ld64(s, 8) as ptr;
        let n: u32 = ld32(s, 16);
        let buf: ptr = jrt_alloc(1024);
        let o: u32 = 0;
        let i: u32 = 0;
        while i < n {
            let c0: u32 = load8(data, i * 2) as u32;
            let hi: u32 = load8(data, i * 2 + 1) as u32;
            let c: u32 = c0 | (hi << 8);
            // Flush before the buffer could overflow (3 bytes per unit + 1).
            if o + 4 > 1024 {
                wr(fd, buf, o);
                o = 0;
            }
            if c < 128 {
                store8(buf, o, c as u8);
                o = o + 1;
            } else if c < 2048 {
                store8(buf, o, (192 + (c >> 6)) as u8);
                store8(buf, o + 1, (128 + (c % 64)) as u8);
                o = o + 2;
            } else {
                store8(buf, o, (224 + (c >> 12)) as u8);
                store8(buf, o + 1, (128 + ((c >> 6) % 64)) as u8);
                store8(buf, o + 2, (128 + (c % 64)) as u8);
                o = o + 3;
            }
            i = i + 1;
        }
        if nl == 1 {
            store8(buf, o, 10 as u8);
            o = o + 1;
        }
        if o > 0 {
            wr(fd, buf, o);
        }
    }
}

fn copy8(dst: ptr, doff: u32, src: ptr, soff: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, doff + i, load8(src, soff + i) as u8);
        i = i + 1;
    }
    return n;
}

// ---------------------------------------------------------------- public

pub fn jrt_print_i32(fd: i64, v: i32) {
    num64(fd, v as i64, 0);
}

pub fn jrt_println_i32(fd: i64, v: i32) {
    num64(fd, v as i64, 1);
}

pub fn jrt_print_i64(fd: i64, v: i64) {
    num64(fd, v, 0);
}

pub fn jrt_println_i64(fd: i64, v: i64) {
    num64(fd, v, 1);
}

pub fn jrt_print_s(fd: i64, s: ptr) {
    jstr(fd, s, 0);
}

pub fn jrt_println_s(fd: i64, s: ptr) {
    jstr(fd, s, 1);
}

pub fn jrt_println(fd: i64) {
    let b: ptr = jrt_alloc(4);
    store8(b, 0, 10 as u8);
    wr(fd, b, 1);
}

// ---------------------------------------------------------------- StringBuilder
//
// 布局（与 AOT 侧约定）：
//
//   +0   i32  已用（UTF-16 单元数）
//   +4   i32  容量（单元数）
//   +8   ptr  数据
//
// `jrt_sb_str` 产出的 String 与 `ldc` 产的形状一致：+8 数据、+16 长度。数据是
// **拷出去**的 —— toString() 之后还可以继续 append。

fn st32(p: ptr, off: u32, v: u32) {
    store8(p, off, (v & 255) as u8);
    store8(p, off + 1, ((v >> 8) & 255) as u8);
    store8(p, off + 2, ((v >> 16) & 255) as u8);
    store8(p, off + 3, ((v >> 24) & 255) as u8);
}

fn st64(p: ptr, off: u32, v: u64) {
    st32(p, off, (v & 4294967295) as u32);
    st32(p, off + 4, (v >> 32) as u32);
}

fn sb_grow(sb: ptr, need: u32) {
    let len: u32 = ld32(sb, 0);
    let cap: u32 = ld32(sb, 4);
    let want: u32 = len + need;
    if want > cap {
        let nc: u32 = cap;
        while nc < want {
            nc = nc * 2;
        }
        let old: ptr = ld64(sb, 8) as ptr;
        let nb: ptr = jrt_alloc(nc * 2);
        let _c: u32 = copy8(nb, 0, old, 0, len * 2);
        st64(sb, 8, nb as u64);
        st32(sb, 4, nc);
    }
}

fn sb_put(sb: ptr, ch: u32) {
    sb_grow(sb, 1);
    let len: u32 = ld32(sb, 0);
    let buf: ptr = ld64(sb, 8) as ptr;
    store8(buf, len * 2, (ch & 255) as u8);
    store8(buf, len * 2 + 1, ((ch >> 8) & 255) as u8);
    st32(sb, 0, len + 1);
}

/// 十进制数字（无符号）追加到 builder —— 先倒着进暂存，再正着写。
fn sb_mag(sb: ptr, mag: u64) {
    if mag == 0 {
        sb_put(sb, 48);
    } else {
        let buf: ptr = jrt_alloc(32);
        let n: u32 = 0;
        let v: u64 = mag;
        while v > 0 {
            store8(buf, n, ((48 as u64) + (v % 10)) as u8);
            n = n + 1;
            v = v / 10;
        }
        while n > 0 {
            n = n - 1;
            sb_put(sb, load8(buf, n) as u32);
        }
    }
}

pub fn jrt_sb_new() -> ptr {
    let sb: ptr = jrt_alloc(16);
    let cap: u32 = 32;
    let buf: ptr = jrt_alloc(cap * 2);
    st32(sb, 0, 0);
    st32(sb, 4, cap);
    st64(sb, 8, buf as u64);
    return sb;
}

pub fn jrt_sb_c(sb: ptr, ch: i32) {
    sb_put(sb, ch as u32);
}

pub fn jrt_sb_i32(sb: ptr, v: i32) {
    if v < 0 {
        sb_put(sb, 45);
        sb_mag(sb, (0 - (v as i64)) as u64);
    } else {
        sb_mag(sb, v as u64);
    }
}

pub fn jrt_sb_i64(sb: ptr, v: i64) {
    if v < 0 {
        sb_put(sb, 45);
        sb_mag(sb, (0 - v) as u64);
    } else {
        sb_mag(sb, v as u64);
    }
}

pub fn jrt_sb_s(sb: ptr, s: ptr) {
    if (s as u64) != 0 {
        let src: ptr = ld64(s, 8) as ptr;
        let n: u32 = ld32(s, 16);
        let i: u32 = 0;
        while i < n {
            sb_grow(sb, 1);
            let len: u32 = ld32(sb, 0);
            let buf: ptr = ld64(sb, 8) as ptr;
            store8(buf, len * 2, load8(src, i * 2) as u8);
            store8(buf, len * 2 + 1, load8(src, i * 2 + 1) as u8);
            st32(sb, 0, len + 1);
            i = i + 1;
        }
    }
}

/// 未捕获的 Java 异常：一行消息到 stderr，退出码 1。
///
/// 没有栈回溯，也没有异常类名 —— 这个子集里异常不携带类型信息（见 docs/282 状态行）。
pub fn jrt_uncaught() {
    wr(2, str_ptr("Exception in thread main"), str_len("Exception in thread main"));
    let nl: ptr = jrt_alloc(4);
    store8(nl, 0, 10 as u8);
    wr(2, nl, 1);
    syscall4(60, 1, 0, 0);
}

pub fn jrt_sb_str(sb: ptr) -> ptr {
    let len: u32 = ld32(sb, 0);
    let bytes: u32 = len * 2;
    let buf: ptr = jrt_alloc(bytes + 2);
    let src: ptr = ld64(sb, 8) as ptr;
    let _c: u32 = copy8(buf, 0, src, 0, bytes);
    let s: ptr = jrt_alloc(24);
    st64(s, 8, buf as u64);
    st32(s, 16, len);
    return s;
}
