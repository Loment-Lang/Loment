enum Opt {
    Some(u32),
    None,
}

fn scope_block(cond: u32) -> u32 {
    let x: u32 = 1;
    if cond != 0 {
        let x: u32 = 2;
        x = x + 1;
    }
    {
        let x: u32 = 3;
        x = x + 1;
    }
    for i in 0..3 {
