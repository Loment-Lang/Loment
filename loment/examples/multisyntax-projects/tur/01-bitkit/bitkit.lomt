choose write grammar tur
module bitkit
choose runtime

/* bitkit.lomt —— 用 **Tur 拼法**写的 Loment 模块。
 *
 * 后缀 `.lomt` 说的是"这是一份 Loment 的文件"；首行 `choose write grammar tur`
 * 说的是"按 Tur 的拼法读它"。Tur 是本语言自己的正式语法（从 Rust 直接修改），
 * 语义仍然是 Loment 的：**表层语法只决定拼法与形状，不决定语义**（docs/188 §0）。
 *
 * 与其他五门**不一样的一处**（这一门特有）：`tur` 是 Loment 的**原生语法**，
 * 所以前门**不经过任何翻译器** —— 它只把首行声明抹成空白，原样交给原生解析器。
 * 原生解析器要求**源里自带 `module <名字>` 行**（另五门的模块名是翻译器从文件名
 * 造出来的）：于是这一份的第二行必须是 `module bitkit`，与文件 stem 一致。
 *
 * ## 为什么这份**没有 `while`/`for`，全用递归**
 *
 * 这一份要**同时是合法的 Rust**（对照组用 `rustc` 编它，判据见
 * `tools/loment_multisyntax_projects_test.py` 的 `_control_rust`）。两种语言在
 * **赋值**上有一个**没有交集**的地方：
 *
 *   * Rust 的 `let x: T = e;` 绑定**不可变**，再赋值要写 `let mut x`；
 *     形参也一样，要 `mut a: T` 才能改。
 *   * Loment 的 `let x: T = e;` **本来就是可变的**（直接再赋值即可），
 *     而 `mut` **不是关键字** —— `let mut x: T` 当场解析失败（`loment_diag.py`
 *     把 `let mut x: T` 明列为"不支持"；`docs/143` 的对照表把 Rust 的
 *     `let mut x: T = e;` 映成本语言的 `let x: T = e;`）。
 *
 * 于是"**改一个局部变量**"这件事在这两个表层里**没有共同写法**。"带着状态的
 * `while` 循环"恰恰要求这么一件事，所以它**进不了这个交集**。出路只有一条：
 * **不用赋值** —— 把每一步的中间值当作**参数**传给下一次递归，循环写成递归。
 * 本文件的每个"循环"都是这么写的（`*_go` 这些内部函数）。
 *
 * 这条是**原生读法独有的坑**：另五门（C / C++ / Java / C# / Go / Python）里
 * 局部变量本来就可变，翻译器把 `x = e;` 原样搬成本语言的 `x = e;`，都不必绕。
 * 只有 Rust 这一门同时受"Rust 要 mut"和"Loment 没有 mut"两头夹。
 *
 * 主题：**整数校验与位操作工具箱** —— 一个确定性的字节流（`byte_at`）喂给一族
 * 哈希 / 校验和，再配一组位运算原语。`entry()` 把每个函数的结果折成一个数，
 * 每一步都参与，所以任一算法错了退出码就变。
 *
 * **全篇不溢出**：所有中间值都界在 i32 范围内（见 README「为什么不会溢出」）。
 */

/* 滚动哈希的模数：**素数**，且足够小，让 `h * mult` 不撞 i32 上界。
 * （mult 最大 251：1e6 * 251 ≈ 2.5e8 < 2^31-1。） */
const MOD: i32 = 1000003;

/* 确定性的"字节流"：第 i 个"字节"（0..255），纯算术、没有数组。
 * i 界在 0..4096，于是 i*i < 1.7e7、7*i < 2.9e4，加减都不溢出。 */
pub fn byte_at(i: i32) -> i32 {
    let x: i32 = (i * i) + (7 * i) + 13;
    return x & 255;
}

/* 辗转相除：**递归**（Rust / Loment 都靠"把新值当参数传下去"推进）。
 * 形参非负，`a % b` 与互换都不溢出。 */
pub fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 {
        return a;
    }
    return gcd(b, a % b);
}

/* 以 2 为底取整：**递归**的右移，n <= 1 是底。 */
pub fn log2_floor(n: i32) -> i32 {
    if n <= 1 {
        return 0;
    }
    return 1 + log2_floor(n >> 1);
}

/* 多项式滚动哈希的**内部递归**：把 (h, i) 当参数推到下一轮。
 * **跨函数调用**（byte_at）；mult 取小值所以乘法不溢出。 */
fn poly_go(h: i32, mult: i32, i: i32, count: i32) -> i32 {
    if i >= count {
        return h;
    }
    return poly_go((h * mult + byte_at(i)) % MOD, mult, i + 1, count);
}

/* 多项式滚动哈希（`h = (h * mult + byte_at(i)) % MOD`）对外的门面。 */
pub fn poly_hash(seed: i32, count: i32, mult: i32) -> i32 {
    return poly_go(seed % MOD, mult, 0, count);
}

/* djb2 那一招（`h * 33 + b`）写成移位加法：`(h << 5) + h`。
 * h < MOD ≈ 1e6 ⇒ `h << 5` < 3.2e7，安全。**递归**推进。 */
fn djb_go(h: i32, i: i32, count: i32) -> i32 {
    if i >= count {
        return h;
    }
    return djb_go(((h << 5) + h + byte_at(i)) % MOD, i + 1, count);
}

pub fn djb_like(count: i32) -> i32 {
    return djb_go(5381, 0, count);
}

/* 置位数：Kernighan 那一招（`n & (n - 1)` 抹掉最低的 1），**递归**。
 * 对负数也成立 —— 补码在两边是同一种表示。 */
pub fn popcount(v: i32) -> i32 {
    if v == 0 {
        return 0;
    }
    return 1 + popcount(v & (v - 1));
}

/* 奇偶位：置位数的最低位。**跨函数调用**（popcount）。 */
pub fn parity(v: i32) -> i32 {
    return popcount(v) & 1;
}

/* 16 位循环左移：取低 16 位、按 16 位环回。
 * `x << s` 最大 65535 << 15 ≈ 2.1475e9 < 2^31-1，刚好不溢出。
 * s = 0 时 `x >> 16` = 0，也不会出现"移位 32 位"那种未定义。 */
pub fn rotl16(v: i32, k: i32) -> i32 {
    let x: i32 = v & 65535;
    let s: i32 = k & 15;
    return ((x << s) | (x >> (16 - s))) & 65535;
}

/* 16 位循环右移：**跨函数调用**（rotl16），把右移折成左移 16-s。 */
pub fn rotr16(v: i32, k: i32) -> i32 {
    return rotl16(v, (16 - (k & 15)) & 15);
}

/* 16 位反转的**内部递归**：每轮取最低位拼到结果高位。 */
fn rev_go(x: i32, r: i32, i: i32) -> i32 {
    if i >= 16 {
        return r;
    }
    return rev_go(x >> 1, ((r << 1) | (x & 1)) & 65535, i + 1);
}

pub fn reverse_bits16(v: i32) -> i32 {
    return rev_go(v & 65535, 0, 0);
}

/* 格雷码编码：`g = n ^ (n >> 1)`。 */
pub fn gray_encode(n: i32) -> i32 {
    let x: i32 = n & 65535;
    return x ^ (x >> 1);
}

/* 格雷码解码：**递归**，用展开式 `g ^ (g>>1) ^ (g>>2) ^ …`。
 * `gray_decode(g) = g ^ gray_decode(g >> 1)`，底是 0。 */
pub fn gray_decode(g: i32) -> i32 {
    if g == 0 {
        return 0;
    }
    return g ^ gray_decode(g >> 1);
}

/* 是不是 2 的幂：两条**提前 return**。 */
pub fn is_pow2(v: i32) -> i32 {
    if v <= 0 {
        return 0;
    }
    if (v & (v - 1)) == 0 {
        return 1;
    }
    return 0;
}

/* 最低的 1 位（`x & -x`）：先收到 16 位，负号就不会撞 i32 最小值。 */
pub fn lowbit(v: i32) -> i32 {
    let x: i32 = v & 65535;
    return x & (0 - x);
}

/* 考拉兹步数：**递归**，两条分支各一次自调用。
 * n = 27 的轨道上最大值 9232，`3*n+1` 不溢出。 */
pub fn collatz_steps(n: i32) -> i32 {
    if n <= 1 {
        return 0;
    }
    if (n % 2) == 0 {
        return 1 + collatz_steps(n / 2);
    }
    return 1 + collatz_steps(3 * n + 1);
}

/* 模幂：**递归** + 平方。底与中间值都 < m = 10007 ⇒ 乘积 < 1.0e8，不溢出。 */
pub fn pow_mod(base: i32, exp: i32, m: i32) -> i32 {
    if exp == 0 {
        return 1 % m;
    }
    if (exp % 2) == 1 {
        return (base * pow_mod(base, exp - 1, m)) % m;
    }
    let half: i32 = pow_mod(base, exp / 2, m);
    return (half * half) % m;
}

/* 数位和：**递归**（n 非负，n/10 与 n%10 都安全）。 */
pub fn digit_sum_rec(n: i32) -> i32 {
    if n == 0 {
        return 0;
    }
    return (n % 10) + digit_sum_rec(n / 10);
}

/* Luhn 校验的**内部递归**：往右走，隔一位翻倍、超过 9 就减 9。
 * 输入是 `byte_at(i) % 10`。 */
fn luhn_go(sum: i32, i: i32, count: i32) -> i32 {
    if i >= count {
        return sum;
    }
    let d: i32 = byte_at(i) % 10;
    if (i % 2) == 1 {
        let dd: i32 = d + d;
        if dd > 9 {
            return luhn_go(sum + (dd - 9), i + 1, count);
        }
        return luhn_go(sum + dd, i + 1, count);
    }
    return luhn_go(sum + d, i + 1, count);
}

pub fn luhn_sum(count: i32) -> i32 {
    return luhn_go(0, 0, count);
}

/* CRC-8（多项式 0x07，初值 0xFF）：**两层嵌套的迭代**。
 * 外层吃字节（`crc_bytes`），内层逐位（`crc_bits`）—— 位运算与分支混在一起。
 * 这里的两层是**嵌套递归**（见文件头：这一门不能用带状态的 `while`）。 */
fn crc_bits(crc: i32, b: i32) -> i32 {
    if b >= 8 {
        return crc;
    }
    if (crc & 128) != 0 {
        return crc_bits(((crc << 1) ^ 7) & 255, b + 1);
    }
    return crc_bits((crc << 1) & 255, b + 1);
}

fn crc_bytes(crc: i32, i: i32, count: i32) -> i32 {
    if i >= count {
        return crc;
    }
    return crc_bytes(crc_bits(crc ^ byte_at(i), 0), i + 1, count);
}

pub fn crc8_like(count: i32) -> i32 {
    return crc_bytes(255, 0, count);
}

/* Adler 那一招（两个累加器取模 65521）折成一个数：**递归**推进。
 * a、b 都 < 65521 ⇒ `b * 31` < 2.1e6，安全。 */
fn adler_go(a: i32, b: i32, i: i32, count: i32) -> i32 {
    if i >= count {
        return (b * 31 + a) % MOD;
    }
    let na: i32 = (a + byte_at(i)) % 65521;
    return adler_go(na, (b + na) % 65521, i + 1, count);
}

pub fn adler_like(count: i32) -> i32 {
    return adler_go(1, 0, 0, count);
}

/* 收尾混合：异或右移 + 乘小常数，反复两轮（无循环）。
 * 先把值收到 16 位，右移就不会带上符号位；`y * 33` < 2.2e6，安全。 */
pub fn mix32(h: i32) -> i32 {
    let x: i32 = h & 65535;
    let y: i32 = x ^ (x >> 7);
    let z: i32 = (y * 33) % MOD;
    let w: i32 = z ^ (z >> 11);
    return w & 65535;
}

/* 多轮校验的**内层递归**：一趟扫过 count 个字节。 */
fn scan_go(h: i32, i: i32, count: i32) -> i32 {
    if i >= count {
        return h;
    }
    return scan_go((h * 131 + byte_at(i)) % MOD, i + 1, count);
}

/* 多轮校验的**外层递归**：每一轮先把 inner 扫一趟，再叠上轮号。
 * `rounds_go`（外）调 `scan_go`（内）—— 又一处**两层嵌套的迭代**。 */
fn rounds_go(h: i32, r: i32, rounds: i32, count: i32) -> i32 {
    if r >= rounds {
        return h;
    }
    let hh: i32 = scan_go(h, 0, count);
    return rounds_go((hh + r) % MOD, r + 1, rounds, count);
}

pub fn checksum_rounds(seed: i32, rounds: i32, count: i32) -> i32 {
    return rounds_go(seed % MOD, 0, rounds, count);
}

/* 宿主调的入口：把上面每个函数的结果折成一个数。
 *
 * 约定：每个中间量都收进 0..255（用 `% 256` 或 `& 255` / `/ 128` 这类收口），
 * 于是二十个量相加也不会溢，最后的 `% 256` 落在 0..255。
 * **每一步都参与**，所以任一算法错了退出码就变。 */
pub fn entry() -> i32 {
    let g: i32 = gcd(1071, 462);                 /* 21 */
    let lg: i32 = log2_floor(1000000);           /* 19 */
    let ph: i32 = poly_hash(7, 64, 31) % 256;
    let dj: i32 = djb_like(64) % 256;
    let pc: i32 = popcount(1048575);             /* 20（2^20 - 1） */
    let pa: i32 = parity(1234567890) & 255;
    let rl: i32 = rotl16(4660, 4) % 256;
    let rr: i32 = rotr16(4660, 4) % 256;
    let rb: i32 = reverse_bits16(1) / 128;       /* 32768 -> 256 */
    let gd: i32 = gray_decode(gray_encode(100)); /* 往返回到 100 */
    let p2: i32 = is_pow2(1024);                 /* 1 */
    let lb: i32 = lowbit(96);                    /* 32 */
    let cs: i32 = collatz_steps(27);             /* 111 */
    let pm: i32 = pow_mod(3, 13, 10007) % 256;
    let ds: i32 = digit_sum_rec(987654);         /* 39 */
    let lu: i32 = luhn_sum(32) & 255;
    let cr: i32 = crc8_like(32);
    let ad: i32 = adler_like(32) % 256;
    let mx: i32 = mix32(65535) % 256;
    let ck: i32 = checksum_rounds(1, 4, 16) % 256;

    let total: i32 = g + lg + ph + dj + pc + pa + rl + rr + rb + gd
        + p2 + lb + cs + pm + ds + lu + cr + ad + mx + ck;
    return total % 256;
}
