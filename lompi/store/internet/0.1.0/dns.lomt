// internet/dns.lomt — DNS 报文的线格式 (RFC 1035 §4): 域名、报文头、查询与应答
//
// 为什么需要它: 工具链里**没有解析器** (没有 getaddrinfo, 见 docs/236) —— 这不是本库
// 能补的, 那需要一条到 libc 或一个内置解析器的路。但**报文本身**是可以做的: 域名的
// 标签长度前缀 + 0 终止、压缩指针 (0xC0)、12 字节报文头、问题段与资源记录段。这一层
// 是纯逻辑, 可以先对到线缆字节级, 之后无论接哪个解析器都用得上。
//
// 边界 (刻意划的, 不是没做完):
//   * 纯逻辑: 不发系统调用, 不分配。"发出去"是调用方的事 (udp 模块 + 一个解析器地址)。
//   * **不做解析器**: 不查 `/etc/resolv.conf`, 不做重试、不做缓存、不做 DNSSEC。
//   * 只实现 `IN` 类, 只解 A / AAAA / CNAME / NS 四种应答 (其余按"有记录但不认识"跳过)。
//   * 本文件不 `use` 任何模块 (理由见 ip.lomt 头)。
//
// 命名: 公开 dns_*, 内部 dnsp_*。自检 test_dns_*。
// 对照物: 线格式的判据对**独立按 RFC 1035 推出来的字节**, 以及 (有网时) 真解析器 ——
// 判据文件里两条分开写, 不混。

module dns
choose runtime

/// 失败 / 找不到。
pub const DNS_NO: u32 = 4294967295;

/// 记录类型。
pub const DNS_A: u32 = 1;
pub const DNS_CNAME: u32 = 5;
pub const DNS_NS: u32 = 2;
pub const DNS_AAAA: u32 = 28;
/// 类 IN。
pub const DNS_IN: u32 = 1;

fn dnsp_be16(p: ptr, o: u32) -> u32 {
    return (load8(p, o) << 8) | load8(p, o + 1);
}

fn dnsp_set16(p: ptr, o: u32, v: u32) {
    store8(p, o, (v >> 8) as u8);
    store8(p, o + 1, (v & 255) as u8);
}

fn dnsp_set32(p: ptr, o: u32, v: u32) {
    store8(p, o, (v >> 24) as u8);
    store8(p, o + 1, ((v >> 16) & 255) as u8);
    store8(p, o + 2, ((v >> 8) & 255) as u8);
    store8(p, o + 3, (v & 255) as u8);
}

// ---------------------------------------------------------------- 域名

/// 把一个标签写进 out[pos]: 长度前缀 + 字节。标签 1..63 且非空。
fn dnsp_label(name: str, so: u32, sn: u32, out: ptr, pos: u32) -> u32 {
    if sn == 0 || sn > 63 {
        return DNS_NO;
    }
    store8(out, pos, sn as u8);
    let i: u32 = 0;
    while i < sn {
        store8(out, pos + 1 + i, str_byte(name, so + i) as u8);
        i = i + 1;
    }
    return pos + 1 + sn;
}

/// 域名 -> 线格式 (标签长度前缀 + 0)。返回写入的字节数; 放不下 / 标签非法返回 DNS_NO。
/// 允许结尾的 `.` (表示根), 但不允许空标签 (`a..b`)。
pub fn dns_name_encode(name: str, out: ptr, cap: u32) -> u32 {
    let n: u32 = str_len(name);
    // 空名字与单独一个 `.` 都是根: 线格式就是一个 0 字节。
    if n == 0 || (n == 1 && str_byte(name, 0) == 46) {
        if cap < 1 {
            return DNS_NO;
        }
        store8(out, 0, 0 as u8);
        return 1;
    }
    let pos: u32 = 0;
    let s: u32 = 0;
    let i: u32 = 0;
    while i < n {
        if str_byte(name, i) == 46 {
            let sn: u32 = i - s;
            if sn == 0 {
                return DNS_NO;                   // 空标签: `a..b` / 前导 `.`
            }
            // **先算容量再写** —— 写完才查的话, cap 小的调用方拿到的是 DNS_NO 加一块越界写。
            // `pos + 1 + sn + 1` 是长度前缀 + 标签内容 + 结尾那个 0。
            // 255 是 RFC 1035 §3.1 的名字上限（含结尾 0），不是调用方的容量 (#684)。
            if sn > 63 || pos + 1 + sn + 1 > cap || pos + 1 + sn + 1 > 255 {
                return DNS_NO;
            }
            let w: u32 = dnsp_label(name, s, sn, out, pos);
            if w == DNS_NO {
                return DNS_NO;
            }
            pos = w;
            s = i + 1;
        }
        i = i + 1;
    }
    // 结尾带 `.` 时 `s == n`, 这一段不存在 —— 那正是"允许结尾的 `.`"的意思,
    // 原来这里会拿一个空标签去编码, 于是文档说允许的写法反而被拒。`sn > 63` 同上。
    if s < n {
        let sn: u32 = n - s;
        if sn > 63 || pos + 1 + sn + 1 > cap || pos + 1 + sn + 1 > 255 {
            return DNS_NO;
        }
        let w: u32 = dnsp_label(name, s, sn, out, pos);
        if w == DNS_NO {
            return DNS_NO;
        }
        pos = w;
    }
    store8(out, pos, 0 as u8);                   // 上面每段都留出了这一个字节
    return pos + 1;
}

/// 线格式域名 -> 点分文本, 处理压缩指针 (`0xC0`)。返回写入 out 的字节数。
/// 指针成环、越界、放不下都返回 DNS_NO。`msg[0, msg_n)` 是整条报文 (指针是相对它算的)。
pub fn dns_name_decode(msg: ptr, msg_n: u32, off: u32, out: ptr, cap: u32) -> u32 {
    let w: u32 = 0;
    let p: u32 = off;
    let jumps: u32 = 0;
    let lbls: u32 = 0;
    while p < msg_n {
        let c: u32 = load8(msg, p);
        if c == 0 {
            if w == 0 {
                return 0;
            }
            return w;
        }
        // RFC 1035 §4.1.4: 头两位是 11 的**任何**字节都是指针（0xC0..0xFF），偏移 14 位。
        // 原来只认 0xC0..0xDF（偏移 < 8192），于是超过 8 KiB 的应答（TCP DNS 的常态）
        // 悄悄丢掉压缩名 (#682)。
        if c >= 192 {
            if p + 1 >= msg_n {
                return DNS_NO;
            }
            let to: u32 = ((c & 63) << 8) | load8(msg, p + 1);
            if to >= p {
                return DNS_NO;                   // RFC 1035: 指针只能往回指 (同时让成环不可能)
            }
            jumps = jumps + 1;
            if jumps > 128 {
                return DNS_NO;                   // 兜底 (上面的"只能往回指"已经让成环不可能)
            }
            p = to;
        } else {
            if c > 63 {
                return DNS_NO;                   // 64..191 是保留值, 不是标签长度
            }
            if w > 0 {
                if w + 1 > cap {
                    return DNS_NO;
                }
                store8(out, w, 46 as u8);
                w = w + 1;
            }
            if p + 1 + c > msg_n {
                return DNS_NO;
            }
            if w + c > cap {
                return DNS_NO;
            }
            // RFC 1035 §3.1: 一个域名（展开后）上限 255 字节 —— 文本长度 + 每个标签的
            // 长度前缀 + 结尾 0。原来只在编码侧没有总长检查，解码侧也没有 (#684)。
            lbls = lbls + 1;
            if w + c + lbls + 1 > 255 {
                return DNS_NO;
            }
            let i: u32 = 0;
            while i < c {
                store8(out, w + i, load8(msg, p + 1 + i) as u8);
                i = i + 1;
            }
            w = w + c;
            p = p + 1 + c;
        }
    }
    return DNS_NO;
}

// ---------------------------------------------------------------- 报文头

/// 事务 ID。
pub fn dns_hdr_id(msg: ptr) -> u32 {
    return dnsp_be16(msg, 0);
}

/// 应答码 (flags 的低 4 位): 0 = NOERROR。
pub fn dns_hdr_rcode(msg: ptr) -> u32 {
    return dnsp_be16(msg, 2) & 15;
}

/// 四个计数之一: which 0=QD 1=AN 2=NS 3=AR。
/// 越界返回 0 —— 原来不校验, `which = 8` 会去读 12 字节头之外的 `msg[20]`。
pub fn dns_hdr_count(msg: ptr, which: u32) -> u32 {
    if which > 3 {
        return 0;
    }
    return dnsp_be16(msg, 4 + which * 2);
}

/// 是不是一条应答 (QR 位)。
pub fn dns_is_response(msg: ptr) -> bool {
    return (dnsp_be16(msg, 2) & 32768) != 0;
}

// ---------------------------------------------------------------- 构建查询

/// 拼一条查询: 12 字节头 + 一个问题 (QNAME + QTYPE + QCLASS=IN)。
/// `rd` 非 0 时置"希望递归"位 (0x0100)。返回报文长度; 放不下返回 DNS_NO。
pub fn dns_query_build(msg: ptr, cap: u32, id: u32, name: str, qtype: u32, rd: u32) -> u32 {
    if cap < 12 {
        return DNS_NO;
    }
    dnsp_set16(msg, 0, id);
    let flags: u32 = 0;
    if rd != 0 {
        flags = 256;                             // RD: 希望递归
    }
    dnsp_set16(msg, 2, flags);
    dnsp_set16(msg, 4, 1);                       // QDCOUNT
    dnsp_set16(msg, 6, 0);
    dnsp_set16(msg, 8, 0);
    dnsp_set16(msg, 10, 0);
    let rest: u32 = cap - 12;
    let qn: u32 = dns_name_encode(name, ((msg as u64) + 12) as ptr, rest);
    if qn == DNS_NO {
        return DNS_NO;
    }
    let pos: u32 = 12 + qn;
    if pos + 4 > cap {
        return DNS_NO;
    }
    dnsp_set16(msg, pos, qtype);
    dnsp_set16(msg, pos + 2, DNS_IN);
    return pos + 4;
}

// ---------------------------------------------------------------- 解析应答

/// 跳过一个域名 (含压缩指针); 返回它**最后一个字节之后**的位置。
fn dnsp_skip_name(msg: ptr, msg_n: u32, off: u32) -> u32 {
    let p: u32 = off;
    while p < msg_n {
        let c: u32 = load8(msg, p);
        if c == 0 {
            return p + 1;
        }
        if c >= 192 {
            return p + 2;                        // 0xC0..0xFF 都是指针 (RFC 1035 §4.1.4, #682)
        }
        if c > 63 {
            return DNS_NO;                       // 64..191 是保留的标签长度
        }
        p = p + 1 + c;
    }
    return DNS_NO;
}

/// 在应答里找第一条 `qtype` 记录, 把 RDATA 拷进 out (上限 cap), 返回字节数。
/// 找不到 / 报文截断返回 DNS_NO。CNAME 的 RDATA 是域名 —— **解成点分文本**再给出去。
pub fn dns_resp_find(msg: ptr, n: u32, qtype: u32, out: ptr, cap: u32) -> u32 {
    if n < 12 {
        return DNS_NO;
    }
    let p: u32 = 12;
    let qd: u32 = dns_hdr_count(msg, 0);
    let i: u32 = 0;
    while i < qd {
        let nx: u32 = dnsp_skip_name(msg, n, p);
        if nx == DNS_NO || nx + 4 > n {
            return DNS_NO;
        }
        p = nx + 4;
        i = i + 1;
    }
    let an: u32 = dns_hdr_count(msg, 1);
    let j: u32 = 0;
    while j < an {
        let nx2: u32 = dnsp_skip_name(msg, n, p);
        if nx2 == DNS_NO || nx2 + 10 > n {
            return DNS_NO;
        }
        let rtype: u32 = dnsp_be16(msg, nx2);
        // CLASS 在 TYPE 与 TTL 之间。这个模块只做 IN；别的 CLASS 的 RDATA 不是同一个
        // 名字空间里的东西，照着返回等于把一条别的记录当成 IN (#688)。
        let rclass: u32 = dnsp_be16(msg, nx2 + 2);
        let rdlen: u32 = dnsp_be16(msg, nx2 + 8);
        let rdo: u32 = nx2 + 10;
        if rdo + rdlen > n {
            return DNS_NO;
        }
        if rtype == qtype && rclass == DNS_IN {
            if qtype == DNS_CNAME || qtype == DNS_NS {
                // 名字必须**落在自己的 RDATA 里**：给整条报文长度的版本会把下一条记录的
                // 0 终结符当成这一条的结尾 —— 经典的缓存投毒形状 (#683)。
                return dns_name_decode(msg, rdo + rdlen, rdo, out, cap);
            }
            if qtype == DNS_A && rdlen == 4 {
                if cap < 4 {
                    return DNS_NO;
                }
                let k: u32 = 0;
                while k < 4 {
                    store8(out, k, load8(msg, rdo + k) as u8);
                    k = k + 1;
                }
                return 4;
            }
            if qtype == DNS_AAAA && rdlen == 16 {
                if cap < 16 {
                    return DNS_NO;
                }
                let k2: u32 = 0;
                while k2 < 16 {
                    store8(out, k2, load8(msg, rdo + k2) as u8);
                    k2 = k2 + 1;
                }
                return 16;
            }
        }
        p = rdo + rdlen;
        j = j + 1;
    }
    return DNS_NO;
}

// ---------------------------------------------------------------- 自检

fn dnsp_lit(out: ptr, o: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(out, o + i, str_byte(s, i) as u8);
        i = i + 1;
    }
    return o + n;
}

fn test_dns_name_encode() -> bool {
    let b: ptr = alloc(64);
    let n: u32 = dns_name_encode("example.com", b, 64);
    return n == 13 && load8(b, 0) == 7 && load8(b, 1) == 101 && load8(b, 8) == 3
        && load8(b, 12) == 0;
}

fn test_dns_name_reject_empty_label() -> bool {
    let b: ptr = alloc(64);
    return dns_name_encode("a..b", b, 64) == DNS_NO;
}

fn test_dns_name_roundtrip() -> bool {
    let b: ptr = alloc(64);
    let o: ptr = alloc(64);
    let n: u32 = dns_name_encode("www.example.com", b, 64);
    let m: u32 = dns_name_decode(b, n, 0, o, 64);
    return m == 15 && load8(o, 0) == 119 && load8(o, 3) == 46 && load8(o, 14) == 109;
}

fn test_dns_name_compression() -> bool {
    // "example.com" 编在偏移 0; 之后放一个指回 0 的压缩指针
    let b: ptr = alloc(64);
    let n: u32 = dns_name_encode("example.com", b, 64);
    store8(b, n, 192 as u8);
    store8(b, n + 1, 0 as u8);
    let o: ptr = alloc(64);
    let m: u32 = dns_name_decode(b, n + 2, n, o, 64);
    return m == 11 && load8(o, 7) == 46 && load8(o, 10) == 109;
}

fn test_dns_query_build() -> bool {
    let b: ptr = alloc(64);
    let n: u32 = dns_query_build(b, 64, 4660, "a.b", DNS_A, 1);
    return n == 12 + 5 + 4 && load8(b, 0) == 18 && load8(b, 1) == 52
        && load8(b, 2) == 1 && load8(b, 5) == 1;
}

fn test_dns_parse_a_record() -> bool {
    // 手搭一条最小应答 (显式偏移):
    //   0..11 头 | 12 "a" 名 | 15 QTYPE | 17 QCLASS | 19 指针->12
    //   21 TYPE | 23 CLASS | 25 TTL | 29 RDLENGTH | 31 RDATA = 1.2.3.4
    let m: ptr = alloc(64);
    let z: u32 = 0;
    while z < 64 {
        store8(m, z, 0 as u8);
        z = z + 1;
    }
    store8(m, 5, 1 as u8);                       // QDCOUNT = 1
    store8(m, 7, 1 as u8);                       // ANCOUNT = 1
    store8(m, 12, 1 as u8);
    store8(m, 13, 97 as u8);                     // "a"
    store8(m, 14, 0 as u8);
    store8(m, 16, 1 as u8);                      // QTYPE = A
    store8(m, 18, 1 as u8);                      // QCLASS = IN
    store8(m, 19, 192 as u8);                    // 名字 = 指针 -> 12
    store8(m, 20, 12 as u8);
    store8(m, 22, 1 as u8);                      // TYPE = A
    store8(m, 24, 1 as u8);                      // CLASS = IN
    store8(m, 30, 4 as u8);                      // RDLENGTH = 4
    store8(m, 31, 1 as u8);
    store8(m, 32, 2 as u8);
    store8(m, 33, 3 as u8);
    store8(m, 34, 4 as u8);
    let out: ptr = alloc(16);
    let got: u32 = dns_resp_find(m, 35, DNS_A, out, 16);
    return got == 4 && load8(out, 0) == 1 && load8(out, 3) == 4;
}
