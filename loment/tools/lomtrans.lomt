// ---------------------------------------------------------------- 外壳剥离
//
// Java 与 C# 的函数不住在顶层：它们在 `class X { … }` 里，C# 还多一层 `namespace`。
// 共享解析器只认顶层 —— 所以分词**之前**先把那两层壳抹掉。
//
// **抹法是"换成等长空白"**（长度、行号、偏移一字不动）—— 报错里的行号就是源里的行号。

fn skip_ht(p: ptr, a: u32, b: u32) -> u32 {
    let i: u32 = a;
    while i < b && (load8(p, i) == 32 || load8(p, i) == 9) {
        i = i + 1;
    }
    return i;
}

/// 词 + `\s+`（上游 `(?:public\s+|…)` 那一格）。命中返回词后位置，否则 `FAIL`。
fn w_sp(p: ptr, i: u32, n: u32, w: str) -> u32 {
    let wl: u32 = str_len(w);
    if i + wl <= n && eq(p, i, w) == 1 {
        if i + wl < n && is_sp(load8(p, i + wl)) == 1 {
            return skip_sp(p, i + wl, n);
        }
    }
    return FAIL;
}

/// 词 + `[ \t]+`（C# 的 `using` 那两条用的是这个，不是 `\s+`）。
fn w_sp_tab(p: ptr, i: u32, n: u32, w: str) -> u32 {
    let wl: u32 = str_len(w);
    if i + wl <= n && eq(p, i, w) == 1 {
        if i + wl < n && (load8(p, i + wl) == 32 || load8(p, i + wl) == 9) {
            return skip_ht(p, i + wl, n);
        }
    }
    return FAIL;
}

/// C# 壳头那一串修饰词 `_MOD`。
fn cs_mods(p: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let going: u32 = 1;
    while going == 1 {
        let nx: u32 = w_sp(p, j, n, "public");
        if nx != FAIL {
            j = nx;
        } else {
            let a: u32 = w_sp(p, j, n, "private");
            if a != FAIL {
                j = a;
            } else {
                let b: u32 = w_sp(p, j, n, "protected");
                if b != FAIL {
                    j = b;
                } else {
                    let c: u32 = w_sp(p, j, n, "internal");
                    if c != FAIL {
                        j = c;
                    } else {
                        let d: u32 = w_sp(p, j, n, "static");
                        if d != FAIL {
                            j = d;
                        } else {
                            let e: u32 = w_sp(p, j, n, "sealed");
                            if e != FAIL {
                                j = e;
                            } else {
                                going = 0;
                            }
                        }
                    }
                }
            }
        }
    }
    return j;
}

/// Java class 头那一串 `(?:public\s+|final\s+|abstract\s+|strictfp\s+)*`。
fn java_mods(p: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let going: u32 = 1;
    while going == 1 {
        let a: u32 = w_sp(p, j, n, "public");
        if a != FAIL {
            j = a;
        } else {
            let b: u32 = w_sp(p, j, n, "final");
            if b != FAIL {
                j = b;
            } else {
                let c: u32 = w_sp(p, j, n, "abstract");
                if c != FAIL {
                    j = c;
                } else {
                    let d: u32 = w_sp(p, j, n, "strictfp");
                    if d != FAIL {
                        j = d;
                    } else {
                        going = 0;
                    }
                }
            }
        }
    }
    return j;
}

/// `(?<![\w.])` —— 前面那个字符既不是词字符也不是 `.`。
fn boundary_ok(p: ptr, i: u32) -> u32 {
    if i == 0 {
        return 1;
    }
    let c: u32 = load8(p, i - 1);
    if is_w(c) == 1 || c == 46 {
        return 0;
    }
    return 1;
}

/// `[^{;]*\{` —— 命中把 `{` 的下标写进 `outp` 返回 1。
fn to_brace(p: ptr, i: u32, n: u32, outp: ptr) -> u32 {
    let j: u32 = i;
    while j < n && load8(p, j) != 123 && load8(p, j) != 59 {
        j = j + 1;
    }
    if j < n && load8(p, j) == 123 {
        let _a: u32 = st32(outp, 0, j);
        return 1;
    }
    return 0;
}

/// `[A-Za-z_]\w*`（`dotted` = 0）或 `[A-Za-z_][\w.]*`（`dotted` = 1）之后的位置。
fn scan_name(p: ptr, i: u32, n: u32, dotted: u32) -> u32 {
    if i >= n || is_id0(load8(p, i)) == 0 {
        return FAIL;
    }
    let e: u32 = i + 1;
    while e < n && (is_w(load8(p, e)) == 1 || (dotted == 1 && load8(p, e) == 46)) {
        e = e + 1;
    }
    return e;
}

/// Java 的 `_CSHELL_HEAD`。
fn java_class_head(p: ptr, n: u32, i: u32, outp: ptr) -> u32 {
    let j: u32 = java_mods(p, i, n);
    let k: u32 = w_sp(p, j, n, "class");
    if k == FAIL {
        return 0;
    }
    let ke: u32 = scan_name(p, k, n, 0);
    if ke == FAIL {
        return 0;
    }
    return to_brace(p, ke, n, outp);
}

/// C# 的 `_CS_CLASS_HEAD`。
fn cs_class_head(p: ptr, n: u32, i: u32, outp: ptr) -> u32 {
    let j: u32 = cs_mods(p, i, n);
    let k: u32 = w_sp(p, j, n, "class");
    if k == FAIL {
        return 0;
    }
    let ke: u32 = scan_name(p, k, n, 0);
    if ke == FAIL {
        return 0;
    }
    return to_brace(p, ke, n, outp);
}

/// C# 的 `_CS_NS_DECL`（`;` 收尾，`kind` = 1）与 `_CS_NS_HEAD`（`{` 收尾，`kind` = 2）。
fn cs_ns_head(p: ptr, n: u32, i: u32, kind: u32, outp: ptr) -> u32 {
    let g: u32 = w_sp(p, i, n, "global");
    let j0: u32 = i;
    if g != FAIL {
        j0 = g;
    }
    let j: u32 = cs_mods(p, j0, n);
    let nsp: u32 = w_sp(p, j, n, "namespace");
    if nsp == FAIL {
        return 0;
    }
    let ne: u32 = scan_name(p, nsp, n, 1);
    if ne == FAIL {
        return 0;
    }
    let t: u32 = skip_sp(p, ne, n);
    if t >= n {
        return 0;
    }
    if kind == 1 && load8(p, t) == 59 {
        let _a: u32 = st32(outp, 0, t);
        return 1;
    }
    if kind == 2 && load8(p, t) == 123 {
        let _a: u32 = st32(outp, 0, t);
        return 1;
    }
    return 0;
}

/// C# 的 `_CS_USING`。
fn cs_using(p: ptr, n: u32, i: u32, outp: ptr) -> u32 {
    let k: u32 = w_sp_tab(p, i, n, "using");
    if k == FAIL {
        return 0;
    }
    let s1: u32 = w_sp_tab(p, k, n, "static");
    let k3: u32 = k;
    if s1 != FAIL {
        k3 = s1;
    }
    let e0: u32 = k3;
    if k3 < n && is_id0(load8(p, k3)) == 1 {
        let ke: u32 = scan_name(p, k3, n, 0);
        let e1: u32 = skip_ht(p, ke, n);
        if e1 < n && load8(p, e1) == 61 {
            e0 = skip_ht(p, e1 + 1, n);
        }
    }
    let ne: u32 = scan_name(p, e0, n, 1);
    if ne == FAIL {
        return 0;
    }
    let sc: u32 = skip_ht(p, ne, n);
    if sc < n && load8(p, sc) == 59 {
        let _a: u32 = st32(outp, 0, sc);
        return 1;
    }
    return 0;
}

/// 一门的头表里第 `k` 条匹配吗。命中写 `[0]` = 尾巴那个 `{`/`;` 的下标、
/// `[4]` = 1（有体）写进 `outp`，返回 1。**头表的顺序与上游逐条对齐**。
fn head_hit(p: ptr, n: u32, i: u32, lang: u32, k: u32, outp: ptr) -> u32 {
    if boundary_ok(p, i) == 0 {
        return 0;
    }
    let r: u32 = 0;
    if lang == DL_JAVA {
        if k != 0 {
            return 0;
        }
        r = java_class_head(p, n, i, outp);
    } else {
        if k == 0 {
            r = cs_using(p, n, i, outp);
        } else {
            if k == 1 {
                r = cs_ns_head(p, n, i, 1, outp);
            } else {
                if k == 2 {
                    r = cs_ns_head(p, n, i, 2, outp);
                } else {
                    r = cs_class_head(p, n, i, outp);
                }
            }
        }
    }
    if r == 1 {
        let braced: u32 = 1;
        if lang == DL_CS && (k == 0 || k == 1) {
            braced = 0;
        }
        let _b: u32 = st32(outp, 4, braced);
    }
    return r;
}

/// 这一条头是不是**透明**壳（抹完继续进去找）—— 只有 C# 的 `namespace X {`。
fn head_transparent(lang: u32, k: u32) -> u32 {
    if lang == DL_CS && k == 2 {
        return 1;
    }
    return 0;
}

/// `{` 配对（`trans_core.match_brace`）。
fn match_brace(p: ptr, open: u32, n: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = open;
    while i < n {
        let c: u32 = load8(p, i);
        if c == 123 {
            d = d + 1;
        } else {
            if c == 125 {
                d = d - 1;
                if d == 0 {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return FAIL;
}

/// `strip_shells`：按门的头表抹壳。返回 0 = 好；1 = 花括号不配平（调用方报解析错）。
fn strip_shells(mem: ptr, sniff: ptr, n: u32, lang: u32, out: ptr) -> u32 {
    let r: ptr = ptr_add(mem, M_TMP);
    let nh: u32 = 1;
    if lang == DL_CS {
        nh = 4;
    }
    return walk_shells(mem, sniff, n, 0, n, lang, nh, out, r);
}

/// `trans_core.strip_shells` 那个 `walk` 的逐行翻译
/// （Python 的 `for … else` 用 `hit` 标记落，`break` 就是"这一格已经处理完"）。
fn walk_shells(mem: ptr, sniff: ptr, n: u32, lo: u32, hi: u32, lang: u32, nh: u32,
               out: ptr, r: ptr) -> u32 {
    let i: u32 = lo;
    while i < hi {
        let hit: u32 = 0;
        let k: u32 = 0;
        while k < nh && hit == 0 {
            if head_hit(sniff, n, i, lang, k, r) == 1 {
                hit = 1;
            } else {
                k = k + 1;
            }
        }
        if hit == 0 {
            i = i + 1;
        } else {
            let j: u32 = ld32(r, 0);            // 尾巴那个 `{` 或 `;`
            let braced: u32 = ld32(r, 4);
            let endk: u32 = j;
            if braced == 1 {
                let kk: u32 = match_brace(sniff, j, n);
                if kk == FAIL {
                    return 1;
                }
                if kk >= hi {
                    return 1;
                }
                endk = kk;
                if head_transparent(lang, k) == 1 {
                    let _w: u32 = walk_shells(mem, sniff, n, j + 1, kk, lang, nh, out, r);
                }
            }
            // 抹 [i, m.end())：有体的是到 `{` 为止，没体的是到 `;` 为止 —— 两个都是 j+1
            let pe: u32 = j + 1;
            let p: u32 = i;
            while p < pe {
                if load8(out, p) != 10 {
                    store8(out, p, 32 as u8);
                }
                p = p + 1;
            }
            if braced == 1 && load8(out, endk) != 10 {
                store8(out, endk, 32 as u8);
            }
            i = endk + 1;
        }
    }
    return 0;
}

/// 扫壳之前要把**注释与字符串字面量**也抹成等长空白（`_SHELL_NOISE`）——
/// 只抹注释是不够的：`String s = "class X {";` 会让扫描把那行当一个 `class` 头，
/// 外壳从字符串**里面**开始切。
fn shell_noise(src: ptr, n: u32, dst: ptr) -> u32 {
    let _c: u32 = copy_n(dst, 0, src, 0, n);
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(src, i);
        if c == 47 && i + 1 < n && load8(src, i + 1) == 47 {
            while i < n && load8(src, i) != 10 {
                store8(dst, i, 32 as u8);
                i = i + 1;
            }
        } else {
            if c == 47 && i + 1 < n && load8(src, i + 1) == 42 {
                let k: u32 = i + 2;
                let done: u32 = 0;
                while k < n && done == 0 {
                    if load8(src, k) == 42 && k + 1 < n && load8(src, k + 1) == 47 {
                        done = 1;
                    } else {
                        k = k + 1;
                    }
                }
                let e: u32 = n;
                if done == 1 {
                    e = k + 2;
                }
                let m: u32 = i;
                while m < e {
                    if load8(src, m) != 10 {
                        store8(dst, m, 32 as u8);
                    }
                    m = m + 1;
                }
                i = e;
            } else {
                if c == 34 {
                    let j: u32 = i + 1;
                    let close: u32 = FAIL;
                    let going: u32 = 1;
                    while j < n && going == 1 {
                        let cj: u32 = load8(src, j);
                        if cj == 34 {
                            close = j;
                            going = 0;
                        } else {
                            if cj == 10 {
                                going = 0;
                            } else {
                                if cj == 92 && j + 1 < n && load8(src, j + 1) != 10 {
                                    j = j + 2;
                                } else {
                                    if cj == 92 {
                                        going = 0;
                                    } else {
                                        j = j + 1;
                                    }
                                }
                            }
                        }
                    }
                    if close != FAIL {
                        let m: u32 = i;
                        while m <= close {
                            if load8(src, m) != 10 {
                                store8(dst, m, 32 as u8);
                            }
                            m = m + 1;
                        }
                        i = close + 1;
                    } else {
                        i = i + 1;
                    }
                } else {
                    i = i + 1;
                }
            }
        }
    }
    return n;
}


// ---------------------------------------------------------------- 输出拼接（调试与发射共用）

fn app(out: ptr, o: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let _c: u32 = copy_n(out, o, str_ptr(s), 0, n);
    return o + n;
}

fn appn(out: ptr, o: u32, p: ptr, off: u32, l: u32) -> u32 {
    let _c: u32 = copy_n(out, o, p, off, l);
    return o + l;
}

/// 十进制无符号（暂存在 `M_TMP + 32`）。
fn appu(mem: ptr, out: ptr, o: u32, v: u32) -> u32 {
    let buf: ptr = ptr_add(mem, M_TMP + 32);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, ((x % 10) + 48) as u8);
        x = x / 10;
        n = n + 1;
    }
    let k: u32 = 0;
    while k < n {
        store8(out, o + k, load8(buf, n - 1 - k) as u8);
        k = k + 1;
    }
    return o + n;
}

// ---------------------------------------------------------------- 分词

fn is_hex(c: u32) -> u32 {
    if is_d(c) == 1 {
        return 1;
    }
    if c >= 97 && c <= 102 {
        return 1;
    }
    if c >= 65 && c <= 70 {
        return 1;
    }
    return 0;
}

/// 点名拒掉的复合赋值（`_REJECT_OP`）——**必须整条认出来**再拒：漏一个的后果是它被
/// 切成两半（`+=` 变成 `+` `=`），报出来的错指的不是真正的原因。
fn reject_op(p: ptr, off: u32, l: u32) -> u32 {
    if l == 2 {
        if eq(p, off, "+=") == 1 || eq(p, off, "-=") == 1 || eq(p, off, "*=") == 1
                || eq(p, off, "/=") == 1 || eq(p, off, "%=") == 1
                || eq(p, off, "&=") == 1 || eq(p, off, "|=") == 1
                || eq(p, off, "^=") == 1 {
            return 1;
        }
    }
    if l == 3 {
        if eq(p, off, "<<=") == 1 || eq(p, off, ">>=") == 1 {
            return 1;
        }
    }
    if l == 4 && eq(p, off, ">>>=") == 1 {
        return 1;
    }
    return 0;
}

/// 点名拒掉、理由要单独说的（`_REJECT_NAMED`）：`...` / `++` / `--` / `>>>` / `~`。
fn reject_named(p: ptr, off: u32, l: u32) -> u32 {
    if l == 3 {
        if eq(p, off, "...") == 1 || eq(p, off, ">>>") == 1 {
            return 1;
        }
    }
    if l == 2 {
        if eq(p, off, "++") == 1 || eq(p, off, "--") == 1 {
            return 1;
        }
    }
    if l == 1 && eq(p, off, "~") == 1 {
        return 1;
    }
    return 0;
}

/// 多字符运算符的**最长优先**表（`_TOKEN` 里 `op` 那一支的顺序）。
/// 命中把长度写进 `outp` 返回 1；不是多字符运算符返回 0。
fn op_len(p: ptr, i: u32, n: u32, outp: ptr) -> u32 {
    if i + 4 <= n && eq(p, i, ">>>=") == 1 {
        let _a: u32 = st32(outp, 0, 4);
        return 1;
    }
    if i + 3 <= n {
        if eq(p, i, ">>>") == 1 || eq(p, i, "<<=") == 1 || eq(p, i, ">>=") == 1
                || eq(p, i, "...") == 1 {
            let _a: u32 = st32(outp, 0, 3);
            return 1;
        }
    }
    if i + 2 <= n {
        if eq(p, i, "+=") == 1 || eq(p, i, "-=") == 1 || eq(p, i, "*=") == 1
                || eq(p, i, "/=") == 1 || eq(p, i, "%=") == 1
                || eq(p, i, "&=") == 1 || eq(p, i, "|=") == 1 || eq(p, i, "^=") == 1
                || eq(p, i, "<<") == 1 || eq(p, i, ">>") == 1 || eq(p, i, "<=") == 1
                || eq(p, i, ">=") == 1 || eq(p, i, "==") == 1 || eq(p, i, "!=") == 1
                || eq(p, i, "&&") == 1 || eq(p, i, "||") == 1 || eq(p, i, "++") == 1
                || eq(p, i, "--") == 1 {
            let _a: u32 = st32(outp, 0, 2);
            return 1;
        }
    }
    return 0;
}

/// 单字符运算符那一支（`[-+*/%&|^~!<>=();,{}\[\]?:#]`）。
fn is_op1(c: u32) -> u32 {
    if c == 45 || c == 43 || c == 42 || c == 47 || c == 37 {
        return 1;
    }
    if c == 38 || c == 124 || c == 94 || c == 126 || c == 33 {
        return 1;
    }
    if c == 60 || c == 62 || c == 61 {
        return 1;
    }
    if c == 40 || c == 41 || c == 59 || c == 44 || c == 123 || c == 125 {
        return 1;
    }
    if c == 91 || c == 93 || c == 63 || c == 58 || c == 35 {
        return 1;
    }
    return 0;
}

/// `_PRE`（`tools/jtrans.py`）在**解析之前**点名拒绝的那些构造。
///
/// 孪生这边它是**兜底**：只在解析已经失败之后跑 —— 正常输入走不到这里，所以不会
/// 误伤。命中就把"解析不过（2）"改回参考实现的说法："子集外（1）"。不这么做，
/// 同一条输入在两边给出不同的退出码（`lomtrans_test` 就是这么红起来的）。
fn pc_skip_sp(p: ptr, i: u32, n: u32) -> u32 {
    let k: u32 = i;
    while k < n && is_sp(load8(p, k)) == 1 {
        k = k + 1;
    }
    return k;
}

fn pc_word_at(p: ptr, i: u32, j: u32, lit: str) -> u32 {
    let l: u32 = j - i;
    if l != str_len(lit) {
        return 0;
    }
    let k: u32 = 0;
    while k < l {
        if load8(p, i + k) != (str_byte(lit, k) as u32) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

fn pc_word(p: ptr, off: u32, n: u32, lit: str) -> u32 {
    let j: u32 = off;
    while j < n && is_w(load8(p, j)) == 1 {
        j = j + 1;
    }
    return pc_word_at(p, off, j, lit);
}

fn pc_reject(p: ptr, n: u32, lang: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c == 64 && i + 1 < n && is_id0(load8(p, i + 1)) == 1 {
            return 1;                                   // 注解
        }
        if c == 45 && i + 1 < n && load8(p, i + 1) == 62 {
            return 1;                                   // lambda 的 `->`
        }
        if c == 46 && i + 1 < n && pc_word(p, i + 1, n, "class") == 1 {
            return 1;                                   // `X.class`
        }
        if is_d(c) == 1 && i + 2 < n && load8(p, i + 1) == 46
            && is_d(load8(p, i + 2)) == 1 {
            return 1;                                   // 浮点字面量
        }
        if is_id0(c) == 1 {
            let j: u32 = i + 1;
            while j < n && is_w(load8(p, j)) == 1 {
                j = j + 1;
            }
            if pc_word_at(p, i, j, "synchronized") == 1
                || pc_word_at(p, i, j, "instanceof") == 1
                || pc_word_at(p, i, j, "throws") == 1
                || pc_word_at(p, i, j, "enum") == 1
                || pc_word_at(p, i, j, "interface") == 1
                || pc_word_at(p, i, j, "record") == 1
                || pc_word_at(p, i, j, "sealed") == 1
                || pc_word_at(p, i, j, "permits") == 1
                || pc_word_at(p, i, j, "null") == 1
                || pc_word_at(p, i, j, "float") == 1
                || pc_word_at(p, i, j, "double") == 1 {
                return 1;
            }
            if lang == DL_CS && (pc_word_at(p, i, j, "string") == 1
                || pc_word_at(p, i, j, "object") == 1
                || pc_word_at(p, i, j, "decimal") == 1) {
                return 1;
            }
            // 参考实现的 `import` / `package` 那条只对 Java 跑（C# 用 `using`）。
            if lang == DL_JAVA && (pc_word_at(p, i, j, "import") == 1
                || pc_word_at(p, i, j, "package") == 1) {
                return 1;
            }
            // `String` 是 Java 类型表里明确拒的那一个 —— 但**只在它当类型名的时候**。
            // `List<String>` 的参考结果是"期望类型名，得到 List"（2）：泛型先把它挡住了，
            // 这里再按 `String` 报 1 就比参考早了。
            if lang == DL_JAVA && pc_word_at(p, i, j, "String") == 1 {
                let k: u32 = pc_skip_sp(p, j, n);
                if k < n && is_id0(load8(p, k)) == 1 {
                    return 1;
                }
            }
            if pc_word_at(p, i, j, "this") == 1 || pc_word_at(p, i, j, "super") == 1 {
                let k: u32 = pc_skip_sp(p, j, n);
                if k < n && load8(p, k) == 46 {
                    return 1;                           // `this.x` / `super.x`
                }
            }
            if pc_word_at(p, i, j, "static") == 1 {
                let k: u32 = pc_skip_sp(p, j, n);
                if k < n && load8(p, k) == 123 {
                    return 1;                           // 静态初始化块
                }
            }
            if lang == DL_JAVA && c >= 65 && c <= 90 {  // 构造器: Upper(...) {
                let k: u32 = pc_skip_sp(p, j, n);
                if k < n && load8(p, k) == 40 {
                    let q: u32 = k + 1;
                    let cl: u32 = 0;
                    while q < n && cl == 0 {
                        let d: u32 = load8(p, q);
                        if d == 41 {
                            cl = 1;
                        } else if d == 59 || d == 123 || d == 10 {
                            q = n;
                        } else {
                            q = q + 1;
                        }
                    }
                    if cl == 1 {
                        let k2: u32 = pc_skip_sp(p, q + 1, n);
                        if k2 < n && load8(p, k2) == 123 {
                            return 1;
                        }
                    }
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return 0;
}

/// `trans_core.tokens`。错误写进 `M_TMP + 8`：0 = 好，1 = 子集外，2 = 认不出的字符。
/// 返回记号数。
fn tokenize(mem: ptr, src: ptr, n: u32) -> u32 {
    let tk: ptr = ptr_add(mem, M_TOK);
    let st: ptr = ptr_add(mem, M_TMP);
    let _e0: u32 = st32(st, 8, 0);
    let _l0: u32 = st32(st, 12, 1);
    let cnt: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(src, i);
        let line: u32 = ld32(st, 12);
        if is_sp(c) == 1 {
            let j: u32 = i;
            while j < n && is_sp(load8(src, j)) == 1 {
                if load8(src, j) == 10 {
                    let _l: u32 = st32(st, 12, ld32(st, 12) + 1);
                }
                j = j + 1;
            }
            i = j;
        } else {
            if c == 47 && i + 1 < n && load8(src, i + 1) == 47 {
                let j: u32 = i;
                while j < n && load8(src, j) != 10 {
                    j = j + 1;
                }
                i = j;
            } else {
                if c == 47 && i + 1 < n && load8(src, i + 1) == 42 {
                    let j: u32 = i + 2;
                    let done: u32 = 0;
                    while j < n && done == 0 {
                        if load8(src, j) == 42 && j + 1 < n && load8(src, j + 1) == 47 {
                            done = 1;
                        } else {
                            if load8(src, j) == 10 {
                                let _l: u32 = st32(st, 12, ld32(st, 12) + 1);
                            }
                            j = j + 1;
                        }
                    }
                    if done == 1 {
                        i = j + 2;
                    } else {
                        i = n;
                    }
                } else {
                    if is_id0(c) == 1 {
                        let j: u32 = i + 1;
                        while j < n && is_w(load8(src, j)) == 1 {
                            j = j + 1;
                        }
                        if cnt < TMAX {
                            let _a: u32 = st32(tk, cnt * 16 + TK_OFF, i);
                            let _b: u32 = st32(tk, cnt * 16 + TK_LEN, j - i);
                            let _c: u32 = st32(tk, cnt * 16 + TK_KIND, 1);
                            let _d: u32 = st32(tk, cnt * 16 + TK_LINE, line);
                        }
                        cnt = cnt + 1;
                        i = j;
                    } else {
                        if is_d(c) == 1 && c == 48 && i + 1 < n
                                && (load8(src, i + 1) == 120 || load8(src, i + 1) == 88)
                                && i + 2 < n && is_hex(load8(src, i + 2)) == 1 {
                            let j: u32 = i + 2;
                            while j < n && is_hex(load8(src, j)) == 1 {
                                j = j + 1;
                            }
                            if cnt < TMAX {
                                let _a: u32 = st32(tk, cnt * 16 + TK_OFF, i);
                                let _b: u32 = st32(tk, cnt * 16 + TK_LEN, j - i);
                                let _c: u32 = st32(tk, cnt * 16 + TK_KIND, 2);
                                let _d: u32 = st32(tk, cnt * 16 + TK_LINE, line);
                            }
                            cnt = cnt + 1;
                            i = j;
                        } else {
                            if is_d(c) == 1 {
                                let j: u32 = i;
                                while j < n && is_d(load8(src, j)) == 1 {
                                    j = j + 1;
                                }
                                if cnt < TMAX {
                                    let _a: u32 = st32(tk, cnt * 16 + TK_OFF, i);
                                    let _b: u32 = st32(tk, cnt * 16 + TK_LEN, j - i);
                                    let _c: u32 = st32(tk, cnt * 16 + TK_KIND, 2);
                                    let _d: u32 = st32(tk, cnt * 16 + TK_LINE, line);
                                }
                                cnt = cnt + 1;
                                i = j;
                            } else {
                                let op: u32 = op_len(src, i, n, ptr_add(st, 16));
                                let l: u32 = 1;
                                if op == 1 {
                                    l = ld32(st, 16);
                                } else {
                                    if is_op1(c) == 0 {
                                        let _e: u32 = st32(st, 8, 2);
                                        return cnt;
                                    }
                                }
                                if reject_named(src, i, l) == 1 {
                                    let _e: u32 = st32(st, 8, 1);
                                    return cnt;
                                }
                                if reject_op(src, i, l) == 1 {
                                    let _e: u32 = st32(st, 8, 1);
                                    return cnt;
                                }
                                if cnt < TMAX {
                                    let _a: u32 = st32(tk, cnt * 16 + TK_OFF, i);
                                    let _b: u32 = st32(tk, cnt * 16 + TK_LEN, l);
                                    let _c: u32 = st32(tk, cnt * 16 + TK_KIND, 3);
                                    let _d: u32 = st32(tk, cnt * 16 + TK_LINE, line);
                                }
                                cnt = cnt + 1;
                                i = i + l;
                            }
                        }
                    }
                }
            }
        }
    }
    return cnt;
}

/// `--tokens`：每个记号一行 `kind text line`（开发期对拍用，判据不看不比）。
fn dump_tokens(mem: ptr, src: ptr, cnt: u32, out: ptr) -> u32 {
    let tk: ptr = ptr_add(mem, M_TOK);
    let o: u32 = 0;
    let i: u32 = 0;
    while i < cnt {
        let k: u32 = ld32(tk, i * 16 + TK_KIND);
        if k == 1 {
            o = app(out, o, "id ");
        } else {
            if k == 2 {
                o = app(out, o, "num ");
            } else {
                o = app(out, o, "op ");
            }
        }
        o = appn(out, o, src, ld32(tk, i * 16 + TK_OFF), ld32(tk, i * 16 + TK_LEN));
        o = app(out, o, " ");
        o = appu(mem, out, o, ld32(tk, i * 16 + TK_LINE));
        o = app(out, o, "\n");
        i = i + 1;
    }
    return o;
}


// ---------------------------------------------------------------- 语法树
//
// 上游那一串 `class Lit/Var/Call/…` 是 Python 对象；本语言没有和类型，所以是一张
// **定长节点表**（8 个字一条）＋一张**列表区**＋一张**函数表**。
//
// 列表区**按递归深度分段**（每层 256 项，最多 16 层）：解析是递归下降，
// 内层列表（调用的实参）会在外层列表（语句块）还没收尾时就先写进去 ——
// 共用一个游标的话外层会**把内层的项也算进来**。分段之后每层各写各的，
// 而"段内下标"与"绝对下标"是同一个线性映射（`d*256 + j`），发射器不用知道深度。

fn node_new(mem: ptr, kind: u32, line: u32) -> u32 {
    let nd: ptr = ptr_add(mem, M_NODE);
    let k: u32 = ld32(ptr_add(mem, M_TMP), 20);
    if k >= NMAX - 1 {
        return 0;
    }
    let idx: u32 = k + 1;
    let _a: u32 = st32(nd, idx * 32 + ND_KIND, kind);
    let _b: u32 = st32(nd, idx * 32 + ND_A, 0);
    let _c: u32 = st32(nd, idx * 32 + ND_B, 0);
    let _d: u32 = st32(nd, idx * 32 + ND_C, 0);
    let _e: u32 = st32(nd, idx * 32 + ND_D, 0);
    let _f: u32 = st32(nd, idx * 32 + ND_E, 0);
    let _g: u32 = st32(nd, idx * 32 + ND_LINE, line);
    let _j: u32 = st32(nd, idx * 32 + ND_F, 0);
    let _h: u32 = st32(ptr_add(mem, M_TMP), 20, idx);
    return idx;
}

fn nd_set(mem: ptr, n: u32, w: u32, v: u32) -> u32 {
    if n == 0 {
        return 0;
    }
    return st32(ptr_add(mem, M_NODE), n * 32 + w, v);
}

fn nd_get(mem: ptr, n: u32, w: u32) -> u32 {
    if n == 0 {
        return 0;
    }
    return ld32(ptr_add(mem, M_NODE), n * 32 + w);
}

/// 列表区的分配（`M_TMP` 里的几格）:
///   +36 当前深度（0 = 最外）   +44 **单调的区号计数器**（永不重用）
///   +512 + d*4  第 d 层的**区号**    +768 + d*4  第 d 层的**游标**
///
/// 两个坑都在这里: ① 每层的区号最初直接用"深度"，于是内层列表写进外层还没收尾的
/// 那一区（调用的实参挤进语句块）；② 改成按深度分区之后，**同一个深度的两处列表
/// 会重用同一区** —— 每个函数的体都在同一深度，于是先建的函数体被后建的盖掉
/// （症状：所有函数都指向**最后一个**函数的体）。现在区号单调递增、**永不重用**：
/// 一个列表写完就不再被碰，谁引用它都对。
fn li_depth(mem: ptr) -> u32 {
    return ld32(ptr_add(mem, M_TMP), 36);
}

fn li_enter(mem: ptr) -> u32 {
    let d: u32 = li_depth(mem);
    if d >= 15 {
        return FAIL;
    }
    let r: u32 = ld32(ptr_add(mem, M_TMP), 44) + 1;
    if r >= 255 {
        return FAIL;
    }
    let _a: u32 = st32(ptr_add(mem, M_TMP), 44, r);
    let _b: u32 = st32(ptr_add(mem, M_TMP), 36, d + 1);
    let _c: u32 = st32(ptr_add(mem, M_TMP), 512 + (d + 1) * 4, r);
    let _e: u32 = st32(ptr_add(mem, M_TMP), 768 + (d + 1) * 4, 0);
    return d + 1;
}

fn li_leave(mem: ptr) -> u32 {
    let d: u32 = li_depth(mem);
    if d == 0 {
        return FAIL;
    }
    return st32(ptr_add(mem, M_TMP), 36, d - 1);
}

/// 当前区里这个列表的**起始下标**（区号 * 64 + 区内游标）。
fn li_here(mem: ptr) -> u32 {
    let d: u32 = li_depth(mem);
    let r: u32 = ld32(ptr_add(mem, M_TMP), 512 + d * 4);
    let j: u32 = ld32(ptr_add(mem, M_TMP), 768 + d * 4);
    return r * 64 + j;
}

fn li_push(mem: ptr, v: u32) -> u32 {
    let d: u32 = li_depth(mem);
    let r: u32 = ld32(ptr_add(mem, M_TMP), 512 + d * 4);
    let j: u32 = ld32(ptr_add(mem, M_TMP), 768 + d * 4);
    if j >= 64 {
        return FAIL;
    }
    let _a: u32 = st32(ptr_add(mem, M_LIST), (r * 64 + j) * 4, v);
    let _b: u32 = st32(ptr_add(mem, M_TMP), 768 + d * 4, j + 1);
    return r * 64 + j;
}

fn li_get(mem: ptr, i: u32) -> u32 {
    return ld32(ptr_add(mem, M_LIST), i * 4);
}

/// 函数表（`Fn` 那一条）: ty(off,len) name(off,len) params(start,count)
/// body(start,count) line —— 8 个格，32 字节。
fn fn_new(mem: ptr) -> u32 {
    let k: u32 = ld32(ptr_add(mem, M_TMP), 40);
    if k >= FNMAX - 1 {
        return FAIL;
    }
    let idx: u32 = k + 1;
    let _a: u32 = st32(ptr_add(mem, M_TMP), 40, idx);
    let i: u32 = 0;
    while i < 8 {
        let _b: u32 = st32(ptr_add(mem, M_FN), idx * 32 + i * 4, 0);
        i = i + 1;
    }
    return idx;
}

fn fn_set(mem: ptr, f: u32, i: u32, v: u32) -> u32 {
    return st32(ptr_add(mem, M_FN), f * 32 + i * 4, v);
}

fn fn_get(mem: ptr, f: u32, i: u32) -> u32 {
    return ld32(ptr_add(mem, M_FN), f * 32 + i * 4);
}

// ---------------------------------------------------------------- 解析
//
// 解析器状态格（都在 `M_TMP` 里）:
//   +256 记号下标   +260 记号数   +264 方言号   +268 错误码（0 好 / 1 子集外 / 2 解析不过）
//   +272 错误行     +276 spec 起点记号          +320/324 ident 结果
//   +328/332 spec 的名字                        +336 spec 的行号
//   +400/404 暂存 1（then） +408/412 暂存 2（else） +416/420 暂存 3（for 体）
//   +432/436 暂存 4（函数体）

const PS_I: u32 = 256;
const PS_N: u32 = 260;
const PS_ERR: u32 = 268;
const PS_SPEC0: u32 = 276;

fn pst(mem: ptr) -> ptr {
    return ptr_add(mem, M_TMP);
}

/// 记号文本的 (off, len)（越界给空串 —— Python 的 `peek` 越界给 `("eof","",最后一行)`）。
fn tk_off(mem: ptr, k: u32) -> u32 {
    if k >= ld32(pst(mem), PS_N) {
        return 0;
    }
    return ld32(ptr_add(mem, M_TOK), k * 16 + TK_OFF);
}

fn tk_len(mem: ptr, k: u32) -> u32 {
    if k >= ld32(pst(mem), PS_N) {
        return 0;
    }
    return ld32(ptr_add(mem, M_TOK), k * 16 + TK_LEN);
}

fn tk_kind(mem: ptr, k: u32) -> u32 {
    if k >= ld32(pst(mem), PS_N) {
        return 0;
    }
    return ld32(ptr_add(mem, M_TOK), k * 16 + TK_KIND);
}

fn tk_line(mem: ptr, k: u32) -> u32 {
    let n: u32 = ld32(pst(mem), PS_N);
    if n == 0 {
        return 1;
    }
    if k >= n {
        return ld32(ptr_add(mem, M_TOK), (n - 1) * 16 + TK_LINE);
    }
    return ld32(ptr_add(mem, M_TOK), k * 16 + TK_LINE);
}

/// `self.peek(k)[1] == text`
fn p_at(mem: ptr, src: ptr, text: str, k: u32) -> u32 {
    let j: u32 = ld32(pst(mem), PS_I) + k;
    let l: u32 = tk_len(mem, j);
    if l != str_len(text) {
        return 0;
    }
    return eq(src, tk_off(mem, j), text);
}

/// 出错的两种（上游 `Unsupported` = 退出 1 / `CError` = 退出 2）。只记码与行号。
///
/// **第一条错说了算**：早先的点名拒绝（子集外 = 1）不能被后面跌跌撞撞的
/// "这里本该有个 `;`"（解析不过 = 2）盖掉。参考实现也是先抛先赢 —— 它先跑
/// `_precheck`，命中就 `Unsupported`，根本走不到解析器。覆盖会让同一条输入在
/// 两边给出不同的退出码（`loment_trans_test` 就是这么红起来的）。
fn perr(mem: ptr, code: u32) -> u32 {
    let st: ptr = pst(mem);
    if ld32(st, PS_ERR) == 0 {
        let _a: u32 = st32(st, PS_ERR, code);
        let _b: u32 = st32(st, 272, tk_line(mem, ld32(st, PS_I)));
    }
    return 0;
}

fn p_want(mem: ptr, src: ptr, text: str) -> u32 {
    if p_at(mem, src, text, 0) == 0 {
        return perr(mem, 2);
    }
    let _a: u32 = st32(pst(mem), PS_I, ld32(pst(mem), PS_I) + 1);
    return 1;
}

/// `self.ident()` —— 命中把 (off, len) 写进 `+320/+324`，返回长度；否则 0。
fn p_ident(mem: ptr, src: ptr) -> u32 {
    let st: ptr = pst(mem);
    let j: u32 = ld32(st, PS_I);
    if tk_kind(mem, j) != 1 {
        let _e: u32 = perr(mem, 2);
        return 0;
    }
    let l: u32 = tk_len(mem, j);
    let _a: u32 = st32(st, 320, tk_off(mem, j));
    let _b: u32 = st32(st, 324, l);
    let _c: u32 = st32(st, PS_I, j + 1);
    return l;
}

/// 刚吃掉的那段词里有没有"常量标志词"（上游 `d.const_words & self.last_spec`）。
fn spec_has_const(mem: ptr, src: ptr, from: u32, to: u32) -> u32 {
    let i: u32 = from;
    while i < to {
        let o: u32 = ld32(ptr_add(mem, M_TOK), i * 16 + TK_OFF);
        let l: u32 = ld32(ptr_add(mem, M_TOK), i * 16 + TK_LEN);
        if word_has(mem, SEG_CONST_WORDS, src, o, l) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 类型名 -> **类型 id**。这一族的类型是**有限的一小撮**（十个），所以树里存 id 而不是
/// 串 —— 串存起来要一块池子，而池子的偏移与"源里的偏移"是两码事，打印时必然要分缓冲。
fn ty_id(p: ptr, l: u32) -> u32 {
    if l == 2 && eq(p, 0, "i8") == 1 {
        return 1;
    }
    if l == 2 && eq(p, 0, "u8") == 1 {
        return 2;
    }
    if l == 3 && eq(p, 0, "i16") == 1 {
        return 3;
    }
    if l == 3 && eq(p, 0, "u16") == 1 {
        return 4;
    }
    if l == 3 && eq(p, 0, "i32") == 1 {
        return 5;
    }
    if l == 3 && eq(p, 0, "u32") == 1 {
        return 6;
    }
    if l == 3 && eq(p, 0, "i64") == 1 {
        return 7;
    }
    if l == 3 && eq(p, 0, "u64") == 1 {
        return 8;
    }
    if l == 4 && eq(p, 0, "bool") == 1 {
        return 9;
    }
    if l == 2 && eq(p, 0, "()") == 1 {
        return 10;
    }
    return 0;
}

fn ty_text(id: u32) -> str {
    if id == 1 {
        return "i8";
    }
    if id == 2 {
        return "u8";
    }
    if id == 3 {
        return "i16";
    }
    if id == 4 {
        return "u16";
    }
    if id == 5 {
        return "i32";
    }
    if id == 6 {
        return "u32";
    }
    if id == 7 {
        return "i64";
    }
    if id == 8 {
        return "u64";
    }
    if id == 9 {
        return "bool";
    }
    return "()";
}

/// `Parser.spec()` —— 命中：类型写进 `M_NAME`（off/len），名字写进 `+328/+332`，
/// 行号写进 `+336`，返回 1。
fn p_spec(mem: ptr, src: ptr, lang: u32) -> u32 {
    let st: ptr = pst(mem);
    let _a: u32 = st32(st, PS_SPEC0, ld32(st, PS_I));
    let raw: ptr = ptr_add(mem, M_NAME + 512);
    let rl: u32 = 0;
    let words: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        let j: u32 = ld32(st, PS_I);
        if tk_kind(mem, j) != 1 {
            going = 0;
        } else {
            let o: u32 = tk_off(mem, j);
            let l: u32 = tk_len(mem, j);
            if word_has(mem, SEG_SPEC_WORDS, src, o, l) == 0 {
                going = 0;
            } else {
                if word_has(mem, SEG_BAD_SPEC, src, o, l) == 1 {
                    let _e: u32 = perr(mem, 1);
                    return 0;
                }
                if word_has(mem, SEG_LINKAGE, src, o, l) == 1 {
                    let _i: u32 = st32(st, PS_I, j + 1);
                } else {
                    if word_has(mem, SEG_AGG, src, o, l) == 1 {
                        let _e: u32 = perr(mem, 1);
                        return 0;
                    }
                    if words > 0 {
                        store8(raw, rl, 32 as u8);
                        rl = rl + 1;
                    }
                    let _c: u32 = copy_n(raw, rl, src, o, l);
                    rl = rl + l;
                    words = words + 1;
                    let _i2: u32 = st32(st, PS_I, j + 1);
                }
            }
        }
    }
    if words == 0 {
        let _e: u32 = perr(mem, 2);
        return 0;
    }
    let line: u32 = tk_line(mem, ld32(st, PS_SPEC0));
    let tl: u32 = type_of(mem, raw, 0, rl, ptr_add(mem, M_NAME));
    if tl == 0 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let tid: u32 = ty_id(ptr_add(mem, M_NAME), tl);
    if tid == 0 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let _t: u32 = st32(st, 344, tid);
    let nl: u32 = p_ident(mem, src);
    if nl == 0 {
        return 0;
    }
    if p_at(mem, src, "*", 0) == 1 || p_at(mem, src, "[", 0) == 1 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let _b: u32 = st32(st, 328, ld32(st, 320));
    let _c: u32 = st32(st, 332, ld32(st, 324));
    let _d: u32 = st32(st, 336, line);
    return 1;
}

/// 二元运算符的编号（`_BIN` 那张表）—— 0 = 不是二元运算符。
fn bin_of(p: ptr, off: u32, l: u32) -> u32 {
    if l == 1 {
        if eq(p, off, "*") == 1 {
            return 1;
        }
        if eq(p, off, "/") == 1 {
            return 2;
        }
        if eq(p, off, "%") == 1 {
            return 3;
        }
        if eq(p, off, "+") == 1 {
            return 4;
        }
        if eq(p, off, "-") == 1 {
            return 5;
        }
        if eq(p, off, "<") == 1 {
            return 8;
        }
        if eq(p, off, ">") == 1 {
            return 9;
        }
        if eq(p, off, "&") == 1 {
            return 14;
        }
        if eq(p, off, "^") == 1 {
            return 15;
        }
        if eq(p, off, "|") == 1 {
            return 16;
        }
        return 0;
    }
    if l == 2 {
        if eq(p, off, "<<") == 1 {
            return 6;
        }
        if eq(p, off, ">>") == 1 {
            return 7;
        }
        if eq(p, off, "<=") == 1 {
            return 10;
        }
        if eq(p, off, ">=") == 1 {
            return 11;
        }
        if eq(p, off, "==") == 1 {
            return 12;
        }
        if eq(p, off, "!=") == 1 {
            return 13;
        }
        if eq(p, off, "&&") == 1 {
            return 17;
        }
        if eq(p, off, "||") == 1 {
            return 18;
        }
    }
    return 0;
}

/// `_PRECOF`：低到高 1..10。
fn precof_of(c: u32) -> u32 {
    if c >= 1 && c <= 3 {
        return 10;
    }
    if c == 4 || c == 5 {
        return 9;
    }
    if c == 6 || c == 7 {
        return 8;
    }
    if c >= 8 && c <= 11 {
        return 7;
    }
    if c == 12 || c == 13 {
        return 6;
    }
    if c == 14 {
        return 5;
    }
    if c == 15 {
        return 4;
    }
    if c == 16 {
        return 3;
    }
    if c == 17 {
        return 2;
    }
    return 1;
}

/// 操作数按什么算（`_BIN` 中间那格）：`&&`/`||` 是 bool，其余是 int（1 = bool）。
fn bin_want(c: u32) -> u32 {
    if c == 17 || c == 18 {
        return 1;
    }
    return 0;
}

/// 结果是不是 bool（`_BIN` 第三格）。
fn bin_isbool(c: u32) -> u32 {
    if c >= 8 && c <= 13 {
        return 1;
    }
    if c == 17 || c == 18 {
        return 1;
    }
    return 0;
}

/// 发出去的运算符文本（这一族与 Loment 同名）。
fn bin_text(c: u32) -> str {
    if c == 1 {
        return "*";
    }
    if c == 2 {
        return "/";
    }
    if c == 3 {
        return "%";
    }
    if c == 4 {
        return "+";
    }
    if c == 5 {
        return "-";
    }
    if c == 6 {
        return "<<";
    }
    if c == 7 {
        return ">>";
    }
    if c == 8 {
        return "<";
    }
    if c == 9 {
        return ">";
    }
    if c == 10 {
        return "<=";
    }
    if c == 11 {
        return ">=";
    }
    if c == 12 {
        return "==";
    }
    if c == 13 {
        return "!=";
    }
    if c == 14 {
        return "&";
    }
    if c == 15 {
        return "^";
    }
    if c == 16 {
        return "|";
    }
    if c == 17 {
        return "&&";
    }
    return "||";
}

/// `Parser.binary(minp)`。
fn p_binary(mem: ptr, src: ptr, lang: u32, minp: u32) -> u32 {
    let left: u32 = p_unary(mem, src, lang);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        let st: ptr = pst(mem);
        let j: u32 = ld32(st, PS_I);
        let o: u32 = tk_off(mem, j);
        let l: u32 = tk_len(mem, j);
        let k: u32 = tk_kind(mem, j);
        // 赋值/三元**点名**拒（别掉进"期望 `;`"那种指不到点子的报错里）
        if k == 3 {
            if l == 1 && (eq(src, o, "?") == 1 || eq(src, o, "=") == 1) {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            if l == 2 && (eq(src, o, "+=") == 1 || eq(src, o, "-=") == 1
                          || eq(src, o, "*=") == 1 || eq(src, o, "/=") == 1
                          || eq(src, o, "%=") == 1 || eq(src, o, "&=") == 1
                          || eq(src, o, "|=") == 1 || eq(src, o, "^=") == 1) {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
        }
        let c: u32 = 0;
        if k == 3 {
            c = bin_of(src, o, l);
        }
        if c == 0 {
            return left;
        }
        if precof_of(c) < minp {
            return left;
        }
        let _i: u32 = st32(st, PS_I, j + 1);
        let right: u32 = p_binary(mem, src, lang, precof_of(c) + 1);
        if right == 0 {
            return 0;
        }
        let n: u32 = node_new(mem, NK_BIN, tk_line(mem, j));
        if n == 0 {
            let _e: u32 = perr(mem, 1);
            return 0;
        }
        let _a: u32 = nd_set(mem, n, ND_A, c);
        let _b: u32 = nd_set(mem, n, ND_B, left);
        let _c: u32 = nd_set(mem, n, ND_C, right);
        left = n;
    }
    return left;
}

/// `Parser.unary()`。`~` 已经在分词那一步被点名拒掉了（不在这里）。
fn p_unary(mem: ptr, src: ptr, lang: u32) -> u32 {
    let st: ptr = pst(mem);
    let j: u32 = ld32(st, PS_I);
    let o: u32 = tk_off(mem, j);
    let l: u32 = tk_len(mem, j);
    if tk_kind(mem, j) == 3 {
        if l == 1 && (eq(src, o, "-") == 1 || eq(src, o, "!") == 1) {
            let _i: u32 = st32(st, PS_I, j + 1);
            let e: u32 = p_unary(mem, src, lang);
            if e == 0 {
                return 0;
            }
            let n: u32 = node_new(mem, NK_UN, tk_line(mem, j));
            if n == 0 {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            let op: u32 = 1;
            if eq(src, o, "!") == 1 {
                op = 2;
            }
            let _a: u32 = nd_set(mem, n, ND_A, op);
            let _b: u32 = nd_set(mem, n, ND_B, e);
            return n;
        }
        if l == 1 && (eq(src, o, "+") == 1 || eq(src, o, "*") == 1
                      || eq(src, o, "&") == 1) {
            let _e: u32 = perr(mem, 1);
            return 0;
        }
    }
    return p_primary(mem, src, lang);
}

fn p_primary(mem: ptr, src: ptr, lang: u32) -> u32 {
    let st: ptr = pst(mem);
    let j: u32 = ld32(st, PS_I);
    let o: u32 = tk_off(mem, j);
    let l: u32 = tk_len(mem, j);
    let k: u32 = tk_kind(mem, j);
    let line: u32 = tk_line(mem, j);
    if k == 3 && l == 1 && eq(src, o, "(") == 1 {
        let _i: u32 = st32(st, PS_I, j + 1);
        let e: u32 = p_expr(mem, src, lang);
        if e == 0 {
            return 0;
        }
        if p_want(mem, src, ")") == 0 {
            return 0;
        }
        return e;
    }
    if k == 2 {
        let _i: u32 = st32(st, PS_I, j + 1);
        let n: u32 = node_new(mem, NK_LIT, line);
        let _a: u32 = nd_set(mem, n, ND_A, num_val(src, o, l));
        return n;
    }
    if k == 1 && (eq(src, o, "true") == 1 || eq(src, o, "false") == 1) {
        let _i: u32 = st32(st, PS_I, j + 1);
        let n: u32 = node_new(mem, NK_LIT, line);
        let bv: u32 = 0;
        if eq(src, o, "true") == 1 {
            bv = 1;
        }
        let _a: u32 = nd_set(mem, n, ND_A, bv);
        let _b: u32 = nd_set(mem, n, ND_B, 1);
        return n;
    }
    if k == 1 {
        if word_has(mem, SEG_KW, src, o, l) == 1 {
            let _e: u32 = perr(mem, 1);
            return 0;
        }
        let _i: u32 = st32(st, PS_I, j + 1);
        if p_at(mem, src, ".", 0) == 1 {
            let _e: u32 = perr(mem, 1);
            return 0;
        }
        if p_at(mem, src, "(", 0) == 1 {
            let _i2: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
            if li_enter(mem) == FAIL {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            let a0: u32 = li_here(mem);
            let an: u32 = 0;
            if p_at(mem, src, ")", 0) == 0 {
                let e1: u32 = p_expr(mem, src, lang);
                if e1 == 0 {
                    return 0;
                }
                let _p: u32 = li_push(mem, e1);
                an = 1;
                while p_at(mem, src, ",", 0) == 1 {
                    let _c1: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                    let e2: u32 = p_expr(mem, src, lang);
                    if e2 == 0 {
                        return 0;
                    }
                    let _p2: u32 = li_push(mem, e2);
                    an = an + 1;
                }
            }
            let _lv: u32 = li_leave(mem);
            if p_want(mem, src, ")") == 0 {
                return 0;
            }
            let n: u32 = node_new(mem, NK_CALL, line);
            let _a: u32 = nd_set(mem, n, ND_A, o);
            let _b: u32 = nd_set(mem, n, ND_B, l);
            let _c: u32 = nd_set(mem, n, ND_C, a0);
            let _d: u32 = nd_set(mem, n, ND_D, an);
            return n;
        }
        let n: u32 = node_new(mem, NK_VAR, line);
        let _a: u32 = nd_set(mem, n, ND_A, o);
        let _b: u32 = nd_set(mem, n, ND_B, l);
        return n;
    }
    let _e: u32 = perr(mem, 2);
    return 0;
}

fn p_expr(mem: ptr, src: ptr, lang: u32) -> u32 {
    return p_binary(mem, src, lang, 1);
}

/// `Parser.block_or_stmt()` —— 结果 (start, count) 写进 `outp`。
fn p_block_or_stmt(mem: ptr, src: ptr, lang: u32, outp: ptr) -> u32 {
    if p_at(mem, src, "{", 0) == 1 {
        return p_block(mem, src, lang, outp);
    }
    if li_enter(mem) == FAIL {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let a0: u32 = li_here(mem);
    let s: u32 = p_stmt(mem, src, lang);
    if s == 0 {
        return 0;
    }
    let _p: u32 = li_push(mem, s);
    let _lv: u32 = li_leave(mem);
    let _a: u32 = st32(outp, 0, a0);
    let _b: u32 = st32(outp, 4, 1);
    return 1;
}

/// `Parser.block()` —— 结果 (start, count) 写进 `outp`。
fn p_block(mem: ptr, src: ptr, lang: u32, outp: ptr) -> u32 {
    let st: ptr = pst(mem);
    if p_want(mem, src, "{") == 0 {
        return 0;
    }
    if li_enter(mem) == FAIL {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let a0: u32 = li_here(mem);
    let cnt: u32 = 0;
    while p_at(mem, src, "}", 0) == 0 {
        if tk_kind(mem, ld32(st, PS_I)) == 0 {
            let _e: u32 = perr(mem, 2);
            return 0;
        }
        let s: u32 = p_stmt(mem, src, lang);
        if s == 0 {
            return 0;
        }
        let _p: u32 = li_push(mem, s);
        cnt = cnt + 1;
    }
    let _lv: u32 = li_leave(mem);
    if p_want(mem, src, "}") == 0 {
        return 0;
    }
    let _a: u32 = st32(outp, 0, a0);
    let _b: u32 = st32(outp, 4, cnt);
    return 1;
}

fn p_stmt(mem: ptr, src: ptr, lang: u32) -> u32 {
    let st: ptr = pst(mem);
    let j: u32 = ld32(st, PS_I);
    let o: u32 = tk_off(mem, j);
    let l: u32 = tk_len(mem, j);
    let line: u32 = tk_line(mem, j);
    if p_at(mem, src, "{", 0) == 1 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    if l == 2 && eq(src, o, "if") == 1 {
        let _i: u32 = st32(st, PS_I, j + 1);
        if p_want(mem, src, "(") == 0 {
            return 0;
        }
        let cond: u32 = p_expr(mem, src, lang);
        if cond == 0 {
            return 0;
        }
        if p_want(mem, src, ")") == 0 {
            return 0;
        }
        if p_block_or_stmt(mem, src, lang, ptr_add(st, 400)) == 0 {
            return 0;
        }
        // ⚠ 一拿到就抄进局部：`then`/`else` 里**还能再嵌 if**，而嵌套那个会用同一批
        // 暂存格 —— 读得晚一步就读到内层的了（症状：外层 then 里套的是内层的语句）。
        let ts: u32 = ld32(st, 400);
        let tn: u32 = ld32(st, 404);
        let es: u32 = 0;
        let en: u32 = FAIL;
        if p_at(mem, src, "else", 0) == 1 {
            let _i2: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
            if p_block_or_stmt(mem, src, lang, ptr_add(st, 408)) == 0 {
                return 0;
            }
            es = ld32(st, 408);
            en = ld32(st, 412);
        }
        let n: u32 = node_new(mem, NK_IF, line);
        let _a: u32 = nd_set(mem, n, ND_A, cond);
        let _b: u32 = nd_set(mem, n, ND_B, ts);
        let _c: u32 = nd_set(mem, n, ND_C, tn);
        let _d: u32 = nd_set(mem, n, ND_D, es);
        let _e: u32 = nd_set(mem, n, ND_E, en);
        return n;
    }
    if l == 5 && eq(src, o, "while") == 1 {
        let _i: u32 = st32(st, PS_I, j + 1);
        if p_want(mem, src, "(") == 0 {
            return 0;
        }
        let cond: u32 = p_expr(mem, src, lang);
        if cond == 0 {
            return 0;
        }
        if p_want(mem, src, ")") == 0 {
            return 0;
        }
        if p_block_or_stmt(mem, src, lang, ptr_add(st, 400)) == 0 {
            return 0;
        }
        let ws: u32 = ld32(st, 400);
        let wn: u32 = ld32(st, 404);
        let n: u32 = node_new(mem, NK_WHILE, line);
        let _a: u32 = nd_set(mem, n, ND_A, cond);
        let _b: u32 = nd_set(mem, n, ND_B, ws);
        let _c: u32 = nd_set(mem, n, ND_C, wn);
        return n;
    }
    if l == 3 && eq(src, o, "for") == 1 {
        return p_for(mem, src, lang);
    }
    if (l == 2 && eq(src, o, "do") == 1) || (l == 6 && eq(src, o, "switch") == 1)
            || (l == 4 && eq(src, o, "goto") == 1) || (l == 4 && eq(src, o, "case") == 1)
            || (l == 7 && eq(src, o, "default") == 1) {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    if l == 5 && eq(src, o, "break") == 1 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    if l == 8 && eq(src, o, "continue") == 1 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    if l == 6 && eq(src, o, "return") == 1 {
        let _i: u32 = st32(st, PS_I, j + 1);
        let n: u32 = node_new(mem, NK_RETURN, line);
        if p_at(mem, src, ";", 0) == 1 {
            let _i2: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
            return n;
        }
        let e: u32 = p_expr(mem, src, lang);
        if e == 0 {
            return 0;
        }
        if p_want(mem, src, ";") == 0 {
            return 0;
        }
        let _a: u32 = nd_set(mem, n, ND_A, e);
        return n;
    }
    return p_simple(mem, src, lang, 1);
}

/// `Parser.simple(semi)`。
fn p_simple(mem: ptr, src: ptr, lang: u32, semi: u32) -> u32 {
    let st: ptr = pst(mem);
    let j: u32 = ld32(st, PS_I);
    let o: u32 = tk_off(mem, j);
    let l: u32 = tk_len(mem, j);
    let line: u32 = tk_line(mem, j);
    if tk_kind(mem, j) == 1 && word_has(mem, SEG_SPEC_WORDS, src, o, l) == 1 {
        if p_spec(mem, src, lang) == 0 {
            return 0;
        }
        let tid: u32 = ld32(st, 344);
        let nmo: u32 = ld32(st, 328);
        let nml: u32 = ld32(st, 332);
        let ln2: u32 = ld32(st, 336);
        if p_at(mem, src, ";", 0) == 1 {
            let _i: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
            let n: u32 = node_new(mem, NK_DECL, ln2);
            let _a: u32 = nd_set(mem, n, ND_A, tid);
            let _c: u32 = nd_set(mem, n, ND_C, nmo);
            let _d: u32 = nd_set(mem, n, ND_D, nml);
            return n;
        }
        if p_want(mem, src, "=") == 0 {
            return 0;
        }
        let e: u32 = p_expr(mem, src, lang);
        if e == 0 {
            return 0;
        }
        if semi == 1 {
            if p_want(mem, src, ";") == 0 {
                return 0;
            }
        }
        let n2: u32 = node_new(mem, NK_DECL, ln2);
        let _a: u32 = nd_set(mem, n2, ND_A, tid);
        let _c: u32 = nd_set(mem, n2, ND_C, nmo);
        let _d: u32 = nd_set(mem, n2, ND_D, nml);
        let _e: u32 = nd_set(mem, n2, ND_E, e + 1);      // `+1`：0 表示"没有初值"
        return n2;
    }
    if tk_kind(mem, j) != 1 {
        let _e: u32 = perr(mem, 2);
        return 0;
    }
    if word_has(mem, SEG_KW, src, o, l) == 1 {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let nl: u32 = p_ident(mem, src);
    if nl == 0 {
        return 0;
    }
    let nmo: u32 = ld32(st, 320);
    let nml: u32 = ld32(st, 324);
    if p_at(mem, src, "=", 0) == 1 {
        let _i: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
        let e: u32 = p_expr(mem, src, lang);
        if e == 0 {
            return 0;
        }
        if semi == 1 {
            if p_want(mem, src, ";") == 0 {
                return 0;
            }
        }
        let n: u32 = node_new(mem, NK_ASSIGN, line);
        let _a: u32 = nd_set(mem, n, ND_A, nmo);
        let _b: u32 = nd_set(mem, n, ND_B, nml);
        let _c: u32 = nd_set(mem, n, ND_C, e);
        return n;
    }
    if p_at(mem, src, "(", 0) == 1 {
        let _i: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
        if li_enter(mem) == FAIL {
            let _e: u32 = perr(mem, 1);
            return 0;
        }
        let a0: u32 = li_here(mem);
        let an: u32 = 0;
        if p_at(mem, src, ")", 0) == 0 {
            let e1: u32 = p_expr(mem, src, lang);
            if e1 == 0 {
                return 0;
            }
            let _p: u32 = li_push(mem, e1);
            an = 1;
            while p_at(mem, src, ",", 0) == 1 {
                let _c1: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                let e2: u32 = p_expr(mem, src, lang);
                if e2 == 0 {
                    return 0;
                }
                let _p2: u32 = li_push(mem, e2);
                an = an + 1;
            }
        }
        let _lv: u32 = li_leave(mem);
        if p_want(mem, src, ")") == 0 {
            return 0;
        }
        if semi == 1 {
            if p_want(mem, src, ";") == 0 {
                return 0;
            }
        }
        let cn: u32 = node_new(mem, NK_CALL, line);
        let _a: u32 = nd_set(mem, cn, ND_A, nmo);
        let _b: u32 = nd_set(mem, cn, ND_B, nml);
        let _c: u32 = nd_set(mem, cn, ND_C, a0);
        let _d: u32 = nd_set(mem, cn, ND_D, an);
        let n: u32 = node_new(mem, NK_EXPR, line);
        let _e: u32 = nd_set(mem, n, ND_A, cn);
        return n;
    }
    let _e: u32 = perr(mem, 2);
    return 0;
}

fn p_for(mem: ptr, src: ptr, lang: u32) -> u32 {
    let st: ptr = pst(mem);
    let line: u32 = tk_line(mem, ld32(st, PS_I));
    let _i: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
    if p_want(mem, src, "(") == 0 {
        return 0;
    }
    let init: u32 = 0;
    if p_at(mem, src, ";", 0) == 1 {
        let _i2: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
    } else {
        init = p_simple(mem, src, lang, 1);
        if init == 0 {
            return 0;
        }
    }
    let cond: u32 = 0;
    if p_at(mem, src, ";", 0) == 0 {
        cond = p_expr(mem, src, lang);
        if cond == 0 {
            return 0;
        }
    }
    if p_want(mem, src, ";") == 0 {
        return 0;
    }
    let step: u32 = 0;
    if p_at(mem, src, ")", 0) == 0 {
        step = p_simple(mem, src, lang, 0);
        if step == 0 {
            return 0;
        }
    }
    if p_want(mem, src, ")") == 0 {
        return 0;
    }
    if p_block_or_stmt(mem, src, lang, ptr_add(st, 416)) == 0 {
        return 0;
    }
    let bs: u32 = ld32(st, 416);
    let bn: u32 = ld32(st, 420);
    let n: u32 = node_new(mem, NK_FOR, line);
    let _a: u32 = nd_set(mem, n, ND_A, init);
    let _b: u32 = nd_set(mem, n, ND_B, cond);
    let _c: u32 = nd_set(mem, n, ND_C, step);
    let _d: u32 = nd_set(mem, n, ND_D, bs);
    let _e: u32 = nd_set(mem, n, ND_E, bn);
    return n;
}

/// `Parser.unit()` —— 函数表写进 `M_LIST`，`outp` 收 (start, count)；返回 1/0。
fn p_unit(mem: ptr, src: ptr, lang: u32, outp: ptr) -> u32 {
    let st: ptr = pst(mem);
    if li_enter(mem) == FAIL {
        let _e: u32 = perr(mem, 1);
        return 0;
    }
    let a0: u32 = li_here(mem);
    let cnt: u32 = 0;
    while tk_kind(mem, ld32(st, PS_I)) != 0 {
        if p_at(mem, src, "#", 0) == 1 {
            let _e: u32 = perr(mem, 1);
            return 0;
        }
        if p_spec(mem, src, lang) == 0 {
            return 0;
        }
        let tid: u32 = ld32(st, 344);
        let nmo: u32 = ld32(st, 328);
        let nml: u32 = ld32(st, 332);
        let line: u32 = ld32(st, 336);
        let spec0: u32 = ld32(st, PS_SPEC0);
        if p_at(mem, src, "(", 0) == 0 {
            if spec_has_const(mem, src, spec0, ld32(st, PS_I)) == 1
                    && p_at(mem, src, "=", 0) == 1 {
                let _i: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                if p_at(mem, src, "-", 0) == 1 && tk_kind(mem, ld32(st, PS_I) + 1) == 2 {
                    let _i2: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                }
                if tk_kind(mem, ld32(st, PS_I)) != 2 {
                    let _e: u32 = perr(mem, 1);
                    return 0;
                }
                let _i3: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                if p_want(mem, src, ";") == 0 {
                    return 0;
                }
            } else {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
        } else {
            let _i: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
            if li_enter(mem) == FAIL {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            let p0: u32 = li_here(mem);
            let pn: u32 = 0;
            if p_at(mem, src, ")", 0) == 0 {
                if p_at(mem, src, "void", 0) == 1 && p_at(mem, src, ")", 1) == 1 {
                    let _i2: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                } else {
                    if p_spec(mem, src, lang) == 0 {
                        return 0;
                    }
                    let _q1: u32 = li_push(mem, ld32(st, 344));
                    let _q3: u32 = li_push(mem, ld32(st, 328));
                    let _q4: u32 = li_push(mem, ld32(st, 332));
                    pn = 1;
                    while p_at(mem, src, ",", 0) == 1 {
                        let _c1: u32 = st32(st, PS_I, ld32(st, PS_I) + 1);
                        if p_spec(mem, src, lang) == 0 {
                            return 0;
                        }
                        let _q5: u32 = li_push(mem, ld32(st, 344));
                        let _q7: u32 = li_push(mem, ld32(st, 328));
                        let _q8: u32 = li_push(mem, ld32(st, 332));
                        pn = pn + 1;
                    }
                }
            }
            let _lv: u32 = li_leave(mem);
            if p_want(mem, src, ")") == 0 {
                return 0;
            }
            if p_at(mem, src, ";", 0) == 1 {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            // **函数体要另起一层**：形参刚在上一层（depth 2）写完，`li_enter` 会把那一层的
            // 游标清零 —— 直接进 `p_block` 的话，**第一条语句会盖掉第一个形参**
            //（症状：每个函数第一个形参的类型/名字都变成别的东西，其余都对）。
            let _be: u32 = li_enter(mem);
            if _be == FAIL {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            if p_block(mem, src, lang, ptr_add(st, 432)) == 0 {
                return 0;
            }
            let bs: u32 = ld32(st, 432);
            let bn: u32 = ld32(st, 436);
            let _bl: u32 = li_leave(mem);
            let f: u32 = fn_new(mem);
            if f == FAIL {
                let _e: u32 = perr(mem, 1);
                return 0;
            }
            let _a: u32 = fn_set(mem, f, 0, tid);
            let _b: u32 = fn_set(mem, f, 1, 0);
            let _c: u32 = fn_set(mem, f, 2, nmo);
            let _d: u32 = fn_set(mem, f, 3, nml);
            let _e2: u32 = fn_set(mem, f, 4, p0);
            let _f: u32 = fn_set(mem, f, 5, pn);
            let _g: u32 = fn_set(mem, f, 6, bs);
            let _h: u32 = fn_set(mem, f, 7, bn);
            let _i3: u32 = li_push(mem, f);
            cnt = cnt + 1;
        }
    }
    let _lv2: u32 = li_leave(mem);
    let _a2: u32 = st32(outp, 0, a0);
    let _b2: u32 = st32(outp, 4, cnt);
    return 1;
}


// ---------------------------------------------------------------- 发射（语法树 -> Loment 源码）
//
// 上游是 `trans_core.translate` + `Emitter`。**四门的差别全在方言表**：
// `safe_suffix`、两个 `coerce_*` 开关、`int_default` —— 这里照搬，一个 `if <语言>`
// 都不写（与解析那一半同一条纪律）。
//
// 上游文件头那三条"不是翻译、是决定"的东西，这一半是它们的落点：
//   1. `int x;`（没给初值）补**零值** —— C 读未初始化变量是未定义行为。
//   2. `for (int i = …)` 的循环变量**改名外提** —— Loment 没有裸块。
//   3. `static` / `inline` / `const` 收下并丢掉（标量子集里丢 `const` 是保义的）。
//
// **表达式走一块临时缓冲**（`M_EB`），一行拼完再整体抄进输出 —— 上游是
// `lines: list[str]` 再 `"\n".join`，这里不能那样存，就"拼一行、抄一行"。
// 递归一律用**单调的下标**传下去（`raw(e, buf, o) -> 新末端`），不靠栈。

const W_INT: u32 = 0;              // 这个上下文要"整数"
const W_BOOL: u32 = 1;             // 这个上下文要"条件"
const TY_VOID_ID: u32 = 10;        // `()` 的类型 id（见 `ty_id`）
const E_VN: u32 = 840;             // 变量表条数
const E_CN: u32 = 844;             // 常量表条数
const E_KN: u32 = 848;             // `--keep` 表条数
const E_ANY: u32 = 852;            // 这个函数已经发过行
const E_NL2: u32 = 856;            // 最后一行是空行
const E_BR: u32 = 860;             // 最后一行以 `{` 收尾
const E_OUT: u32 = 864;            // 输出的末端下标
const E_VBC: u32 = 868;            // 变量名池（`M_VB`）的游标
const E_FN_N: u32 = 872;           // `fresh()` 的计数器（每个函数归零）
const E_I2B: u32 = 876;            // 方言开关: 整数 -> 条件
const E_B2I: u32 = 880;            // 方言开关: 条件 -> 整数
const E_ERR: u32 = 884;            // 发射期的"子集外"（上游那条 `Unsupported`）
const E_RET: u32 = 888;            // 正在发的那个函数的返回类型 id
const E_NC: u32 = 892;             // 外部名池（`M_EXN`）的游标
const E_AC: u32 = 900;             // 辅助名池（`M_SCR` 高处）的游标
const E_EXN: u32 = 896;            // 外部函数表条数
const E_ARITH: u32 = 904;          // 方言开关: **寻常算术转换**（C / C++ 开，Java / C# 关）
const E_SD: u32 = 908;             // 块作用域栈的**深度**（`self.scopes` 有几层）
const E_SP: u32 = 912;             // 块作用域栈的**条目数**

/// 类型 id -> **秩**（C 的寻常算术转换按它走，见 `tools/trans_core.py` 的 `_INT_RANK`）。
/// 0 = 比 `int` 窄（先整型提升）、1 = `int` 那一档、2 = `long` 那一档；
/// `FAIL` = 不参与提升（`bool` / `()` / 还不认识）。
const TY_I32: u32 = 5;
const TY_U32: u32 = 6;
const TY_U64: u32 = 8;

fn ty_rank(t: u32) -> u32 {
    if t == 1 || t == 2 || t == 3 || t == 4 {
        return 0;                       // i8 u8 i16 u16
    }
    if t == 5 || t == 6 {
        return 1;                       // i32 u32
    }
    if t == 7 || t == 8 {
        return 2;                       // i64 u64
    }
    return FAIL;
}

fn ty_uns(t: u32) -> u32 {
    if t == 2 || t == 4 || t == 6 || t == 8 {
        return 1;
    }
    return 0;
}

/// 整型提升：比 `int` 窄的一律先升到 `i32`（`u16` 的最大值也装得下）。
fn ty_prom(t: u32) -> u32 {
    if ty_rank(t) == 0 {
        return TY_I32;
    }
    return t;
}

/// 上游 `_usual_arith` —— 两侧的整型 id 给进来，返回运算该在哪个宽度做；
/// `0` = 有一侧不定型（字面量），由另一侧说了算；两侧都 0 才返回 0。
fn ty_usual(a0: u32, b0: u32) -> u32 {
    if a0 == 0 {
        return b0;
    }
    if b0 == 0 {
        return a0;
    }
    let a: u32 = ty_prom(a0);
    let b: u32 = ty_prom(b0);
    if a == b {
        return a;
    }
    let ra: u32 = ty_rank(a);
    let rb: u32 = ty_rank(b);
    if ra == rb {
        if ty_uns(a) == 1 {
            return a;                   // 同秩不同符号 ⇒ 无符号那侧
        }
        return b;
    }
    let hi: u32 = a;
    if rb > ra {
        hi = b;
    }
    if ty_uns(hi) == 0 {
        return hi;                      // 秩高的那侧（有符号）装得下秩低那侧
    }
    if ty_rank(hi) == 2 {
        return TY_U64;
    }
    return TY_U32;
}

const VAR_N: u32 = 0;              // 记录（24 字节）: 源名 off/len、发出名 off/len、
const VAR_L: u32 = 4;              //   声明时的类型 id、**墓碑**（1 = 已删）
const VAR_O: u32 = 8;
const VAR_OL: u32 = 12;
const VAR_TY: u32 = 16;
const VAR_DEAD: u32 = 20;

// 块作用域栈的条目（24 字节，见 `sc_push` / `sc_pop`）:
//   源名 off/len、外层那个变量的表下标+1（0 = 外层没有这个名字）、它的发出名 off/len、类型 id
const SC_N: u32 = 0;
const SC_L: u32 = 4;
const SC_K: u32 = 8;
const SC_OO: u32 = 12;
const SC_OL: u32 = 16;
const SC_TY: u32 = 20;

fn em_fail(mem: ptr) -> u32 {
    return st32(ptr_add(mem, M_TMP), E_ERR, 1);
}

fn em_ok(mem: ptr) -> u32 {
    if ld32(ptr_add(mem, M_TMP), E_ERR) == 0 {
        return 1;
    }
    return 0;
}

// ---- 变量表（上游的 `self.vars` / `self.varty` / `self.consts` 三张）

fn var_n(mem: ptr) -> u32 {
    return ld32(ptr_add(mem, M_TMP), E_VN);
}

/// 按**源里的名字**查（返回下标 +1；0 = 没有）。墓碑跳过 —— 与上游
/// `del self.vars[name]` 等价（那边是真删，这里标记）。
fn var_find(mem: ptr, a: u32, l: u32) -> u32 {
    let n: u32 = var_n(mem);
    let r: ptr = ptr_add(mem, M_VAR);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 24 + VAR_DEAD) == 0 && ld32(r, i * 24 + VAR_L) == l
                && same_n(s, ld32(r, i * 24 + VAR_N), s, a, l) == 1 {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 声明（或重新声明）一个名字 —— 上游是 `self.vars[name] = …`，
/// **已在表里就原地改，不在才追加**（追加的话重复声明会留下两条，查到的是旧那条）。
fn var_decl(mem: ptr, a: u32, l: u32, oo: u32, ol: u32, ty: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let k: u32 = var_find(mem, a, l);
    if k > 0 {
        let _a: u32 = var_set(mem, k, oo, ol, ty);
        return k;
    }
    let n: u32 = var_n(mem);
    if n >= VMAX - 1 {
        let _e: u32 = em_fail(mem);
        return 0;
    }
    let r: ptr = ptr_add(mem, M_VAR);
    let _1: u32 = st32(r, n * 24 + VAR_N, a);
    let _2: u32 = st32(r, n * 24 + VAR_L, l);
    let _3: u32 = st32(r, n * 24 + VAR_O, oo);
    let _4: u32 = st32(r, n * 24 + VAR_OL, ol);
    let _5: u32 = st32(r, n * 24 + VAR_TY, ty);
    let _6: u32 = st32(r, n * 24 + VAR_DEAD, 0);
    let _7: u32 = st32(st, E_VN, n + 1);
    return n + 1;
}

fn var_set(mem: ptr, k: u32, oo: u32, ol: u32, ty: u32) -> u32 {
    let r: ptr = ptr_add(mem, M_VAR);
    let _1: u32 = st32(r, (k - 1) * 24 + VAR_O, oo);
    let _2: u32 = st32(r, (k - 1) * 24 + VAR_OL, ol);
    let _3: u32 = st32(r, (k - 1) * 24 + VAR_TY, ty);
    let _4: u32 = st32(r, (k - 1) * 24 + VAR_DEAD, 0);
    return k;
}

/// 上游 `del self.vars[name]` —— 记个墓碑（不能改条数：循环体里声明过别的名字，
/// 那条记录就在它后面）。
fn var_kill(mem: ptr, k: u32) -> u32 {
    return st32(ptr_add(mem, M_VAR), (k - 1) * 24 + VAR_DEAD, 1);
}

fn var_oo(mem: ptr, k: u32) -> u32 {
    return ld32(ptr_add(mem, M_VAR), (k - 1) * 24 + VAR_O);
}

fn var_ol(mem: ptr, k: u32) -> u32 {
    return ld32(ptr_add(mem, M_VAR), (k - 1) * 24 + VAR_OL);
}

fn var_ty(mem: ptr, k: u32) -> u32 {
    return ld32(ptr_add(mem, M_VAR), (k - 1) * 24 + VAR_TY);
}

/// 上游 `want_of(ty)` —— 一个声明出来的类型在这个发射器眼里是"整数场合"还是
/// "布尔场合"。**所有"右边赋给左边"的地方都走它**（`Decl` / `Assign` / `Return` /
/// `for` 的初值）。
fn want_of(tid: u32) -> u32 {
    if tid == 9 {
        return W_BOOL;
    }
    return W_INT;
}

/// 段里的**第一个**词写到 `dst`，返回长度。
fn seg_word(mem: ptr, seg: u32, dst: ptr) -> u32 {
    let d: ptr = ptr_add(mem, M_WORD);
    let s0: u32 = ld32(d, seg * 8);
    let sl: u32 = ld32(d, seg * 8 + 4);
    let k: u32 = s0;
    while k < s0 + sl && load8(d, k) != 0 {
        k = k + 1;
    }
    let _c: u32 = copy_n(dst, 0, d, s0, k - s0);
    return k - s0;
}

/// `d.safe(name)` —— 撞上 Loment 保留字就加**这一门的**后缀。写进 `dst`，返回长度。
fn safe_name(mem: ptr, o: u32, l: u32, dst: ptr) -> u32 {
    let _c: u32 = copy_n(dst, 0, ptr_add(mem, M_SCR), o, l);
    if word_has(mem, SEG_LKW, ptr_add(mem, M_SCR), o, l) == 1 {
        let sfx: ptr = ptr_add(mem, M_TMP + 960);
        let sl: u32 = seg_word(mem, SEG_SAFE, sfx);
        let _c2: u32 = copy_n(dst, l, sfx, 0, sl);
        return l + sl;
    }
    return l;
}

fn vb_taken(mem: ptr, o: u32, l: u32) -> u32 {
    let n: u32 = var_n(mem);
    let r: ptr = ptr_add(mem, M_VAR);
    let d: ptr = ptr_add(mem, M_VB);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 24 + VAR_DEAD) == 0 && ld32(r, i * 24 + VAR_OL) == l
                && same_n(d, ld32(r, i * 24 + VAR_O), d, o, l) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 上游 `Emitter.fresh(base)` —— `safe(base) + "__" + n`，且不能撞上已有的名字。
/// **游标不动到不撞为止**：名字写进 `M_VB` 的游标处，返回长度（起点 = 调用前的游标）。
fn fresh(mem: ptr, o: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let dst: ptr = ptr_add(mem, M_VB);
    let o0: u32 = ld32(st, E_VBC);
    let ln: u32 = 0;
    let tries: u32 = 0;
    while ln == 0 && tries < 4096 {
        tries = tries + 1;
        let n: u32 = ld32(st, E_FN_N) + 1;
        let _a: u32 = st32(st, E_FN_N, n);
        let p1: u32 = safe_name(mem, o, l, ptr_add(dst, o0));
        let p2: u32 = app(dst, o0 + p1, "__");
        let p3: u32 = appu(mem, dst, p2, n);
        let t: u32 = p3 - o0;
        if vb_taken(mem, o0, t) == 0 {
            ln = t;
        }
    }
    let _b: u32 = st32(st, E_VBC, o0 + ln);
    return ln;
}

// ---- 常量表与外部函数表（`--const K:i32` / `--extern f:i32`）

/// `--keep` / `--const` 的名字池 —— 在 `M_SCR` 的高处。查名字的两个函数都拿
/// `M_SCR` 当基准比，所以这两张表的名字**必须**也住在那儿（外部函数表不一样：
/// 那边的键来自调用点，两边是各自的池子）。
const M_AUX: u32 = 122880;
const AUX_CAP: u32 = 8192;

fn aux_put(mem: ptr, p: ptr, o: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let c: u32 = ld32(st, E_AC);
    if c + l + 1 >= AUX_CAP {
        let _e: u32 = em_fail(mem);
        return 0;
    }
    let _c1: u32 = copy_n(ptr_add(mem, M_SCR), M_AUX + c, p, o, l);
    let _c2: u32 = st32(st, E_AC, c + l + 1);
    return M_AUX + c;
}

/// `--extern a:i32,b:()` / `--const K:i32,L` 这种**逗号分隔的列表**。
/// `is_const` = 1 走常量表（`K` 不带 `:` 也收，类型对常量表没用）；
/// 否则走外部函数表（**必须**带 `:`，返回类型是调用点要认的东西）。
fn cli_pairs(mem: ptr, vp: ptr, vl: u32, is_const: u32) -> u32 {
    let i: u32 = 0;
    let s0: u32 = 0;
    while i <= vl {
        if i == vl || load8(vp, i) == 44 {
            let a: u32 = s0;
            let b: u32 = i;
            while a < b && is_sp(load8(vp, a)) == 1 {
                a = a + 1;
            }
            while b > a && is_sp(load8(vp, b - 1)) == 1 {
                b = b - 1;
            }
            if b > a {
                let cp: u32 = find_ch(vp, a, b, 58);
                if is_const == 1 {
                    let ne: u32 = b - a;
                    let cty: u32 = 7;              // 不带 `:类型` 时按 `i64`（上游模块常量就是 i64）
                    if cp != FAIL {
                        ne = cp - a;
                        cty = ty_id(ptr_add(vp, cp + 1), b - cp - 1);
                        if cty == 0 {
                            return 0;
                        }
                    }
                    let co: u32 = aux_put(mem, vp, a, ne);
                    let _ca: u32 = const_add(mem, co, ne, cty);
                } else {
                    if cp == FAIL {
                        return 0;
                    }
                    let tid: u32 = ty_id(ptr_add(vp, cp + 1), b - cp - 1);
                    if tid == 0 {
                        return 0;
                    }
                    let eo: u32 = exn_put(mem, vp, a, cp - a);
                    let nf: u32 = fn_new(mem);
                    if nf == FAIL {
                        return 0;
                    }
                    let _f1: u32 = fn_set(mem, nf, 0, tid);
                    let _f2: u32 = fn_set(mem, nf, 1, 1);
                    let _f3: u32 = fn_set(mem, nf, 2, eo);
                    let _f4: u32 = fn_set(mem, nf, 3, cp - a);
                    let _en: u32 = st32(ptr_add(mem, M_TMP), E_EXN,
                                        ld32(ptr_add(mem, M_TMP), E_EXN) + 1);
                }
            }
            s0 = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

fn exn_put(mem: ptr, p: ptr, o: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let c: u32 = ld32(st, E_NC);
    if c + l + 1 >= 16000 {
        let _e: u32 = em_fail(mem);
        return 0;
    }
    let _c1: u32 = copy_n(ptr_add(mem, M_EXN), c, p, o, l);
    let _c2: u32 = st32(st, E_NC, c + l + 1);
    return c;
}

fn const_find(mem: ptr, a: u32, l: u32) -> u32 {
    let n: u32 = ld32(ptr_add(mem, M_TMP), E_CN);
    let r: ptr = ptr_add(mem, M_CN);
    let d: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 12 + 4) == l && same_n(d, ld32(r, i * 12), d, a, l) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn const_add(mem: ptr, a: u32, l: u32, ty: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, E_CN);
    if n >= VMAX - 1 {
        return 0;
    }
    let r: ptr = ptr_add(mem, M_CN);
    let _1: u32 = st32(r, n * 12, a);
    let _2: u32 = st32(r, n * 12 + 4, l);
    let _3: u32 = st32(r, n * 12 + 8, ty);
    return st32(st, E_CN, n + 1);
}

/// 一个名字的返回类型 id（`() ` = 10）。**外部表优先** —— 上游是先收本单元的函数、
/// 再 `rets.update(externs)`，所以同名的外部函数赢。
fn fn_ret(mem: ptr, o: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let d: ptr = ptr_add(mem, M_EXN);
    let s: ptr = ptr_add(mem, M_SCR);
    let n: u32 = ld32(st, 40);
    // 先过外部表 —— 上游是先收本单元的、再 `rets.update(externs)`，同名的**外部赢**。
    // 第 1 格当"这是外部条目"的标记（本单元的条目那边恒为 0）。
    let res: u32 = FAIL;
    let k: u32 = 1;
    while k <= n {
        if fn_get(mem, k, 1) == 1 && fn_get(mem, k, 3) == l
                && same_n(d, fn_get(mem, k, 2), s, o, l) == 1 {
            res = fn_get(mem, k, 0);
        }
        k = k + 1;
    }
    if res != FAIL {
        return res;
    }
    let k2: u32 = 1;
    while k2 <= n {
        if fn_get(mem, k2, 1) == 0 && fn_get(mem, k2, 3) == l
                && same_n(s, fn_get(mem, k2, 2), s, o, l) == 1 {
            res = fn_get(mem, k2, 0);
        }
        k2 = k2 + 1;
    }
    return res;
}

fn keep_has(mem: ptr, a: u32, l: u32) -> u32 {
    let n: u32 = ld32(ptr_add(mem, M_TMP), E_KN);
    let r: ptr = ptr_add(mem, M_KP);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 12 + 4) == l && same_n(s, ld32(r, i * 12), s, a, l) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn keep_add(mem: ptr, a: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, E_KN);
    if n >= FNMAX - 1 {
        return 0;
    }
    let r: ptr = ptr_add(mem, M_KP);
    let _1: u32 = st32(r, n * 12, a);
    let _2: u32 = st32(r, n * 12 + 4, l);
    return st32(st, E_KN, n + 1);
}

// ---- 类型（`ty_of`）

/// 表达式**自己**的类型: 0 = 整数, 1 = 条件, 2 = 不返回值, 3 = 说不上来（报错）。
fn ty_of(mem: ptr, e: u32) -> u32 {
    let k: u32 = nd_get(mem, e, ND_KIND);
    if k == NK_LIT {
        if nd_get(mem, e, ND_B) == 1 {
            return W_BOOL;
        }
        return W_INT;
    }
    if k == NK_VAR {
        let f: u32 = var_find(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        if f > 0 && var_ty(mem, f) == 9 {
            return W_BOOL;
        }
        return W_INT;
    }
    if k == NK_CALL {
        let r: u32 = fn_ret(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        if r == FAIL {
            return 3;
        }
        if r == 10 {
            return TY_VOID_ID;
        }
        return W_INT;
    }
    if k == NK_UN {
        if nd_get(mem, e, ND_A) == 2 {
            return W_BOOL;
        }
        return W_INT;
    }
    if k == NK_BIN {
        if bin_isbool(nd_get(mem, e, ND_A)) == 1 {
            return W_BOOL;
        }
        return W_INT;
    }
    return 3;
}

// ---------------------------------------------------------------- 宽度与块作用域
//
// 上游 `trans_core.Emitter` 里那几样与**声明位置 / 整数宽度**有关的东西，全在这里：
//   `num_ty` / `conv` / `sink` —— C 的**寻常算术转换**与三处隐式整型转换
//   `pin_ex`（带类型那版）      —— 比较的操作数钉住宽度
//   `decl_bind` / `em_block`    —— **块作用域**（本语言没有，见 `#119` / `#120`）
// 判据 `loment_trans_test` 逐字节比两个实现的产物，所以两边必须一模一样。

/// 本单元那个函数的 **Fn 表下标**（0 = 没有）。**外部条目不算** —— 上游
/// `Emitter.fparams` 只收本单元的函数（`extern` 那种的形参表不知道 ⇒ 不转）。
fn fn_local(mem: ptr, o: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let s: ptr = ptr_add(mem, M_SCR);
    let n: u32 = ld32(st, 40);
    let k: u32 = 1;
    while k <= n {
        if fn_get(mem, k, 1) == 0 && fn_get(mem, k, 3) == l
                && same_n(s, fn_get(mem, k, 2), s, o, l) == 1 {
            return k;
        }
        k = k + 1;
    }
    return 0;
}

/// 上游 `Emitter.num_ty` —— 表达式在**宽度规则**下的整型 id。
/// `0` = 不定型（字面量，或全是字面量的式子）或结果不是整数；两种情况处理一样。
fn num_ty(mem: ptr, e: u32) -> u32 {
    let k: u32 = nd_get(mem, e, ND_KIND);
    if k == NK_VAR {
        let f: u32 = var_find(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        if f > 0 {
            let t: u32 = var_ty(mem, f);
            if ty_rank(t) != FAIL {
                return t;
            }
        }
        return 0;
    }
    if k == NK_CALL {
        let r: u32 = fn_ret(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        if r != FAIL && ty_rank(r) != FAIL {
            return r;
        }
        return 0;
    }
    if k == NK_UN {
        // 一元 `-`（码 1）出的是**提升后**的操作数类型；`!`（码 2）出 bool ⇒ 不参与
        if nd_get(mem, e, ND_A) == 1 {
            return num_ty(mem, nd_get(mem, e, ND_B));
        }
        return 0;
    }
    if k == NK_BIN {
        let c: u32 = nd_get(mem, e, ND_A);
        if c == 17 || c == 18 || bin_isbool(c) == 1 {
            return 0;                       // 比较 / 逻辑 ⇒ bool
        }
        if c == 6 || c == 7 {
            return num_ty(mem, nd_get(mem, e, ND_B));   // 移位只看左操作数
        }
        return ty_usual(num_ty(mem, nd_get(mem, e, ND_B)), num_ty(mem, nd_get(mem, e, ND_C)));
    }
    return 0;
}

/// 上游 `Emitter.conv` —— 把表达式转成类型 `t`（`0` = 不转）。只转**已知类型**的式子。
fn conv(mem: ptr, e: u32, t: u32, buf: ptr, o: u32) -> u32 {
    if t == 0 {
        return ex_want(mem, e, W_INT, buf, o);
    }
    let s: u32 = num_ty(mem, e);
    if s == 0 || s == t {
        return ex_want(mem, e, W_INT, buf, o);
    }
    let o2: u32 = app(buf, o, "(");
    let o3: u32 = ex_want(mem, e, W_INT, buf, o2);
    let o4: u32 = app(buf, o3, " as ");
    let o5: u32 = app(buf, o4, ty_text(t));
    return app(buf, o5, ")");
}

/// 上游 `Emitter.sink` —— 表达式放进一个**声明类型为 `t`** 的位置（赋值 / 返回 /
/// 实参 / `for` 初值）。不开 `E_ARITH` 的方言（Java / C#）**不转**（它们的规则不同，
/// 让它在 check 那层响亮地失败）。
fn sink(mem: ptr, e: u32, t: u32, buf: ptr, o: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let w: u32 = want_of(t);
    if w != W_INT || ld32(st, E_ARITH) == 0 {
        return ex_want(mem, e, w, buf, o);
    }
    if ty_rank(t) == FAIL {
        return ex_want(mem, e, W_INT, buf, o);
    }
    return conv(mem, e, t, buf, o);
}

/// 钉宽度时写哪个宽度名：`t` 为 0（没有宽度信息）时用**方言表那个**
/// （`SEG_INTDEF`，与上游 `Dialect.int_default` 同一个东西）。
fn pin_ty(mem: ptr, t: u32, buf: ptr, o: u32) -> u32 {
    if t == 0 {
        let tmp: ptr = ptr_add(mem, M_TMP + 960);
        let tl: u32 = seg_word(mem, SEG_INTDEF, tmp);
        return appn(buf, o, tmp, 0, tl);
    }
    return app(buf, o, ty_text(t));
}

// ---- 块作用域栈（上游 `Emitter.scopes` / `block` / `decl_bind`）

/// 进一个块：把当前条目数记成这一帧的起点。
fn sc_push(mem: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let d: u32 = ld32(st, E_SD);
    if d >= SCO_MAXD {
        let _e: u32 = em_fail(mem);
        return 0;
    }
    let _a: u32 = st32(ptr_add(mem, M_SCOPE), d * 4, ld32(st, E_SP));
    let _b: u32 = st32(st, E_SD, d + 1);
    return 1;
}

/// 出一个块：**逆序**把这一帧里重新绑定过的名还原（后进先还原）——
/// 外层本来没有的**撤掉**，外层本来就有的**还回去**。
fn sc_pop(mem: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let d: u32 = ld32(st, E_SD);
    if d == 0 {
        return 0;
    }
    let s0: u32 = ld32(ptr_add(mem, M_SCOPE), (d - 1) * 4);
    let sp: u32 = ld32(st, E_SP);
    let i: u32 = sp;
    while i > s0 {
        i = i - 1;
        let e: ptr = ptr_add(mem, SCO_ENT + i * 24);
        let k: u32 = var_find(mem, ld32(e, SC_N), ld32(e, SC_L));
        if k > 0 {
            if ld32(e, SC_K) == 0 {
                let _g: u32 = var_kill(mem, k);
            } else {
                let _r: u32 = var_set(mem, k, ld32(e, SC_OO), ld32(e, SC_OL), ld32(e, SC_TY));
            }
        }
    }
    let _c: u32 = st32(st, E_SP, s0);
    let _d: u32 = st32(st, E_SD, d - 1);
    return 1;
}

/// 当前块里声明过这个名没有（同一个块里重复声明 = 源语言的编译错）。
fn sc_find(mem: ptr, a: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let d: u32 = ld32(st, E_SD);
    if d == 0 {
        return 0;
    }
    let s0: u32 = ld32(ptr_add(mem, M_SCOPE), (d - 1) * 4);
    let sp: u32 = ld32(st, E_SP);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = s0;
    while i < sp {
        let e: ptr = ptr_add(mem, SCO_ENT + i * 24);
        if ld32(e, SC_L) == l && same_n(s, ld32(e, SC_N), s, a, l) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn sc_add(mem: ptr, a: u32, l: u32, k0: u32, oo: u32, ol: u32, ty: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let sp: u32 = ld32(st, E_SP);
    if sp >= 500 {
        let _e: u32 = em_fail(mem);
        return 0;
    }
    let e: ptr = ptr_add(mem, SCO_ENT + sp * 24);
    let _1: u32 = st32(e, SC_N, a);
    let _2: u32 = st32(e, SC_L, l);
    let _3: u32 = st32(e, SC_K, k0);
    let _4: u32 = st32(e, SC_OO, oo);
    let _5: u32 = st32(e, SC_OL, ol);
    let _6: u32 = st32(e, SC_TY, ty);
    let _7: u32 = st32(st, E_SP, sp + 1);
    return 1;
}

/// 上游 `Emitter.decl_bind` —— 一条声明要发出去的名字（`#119` / `#120`）。
/// `(起点, 长度)` 写进 `outp`（变量名池 `M_VB` 的下标），返回 1；
/// 子集外时 `em_fail` 并返回 0。**名字池的游标由这里推**（调用方不再推）。
fn decl_bind(mem: ptr, a: u32, l: u32, outp: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let d: u32 = ld32(st, E_SD);
    let k0: u32 = var_find(mem, a, l);
    let o0: u32 = ld32(st, E_VBC);
    let ln: u32 = 0;
    if d > 0 {
        if sc_find(mem, a, l) == 1 {
            let _e: u32 = em_fail(mem);
            return 0;
        }
        let oo: u32 = 0;
        let ol: u32 = 0;
        let ty: u32 = 0;
        if k0 > 0 {
            oo = var_oo(mem, k0);
            ol = var_ol(mem, k0);
            ty = var_ty(mem, k0);
        }
        let _s: u32 = sc_add(mem, a, l, k0, oo, ol, ty);
        if k0 > 0 {
            // **遮蔽外层** —— 本语言没有块作用域，只能**改名**（出块时 `sc_pop` 还回去）
            ln = fresh(mem, a, l);
        } else {
            // 块里的**新名** —— 照 `bind` 发，`sc_pop` 出块时撤掉
            ln = safe_name(mem, a, l, ptr_add(ptr_add(mem, M_VB), o0));
            let _w: u32 = st32(st, E_VBC, o0 + ln);
        }
    } else {
        if k0 > 0 {
            // **函数层**重复声明 —— 源语言里是编译错
            let _e: u32 = em_fail(mem);
            return 0;
        }
        ln = safe_name(mem, a, l, ptr_add(ptr_add(mem, M_VB), o0));
        let _w: u32 = st32(st, E_VBC, o0 + ln);
    }
    let _p: u32 = st32(outp, 0, o0);
    let _q: u32 = st32(outp, 4, ln);
    return 1;
}

/// 上游 `Emitter.block` —— 发一个块（`if` / `while` / `for` 的体），**并保住
/// 源语言的块作用域**：进块压一帧、出块还原（体里遮蔽外层同名的声明走改名，
/// 新声明的名出块时撤掉）。
fn em_block(mem: ptr, start: u32, cnt: u32, depth: u32) -> u32 {
    let _p: u32 = sc_push(mem);
    let i: u32 = 0;
    while i < cnt && em_ok(mem) == 1 {
        let _r: u32 = emit_stmt(mem, li_get(mem, start + i), depth);
        i = i + 1;
    }
    let _q: u32 = sc_pop(mem);
    return 0;
}

/// 表达式在**它自己的类型**下的写法。括号一律加上 —— 别让读者去猜优先级。
/// 结果从 `o` 处往下写进 `buf`，返回新的末端。
fn raw_ex(mem: ptr, e: u32, buf: ptr, o: u32) -> u32 {
    let s: ptr = ptr_add(mem, M_SCR);
    let k: u32 = nd_get(mem, e, ND_KIND);
    if k == NK_LIT {
        if nd_get(mem, e, ND_B) == 1 {
            if nd_get(mem, e, ND_A) == 0 {
                return app(buf, o, "false");
            }
            return app(buf, o, "true");
        }
        let lv: u32 = nd_get(mem, e, ND_A);
        // **超 32 位的字面量不收**（与 `tools/trans_core.py` 的 `_lit32` 同一条）：
        // 本语言里没标注宽度的整数字面量在**解析那一层**就被截断（实测 `8589934591`
        // 读出来是 `4294967295`），事后 `as i64` 也救不回来。静默截断会让
        // `0x1FFFFFFFF == 0xFFFFFFFF` 从假变真，所以拒。
        if lv >= 2147483648 {
            let _e: u32 = em_fail(mem);
            return o;
        }
        return appu(mem, buf, o, lv);
    }
    if k == NK_VAR {
        let vo: u32 = nd_get(mem, e, ND_A);
        let vl: u32 = nd_get(mem, e, ND_B);
        // 上游先看常量名（照抄）、再看变量 —— 顶层常量声明在解析时被跳过，
        // 名字对不上的话就是 `lomt_from` 那一步没收它。
        if const_find(mem, vo, vl) == 1 {
            return appn(buf, o, s, vo, vl);
        }
        let f: u32 = var_find(mem, vo, vl);
        if f > 0 {
            return appn(buf, o, ptr_add(mem, M_VB), var_oo(mem, f), var_ol(mem, f));
        }
        let _e: u32 = em_fail(mem);
        return o;
    }
    if k == NK_CALL {
        // **那道闸在这里也要过一遍**（`docs/198` §3 / #147）：同一个"本单元没有的
        // 函数"，写在**值位**被拒、写在**语句位**照发。上游 `raw` 里查 `self.fns`，
        // 这里就查 `ty_of`（两处各写一遍必然漂 —— 复用同一个）。
        if ty_of(mem, e) == 3 {
            let _e: u32 = em_fail(mem);
            return o;
        }
        let o2: u32 = appn(buf, o, s, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        let o3: u32 = app(buf, o2, "(");
        let ao: u32 = nd_get(mem, e, ND_C);
        let an: u32 = nd_get(mem, e, ND_D);
        // **实参按形参类型转**（#125）—— 形参表只知道**本单元**的函数（`extern` 那种
        // 不知道 ⇒ 不转），而且个数要对得上（变参不转）。见 `fn_local`。
        let lf: u32 = fn_local(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        let p0: u32 = 0;
        let args_ok: u32 = 0;
        if lf > 0 {
            if fn_get(mem, lf, 5) == an {
                p0 = fn_get(mem, lf, 4);
                args_ok = 1;
            }
        }
        let i: u32 = 0;
        let cur: u32 = o3;
        while i < an {
            if i > 0 {
                cur = app(buf, cur, ", ");
            }
            let arg: u32 = li_get(mem, ao + i);
            if args_ok == 1 && ld32(ptr_add(mem, M_TMP), E_ARITH) == 1 {
                let pty: u32 = li_get(mem, p0 + i * 3);
                if want_of(pty) == W_BOOL {
                    cur = ex_want(mem, arg, W_BOOL, buf, cur);
                } else {
                    let ct: u32 = 0;
                    if ty_rank(pty) != FAIL {
                        ct = pty;
                    }
                    cur = conv(mem, arg, ct, buf, cur);
                }
            } else {
                cur = ex_want(mem, arg, W_INT, buf, cur);
            }
            i = i + 1;
        }
        return app(buf, cur, ")");
    }
    if k == NK_UN {
        if nd_get(mem, e, ND_A) == 2 {
            // Loment 的 `!` 只收 bool，而 C 的 `!x` 收 int —— 直接写成 `x == 0`
            let o2: u32 = app(buf, o, "(");
            let o3: u32 = ex_want(mem, nd_get(mem, e, ND_B), W_INT, buf, o2);
            return app(buf, o3, " == 0)");
        }
        let o2: u32 = app(buf, o, "(-");
        let o3: u32 = ex_want(mem, nd_get(mem, e, ND_B), W_INT, buf, o2);
        return app(buf, o3, ")");
    }
    if k == NK_BIN {
        let c: u32 = nd_get(mem, e, ND_A);
        // **比较（码 8..13）的操作数要钉住宽度**（见 `pin_ex`）—— 宽窄 / 有符号
        // 无符号会把结论翻掉，而 C 在这里是有符号的。开了 `E_ARITH` 的方言还先按
        // **寻常算术转换**算出该在哪个宽度比（`int` + `unsigned` ⇒ 无符号）。
        if c >= 8 && c <= 13 {
            let pt: u32 = 0;
            if ld32(ptr_add(mem, M_TMP), E_ARITH) == 1 {
                pt = ty_usual(num_ty(mem, nd_get(mem, e, ND_B)),
                              num_ty(mem, nd_get(mem, e, ND_C)));
            }
            let o2: u32 = app(buf, o, "(");
            let o3: u32 = pin_ex(mem, nd_get(mem, e, ND_B), pt, buf, o2);
            let o4: u32 = app(buf, o3, " ");
            let o5: u32 = app(buf, o4, bin_text(c));
            let o6: u32 = app(buf, o5, " ");
            let o7: u32 = pin_ex(mem, nd_get(mem, e, ND_C), pt, buf, o6);
            return app(buf, o7, ")");
        }
        // **算术也按提升后的宽度做**（码 1..5、14..16：`int` + `long` 在 C 里是 64 位加法）。
        if ld32(ptr_add(mem, M_TMP), E_ARITH) == 1 && (c <= 5 || (c >= 14 && c <= 16)) {
            let pt: u32 = ty_usual(num_ty(mem, nd_get(mem, e, ND_B)),
                                   num_ty(mem, nd_get(mem, e, ND_C)));
            let o2: u32 = app(buf, o, "(");
            let o3: u32 = conv(mem, nd_get(mem, e, ND_B), pt, buf, o2);
            let o4: u32 = app(buf, o3, " ");
            let o5: u32 = app(buf, o4, bin_text(c));
            let o6: u32 = app(buf, o5, " ");
            let o7: u32 = conv(mem, nd_get(mem, e, ND_C), pt, buf, o6);
            return app(buf, o7, ")");
        }
        let w: u32 = bin_want(c);
        let o2: u32 = app(buf, o, "(");
        let o3: u32 = ex_want(mem, nd_get(mem, e, ND_B), w, buf, o2);
        let o4: u32 = app(buf, o3, " ");
        let o5: u32 = app(buf, o4, bin_text(c));
        let o6: u32 = app(buf, o5, " ");
        let o7: u32 = ex_want(mem, nd_get(mem, e, ND_C), w, buf, o6);
        return app(buf, o7, ")");
    }
    let _e: u32 = em_fail(mem);
    return o;
}

/// 把表达式按**本族的整数宽度**发出来 —— **字面量起头的那些在这里被钉住**。
///
/// 与 `tools/trans_core.py` 的 `Emitter.pinned` **逐条对应**（判据 `loment_trans_test`
/// 逐字节比两个实现的产物，所以两边必须一模一样）。
///
/// 本语言里**没标注宽度的整数字面量是不确定的**：实测 `(0 - 1) < 0` 编出来是
/// `icmp ult i32`（**无符号**），而 `((0 as i32) - (1 as i32)) < (0 as i32)` 才是
/// `icmp slt`。C 在这里是**有符号**的 —— 于是 `-1 < 0` 在 C 是真、在这边是假。
/// 所以**比较的操作数**要钉住宽度。
///
/// **别处**（赋值 / 返回 / 实参）**不能**钉：那些位置的宽度由**接收方**决定
/// （`u8` / `u64` …），走 `conv`，而且**只转已知类型的式子**。
///
/// `t` 是要钉到哪个宽度（类型 id）；`0` = 没有宽度信息，用**方言表那个**
/// （`SEG_INTDEF`）。C 那边会传**提升后**的类型 —— `int a; unsigned b; a > b`
/// 钉成 `u32`，与 C 的规则一致。
fn pin_ex(mem: ptr, e: u32, t: u32, buf: ptr, o: u32) -> u32 {
    let k: u32 = nd_get(mem, e, ND_KIND);
    if k == NK_LIT {
        if nd_get(mem, e, ND_B) == 1 {
            return raw_ex(mem, e, buf, o);
        }
        let v: u32 = nd_get(mem, e, ND_A);
        let o2: u32 = app(buf, o, "(");
        let o3: u32 = appu(mem, buf, o2, v);
        let o4: u32 = app(buf, o3, " as ");
        // 超 32 位的字面量在上面（`raw_ex` 的字面量分支）已经拒了，所以到不了这里。
        let o5: u32 = pin_ty(mem, t, buf, o4);
        return app(buf, o5, ")");
    }
    if k == NK_UN {
        // `-2147483648`（`#131` 那张表的最后一行）：**正的** 2147483648 不在 i32 里，
        // 可整个式子（取负之后）在。`raw_ex` 的字面量分支只认**正**字面量，于是会
        // 误拒 —— 先把负号并进常量再发。只在**有符号**那一侧这么做（与上游
        // `pinned` 同一条；无符号场合照旧拒，那是另一条未建的规则）。
        //
        // 码 `1` 是 `UN_SUB`（常量声明在文件后段，而本语言要求先定义后使用）。
        let c: u32 = nd_get(mem, e, ND_A);
        let ch: u32 = nd_get(mem, e, ND_B);
        if c == 1 && nd_get(mem, ch, ND_KIND) == NK_LIT
                && nd_get(mem, ch, ND_B) == 0 {
            let v: u32 = nd_get(mem, ch, ND_A);
            let signed: u32 = 0;
            if t == 0 || t == 1 || t == 3 || t == 5 || t == 7 {
                signed = 1;          // 0 = 方言默认（`i32`）；1/3/5/7 = i8/i16/i32/i64
            }
            if signed == 1 && v <= 2147483648 {
                let o2: u32 = app(buf, o, "(");
                let o3: u32 = o2;
                if v != 0 {
                    o3 = app(buf, o2, "-");
                }
                let o4: u32 = appu(mem, buf, o3, v);
                let o5: u32 = app(buf, o4, " as ");
                let o6: u32 = pin_ty(mem, t, buf, o5);
                return app(buf, o6, ")");
            }
        }
    }
    if k == NK_BIN {
        // `&&` / `||`（码 17 / 18）**不钉** —— 它们出 bool，宽度无关。
        let c: u32 = nd_get(mem, e, ND_A);
        if c == 17 || c == 18 {
            return ex_want(mem, e, W_INT, buf, o);
        }
        let o2: u32 = app(buf, o, "(");
        let o3: u32 = pin_ex(mem, nd_get(mem, e, ND_B), t, buf, o2);
        let o4: u32 = app(buf, o3, " ");
        let o5: u32 = app(buf, o4, bin_text(c));
        let o6: u32 = app(buf, o5, " ");
        let o7: u32 = pin_ex(mem, nd_get(mem, e, ND_C), t, buf, o6);
        return app(buf, o7, ")");
    }
    // 其余（变量 / 调用 / 一元）：有确定类型且与目标不同就转（与上游 `pinned` 同一条）
    let sy: u32 = num_ty(mem, e);
    if sy != 0 && t != 0 && sy != t {
        let o2: u32 = app(buf, o, "(");
        let o3: u32 = ex_want(mem, e, W_INT, buf, o2);
        let o4: u32 = app(buf, o3, " as ");
        let o5: u32 = app(buf, o4, ty_text(t));
        return app(buf, o5, ")");
    }
    return ex_want(mem, e, W_INT, buf, o);
}

/// 表达式，**在 `want` 这个上下文里**的写法（必要时补转换）。
///
/// **两条转换要不要补，是方言表说了算** —— 这是这一族里最会咬人的一格：
/// C / C++ 的 `&&` 出 `int`、`if (x)` 收标量，两个方向都要补；Java / C# 的 `&&`
/// 出 `boolean`、条件只收 `boolean`，**一个都不用**。同一处的差别，按"能表达的就转、
/// 表达不出来的就报错"那条判据，两族结论相反。
fn ex_want(mem: ptr, e: u32, want: u32, buf: ptr, o: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let got: u32 = ty_of(mem, e);
    if got == TY_VOID_ID || got == 3 {
        let _e: u32 = em_fail(mem);
        return o;
    }
    if got == want {
        return raw_ex(mem, e, buf, o);
    }
    if got == W_INT {
        if ld32(st, E_I2B) == 0 {
            let _e: u32 = em_fail(mem);
            return o;
        }
        let o2: u32 = raw_ex(mem, e, buf, o);
        return app(buf, o2, " != 0");          // `if (x)`：非零即真
    }
    if ld32(st, E_B2I) == 0 {
        let _e: u32 = em_fail(mem);
        return o;
    }
    let o2: u32 = app(buf, o, "((");
    let o3: u32 = raw_ex(mem, e, buf, o2);
    let o4: u32 = app(buf, o3, ") as ");
    let t: ptr = ptr_add(mem, M_TMP + 960);
    let tl: u32 = seg_word(mem, SEG_INTDEF, t);
    let o5: u32 = appn(buf, o4, t, 0, tl);
    // **整条投影自己要括住**（`tools/trans_core.py` 的 `ex` 那一处，2026-10-09 #124）：
    // `ex()` 的返回值是拿去当**操作数**用的，而 `… as i32 < c` 里的 `i32 <` 会被
    // parser 当成**泛型实参**的开头。原先这里漏了这一层 —— 判据在门禁**基线**里
    // （`loment_trans_test` 标着"已知红"），所以只改参考实现那边一直没被发现。
    return app(buf, o5, ")");
}

// ---- 行（上游的 `lines` / `out` / `gap`）

/// 把 `M_EB` 的 `[0, n)` 当成一行发出去（缩进 `depth + 1` 层）。
/// `br` = 这一行以 `{` 收尾（`gap` 要看这个）。
fn line_put(mem: ptr, n: u32, depth: u32, br: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let out: ptr = ptr_add(mem, M_OUT);
    let cur: u32 = ld32(st, E_OUT);
    let i: u32 = 0;
    let c0: u32 = cur;
    while i < depth + 1 {
        c0 = app(out, c0, "    ");
        i = i + 1;
    }
    let c1: u32 = appn(out, c0, ptr_add(mem, M_EB), 0, n);
    let c2: u32 = app(out, c1, "\n");
    let _a: u32 = st32(st, E_OUT, c2);
    let _b: u32 = st32(st, E_ANY, 1);
    let _c: u32 = st32(st, E_NL2, 0);
    let _d: u32 = st32(st, E_BR, br);
    return c2;
}

/// **不缩进**的一行（内容在 `M_EB`）—— 只有**函数头**用它：上游是
/// `lines.append(head + " {")`，那头一行不缩进。
fn line_put_ni(mem: ptr, n: u32, br: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let out: ptr = ptr_add(mem, M_OUT);
    let c0: u32 = appn(out, ld32(st, E_OUT), ptr_add(mem, M_EB), 0, n);
    let c1: u32 = app(out, c0, "
");
    let _a: u32 = st32(st, E_OUT, c1);
    let _b: u32 = st32(st, E_ANY, 1);
    let _c: u32 = st32(st, E_NL2, 0);
    let _d: u32 = st32(st, E_BR, br);
    return c1;
}

/// 一行字面量（缩进 `depth + 1` 层）—— `}` / `} else {` 这类收尾行用。
fn line_lit(mem: ptr, s: str, depth: u32, br: u32) -> u32 {
    return line_put(mem, app(ptr_add(mem, M_EB), 0, s), depth, br);
}

/// **不缩进**的一行 —— 只有函数收尾那个 `}` 用它（上游是 `lines.append("}")`）。
fn line_put0(mem: ptr, s: str) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let out: ptr = ptr_add(mem, M_OUT);
    let c0: u32 = app(out, ld32(st, E_OUT), s);
    let c1: u32 = app(out, c0, "\n");
    let _a: u32 = st32(st, E_OUT, c1);
    let _b: u32 = st32(st, E_ANY, 1);
    let _c: u32 = st32(st, E_NL2, 0);
    let _d: u32 = st32(st, E_BR, 0);
    return c1;
}

/// 控制流前面留一个空行 —— **但别在开头留**（`{` 后面直接一个空行很难看），
/// 也别连着留两个。
fn gap(mem: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    if ld32(st, E_ANY) == 0 || ld32(st, E_NL2) == 1 || ld32(st, E_BR) == 1 {
        return 0;
    }
    let c: u32 = app(ptr_add(mem, M_OUT), ld32(st, E_OUT), "\n");
    let _a: u32 = st32(st, E_OUT, c);
    let _b: u32 = st32(st, E_NL2, 1);
    let _c: u32 = st32(st, E_BR, 0);
    return 1;
}

// ---- 语句

fn stmts(mem: ptr, start: u32, cnt: u32, depth: u32) -> u32 {
    let i: u32 = 0;
    while i < cnt {
        let _r: u32 = emit_stmt(mem, li_get(mem, start + i), depth);
        i = i + 1;
    }
    return 0;
}

fn emit_stmt(mem: ptr, s: u32, depth: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let eb: ptr = ptr_add(mem, M_EB);
    let k: u32 = nd_get(mem, s, ND_KIND);
    if k == NK_DECL {
        let tid: u32 = nd_get(mem, s, ND_A);
        if tid == 10 {
            let _e: u32 = em_fail(mem);      // 上游: 不能声明 `void` 变量
            return 0;
        }
        let no: u32 = nd_get(mem, s, ND_C);
        let nl: u32 = nd_get(mem, s, ND_D);
        let nmb: ptr = ptr_add(mem, M_TMP + 916);   // `decl_bind` 的 (起点, 长度)
        // **声明走 `decl_bind`**（`#119` / `#120`）：块里遮蔽外层的名要**改名**、
        // 同一层重复声明要**拒**。名字池的游标由 `decl_bind` 推。
        let ok0: u32 = decl_bind(mem, no, nl, nmb);
        if ok0 == 0 {
            return 0;
        }
        let o0: u32 = ld32(nmb, 0);
        let ln: u32 = ld32(nmb, 4);
        let o: u32 = app(eb, 0, "let ");
        let o2: u32 = appn(eb, o, ptr_add(mem, M_VB), o0, ln);
        let o3: u32 = app(eb, o2, ": ");
        let o4: u32 = app(eb, o3, ty_text(tid));
        let o5: u32 = app(eb, o4, " = ");
        let e: u32 = nd_get(mem, s, ND_E);
        let o6: u32 = 0;
        if e == 0 {
            // 见文件头 §语义选择 1：C 的未初始化在这里变成确定的零值
            o6 = app(eb, o5, "0");
        } else {
            // **初值在声明生效之前发射**（`#234`，与上游 `stmt(Decl)` 同序）：
            // 块里遮蔽外层的 `int x = x + 100;` 右边那个 `x` 是外层的 ——
            // 先 `var_decl` 的话它会解析成刚改名的 `x__1`，发出一条自引用声明。
            o6 = sink(mem, e - 1, tid, eb, o5);
        }
        let _vd: u32 = var_decl(mem, no, nl, o0, ln, tid);
        let o7: u32 = app(eb, o6, ";");
        return line_put(mem, o7, depth, 0);
    }
    if k == NK_ASSIGN {
        let f: u32 = var_find(mem, nd_get(mem, s, ND_A), nd_get(mem, s, ND_B));
        if f == 0 {
            let _e: u32 = em_fail(mem);      // 赋值给没声明过的
            return 0;
        }
        let o: u32 = appn(eb, 0, ptr_add(mem, M_VB), var_oo(mem, f), var_ol(mem, f));
        let o2: u32 = app(eb, o, " = ");
        // **赋值位置要按左边声明的类型做隐式转换**（`#125`）
        let o3: u32 = sink(mem, nd_get(mem, s, ND_C), var_ty(mem, f), eb, o2);
        let o4: u32 = app(eb, o3, ";");
        return line_put(mem, o4, depth, 0);
    }
    if k == NK_RETURN {
        let e: u32 = nd_get(mem, s, ND_A);
        if e == 0 {
            // 裸 `return` —— 本语言的 `()` 函数没有提前退出（上游点名拒，见 `trans_core`）
            let _e: u32 = em_fail(mem);
            return 0;
        }
        // **要的是这个函数声明的返回类型，不是写死的 `int`。**
        // `bool positive(int x) { return x > 0; }` 里那个 `x > 0` 本来就是条件，
        // 写死"整数"会把它补成 `(x > 0) as i32` —— 而函数声明的是 `-> bool`，
        // 那是本语言的类型错。
        let o: u32 = app(eb, 0, "return ");
        // **返回位置要按函数声明的返回类型做隐式转换**（`#125`）
        let o2: u32 = sink(mem, e, ld32(st, E_RET), eb, o);
        let o3: u32 = app(eb, o2, ";");
        return line_put(mem, o3, depth, 0);
    }
    if k == NK_IF {
        gap(mem);
        let o: u32 = app(eb, 0, "if ");
        let o2: u32 = ex_want(mem, nd_get(mem, s, ND_A), W_BOOL, eb, o);
        let o3: u32 = app(eb, o2, " {");
        let _l1: u32 = line_put(mem, o3, depth, 1);
        // 体是**独立的一层作用域**（`#120`：体里重名的声明要改名、出块撤掉）
        let _t: u32 = em_block(mem, nd_get(mem, s, ND_B), nd_get(mem, s, ND_C), depth + 1);
        if nd_get(mem, s, ND_E) == FAIL {
            return line_lit(mem, "}", depth, 0);
        }
        let _l2: u32 = line_lit(mem, "} else {", depth, 1);   // 以 `{` 收尾 —— `gap` 看这个
        let _e2: u32 = em_block(mem, nd_get(mem, s, ND_D), nd_get(mem, s, ND_E), depth + 1);
        return line_lit(mem, "}", depth, 0);
    }
    if k == NK_WHILE {
        gap(mem);
        let o: u32 = app(eb, 0, "while ");
        let o2: u32 = ex_want(mem, nd_get(mem, s, ND_A), W_BOOL, eb, o);
        let o3: u32 = app(eb, o2, " {");
        let _l1: u32 = line_put(mem, o3, depth, 1);
        // 体是**独立的一层作用域**（`#120`）
        let _b: u32 = em_block(mem, nd_get(mem, s, ND_B), nd_get(mem, s, ND_C), depth + 1);
        return line_lit(mem, "}", depth, 0);
    }
    if k == NK_FOR {
        return emit_for(mem, s, depth);
    }
    if k == NK_EXPR {
        let c: u32 = nd_get(mem, s, ND_A);
        if nd_get(mem, c, ND_KIND) != NK_CALL {
            let _e: u32 = em_fail(mem);      // 表达式语句只收函数调用
            return 0;
        }
        let o: u32 = raw_ex(mem, c, eb, 0);
        let o2: u32 = app(eb, o, ";");
        return line_put(mem, o2, depth, 0);
    }
    let _e: u32 = em_fail(mem);
    return 0;
}

/// `for (init; cond; step) body` -> `init; while cond { body; step; }`。
///
/// **Loment 没有裸块**，所以 `for (int i = …)` 里那个 `i` 不能靠一层 `{ }` 圈住 ——
/// 只能改名外提（见文件头 §语义选择 2）。改名是安全的：C 的 for 作用域本来就在
/// 循环结束处结束，外面看不到它。
///
/// 初值是**声明**时改名；初值是**赋值**（`for (i = 3; …)`）时原地发出，名字不动 ——
/// 那种写法用的是外面的变量，本来就该影响外面。
fn emit_for(mem: ptr, s: u32, depth: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let eb: ptr = ptr_add(mem, M_EB);
    gap(mem);
    let init: u32 = nd_get(mem, s, ND_A);
    let vno: u32 = 0;
    let vnl: u32 = 0;
    let sv_k: u32 = 0;
    let sv_oo: u32 = 0;
    let sv_ol: u32 = 0;
    let sv_ty: u32 = 0;
    let is_decl: u32 = 0;
    if init != 0 && nd_get(mem, init, ND_KIND) == NK_DECL {
        is_decl = 1;
        let tid: u32 = nd_get(mem, init, ND_A);
        if tid == 10 {
            let _e: u32 = em_fail(mem);
            return 0;
        }
        vno = nd_get(mem, init, ND_C);
        vnl = nd_get(mem, init, ND_D);
        // 老的那条先记下来（`fresh` 是在它还占着名字的时候问的 —— 与上游同序）
        sv_k = var_find(mem, vno, vnl);
        if sv_k > 0 {
            sv_oo = var_oo(mem, sv_k);
            sv_ol = var_ol(mem, sv_k);
            sv_ty = var_ty(mem, sv_k);
        }
        let o0: u32 = ld32(st, E_VBC);
        let ln: u32 = fresh(mem, vno, vnl);
        let o: u32 = app(eb, 0, "let ");
        let o2: u32 = appn(eb, o, ptr_add(mem, M_VB), o0, ln);
        let o3: u32 = app(eb, o2, ": ");
        let o4: u32 = app(eb, o3, ty_text(tid));
        let o5: u32 = app(eb, o4, " = ");
        let ie: u32 = nd_get(mem, init, ND_E);
        let o6: u32 = 0;
        if ie == 0 {
            o6 = app(eb, o5, "0");
        } else {
            // **初值在循环变量生效之前发射**（`#234`，与上游 `emit_for` 同序）：
            // `for (int x = x + 1; …)` 右边那个 `x` 是外层的那个。
            o6 = sink(mem, ie - 1, tid, eb, o5);
        }
        let _vd: u32 = var_decl(mem, vno, vnl, o0, ln, tid);
        let o7: u32 = app(eb, o6, ";");
        let _l: u32 = line_put(mem, o7, depth, 0);
    } else {
        if init != 0 {
            let _r: u32 = emit_stmt(mem, init, depth);
        }
    }
    let cond: u32 = nd_get(mem, s, ND_B);
    let o: u32 = app(eb, 0, "while ");
    let o2: u32 = 0;
    if cond == 0 {
        o2 = app(eb, o, "true");
    } else {
        o2 = ex_want(mem, cond, W_BOOL, eb, o);
    }
    let o3: u32 = app(eb, o2, " {");
    let _l2: u32 = line_put(mem, o3, depth, 1);
    // 体是**独立的一层作用域**（`#119`：体里 `int i = 9;` 遮蔽循环变量时，
    // 步进必须还写到循环变量那个名上，而不是被遮蔽的那个）
    let _b: u32 = em_block(mem, nd_get(mem, s, ND_D), nd_get(mem, s, ND_E), depth + 1);
    let step: u32 = nd_get(mem, s, ND_C);
    if step != 0 {
        let _r: u32 = emit_stmt(mem, step, depth + 1);   // 步进在体**之后**
    }
    let _l3: u32 = line_lit(mem, "}", depth, 0);
    // 循环结束：那个名字的作用域也结束（C 的 for 语义）。有遮蔽就把外层的还回去。
    if is_decl == 1 {
        let k: u32 = var_find(mem, vno, vnl);
        if k > 0 {
            if sv_k == 0 {
                let _d: u32 = var_kill(mem, k);
            } else {
                let _r2: u32 = var_set(mem, k, sv_oo, sv_ol, sv_ty);
            }
        }
    }
    return 1;
}

/// 一个函数一份 `Emitter`：表归零、名字池归零、`fresh` 计数归零，然后发一行头、
/// 发体、再发收尾的 `}`。
fn emit_fn(mem: ptr, f: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let eb: ptr = ptr_add(mem, M_EB);
    let _1: u32 = st32(st, E_VN, 0);
    let _2: u32 = st32(st, E_VBC, 0);
    let _3: u32 = st32(st, E_FN_N, 0);
    let _4: u32 = st32(st, E_ANY, 0);
    let _5: u32 = st32(st, E_NL2, 0);
    let _6: u32 = st32(st, E_BR, 0);
    let _7: u32 = st32(st, E_RET, fn_get(mem, f, 0));
    let _8: u32 = st32(st, E_SD, 0);
    let _9: u32 = st32(st, E_SP, 0);
    let p0: u32 = fn_get(mem, f, 4);
    let pn: u32 = fn_get(mem, f, 5);
    let i: u32 = 0;
    while i < pn {
        let t: u32 = li_get(mem, p0 + i * 3);
        let no: u32 = li_get(mem, p0 + i * 3 + 1);
        let nl: u32 = li_get(mem, p0 + i * 3 + 2);
        let o0: u32 = ld32(st, E_VBC);
        let ln: u32 = safe_name(mem, no, nl, ptr_add(ptr_add(mem, M_VB), o0));
        let _s0: u32 = st32(st, E_VBC, o0 + ln);
        let _vd: u32 = var_decl(mem, no, nl, o0, ln, t);
        i = i + 1;
    }
    let o: u32 = app(eb, 0, "pub fn ");
    let o2: u32 = appn(eb, o, ptr_add(mem, M_SCR), fn_get(mem, f, 2), fn_get(mem, f, 3));
    let o3: u32 = app(eb, o2, "(");
    let j: u32 = 0;
    let cur: u32 = o3;
    while j < pn {
        if j > 0 {
            cur = app(eb, cur, ", ");
        }
        let k: u32 = var_find(mem, li_get(mem, p0 + j * 3 + 1), li_get(mem, p0 + j * 3 + 2));
        cur = appn(eb, cur, ptr_add(mem, M_VB), var_oo(mem, k), var_ol(mem, k));
        cur = app(eb, cur, ": ");
        cur = app(eb, cur, ty_text(li_get(mem, p0 + j * 3)));
        j = j + 1;
    }
    let o4: u32 = app(eb, cur, ")");
    let o5: u32 = 0;
    if fn_get(mem, f, 0) != 10 {
        o5 = app(eb, o4, " -> ");
        o5 = app(eb, o5, ty_text(fn_get(mem, f, 0)));
    } else {
        o5 = o4;
    }
    let o6: u32 = app(eb, o5, " {");
    let _l1: u32 = line_put_ni(mem, o6, 1);
    let _b: u32 = stmts(mem, fn_get(mem, f, 6), fn_get(mem, f, 7), 0);
    let _l2: u32 = line_put0(mem, "}");
    return 1;
}

/// `translate()` —— 整份源发出去。返回 1（成功了）；失败时 `E_ERR` 是 1。
///
/// 顺序与上游一字不差：先 `unit()`（有语法错就先报语法错）、再查重名、
/// 再按 `keep` 过滤、最后逐个函数发射。
fn emit_unit(mem: ptr, ustart: u32, ucnt: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let _a: u32 = st32(st, E_OUT, 0);
    let _b: u32 = st32(st, E_NL2, 0);
    let _c: u32 = st32(st, E_BR, 0);
    // 重名（Loment 没有重载，名字必须精确）
    let i: u32 = 0;
    while i < ucnt {
        let f: u32 = li_get(mem, ustart + i);
        let j: u32 = i + 1;
        while j < ucnt {
            let g: u32 = li_get(mem, ustart + j);
            if fn_get(mem, f, 3) == fn_get(mem, g, 3)
                    && same_n(ptr_add(mem, M_SCR), fn_get(mem, f, 2),
                              ptr_add(mem, M_SCR), fn_get(mem, g, 2),
                              fn_get(mem, f, 3)) == 1 {
                let _e: u32 = em_fail(mem);
                return 0;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let has_keep: u32 = 0;
    if ld32(st, E_KN) > 0 {
        has_keep = 1;
    }
    let nseen: u32 = 0;
    let k: u32 = 0;
    while k < ucnt {
        let f: u32 = li_get(mem, ustart + k);
        if has_keep == 1 && keep_has(mem, fn_get(mem, f, 2), fn_get(mem, f, 3)) == 0 {
            k = k + 1;
        } else {
            if nseen > 0 {
                let c: u32 = app(ptr_add(mem, M_OUT), ld32(st, E_OUT), "\n");
                let _z1: u32 = st32(st, E_OUT, c);
                let _z2: u32 = st32(st, E_NL2, 1);
            }
            let _r: u32 = emit_fn(mem, f);
            nseen = nseen + 1;
            k = k + 1;
        }
    }
    if nseen == 0 {
        let c: u32 = app(ptr_add(mem, M_OUT), ld32(st, E_OUT), "\n");
        let _z: u32 = st32(st, E_OUT, c);
    }
    return 1;
}

// ================================================================ Python（第五门）
//
// `--lang python` 对着 `tools/pytrans.py` 移植 —— **语法树 -> Loment 源码**那一条路
// （与 `lompotc --python` 不是一回事：那一半是"源 -> Potato 对象"）。
//
// **这一门的机器与前四门不一样**：C / C++ / Java / C# 那几个是"花括号 + 分号"，
// 解析器一套；Python 是**换行 + 缩进**，块由空白决定。所以这里是一台**自己的**词法器
// （带 INDENT / DEDENT）与一台**自己的**递归下降。
//
// 与 `pytrans.py` 的关系：那边坐在 CPython 的 `ast` 上，这边自己读源码。三条口径要
// 逐条对齐（写在下面各处注解里）：
//
//   * **数字一律按十进制发**（`raw(Constant int)` 是 `str(e.value)`）—— 与 C 那几门
//     "原文照抄"不同：`0x1f` 这里要发成 `31`。
//   * **`for i in range(a, b)` 是一条定义**（`pytrans` 文件头 §`for`）：降级成
//     `let i: i64 = a; while i < b { …; i = i + 1; }`，**两个后果都照做** ——
//     循环走完 `i` 是 `b`（不是 `b-1`），且**循环体里给 `i` 赋值要报错**
//     （那条降级式在那种写法下不成立）。`while` 的体里直接声明的 `for` 变量也一并
//     进那张"不许赋值"的表，与上游 `_loopvars` 逐字对齐。
//   * **`bool` 与 `int`**：`bool -> int` **不转、报错**（Python 的 `bool` 是 `int` 的
//     子类、`and`/`or` 返回**操作数**，那个意思本语言表达不出来）；`int -> bool`
//     在条件位置**转**成 `x != 0`。与 C 那门"两个方向都补"正好相反，判据是同一条。
//
// **刻意偏离**（与那几门同样的三条）：只报类别不报文案（退出码 1 = 子集外 /
// 2 = 解析不过）、名字表与节点表容量固定（超了报错不静默丢）。
//
// ⚠ 参数下标的口径在本文件里不统一，**用之前先看签名那行**：`(a, b)` 是**半开区间**、
// `(a, l)` 是**起点+长度**。上一次混了这两个，症状是每条注解都"无映射"。

// ---------------------------------------------------------------- Python 那一门的状态
//
// 都放在 `M_TMP + 1000` 之后（li 那两张表到 +828，发射器那几格在 840..900）。
const PY_TOKS: u32 = 1000;         // 词法器: 记号数
const PY_ERR: u32 = 1004;          // 0 好 / 1 子集外 / 2 解析不过
const PY_ERRLN: u32 = 1008;        // 出错的行号
const PY_LSTK: u32 = 1012;         // 缩进栈（32 层 × 4）
const PY_LCNT: u32 = 1140;         // 缩进栈的深度（栈顶下标）
const PY_PI: u32 = 1144;           // 解析器游标（第几个记号）
const PY_CN: u32 = 1148;           // 常量表条数
const PY_VN: u32 = 1152;           // 变量表条数
const PY_FTN: u32 = 1156;          // "循环变量"表条数
const PY_SAV: u32 = 1160;          // 它的存/取点（`while` 那一支用）
const PY_LINE: u32 = 1164;         // 当前记号的行号
const PY_MDOC: u32 = 1168;         // 模块文档字符串（在 `M_PS` 里的 off/len）
const PY_MDL: u32 = 1172;
const PY_MPS: u32 = 1176;          // `M_PS` 的游标
const PY_MCN: u32 = 1180;          // **模块级**常量的条数（调用方给的不发 `pub const`）

/// 常量 / 变量共用的表: (名字 off, 名字 len, 类型 id)
const M_PC: u32 = 1503232;         // 128*20 = 2560 -> 1505792   常量表（带值）
const M_PV: u32 = 1505792;         // 128*12 = 1536 -> 1507328   变量表
const M_PF: u32 = 1507328;         // 64*8   = 512  -> 1507840   循环变量表
const M_PS: u32 = 1507840;         // 16384         -> 1524224   解出来的文档字符串
const M_RS: u32 = 1524224;         // 1024          -> 1525248   Python 解析器的暂存格
const M_CAP: u32 = 1541632;

const CT_NO: u32 = 0;
const CT_NL: u32 = 4;
const CT_TY: u32 = 8;

// 记号种类（前三个与前四门同号，后三个是这一门独有）
const PT_ID: u32 = 1;
const PT_NUM: u32 = 2;
const PT_OP: u32 = 3;
const PT_NL: u32 = 4;              // 逻辑行结束
const PT_IND: u32 = 5;             // 缩进加深
const PT_DED: u32 = 6;             // 缩进回到上一层
const PT_STR: u32 = 7;             // 字符串字面量（只有文档字符串用得上）

fn pyt(mem: ptr) -> ptr {
    return ptr_add(mem, M_TOK);
}

fn pt_kind(mem: ptr, k: u32) -> u32 {
    if k >= ld32(ptr_add(mem, M_TMP), PY_TOKS) {
        return 0;
    }
    return ld32(pyt(mem), k * 16 + 8);
}

fn pt_off(mem: ptr, k: u32) -> u32 {
    if k >= ld32(ptr_add(mem, M_TMP), PY_TOKS) {
        return 0;
    }
    return ld32(pyt(mem), k * 16 + 0);
}

fn pt_len(mem: ptr, k: u32) -> u32 {
    if k >= ld32(ptr_add(mem, M_TMP), PY_TOKS) {
        return 0;
    }
    return ld32(pyt(mem), k * 16 + 4);
}

fn pt_line(mem: ptr, k: u32) -> u32 {
    let n: u32 = ld32(ptr_add(mem, M_TMP), PY_TOKS);
    if n == 0 {
        return 1;
    }
    if k >= n {
        return ld32(pyt(mem), (n - 1) * 16 + 12);
    }
    return ld32(pyt(mem), k * 16 + 12);
}

/// 词法出错（都是"这份 Python 本身有问题"那一类）。
fn pt_err(mem: ptr, line: u32) -> u32 {
    let _a: u32 = st32(ptr_add(mem, M_TMP), PY_ERR, 2);
    let _b: u32 = st32(ptr_add(mem, M_TMP), PY_ERRLN, line);
    return 0;
}

/// 子集外出错（"没实现"那一类）。
fn pt_uns(mem: ptr, line: u32) -> u32 {
    if ld32(ptr_add(mem, M_TMP), PY_ERR) == 0 {
        let _a: u32 = st32(ptr_add(mem, M_TMP), PY_ERR, 1);
        let _b: u32 = st32(ptr_add(mem, M_TMP), PY_ERRLN, line);
    }
    return 0;
}

fn pt_put(mem: ptr, kind: u32, off: u32, ln: u32, line: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let k: u32 = ld32(st, PY_TOKS);
    if k >= 16000 {
        let _e: u32 = pt_err(mem, line);
        return 0;
    }
    let _1: u32 = st32(pyt(mem), k * 16 + 0, off);
    let _2: u32 = st32(pyt(mem), k * 16 + 4, ln);
    let _3: u32 = st32(pyt(mem), k * 16 + 8, kind);
    let _4: u32 = st32(pyt(mem), k * 16 + 12, line);
    let _5: u32 = st32(st, PY_TOKS, k + 1);
    return 1;
}

/// 缩进 = 前导空白的**宽度**（制表按 8 对齐算 —— Python 的口径；语料是纯空格）。
fn pt_indent(src: ptr, i: u32, j: u32) -> u32 {
    let w: u32 = 0;
    let k: u32 = i;
    while k < j {
        let c: u32 = load8(src, k);
        if c == 32 {
            w = w + 1;
        } else {
            if c == 9 {
                w = (w / 8) * 8 + 8;
            } else {
                return w;
            }
        }
        k = k + 1;
    }
    return w;
}

fn pt_is_digit(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return 1;
    }
    return 0;
}

fn pt_hexval(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10;
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10;
    }
    return 99;
}

/// 一个数字字面量的**值**（`0x1f` / `0o17` / `0b101` / `1_000` / 十进制）。
/// 词法器把它放进记号的 `off` 那一格 —— 这一门发的是十进制值，不是原文
/// （上游 `raw` 就是 `str(e.value)`，与 C 那几门照抄原文不同）。
fn pt_number(src: ptr, i: u32, j: u32) -> u32 {
    let base: u32 = 10;
    let k: u32 = i;
    if load8(src, k) == 48 && k + 1 < j {
        let d: u32 = load8(src, k + 1);
        if d == 120 || d == 88 {
            base = 16;
            k = k + 2;
        }
        if d == 111 || d == 79 {
            base = 8;
            k = k + 2;
        }
        if d == 98 || d == 66 {
            base = 2;
            k = k + 2;
        }
    }
    let v: u32 = 0;
    while k < j {
        let c: u32 = load8(src, k);
        if c != 95 {
            let dg: u32 = pt_hexval(c);
            if dg >= base {
                return v;
            }
            v = v * base + dg;
        }
        k = k + 1;
    }
    return v;
}

/// 一个字符串字面量（含引号）扫到哪儿结束；返回**闭引号之后**的下标。
/// 三引号跨行；单引号串到行尾为止。
fn pt_str_end(src: ptr, n: u32, q: u32, k: u32) -> u32 {
    let tq: u32 = 0;
    if k + 2 < n && load8(src, k + 1) == q && load8(src, k + 2) == q {
        tq = 1;
    }
    let j: u32 = k + 1;
    if tq == 1 {
        j = k + 3;
    }
    while j < n {
        let d: u32 = load8(src, j);
        if d == 92 {
            j = j + 2;
        } else {
            if d == q {
                if tq == 0 {
                    return j + 1;
                }
                if j + 2 < n && load8(src, j + 1) == q && load8(src, j + 2) == q {
                    return j + 3;
                }
                j = j + 1;
            } else {
                if d == 10 && tq == 0 {
                    return j;
                }
                j = j + 1;
            }
        }
    }
    return n;
}

/// 词法器。与上游 `ast` 的差别只有一处要记：**这里自己造 INDENT / DEDENT**
/// （`ast` 把缩进做进树里，我们没有树）。
///
/// 缩进只在**逻辑行**的首个记号处比：空行与纯注释行不算（Python 也这么定）。
/// 括号里换行不算逻辑行结束（隐式续行）。
fn py_lex(mem: ptr, src: ptr, n: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let _z1: u32 = st32(st, PY_TOKS, 0);
    let _z2: u32 = st32(st, PY_ERR, 0);
    let _z3: u32 = st32(st, PY_LCNT, 0);
    let i: u32 = 0;
    let line: u32 = 1;
    let depth: u32 = 0;                        // 括号深度（>0 时不结束逻辑行）
    let at_start: u32 = 1;                     // 这一行的首个记号还没出现
    let first: u32 = 1;                        // 整个文件的第一行
    while i < n {
        if at_start == 1 {
            let j: u32 = i;
            while j < n && load8(src, j) != 10 {
                j = j + 1;
            }
            let k: u32 = pt_indent(src, i, j);
            let c: u32 = 0;
            if i + k < j {
                c = load8(src, i + k);
            }
            if c == 0 || c == 35 {
                // 空行或纯注释行: 不动缩进栈
                i = j + 1;
                if j < n {
                    line = line + 1;
                }
            } else {
                let ind: u32 = k;
                if first == 1 && ind != 0 {
                    let _e: u32 = pt_err(mem, line);
                    return 0;
                }
                first = 0;
                let top: u32 = ld32(st, PY_LCNT);
                let cur: u32 = ld32(st, PY_LSTK + top * 4);
                if ind > cur {
                    if top >= 30 {
                        let _e: u32 = pt_err(mem, line);
                        return 0;
                    }
                    let _p: u32 = st32(st, PY_LCNT, top + 1);
                    let _q: u32 = st32(st, PY_LSTK + (top + 1) * 4, ind);
                    let _t: u32 = pt_put(mem, PT_IND, 0, 0, line);
                } else {
                    if ind < cur {
                        // ⚠ 先看"要不要弹"，**再看栈空没空** —— 反过来的话，最后一层
                        // 弹到栈底（0）时会被当成"缩进不合法"报出来：
                        // 两个函数之间那一下必然弹到 0，于是**多函数模块一条都发不出来**。
                        let going: u32 = 1;
                        while going == 1 {
                            let t2: u32 = ld32(st, PY_LCNT);
                            if ld32(st, PY_LSTK + t2 * 4) > ind {
                                if t2 == 0 {
                                    let _e: u32 = pt_err(mem, line);
                                    return 0;
                                }
                                let _p: u32 = st32(st, PY_LCNT, t2 - 1);
                                let _t: u32 = pt_put(mem, PT_DED, 0, 0, line);
                            } else {
                                going = 0;
                            }
                        }
                        if ld32(st, PY_LSTK + ld32(st, PY_LCNT) * 4) != ind {
                            let _e: u32 = pt_err(mem, line);
                            return 0;
                        }
                    }
                }
                i = i + ind;
                at_start = 0;
            }
        } else {
            let c: u32 = load8(src, i);
            if c == 32 || c == 9 || c == 13 {
                i = i + 1;
            } else {
                if c == 10 {
                    if depth > 0 {
                        i = i + 1;
                        line = line + 1;
                    } else {
                        let _t: u32 = pt_put(mem, PT_NL, 0, 0, line);
                        i = i + 1;
                        line = line + 1;
                        at_start = 1;
                    }
                } else {
                    if c == 35 {
                        while i < n && load8(src, i) != 10 {
                            i = i + 1;
                        }
                    } else {
                        if c == 92 && i + 1 < n && load8(src, i + 1) == 10 {
                            i = i + 2;             // 显式续行
                            line = line + 1;
                        } else {
                            if is_id0(c) == 1 {
                                // 名字；`r"…"` / `f"…"` 那种前缀串也在这里认出
                                let j: u32 = i;
                                while j < n && is_w(load8(src, j)) == 1 {
                                    j = j + 1;
                                }
                                let pre: u32 = j - i;
                                let q: u32 = 0;
                                if j < n {
                                    q = load8(src, j);
                                }
                                if (q == 34 || q == 39) && pre <= 2 {
                                    if pre == 1 && (c == 114 || c == 82) {
                                        let e: u32 = pt_str_end(src, n, q, j);
                                        let _t: u32 = pt_put(mem, PT_STR, i, e - i, line);
                                        i = e;
                                    } else {
                                        if pre == 0 {
                                            let e: u32 = pt_str_end(src, n, q, j);
                                            let _t: u32 = pt_put(mem, PT_STR, i, e - i, line);
                                            i = e;
                                        } else {
                                            // `f` / `b` / `u` 前缀: 本子集不收（早拒比晚拒好）
                                            let _u: u32 = pt_uns(mem, line);
                                            return 0;
                                        }
                                    }
                                } else {
                                    let _t: u32 = pt_put(mem, PT_ID, i, j - i, line);
                                    i = j;
                                }
                            } else {
                                if pt_is_digit(c) == 1 {
                                    let j: u32 = i;
                                    while j < n && (is_w(load8(src, j)) == 1
                                                    || load8(src, j) == 46) {
                                        j = j + 1;
                                    }
                                    if find_ch(src, i, j, 46) != FAIL {
                                        let _u: u32 = pt_uns(mem, line);   // 浮点
                                        return 0;
                                    }
                                    let v: u32 = pt_number(src, i, j);
                                    let _t: u32 = pt_put(mem, PT_NUM, v, 0, line);
                                    i = j;
                                } else {
                                    if c == 34 || c == 39 {
                                        let e: u32 = pt_str_end(src, n, c, i);
                                        let _t: u32 = pt_put(mem, PT_STR, i, e - i, line);
                                        i = e;
                                    } else {
                                        let l: u32 = py_op_len(src, i, n);
                                        if l == 0 {
                                            let _e: u32 = pt_err(mem, line);
                                            return 0;
                                        }
                                        if l == 1 && load8(src, i) == 40 {
                                            depth = depth + 1;
                                        }
                                        if l == 1 && load8(src, i) == 41 {
                                            if depth > 0 {
                                                depth = depth - 1;
                                            }
                                        }
                                        if l == 1 && (load8(src, i) == 91
                                                      || load8(src, i) == 123) {
                                            depth = depth + 1;
                                        }
                                        if l == 1 && (load8(src, i) == 93
                                                      || load8(src, i) == 125) {
                                            if depth > 0 {
                                                depth = depth - 1;
                                            }
                                        }
                                        let _t: u32 = pt_put(mem, PT_OP, i, l, line);
                                        i = i + l;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // 收尾: 补一个逻辑行结束，再把缩进栈弹空
    if ld32(st, PY_TOKS) > 0 && pt_kind(mem, ld32(st, PY_TOKS) - 1) != PT_NL {
        let _t: u32 = pt_put(mem, PT_NL, 0, 0, line);
    }
    let going: u32 = 1;
    while going == 1 {
        let t2: u32 = ld32(st, PY_LCNT);
        if t2 == 0 {
            going = 0;
        } else {
            let _p: u32 = st32(st, PY_LCNT, t2 - 1);
            let _t: u32 = pt_put(mem, PT_DED, 0, 0, line);
        }
    }
    let _t: u32 = pt_put(mem, 0, 0, 0, line);
    return 1;
}

/// Python 这一门的运算符长度（最长优先）。**只收子集里的那些** —— 其余交给上游
/// 那套"点名拒"的老规矩：能一眼看出是哪个词就报哪个词。
fn py_op_len(src: ptr, i: u32, n: u32) -> u32 {
    if i + 1 < n {
        let a: u32 = load8(src, i);
        let b: u32 = load8(src, i + 1);
        let two: u32 = 0;
        if (a == 42 && b == 42) || (a == 47 && b == 47) {
            two = 1;                                   // `**` `//`
        }
        if (a == 60 && b == 60) || (a == 62 && b == 62) {
            two = 1;                                   // `<<` `>>`
        }
        if (a == 60 && b == 61) || (a == 62 && b == 61) {
            two = 1;                                   // `<=` `>=`
        }
        if (a == 61 && b == 61) || (a == 33 && b == 61) {
            two = 1;                                   // `==` `!=`
        }
        if (a == 43 && b == 61) || (a == 45 && b == 61) {
            two = 1;                                   // `+=` `-=`
        }
        if (a == 42 && b == 61) || (a == 47 && b == 61) {
            two = 1;                                   // `*=` `/=`
        }
        if (a == 37 && b == 61) || (a == 38 && b == 61) {
            two = 1;                                   // `%=` `&=`
        }
        if (a == 124 && b == 61) || (a == 94 && b == 61) {
            two = 1;                                   // `|=` `^=`
        }
        if a == 45 && b == 62 {
            two = 1;                                   // `->`（漏了它 = 每条注解都读不出来）
        }
        if two == 1 {
            return 2;
        }
    }
    let c: u32 = load8(src, i);
    if c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 || c == 124
            || c == 94 || c == 126 || c == 60 || c == 62 || c == 40 || c == 41
            || c == 91 || c == 93 || c == 123 || c == 125 || c == 44 || c == 58
            || c == 46 || c == 61 || c == 59 || c == 64 {
        return 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 解析
//
// 一台**自己的**递归下降 —— 前四门那台吃的是花括号与分号，这台吃换行与缩进。
// 语法树仍用同一张节点表（`M_NODE`），只有两处是新加的：
//   * `NK_PFOR` —— Python 的 `for i in range(a, b)`，形状与 C 那门不同
//     （**不改名外提**：上游用的是同一个 `_safe` 名字）
//   * `NK_DOC`  —— 文档字符串（上游把它转成 `///` 注释发出去，**带走不是丢掉**）
// 另加一个 `NK_PASS`（什么都不发）。`NK_UN` 多两个编号：3 = `~`、4 = 一元 `+`。

const NK_PFOR: u32 = 13;
const NK_DOC: u32 = 14;
const NK_PASS: u32 = 15;
const NK_BOOL: u32 = 16;           // `and` / `or` —— **n 元**（`a and b and c` 是一个节点）

const UN_SUB: u32 = 1;             // 一元 `-`
const UN_NOT: u32 = 2;             // `not`
const UN_INV: u32 = 3;             // `~`
const UN_POS: u32 = 4;             // 一元 `+`

fn pp(st: ptr, c: u32) -> u32 {
    return st32(ptr_add(st, 0), 0, 0);
}

fn pp_i(mem: ptr) -> u32 {
    return ld32(ptr_add(mem, M_TMP), PY_PI);
}

fn pp_err(mem: ptr) -> u32 {
    if ld32(ptr_add(mem, M_TMP), PY_ERR) == 0 {
        let _a: u32 = st32(ptr_add(mem, M_TMP), PY_ERR, 2);
        let _b: u32 = st32(ptr_add(mem, M_TMP), PY_ERRLN,
                           pt_line(mem, ld32(ptr_add(mem, M_TMP), PY_PI)));
    }
    return 0;
}

/// 子集外 —— **只在还没有错的时候写**（第一个错才是根因）。
fn pp_uns(mem: ptr) -> u32 {
    if ld32(ptr_add(mem, M_TMP), PY_ERR) == 0 {
        let _a: u32 = st32(ptr_add(mem, M_TMP), PY_ERR, 1);
        let _b: u32 = st32(ptr_add(mem, M_TMP), PY_ERRLN,
                           pt_line(mem, ld32(ptr_add(mem, M_TMP), PY_PI)));
    }
    return 0;
}

/// 第 `k` 个记号（从游标数）是文本 `text` 吗。
fn pp_at(mem: ptr, src: ptr, text: str, k: u32) -> u32 {
    let j: u32 = ld32(ptr_add(mem, M_TMP), PY_PI) + k;
    let l: u32 = pt_len(mem, j);
    if l != str_len(text) {
        return 0;
    }
    return eq(src, pt_off(mem, j), text);
}

fn pp_is(mem: ptr, src: ptr, text: str) -> u32 {
    return pp_at(mem, src, text, 0);
}

fn pp_next(mem: ptr) -> u32 {
    return st32(ptr_add(mem, M_TMP), PY_PI, ld32(ptr_add(mem, M_TMP), PY_PI) + 1);
}

/// 吃一个文本记号；不在就报"解析不过"。
fn pp_want(mem: ptr, src: ptr, text: str) -> u32 {
    if pp_at(mem, src, text, 0) == 0 {
        return pp_err(mem);
    }
    let _n: u32 = pp_next(mem);
    return 1;
}

fn pp_kind(mem: ptr, k: u32) -> u32 {
    return pt_kind(mem, ld32(ptr_add(mem, M_TMP), PY_PI) + k);
}

fn pp_off(mem: ptr, k: u32) -> u32 {
    return pt_off(mem, ld32(ptr_add(mem, M_TMP), PY_PI) + k);
}

/// 吃一个名字（`outp` 收 (off, len)）；不是名字就报错。
fn pp_id(mem: ptr, outp: ptr) -> u32 {
    if pp_kind(mem, 0) != PT_ID {
        let _e: u32 = pp_err(mem);
        return 0;
    }
    let _a: u32 = st32(outp, 0, pp_off(mem, 0));
    let _b: u32 = st32(outp, 4, pt_len(mem, ld32(ptr_add(mem, M_TMP), PY_PI)));
    let _n: u32 = pp_next(mem);
    return 1;
}

/// 注解 -> 类型 id。**只收 `int` / `bool` / `None`**（上游 `_TYPES` 那三条），
/// 别的与"没有注解"一样都是**子集外**（`_ty_of_annotation` 两条都抛）。
fn pp_type(mem: ptr, src: ptr) -> u32 {
    let k: u32 = ld32(ptr_add(mem, M_TMP), PY_PI);
    let o: u32 = pt_off(mem, k);
    let l: u32 = pt_len(mem, k);
    if pt_kind(mem, k) != PT_ID {
        let _u: u32 = pp_uns(mem);
        return 0;
    }
    if l == 3 && eq(src, o, "int") == 1 {
        let _n: u32 = pp_next(mem);
        return 7;                                  // `i64`
    }
    if l == 4 && eq(src, o, "bool") == 1 {
        let _n: u32 = pp_next(mem);
        return 9;
    }
    if l == 4 && eq(src, o, "None") == 1 {
        let _n: u32 = pp_next(mem);
        return 10;                                 // `()`
    }
    let _u: u32 = pp_uns(mem);
    return 0;
}

/// 一个字符串字面量 -> 解出来的文本写进 `M_PS` 的游标处，返回 (off, len)；
/// 失败返回 0。`frac` 收两格。
///
/// **要解转义**：`ast.Constant.value` 是解过的，而上游拿它去 `strip().splitlines()`。
/// `r"…"` 那种原始串不解（前缀 `r`/`R` 时跳过反斜杠处理）。
fn pp_str(mem: ptr, src: ptr, frac: ptr) -> u32 {
    if pp_kind(mem, 0) != PT_STR {
        let _e: u32 = pp_err(mem);
        return 0;
    }
    let k: u32 = ld32(ptr_add(mem, M_TMP), PY_PI);
    let o: u32 = pt_off(mem, k);
    let l: u32 = pt_len(mem, k);
    let raw: u32 = 0;
    if l >= 2 && (load8(src, o) == 114 || load8(src, o) == 82)
            && (load8(src, o + 1) == 34 || load8(src, o + 1) == 39) {
        raw = 1;
        o = o + 1;
        l = l - 1;
    }
    let q: u32 = load8(src, o);
    // ⚠ 引号**占几个字节**（1 或 3），不是"0 或 3 的标记" —— 第一版写成
    // `o + 1 + tq` / `o + l - 1 - tq`，三引号那两处**各偏一格**，于是正文的首字符被吃掉
    //（`" + ' + "a" + BS + "nb" + ' + "` 解出来是 `" + BS + "nb`，少了个 `a`）。
    let ql: u32 = 1;
    if l >= 6 && load8(src, o + 1) == q && load8(src, o + 2) == q {
        ql = 3;
    }
    let b: u32 = o + ql;
    let e: u32 = o + l - ql;
    let st: ptr = ptr_add(mem, M_TMP);
    let c: u32 = ld32(st, PY_MPS);
    let i: u32 = b;
    let out: u32 = c;
    while i < e {
        let ch: u32 = load8(src, i);
        if ch == 92 && raw == 0 && i + 1 < e {
            let d: u32 = load8(src, i + 1);
            let put: u32 = 0;
            let adv: u32 = 2;
            if d == 110 {
                put = 10;
            }
            if d == 116 {
                put = 9;
            }
            if d == 114 {
                put = 13;
            }
            if d == 48 {
                put = 0;
            }
            if d == 92 {
                put = 92;
            }
            if d == 34 {
                put = 34;
            }
            if d == 39 {
                put = 39;
            }
            if put == 0 {
                store8(ptr_add(mem, M_PS), out, 92 as u8);
                out = out + 1;
                put = d;
            }
            store8(ptr_add(mem, M_PS), out, put as u8);
            out = out + 1;
            i = i + adv;
        } else {
            store8(ptr_add(mem, M_PS), out, ch as u8);
            out = out + 1;
            i = i + 1;
        }
    }
    let _s: u32 = st32(st, PY_MPS, out);
    let _a: u32 = st32(frac, 0, c);
    let _b: u32 = st32(frac, 4, out - c);
    let _n: u32 = pp_next(mem);
    return 1;
}

/// 一个逻辑行结束（`PT_NL`）。**上游没有这一层** —— 换行不生成节点，
/// 所以"吞掉行尾"这件事在这里是显式的，漏一处就是把下一条语句读进这一条里。
fn pp_end(mem: ptr, src: ptr) -> u32 {
    if pp_is(mem, src, ";") == 1 {
        // 一行多条语句（`x = 1; y = 2`）—— 行结束的位置来了个 `;`。
        // **不收，但出声**：静默少一条语句是最坏的那一档。
        let _u: u32 = pp_uns(mem);
        return 0;
    }
    if pp_kind(mem, 0) != PT_NL {
        return pp_err(mem);
    }
    let _n: u32 = pp_next(mem);
    return 1;
}

/// `:` NL IND … DED —— `outp` 收 (start, count)。
fn pp_block(mem: ptr, src: ptr, outp: ptr) -> u32 {
    if pp_want(mem, src, ":") == 0 {
        return 0;
    }
    if pp_end(mem, src) == 0 {
        return 0;
    }
    if pp_kind(mem, 0) != PT_IND {
        return pp_err(mem);
    }
    let _n: u32 = pp_next(mem);
    if li_enter(mem) == FAIL {
        return pp_err(mem);
    }
    let a0: u32 = li_here(mem);
    let cnt: u32 = 0;
    let first: u32 = 1;
    let going: u32 = 1;
    while going == 1 {
        if pp_kind(mem, 0) == PT_DED {
            going = 0;
        } else {
            if pp_kind(mem, 0) == 0 {
                going = 0;
            } else {
                if first == 1 && pp_kind(mem, 0) == PT_STR {
                    // 函数的第一条是字符串 -> 文档字符串（**只认第一条**，
                    // 与 `ast` 那条 `body[0]` 一样；后面再出现就是"散落的字符串"）
                    let frac: ptr = ptr_add(mem, M_RS + 216);
                    if pp_str(mem, src, frac) == 0 {
                        return 0;
                    }
                    if pp_end(mem, src) == 0 {
                        return 0;
                    }
                    let d: u32 = node_new(mem, NK_DOC, 0);
                    let _d1: u32 = nd_set(mem, d, ND_A, ld32(frac, 0));
                    let _d2: u32 = nd_set(mem, d, ND_B, ld32(frac, 4));
                    let _p0: u32 = li_push(mem, d);
                    cnt = cnt + 1;
                    first = 0;
                } else {
                    first = 0;
                    let s: u32 = pp_stmt(mem, src);
                    if s == 0 {
                        return 0;
                    }
                    let _p: u32 = li_push(mem, s);
                    cnt = cnt + 1;
                }
            }
        }
    }
    let _lv: u32 = li_leave(mem);
    if pp_kind(mem, 0) == PT_DED {
        let _n2: u32 = pp_next(mem);
    }
    let _a: u32 = st32(outp, 0, a0);
    let _b: u32 = st32(outp, 4, cnt);
    return 1;
}

// ---- 表达式（优先级由低到高，与 Python 一致）

fn pp_expr(mem: ptr, src: ptr) -> u32 {
    return pp_or(mem, src);
}

fn pp_or(mem: ptr, src: ptr) -> u32 {
    let first: u32 = pp_and(mem, src);
    if first == 0 {
        return 0;
    }
    if pp_is(mem, src, "or") == 0 {
        return first;
    }
    return pp_boolop(mem, src, 18, first);
}

fn pp_and(mem: ptr, src: ptr) -> u32 {
    let first: u32 = pp_not(mem, src);
    if first == 0 {
        return 0;
    }
    if pp_is(mem, src, "and") == 0 {
        return first;
    }
    return pp_boolop(mem, src, 17, first);
}

/// `and` / `or` 收成**一个 n 元节点** —— 上游那个 `BoolOp` 是 `values` 列表，
/// 发出来是 `(a && b && c)`；写成左结合的二叉树会多出两层括号（逐字节就不一样了）。
fn pp_boolop(mem: ptr, src: ptr, code: u32, first: u32) -> u32 {
    if li_enter(mem) == FAIL {
        return pp_err(mem);
    }
    let a0: u32 = li_here(mem);
    let _p: u32 = li_push(mem, first);
    let n: u32 = 1;
    let going: u32 = 1;
    while going == 1 {
        let hit: u32 = 0;
        if code == 17 && pp_is(mem, src, "and") == 1 {
            hit = 1;
        }
        if code == 18 && pp_is(mem, src, "or") == 1 {
            hit = 1;
        }
        if hit == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_not(mem, src);
            if r == 0 {
                return 0;
            }
            let _p2: u32 = li_push(mem, r);
            n = n + 1;
        }
    }
    let _lv: u32 = li_leave(mem);
    let x: u32 = node_new(mem, NK_BOOL, 0);
    let _a: u32 = nd_set(mem, x, ND_A, code);
    let _b: u32 = nd_set(mem, x, ND_B, a0);
    let _c: u32 = nd_set(mem, x, ND_C, n);
    return x;
}

fn pp_not(mem: ptr, src: ptr) -> u32 {
    if pp_is(mem, src, "not") == 1 {
        let _n: u32 = pp_next(mem);
        let e: u32 = pp_not(mem, src);
        if e == 0 {
            return 0;
        }
        let x: u32 = node_new(mem, NK_UN, 0);
        let _a: u32 = nd_set(mem, x, ND_A, UN_NOT);
        let _b: u32 = nd_set(mem, x, ND_B, e);
        return x;
    }
    return pp_cmp(mem, src);
}

/// 比较。**只收单比较** —— 链式比较（`a < b < c`）里中间那个只求值一次，
/// 拆成两句会求两次，上游因此点名拒（`len(e.ops) != 1`）。
fn pp_cmp(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_bor(mem, src);
    if left == 0 {
        return 0;
    }
    let c: u32 = pp_cmpop(mem, src);
    if c == 0 {
        return left;
    }
    let _n: u32 = pp_next(mem);
    let r: u32 = pp_bor(mem, src);
    if r == 0 {
        return 0;
    }
    let x: u32 = node_new(mem, NK_BIN, 0);
    let _a: u32 = nd_set(mem, x, ND_A, c);
    let _b: u32 = nd_set(mem, x, ND_B, left);
    let _c: u32 = nd_set(mem, x, ND_C, r);
    if pp_cmpop(mem, src) != 0 {
        let _u: u32 = pp_uns(mem);                 // 链式比较
        return 0;
    }
    return x;
}

/// 比较运算符的编号（0 = 不是）。链式那一处也靠它判。
fn pp_cmpop(mem: ptr, src: ptr) -> u32 {
    if pp_is(mem, src, "==") == 1 {
        return 12;
    }
    if pp_is(mem, src, "!=") == 1 {
        return 13;
    }
    if pp_is(mem, src, "<=") == 1 {
        return 10;
    }
    if pp_is(mem, src, ">=") == 1 {
        return 11;
    }
    if pp_is(mem, src, "<") == 1 {
        return 8;
    }
    if pp_is(mem, src, ">") == 1 {
        return 9;
    }
    if pp_is(mem, src, "=") == 1 {
        // `x = 1` 走到这里说明它出现在表达式位置（`a = b = 1` 那种）—— 上游的
        // `ast` 把它当两条赋值，这里只有单目标，所以**报子集外**，不是解析不过。
        let _u: u32 = pp_uns(mem);
        return 0;
    }
    return 0;
}

fn pp_bor(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_bxor(mem, src);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        if pp_is(mem, src, "|") == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_bxor(mem, src);
            if r == 0 {
                return 0;
            }
            left = pp_mk(mem, 16, left, r);
        }
    }
    return left;
}

fn pp_bxor(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_band(mem, src);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        if pp_is(mem, src, "^") == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_band(mem, src);
            if r == 0 {
                return 0;
            }
            left = pp_mk(mem, 15, left, r);
        }
    }
    return left;
}

fn pp_band(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_shift(mem, src);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        if pp_is(mem, src, "&") == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_shift(mem, src);
            if r == 0 {
                return 0;
            }
            left = pp_mk(mem, 14, left, r);
        }
    }
    return left;
}

fn pp_shift(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_arith(mem, src);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        let c: u32 = 0;
        if pp_is(mem, src, "<<") == 1 {
            c = 6;
        }
        if pp_is(mem, src, ">>") == 1 {
            c = 7;
        }
        if c == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_arith(mem, src);
            if r == 0 {
                return 0;
            }
            left = pp_mk(mem, c, left, r);
        }
    }
    return left;
}

fn pp_arith(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_term(mem, src);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        let c: u32 = 0;
        if pp_is(mem, src, "+") == 1 {
            c = 4;
        }
        if pp_is(mem, src, "-") == 1 {
            c = 5;
        }
        if c == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_term(mem, src);
            if r == 0 {
                return 0;
            }
            left = pp_mk(mem, c, left, r);
        }
    }
    return left;
}

fn pp_term(mem: ptr, src: ptr) -> u32 {
    let left: u32 = pp_unary(mem, src);
    if left == 0 {
        return 0;
    }
    let going: u32 = 1;
    while going == 1 {
        let c: u32 = 0;
        if pp_is(mem, src, "**") == 1 {
            let _u: u32 = pp_uns(mem);             // 本语言没有乘方
            return 0;
        }
        if pp_is(mem, src, "/") == 1 {
            let _u: u32 = pp_uns(mem);             // 真除出浮点
            return 0;
        }
        if pp_is(mem, src, "*") == 1 {
            c = 1;
        }
        if pp_is(mem, src, "//") == 1 {
            c = 2;                                 // `//` **就是**本语言的整除（拼法不同）
        }
        if pp_is(mem, src, "%") == 1 {
            c = 3;
        }
        if c == 0 {
            going = 0;
        } else {
            let _n: u32 = pp_next(mem);
            let r: u32 = pp_unary(mem, src);
            if r == 0 {
                return 0;
            }
            left = pp_mk(mem, c, left, r);
        }
    }
    return left;
}

fn pp_mk(mem: ptr, c: u32, l: u32, r: u32) -> u32 {
    let x: u32 = node_new(mem, NK_BIN, 0);
    let _a: u32 = nd_set(mem, x, ND_A, c);
    let _b: u32 = nd_set(mem, x, ND_B, l);
    let _c: u32 = nd_set(mem, x, ND_C, r);
    return x;
}

fn pp_unary(mem: ptr, src: ptr) -> u32 {
    let c: u32 = 0;
    if pp_is(mem, src, "-") == 1 {
        c = UN_SUB;
    }
    if pp_is(mem, src, "+") == 1 {
        c = UN_POS;
    }
    if pp_is(mem, src, "~") == 1 {
        c = UN_INV;
    }
    if c != 0 {
        let _n: u32 = pp_next(mem);
        let e: u32 = pp_unary(mem, src);
        if e == 0 {
            return 0;
        }
        let x: u32 = node_new(mem, NK_UN, 0);
        let _a: u32 = nd_set(mem, x, ND_A, c);
        let _b: u32 = nd_set(mem, x, ND_B, e);
        return x;
    }
    return pp_primary(mem, src);
}

fn pp_primary(mem: ptr, src: ptr) -> u32 {
    let k: u32 = ld32(ptr_add(mem, M_TMP), PY_PI);
    let kind: u32 = pt_kind(mem, k);
    let line: u32 = pt_line(mem, k);
    if kind == PT_NUM {
        let x: u32 = node_new(mem, NK_LIT, line);
        let _a: u32 = nd_set(mem, x, ND_A, pt_off(mem, k));
        let _n: u32 = pp_next(mem);
        return x;
    }
    if kind == PT_ID {
        let o: u32 = pt_off(mem, k);
        let l: u32 = pt_len(mem, k);
        if (l == 4 && eq(src, o, "True") == 1) || (l == 5 && eq(src, o, "False") == 1) {
            let x: u32 = node_new(mem, NK_LIT, line);
            let b: u32 = 0;
            if l == 4 {
                b = 1;
            }
            let _a: u32 = nd_set(mem, x, ND_A, b);
            let _b: u32 = nd_set(mem, x, ND_B, 1);
            let _n: u32 = pp_next(mem);
            return x;
        }
        if l == 4 && eq(src, o, "None") == 1 {
            let _u: u32 = pp_uns(mem);
            return 0;
        }
        if pp_type_word(mem, src) == 1 {
            let _u: u32 = pp_uns(mem);          // `int` / `bool` 当值用
            return 0;
        }
        let _n: u32 = pp_next(mem);
        if pp_is(mem, src, "(") == 1 {
            let _n2: u32 = pp_next(mem);
            if li_enter(mem) == FAIL {
                return pp_err(mem);
            }
            let a0: u32 = li_here(mem);
            let an: u32 = 0;
            if pp_is(mem, src, ")") == 0 {
                let e: u32 = pp_expr(mem, src);
                if e == 0 {
                    return 0;
                }
                let _p: u32 = li_push(mem, e);
                an = 1;
                while pp_is(mem, src, ",") == 1 {
                    let _n3: u32 = pp_next(mem);
                    let e2: u32 = pp_expr(mem, src);
                    if e2 == 0 {
                        return 0;
                    }
                    let _p2: u32 = li_push(mem, e2);
                    an = an + 1;
                }
            }
            let _lv: u32 = li_leave(mem);
            if pp_want(mem, src, ")") == 0 {
                return 0;
            }
            let x: u32 = node_new(mem, NK_CALL, line);
            let _a: u32 = nd_set(mem, x, ND_A, o);
            let _b: u32 = nd_set(mem, x, ND_B, l);
            let _c: u32 = nd_set(mem, x, ND_C, a0);
            let _d: u32 = nd_set(mem, x, ND_D, an);
            return x;
        }
        let x: u32 = node_new(mem, NK_VAR, line);
        let _a: u32 = nd_set(mem, x, ND_A, o);
        let _b: u32 = nd_set(mem, x, ND_B, l);
        return x;
    }
    if kind == PT_OP && pp_is(mem, src, "(") == 1 {
        let _n: u32 = pp_next(mem);
        let e: u32 = pp_expr(mem, src);
        if e == 0 {
            return 0;
        }
        if pp_want(mem, src, ")") == 0 {
            return 0;
        }
        return e;
    }
    if kind == PT_STR {
        let _u: u32 = pp_uns(mem);              // 散落的字符串 / f-string 之外的字面量
        return 0;
    }
    let _e: u32 = pp_err(mem);
    return 0;
}

/// 当前记号是 `int` / `bool` / `None` 这三个类型词吗（它们在值的位置上不收）。
fn pp_type_word(mem: ptr, src: ptr) -> u32 {
    let k: u32 = ld32(ptr_add(mem, M_TMP), PY_PI);
    if pt_kind(mem, k) != PT_ID {
        return 0;
    }
    let o: u32 = pt_off(mem, k);
    let l: u32 = pt_len(mem, k);
    if l == 3 && eq(src, o, "int") == 1 {
        return 1;
    }
    if l == 4 && eq(src, o, "bool") == 1 {
        return 1;
    }
    if l == 4 && eq(src, o, "None") == 1 {
        return 1;
    }
    if l == 6 && eq(src, o, "False") == 1 {
        return 0;
    }
    if l == 5 && eq(src, o, "range") == 1 {
        return 0;
    }
    return 0;
}

// ---- 语句

fn pp_stmt(mem: ptr, src: ptr) -> u32 {
    let k: u32 = ld32(ptr_add(mem, M_TMP), PY_PI);
    let line: u32 = pt_line(mem, k);
    let kind: u32 = pt_kind(mem, k);
    if kind == PT_ID {
        let o: u32 = pt_off(mem, k);
        let l: u32 = pt_len(mem, k);
        if l == 2 && eq(src, o, "if") == 1 {
            return pp_if(mem, src);
        }
        if l == 5 && eq(src, o, "while") == 1 {
            let _n: u32 = pp_next(mem);
            let cond: u32 = pp_expr(mem, src);
            if cond == 0 {
                return 0;
            }
            let _b: u32 = pp_block(mem, src, ptr_add(mem, M_RS + 160));
            if ld32(ptr_add(mem, M_TMP), PY_ERR) != 0 {
                return 0;
            }
            let x: u32 = node_new(mem, NK_WHILE, line);
            let _a: u32 = nd_set(mem, x, ND_A, cond);
            let _bb: u32 = nd_set(mem, x, ND_B, ld32(ptr_add(mem, M_RS + 160), 0));
            let _c: u32 = nd_set(mem, x, ND_C, ld32(ptr_add(mem, M_RS + 160), 4));
            return x;
        }
        if l == 3 && eq(src, o, "for") == 1 {
            return pp_for(mem, src);
        }
        if l == 6 && eq(src, o, "return") == 1 {
            let _n: u32 = pp_next(mem);
            let x: u32 = node_new(mem, NK_RETURN, line);
            if pp_kind(mem, 0) == PT_NL {
                let _e: u32 = pp_end(mem, src);
                return x;
            }
            let e: u32 = pp_expr(mem, src);
            if e == 0 {
                return 0;
            }
            let _e2: u32 = pp_end(mem, src);
            let _a: u32 = nd_set(mem, x, ND_A, e);
            return x;
        }
        if l == 4 && eq(src, o, "pass") == 1 {
            let _n: u32 = pp_next(mem);
            let _e: u32 = pp_end(mem, src);
            return node_new(mem, NK_PASS, line);
        }
        if is_kw_word(src, o, l) == 1 {
            let _u: u32 = pp_uns(mem);          // `break` / `import` / `class` 那些
            return 0;
        }
        // 赋值 / 增量赋值 / 表达式语句
        let t1: u32 = pp_kind(mem, 1);
        let is_aug: u32 = 0;
        if t1 == PT_OP {
            let o1: u32 = pp_off(mem, 1);
            if pt_len(mem, ld32(ptr_add(mem, M_TMP), PY_PI) + 1) == 2
                    && load8(src, o1 + 1) == 61 {
                is_aug = 1;                     // `+=` 那一族
            }
        }
        if t1 == PT_OP && pp_at(mem, src, "=", 1) == 1 {
            let _n: u32 = pp_next(mem);
            let _w: u32 = pp_next(mem);
            let e: u32 = pp_expr(mem, src);
            if e == 0 {
                return 0;
            }
            let _e2: u32 = pp_end(mem, src);
            let x: u32 = node_new(mem, NK_ASSIGN, line);
            let _a: u32 = nd_set(mem, x, ND_A, o);
            let _b: u32 = nd_set(mem, x, ND_B, l);
            let _c: u32 = nd_set(mem, x, ND_C, e);
            return x;
        }
        if is_aug == 1 {
            return pp_aug(mem, src, o, l, line);
        }
        if t1 == PT_OP && pp_at(mem, src, ":", 1) == 1 {
            // 注解赋值 `x: int = e`；只注解不给值上游直接收(`Loment 的 let 要初值`)
            let _n: u32 = pp_next(mem);
            let _w: u32 = pp_next(mem);
            let ty: u32 = pp_type(mem, src);
            if ty == 0 {
                return 0;
            }
            if pp_want(mem, src, "=") == 0 {
                let _u: u32 = pp_uns(mem);
                return 0;
            }
            let e: u32 = pp_expr(mem, src);
            if e == 0 {
                return 0;
            }
            let _e2: u32 = pp_end(mem, src);
            let x: u32 = node_new(mem, NK_DECL, line);
            let _a: u32 = nd_set(mem, x, ND_A, ty);
            let _c: u32 = nd_set(mem, x, ND_C, o);
            let _d: u32 = nd_set(mem, x, ND_D, l);
            let _e: u32 = nd_set(mem, x, ND_E, e + 1);
            return x;
        }
    }
    // 表达式语句：只收调用
    let e: u32 = pp_expr(mem, src);
    if e == 0 {
        return 0;
    }
    let _e2: u32 = pp_end(mem, src);
    if nd_get(mem, e, ND_KIND) != NK_CALL {
        let _u: u32 = pp_uns(mem);
        return 0;
    }
    let x: u32 = node_new(mem, NK_EXPR, line);
    let _a: u32 = nd_set(mem, x, ND_A, e);
    return x;
}

/// 语句位置上的关键字（上游 `_stmt_name` 那张表点名拒的那些）。
fn is_kw_word(src: ptr, o: u32, l: u32) -> u32 {
    if l == 5 && eq(src, o, "break") == 1 {
        return 1;
    }
    if l == 8 && eq(src, o, "continue") == 1 {
        return 1;
    }
    if l == 3 && eq(src, o, "try") == 1 {
        return 1;
    }
    if l == 4 && eq(src, o, "with") == 1 {
        return 1;
    }
    if l == 6 && eq(src, o, "import") == 1 {
        return 1;
    }
    if l == 4 && eq(src, o, "from") == 1 {
        return 1;
    }
    if l == 6 && eq(src, o, "global") == 1 {
        return 1;
    }
    if l == 8 && eq(src, o, "nonlocal") == 1 {
        return 1;
    }
    if l == 3 && eq(src, o, "del") == 1 {
        return 1;
    }
    if l == 5 && eq(src, o, "raise") == 1 {
        return 1;
    }
    if l == 6 && eq(src, o, "assert") == 1 {
        return 1;
    }
    if l == 5 && eq(src, o, "class") == 1 {
        return 1;
    }
    if l == 5 && eq(src, o, "async") == 1 {
        return 1;
    }
    if l == 5 && eq(src, o, "lambda") == 1 {
        return 1;
    }
    if l == 5 && eq(src, o, "yield") == 1 {
        return 1;
    }
    if l == 7 && eq(src, o, "elif") == 1 {
        return 1;
    }
    if l == 4 && eq(src, o, "else") == 1 {
        return 1;
    }
    if l == 6 && eq(src, o, "except") == 1 {
        return 1;
    }
    if l == 7 && eq(src, o, "finally") == 1 {
        return 1;
    }
    return 0;
}

fn pp_aug(mem: ptr, src: ptr, o: u32, l: u32, line: u32) -> u32 {
    let k: u32 = ld32(ptr_add(mem, M_TMP), PY_PI) + 1;
    let c: u32 = load8(src, pt_off(mem, k));
    let code: u32 = 0;
    if c == 43 {
        code = 4;
    }
    if c == 45 {
        code = 5;
    }
    if c == 42 {
        code = 1;
    }
    if c == 47 {
        code = 2;
    }
    if c == 37 {
        code = 3;
    }
    if c == 38 {
        code = 14;
    }
    if c == 124 {
        code = 16;
    }
    if c == 94 {
        code = 15;
    }
    if code == 0 {
        let _e: u32 = pp_err(mem);
        return 0;
    }
    let _n: u32 = pp_next(mem);
    let _w: u32 = pp_next(mem);
    let e: u32 = pp_expr(mem, src);
    if e == 0 {
        return 0;
    }
    let _e2: u32 = pp_end(mem, src);
    let v: u32 = node_new(mem, NK_VAR, line);
    let _a: u32 = nd_set(mem, v, ND_A, o);
    let _b: u32 = nd_set(mem, v, ND_B, l);
    let b: u32 = pp_mk(mem, code, v, e);
    let x: u32 = node_new(mem, NK_ASSIGN, line);
    let _c: u32 = nd_set(mem, x, ND_A, o);
    let _d: u32 = nd_set(mem, x, ND_B, l);
    let _f: u32 = nd_set(mem, x, ND_C, b);
    return x;
}

fn pp_if(mem: ptr, src: ptr) -> u32 {
    let line: u32 = pt_line(mem, ld32(ptr_add(mem, M_TMP), PY_PI));
    let _n: u32 = pp_next(mem);
    let cond: u32 = pp_expr(mem, src);
    if cond == 0 {
        return 0;
    }
    if pp_block(mem, src, ptr_add(mem, M_RS + 160)) == 0 {
        return 0;
    }
    let ts: u32 = ld32(ptr_add(mem, M_RS + 160), 0);
    let tn: u32 = ld32(ptr_add(mem, M_RS + 160), 4);
    let es: u32 = 0;
    let en: u32 = FAIL;
    if pp_is(mem, src, "elif") == 1 {
        // `elif` 就是"else 里再嵌一个 if" —— 上游那棵树也是这个形状，
        // 发射时 `_if_chain` 会把它摊回 `} else if`
        let sub: u32 = pp_if(mem, src);
        if sub == 0 {
            return 0;
        }
        let _e: u32 = li_enter(mem);
        if _e == FAIL {
            return pp_err(mem);
        }
        let a0: u32 = li_here(mem);
        let _p: u32 = li_push(mem, sub);
        let _lv: u32 = li_leave(mem);
        es = a0;
        en = 1;
    } else {
        if pp_is(mem, src, "else") == 1 {
            let _n2: u32 = pp_next(mem);
            if pp_block(mem, src, ptr_add(mem, M_RS + 160)) == 0 {
                return 0;
            }
            es = ld32(ptr_add(mem, M_RS + 160), 0);
            en = ld32(ptr_add(mem, M_RS + 160), 4);
        }
    }
    let x: u32 = node_new(mem, NK_IF, line);
    let _a: u32 = nd_set(mem, x, ND_A, cond);
    let _b: u32 = nd_set(mem, x, ND_B, ts);
    let _c: u32 = nd_set(mem, x, ND_C, tn);
    let _d: u32 = nd_set(mem, x, ND_D, es);
    let _e2: u32 = nd_set(mem, x, ND_E, en);
    return x;
}

/// `for NAME in range(...)` —— **降级是定义，不是搬运**（`pytrans` 文件头 §`for`）。
fn pp_for(mem: ptr, src: ptr) -> u32 {
    let line: u32 = pt_line(mem, ld32(ptr_add(mem, M_TMP), PY_PI));
    let _n: u32 = pp_next(mem);
    let np: ptr = ptr_add(mem, M_RS + 96);
    if pp_id(mem, np) == 0 {
        return 0;
    }
    let no: u32 = ld32(np, 0);
    let nl: u32 = ld32(np, 4);
    if pp_want(mem, src, "in") == 0 {
        return 0;
    }
    if pp_is(mem, src, "range") == 0 {
        let _u: u32 = pp_uns(mem);              // `for` 只收 `range(…)`
        return 0;
    }
    let _n2: u32 = pp_next(mem);
    if pp_want(mem, src, "(") == 0 {
        return 0;
    }
    let a1: u32 = pp_expr(mem, src);
    if a1 == 0 {
        return 0;
    }
    let a2: u32 = 0;
    let two: u32 = 0;
    if pp_is(mem, src, ",") == 1 {
        let _n3: u32 = pp_next(mem);
        let b: u32 = pp_expr(mem, src);
        if b == 0 {
            return 0;
        }
        a2 = b;
        two = 1;
        if pp_is(mem, src, ",") == 1 {
            let _u: u32 = pp_uns(mem);          // 带步进的 `range` 先不做
            return 0;
        }
    }
    if pp_want(mem, src, ")") == 0 {
        return 0;
    }
    let start: u32 = 0;
    let stop: u32 = a1;
    if two == 1 {
        start = a1;
        stop = a2;
    } else {
        start = node_new(mem, NK_LIT, line);
        let _a: u32 = nd_set(mem, start, ND_A, 0);
    }
    if pp_block(mem, src, ptr_add(mem, M_RS + 160)) == 0 {
        return 0;
    }
    let x: u32 = node_new(mem, NK_PFOR, line);
    let _a3: u32 = nd_set(mem, x, ND_A, no);
    let _b3: u32 = nd_set(mem, x, ND_B, nl);
    let _c3: u32 = nd_set(mem, x, ND_C, start);
    let _d3: u32 = nd_set(mem, x, ND_D, stop);
    let _e3: u32 = nd_set(mem, x, ND_E, ld32(ptr_add(mem, M_RS + 160), 0));
    let _f3: u32 = nd_set(mem, x, ND_F, ld32(ptr_add(mem, M_RS + 160), 4));
    return x;
}

// ---------------------------------------------------------------- 发射
//
// 与 `pytrans.Emitter` 逐条对齐。**行那套机器与前面几门共用**（`line_put` / `gap` /
// `line_lit` / `line_put0`），但**表达式与语句那一层是另写的** —— 规则不一样：
//   * `bool -> int` 不转、报错（前四门里 C/C++ 是转的）
//   * `and` / `or` 是**n 元**的（`a and b and c` 上游是一个 BoolOp 三个值，
//     发成 `(a && b && c)`；写成左结合的二叉树会多出两层括号）
//   * `for` 不改名外提，且**循环体里给循环变量赋值要报错**
//   * 类型只有三档：`i64` / `bool` / `()`，局部变量的类型**从右值推**

const PY_EERR: u32 = 1188;         // 发射期的错: 0 好 / 1 子集外 / 2 解析不过

fn pye_uns(mem: ptr) -> u32 {
    if ld32(ptr_add(mem, M_TMP), PY_EERR) == 0 {
        let _a: u32 = st32(ptr_add(mem, M_TMP), PY_EERR, 1);
    }
    return 0;
}

/// 名字没赋过值 —— 上游抛的是 `PyError`（**解析不过**那一类，退出码 2）。
fn pye_pyerr(mem: ptr) -> u32 {
    if ld32(ptr_add(mem, M_TMP), PY_EERR) == 0 {
        let _a: u32 = st32(ptr_add(mem, M_TMP), PY_EERR, 2);
    }
    return 0;
}

// ---- 三张表：常量 / 变量 / "循环变量"

fn pye_var_find(mem: ptr, a: u32, l: u32) -> u32 {
    let n: u32 = ld32(ptr_add(mem, M_TMP), PY_VN);
    let r: ptr = ptr_add(mem, M_PV);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 12 + CT_NL) == l
                && same_n(s, ld32(r, i * 12 + CT_NO), s, a, l) == 1 {
            return ld32(r, i * 12 + CT_TY);
        }
        i = i + 1;
    }
    return 0;
}

fn pye_var_set(mem: ptr, a: u32, l: u32, ty: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, PY_VN);
    let r: ptr = ptr_add(mem, M_PV);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 12 + CT_NL) == l
                && same_n(s, ld32(r, i * 12 + CT_NO), s, a, l) == 1 {
            let _t: u32 = st32(r, i * 12 + CT_TY, ty);
            return 1;
        }
        i = i + 1;
    }
    if n >= 127 {
        let _e: u32 = pye_uns(mem);
        return 0;
    }
    let _1: u32 = st32(r, n * 12 + CT_NO, a);
    let _2: u32 = st32(r, n * 12 + CT_NL, l);
    let _3: u32 = st32(r, n * 12 + CT_TY, ty);
    let _4: u32 = st32(st, PY_VN, n + 1);
    return 1;
}

/// 常量表：模块级那些 + 调用方给的（`--const K:i32`）。
/// **后写的赢** —— 上游 `cenv = {模块常量: i64}` 再 `.update(consts)`（调用方那侧），
/// 同名的以调用方为准。查第一个的话那条规矩就反了。
fn pye_const_find(mem: ptr, a: u32, l: u32) -> u32 {
    let n: u32 = ld32(ptr_add(mem, M_TMP), PY_CN);
    let r: ptr = ptr_add(mem, M_PC);
    let s: ptr = ptr_add(mem, M_SCR);
    let res: u32 = 0;
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 20 + 4) == l
                && same_n(s, ld32(r, i * 20), s, a, l) == 1 {
            res = ld32(r, i * 20 + 8);
        }
        i = i + 1;
    }
    return res;
}

fn pye_const_add(mem: ptr, a: u32, l: u32, ty: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, PY_CN);
    if n >= 127 {
        let _e: u32 = pye_uns(mem);
        return 0;
    }
    let r: ptr = ptr_add(mem, M_PC);
    let _1: u32 = st32(r, n * 20 + CT_NO, a);
    let _2: u32 = st32(r, n * 20 + CT_NL, l);
    let _3: u32 = st32(r, n * 20 + CT_TY, ty);
    let _4: u32 = st32(r, n * 20 + 12, 0);
    let _5: u32 = st32(r, n * 20 + 16, 0);
    let _6: u32 = st32(st, PY_CN, n + 1);
    return 1;
}

fn pye_ft_has(mem: ptr, a: u32, l: u32) -> u32 {
    let n: u32 = ld32(ptr_add(mem, M_TMP), PY_FTN);
    let r: ptr = ptr_add(mem, M_PF);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    while i < n {
        if ld32(r, i * 8 + 4) == l && same_n(s, ld32(r, i * 8), s, a, l) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn pye_ft_add(mem: ptr, a: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, PY_FTN);
    if n >= 60 {
        let _e: u32 = pye_uns(mem);
        return 0;
    }
    let r: ptr = ptr_add(mem, M_PF);
    let _1: u32 = st32(r, n * 8, a);
    let _2: u32 = st32(r, n * 8 + 4, l);
    let _3: u32 = st32(st, PY_FTN, n + 1);
    return 1;
}

/// `set -= set` 的删法（上游是集合差集，**不管原来有几条都删干净**）。
fn pye_ft_trim(mem: ptr, from: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, PY_FTN);
    let r: ptr = ptr_add(mem, M_PF);
    let s: ptr = ptr_add(mem, M_SCR);
    let k: u32 = from;
    let out: u32 = from;
    while k < n {
        let o: u32 = ld32(r, k * 8);
        let l: u32 = ld32(r, k * 8 + 4);
        let dup: u32 = 0;
        let j: u32 = from;
        while j < out {
            if ld32(r, j * 8 + 4) == l && same_n(s, ld32(r, j * 8), s, o, l) == 1 {
                dup = 1;
            }
            j = j + 1;
        }
        if dup == 0 {
            let _1: u32 = st32(r, out * 8, o);
            let _2: u32 = st32(r, out * 8 + 4, l);
            out = out + 1;
        }
        k = k + 1;
    }
    return st32(st, PY_FTN, out);
}

/// `_safe(name)` —— 撞上本语言保留字加 `_py`。
fn pye_safe(mem: ptr, o: u32, l: u32, dst: ptr) -> u32 {
    let _c: u32 = copy_n(dst, 0, ptr_add(mem, M_SCR), o, l);
    if word_has(mem, SEG_LKW, ptr_add(mem, M_SCR), o, l) == 1 {
        let sfx: ptr = ptr_add(mem, M_TMP + 960);
        let sl: u32 = seg_word(mem, SEG_PYSAFE, sfx);
        let _c2: u32 = copy_n(dst, l, sfx, 0, sl);
        return l + sl;
    }
    return l;
}

// ---- 类型：只有三档

fn pye_ty_of(mem: ptr, e: u32) -> u32 {
    let k: u32 = nd_get(mem, e, ND_KIND);
    if k == NK_LIT {
        if nd_get(mem, e, ND_B) == 1 {
            return 9;
        }
        return 7;
    }
    if k == NK_VAR {
        let o: u32 = nd_get(mem, e, ND_A);
        let l: u32 = nd_get(mem, e, ND_B);
        let c: u32 = pye_const_find(mem, o, l);
        if c != 0 {
            return c;
        }
        let v: u32 = pye_var_find(mem, o, l);
        if v != 0 {
            return v;
        }
        let _e: u32 = pye_pyerr(mem);              // 用了没赋过值的
        return 0;
    }
    if k == NK_CALL {
        let r: u32 = fn_ret(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B));
        if r == FAIL {
            let _e: u32 = pye_uns(mem);            // 本单元没有的函数
            return 0;
        }
        return r;
    }
    if k == NK_UN {
        if nd_get(mem, e, ND_A) == UN_NOT {
            return 9;
        }
        return 7;
    }
    if k == NK_BIN {
        if bin_isbool(nd_get(mem, e, ND_A)) == 1 {
            return 9;
        }
        return 7;
    }
    if k == NK_BOOL {
        return 9;
    }
    let _e: u32 = pye_uns(mem);
    return 0;
}

/// 表达式在**它自己的类型**下的写法（括号一律加上）。
fn pye_raw(mem: ptr, e: u32, buf: ptr, o: u32) -> u32 {
    let s: ptr = ptr_add(mem, M_SCR);
    let k: u32 = nd_get(mem, e, ND_KIND);
    if k == NK_LIT {
        if nd_get(mem, e, ND_B) == 1 {
            if nd_get(mem, e, ND_A) == 0 {
                return app(buf, o, "false");
            }
            return app(buf, o, "true");
        }
        let lv: u32 = nd_get(mem, e, ND_A);
        // **超 32 位的字面量不收**（与 `tools/trans_core.py` 的 `_lit32` 同一条）：
        // 本语言里没标注宽度的整数字面量在**解析那一层**就被截断（实测 `8589934591`
        // 读出来是 `4294967295`），事后 `as i64` 也救不回来。静默截断会让
        // `0x1FFFFFFFF == 0xFFFFFFFF` 从假变真，所以拒。
        if lv >= 2147483648 {
            let _e: u32 = em_fail(mem);
            return o;
        }
        return appu(mem, buf, o, lv);
    }
    if k == NK_VAR {
        let vo: u32 = nd_get(mem, e, ND_A);
        let vl: u32 = nd_get(mem, e, ND_B);
        if pye_const_find(mem, vo, vl) != 0 {
            return appn(buf, o, s, vo, vl);        // 模块常量名照抄
        }
        if pye_var_find(mem, vo, vl) == 0 {
            let _e: u32 = pye_pyerr(mem);
            return o;
        }
        let t: ptr = ptr_add(mem, M_TMP + 1400);
        let n: u32 = pye_safe(mem, vo, vl, t);
        return appn(buf, o, t, 0, n);
    }
    if k == NK_CALL {
        let o1: u32 = 0;
        let t: ptr = ptr_add(mem, M_TMP + 1400);
        let n: u32 = pye_safe(mem, nd_get(mem, e, ND_A), nd_get(mem, e, ND_B), t);
        let o2: u32 = appn(buf, o, t, 0, n);
        let o3: u32 = app(buf, o2, "(");
        let as: u32 = nd_get(mem, e, ND_C);
        let an: u32 = nd_get(mem, e, ND_D);
        let i: u32 = 0;
        let cur: u32 = o3;
        while i < an {
            if i > 0 {
                cur = app(buf, cur, ", ");
            }
            cur = pye_ex(mem, li_get(mem, as + i), 7, buf, cur);
            i = i + 1;
        }
        return app(buf, cur, ")");
    }
    if k == NK_UN {
        let c: u32 = nd_get(mem, e, ND_A);
        if c == UN_NOT {
            // Python 的 `not` **永远**出 bool（与 `and`/`or` 不同），所以它收任何真值、
            // 出 `!`（本语言的 `!` 只收 bool）—— 操作数按**条件**那一侧写。
            let o2: u32 = app(buf, o, "!");
            return pye_ex(mem, nd_get(mem, e, ND_B), 9, buf, o2);
        }
        let o2: u32 = app(buf, o, "(");
        let o3: u32 = o2;
        if c == UN_SUB {
            o3 = app(buf, o2, "-");
        }
        if c == UN_INV {
            // **跟着上游拒**：本语言的一元运算符只有 `-` 与 `!`，`~v` 得按宽度写成
            // `v ^ -1` / `v ^ 255`，而这一族不做宽度跟踪 —— 见 `docs/198` §1。
            let _u: u32 = pye_uns(mem);
            return o;
        }
        let o4: u32 = pye_ex(mem, nd_get(mem, e, ND_B), 7, buf, o3);
        return app(buf, o4, ")");
    }
    if k == NK_BIN {
        // **Python 这一侧的 `raw` 不钉宽度** —— 与 `tools/pytrans.py` 对齐，
        // 而那一门**不用 `trans_core`**（它的语法树来自 `ast`，发射器是它自己那份）。
        // 判据逐字节比两边，所以在那边跟上之前，这边照旧。
        let c: u32 = nd_get(mem, e, ND_A);
        let o2: u32 = app(buf, o, "(");
        let o3: u32 = pye_ex(mem, nd_get(mem, e, ND_B), 7, buf, o2);
        let o4: u32 = app(buf, o3, " ");
        let o5: u32 = app(buf, o4, bin_text(c));
        let o6: u32 = app(buf, o5, " ");
        let o7: u32 = pye_ex(mem, nd_get(mem, e, ND_C), 7, buf, o6);
        return app(buf, o7, ")");
    }
    if k == NK_BOOL {
        // **n 元**：`a and b and c` 是**一个** BoolOp 三个值，发成 `(a && b && c)`。
        // 写成左结合的二叉树会多出两层括号 —— 上游那棵树不是那个形状。
        let c: u32 = nd_get(mem, e, ND_A);
        let as: u32 = nd_get(mem, e, ND_B);
        let an: u32 = nd_get(mem, e, ND_C);
        let o2: u32 = app(buf, o, "(");
        let i: u32 = 0;
        let cur: u32 = o2;
        while i < an {
            if i > 0 {
                if c == 17 {
                    cur = app(buf, cur, " && ");
                } else {
                    cur = app(buf, cur, " || ");
                }
            }
            cur = pye_ex(mem, li_get(mem, as + i), 9, buf, cur);
            i = i + 1;
        }
        return app(buf, cur, ")");
    }
    let _e: u32 = pye_uns(mem);
    return o;
}

fn pye_ex(mem: ptr, e: u32, want: u32, buf: ptr, o: u32) -> u32 {
    let got: u32 = pye_ty_of(mem, e);
    if got == 0 {
        return o;
    }
    if got == 10 {
        let _e: u32 = pye_uns(mem);                // 这里用了个不返回值的调用
        return o;
    }
    if got == want {
        return pye_raw(mem, e, buf, o);
    }
    if got == 7 && want == 9 {
        let o2: u32 = pye_raw(mem, e, buf, o);
        return app(buf, o2, " != 0");              // `if x:`：整数当条件的两种拼法
    }
    // `bool -> int`：**不转，报错**。Python 的 `bool` 是 `int` 的子类
    // （`True + 1 == 2`），而 `and`/`or` 返回的是**操作数** —— 这个意思本语言
    // 表达不出来。悄悄补 `as i64` 会让 `a and b` 变成 0/1，与 Python 给的数不同。
    let _e: u32 = pye_uns(mem);
    return o;
}

// ---- 语句

fn pye_stmts(mem: ptr, start: u32, cnt: u32, depth: u32) -> u32 {
    let i: u32 = 0;
    while i < cnt {
        let _r: u32 = pye_stmt(mem, li_get(mem, start + i), depth);
        i = i + 1;
    }
    return 0;
}

/// `_loopvars(body)` —— 这一层里**直接**声明的那几个 `for` 变量名。
fn pye_loopvars(mem: ptr, start: u32, cnt: u32) -> u32 {
    let from: u32 = ld32(ptr_add(mem, M_TMP), PY_FTN);
    let i: u32 = 0;
    while i < cnt {
        let n: u32 = li_get(mem, start + i);
        if nd_get(mem, n, ND_KIND) == NK_PFOR {
            let _a: u32 = pye_ft_add(mem, nd_get(mem, n, ND_A), nd_get(mem, n, ND_B));
        }
        i = i + 1;
    }
    return from;
}

fn pye_stmt(mem: ptr, s: u32, depth: u32) -> u32 {
    let py: ptr = ptr_add(mem, M_TMP);
    let eb: ptr = ptr_add(mem, M_EB);
    let k: u32 = nd_get(mem, s, ND_KIND);
    if k == NK_PASS {
        return 1;
    }
    if k == NK_DOC {
        return 1;                                  // 函数头那边已经发过了
    }
    if k == NK_ASSIGN {
        return pye_bind(mem, s, depth, 0);
    }
    if k == NK_DECL {
        return pye_bind(mem, s, depth, 1);
    }
    if k == NK_RETURN {
        let e: u32 = nd_get(mem, s, ND_A);
        if e == 0 {
            // 同上：不带值的 `return` 本语言没有对应写法
            let _u: u32 = pye_uns(mem);
            return 0;
        }
        let o: u32 = app(eb, 0, "return ");
        let o2: u32 = pye_ex(mem, e, ld32(py, E_RET), eb, o);
        let o3: u32 = app(eb, o2, ";");
        return line_put(mem, o3, depth, 0);
    }
    if k == NK_IF {
        gap(mem);
        return pye_if_chain(mem, s, depth);
    }
    if k == NK_WHILE {
        gap(mem);
        let o: u32 = app(eb, 0, "while ");
        let o2: u32 = pye_ex(mem, nd_get(mem, s, ND_A), 9, eb, o);
        let o3: u32 = app(eb, o2, " {");
        let _l: u32 = line_put(mem, o3, depth, 1);
        let bs: u32 = nd_get(mem, s, ND_B);
        let bn: u32 = nd_get(mem, s, ND_C);
        let from: u32 = pye_loopvars(mem, bs, bn);
        let _b: u32 = pye_stmts(mem, bs, bn, depth + 1);
        let _t: u32 = pye_ft_trim(mem, from);
        return line_lit(mem, "}", depth, 0);
    }
    if k == NK_PFOR {
        return pye_for(mem, s, depth);
    }
    if k == NK_EXPR {
        let c: u32 = nd_get(mem, s, ND_A);
        if nd_get(mem, c, ND_KIND) != NK_CALL {
            let _e: u32 = pye_uns(mem);
            return 0;
        }
        let o: u32 = pye_raw(mem, c, eb, 0);
        let o2: u32 = app(eb, o, ";");
        return line_put(mem, o2, depth, 0);
    }
    let _e: u32 = pye_uns(mem);
    return 0;
}

/// 赋值一条。`is_ann` = 1 时类型来自注解（`NK_DECL` 的 `ND_A`），
/// 否则**从右值推**（上游 `_decl_type` 那两档）。
fn pye_bind(mem: ptr, s: u32, depth: u32, is_ann: u32) -> u32 {
    let py: ptr = ptr_add(mem, M_TMP);
    let eb: ptr = ptr_add(mem, M_EB);
    let no: u32 = nd_get(mem, s, ND_A);
    let nl: u32 = nd_get(mem, s, ND_B);
    let e: u32 = nd_get(mem, s, ND_C);
    if is_ann == 1 {
        // `NK_DECL` 的布局与 `NK_ASSIGN` 不同（A 是类型、名字在 C/D）——
        // 第一版照抄了 A/B，症状是注解赋值整条报"用了没赋过值的名字"
        no = nd_get(mem, s, ND_C);
        nl = nd_get(mem, s, ND_D);
        e = nd_get(mem, s, ND_E) - 1;
    }
    // 循环体里给循环变量赋值 —— 那条降级式在这种写法下不成立，上游点名拒
    if pye_ft_has(mem, no, nl) == 1 {
        let _u: u32 = pye_uns(mem);
        return 0;
    }
    let tname: ptr = ptr_add(mem, M_TMP + 1200);
    let tn: u32 = pye_safe(mem, no, nl, tname);
    let have: u32 = pye_var_find(mem, no, nl);
    if have != 0 {
        let o: u32 = appn(eb, 0, tname, 0, tn);
        let o2: u32 = app(eb, o, " = ");
        let o3: u32 = pye_ex(mem, e, have, eb, o2);
        let o4: u32 = app(eb, o3, ";");
        return line_put(mem, o4, depth, 0);
    }
    let ty: u32 = 7;
    if is_ann == 1 {
        ty = nd_get(mem, s, ND_A);
    } else {
        ty = pye_ty_of(mem, e);
        if ty == 0 {
            return 0;
        }
    }
    let _v: u32 = pye_var_set(mem, no, nl, ty);
    let o: u32 = app(eb, 0, "let ");
    let o2: u32 = appn(eb, o, tname, 0, tn);
    let o3: u32 = app(eb, o2, ": ");
    let o4: u32 = app(eb, o3, ty_text(ty));
    let o5: u32 = app(eb, o4, " = ");
    let o6: u32 = pye_ex(mem, e, ty, eb, o5);
    let o7: u32 = app(eb, o6, ";");
    return line_put(mem, o7, depth, 0);
}

fn pye_if_chain(mem: ptr, s: u32, depth: u32) -> u32 {
    let eb: ptr = ptr_add(mem, M_EB);
    let o: u32 = app(eb, 0, "if ");
    let o2: u32 = pye_ex(mem, nd_get(mem, s, ND_A), 9, eb, o);
    let o3: u32 = app(eb, o2, " {");
    let _l: u32 = line_put(mem, o3, depth, 1);
    let _b: u32 = pye_stmts(mem, nd_get(mem, s, ND_B), nd_get(mem, s, ND_C), depth + 1);
    let cur: u32 = s;
    let going: u32 = 1;
    while going == 1 {
        let es: u32 = nd_get(mem, cur, ND_D);
        let en: u32 = nd_get(mem, cur, ND_E);
        if en != 1 {
            going = 0;
        } else {
            let sub: u32 = li_get(mem, es);
            if nd_get(mem, sub, ND_KIND) != NK_IF {
                going = 0;
            } else {
                let o4: u32 = app(eb, 0, "} else if ");
                let o5: u32 = pye_ex(mem, nd_get(mem, sub, ND_A), 9, eb, o4);
                let o6: u32 = app(eb, o5, " {");
                let _l2: u32 = line_put(mem, o6, depth, 1);
                let _b2: u32 = pye_stmts(mem, nd_get(mem, sub, ND_B),
                                         nd_get(mem, sub, ND_C), depth + 1);
                cur = sub;
            }
        }
    }
    let es2: u32 = nd_get(mem, cur, ND_D);
    let en2: u32 = nd_get(mem, cur, ND_E);
    if en2 != FAIL {
        let _l3: u32 = line_lit(mem, "} else {", depth, 1);
        let _b3: u32 = pye_stmts(mem, es2, en2, depth + 1);
    }
    return line_lit(mem, "}", depth, 0);
}

/// `for i in range(a, b)` -> `let i: i64 = a; while i < b { …; i = i + 1; }`。
/// **这是定义，不是搬运**（`pytrans` 文件头 §`for`）。
fn pye_for(mem: ptr, s: u32, depth: u32) -> u32 {
    let eb: ptr = ptr_add(mem, M_EB);
    let no: u32 = nd_get(mem, s, ND_A);
    let nl: u32 = nd_get(mem, s, ND_B);
    gap(mem);
    let t: ptr = ptr_add(mem, M_TMP + 1200);
    let tn: u32 = pye_safe(mem, no, nl, t);
    let have: u32 = pye_var_find(mem, no, nl);
    let o: u32 = 0;
    if have == 0 {
        let _v: u32 = pye_var_set(mem, no, nl, 7);
        let o1: u32 = app(eb, 0, "let ");
        let o2: u32 = appn(eb, o1, t, 0, tn);
        let o3: u32 = app(eb, o2, ": i64 = ");
        let o4: u32 = pye_ex(mem, nd_get(mem, s, ND_C), 7, eb, o3);
        o = app(eb, o4, ";");
    } else {
        let o1: u32 = appn(eb, 0, t, 0, tn);
        let o2: u32 = app(eb, o1, " = ");
        let o3: u32 = pye_ex(mem, nd_get(mem, s, ND_C), 7, eb, o2);
        o = app(eb, o3, ";");
    }
    let _l: u32 = line_put(mem, o, depth, 0);
    // `while i < b {` 是**字面模板**（上游就是这么拼的）—— 走 `pye_ex` 发一个比较
    // 节点的话会多出一对括号（`while (i < b) {`），逐字节就不一样了。
    let tn3: u32 = pye_safe(mem, no, nl, ptr_add(mem, M_TMP + 1400));
    let o5: u32 = app(eb, 0, "while ");
    let o6: u32 = appn(eb, o5, ptr_add(mem, M_TMP + 1400), 0, tn3);
    let o7: u32 = app(eb, o6, " < ");
    let o8: u32 = pye_ex(mem, nd_get(mem, s, ND_D), 7, eb, o7);
    let o9: u32 = app(eb, o8, " {");
    let _l2: u32 = line_put(mem, o9, depth, 1);
    let _ft: u32 = pye_ft_add(mem, no, nl);
    let _b: u32 = pye_stmts(mem, nd_get(mem, s, ND_E), nd_get(mem, s, ND_F), depth + 1);
    let _d: u32 = pye_ft_discard(mem, no, nl);
    // 体里可能写过这块暂存 —— **重新算一遍**名字（`+1200` 是语句那一层的，会互相盖）
    let tn2: u32 = pye_safe(mem, no, nl, t);
    let o8: u32 = appn(eb, 0, t, 0, tn2);
    let o9: u32 = app(eb, o8, " = ");
    let o10: u32 = appn(eb, o9, t, 0, tn2);
    let o11: u32 = app(eb, o10, " + 1;");
    let _l3: u32 = line_put(mem, o11, depth + 1, 0);
    return line_lit(mem, "}", depth, 0);
}

/// `set.discard(x)` —— 删掉**第一个**匹配的（上游那个 `_for_targets.discard`）。
fn pye_ft_discard(mem: ptr, a: u32, l: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let n: u32 = ld32(st, PY_FTN);
    let r: ptr = ptr_add(mem, M_PF);
    let s: ptr = ptr_add(mem, M_SCR);
    let i: u32 = 0;
    let going: u32 = 1;
    while i < n && going == 1 {
        if ld32(r, i * 8 + 4) == l && same_n(s, ld32(r, i * 8), s, a, l) == 1 {
            let j: u32 = i;
            while j + 1 < n {
                let _1: u32 = st32(r, j * 8, ld32(r, (j + 1) * 8));
                let _2: u32 = st32(r, j * 8 + 4, ld32(r, (j + 1) * 8 + 4));
                j = j + 1;
            }
            let _t: u32 = st32(st, PY_FTN, n - 1);
            going = 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 一个函数。`body` 的第一条可能是 `NK_DOC`（上游把它发成 `///`）。
fn pye_emit_fn(mem: ptr, f: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let eb: ptr = ptr_add(mem, M_EB);
    let _1: u32 = st32(st, PY_VN, 0);
    let _2: u32 = st32(st, PY_FTN, 0);
    let _3: u32 = st32(st, E_RET, fn_get(mem, f, 0));
    let _4: u32 = st32(st, E_ANY, 0);
    let _5: u32 = st32(st, E_NL2, 0);
    let _6: u32 = st32(st, E_BR, 0);
    let bs: u32 = fn_get(mem, f, 6);
    let bn: u32 = fn_get(mem, f, 7);
    let b0: u32 = 0;
    let bcnt: u32 = bn;
    // **文档字符串先发**（上游也是这个顺序），而且它拼行用的就是 `M_EB` ——
    // 放在函数头之后发的话，头的前半截会被它盖掉（症状：`pub fn` 变成一截乱码）
    if bn > 0 {
        let firstn: u32 = li_get(mem, bs);
        if nd_get(mem, firstn, ND_KIND) == NK_DOC {
            let _d: u32 = pye_doc(mem, firstn);
            b0 = 1;
            bcnt = bn - 1;
        }
    }
    let p0: u32 = fn_get(mem, f, 4);
    let pn: u32 = fn_get(mem, f, 5);
    let o: u32 = app(eb, 0, "pub fn ");
    let o2: u32 = appn(eb, o, ptr_add(mem, M_SCR), fn_get(mem, f, 2), fn_get(mem, f, 3));
    let o3: u32 = app(eb, o2, "(");
    let i: u32 = 0;
    let cur: u32 = o3;
    while i < pn {
        let no: u32 = li_get(mem, p0 + i * 3);
        let nl: u32 = li_get(mem, p0 + i * 3 + 1);
        let ty: u32 = li_get(mem, p0 + i * 3 + 2);
        let _v: u32 = pye_var_set(mem, no, nl, ty);
        if i > 0 {
            cur = app(eb, cur, ", ");
        }
        let t: ptr = ptr_add(mem, M_TMP + 1200);
        let tn: u32 = pye_safe(mem, no, nl, t);
        cur = appn(eb, cur, t, 0, tn);
        cur = app(eb, cur, ": ");
        cur = app(eb, cur, ty_text(ty));
        i = i + 1;
    }
    let o4: u32 = app(eb, cur, ")");
    let o5: u32 = 0;
    if fn_get(mem, f, 0) != 10 {
        o5 = app(eb, o4, " -> ");
        o5 = app(eb, o5, ty_text(fn_get(mem, f, 0)));
    } else {
        o5 = o4;
    }
    let o6: u32 = app(eb, o5, " {");
    let _l1: u32 = line_put_ni(mem, o6, 1);
    let _b: u32 = pye_stmts(mem, bs + b0, bcnt, 0);
    return line_put0(mem, "}");
}

/// 函数文档字符串 -> `///` 那几行（上游是 `["/// " + ln …]` 再**整行 rstrip**）。
/// 注意：空行发出来是 `///`（`"/// ".rstrip()`），不是 `/// `。
fn pye_doc(mem: ptr, n: u32) -> u32 {
    let o: u32 = nd_get(mem, n, ND_A);
    let l: u32 = nd_get(mem, n, ND_B);
    let p: ptr = ptr_add(mem, M_PS);
    let a: u32 = py_triml(p, o, o + l);
    let b: u32 = py_trimr(p, a, o + l);
    if a == b {
        return 1;                                  // 空白串 -> 一行都没有
    }
    let i: u32 = a;
    while i <= b {
        if i == b || load8(p, i) == 10 {
            let k: u32 = i;
            while k > a && load8(p, k - 1) != 10 {
                k = k - 1;
            }
            let eb: ptr = ptr_add(mem, M_EB);
            let o2: u32 = app(eb, 0, "/// ");          // o2 是**末端**（= 4）
            let o3: u32 = appn(eb, o2, p, k, i - k);
            let o4: u32 = py_trimr(eb, 0, o3);          // 整行从 0 起裁
            let _l2: u32 = line_raw(mem, eb, o4);
        }
        i = i + 1;
    }
    return 1;
}

/// `[a, b)` 掐掉两端空白（`strip()` 的口径：空格 / 制表 / 回车 / 换行）。
fn py_triml(p: ptr, a: u32, b: u32) -> u32 {
    let i: u32 = a;
    while i < b {
        let c: u32 = load8(p, i);
        if c != 32 && c != 9 && c != 13 && c != 10 {
            return i;
        }
        i = i + 1;
    }
    return b;
}

fn py_trimr(p: ptr, a: u32, b: u32) -> u32 {
    let i: u32 = b;
    while i > a {
        let c: u32 = load8(p, i - 1);
        if c != 32 && c != 9 && c != 13 && c != 10 {
            return i;
        }
        i = i - 1;
    }
    return a;
}

/// 一行**原样**（不缩进）—— 文档字符串那几行走这条。
fn line_raw(mem: ptr, buf: ptr, n: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let out: ptr = ptr_add(mem, M_OUT);
    let c0: u32 = appn(out, ld32(st, E_OUT), buf, 0, n);
    let c1: u32 = app(out, c0, "\n");
    let _a: u32 = st32(st, E_OUT, c1);
    let _b: u32 = st32(st, E_ANY, 1);
    let _c: u32 = st32(st, E_NL2, 0);
    let _d: u32 = st32(st, E_BR, 0);
    return c1;
}

// ---------------------------------------------------------------- 模块那一层与整份翻译
//
// 与上游 `parse()` + `translate()` 对齐：
//   * 模块级的**第一条**若是字符串 -> 模块文档字符串（转成 `//` 注释**带走**）
//   * 其余只收 `def` 与**全大写**的 `NAME = <整数字面量>`，别的点名拒
//
// 输出是**一串块**拼起来的（`"\n".join(out) + "\n"`）：文档那块、常量那块（前面还有
// 一行 `// ---- 模块常量`）、每个函数一块，块之间插一个空元素 —— 所以块与块之间
// **是空行**，而常量那一块内部**不是**。这里按"每个元素逐行发、块间多补一个换行"来做。

/// `def NAME ( 形参 ) -> 返回 :` 那一整条 —— 返回函数表下标（0 = 失败）。
/// `str.isupper()` 的 ASCII 口径（与 `lompotc` 那一份同口径：**至少一个带大小写的
/// 字符**，且没有小写 —— `_1` 是假、`MAX_1` 是真）。
fn py_isupper(p: ptr, a: u32, l: u32) -> u32 {
    let cased: u32 = 0;
    let i: u32 = 0;
    while i < l {
        let c: u32 = load8(p, a + i);
        if c >= 97 && c <= 122 {
            return 0;
        }
        if c >= 65 && c <= 90 {
            cased = 1;
        }
        i = i + 1;
    }
    return cased;
}

fn py_def(mem: ptr, src: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    if pp_want(mem, src, "def") == 0 {
        return 0;
    }
    let np: ptr = ptr_add(mem, M_RS + 96);
    if pp_id(mem, np) == 0 {
        return 0;
    }
    let no: u32 = ld32(np, 0);
    let nl: u32 = ld32(np, 4);
    if pp_want(mem, src, "(") == 0 {
        return 0;
    }
    if li_enter(mem) == FAIL {
        return pp_err(mem);
    }
    let p0: u32 = li_here(mem);
    let pn: u32 = 0;
    if pp_is(mem, src, ")") == 0 {
        let going: u32 = 1;
        while going == 1 {
            // 变参 / 位置参数标记 / keyword-only 标记 —— 上游四条各自点名拒
            if pp_is(mem, src, "*") == 1 || pp_is(mem, src, "**") == 1
                    || pp_is(mem, src, "/") == 1 {
                let _u: u32 = pp_uns(mem);
                return 0;
            }
            if pp_kind(mem, 0) != PT_ID {
                let _e: u32 = pp_err(mem);
                return 0;
            }
            let q: ptr = ptr_add(mem, M_RS + 112);
            if pp_id(mem, q) == 0 {
                return 0;
            }
            if pp_is(mem, src, ":") == 0 {
                let _u: u32 = pp_uns(mem);         // 没有注解（上游是 `Unsupported`）
                return 0;
            }
            let _n0: u32 = pp_next(mem);
            let ty: u32 = pp_type(mem, src);
            if ty == 0 {
                return 0;
            }
            if pp_is(mem, src, "=") == 1 {
                let _u: u32 = pp_uns(mem);         // 默认参数
                return 0;
            }
            let _1: u32 = li_push(mem, ld32(q, 0));
            let _2: u32 = li_push(mem, ld32(q, 4));
            let _3: u32 = li_push(mem, ty);
            pn = pn + 1;
            if pp_is(mem, src, ",") == 1 {
                let _n: u32 = pp_next(mem);
                if pp_is(mem, src, ")") == 1 {
                    going = 0;                     // 尾逗号
                }
            } else {
                going = 0;
            }
        }
    }
    let _lv: u32 = li_leave(mem);
    if pp_want(mem, src, ")") == 0 {
        return 0;
    }
    let ret: u32 = 0;
    if pp_is(mem, src, "->") == 1 {
        let _n: u32 = pp_next(mem);
        ret = pp_type(mem, src);
        if ret == 0 {
            return 0;
        }
    } else {
        let _u: u32 = pp_uns(mem);                 // 没有返回注解
        return 0;
    }
    let _b: u32 = pp_block(mem, src, ptr_add(mem, M_RS + 176));
    if ld32(st, PY_ERR) != 0 {
        return 0;
    }
    let f: u32 = fn_new(mem);
    if f == FAIL {
        return pp_err(mem);
    }
    let _a1: u32 = fn_set(mem, f, 0, ret);
    let _a2: u32 = fn_set(mem, f, 2, no);
    let _a3: u32 = fn_set(mem, f, 3, nl);
    let _a4: u32 = fn_set(mem, f, 4, p0);
    let _a5: u32 = fn_set(mem, f, 5, pn);
    let _a6: u32 = fn_set(mem, f, 6, ld32(ptr_add(mem, M_RS + 176), 0));
    let _a7: u32 = fn_set(mem, f, 7, ld32(ptr_add(mem, M_RS + 176), 4));
    return f;
}

/// 模块那一层。`outp` 收 (函数表起点, 条数)；模块文档在 `PY_MDOC/PY_MDL`，常量在 `M_PC`。
fn py_module(mem: ptr, src: ptr, n: u32, outp: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let _d0: u32 = st32(st, PY_MDOC, 0);
    let _d1: u32 = st32(st, PY_MDL, 0);
    let _c0: u32 = st32(st, PY_CN, 0);
    let _c1: u32 = st32(st, PY_MCN, 0);
    let _p0: u32 = st32(st, PY_MPS, 0);
    let _i0: u32 = st32(st, PY_PI, 0);
    let _v0: u32 = st32(st, PY_VN, 0);
    let _f0: u32 = st32(st, PY_FTN, 0);
    let _e0: u32 = st32(st, PY_EERR, 0);
    if li_enter(mem) == FAIL {
        return pp_err(mem);
    }
    let a0: u32 = li_here(mem);
    let cnt: u32 = 0;
    let seen: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        let kind: u32 = pp_kind(mem, 0);
        if kind == 0 {
            going = 0;
        } else {
            if kind == PT_NL || kind == PT_DED {
                let _x: u32 = pp_next(mem);
            } else {
                if kind == PT_STR {
                    if seen == 1 {
                        let _u: u32 = pp_uns(mem);     // 散落的字符串
                        return 0;
                    }
                    let frac: ptr = ptr_add(mem, M_RS + 200);
                    if pp_str(mem, src, frac) == 0 {
                        return 0;
                    }
                    let _a: u32 = st32(st, PY_MDOC, ld32(frac, 0));
                    let _b: u32 = st32(st, PY_MDL, ld32(frac, 4));
                    if pp_end(mem, src) == 0 {
                        return 0;
                    }
                    seen = 1;
                } else {
                    if kind == PT_ID && pp_is(mem, src, "def") == 1 {
                        let f: u32 = py_def(mem, src);
                        if f == 0 {
                            return 0;
                        }
                        let _q: u32 = li_push(mem, f);
                        cnt = cnt + 1;
                        seen = 1;
                    } else {
                        if kind == PT_ID && ld32(st, PY_CN) == ld32(st, PY_MCN)
                                && py_const(mem, src) == 1 {
                            seen = 1;
                        } else {
                            let _u: u32 = pp_uns(mem);
                            return 0;
                        }
                    }
                }
            }
        }
    }
    // 模块末尾那一串 DED 已经吃掉了；收尾
    let _lv: u32 = li_leave(mem);
    let _a2: u32 = st32(outp, 0, a0);
    let _b2: u32 = st32(outp, 4, cnt);
    return 1;
}

/// 一条全大写常量：`NAME = <整数字面量>` / `NAME = -<整数字面量>`。收下返回 1。
fn py_const(mem: ptr, src: ptr) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let k: u32 = ld32(st, PY_PI);
    let o: u32 = pt_off(mem, k);
    let l: u32 = pt_len(mem, k);
    if py_isupper(src, o, l) == 0 {
        return 0;                                  // 小写的是变量，不是"没转成功的常量"
    }
    if pp_at(mem, src, "=", 1) == 0 {
        return 0;
    }
    let _n: u32 = pp_next(mem);
    let _w: u32 = pp_next(mem);
    let neg: u32 = 0;
    if pp_is(mem, src, "-") == 1 {
        neg = 1;
        let _n2: u32 = pp_next(mem);
    }
    if pp_kind(mem, 0) != PT_NUM {
        let _u: u32 = pp_uns(mem);                 // 值不是整数字面量
        return 0;
    }
    let v: u32 = pp_off(mem, 0);
    let _vn: u32 = pp_next(mem);
    if pp_end(mem, src) == 0 {
        return 0;
    }
    let n: u32 = ld32(st, PY_CN);
    let r: ptr = ptr_add(mem, M_PC);
    let _1: u32 = st32(r, n * 20 + 0, o);
    let _2: u32 = st32(r, n * 20 + 4, l);
    let _3: u32 = st32(r, n * 20 + 8, 7);          // 类型一律 `i64`
    let _4: u32 = st32(r, n * 20 + 12, v);
    let _5: u32 = st32(r, n * 20 + 16, neg);
    let _6: u32 = st32(st, PY_CN, n + 1);
    let _7: u32 = st32(st, PY_MCN, n + 1);
    return 1;
}

/// `translate()` —— 整份发出去。
fn py_translate(mem: ptr, src: ptr, n: u32) -> u32 {
    let st: ptr = ptr_add(mem, M_TMP);
    let _1: u32 = st32(st, E_OUT, 0);
    let _2: u32 = st32(st, E_ANY, 0);
    let _3: u32 = st32(st, E_NL2, 0);
    let _4: u32 = st32(st, E_BR, 0);
    let _5: u32 = st32(st, PY_EERR, 0);
    if py_lex(mem, src, n) == 0 {
        return 0;
    }
    if ld32(st, PY_ERR) != 0 {
        return 0;
    }
    let up: ptr = ptr_add(mem, M_RS + 220);
    if py_module(mem, src, n, up) == 0 {
        return 0;
    }
    let ustart: u32 = ld32(up, 0);
    let ucnt: u32 = ld32(up, 4);
    // 调用方那侧给的常量（`--const K:i32`）接在模块常量**后面** ——
    // 上游 `cenv.update(consts)` 是"后写的赢"，而查表也是后写的赢。
    let q: u32 = 0;
    while q < ld32(st, E_CN) {
        let cn: ptr = ptr_add(mem, M_CN);
        let _ca: u32 = pye_const_add(mem, ld32(cn, q * 12), ld32(cn, q * 12 + 4),
                                     ld32(cn, q * 12 + 8));
        q = q + 1;
    }
    // 重名（Loment 没有重载，名字必须精确）
    let i: u32 = 0;
    while i < ucnt {
        let f: u32 = li_get(mem, ustart + i);
        let j: u32 = i + 1;
        while j < ucnt {
            let g: u32 = li_get(mem, ustart + j);
            if fn_get(mem, f, 3) == fn_get(mem, g, 3)
                    && same_n(ptr_add(mem, M_SCR), fn_get(mem, f, 2),
                              ptr_add(mem, M_SCR), fn_get(mem, g, 2),
                              fn_get(mem, f, 3)) == 1 {
                let _u: u32 = pye_uns(mem);
                return 0;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let out: ptr = ptr_add(mem, M_OUT);
    let blocks: u32 = 0;
    // ---- 模块文档字符串 -> `//` 注释那一块
    if ld32(st, PY_MDL) > 0 {
        let cur: u32 = py_doc_block(mem, out, 0, ld32(st, PY_MDOC), ld32(st, PY_MDL));
        let _e: u32 = st32(st, E_OUT, cur);
        blocks = blocks + 1;
    }
    // ---- 常量那一块（`// ---- 模块常量` 一行 + 每条一行）
    if ld32(st, PY_MCN) > 0 {
        // **常量那一块前面不加空行** —— 上游是 `out.append("// ---- 模块常量")`
        // 直接接在文档那块后面（空元素只在**函数**那块前面加）。加错了就差一个空行。
        let cur: u32 = ld32(st, E_OUT);
        cur = app(out, cur, "// ---- 模块常量\n");
        let r: ptr = ptr_add(mem, M_PC);
        let c: u32 = 0;
        while c < ld32(st, PY_MCN) {
            cur = app(out, cur, "pub const ");
            cur = appn(out, cur, ptr_add(mem, M_SCR), ld32(r, c * 20 + 0),
                       ld32(r, c * 20 + 4));
            cur = app(out, cur, ": i64 = ");
            if ld32(r, c * 20 + 16) == 1 {
                cur = app(out, cur, "-");
            }
            cur = appu(mem, out, cur, ld32(r, c * 20 + 12));
            cur = app(out, cur, ";\n");
            c = c + 1;
        }
        let _e: u32 = st32(st, E_OUT, cur);
        blocks = blocks + 1;
    }
    // ---- 每个函数一块
    let k: u32 = 0;
    while k < ucnt {
        let f: u32 = li_get(mem, ustart + k);
        let has_keep: u32 = 0;
        if ld32(st, E_KN) > 0 {
            has_keep = 1;
        }
        if has_keep == 0 || keep_has(mem, fn_get(mem, f, 2), fn_get(mem, f, 3)) == 1 {
            if blocks > 0 {
                let c: u32 = app(out, ld32(st, E_OUT), "\n");
                let _z: u32 = st32(st, E_OUT, c);
            }
            let _r: u32 = pye_emit_fn(mem, f);
            blocks = blocks + 1;
        }
        k = k + 1;
    }
    if blocks == 0 {
        // 一块都没有 -> 上游是 `"\n".join([]) + "\n"` = 一个换行
        let c: u32 = app(out, ld32(st, E_OUT), "\n");
        let _z: u32 = st32(st, E_OUT, c);
    }
    return 1;
}

/// 文档字符串那一块（`"\n".join("// " + ln for ln in doc.strip().splitlines())`）。
/// **不 rstrip 行尾** —— 上游那一处没有 rstrip（函数文档字符串那处才有）。
fn py_doc_block(mem: ptr, out: ptr, o: u32, off: u32, l: u32) -> u32 {
    let p: ptr = ptr_add(mem, M_PS);
    let a: u32 = py_triml(p, off, off + l);
    let b: u32 = py_trimr(p, a, off + l);
    let i: u32 = a;
    let cur: u32 = o;
    if a == b {
        return o;                                  // 空白串 -> 一行都没有
    }
    while i <= b {
        if i == b || load8(p, i) == 10 {
            let k: u32 = i;
            while k > a && load8(p, k - 1) != 10 {
                k = k - 1;
            }
            cur = app(out, cur, "// ");
            cur = appn(out, cur, p, k, i - k);
            cur = app(out, cur, "\n");
        }
        i = i + 1;
    }
    return cur;
}

// ---------------------------------------------------------------- 语法树转写（`--ast`）
//
// 开发期对拍用：把语法树打成一串 S 表达式，与 Python 那边的同一份转写逐字节比
// —— 翻译器出了问题，先分清"是读错了还是发错了"。判据不用它。

fn dump_list(mem: ptr, src: ptr, start: u32, cnt: u32, out: ptr, o: u32) -> u32 {
    let i: u32 = 0;
    o = app(out, o, "[");
    while i < cnt {
        if i > 0 {
            o = app(out, o, " ");
        }
        o = dump_stmt(mem, src, li_get(mem, start + i), out, o);
        i = i + 1;
    }
    return app(out, o, "]");
}

fn dump_stmt(mem: ptr, src: ptr, n: u32, out: ptr, o: u32) -> u32 {
    let k: u32 = nd_get(mem, n, ND_KIND);
    if k == NK_LIT {
        let b: u32 = nd_get(mem, n, ND_B);
        if b == 1 {
            if nd_get(mem, n, ND_A) == 1 {
                return app(out, o, "(Lit #t)");
            }
            return app(out, o, "(Lit #f)");
        }
        o = app(out, o, "(Lit ");
        o = appu(mem, out, o, nd_get(mem, n, ND_A));
        return app(out, o, ")");
    }
    if k == NK_VAR {
        o = app(out, o, "(Var ");
        o = appn(out, o, src, nd_get(mem, n, ND_A), nd_get(mem, n, ND_B));
        return app(out, o, ")");
    }
    if k == NK_CALL {
        o = app(out, o, "(Call ");
        o = appn(out, o, src, nd_get(mem, n, ND_A), nd_get(mem, n, ND_B));
        let cnt: u32 = nd_get(mem, n, ND_D);
        let a: u32 = nd_get(mem, n, ND_C);
        let i: u32 = 0;
        while i < cnt {
            o = app(out, o, " ");
            o = dump_expr(mem, src, li_get(mem, a + i), out, o);
            i = i + 1;
        }
        return app(out, o, ")");
    }
    if k == NK_UN {
        o = app(out, o, "(Un ");
        if nd_get(mem, n, ND_A) == 2 {
            o = app(out, o, "!");
        } else {
            o = app(out, o, "-");
        }
        o = app(out, o, " ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_B), out, o);
        return app(out, o, ")");
    }
    if k == NK_BIN {
        o = app(out, o, "(Bin ");
        o = app(out, o, bin_text(nd_get(mem, n, ND_A)));
        o = app(out, o, " ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_B), out, o);
        o = app(out, o, " ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_C), out, o);
        return app(out, o, ")");
    }
    if k == NK_DECL {
        o = app(out, o, "(Decl ");
        o = app(out, o, ty_text(nd_get(mem, n, ND_A)));
        o = app(out, o, " ");
        o = appn(out, o, src, nd_get(mem, n, ND_C), nd_get(mem, n, ND_D));
        o = app(out, o, " ");
        let iv: u32 = nd_get(mem, n, ND_E);
        if iv == 0 {
            return app(out, o, "_)");
        }
        o = dump_expr(mem, src, iv - 1, out, o);
        return app(out, o, ")");
    }
    if k == NK_ASSIGN {
        o = app(out, o, "(Assign ");
        o = appn(out, o, src, nd_get(mem, n, ND_A), nd_get(mem, n, ND_B));
        o = app(out, o, " ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_C), out, o);
        return app(out, o, ")");
    }
    if k == NK_RETURN {
        o = app(out, o, "(Return ");
        let e: u32 = nd_get(mem, n, ND_A);
        if e == 0 {
            return app(out, o, "_)");
        }
        o = dump_expr(mem, src, e, out, o);
        return app(out, o, ")");
    }
    if k == NK_IF {
        o = app(out, o, "(If ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_A), out, o);
        o = app(out, o, " ");
        o = dump_list(mem, src, nd_get(mem, n, ND_B), nd_get(mem, n, ND_C), out, o);
        o = app(out, o, " ");
        let en: u32 = nd_get(mem, n, ND_E);
        if en == FAIL {
            o = app(out, o, "_");
        } else {
            o = dump_list(mem, src, nd_get(mem, n, ND_D), en, out, o);
        }
        return app(out, o, ")");
    }
    if k == NK_WHILE {
        o = app(out, o, "(While ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_A), out, o);
        o = app(out, o, " ");
        o = dump_list(mem, src, nd_get(mem, n, ND_B), nd_get(mem, n, ND_C), out, o);
        return app(out, o, ")");
    }
    if k == NK_FOR {
        o = app(out, o, "(For ");
        let a: u32 = nd_get(mem, n, ND_A);
        if a == 0 {
            o = app(out, o, "_");
        } else {
            o = dump_stmt(mem, src, a, out, o);
        }
        o = app(out, o, " ");
        let b: u32 = nd_get(mem, n, ND_B);
        if b == 0 {
            o = app(out, o, "_");
        } else {
            o = dump_expr(mem, src, b, out, o);
        }
        o = app(out, o, " ");
        let c: u32 = nd_get(mem, n, ND_C);
        if c == 0 {
            o = app(out, o, "_");
        } else {
            o = dump_stmt(mem, src, c, out, o);
        }
        o = app(out, o, " ");
        o = dump_list(mem, src, nd_get(mem, n, ND_D), nd_get(mem, n, ND_E), out, o);
        return app(out, o, ")");
    }
    if k == NK_EXPR {
        o = app(out, o, "(Expr ");
        o = dump_expr(mem, src, nd_get(mem, n, ND_A), out, o);
        return app(out, o, ")");
    }
    return app(out, o, "(?)");
}

fn dump_expr(mem: ptr, src: ptr, n: u32, out: ptr, o: u32) -> u32 {
    return dump_stmt(mem, src, n, out, o);
}

/// 整个单元：每个函数一行。
fn dump_unit(mem: ptr, src: ptr, start: u32, cnt: u32, out: ptr) -> u32 {
    let o: u32 = 0;
    let i: u32 = 0;
    while i < cnt {
        let f: u32 = li_get(mem, start + i);
        o = app(out, o, "(Fn ");
        o = app(out, o, ty_text(fn_get(mem, f, 0)));
        o = app(out, o, " ");
        o = appn(out, o, src, fn_get(mem, f, 2), fn_get(mem, f, 3));
        o = app(out, o, " [");
        let pn: u32 = fn_get(mem, f, 5);
        let p0: u32 = fn_get(mem, f, 4);
        let j: u32 = 0;
        while j < pn {
            if j > 0 {
                o = app(out, o, " ");
            }
            o = app(out, o, "(");
            o = app(out, o, ty_text(li_get(mem, p0 + j * 3)));
            o = app(out, o, " ");
            o = appn(out, o, src, li_get(mem, p0 + j * 3 + 1), li_get(mem, p0 + j * 3 + 2));
            o = app(out, o, ")");
            j = j + 1;
        }
        o = app(out, o, "] ");
        o = dump_list(mem, src, fn_get(mem, f, 6), fn_get(mem, f, 7), out, o);
        o = app(out, o, ")\n");
        i = i + 1;
    }
    return o;
}


// ---------------------------------------------------------------- 入口

/// argv 第 k 项（从 0 数）的偏移；返回长度。
fn arg_at(buf: ptr, tot: u32, k: u32, outp: ptr) -> u32 {
    let i: u32 = 0;
    let idx: u32 = 0;
    let s: u32 = 0;
    let found: u32 = 0;
    let ln: u32 = 0;
    while i < tot {
        if load8(buf, i) == 0 {
            if idx == k && found == 0 {
                let _a: u32 = st32(outp, 0, s);
                ln = i - s;
                found = 1;
            }
            idx = idx + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return ln;
}

/// 一个 argv 参数是不是 `lit`。
fn arg_is(cb: ptr, tot: u32, k: u32, lit: str, ap: ptr) -> u32 {
    let l: u32 = arg_at(cb, tot, k, ap);
    if l == 0 {
        return 0;
    }
    let o: u32 = ld32(ap, 0);
    if l != str_len(lit) {
        return 0;
    }
    return eq(cb, o, lit);
}

/// 参数的文本（写进 `M_TMP + 64`，返回长度）—— 给 `--lang c` 这种"值在下一个参数"
/// 与 `--k=v` 两种写法用。
fn arg_val(cb: ptr, tot: u32, k: u32, out: ptr, ap: ptr) -> u32 {
    let l: u32 = arg_at(cb, tot, k, ap);
    if l == 0 {
        return 0;
    }
    let o: u32 = ld32(ap, 0);
    let _c: u32 = copy_n(out, 0, cb, o, l);
    return l;
}

fn lang_of(p: ptr, l: u32) -> u32 {
    if l == 1 && eq(p, 0, "c") == 1 {
        return DL_C + 1;
    }
    if l == 3 && eq(p, 0, "cpp") == 1 {
        return DL_CPP + 1;
    }
    if l == 4 && eq(p, 0, "java") == 1 {
        return DL_JAVA + 1;
    }
    if l == 6 && eq(p, 0, "csharp") == 1 {
        return DL_CS + 1;
    }
    if l == 6 && eq(p, 0, "python") == 1 {
        return DL_PY + 1;
    }
    return 0;
}

fn _start() -> u32 {
    // **先把堆扩到够，再拿它当基址** —— 与家族里其余工具一致。原来只 `brk(0)` 就开始把
    // `[mem, mem + M_CAP)` 当自己的内存用，而那一带多数页根本没被映射，Linux 上第一次写
    // 就是 SIGSEGV（Windows 上因为 PE 的 .bss/堆区 committed 得大而看不出来）。
    // 详述与家族扫描见 `lomtfrom.lomt` 同一处、
    // `loment_tools_test::test_tool_reserves_its_memory`。
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return die(2);
    }
    let got: i64 = syscall4(12, (cur as u64) + M_CAP as u64, 0, 0);
    if got < 0 {
        return die(2);
    }
    let mem: ptr = cur as ptr;
    let _z1: u32 = st32(ptr_add(mem, M_TMP), E_CN, 0);
    let _z2: u32 = st32(ptr_add(mem, M_TMP), E_KN, 0);
    let _z3: u32 = st32(ptr_add(mem, M_TMP), E_EXN, 0);
    let _z4: u32 = st32(ptr_add(mem, M_TMP), E_ERR, 0);
    let _z5: u32 = st32(ptr_add(mem, M_TMP), E_OUT, 0);
    let _z6: u32 = st32(ptr_add(mem, M_TMP), E_NC, 0);
    let _z7: u32 = st32(ptr_add(mem, M_TMP), E_AC, 0);
    let cb: ptr = ptr_add(mem, M_ARG);
    let fd: i64 = syscall4(257, (0 as u64) - 100, str_ptr("/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return die(2);
    }
    let tot: u32 = read_all(fd as u64, cb, 4096) as u32;
    syscall4(3, fd as u64, 0, 0);
    let vp: ptr = ptr_add(mem, M_TMP + 64);
    // 参数检查用的暂存格。它**必须从 `mem` 算** —— 曾经写成 `ptr_add(cb, M_TMP + 96)`，
    // 而 `cb` 已经是 `mem + M_ARG`，于是那个地址落到 `mem + 2441312`：越过 `M_CAP`
    // （1525248）约 90 万字节。任何参数都会走到 `arg_is`，所以**有参数就 SIGSEGV、
    // 无参数不崩**。正确写法要从 `cb` 往下减，而那个相对偏移是负数、`u32` 写不出来 ——
    // 所以按 `arg_at` 自己的约定，把格子交给调用方算。
    let sap: ptr = ptr_add(mem, M_TMP + 96);
    let lang: u32 = 0;
    let toks: u32 = 0;
    let pre: u32 = 0;
    let ast: u32 = 0;
    let pathk: u32 = 0;
    let k: u32 = 1;
    let argc: u32 = 0;
    let q: u32 = 0;
    while q < tot {
        if load8(cb, q) == 0 {
            argc = argc + 1;
        }
        q = q + 1;
    }
    while k < argc {
        if arg_is(cb, tot, k, "--lang", sap) == 1 {
            let l: u32 = arg_val(cb, tot, k + 1, vp, sap);
            let d: u32 = lang_of(vp, l);
            if d == 0 {
                return die(2);
            }
            lang = d - 1;
            k = k + 2;
        } else {
            if arg_is(cb, tot, k, "--tokens", sap) == 1 {
                toks = 1;
                k = k + 1;
            } else {
                if arg_is(cb, tot, k, "--ast", sap) == 1 {
                    ast = 1;
                    k = k + 1;
                } else {
                    if arg_is(cb, tot, k, "--pre", sap) == 1 {
                        pre = 1;
                        k = k + 1;
                    } else {
                        if arg_is(cb, tot, k, "--keep", sap) == 1 {
                            let vl: u32 = arg_val(cb, tot, k + 1, vp, sap);
                            let i: u32 = 0;
                            let s0: u32 = 0;
                            while i <= vl {
                                if i == vl || load8(vp, i) == 44 {
                                    let a: u32 = s0;
                                    let b: u32 = i;
                                    while a < b && is_sp(load8(vp, a)) == 1 {
                                        a = a + 1;
                                    }
                                    while b > a && is_sp(load8(vp, b - 1)) == 1 {
                                        b = b - 1;
                                    }
                                    if b > a {
                                        let ao: u32 = aux_put(mem, vp, a, b - a);
                                        let _ka: u32 = keep_add(mem, ao, b - a);
                                    }
                                    s0 = i + 1;
                                }
                                i = i + 1;
                            }
                            k = k + 2;
                        } else {
                            if arg_is(cb, tot, k, "--extern", sap) == 1 {
                                let vl: u32 = arg_val(cb, tot, k + 1, vp, sap);
                                if cli_pairs(mem, vp, vl, 0) == 0 {
                                    return die(2);
                                }
                                k = k + 2;
                            } else {
                                if arg_is(cb, tot, k, "--const", sap) == 1 {
                                    let vl: u32 = arg_val(cb, tot, k + 1, vp, sap);
                                    if cli_pairs(mem, vp, vl, 1) == 0 {
                                        return die(2);
                                    }
                                    k = k + 2;
                                } else {
                                    pathk = k;
                                    k = k + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if pathk == 0 {
        return die(2);
    }
    let _i: u32 = init_dialect(mem, lang);
    let pl: u32 = arg_val(cb, tot, pathk, ptr_add(mem, M_SRC), sap);
    let pp: ptr = ptr_add(mem, M_SRC);
    store8(pp, pl, 0 as u8);
    let jf: i64 = syscall4(257, (0 as u64) - 100, pp as u64, 0);
    if jf < 0 {
        return die(2);
    }
    let n: u32 = read_all(jf as u64, ptr_add(mem, M_SCR), IN_CAP as u64) as u32;
    syscall4(3, jf as u64, 0, 0);
    if n > M_AUX {
        return die(2);
    }
    // 预处理：Java/C# 抹 `class` / `namespace` 外壳（等长，不动行号）
    let body: ptr = ptr_add(mem, M_SCR);
    if lang == DL_JAVA || lang == DL_CS {
        let sn: ptr = ptr_add(mem, M_SRC);
        let _c1: u32 = copy_n(sn, 0, body, 0, n);
        let _c2: u32 = shell_noise(body, n, sn);
        let e: u32 = strip_shells(mem, sn, n, lang, body);
        if e == 1 {
            return errout("unbalanced", 2);
        }
    }
    // Java 的 `_PRE` 是**解析之前**的点名拒绝（`tools/jtrans.py`）。孪生这边也必须
    // 在解析之前跑：`synchronized void f()` 这类输入孪生的解析器**吃得下**（静默丢掉
    // 修饰词），只有参考实现拒 —— 放到失败之后跑就永远等不到它。
    // C# 没有这条前置检查（它自己的 `_unwrap` 没有），所以只在失败路径上兜底。
    if lang == DL_JAVA && pc_reject(body, n, lang) == 1 {
        return errout("unsupported", 1);
    }
    let out: ptr = ptr_add(mem, M_OUT);
    if pre == 1 {
        let o: u32 = appn(out, 0, body, 0, n);
        let _w: u64 = write_all(1, out, o as u64);
        return die(0);
    }
    if lang == DL_PY {
        // Python 那一门**不走** `tokenize` / `p_unit` / `emit_unit` —— 它的词法器
        // 要造 INDENT/DEDENT、它的解析器吃换行与缩进，是另写的一套。
        let _t: u32 = py_translate(mem, body, n);
        let e1: u32 = ld32(pst(mem), PY_ERR);
        let e2: u32 = ld32(pst(mem), PY_EERR);
        if e1 != 0 || e2 != 0 {
            if e1 == 1 || e2 == 1 {
                return errout("unsupported", 1);
            }
            return errout("cerror", 2);
        }
        let _w: u64 = write_all(1, out, ld32(pst(mem), E_OUT) as u64);
        return die(0);
    }
    let cnt: u32 = tokenize(mem, body, n);
    let ec: u32 = ld32(ptr_add(mem, M_TMP), 8);
    if ec == 1 {
        return errout("unsupported", 1);
    }
    if ec == 2 && (lang == DL_JAVA || lang == DL_CS) && pc_reject(body, n, lang) == 1 {
        return errout("unsupported", 1);
    }
    if ec == 2 {
        return errout("cerror", 2);
    }
    if toks == 1 {
        let o: u32 = dump_tokens(mem, body, cnt, out);
        let _w: u64 = write_all(1, out, o as u64);
        return die(0);
    }
    // 解析（`--ast` 就停在这儿；发射那条路接着用同一棵树）
    let st: ptr = ptr_add(mem, M_TMP);
    let _n1: u32 = st32(st, PS_N, cnt);
    let _i1: u32 = st32(st, PS_I, 0);
    let _e1: u32 = st32(st, PS_ERR, 0);
    let _c1: u32 = st32(st, 20, 0);          // 节点游标
    let _c2: u32 = st32(st, 36, 0);          // 列表深度
    // 函数游标的起点不是 0 —— `--extern` 收进来的那些**已经占住 1..n 了**，
    // 在这儿抹成 0 的话它们会被第一个真函数整个盖掉（症状：外部函数的返回类型
    // 静默失效，调用点按本单元的看法走）。
    let _c3: u32 = st32(st, 40, ld32(st, E_EXN));   // 函数游标
    let _c4: u32 = st32(st, 512, 0);         // 第 0 层游标
    if p_unit(mem, body, lang, ptr_add(st, 440)) == 0 {
        let e: u32 = ld32(st, PS_ERR);
        if e == 1 {
            return errout("unsupported", 1);
        }
        if (lang == DL_JAVA || lang == DL_CS) && pc_reject(body, n, lang) == 1 {
            return errout("unsupported", 1);
        }
        return errout("cerror", 2);
    }
    if ast == 1 {
        let o: u32 = dump_unit(mem, body, ld32(st, 440), ld32(st, 444), out);
        let _w: u64 = write_all(1, out, o as u64);
        return die(0);
    }
    // 默认那条路: 发射（上游 `translate`）。`--keep` / `--extern` / `--const`
    // 已经在前面的参数那一轮收好了。
    let _em: u32 = emit_unit(mem, ld32(st, 440), ld32(st, 444));
    if em_ok(mem) == 0 {
        return errout("unsupported", 1);
    }
    let _w2: u64 = write_all(1, out, ld32(st, E_OUT) as u64);
    return die(0);
}
