// std/physics.lomt — SI 物理常量与常见公式（double）
//
// 为什么要有它: 物理常量写错一位（`6.674e-11` vs `6.67430e-11`）不会让程序崩，
// 只会让每个结果"看起来差不多"。把常量收在一处、只写一次，是用库替代复制粘贴的
// 最直接收益。
//
// 口径: CODATA 2018 / SI 2019 的**定义值**（c、h、e、k_B、N_A 在 2019 后是精确值）。
// 单位是 SI 基本单位；公式里不做量纲检查（那需要类型系统，见 `units` 的量纲说明）。
//
// 不做的: 量纲分析、单位换算（走 `units`）、相对论张量、量子力学算符 —— 这一层是
// "把公式写成函数"，不是物理引擎。
//
// 命名: 公开 ph_*, 内部 ph_*。自检 test_physics_*。

module physics
choose runtime

use f64
use f64conv
use mathf

pub const PH_C: u64 = 0x41B1DE784A000000;      // 299792458 m/s（精确）
pub const PH_G: u64 = 0x3DD2589EFFED8ACC;      // 6.67430e-11
pub const PH_H: u64 = 0x390B860BDE023111;      // 6.62607015e-34（精确）
pub const PH_HBAR: u64 = 0x38E185A7054E4C91;   // 1.054571817e-34
pub const PH_KB: u64 = 0x3B30B0E6D55E647C;     // 1.380649e-23（精确）
pub const PH_QE: u64 = 0x3C07A4DA290C1653;     // 1.602176634e-19（精确）
pub const PH_NA: u64 = 0x44DFE185CA57C517;     // 6.02214076e23（精确）
pub const PH_R: u64 = 0x4020A1013E883FC4;      // 8.314462618
pub const PH_EPS0: u64 = 0x3DA37876F1206634;   // 8.8541878128e-12
pub const PH_MU0: u64 = 0x3EB515370FCB41E4;    // 1.25663706212e-6
pub const PH_SIGMA: u64 = 0x3E6E714DA268C0CC;  // 5.670374419e-8（Stefan–Boltzmann）
pub const PH_G0: u64 = 0x40239D013A92A305;     // 9.80665 m/s^2（标准重力）
pub const PH_ME: u64 = 0x39B279DCC8B6B7ED;     // 9.1093837015e-31
pub const PH_MP: u64 = 0x3A609099B1EAA2C5;     // 1.67262192369e-27
pub const PH_U: u64 = 0x3A6071F778ED6AAF;      // 1.66053906660e-27
pub const PH_ALPHA: u64 = 0x3F7DE3D42A1ED29D;  // 7.2973525693e-3
/// 库仑常量 1/(4π eps0)。
pub const PH_K: u64 = 0x4200BD99418216E1;      // 8.9875517923e9

/// 动能 ½ m v²。
pub fn ph_kinetic(m: u64, v: u64) -> u64 {
    return f64_mul(F64_HALF, f64_mul(m, f64_mul(v, v)));
}

pub fn ph_momentum(m: u64, v: u64) -> u64 {
    return f64_mul(m, v);
}

/// 重力势能 m g h（近地）。
pub fn ph_potential(m: u64, h: u64) -> u64 {
    return f64_mul(m, f64_mul(PH_G0, h));
}

/// 万有引力 F = G m1 m2 / r²。
pub fn ph_grav_force(m1: u64, m2: u64, r: u64) -> u64 {
    if f64_eq(r, F64_POS_ZERO) {
        return 0x7FF0000000000000; // +inf
    }
    return f64_div(f64_mul(PH_G, f64_mul(m1, m2)), f64_mul(r, r));
}

/// 引力势能 -G m1 m2 / r。
pub fn ph_grav_potential(m1: u64, m2: u64, r: u64) -> u64 {
    if f64_eq(r, F64_POS_ZERO) {
        return 0xFFF0000000000000; // -inf
    }
    return f64_neg(f64_div(f64_mul(PH_G, f64_mul(m1, m2)), r));
}

/// 光子能量 E = h f。
pub fn ph_photon_energy(f: u64) -> u64 {
    return f64_mul(PH_H, f);
}

/// 德布罗意波长 λ = h / (m v)。
pub fn ph_de_broglie(m: u64, v: u64) -> u64 {
    let p: u64 = f64_mul(m, v);
    if f64_eq(p, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return f64_div(PH_H, p);
}

/// 洛伦兹因子 1/sqrt(1 - v²/c²)。v >= c 返回 +inf。
pub fn ph_lorentz(v: u64) -> u64 {
    let b: u64 = f64_div(v, PH_C);
    let t: u64 = f64_sub(F64_ONE, f64_mul(b, b));
    if f64_le(t, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return f64_div(F64_ONE, mathf_sqrt(t));
}

/// 库仑力 F = k q1 q2 / r²。
pub fn ph_coulomb(q1: u64, q2: u64, r: u64) -> u64 {
    if f64_eq(r, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return f64_div(f64_mul(PH_K, f64_mul(q1, q2)), f64_mul(r, r));
}

/// 逃逸速度 sqrt(2 G M / r)。
pub fn ph_escape_velocity(m: u64, r: u64) -> u64 {
    if f64_eq(r, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return mathf_sqrt(f64_div(f64_mul(F64_TWO, f64_mul(PH_G, m)), r));
}

/// 圆轨道速度 sqrt(G M / r)。
pub fn ph_orbital_velocity(m: u64, r: u64) -> u64 {
    if f64_eq(r, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return mathf_sqrt(f64_div(f64_mul(PH_G, m), r));
}

/// 波长 -> 频率 c/λ。
pub fn ph_frequency(lambda: u64) -> u64 {
    if f64_eq(lambda, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return f64_div(PH_C, lambda);
}

/// 频率 -> 波长 c/f。
pub fn ph_wavelength(f: u64) -> u64 {
    if f64_eq(f, F64_POS_ZERO) {
        return 0x7FF0000000000000;
    }
    return f64_div(PH_C, f);
}

/// 热运动能量 k_B T。
pub fn ph_thermal_energy(t: u64) -> u64 {
    return f64_mul(PH_KB, t);
}

// ---------------------------------------------------------------- 自检

fn test_physics_kinetic() -> bool {
    // ½ * 2 * 3² = 9
    let e: u64 = ph_kinetic(F64_TWO, F64_THREE);
    return f64_eq(e, 0x4022000000000000);
}

fn test_physics_photon() -> bool {
    // E = h * 1 = h
    return f64_eq(ph_photon_energy(F64_ONE), PH_H);
}

fn test_physics_lorentz() -> bool {
    // v=0 -> 1
    return f64_eq(ph_lorentz(F64_POS_ZERO), F64_ONE);
}

fn test_physics_orbital() -> bool {
    // 地球：M=5.972e24, r=6.371e6 -> ~7.9 km/s（只查数量级：> 7000 且 < 9000）
    let m: u64 = 0x4513C27B13272FB6; // 5.972e24
    let r: u64 = 0x41584DAE00000000; // 6.371e6
    let v: u64 = ph_orbital_velocity(m, r);
    return f64_gt(v, 0x40BB580000000000) && f64_lt(v, 0x40C1940000000000);
}
