// system/sysinfo.lomt — `sysinfo(2)` 那一个结构体
//
// 为什么系统工具需要它: "这台机器还剩多少内存 / 开机多久了 / 有几个进程" 在
// Linux 上是**一条系统调用换一整块结构体**（`sysinfo`，编号 99）。结构体是内核
// ABI 的一部分: 字段顺序、每个字段的宽度都是写死的，而**单位不是字节** ——
// `totalram` 要乘上末尾的 `mem_unit` 才是字节。漏乘那个因子会让 64 位机器上
// 报出"总内存 64 KB"这种数（实测过），因为大多数机器上 `mem_unit` 是 1 或者
// 一个小整数，只有真大内存机器才不是 1。
//
// 结构体（x86-64 Linux，`struct sysinfo`）:
//   uptime i64(0) | loads u64(8,16,24) | totalram(32) | freeram(40) |
//   sharedram(48) | bufferram(56) | totalswap(64) | freeswap(72) |
//   procs u16(80) | pad(82) | totalhigh(88) | freehigh(96) |
//   mem_unit u32(104) | _f(112..)
//
// 不做: 把 loads 除以 (1<<16) 换成浮点（本语言这一层不引浮点）、swap 与 high
// memory 的语义解释、跨架构的结构体（这是 x86-64 的那份）。
//
// 命名: 公开 si_*, 内部 siq_*。自检 test_sysinfo_*。

module sysinfo

pub const SI_SYS_SYSINFO: u64 = 99;
/// 结构体要交给内核写的最小字节数（尾部 `_f` 可以多给）。
pub const SI_BYTES: u32 = 112;

pub const SI_OFF_UPTIME: u32 = 0;
pub const SI_OFF_LOADS: u32 = 8;
pub const SI_OFF_TOTALRAM: u32 = 32;
pub const SI_OFF_FREERAM: u32 = 40;
pub const SI_OFF_SHAREDRAM: u32 = 48;
pub const SI_OFF_BUFFERRAM: u32 = 56;
pub const SI_OFF_TOTALSWAP: u32 = 64;
pub const SI_OFF_FREESWAP: u32 = 72;
pub const SI_OFF_PROCS: u32 = 80;
pub const SI_OFF_TOTALHIGH: u32 = 88;
pub const SI_OFF_FREEHIGH: u32 = 96;
pub const SI_OFF_MEM_UNIT: u32 = 104;

fn siq_ld64(p: ptr, off: u32) -> u64 {
    let v: u64 = 0 as u64;
    let b: u32 = 0;
    while b < 8 {
        v = v | ((load8(p, off + b) as u64) << ((8 * b) as u64));
        b = b + 1;
    }
    return v;
}

fn siq_ld32(p: ptr, off: u32) -> u32 {
    let v: u32 = 0;
    let b: u32 = 0;
    while b < 4 {
        v = v | ((load8(p, off + b) as u32) << ((8 * b) as u32));
        b = b + 1;
    }
    return v;
}

fn siq_ld16(p: ptr, off: u32) -> u32 {
    return (load8(p, off) as u32) | ((load8(p, off + 1) as u32) << (8 as u32));
}

fn siq_st64(p: ptr, off: u32, v: u64) -> u32 {
    let b: u32 = 0;
    while b < 8 {
        store8(p, off + b, ((v >> ((8 * b) as u64)) & (255 as u64)) as u8);
        b = b + 1;
    }
    return off + 8;
}

fn siq_st32(p: ptr, off: u32, v: u32) -> u32 {
    let b: u32 = 0;
    while b < 4 {
        store8(p, off + b, ((v >> ((8 * b) as u32)) & (255 as u32)) as u8);
        b = b + 1;
    }
    return off + 4;
}

fn siq_put(out: ptr, cap: u32, pos: u32, s: str) -> u32 {
    let p: u32 = pos;
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        if p < cap {
            store8(out, p, str_byte(s, i) as u8);
        }
        p = p + 1;
        i = i + 1;
    }
    return p;
}

fn siq_u64(out: ptr, cap: u32, pos0: u32, v0: u64) -> u32 {
    let tmp: ptr = alloc(24);
    let v: u64 = v0;
    let n: u32 = 0;
    if v == (0 as u64) {
        store8(tmp, 0, 48 as u8);
        n = 1;
    }
    while v > (0 as u64) {
        let d: u32 = (v % (10 as u64)) as u32;
        store8(tmp, n, (48 + d) as u8);
        n = n + 1;
        v = v / (10 as u64);
    }
    let pos: u32 = pos0;
    let i: u32 = 0;
    while i < n {
        if pos < cap {
            store8(out, pos, load8(tmp, n - 1 - i) as u8);
        }
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

/// `sysinfo(buf)` —— buf 至少 `SI_BYTES` 字节。返回 0 成功，负数失败。
pub fn si_sysinfo(buf: ptr) -> i64 {
    return syscall4(SI_SYS_SYSINFO, buf as u64, 0, 0);
}

/// 开机以来的秒数。
pub fn si_uptime(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_UPTIME);
}

/// 第 `i` 个负载均值（0..2）的定点值 —— 除以 65536 才是那个小数。
pub fn si_load(buf: ptr, i: u32) -> u64 {
    if i > 2 {
        return 0 as u64;
    }
    return siq_ld64(buf, SI_OFF_LOADS + 8 * i);
}

pub fn si_totalram(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_TOTALRAM);
}

pub fn si_freeram(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_FREERAM);
}

pub fn si_sharedram(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_SHAREDRAM);
}

pub fn si_bufferram(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_BUFFERRAM);
}

pub fn si_totalswap(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_TOTALSWAP);
}

pub fn si_freeswap(buf: ptr) -> u64 {
    return siq_ld64(buf, SI_OFF_FREESWAP);
}

/// 进程数（内核填的是"当前进程数"，不是上限）。
pub fn si_procs(buf: ptr) -> u32 {
    return siq_ld16(buf, SI_OFF_PROCS);
}

/// 内存字段的单位因子 —— **每个 ram 字段都要乘它**。
pub fn si_mem_unit(buf: ptr) -> u32 {
    return siq_ld32(buf, SI_OFF_MEM_UNIT);
}

/// 把某个 `*ram` 字段换成字节。`mem_unit` 为 0（老内核/未填）时原样返回。
pub fn si_mem_bytes(buf: ptr, off: u32) -> u64 {
    let v: u64 = siq_ld64(buf, off);
    let u: u32 = si_mem_unit(buf);
    if u == 0 {
        return v;
    }
    return v * (u as u64);
}

/// 开机时长 -> `"3d 4h 5m"`。零的段省略，分钟总是出现。
pub fn si_uptime_text(sec: u64, out: ptr, cap: u32) -> u32 {
    let d: u64 = sec / (86400 as u64);
    let h: u64 = (sec / (3600 as u64)) % (24 as u64);
    let m: u64 = (sec / (60 as u64)) % (60 as u64);
    let pos: u32 = 0;
    if d > (0 as u64) {
        pos = siq_u64(out, cap, pos, d);
        pos = siq_put(out, cap, pos, "d ");
    }
    if h > (0 as u64) {
        pos = siq_u64(out, cap, pos, h);
        pos = siq_put(out, cap, pos, "h ");
    }
    pos = siq_u64(out, cap, pos, m);
    pos = siq_put(out, cap, pos, "m");
    return pos;
}

// ---------------------------------------------------------------- 自检

fn siq_fake(buf: ptr) -> u32 {
    siq_st64(buf, SI_OFF_UPTIME, 250000 as u64);
    siq_st64(buf, SI_OFF_LOADS, 65536 as u64);
    siq_st64(buf, SI_OFF_LOADS + 8, 32768 as u64);
    siq_st64(buf, SI_OFF_TOTALRAM, 2000 as u64);
    siq_st64(buf, SI_OFF_FREERAM, 500 as u64);
    siq_st64(buf, SI_OFF_TOTALSWAP, 100 as u64);
    siq_st64(buf, SI_OFF_FREESWAP, 40 as u64);
    store8(buf, SI_OFF_PROCS, 17 as u8);
    store8(buf, SI_OFF_PROCS + 1, 0 as u8);
    siq_st32(buf, SI_OFF_MEM_UNIT, 1024);
    return SI_BYTES;
}

fn test_sysinfo_fields() -> bool {
    let b: ptr = alloc(128);
    siq_fake(b);
    return si_uptime(b) == 250000 && si_load(b, 0) == 65536 && si_load(b, 1) == 32768;
}

fn test_sysinfo_mem_unit_is_applied() -> bool {
    let b: ptr = alloc(128);
    siq_fake(b);
    // totalram 是"2000 个 mem_unit"，每个 1024 字节。
    if si_mem_bytes(b, SI_OFF_TOTALRAM) != (2048000 as u64) {
        return false;
    }
    return si_mem_bytes(b, SI_OFF_FREERAM) == (512000 as u64);
}

fn test_sysinfo_procs_and_unit() -> bool {
    let b: ptr = alloc(128);
    siq_fake(b);
    return si_procs(b) == 17 && si_mem_unit(b) == 1024;
}

fn test_sysinfo_uptime_text() -> bool {
    let o: ptr = alloc(32);
    let w: str = "3d 4h 5m";
    let n: u32 = si_uptime_text(277500 as u64, o, 32);
    if n != str_len(w) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(o, i) != str_byte(w, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
