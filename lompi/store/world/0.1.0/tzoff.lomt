// world/tzoff.lomt — 时区偏移：解析、格式化、把 epoch 变当地时间
//
// 为什么现实世界需要它: "2026-11-08T10:00+08:00" 里唯一能机器验证的是**偏移量**；
// 时区名（`Asia/Shanghai`）要一张会变的数据库，偏移量不用。日志、HTTP 日期、
// ISO 8601 里全是这个形状。
//
// 约定:
//   * 偏移以**分钟**为单位（东正西负），范围 -14*60 … +14*60；
//   * `tz_parse` 接受 `Z` `z` `+08` `+0800` `+08:00` `-05:30`；
//   * `tz_civil` 把 epoch 秒 + 偏移拆成年月日时分秒（写 6 个 i32）。
//
// 不做的: IANA 时区库、夏令时规则、历史偏移变更 —— 那是数据，不是算法。
//
// 命名: 公开 tz_*, 内部 tzc_*。自检 test_tzoff_*。

module tzoff
choose runtime

use mem
use "calendar.lomt"

fn tzc_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

/// 解析偏移。成功写 ok=1，返回分钟；失败 ok=0、返回 0。
pub fn tz_parse(s: str, ok_out: ptr) -> i32 {
    mem_store32(ok_out, 0, 0);
    let n: u32 = str_len(s);
    if n == 0 {
        return 0 as i32;
    }
    let c0: u32 = str_byte(s, 0);
    if c0 == 90 || c0 == 122 { // Z / z
        if n == 1 {
            mem_store32(ok_out, 0, 1);
            return 0 as i32;
        }
        return 0 as i32;
    }
    let sign: i32 = 1;
    let i: u32 = 0;
    if c0 == 43 {
        i = 1;
    } else if c0 == 45 {
        sign = 0 as i32 - 1 as i32;
        i = 1;
    } else {
        return 0 as i32;
    }
    let hh: u32 = 0;
    let mm: u32 = 0;
    let nd: u32 = 0;
    while i < n && tzc_digit(str_byte(s, i)) && nd < 4 {
        let d: u32 = str_byte(s, i) - 48;
        if nd < 2 {
            hh = hh * 10 + d;
        } else {
            mm = mm * 10 + d;
        }
        nd = nd + 1;
        i = i + 1;
    }
    if i < n && str_byte(s, i) == 58 { // ':'
        i = i + 1;
    }
    while i < n && tzc_digit(str_byte(s, i)) && mm < 60 {
        mm = mm * 10 + (str_byte(s, i) - 48);
        i = i + 1;
    }
    if i < n || nd < 2 || hh > 14 || mm > 59 {
        return 0 as i32;
    }
    if hh == 14 && mm != 0 {
        return 0 as i32;
    }
    mem_store32(ok_out, 0, 1);
    let total: i32 = (hh * 60 + mm) as i32;
    if sign < 0 as i32 {
        return 0 as i32 - total;
    }
    return total;
}

fn tzc_two(out: ptr, cap: u32, pos: u32, v: u32) -> u32 {
    let p: u32 = pos;
    if p < cap {
        store8(out, p, (48 + v / 10) as u8);
    }
    p = p + 1;
    if p < cap {
        store8(out, p, (48 + v % 10) as u8);
    }
    return p + 1;
}

/// `+08:00` / `-05:30` / `+00:00`。返回完整长度。
pub fn tz_format(minutes: i32, out: ptr, cap: u32) -> u32 {
    let a: u32 = 0;
    let neg: u32 = 0;
    if minutes < 0 as i32 {
        neg = 1;
        a = (0 as i32 - minutes) as u32;
    } else {
        a = minutes as u32;
    }
    let p: u32 = 0;
    if p < cap {
        if neg == 1 {
            store8(out, p, 45 as u8);
        } else {
            store8(out, p, 43 as u8);
        }
    }
    p = p + 1;
    p = tzc_two(out, cap, p, a / 60);
    if p < cap {
        store8(out, p, 58 as u8);
    }
    p = p + 1;
    p = tzc_two(out, cap, p, a % 60);
    return p;
}

/// epoch 秒 -> 当地时间，out 写 [y, m, d, hh, mi, ss]（各 i32）。
pub fn tz_civil(epoch: i64, minutes: i32, out: ptr) {
    let local: i64 = epoch + (minutes as i64) * (60 as i64);
    let days: i64 = local / (86400 as i64);
    let secs: i64 = local % (86400 as i64);
    let s: i64 = secs;
    if s < (0 as i64) {
        s = s + (86400 as i64);
    }
    let dd: i64 = days;
    if secs < (0 as i64) {
        dd = days - (1 as i64);
    }
    cd_civil_from_days(dd, out);
    mem_store32(out, 12, (s / (3600 as i64)) as u32);
    mem_store32(out, 16, ((s % (3600 as i64)) / (60 as i64)) as u32);
    mem_store32(out, 20, (s % (60 as i64)) as u32);
}

/// 当地年月日时分秒 -> epoch 秒（不校验日期合法性）。
pub fn tz_epoch(y: i64, m: i64, d: i64, hh: u32, mi: u32, ss: u32, minutes: i32) -> i64 {
    let days: i64 = cd_days_from_civil(y, m, d);
    let secs: i64 = (hh as i64) * (3600 as i64) + (mi as i64) * (60 as i64) + (ss as i64);
    return days * (86400 as i64) + secs - (minutes as i64) * (60 as i64);
}

// ---------------------------------------------------------------- 自检

fn test_tzoff_parse() -> bool {
    let ok: ptr = alloc(4);
    if tz_parse("+08:00", ok) != 480 || mem_load32(ok, 0) != 1 {
        return false;
    }
    if tz_parse("-0530", ok) != (0 as i32 - 330) || mem_load32(ok, 0) != 1 {
        return false;
    }
    if tz_parse("Z", ok) != 0 || mem_load32(ok, 0) != 1 {
        return false;
    }
    return tz_parse("+15:00", ok) == 0 && mem_load32(ok, 0) == 0;
}

fn test_tzoff_civil() -> bool {
    let o: ptr = alloc(24);
    tz_civil(0 as i64, 480 as i32, o);
    if mem_load32(o, 0) != 1970 || mem_load32(o, 4) != 1 || mem_load32(o, 8) != 1 {
        return false;
    }
    if mem_load32(o, 12) != 8 || mem_load32(o, 16) != 0 {
        return false;
    }
    return tz_epoch(1970 as i64, 1 as i64, 1 as i64, 8, 0, 0, 480 as i32) == (0 as i64);
}
