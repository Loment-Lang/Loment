// lompi/lpi_cli.lomt — 命令行: 命令分派与输出
//
// 命令面照 pip 摆, 但每一条都只做 Loment 模型里**成立**的事:
//
//   lompi index   <store>                     仓库里有哪些包 (pip index)
//   lompi show    <store> <名字[@版本]>        一个包的元数据与身份 (pip show)
//   lompi tree    <store> <名字[@版本]>        依赖树 + 实例身份 (pipdeptree)
//   lompi resolve <store> <名字[@版本]>        把锁打出来 (pip freeze)
//   lompi verify  <store> <锁文件>             重算并逐字节比对 (pip check 的强版本)
//   lompi plan    <store> <名字[@版本]> [--into D]  解出闭包与落盘清单
//   lompi hash    <包目录>                     单个包的自身源码哈希
//   lompi help
//
// **为什么没有"直接装"**: 实测 PE 的派发面 (`docs/167` §5) 里**没有 mkdir (83)** ——
// 能写进已存在的目录, 但建不了目录。装一个包要新建 `deps/<名字>/`, 所以 lompi 把
// 那一步做成**计划** (plan): 打出确定的目录与文件清单, 由上层的 shell / CI / 参考
// 工具链去执行。在 ELF 目标上 mkdir 是可用的, 那时 plan 可以直接就地执行 —— 边界
// 是目标平台的, 不是 lompi 的。
//
// resolve 与 verify 是一对: resolve 打出锁, verify **重新算一遍再逐字节比对**。
// 这比"检查一下版本对不对"强得多 —— 它真的回答了"这棵仓库还是不是那把锁描述的那棵"。
//
// 命名: 公开 cli_*, 自检 test_cli_*。

module lpi_cli
choose runtime

use "lpi_idn.lomt"

// ---------------------------------------------------------------- 输出

fn out_lit(s: str) {
    sys_write_str(1, s);
}

fn out_slice(p: ptr, off: u32, n: u32) {
    sys_write(1, ((p as u64) + (off as u64)) as ptr, n as u64);
}

fn out_dec(scr: ptr, v: u64) {
    txt_write_dec(1, scr, v);
}

fn err_lit(s: str) {
    sys_write_str(2, s);
}

fn err_name(p: ptr, off: u32, n: u32) {
    sys_write(2, ((p as u64) + (off as u64)) as ptr, n as u64);
}

/// 用法错 (缺参数 / 不认识的命令): 退出码 **2**, 不是 1。
/// 1 留给"跑了但失败" —— 脚本靠这个区分"我用错了"和"仓库有问题"。
fn cli_usage(msg: str) -> u32 {
    err_lit("lompi: ");
    err_lit(msg);
    err_lit("\n");
    return 2;
}

/// 一条诊断行: "lompi: <消息>\n" 到 stderr。退出码 1。
fn cli_die(msg: str) -> u32 {
    err_lit("lompi: ");
    err_lit(msg);
    err_lit("\n");
    return 1;
}

// ---------------------------------------------------------------- 报告缓冲区

fn R(ws: ptr) -> ptr { return ((ws as u64) + WS_REPORT as u64) as ptr; }

/// 生效 store 路径的槽 —— 见 WS_DSTORE 的注释。
fn S(ws: ptr) -> ptr { return ((ws as u64) + WS_DSTORE as u64) as ptr; }

// ---------------------------------------------------------------- argv

fn arg_count(buf: ptr, m: u32) -> u32 {
    return sys_arg_count(buf, m);
}

fn arg_is(buf: ptr, av: u64, lit: str) -> bool {
    return sys_arg_eq(buf, av, lit);
}

/// 参数 = "名字[@版本]"。返回 (名字偏移 << 32) | (名字长度 << 16) | 版本长度 打包 —
/// 版本紧跟在名字后面, 中间隔一个 '@'。没有 '@' 时版本长度为 0。
fn spec_split(buf: ptr, av: u64) -> u64 {
    let off: u32 = sys_arg_off(av);
    let n: u32 = sys_arg_len(av);
    let at: u32 = txt_find(buf, off, n, 64);
    if at == TXT_NFIND {
        return (off as u64) * 4294967296 + (n as u64) * 65536 + 0;
    }
    return (off as u64) * 4294967296 + (at as u64) * 65536 + ((n - at - 1) as u64);
}

fn spec_name_off(sp: u64) -> u32 { return (sp / 4294967296) as u32; }
fn spec_name_len(sp: u64) -> u32 { return ((sp % 4294967296) / 65536) as u32; }
fn spec_ver_len(sp: u64) -> u32 { return (sp % 65536) as u32; }
fn spec_ver_ptr(buf: ptr, sp: u64) -> ptr {
    return ((buf as u64) + (spec_name_off(sp) as u64) + (spec_name_len(sp) as u64) + 1) as ptr;
}

// ---------------------------------------------------------------- 生效 store

/// 把**生效的 store 路径**写进 WS_DSTORE (NUL 结尾), 返回长度; 0 = 推不出来。
///
/// `av == 0` 表示命令行**没给** `<store>` —— 那时用全局根下的 `store\`, 也就是
/// `lompi config` 打的那一行; 给了就照抄。于是 `lompi show mathutil` 与
/// `lompi show <store> mathutil` 走同一条码路, 命令体里一次分支都不用写。
///
/// 推不出来是**报错**而不是悄悄落到当前目录: 全局根是从 argv[0] 反推的, 反推不出来
/// 说明这个二进制是被从莫名其妙的地方调起来的 —— 那时猜一个目录只会把东西装到别处。
fn cli_resolve_store(ws: ptr, buf: ptr, m: u32, av: u64) -> u32 {
    let out: ptr = S(ws);
    if av != 0 {
        return sys_put_bytes(out, buf, sys_arg_off(av), sys_arg_len(av));
    }
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_TMP as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_TMP as u64 + 1024) as ptr;
    if cfg_exe_dir(buf, m, scr, exed, 1024) == 0 {
        return 0;
    }
    cfg_root(exed, scr, root, 1024);
    return cfg_join(root, "store", out, WS_DSTORE_CAP);
}

/// 数位置参数 (`--flag <值>` 这样的成对参数整个跳过)。用来裁决"给没给 `<store>`":
/// `show [<store>] <名字>` 给了一个位置参数就是没给 store, 两个就是给了。
fn cli_npos(buf: ptr, m: u32, from: u32, flag: str) -> u32 {
    let ac: u32 = sys_arg_count(buf, m);
    let n: u32 = 0;
    let i: u32 = from;
    while i < ac {
        if arg_is(buf, sys_arg_at(buf, m, i), flag) {
            i = i + 2;
        } else {
            n = n + 1;
            i = i + 1;
        }
    }
    return n;
}

// ---------------------------------------------------------------- 公共步骤

/// 扫仓库 + 算身份。返回包数; 失败时用 code 指出原因 (1 打不开 / 2 环 / 3 缺依赖)。
fn load_store(ws: ptr, store: ptr, msg: ptr, msgcap: u32) -> u32 {
    let n: u32 = sto_scan(ws, store);
    if n == 0 {
        // **不静默**: 不传 <store> 时走的是全局 store, 那条路径打不开必须看得见是哪一条,
        // 否则用户只看到"退 1 且什么都不说" —— 而这正是最容易配错的地方。
        err_lit("lompi: cannot read the store: ");
        sys_write(2, store, txt_len_cstr(store) as u64);
        err_lit("\n  (pass <store> explicitly, or check the `store:` line of `lompi config`)\n");
        return 0;
    }
    if idn_pass1(ws, n) != n {
        err_lit("lompi: some package in the store could not be hashed (see the guide's limits)\n");
        return 0;
    }
    let r: u32 = idn_pass2(ws, n, msg, msgcap);
    if r == IDN_CYCLE {
    cli_die("dependency cycle in store");
        return 0;
    }
    if r == IDN_MISSING {
        err_lit("lompi: missing dependency in store: ");
        sys_write(2, msg, txt_len_cstr(msg) as u64);
        err_lit("\n");
        return 0;
    }
    return n;
}

// ---------------------------------------------------------------- index

fn cmd_index(ws: ptr, store: ptr) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let n: u32 = load_store(ws, store, msg, 128);
    if n == 0 {
        return 1;
    }
    out_dec(scr, n as u64);
    out_lit(" package(s) in store\n");
    let i: u32 = 0;
    while i < n {
        out_slice(names, pkg_name_off(ws, i), pkg_name_len(ws, i));
        out_lit(" ");
        out_slice(names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
        out_lit(" ");
        out_slice(pkg_id_hex(ws, i), 0, 16);
        out_lit("\n");
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- show

fn cmd_show(ws: ptr, buf: ptr, store: ptr, av_spec: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let n: u32 = load_store(ws, store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let off: u32 = spec_name_off(sp);
    let nl: u32 = spec_name_len(sp);
    let vl: u32 = spec_ver_len(sp);
    let idx: u32 = sto_find_bytes2(ws, n, ((buf as u64) + (off as u64)) as ptr, nl,
                                   spec_ver_ptr(buf, sp), vl);
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    out_lit("name:    ");
    out_slice(names, pkg_name_off(ws, idx), pkg_name_len(ws, idx));
    out_lit("\nversion: ");
    out_slice(names, pkg_ver_off(ws, idx), pkg_ver_len(ws, idx));
    out_lit("\nid:      ");
    out_slice(pkg_id_hex(ws, idx), 0, 64);
    out_lit("\ndir:     ");
    out_lit("");
    sys_write(1, pkg_dir(ws, idx), txt_len_cstr(pkg_dir(ws, idx)) as u64);
    out_lit("\n");
    // 边
    let d: ptr = pkg_dir(ws, idx);
    let nf: u32 = pkg_list_sources(ws, d);
    let c: u32 = pkg_edges(ws, d, nf);
    let pool: ptr = ((ws as u64) + WS_EPOOL as u64) as ptr;
    let eents: ptr = ((ws as u64) + WS_EENTS as u64) as ptr;
    idn_sort_edges(pool, eents, c);
    out_dec(scr, c as u64);
    out_lit(" use edge(s):\n");
    let k: u32 = 0;
    while k < c {
        out_lit("  ");
        if lex_ent_kind(eents, k) == LEX_NAME {
            out_lit("name ");
        } else {
            out_lit("path ");
        }
        out_slice(pool, lex_ent_off(eents, k), lex_ent_len(eents, k));
        out_lit("\n");
        k = k + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- tree

/// 第 idx 个包的边数 (重算)。lpi_idn 里的同名助手是私有的, 这里另开一个公开入口。
fn idn_edges_of(ws: ptr, idx: u32) -> u32 {
    let d: ptr = pkg_dir(ws, idx);
    let nf: u32 = pkg_list_sources(ws, d);
    if nf == DIR_ERR {
        return 0;
    }
    return pkg_edges(ws, d, nf);
}

/// 依赖树。用一个 (下标, 深度) 的显式栈 —— 语言没有递归深度保证, 而且树里
/// 菱形依赖会让同一个包出现多次, 所以"已经打过"的要标出来, 不能默默重复。
fn cmd_tree(ws: ptr, buf: ptr, store: ptr, av_spec: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let pool: ptr = ((ws as u64) + WS_EPOOL as u64) as ptr;
    let eents: ptr = ((ws as u64) + WS_EENTS as u64) as ptr;
    // 栈: 每个元素 8 字节 (下标 u32 + 深度 u32), 放在报告区尾部之前的一块独立空间
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 5120) as ptr;
    let n: u32 = load_store(ws, store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    let spx: u32 = 0;
    txt_store32(stack, 0, idx);
    txt_store32(stack, 4, 0);
    spx = 1;
    while spx > 0 {
        spx = spx - 1;
        let cur: u32 = txt_load32(stack, spx * 8);
        let depth: u32 = txt_load32(stack, spx * 8 + 4);
        let ind: u32 = 0;
        while ind < depth {
            out_lit("  ");
            ind = ind + 1;
        }
        out_slice(names, pkg_name_off(ws, cur), pkg_name_len(ws, cur));
        out_lit("@");
        out_slice(names, pkg_ver_off(ws, cur), pkg_ver_len(ws, cur));
        out_lit(" ");
        out_slice(pkg_id_hex(ws, cur), 0, 12);
        if (pkg_flags(ws, cur) & PKG_F_INCLOSURE) != 0 {
            out_lit("  (already shown)\n");
        } else {
            out_lit("\n");
            pkg_set_flag(ws, cur, PKG_F_INCLOSURE);
            let c: u32 = idn_edges_of(ws, cur);
            idn_sort_edges(pool, eents, c);
            // 逆序压栈, 弹出时才是正序
            let k: u32 = c;
            while k > 0 {
                k = k - 1;
                if lex_ent_kind(eents, k) == LEX_NAME {
                    let ch: u32 = idn_resolve_name(ws, n, cur,
                        ((pool as u64) + (lex_ent_off(eents, k) as u64)) as ptr,
                        lex_ent_len(eents, k));
                    if ch != PKG_NONE && ch != IDN_NOEDGE && spx < 256 {
                        txt_store32(stack, spx * 8, ch);
                        txt_store32(stack, spx * 8 + 4, depth + 1);
                        spx = spx + 1;
                    }
                }
            }
        }
    }
    return 0;
}

// ---------------------------------------------------------------- resolve / verify

/// 把锁打出来 (进报告区)。锁的每行是 `名字 版本 身份` —— 只有**内容哈希**,
/// 没有版本区间 (docs/168 §3.2: 版本对机器只是标签)。
fn build_lock(ws: ptr, n: u32, root: u32) -> u32 {
    let rep: ptr = R(ws);
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let pool: ptr = ((ws as u64) + WS_EPOOL as u64) as ptr;
    let eents: ptr = ((ws as u64) + WS_EENTS as u64) as ptr;
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 5120) as ptr;
    let o: u32 = 0;
    o = txt_put(rep, o, "# lompi lock v1\n");
    if root == PKG_NONE {
        return o;
    }
    let spx: u32 = 0;
    txt_store32(stack, 0, root);
    spx = 1;
    pkg_set_flag(ws, root, PKG_F_INCLOSURE);
    while spx > 0 {
        spx = spx - 1;
        let cur: u32 = txt_load32(stack, spx * 8);
        o = txt_put_bytes(rep, o, names, pkg_name_off(ws, cur), pkg_name_len(ws, cur));
        o = txt_put(rep, o, " ");
        o = txt_put_bytes(rep, o, names, pkg_ver_off(ws, cur), pkg_ver_len(ws, cur));
        o = txt_put(rep, o, " ");
        o = txt_put_bytes(rep, o, pkg_id_hex(ws, cur), 0, 64);
        o = txt_put(rep, o, "\n");
        let c: u32 = idn_edges_of(ws, cur);
        idn_sort_edges(pool, eents, c);
        let k: u32 = c;
        while k > 0 {
            k = k - 1;
            if lex_ent_kind(eents, k) == LEX_NAME {
                let ch: u32 = idn_resolve_name(ws, n, cur,
                    ((pool as u64) + (lex_ent_off(eents, k) as u64)) as ptr,
                    lex_ent_len(eents, k));
                if ch != PKG_NONE && ch != IDN_NOEDGE
                    && (pkg_flags(ws, ch) & PKG_F_INCLOSURE) == 0 && spx < 256 {
                    pkg_set_flag(ws, ch, PKG_F_INCLOSURE);
                    txt_store32(stack, spx * 8, ch);
                    spx = spx + 1;
                }
            }
        }
    }
    return o;
}

fn cmd_resolve(ws: ptr, buf: ptr, store: ptr, av_spec: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let n: u32 = load_store(ws, store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    let o: u32 = build_lock(ws, n, idx);
    sys_write(1, R(ws), o as u64);
    return 0;
}

/// verify: **重新算一遍**, 与锁文件逐字节比。
/// 比"检查版本对不对"强 —— 它回答的是"这棵仓库还是不是那把锁描述的那棵"。
fn cmd_verify(ws: ptr, buf: ptr, store: ptr, av_spec: u64, av_lock: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let lockp: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let n: u32 = load_store(ws, store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    let o: u32 = build_lock(ws, n, idx);
    // 读锁文件
    sys_put_bytes(lockp, buf, sys_arg_off(av_lock), sys_arg_len(av_lock));
    let file: ptr = ((ws as u64) + WS_STORE as u64) as ptr;
    let got: u64 = sys_read_file(lockp, file, 4096);
    if got == SYS_ERR {
        cli_die("cannot read lock file");
        return 2;
    }
    if got as u32 != o || !txt_eq(R(ws), 0, o, file, 0, o) {
        err_lit("[DIFF] lompi: lock does not match store\n");
        return 1;
    }
    out_lit("[OK] lompi: lock matches store (");
    out_dec(((ws as u64) + (WS_TMP + 7000) as u64) as ptr, o as u64);
    out_lit(" bytes)\n");
    return 0;
}

// ---------------------------------------------------------------- plan

/// 落盘计划。**这一步就是 pip 的 install**, 只是把"建目录"那部分如实写在计划里,
/// 因为 PE 上 lompi 自己做不到 (没有 mkdir) —— 不假装做到。
fn cmd_plan(ws: ptr, buf: ptr, store: ptr, av_spec: u64, into: u64) -> u32 {
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let n: u32 = load_store(ws, store, msg, 128);
    if n == 0 {
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, n,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }
    out_lit("# lompi plan (target dirs must already exist -- no mkdir on PE)\n");
    out_lit("mkdir -p ");
    if into == 0 {
        out_lit("deps");
    } else {
        sys_write(1, ((buf as u64) + (sys_arg_off(into) as u64)) as ptr, sys_arg_len(into) as u64);
    }
    out_lit("\n");
    // 闭包
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 5120) as ptr;
    let c: u32 = idn_closure(ws, n, idx, stack, 256, msg, 128);
    out_lit("# ");
    out_dec(scr, c as u64);
    out_lit(" package instance(s) in the closure:\n");
    let i: u32 = 0;
    while i < n {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            out_lit("#   ");
            out_slice(names, pkg_name_off(ws, i), pkg_name_len(ws, i));
            out_lit("@");
            out_slice(names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
            out_lit(" ");
            out_slice(pkg_id_hex(ws, i), 0, 12);
            out_lit("\n");
            out_lit("#     from ");
            sys_write(1, pkg_dir(ws, i), txt_len_cstr(pkg_dir(ws, i)) as u64);
            out_lit("\n");
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- hash

fn cmd_hash(ws: ptr, buf: ptr, m: u32, av_dir: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let dig: ptr = ((ws as u64) + WS_DIG as u64) as ptr;
    let hex: ptr = ((ws as u64) + WS_HEX as u64) as ptr;
    sys_put_bytes(scr, buf, sys_arg_off(av_dir), sys_arg_len(av_dir));
    let nf: u32 = pkg_list_sources(ws, scr);
    if nf == DIR_ERR {
        cli_die("cannot open directory");
        return 1;
    }
    if pkg_own_hash(ws, scr, nf, dig) != nf {
        cli_die("source file unreadable or too large (refusing to hash truncated content)");
        return 1;
    }
    sha_hex(dig, hex);
    out_lit("files: ");
    out_dec(((ws as u64) + WS_SCR2 as u64) as ptr, nf as u64);
    out_lit("\nself:  ");
    out_slice(hex, 0, 64);
    out_lit("\n");
    return 0;
}

// ---------------------------------------------------------------- obj: 预优化对象的仓 (docs/212 §5 B)
//
// 一个"对象"（`loment build --opt` 或 `tools/loment_opt_obj.py` 产的 `.o`）按**内容寻址**
// 落进 store: `<store>/obj-<sha256>.o`。**端机不需要 clang** —— 拿到那串十六进制就能取回字节,
// 再 `loment build app.lomt --link that.o`。这是"编一次、按内容寻址分发"那格里 store 的这半边。
//
// **扁平存放（`obj-<hex>.o` 直接躺在 store 目录里），不建子目录** —— lompi 的 mkdir 在 PE 上
// 没实现（`sys_can_mkdir()` 恒 false），建子目录会让这一格在 Windows 上直接不可用；而"写一个
// 文件"两个平台都行。store 目录里其它成员是 `<名字>/`，一个 `obj-…` 文件不会与它们撞。

//: 单个对象的字节上限 = WS_SHA - WS_FILE (256 KiB)。满了就**点名拒**，绝不存截断的字节。
const OBJ_CAP: u32 = 262144;

fn cmd_obj(ws: ptr, buf: ptr, m: u32, ac: u32) -> u32 {
    let c2: u64 = sys_arg_at(buf, m, 2);
    if arg_is(buf, c2, "add") {
        // ac-3 个位置参数: 一个 = 只有 <file.o> (store 走默认), 两个 = <store> <file.o>。
        let np: u32 = ac - 3;
        if np == 1 {
            if cli_resolve_store(ws, buf, m, 0) == 0 {
                return cli_die("cannot derive the store path (pass <store> explicitly)");
            }
            return obj_add(ws, buf, S(ws), sys_arg_at(buf, m, 3));
        }
        if np == 2 {
            if cli_resolve_store(ws, buf, m, sys_arg_at(buf, m, 3)) == 0 {
                return cli_die("obj add: the store path is unusable");
            }
            return obj_add(ws, buf, S(ws), sys_arg_at(buf, m, 4));
        }
        return cli_usage("obj add needs [<store>] <file.o>");
    }
    if arg_is(buf, c2, "get") {
        // `--out` 可以跟在任何一个位置参数后面, 所以先数**位置参数**再裁决。
        let np: u32 = cli_npos(buf, m, 3, "--out");
        let hexa: u64 = 0;
        if np == 1 {
            hexa = sys_arg_at(buf, m, 3);
            if cli_resolve_store(ws, buf, m, 0) == 0 {
                return cli_die("cannot derive the store path (pass <store> explicitly)");
            }
        } else if np == 2 {
            if cli_resolve_store(ws, buf, m, sys_arg_at(buf, m, 3)) == 0 {
                return cli_die("obj get: the store path is unusable");
            }
            hexa = sys_arg_at(buf, m, 4);
        } else {
            return cli_usage("obj get needs [<store>] <sha256> [--out OUT.o]");
        }
        return obj_get(ws, buf, S(ws), hexa, cfg_flag_arg(buf, m, "--out"));
    }
    return cli_usage("obj needs add|get");
}

/// `<store>/obj-<hex>.o` 写进 WS_SCR2，返回长度 (不含 NUL)。
fn obj_slot(ws: ptr, store: ptr, hex: ptr, hn: u32) -> u32 {
    let scr2: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let n: u32 = cli_put_cstr(scr2, 0, store);
    n = sys_append_lit(scr2, n, "/obj-");
    n = sys_append_bytes(scr2, n, hex, hn);
    return sys_append_lit(scr2, n, ".o");
}

fn obj_add(ws: ptr, buf: ptr, store: ptr, file_av: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let obuf: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
    let st: ptr = ((ws as u64) + WS_SHA as u64) as ptr;
    let dig: ptr = ((ws as u64) + WS_DIG as u64) as ptr;
    let hex: ptr = ((ws as u64) + WS_HEX as u64) as ptr;
    let _fl: u32 = sys_put_bytes(scr, buf, sys_arg_off(file_av), sys_arg_len(file_av));
    let n: u64 = sys_read_file(scr, obuf, OBJ_CAP as u64);
    if n == SYS_ERR {
        cli_die("obj add: cannot open the object file");
        return 1;
    }
    if n >= OBJ_CAP as u64 {
        cli_die("obj add: object exceeds the 256 KiB slot (refusing to store truncated bytes)");
        return 1;
    }
    sha_hex_of(obuf, n as u32, st, dig, hex);
    let _sl: u32 = obj_slot(ws, store, hex, 64);
    let w: u64 = sys_write_file(((ws as u64) + WS_SCR2 as u64) as ptr, obuf, n);
    if w == SYS_ERR {
        cli_die("obj add: cannot write into the store");
        return 1;
    }
    out_lit("obj: ");
    out_slice(hex, 0, 64);
    out_lit("\n");
    return 0;
}

fn obj_get(ws: ptr, buf: ptr, store: ptr, hex_av: u64, out_av: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let obuf: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
    let hex: ptr = ((ws as u64) + WS_HEX as u64) as ptr;
    let hn: u32 = sys_arg_len(hex_av);
    if hn == 0 || hn > 64 {
        cli_die("obj get: the content address must be 1..64 hex chars");
        return 1;
    }
    let _hl: u32 = sys_put_bytes(hex, buf, sys_arg_off(hex_av), hn);
    let _sl: u32 = obj_slot(ws, store, hex, hn);
    let n: u64 = sys_read_file(((ws as u64) + WS_SCR2 as u64) as ptr, obuf, OBJ_CAP as u64);
    if n == SYS_ERR {
        cli_die("obj get: no such object in the store");
        return 1;
    }
    // 落点: `--out OUT` 给了就用它; 否则 `<hex>.o` 落在当前目录。
    let ol: u32 = 0;
    if out_av != 0 {
        ol = sys_put_bytes(scr, buf, sys_arg_off(out_av), sys_arg_len(out_av));
    } else {
        ol = sys_put_bytes(scr, buf, sys_arg_off(hex_av), hn);
        ol = sys_append_lit(scr, ol, ".o");
    }
    let w: u64 = sys_write_file(scr, obuf, n);
    if w == SYS_ERR {
        cli_die("obj get: cannot write the output file");
        return 1;
    }
    out_lit("wrote: ");
    out_slice(scr, 0, ol);
    out_lit("\n");
    return 0;
}

// ---------------------------------------------------------------- help / main

// Output here is ASCII-only ON PURPOSE: on a 936 (GBK) Windows console the PE
// runtime writes UTF-8 bytes via WriteFile and the console decodes them as GBK, so
// anything non-ASCII becomes mojibake. The runtime has no WriteConsoleW, so the only
// lever we own is to print nothing but ASCII.
fn print_help() {
    out_lit("lompi 0.2.0 - package manager for Loment libraries\n");
    out_lit("        identity = content hash, dependencies = `use` in source\n");
    out_lit("\n");
    out_lit("  lompi install <name> [--into DIR] [--apply] [--from-lock F]  fetch/validate/install\n");
    out_lit("        --apply        really write the files (target dirs must already exist)\n");
    out_lit("        --from-lock F  install exactly the instances F pins, refuse on mismatch\n");
    out_lit("        --into DIR     target DIR\\<name>\\; default is the global store\n");
    out_lit("  lompi check   <dir>                                 is this a valid Loment library?\n");
    out_lit("  lompi fetch   [--registry URL] [--registry-sha256 H]  fetch the registry (H = index sha256)\n");
    out_lit("        --registry-sha256 H  pin the index hash out of band (64 hex; docs/236 §7.1)\n");
    out_lit("  lompi config                                        show global root and registry\n");
    out_lit("  lompi version                                       print the version\n");
    out_lit("\n");
    out_lit("  lompi list    [<store>]                             list packages in the store\n");
    out_lit("  lompi show    [<store>] <name[@version]>            metadata / use edges / identity\n");
    out_lit("  lompi tree    [<store>] <name[@version]>            dependency tree\n");
    out_lit("  lompi resolve [<store>] <name[@version]>            print the lock (hash-pinned)\n");
    out_lit("  lompi verify  [<store>] <name[@version]> <lockfile> recompute, compare byte-for-byte\n");
    out_lit("  lompi plan    [<store>] <name[@version]> [--into DIR]  closure + install plan\n");
    out_lit("  lompi hash    <package-dir>                         own-source hash of one package\n");
    out_lit("  lompi obj     add [<store>] <file.o>                content-addressed object -> <store>\n");
    out_lit("  lompi obj     get [<store>] <sha256> [--out OUT.o]  fetch an object (no compiler needed)\n");
    out_lit("\n");
    out_lit("<store> is optional on every verb above: omit it and the global store is\n");
    out_lit("used -- the directory `lompi config` prints on its `store:` line.\n");
    out_lit("`index` is kept as a synonym for `list`.\n");
    out_lit("store layout: <store>/<name>/<version>/*.lomt (+ optional pkg.lomp)\n");
    out_lit("registry:     a git repo with that same layout; see lompi.conf or --registry\n");
    out_lit("install default destination: the global store (use --into DIR for a project)\n");
}

/// 命令行入口。返回退出码 (0 = OK / 1 = 失败 / 2 = 用法错)。
pub fn cli_main(ws: ptr, buf: ptr, m: u32) -> u32 {
    let ac: u32 = arg_count(buf, m);
    if ac < 2 {
        print_help();
        return 2;
    }
    let c1: u64 = sys_arg_at(buf, m, 1);
    if arg_is(buf, c1, "help") || arg_is(buf, c1, "--help") || arg_is(buf, c1, "-h") {
        print_help();
        return 0;
    }
    if arg_is(buf, c1, "version") || arg_is(buf, c1, "--version") || arg_is(buf, c1, "-V") {
        return cmd_version();
    }
    if arg_is(buf, c1, "config") {
        return cmd_config(ws, buf, m);
    }
    if arg_is(buf, c1, "check") {
        if ac < 3 {
            return cli_usage("check needs a <directory>");
        }
        return cmd_check(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "fetch") {
        return cmd_fetch(ws, buf, m);
    }
    if arg_is(buf, c1, "install") {
        if ac < 3 {
            return cli_usage("install needs a <name>");
        }
        return cmd_install(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "index") || arg_is(buf, c1, "list") {
        let av: u64 = 0;
        if ac >= 3 {
            av = sys_arg_at(buf, m, 2);
        }
        if cli_resolve_store(ws, buf, m, av) == 0 {
            return cli_die("cannot derive the store path (pass <store> explicitly)");
        }
        return cmd_index(ws, S(ws));
    }
    if arg_is(buf, c1, "hash") {
        if ac < 3 {
            return cli_usage("hash needs a <package-dir>");
        }
        return cmd_hash(ws, buf, m, sys_arg_at(buf, m, 2));
    }
    if arg_is(buf, c1, "obj") {
        if ac < 4 {
            return cli_usage("obj needs add|get");
        }
        return cmd_obj(ws, buf, m, ac);
    }
    if arg_is(buf, c1, "show") {
        let stv: u64 = 0;
        let nm: u64 = 0;
        if ac >= 4 {
            stv = sys_arg_at(buf, m, 2);
            nm = sys_arg_at(buf, m, 3);
        } else if ac >= 3 {
            nm = sys_arg_at(buf, m, 2);
        } else {
            return cli_usage("show needs a <name>");
        }
        if cli_resolve_store(ws, buf, m, stv) == 0 {
            return cli_die("cannot derive the store path (pass <store> explicitly)");
        }
        return cmd_show(ws, buf, S(ws), nm);
    }
    if arg_is(buf, c1, "tree") {
        let stv: u64 = 0;
        let nm: u64 = 0;
        if ac >= 4 {
            stv = sys_arg_at(buf, m, 2);
            nm = sys_arg_at(buf, m, 3);
        } else if ac >= 3 {
            nm = sys_arg_at(buf, m, 2);
        } else {
            return cli_usage("tree needs a <name>");
        }
        if cli_resolve_store(ws, buf, m, stv) == 0 {
            return cli_die("cannot derive the store path (pass <store> explicitly)");
        }
        return cmd_tree(ws, buf, S(ws), nm);
    }
    if arg_is(buf, c1, "resolve") {
        let stv: u64 = 0;
        let nm: u64 = 0;
        if ac >= 4 {
            stv = sys_arg_at(buf, m, 2);
            nm = sys_arg_at(buf, m, 3);
        } else if ac >= 3 {
            nm = sys_arg_at(buf, m, 2);
        } else {
            return cli_usage("resolve needs a <name>");
        }
        if cli_resolve_store(ws, buf, m, stv) == 0 {
            return cli_die("cannot derive the store path (pass <store> explicitly)");
        }
        return cmd_resolve(ws, buf, S(ws), nm);
    }
    if arg_is(buf, c1, "verify") {
        let stv: u64 = 0;
        let nm: u64 = 0;
        let lk: u64 = 0;
        if ac >= 5 {
            stv = sys_arg_at(buf, m, 2);
            nm = sys_arg_at(buf, m, 3);
            lk = sys_arg_at(buf, m, 4);
        } else if ac >= 4 {
            nm = sys_arg_at(buf, m, 2);
            lk = sys_arg_at(buf, m, 3);
        } else {
            return cli_usage("verify needs a <name> and a <lockfile>");
        }
        if cli_resolve_store(ws, buf, m, stv) == 0 {
            return cli_die("cannot derive the store path (pass <store> explicitly)");
        }
        return cmd_verify(ws, buf, S(ws), nm, lk);
    }
    if arg_is(buf, c1, "plan") {
        // `[<store>] <name> [--into DIR]` —— 数位置参数裁决给没给 store。
        let np: u32 = cli_npos(buf, m, 2, "--into");
        let stv: u64 = 0;
        let nm: u64 = 0;
        if np >= 2 {
            stv = sys_arg_at(buf, m, 2);
            nm = sys_arg_at(buf, m, 3);
        } else if np == 1 {
            nm = sys_arg_at(buf, m, 2);
        } else {
            return cli_usage("plan needs a <name>");
        }
        if cli_resolve_store(ws, buf, m, stv) == 0 {
            return cli_die("cannot derive the store path (pass <store> explicitly)");
        }
        return cmd_plan(ws, buf, S(ws), nm, cfg_flag_arg(buf, m, "--into"));
    }
    err_lit("lompi: unknown command: ");
    sys_write(2, ((buf as u64) + (sys_arg_off(c1) as u64)) as ptr, sys_arg_len(c1) as u64);
    err_lit("\n");
    print_help();
    return 2;
}

// ---------------------------------------------------------------- 配置: 全局根 / 网址库
//
// **为什么全局根是"推"出来的而不是读环境变量**: 实测 `/proc/self/environ` 在 PE 垫片
// 上读不了 (它只合成 cmdline), 语言也没有 getenv。但 argv[0] 是**执行文件的全路径**,
// 所以从它反推用户目录是可行的。规则按可靠性排序, 命中哪条 `lompi config` 会打出来 ——
// 猜错看得见, 不会静默走错目录。
//
// 网址库的配置文件 `lompi.conf` 放在**执行文件旁边**, 内容是 **Loment 源码**, 形状与
// `pkg.lomp` 一样: `pub fn registry() -> str { return "https://..."; }`。
// 不新造格式 —— 读它用的就是读清单那套 lex_find_label。

/// ASCII 小写 (Windows 路径大小写不保证)。
fn cfg_fold(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

/// 大小写不敏感地找子串。返回下标或 TXT_NFIND。
fn cfg_find_ci(p: ptr, n: u32, lit: str) -> u32 {
    let ln: u32 = str_len(lit);
    if ln == 0 || ln > n {
        return TXT_NFIND;
    }
    let i: u32 = 0;
    while i + ln <= n {
        let j: u32 = 0;
        let hit: u32 = 1;
        while j < ln {
            if cfg_fold(load8(p, i + j)) != cfg_fold(str_byte(lit, j)) {
                hit = 0;
            }
            j = j + 1;
        }
        if hit == 1 {
            return i;
        }
        i = i + 1;
    }
    return TXT_NFIND;
}

/// path 的父目录。返回长度。
pub fn cfg_parent(path: ptr, out: ptr, outcap: u32) -> u32 {
    let n: u32 = txt_len_cstr(path);
    let cut: u32 = 0;
    let found: u32 = 0;
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        let c: u32 = load8(path, i);
        if (c == 47 || c == 92) && found == 0 {
            cut = i;
            found = 1;
            i = 0;
        }
    }
    let len: u32 = cut;
    if found == 0 {
        return 0;
    }
    if len > outcap {
        return 0;
    }
    sys_copy(out, 0, path, 0, len);
    store8(out, len, 0 as u8);
    return len;
}

/// argv[0] 的目录 —— 也就是执行文件所在目录。scr 是调用方给的暂存 (≥512 字节)。
fn cfg_exe_dir(buf: ptr, m: u32, scr: ptr, out: ptr, outcap: u32) -> u32 {
    let a0: u64 = sys_arg_at(buf, m, 0);
    if a0 == 0 {
        return 0;
    }
    sys_put_bytes(scr, buf, sys_arg_off(a0), sys_arg_len(a0));
    return cfg_parent(scr, out, outcap);
}

/// 全局根 (store / cache / lompi.conf 的父目录)。路径写进 out, 返回**命中的规则号**:
///   0 = exe 在 `\AppData\Local\` 下 -> 它就是 %LOCALAPPDATA%, 根 = <它>\lompi
///   1 = exe 在 `\Users\<名>\` 下      -> 根 = `\Users\<名>\.lompi`
///   2 = 都不是                       -> 根 = <exe 目录><分隔符>.lompi
/// 命中的是哪条会由 `lompi config` 打出来 —— 推错了要看得见。
///
/// 规则 0/1 认的是 **Windows 的字面串**, 所以只有 PE 上会命中; 其余平台落到规则 2
/// (exe 旁边那个 `.lompi`)。**这是既有的规则, 本文只换分隔符** —— 没给 ELF 发明
/// 新规则 (比如 `$HOME/.lompi`), 那是一条要单独拍的决定。
pub fn cfg_root(exe_path: ptr, scr: ptr, out: ptr, outcap: u32) -> u32 {
    let n: u32 = txt_len_cstr(exe_path);
    let a: u32 = cfg_find_ci(exe_path, n, "\\AppData\\Local\\");
    if a != TXT_NFIND && a + 20 <= outcap {
        let end: u32 = a + 15;                 // 含结尾那个 '\'
        sys_copy(out, 0, exe_path, 0, end);
        txt_put(out, end, "lompi");
        return 0;
    }
    let u: u32 = cfg_find_ci(exe_path, n, "\\Users\\");
    if u != TXT_NFIND {
        let ns: u32 = u + 7;                   // 用户名起点
        let ne: u32 = ns;
        while ne < n && load8(exe_path, ne) != 92 && load8(exe_path, ne) != 47 {
            ne = ne + 1;
        }
        if ne > ns && ne + 8 <= outcap {
            sys_copy(out, 0, exe_path, 0, ne);
            sys_put_sep(out, ne, ".lompi");
            return 1;
        }
    }
    let dn: u32 = cfg_parent(exe_path, scr, 4096);
    if dn == 0 || dn + 8 > outcap {
        store8(out, 0, 0 as u8);
        return 2;
    }
    sys_copy(out, 0, scr, 0, dn);
    sys_put_sep(out, dn, ".lompi");
    return 2;
}

/// `root` + <分隔符> + `sub`, 写进 out 并补 NUL。返回总长度。
pub fn cfg_join(root: ptr, sub: str, out: ptr, outcap: u32) -> u32 {
    let rn: u32 = txt_len_cstr(root);
    let sl: u32 = str_len(sub);
    if rn + 1 + sl > outcap {
        return 0;
    }
    sys_copy(out, 0, root, 0, rn);
    let o1: u32 = sys_append_sep(out, rn);
    let o2: u32 = txt_put(out, o1, sub);
    store8(out, o2, 0 as u8);
    return o2;
}

/// 读 `<dir><分隔符>lompi.conf` 里的标签 (Loment 源码, 形状同 pkg.lomp)。返回长度 (0 = 没有)。
/// out 不能用 WS_SCR2 (本函数内部拿它拼路径)。
pub fn cfg_label(ws: ptr, dir: ptr, name: str, out: ptr, outcap: u32) -> u32 {
    let file: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
    let scr: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let dn: u32 = txt_len_cstr(dir);
    if dn == 0 || dn + 12 > WS_SCR2_CAP {
        return 0;
    }
    sys_copy(scr, 0, dir, 0, dn);
    let o: u32 = sys_put_sep(scr, dn, "lompi.conf");
    store8(scr, o, 0 as u8);
    let got: u64 = sys_read_file(scr, file, 65536);
    if got == SYS_ERR {
        return 0;
    }
    return lex_find_label(file, got as u32, name, out, outcap);
}

/// 解析生效的网址库。顺序: `--registry <url>` > lompi.conf 的 `registry()` > 无。
/// 返回长度 (0 = 没配); 来源写进 src 的第 0 字节: 0=命令行 1=配置文件 2=没配。
pub fn cfg_registry(ws: ptr, buf: ptr, exe_dir: ptr, flag_av: u64,
                    out: ptr, outcap: u32, src: ptr) -> u32 {
    store8(src, 0, 2 as u8);
    if flag_av != 0 {
        let l: u32 = sys_arg_len(flag_av);
        if l > outcap {
            return 0;
        }
        sys_copy(out, 0, buf, sys_arg_off(flag_av), l);
        store8(src, 0, 0 as u8);
        return l;
    }
    let n: u32 = cfg_label(ws, exe_dir, "registry", out, outcap);
    if n > 0 {
        store8(src, 0, 1 as u8);
    }
    return n;
}

/// 从命令行取 `--flag <值>` 的参数, 没有返回 0。
pub fn cfg_flag_arg(buf: ptr, m: u32, lit: str) -> u64 {
    let ac: u32 = sys_arg_count(buf, m);
    let k: u32 = 2;
    while k < ac {
        if arg_is(buf, sys_arg_at(buf, m, k), lit) && k + 1 < ac {
            return sys_arg_at(buf, m, k + 1);
        }
        k = k + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- version / config / check

fn cmd_version() -> u32 {
    out_lit("lompi 0.2.0\n");
    return 0;
}

/// 打出生效的全局根与网址库, **连"它是按哪条规则推出来的"一起打** ——
/// 推错了要看得见, 而不是静默落到错误的目录上去装东西。
fn cmd_config(ws: ptr, buf: ptr, m: u32) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_OUT as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_OUT as u64 + 1024) as ptr;
    let p: ptr = ((ws as u64) + WS_OUT as u64 + 2048) as ptr;
    let reg: ptr = ((ws as u64) + WS_OUT as u64 + 3072) as ptr;
    let sr: ptr = ((ws as u64) + WS_TMP as u64 + 512) as ptr;
    let exen: u32 = cfg_exe_dir(buf, m, scr, exed, 1024);
    out_lit("version:  0.2.0\n");
    out_lit("exe:      ");
    sys_write(1, exed, exen as u64);
    out_lit("\n");
    if exen == 0 {
        cli_die("cannot derive the executable directory from argv[0]");
        return 1;
    }
    let rule: u32 = cfg_root(exed, scr, root, 1024);
    out_lit("global:   ");
    sys_write(1, root, txt_len_cstr(root) as u64);
    out_lit("\n  rule:   ");
    if rule == 0 {
        out_lit("argv[0] sits under \\AppData\\Local\\, so that is %LOCALAPPDATA%\n");
    } else if rule == 1 {
        out_lit("argv[0] sits under \\Users\\<name>\\, so <that>\\.lompi\n");
    } else {
        out_lit("fallback: <exe dir>\\.lompi (exe is not under AppData or Users)\n");
    }
    cfg_join(root, "store", p, 1024);
    out_lit("store:    ");
    sys_write(1, p, txt_len_cstr(p) as u64);
    out_lit("\n");
    cfg_join(root, "cache", p, 1024);
    out_lit("cache:    ");
    sys_write(1, p, txt_len_cstr(p) as u64);
    out_lit("\n");
    cfg_join(exed, "lompi.conf", p, 1024);
    out_lit("conf:     ");
    sys_write(1, p, txt_len_cstr(p) as u64);
    if cli_exists(p) {
        out_lit("  (present)\n");
    } else {
        out_lit("  (absent)\n");
    }
    let n: u32 = cfg_registry(ws, buf, exed, cfg_flag_arg(buf, m, "--registry"), reg, 1024, sr);
    out_lit("registry: ");
    if n == 0 {
        out_lit("(not set) -- install will use the global store\n");
    } else {
        sys_write(1, reg, n as u64);
        out_lit("\n  from:   ");
        if load8(sr, 0) == 0 {
            out_lit("--registry\n");
        } else {
            out_lit("lompi.conf\n");
        }
    }
    return 0;
}

/// 追加一个**运行期**的 NUL 结尾串 (不含 NUL)。返回新偏移。
/// 为什么不用 txt_put: 那个收的是编译期 str 字面量, 运行期的 ptr 传不进去。
pub fn cli_put_cstr(dst: ptr, off: u32, s: ptr) -> u32 {
    let n: u32 = txt_len_cstr(s);
    sys_copy(dst, off, s, 0, n);
    return off + n;
}

/// 文件在不在 (读得开就算在)。
fn cli_exists(path: ptr) -> bool {
    let fd: i64 = sys_open_ro(path);
    if fd < 0 {
        return false;
    }
    sys_close(fd);
    return true;
}

/// `check <目录>`: 这**是不是一个正确的 Loment 库**。
fn cmd_check(ws: ptr, buf: ptr, m: u32, av_dir: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let rep: ptr = ((ws as u64) + WS_REPORT as u64) as ptr;
    let dec: ptr = ((ws as u64) + WS_TMP as u64) as ptr;
    sys_put_bytes(scr, buf, sys_arg_off(av_dir), sys_arg_len(av_dir));
    let bad: u32 = pkg_check(ws, scr, rep, WS_REPORT_CAP);
    sys_write(1, rep, txt_len_cstr(rep) as u64);
    if bad == 0 {
        out_lit("[OK] lompi: this is a valid Loment library\n");
        return 0;
    }
    out_lit("[BAD] lompi: ");
    out_dec(dec, bad as u64);
    out_lit(" check(s) failed\n");
    return 1;
}

// ---------------------------------------------------------------- fetch / install

/// 从 URL 取仓库名 (最后一段, 去掉结尾的 .git)。
pub fn cfg_slug(url: ptr, n: u32, out: ptr, outcap: u32) -> u32 {
    let cut: u32 = 4294967295;
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        let c: u32 = load8(url, i);
        if (c == 47 || c == 58) && cut == 4294967295 {
            cut = i;
            i = 0;
        }
    }
    let s: u32 = 0;
    if cut != 4294967295 {
        s = cut + 1;
    }
    let e: u32 = n - s;
    let e2: u32 = e;
    if e > 4 && txt_eq_lit(url, s + e - 4, 4, ".git") {
        e2 = e - 4;
    }
    if e2 == 0 || e2 > outcap {
        return 0;
    }
    sys_copy(out, 0, url, s, e2);
    store8(out, e2, 0 as u8);
    return e2;
}

// ---------------------------------------------------------------- 联网 (0.2.0)
//
// **为什么这一层住在 lpi_cli 里**: 链的**嵌套上限是 8 层**(`loment ir` 报
// 「依赖嵌套超过 8 层」), 而 lompi 的链已经是 `lompi -> lpi_cli -> lpi_idn ->
// lpi_pkg -> lpi_sha -> lpi_dir -> lpi_txt -> lpi_sys` 八层 —— 再插一个模块就
// 超了。所以联网原语与 `fetch` 放在同一个文件里: 它在链顶, `txt_*`/`sha_*` 都够得着。
//
// **能力边界**(写在 `docs/236`): 只认 `http://` + IPv4 字面量 —— 工具链里
// **没有解析器**(没有 `getaddrinfo`)、**没有 TLS**。这两条是运行时欠账, 不是
// lompi 的设计立场: 0.1.5 时那句是「PE 上没有 socket」, 联网面补完(`docs/234`)
// 之后往后退到了这一格。

/// socket / connect / sendto / recvfrom 的 Linux 号 (x86-64)。
pub const NET_SYS_SOCKET: u64 = 41;
pub const NET_SYS_CONNECT: u64 = 42;
pub const NET_SYS_SENDTO: u64 = 44;
pub const NET_SYS_RECVFROM: u64 = 45;
pub const NET_AF_INET: u64 = 2;
pub const NET_SOCK_STREAM: u64 = 1;
/// 端口是 16 位。
pub const NET_PORT_MAX: u64 = 65535;
/// 失败哨兵 (与 `SYS_ERR` 同值, 免得两个哨兵混着比)。
pub const NET_ERR: u64 = 18446744073709551615;

// ---------------------------------------------------------------- 基本件

/// IPv4 TCP socket。失败返回 -1。
pub fn net_tcp4() -> i64 {
    return syscall4(NET_SYS_SOCKET, NET_AF_INET, NET_SOCK_STREAM, 0);
}

/// 连到 a.b.c.d:port —— **点分四段直接写进 `sockaddr_in`** (没有解析器可用)。
/// addr 至少 16 字节。返回 connect 的返回值 (0 = 成)。
pub fn net_connect4(fd: i64, addr: ptr, a: u32, b: u32, c: u32, d: u32, port: u64) -> i64 {
    store8(addr, 0, 2 as u8);            // sin_family = AF_INET
    store8(addr, 1, 0 as u8);
    let ph: u64 = port / 256;
    store8(addr, 2, ph as u8);           // 端口是**网络序**: 高字节在前
    store8(addr, 3, (port % 256) as u8);
    store8(addr, 4, a as u8);
    store8(addr, 5, b as u8);
    store8(addr, 6, c as u8);
    store8(addr, 7, d as u8);
    let i: u32 = 8;
    while i < 16 {
        store8(addr, i, 0 as u8);
        i = i + 1;
    }
    return syscall4(NET_SYS_CONNECT, fd as u64, addr as u64, 16);
}

/// 已连接的 socket 上 `sendto` 不带地址就是 `send`。
pub fn net_send(fd: i64, p: ptr, n: u64) -> i64 {
    return syscall7(NET_SYS_SENDTO, fd as u64, p as u64, n, 0, 0, 0);
}

pub fn net_recv(fd: i64, p: ptr, cap: u64) -> i64 {
    return syscall7(NET_SYS_RECVFROM, fd as u64, p as u64, cap, 0, 0, 0);
}

// ---------------------------------------------------------------- 明文 HTTP GET

/// 一条 `HTTP/1.0 GET`。连 a.b.c.d:port, 把 `path` 取进 `out`, 返回**响应体**长度;
/// 任何一步失败返回 `NET_ERR`。
///
/// * 参数从 `req` 那块暂存里取 (`NETREQ_*`); `head` 缓冲固定 1024 字节;
/// * 整条响应先收进 `out`, 再把头切掉 —— 所以 `cap` 要装得下"头 + 体";
/// * `Host:` 里写 `a.b.c.d:port` (对 IP 字面量来说这就是对的名字)。
/// 写一个 CRLF —— **不能靠字符串字面量**: Loment 的转义只认 `\n`, `\r` 会**退化成一个
/// 字母 `r`**(实测: 服务器收到的请求行是 `HTTP/1.0r`, 直接回 400 "Bad request version")。
/// 所以 CR 走字节写, 不写字面量。
pub fn net_crlf(dst: ptr, off: u32) -> u32 {
    store8(dst, off, 13 as u8);
    store8(dst, off + 1, 10 as u8);
    return off + 2;
}

/// 找 HTTP 头结束(字节 13,10,13,10), 返回头结束的下标; 找不到返回 DIR_ERR。
/// 顺手认一下只发 LF 的服务器 —— 少见, 但撞上了不该被当成"这不是 HTTP"。
pub fn net_hdr_end(p: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i + 4 <= n {
        if load8(p, i) == 13 && load8(p, i + 1) == 10
            && load8(p, i + 2) == 13 && load8(p, i + 3) == 10 {
            return i;
        }
        i = i + 1;
    }
    let j: u32 = 0;
    while j + 2 <= n {
        if load8(p, j) == 10 && load8(p, j + 1) == 10 {
            return j;
        }
        j = j + 1;
    }
    return DIR_ERR;
}

pub fn net_http_get(req: ptr, path: ptr, plen: u32, out: ptr, cap: u64) -> u64 {
    let scr: ptr = txt_load64(req, NETREQ_SCR) as ptr;
    let head: ptr = txt_load64(req, NETREQ_HEAD) as ptr;
    let a: u32 = txt_load32(req, NETREQ_A);
    let b: u32 = txt_load32(req, NETREQ_B);
    let c: u32 = txt_load32(req, NETREQ_C);
    let d: u32 = txt_load32(req, NETREQ_D);
    let port: u64 = txt_load64(req, NETREQ_PORT);
    let fd: i64 = net_tcp4();
    if fd < 0 {
        return NET_ERR;
    }
    let cn: i64 = net_connect4(fd, scr, a, b, c, d, port);
    if cn < 0 {
        sys_close(fd);
        return NET_ERR;
    }
    let o: u32 = txt_put(head, 0, "GET ");
    let o1: u32 = txt_put_bytes(head, o, path, 0, plen);
    let o2: u32 = net_crlf(head, txt_put(head, o1, " HTTP/1.0"));
    let o2b: u32 = txt_put(head, o2, "Host: ");
    let o3: u32 = txt_put_dec(head, o2b, a as u64);
    let o4: u32 = txt_put_byte(head, o3, 46);
    let o5: u32 = txt_put_dec(head, o4, b as u64);
    let o6: u32 = txt_put_byte(head, o5, 46);
    let o7: u32 = txt_put_dec(head, o6, c as u64);
    let o8: u32 = txt_put_byte(head, o7, 46);
    let o9: u32 = txt_put_dec(head, o8, d as u64);
    let oA: u32 = txt_put_byte(head, o9, 58);
    let oB: u32 = txt_put_dec(head, oA, port);
    let oC: u32 = net_crlf(head, txt_put(head, oB, "Connection: close"));
    let oD: u32 = net_crlf(head, oC);
    if oD > 1024 {
        sys_close(fd);
        return NET_ERR;
    }
    let sn: i64 = net_send(fd, head, oD as u64);
    if sn < 0 {
        sys_close(fd);
        return NET_ERR;
    }
    let got: u64 = 0;
    let run: u32 = 1;
    while run == 1 && got < cap {
        let dst: ptr = ((out as u64) + got) as ptr;
        let r: i64 = net_recv(fd, dst, cap - got);
        if r <= 0 {
            run = 0;
        } else {
            got = got + (r as u64);
        }
    }
    sys_close(fd);
    if got == 0 {
        return NET_ERR;
    }
    let hdr: u32 = net_hdr_end(out, got as u32);
    if hdr == DIR_ERR {
        return NET_ERR;                  // 不是一条 HTTP 响应
    }
    if txt_find_lit(out, 0, hdr, " 200") == TXT_NFIND {
        return NET_ERR;                  // 非 200(含 3xx: 不跟重定向)
    }
    let bstart: u32 = hdr + 4;
    let blen: u32 = (got as u32) - bstart;
    if bstart > 0 {
        sys_copy(out, 0, out, bstart, blen);
    }
    return blen as u64;
}

// ---------------------------------------------------------------- URL 拆解
//
// 只拆 `http://a.b.c.d[:port][/path]` 这一种形状; 别的一律"不认"(返回 0),
// 由上层回退到打印计划。**不猜**: 认不出来就说不认。

/// 拆一个 registry URL。全部成功返回 1, 否则返回 0 (调用方去打印计划)。
/// * `a`..`d` 收 4 段地址; `port_out` 收端口 (缺省 80);
/// * `path`/`pathcap` 收**路径**(含前导 `/`, 不含 query; 空路径写成 `/`);
/// * `ip` 是"这个 URL 能不能自己连"的标志位输出(0/1) —— 现代码里它总是 1,
///   留着是为了"主机不是 IP 字面量"那一支明确地失败。
pub fn net_parse_http(url: ptr, n: u32,
                      pa: ptr, pb: ptr, pc: ptr, pd: ptr, port_out: ptr,
                      path: ptr, pathcap: u32) -> u32 {
    // 必须 http:// 开头 (https:// 直接不认 —— 没有 TLS)
    if n < 8 || !txt_eq_lit(url, 0, 7, "http://") {
        return 0;
    }
    let i: u32 = 7;
    // 四段十进制, 点分隔
    let ok: u32 = 1;
    let seg: u32 = 0;
    let v0: u32 = 0;
    let v1: u32 = 0;
    let v2: u32 = 0;
    let v3: u32 = 0;
    while seg < 4 && ok == 1 {
        let st: u32 = i;
        while i < n && txt_is_digit(load8(url, i)) {
            i = i + 1;
        }
        if i == st {
            ok = 0;
        } else {
            let v: u64 = txt_parse_dec_v(txt_parse_dec(url, st, i - st));
            if v > 255 {
                ok = 0;
            }
            if seg == 0 {
                v0 = v as u32;
            } else if seg == 1 {
                v1 = v as u32;
            } else if seg == 2 {
                v2 = v as u32;
            } else {
                v3 = v as u32;
            }
            seg = seg + 1;
            if seg < 4 {
                if i >= n || load8(url, i) != 46 {
                    ok = 0;
                } else {
                    i = i + 1;
                }
            }
        }
    }
    if ok == 0 {
        return 0;
    }
    let port: u64 = 80;
    if i < n && load8(url, i) == 58 {
        i = i + 1;
        let ps: u32 = i;
        while i < n && txt_is_digit(load8(url, i)) {
            i = i + 1;
        }
        if i == ps {
            return 0;
        }
        port = txt_parse_dec_v(txt_parse_dec(url, ps, i - ps));
        if port == 0 || port > NET_PORT_MAX {
            return 0;
        }
    }
    // 余下的是路径 (可空; 空 = `/`)
    let pn: u32 = 0;
    if i < n {
        if load8(url, i) != 47 {
            return 0;                    // 主机后面必须是 `/` 或结束
        }
        while i < n {
            if load8(url, i) == 63 || load8(url, i) == 35 {
                // `?` / `#` 之后不取(我们不支持 query)
                i = n;
            } else {
                if pn + 1 >= pathcap {
                    return 0;
                }
                store8(path, pn, load8(url, i) as u8);
                pn = pn + 1;
                i = i + 1;
            }
        }
    }
    if pn == 0 {
        store8(path, 0, 47 as u8);
        pn = 1;
    }
    store8(path, pn, 0 as u8);
    txt_store32(pa, 0, v0);
    txt_store32(pb, 0, v1);
    txt_store32(pc, 0, v2);
    txt_store32(pd, 0, v3);
    txt_store64(port_out, 0, port);
    return 1;
}

// ---------------------------------------------------------------- 自检 (联网那一层)

fn test_net_parse_rejects_https() -> bool {
    let s: ptr = sys_alloc(64);
    let pa: ptr = sys_alloc(8);
    let pb: ptr = sys_alloc(8);
    let pc: ptr = sys_alloc(8);
    let pd: ptr = sys_alloc(8);
    let po: ptr = sys_alloc(8);
    let path: ptr = sys_alloc(64);
    let o: u32 = sys_put_lit(s, "https://github.com/x/y");
    return net_parse_http(s, o, pa, pb, pc, pd, po, path, 64) == 0;
}

fn test_net_parse_accepts_ip_and_port() -> bool {
    let s: ptr = sys_alloc(64);
    let pa: ptr = sys_alloc(8);
    let pb: ptr = sys_alloc(8);
    let pc: ptr = sys_alloc(8);
    let pd: ptr = sys_alloc(8);
    let po: ptr = sys_alloc(8);
    let path: ptr = sys_alloc(64);
    let o: u32 = sys_put_lit(s, "http://127.0.0.1:8080/libs");
    if net_parse_http(s, o, pa, pb, pc, pd, po, path, 64) != 1 {
        return false;
    }
    if txt_load32(pa, 0) != 127 || txt_load32(pb, 0) != 0
        || txt_load32(pc, 0) != 0 || txt_load32(pd, 0) != 1 {
        return false;
    }
    if txt_load64(po, 0) != 8080 {
        return false;
    }
    let pl: u32 = txt_len_cstr(path);
    return pl == 5 && txt_eq_lit(path, 0, 5, "/libs");
}

fn test_net_parse_rejects_hostname() -> bool {
    let s: ptr = sys_alloc(64);
    let pa: ptr = sys_alloc(8);
    let pb: ptr = sys_alloc(8);
    let pc: ptr = sys_alloc(8);
    let pd: ptr = sys_alloc(8);
    let po: ptr = sys_alloc(8);
    let path: ptr = sys_alloc(64);
    let o: u32 = sys_put_lit(s, "http://libs.example.com/x");
    return net_parse_http(s, o, pa, pb, pc, pd, po, path, 64) == 0;
}

/// 跑本模块全部自检, 返回失败条数 (0 = 全绿)。
pub fn selftest_net() -> u32 {
    let f: u32 = 0;
    if !test_net_parse_rejects_https() { f = f + 1; sys_write_str(1, "  FAIL net_parse_https\n"); }
    if !test_net_parse_accepts_ip_and_port() { f = f + 1; sys_write_str(1, "  FAIL net_parse_ip\n"); }
    if !test_net_parse_rejects_hostname() { f = f + 1; sys_write_str(1, "  FAIL net_parse_hostname\n"); }
    return f;
}
// ---------------------------------------------------------------- 注册表: 自己拉 (0.2.0)

//: 单个文件的落盘上限, 与 `pkg` 那一侧同一条口径 (256 KiB)。
const NET_FILE_CAP: u32 = 262144;

//: **一次取件的全部参数**挤在这一块暂存里 —— 为什么不摊成形参: **自举编译器的形参上限
//: 是 10**(11 个直接 SIGILL, 而且**无声**), 参考实现却照收。这条差异是实测出来的。
const NETREQ_SCR: u32 = 0;          // ptr: 16 字节 sockaddr 暂存
const NETREQ_HEAD: u32 = 8;         // ptr: 请求头暂存 (1024)
const NETREQ_BASE: u32 = 16;        // ptr: 注册表基路径 (已带前导 `/`)
const NETREQ_A: u32 = 24;           // u32: 四段地址
const NETREQ_B: u32 = 32;
const NETREQ_C: u32 = 40;
const NETREQ_D: u32 = 48;
const NETREQ_PORT: u32 = 56;        // u64: 端口
const NETREQ_IDX: u32 = 64;         // ptr: 索引缓冲
const NETREQ_IDXCAP: u32 = 72;      // u32
const NETREQ_BODY: u32 = 80;        // ptr: 单文件响应缓冲
const NETREQ_BODYCAP: u32 = 88;     // u32
//: ptr: **带外**钉住的索引 sha256 (64 个小写十六进制字节的 C 串), 或 0 = 没钉。
//: 索引与它里面的那些哈希走的是**同一条明文通道** —— 那条逐个比 sha256 只能查出
//: "路上坏了", 挡不住"有人把索引和载荷一起换掉" (issue #306/#377)。
const NETREQ_PIN: u32 = 96;
const NETREQ_SIZE: u32 = 128;

//: 完成标记的**内容**是 `lompi-fetch 1 complete\n` (下面两处逐字写死 —— 语言没有
//: 字符串常量)。它落在 `<cache>/lompi-fetch-complete`, 但"完成"是内容说了算:
//: 0 字节 = 上一次没走完 (或正在走) —— PE 运行时没有 unlink, 标记删不掉, 所以作废
//: 只能靠截断 (issue #378)。改这个字符串要两处一起改。

/// 完成标记的完整路径。返回长度 (不含 NUL)。
fn net_mark_path(dir: ptr, out: ptr) -> u32 {
    let n: u32 = txt_len_cstr(dir);
    sys_copy(out, 0, dir, 0, n);
    let o: u32 = sys_append_sep(out, n);
    let o2: u32 = sys_append_lit(out, o, "lompi-fetch-complete");
    store8(out, o2, 0 as u8);
    return o2;
}

/// 这个缓存目录取齐了没有。1 = 标记内容说的是"上一次走完了"; 0 = 没有标记、
/// 标记是空的、或内容不认识 —— **认不出就算不完整**, 别把坏状态当好消息。
fn net_mark_state(dir: ptr) -> u32 {
    let mp: ptr = sys_alloc(1200);
    let _mpn: u32 = net_mark_path(dir, mp);
    let buf: ptr = sys_alloc(64);
    let got: u64 = sys_read_file(mp, buf, 64);
    if got == SYS_ERR {
        return 0;
    }
    if txt_eq_lit(buf, 0, got as u32, "lompi-fetch 1 complete\n") {
        return 1;
    }
    return 0;
}

/// 写标记: `complete == 1` 落完成令牌, 否则**截断成 0 字节** (= 这次不作数)。
/// 返回 1 = 写了; 0 = 目录不在 / 写不了 (调用方不需要因此改判, 落盘那一步会自己报)。
fn net_mark_write(dir: ptr, complete: u32) -> u32 {
    let mp: ptr = sys_alloc(1200);
    let _mpn: u32 = net_mark_path(dir, mp);
    let buf: ptr = sys_alloc(64);
    if complete == 1 {
        let m: u32 = sys_append_lit(buf, 0, "lompi-fetch 1 complete\n");
        if sys_write_file(mp, buf, m as u64) == SYS_ERR {
            return 0;
        }
        return 1;
    }
    if sys_write_file(mp, buf, 0) == SYS_ERR {
        return 0;
    }
    return 1;
}

/// `--registry-sha256` 的值: 必须恰好 64 个十六进制字符; 大小写都收, 但**规整成小写**
/// 再写进 out (C 串)。返回 1 = 收了; 0 = 形状不对 (调用方当场拒, 别让它变成一颗
/// 永远比不上的钉子, 看起来却像"已经在验来源")。
fn net_pin_take(buf: ptr, av: u64, out: ptr) -> u32 {
    let n: u32 = sys_arg_len(av);
    if n != 64 {
        return 0;
    }
    let off: u32 = sys_arg_off(av);
    let i: u32 = 0;
    while i < 64 {
        let c: u32 = load8(buf, off + i);
        let l: u32 = c;
        if c >= 65 && c <= 70 {
            l = c + 32;
        } else if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
            return 0;
        }
        store8(out, i, l as u8);
        i = i + 1;
    }
    store8(out, 64, 0 as u8);
    return 1;
}

/// 从 p 的 [off, n) 取一个空白分隔的字段写进 out (cap)。
/// 返回 `(新起点 << 32) | 字段长度`; 长度 0 = 这一行没有这一段(调用方据此判失败)。
fn net_field(p: ptr, off: u32, n: u32, out: ptr, cap: u32) -> u64 {
    let i: u32 = txt_skip_ws(p, off, n);
    let st: u32 = i;
    let done: u32 = 0;
    while i < n && done == 0 {
        let c: u32 = load8(p, i);
        if c == 32 || c == 9 || c == 13 {
            done = 1;
        } else {
            i = i + 1;
        }
    }
    let ln: u32 = i - st;
    if ln >= cap {
        return 0;
    }
    let k: u32 = 0;
    while k < ln {
        store8(out, k, load8(p, st + k) as u8);
        k = k + 1;
    }
    store8(out, ln, 0 as u8);
    return ((i as u64 + 1) * 4294967296) + (ln as u64);
}

fn net_foff(v: u64) -> u32 { return (v / 4294967296) as u32; }
fn net_flen(v: u64) -> u32 { return (v % 4294967296) as u32; }

/// 取 `p` 最后一段(落盘时的文件名)。返回长度; 0 = 路径不合法。
fn net_basename(p: ptr, n: u32, out: ptr, cap: u32) -> u32 {
    let cut: u32 = 0;
    let i: u32 = 0;
    while i < n {
        if load8(p, i) == 47 {
            cut = i + 1;
        }
        i = i + 1;
    }
    let ln: u32 = n - cut;
    if ln == 0 || ln >= cap {
        return 0;
    }
    let k: u32 = 0;
    while k < ln {
        store8(out, k, load8(p, cut + k) as u8);
        k = k + 1;
    }
    store8(out, ln, 0 as u8);
    return ln;
}

/// 把注册表拉进 `dst`(一个**已经存在**的目录: `<root>/cache/<slug>`)。
/// 返回 1 = 全部下完且逐个**校验过索引里写着的 sha256**; 0 = 任一步不成;
/// 2 = 索引与 `--registry-sha256` 对不上 (**硬失败**, 调用方不许退回到打印计划)。
fn net_fetch_registry(req: ptr, dst: ptr) -> u32 {
    let base: ptr = txt_load64(req, NETREQ_BASE) as ptr;
    let blen: u32 = txt_len_cstr(base);
    let idx: ptr = txt_load64(req, NETREQ_IDX) as ptr;
    let idxcap: u32 = txt_load32(req, NETREQ_IDXCAP);
    let body: ptr = txt_load64(req, NETREQ_BODY) as ptr;
    let bodycap: u64 = txt_load32(req, NETREQ_BODYCAP) as u64;
    // **先作废上一轮的完成标记** (issue #378): 这一趟只要没走到最后, 目录里留下的就是
    // 0 字节标记, 消费方据此判"不完整"。写在开始而不是在每个失败分支里清, 是因为失败
    // 路径太多 (索引没来、索引行坏、摘要不对、写盘失败) —— 逐个清理总会漏一条。
    let _mk0: u32 = net_mark_write(dst, 0);
    let ipath: ptr = sys_alloc(1200);
    sys_copy(ipath, 0, base, 0, blen);
    let o1: u32 = sys_append_lit(ipath, blen, "lompi-index.txt");
    store8(ipath, o1, 0 as u8);
    let ilen: u64 = net_http_get(req, ipath, o1, idx, idxcap as u64);
    if ilen == NET_ERR {
        sys_write_str(2, "lompi: the registry did not answer -- falling back to the plan\n");
        return 0;
    }
    let name: ptr = sys_alloc(192);
    let ver: ptr = sys_alloc(128);
    let rel: ptr = sys_alloc(576);
    let sha: ptr = sys_alloc(128);
    let fpath: ptr = sys_alloc(1200);
    let fdir: ptr = sys_alloc(1200);
    let ffull: ptr = sys_alloc(1600);
    let st: ptr = sys_alloc(sha_state_size() as u64);
    let dig: ptr = sys_alloc(64);
    let hex: ptr = sys_alloc(128);
    // 带外钉住的索引哈希。有它, 信任根就在通道之外; 没有它, 下面那条逐个比只能是完整性
    // 检查 —— 这一点**说出来**, 而且把"怎么弄到钉子"一并说, 别让用户卡在
    // "--registry-sha256 是唯一提到它的地方" (issue #377)。
    let pin: ptr = txt_load64(req, NETREQ_PIN) as ptr;
    if pin != (0 as ptr) {
        sha_init(st);
        sha_update(st, idx, ilen as u32);
        sha_final(st, dig);
        sha_hex(dig, hex);
        if !txt_eq(hex, 0, 64, pin, 0, 64) {
            sys_write_str(2, "lompi: the index does not match --registry-sha256 -- refused\n");
            return 2;
        }
        sys_write_str(1, "lompi: index matches the pinned sha256\n");
    } else {
        sys_write_str(1, "lompi: (not pinned; hashes arrived over the same channel)\n");
        sys_write_str(1, "lompi: to pin it, get lompi-index.txt over a trusted channel and run `sha256sum`,\n");
        sys_write_str(1, "lompi: then pass the 64 hex digits as --registry-sha256 <hex> (docs/236 §7.1)\n");
    }
    let off: u32 = 0;
    let files: u32 = 0;
    while off < (ilen as u32) {
        let ll: u32 = txt_line_len(idx, off, ilen as u32);
        if ll > 0 && load8(idx, off) != 35 {
            let f0: u64 = net_field(idx, off, off + ll, name, 192);
            let f1: u64 = net_field(idx, net_foff(f0), off + ll, ver, 128);
            let f2: u64 = net_field(idx, net_foff(f1), off + ll, rel, 576);
            let f3: u64 = net_field(idx, net_foff(f2), off + ll, sha, 128);
            let nl: u32 = net_flen(f0);
            let vl: u32 = net_flen(f1);
            let rl: u32 = net_flen(f2);
            let sl: u32 = net_flen(f3);
            if nl == 0 || vl == 0 || rl == 0 || sl != 64 {
                sys_write_str(2, "lompi: bad index line (want: name version path sha256)\n");
                return 0;
            }
            sys_copy(fpath, 0, base, 0, blen);
            let g1: u32 = blen;              // 基路径已经以 `/` 收尾, 别再加一个
            let g2: u32 = sys_append_bytes(fpath, g1, rel, rl);
            store8(fpath, g2, 0 as u8);
            let got: u64 = net_http_get(req, fpath, g2, body, bodycap);
            if got == NET_ERR {
                sys_write_str(2, "lompi: no body for ");
                sys_write(2, rel, rl as u64);
                sys_write_str(2, "\n");
                return 0;
            }
            sha_init(st);
            sha_update(st, body, got as u32);
            sha_final(st, dig);
            sha_hex(dig, hex);
            if !txt_eq(hex, 0, 64, sha, 0, 64) {
                sys_write_str(2, "lompi: sha256 mismatch for ");
                sys_write(2, rel, rl as u64);
                sys_write_str(2, " -- refused\n");
                return 0;
            }
            let bn: u32 = net_basename(rel, rl, fdir, 576);
            if bn == 0 {
                sys_write_str(2, "lompi: bad path in index\n");
                return 0;
            }
            let dlen: u32 = txt_len_cstr(dst);
            sys_copy(ffull, 0, dst, 0, dlen);
            let q1: u32 = sys_append_sep(ffull, dlen);
            let q2: u32 = sys_append_bytes(ffull, q1, name, nl);
            let q3: u32 = sys_append_sep(ffull, q2);
            let q4: u32 = sys_append_bytes(ffull, q3, ver, vl);
            store8(ffull, q4, 0 as u8);
            sys_copy(fpath, 0, ffull, 0, q4);
            let q5: u32 = sys_append_sep(fpath, q4);
            let q6: u32 = sys_append_bytes(fpath, q5, fdir, bn);
            store8(fpath, q6, 0 as u8);
            let wn: u64 = sys_write_file(fpath, body, got);
            if wn == SYS_ERR {
                // `mkdir` 在 PE 上没有(与 `install --apply` 同一条边界): 建不了目录就说清
                // **要建哪个**, 而不是含糊地"写不了"。
                sys_write_str(2, "lompi: cannot write ");
                sys_write(2, fpath, q6 as u64);
                sys_write_str(2, "\nlompi: make it first:  mkdir -p ");
                sys_write(2, ffull, q4 as u64);
                sys_write_str(2, "\nlompi: (mkdir is not in the PE runtime -- docs/236)\n");
                return 0;
            }
            sys_write_str(1, "fetched ");
            sys_write(1, name, nl as u64);
            sys_write_str(1, " ");
            sys_write(1, ver, vl as u64);
            sys_write_str(1, " ");
            sys_write(1, fdir, bn as u64);
            sys_write_str(1, "  sha256 ok\n");
            files = files + 1;
        }
        let nxt: u32 = txt_next_line(idx, off, ilen as u32);
        if nxt <= off {
            off = ilen as u32;
        } else {
            off = nxt;
        }
    }
    if files == 0 {
        sys_write_str(2, "lompi: the index has no entries\n");
        return 0;
    }
    // 整份取齐了才写**完成令牌**。写不进去也不改变"取到了"这个事实, 但消费方会因此
    // 判不完整 —— 所以把这件事说出来, 而不是静默地留一个没有标记的目录。
    if net_mark_write(dst, 1) == 0 {
        sys_write_str(2, "lompi: fetched everything but could not write the completion marker\n");
    }
    return 1;
}

/// `fetch`: 把注册表拉进缓存。
///
/// **0.2.0 起它真的自己联网**(`docs/236`): 注册表是 `http://<IPv4>[:port][/path]` 时,
/// 直接 GET `<base>/lompi-index.txt`, 再按索引逐个下文件、**校验 sha256**、写进
/// `<root>/cache/<slug>/<name>/<version>/`。
///
/// **别的形状照旧打印计划**, 而且把理由写清楚(https 要 TLS、主机名要解析器) ——
/// 不含糊地说"做不到"。这不是 lompi 的设计立场, 是运行时的欠账: 0.1.5 那句是
/// "PE 上没有 socket", 现在是"没有 TLS / 没有解析器"(联网面补完了, `docs/234`)。
fn cmd_fetch(ws: ptr, buf: ptr, m: u32) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_OUT as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_OUT as u64 + 1024) as ptr;
    let cache: ptr = ((ws as u64) + WS_OUT as u64 + 2048) as ptr;
    let slug: ptr = ((ws as u64) + WS_OUT as u64 + 3072) as ptr;
    let reg: ptr = ((ws as u64) + WS_OUT as u64 + 3328) as ptr;
    let dst: ptr = ((ws as u64) + WS_OUT as u64 + 4352) as ptr;
    let sr: ptr = ((ws as u64) + WS_TMP as u64) as ptr;
    if cfg_exe_dir(buf, m, scr, exed, 1024) == 0 {
        return cli_die("cannot derive the executable directory from argv[0]");
    }
    let n: u32 = cfg_registry(ws, buf, exed, cfg_flag_arg(buf, m, "--registry"), reg, 1024, sr);
    if n == 0 {
        cli_die("no registry configured: pass --registry <url> or put a lompi.conf next to lompi.exe");
        return 1;
    }
    cfg_root(exed, scr, root, 1024);
    cfg_join(root, "cache", cache, 1024);
    cfg_slug(reg, n, slug, 256);
    let dn: u32 = txt_len_cstr(cache);
    sys_copy(dst, 0, cache, 0, dn);
    let o1: u32 = sys_append_sep(dst, dn);
    let o2: u32 = cli_put_cstr(dst, o1, slug);
    store8(dst, o2, 0 as u8);
    // 缓存状态**说出来** (issue #378): 没有完成标记的目录一律当"上一次没走完",
    // 这时 fetch 会整份重取 —— 而用户该知道重取是因为上一轮失败了, 不是因为这里"总是慢".
    if cli_exists(dst) {
        if net_mark_state(dst) == 1 {
            out_lit("lompi: this cache is marked complete; refreshing it\n");
        } else {
            out_lit("lompi: this cache is INCOMPLETE (the last fetch did not finish); re-fetching\n");
        }
    }
    // 带外的索引哈希 (issue #377): 形状不对当场拒 —— 一颗永远比不上的钉子会让人以为
    // "正在验来源", 那比没有钉子更糟。
    let pinav: u64 = cfg_flag_arg(buf, m, "--registry-sha256");
    let pin: ptr = 0 as ptr;
    if pinav != 0 {
        pin = sys_alloc(72);
        if net_pin_take(buf, pinav, pin) == 0 {
            return cli_die("--registry-sha256 wants exactly 64 hex characters");
        }
    }

    let ipa: ptr = sys_alloc(8);
    let ipb: ptr = sys_alloc(8);
    let ipc: ptr = sys_alloc(8);
    let ipd: ptr = sys_alloc(8);
    let pop: ptr = sys_alloc(8);
    let base: ptr = sys_alloc(1200);
    if net_parse_http(reg, n, ipa, ipb, ipc, ipd, pop, base, 1200) == 1 {
        let head: ptr = sys_alloc(1024);
        let idx: ptr = sys_alloc(65536);
        let body: ptr = sys_alloc((NET_FILE_CAP as u64) + 8192);
        let req: ptr = sys_alloc(NETREQ_SIZE as u64);
        txt_store64(req, NETREQ_SCR, scr as u64);
        txt_store64(req, NETREQ_HEAD, head as u64);
        txt_store64(req, NETREQ_BASE, base as u64);
        txt_store32(req, NETREQ_A, txt_load32(ipa, 0));
        txt_store32(req, NETREQ_B, txt_load32(ipb, 0));
        txt_store32(req, NETREQ_C, txt_load32(ipc, 0));
        txt_store32(req, NETREQ_D, txt_load32(ipd, 0));
        txt_store64(req, NETREQ_PORT, txt_load64(pop, 0));
        txt_store64(req, NETREQ_IDX, idx as u64);
        txt_store32(req, NETREQ_IDXCAP, 65536);
        txt_store64(req, NETREQ_BODY, body as u64);
        txt_store32(req, NETREQ_BODYCAP, NET_FILE_CAP + 8192);
        txt_store64(req, NETREQ_PIN, pin as u64);
        let bak: u32 = net_fetch_registry(req, dst);
        if bak == 1 {
            out_lit("lompi: registry fetched into ");
            sys_write(1, dst, txt_len_cstr(dst) as u64);
            out_lit("\n");
            return 0;
        }
        if bak == 2 {
            // 钉子对不上**不许**退回到"打印计划" —— 那是把一次拒绝装成一次成功。
            return 1;
        }
        out_lit("# the http fetch did not go through -- plan below\n");
    } else {
        out_lit("# lompi will not fetch this registry itself: only http:// with an IPv4 literal\n");
        out_lit("#   (https needs TLS; a hostname needs a resolver -- neither is in the toolchain)\n");
    }

    out_lit("# registry: ");
    sys_write(1, reg, n as u64);
    if load8(sr, 0) == 0 {
        out_lit("  (from --registry)\n");
    } else {
        out_lit("  (from lompi.conf)\n");
    }
    out_lit("mkdir -p ");
    sys_write(1, cache, dn as u64);
    out_lit("\n");
    out_lit("git clone --depth 1 ");
    sys_write(1, reg, n as u64);
    out_lit(" ");
    sys_write(1, dst, o2 as u64);
    out_lit("\n# to update later:  git -C ");
    sys_write(1, dst, o2 as u64);
    out_lit(" pull\n");
    out_lit("# (a cache cloned by hand has no completion marker; `lompi install` only uses\n");
    out_lit("#  a cache that `lompi fetch` finished -- docs/236 §7.2)\n");
    return 0;
}
/// 把一个包的源文件 (含可选的 pkg.lomp) 从 src 目录拷进 dst 目录。
/// 返回拷过去的文件数; 有任何一步失败返回 4294967295。
///
/// **不建目录** —— dst 必须已经存在。这是 PE 上没有 mkdir 的直接后果, 不是没做完:
/// 能写进已存在的目录, 建不了目录。所以 `--apply` 会先把缺的目录查出来报清楚。
fn cli_copy_pkg(ws: ptr, src: ptr, dst: ptr, scr: ptr, scr2: ptr) -> u32 {
    let file: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_NAMES as u64) as ptr;
    let ents: ptr = ((ws as u64) + WS_ENTS as u64) as ptr;
    let sn: u32 = txt_len_cstr(src);
    let dn: u32 = txt_len_cstr(dst);
    if sn == dn && txt_eq(src, 0, sn, dst, 0, dn) {
        return 0;                                  // 源与目标同一个目录, 没什么可做
    }
    let n: u32 = pkg_list_sources(ws, src);
    if n == DIR_ERR {
        return 4294967295;
    }
    let k: u32 = 0;
    while k < n {
        let o: u32 = dir_ent_name_off(ents, k);
        let l: u32 = dir_ent_name_len(ents, k);
        sys_join(scr, src, sn, ((names as u64) + (o as u64)) as ptr, l);
        let got: u64 = sys_read_file(scr, file, PKG_FILE_MAX as u64);
        if got == SYS_ERR || got > (PKG_FILE_MAX as u64) {
            return 4294967295;
        }
        sys_join(scr2, dst, dn, ((names as u64) + (o as u64)) as ptr, l);
        if sys_write_file(scr2, file, got) == SYS_ERR {
            return 4294967295;
        }
        k = k + 1;
    }
    // pkg.lomp 是可选标签文件, 一起带过去 —— 留着才知道这个包自称是什么
    let leaf: ptr = ((ws as u64) + WS_TMP as u64 + 7168) as ptr;
    txt_put(leaf, 0, "pkg.lomp");
    store8(leaf, 8, 0 as u8);
    sys_join(scr, src, sn, leaf, 8);
    let pg: u64 = sys_read_file(scr, file, 65536);
    if pg != SYS_ERR {
        sys_join(scr2, dst, dn, leaf, 8);
        if sys_write_file(scr2, file, pg) == SYS_ERR {
            return 4294967295;
        }
    }
    return n;
}

/// 命令行里有没有这个开关 (不带值的那种)。
pub fn cfg_has_flag(buf: ptr, m: u32, lit: str) -> bool {
    let ac: u32 = sys_arg_count(buf, m);
    let k: u32 = 2;
    while k < ac {
        if arg_is(buf, sys_arg_at(buf, m, k), lit) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// 第 i 个实例的目标目录 (NUL 结尾, 写进 dst)。
/// `--into DIR` -> `DIR\<名字>` (编译器 `use` 要的扁平形状);
/// 不给 -> `<全局库>\<名字>\<版本>`。
fn cli_dst_of(dst: ptr, buf: ptr, into: u64, store: ptr, ws: ptr, i: u32) {
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let o: u32 = 0;
    if into != 0 {
        let l: u32 = sys_arg_len(into);
        sys_copy(dst, 0, buf, sys_arg_off(into), l);
        o = l;
    } else {
        let sn: u32 = txt_len_cstr(store);
        sys_copy(dst, 0, store, 0, sn);
        o = sn;
    }
    store8(dst, o, sys_sep());
    o = o + 1;
    sys_copy(dst, o, names, pkg_name_off(ws, i), pkg_name_len(ws, i));
    o = o + pkg_name_len(ws, i);
    if into == 0 {
        store8(dst, o, sys_sep());
        o = o + 1;
        sys_copy(dst, o, names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
        o = o + pkg_ver_len(ws, i);
    }
    store8(dst, o, 0 as u8);
}

/// `--apply` 那一半: **真的把文件写过去**。
///
/// 先查目标目录在不在 —— lompi 建不了目录 (PE 上没有 mkdir), 所以缺就先一次性报清楚
/// 再拒, 而不是拷一半留下个半成品。目录由调用方建 (报错里直接给出 mkdir 命令)。
fn cli_apply(ws: ptr, np: u32, into: u64, buf: ptr, store: ptr) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let scr2: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let dst: ptr = ((ws as u64) + WS_REPORT as u64 + 4096) as ptr;
    let st: ptr = ((ws as u64) + WS_TMP as u64 + 7168) as ptr;
    let missing: u32 = 0;
    let i: u32 = 0;
    while i < np {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            cli_dst_of(dst, buf, into, store, ws, i);
            if !dir_stat_exists(dst, st) {
                missing = missing + 1;
            }
        }
        i = i + 1;
    }
    if missing > 0 {
        err_lit("[BAD] lompi: refusing --apply: target director(y/ies) do not exist.\n");
        err_lit("      lompi cannot mkdir on PE -- create them first:\n");
        i = 0;
        while i < np {
            if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
                cli_dst_of(dst, buf, into, store, ws, i);
                err_lit("      mkdir -p \"");
                sys_write(2, dst, txt_len_cstr(dst) as u64);
                err_lit("\"\n");
            }
            i = i + 1;
        }
        return 1;
    }
    i = 0;
    while i < np {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            cli_dst_of(dst, buf, into, store, ws, i);
            let c: u32 = cli_copy_pkg(ws, pkg_dir(ws, i), dst, scr, scr2);
            if c == 4294967295 {
                err_lit("lompi: copy failed into ");
                sys_write(2, dst, txt_len_cstr(dst) as u64);
                err_lit("\n");
                return 1;
            }
            out_lit("installed ");
            out_slice(names, pkg_name_off(ws, i), pkg_name_len(ws, i));
            out_lit("@");
            out_slice(names, pkg_ver_off(ws, i), pkg_ver_len(ws, i));
            out_lit(" -> ");
            sys_write(1, dst, txt_len_cstr(dst) as u64);
            out_lit("\n");
        }
        i = i + 1;
    }
    out_lit("[OK] lompi: installed\n");
    return 0;
}

/// `install <名字> [--into DIR]`: 就位 -> **校验** -> 身份 -> 落盘计划 (含拷贝命令)。
///
/// 来源 (按序): 缓存里克隆好的网址库 -> 全局库。目标: `--into DIR` 装成
/// `DIR\<名字>\`, 不给就**全局安装**到 `<全局根>\store\<名字>\<版本>\`。
fn cmd_install(ws: ptr, buf: ptr, m: u32, av_spec: u64) -> u32 {
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let exed: ptr = ((ws as u64) + WS_OUT as u64) as ptr;
    let root: ptr = ((ws as u64) + WS_OUT as u64 + 1024) as ptr;
    let cache: ptr = ((ws as u64) + WS_OUT as u64 + 2048) as ptr;
    let store: ptr = ((ws as u64) + WS_OUT as u64 + 3072) as ptr;
    let slug: ptr = ((ws as u64) + WS_OUT as u64 + 4096) as ptr;
    let reg: ptr = ((ws as u64) + WS_OUT as u64 + 4352) as ptr;
    let srcroot: ptr = ((ws as u64) + WS_OUT as u64 + 5376) as ptr;
    let sr: ptr = ((ws as u64) + WS_TMP as u64 + 512) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 1024) as ptr;
    let rep: ptr = ((ws as u64) + WS_REPORT as u64) as ptr;
    let dec: ptr = ((ws as u64) + WS_SCR2 as u64) as ptr;
    if cfg_exe_dir(buf, m, scr, exed, 1024) == 0 {
        return cli_die("cannot derive the executable directory from argv[0]");
    }
    cfg_root(exed, scr, root, 1024);
    cfg_join(root, "store", store, 1024);
    cfg_join(root, "cache", cache, 1024);
    let into: u64 = cfg_flag_arg(buf, m, "--into");

    // ---- 来源: 缓存里的网址库 -> 全局库
    let n: u32 = cfg_registry(ws, buf, exed, cfg_flag_arg(buf, m, "--registry"), reg, 1024, sr);
    let have_reg: u32 = 0;
    if n > 0 {
        cfg_slug(reg, n, slug, 256);
        let cn: u32 = txt_len_cstr(cache);
        sys_copy(srcroot, 0, cache, 0, cn);
        let g1: u32 = sys_append_sep(srcroot, cn);
        let g2: u32 = cli_put_cstr(srcroot, g1, slug);
        store8(srcroot, g2, 0 as u8);
        if cli_exists(srcroot) {
            // 装包这条路径**也在消费缓存** —— 它同样要认完成标记 (issue #378)。
            // 没有标记 / 标记是空的 = 上一轮取到一半断了: 里面可能有半写的文件, 不能装。
            if net_mark_state(srcroot) == 1 {
                have_reg = 1;
            } else {
                err_lit("lompi: the registry cache is incomplete (the last fetch did not finish)\n");
                err_lit("  run `lompi fetch` again before installing from it\n");
                return 1;
            }
        }
    }
    if have_reg == 0 {
        // +1: 结尾 NUL 也要抄。少抄一个字节, 路径后面就会拖着上一步写进去的
        // 网址库路径残字 (srcroot 先被当作缓存路径用过), sto_scan 于是报"没有包"——
        // 而这个分支恰恰是"配了网址库但还没克隆"时才会走到的。
        sys_copy(srcroot, 0, store, 0, txt_len_cstr(store) + 1);
    }

    let np: u32 = sto_scan(ws, srcroot);
    if np == 0 {
        if have_reg == 1 {
            cli_die("the fetched registry is empty or unreadable; run `lompi fetch` first");
        } else {
            cli_die("no packages found; is the global store populated?");
        }
        return 1;
    }
    let sp: u64 = spec_split(buf, av_spec);
    let idx: u32 = sto_find_bytes2(ws, np,
                                   ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                   spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
    if idx == PKG_NONE {
        cli_die("no such package in store");
        return 1;
    }

    // ---- 校验: 不是正确的 Loment 库就拒装, 并说清是哪一条不过
    let bad: u32 = pkg_check(ws, pkg_dir(ws, idx), rep, WS_REPORT_CAP);
    if bad != 0 {
        err_lit("[BAD] lompi: refusing to install -- not a valid Loment library:\n");
        sys_write(2, rep, txt_len_cstr(rep) as u64);
        return 1;
    }
    // pkg_check 用掉了列目录那套暂存, 身份要重算一次
    let np2: u32 = sto_scan(ws, srcroot);
    if idn_pass1(ws, np2) != np2 {
        return cli_die("some package in the store could not be hashed");
    }
    let r2: u32 = idn_pass2(ws, np2, msg, 256);
    if r2 != IDN_OK {
        // 仓库层面算不出身份: 报出来, 但**不因此拒绝** —— 要装的那一支可能是好的,
        // 让下面的锁/闭包检查去裁决, 免得一个坏包把整个仓库的安装都堵死。
        err_lit("# note: the store has packages that cannot be identified: ");
        if r2 == IDN_CYCLE {
            err_lit("dependency cycle\n");
        } else {
            err_lit("missing dependency `");
            sys_write(2, msg, txt_len_cstr(msg) as u64);
            err_lit("`\n");
        }
    }

    // ---- 闭包: `--from-lock` 按锁对实例, 否则按"版本最大"解析
    let stack: ptr = ((ws as u64) + WS_TMP as u64 + 2048) as ptr;
    let lockav: u64 = cfg_flag_arg(buf, m, "--from-lock");
    let from_lock: u32 = 0;
    let cl: u32 = 0;
    if lockav != 0 {
        let lbuf: ptr = ((ws as u64) + WS_FILE as u64) as ptr;
        let lpath: ptr = ((ws as u64) + WS_OUT as u64 + 6400) as ptr;
        sys_put_bytes(lpath, buf, sys_arg_off(lockav), sys_arg_len(lockav));
        let got: u64 = sys_read_file(lpath, lbuf, 65536);
        if got == SYS_ERR {
            return cli_die("cannot read the lock file");
        }
        let ln: u32 = pkg_lock_read(ws, lbuf, got as u32, np2, msg, 256);
        if ln == PKG_ERR {
            err_lit("lompi: lock does not match this store: ");
            sys_write(2, msg, txt_len_cstr(msg) as u64);
            err_lit("\n  (the locked instance is absent, or its identity changed)\n");
            return 1;
        }
        cl = ln;
        from_lock = 1;
    } else {
        let idx2: u32 = sto_find_bytes2(ws, np2,
                                        ((buf as u64) + (spec_name_off(sp) as u64)) as ptr,
                                        spec_name_len(sp), spec_ver_ptr(buf, sp), spec_ver_len(sp));
        cl = idn_closure(ws, np2, idx2, stack, 256, msg, 256);
        if cl == 4294967295 {
            err_lit("lompi: missing dependency in store: ");
            sys_write(2, msg, txt_len_cstr(msg) as u64);
            err_lit("\n");
            return 1;
        }
    }

    // ---- 落盘: 打出计划; `--apply` 时交给 cli_apply 真的写。
    // 目标目录必须已存在 —— PE 上没有 mkdir, cli_apply 会先一次性报清缺哪些再拒,
    // 而不是拷一半留下半成品。
    let names: ptr = ((ws as u64) + WS_SNAMES as u64) as ptr;
    let apply: bool = cfg_has_flag(buf, m, "--apply");
    let dstb: ptr = ((ws as u64) + WS_OUT as u64 + 7424) as ptr;
    out_lit("# lompi install plan\n");
    out_lit("# source:   ");
    sys_write(1, srcroot, txt_len_cstr(srcroot) as u64);
    if have_reg == 1 {
        out_lit("  (cached registry)\n");
    } else {
        out_lit("  (global store)\n");
    }
    out_lit("# closure:  ");
    if from_lock == 1 {
        out_lit("from the lock file -- every entry checked against this store\n");
    } else {
        out_lit("resolved by highest version\n");
    }
    out_lit("# dest:     ");
    if into != 0 {
        out_lit("--into <DIR> -> DIR\\<name>\\ (flat, as the compiler expects)\n");
    } else {
        out_lit("global store -> <global>\\store\\<name>\\<version>\\\n");
    }
    out_lit("mkdir -p ");
    if into != 0 {
        sys_write(1, ((buf as u64) + (sys_arg_off(into) as u64)) as ptr, sys_arg_len(into) as u64);
    } else {
        sys_write(1, store, txt_len_cstr(store) as u64);
    }
    out_lit("\n# ");
    out_dec(dec, cl as u64);
    out_lit(" package instance(s):\n");
    let i: u32 = 0;
    while i < np2 {
        if (pkg_flags(ws, i) & PKG_F_INCLOSURE) != 0 {
            cli_dst_of(dstb, buf, into, store, ws, i);
            out_lit("cp -r ");
            sys_write(1, pkg_dir(ws, i), txt_len_cstr(pkg_dir(ws, i)) as u64);
            out_lit(" ");
            sys_write(1, dstb, txt_len_cstr(dstb) as u64);
            out_lit("\n");
        }
        i = i + 1;
    }
    if apply {
        return cli_apply(ws, np2, into, buf, store);
    }
    out_lit("# nothing was written: re-run with --apply to materialize (target dirs must exist)\n");
    return 0;
}

// ---------------------------------------------------------------- 自检

fn test_cli_spec_split_with_version() -> bool {
    let b: ptr = alloc(128);
    sys_put_lit(b, "geom@1.0.0");
    let av: u64 = 0;
    let sp: u64 = spec_split(b, av + 10);
    return spec_name_off(sp) == 0 && spec_name_len(sp) == 4 && spec_ver_len(sp) == 5;
}

fn test_cli_spec_split_without_version() -> bool {
    let b: ptr = alloc(128);
    sys_put_lit(b, "mathutil");
    let av: u64 = 0;
    let sp: u64 = spec_split(b, av + 8);
    return spec_name_off(sp) == 0 && spec_name_len(sp) == 8 && spec_ver_len(sp) == 0;
}

fn test_cli_verify_sees_identical_lock() -> bool {
    // resolve 与 verify 是一对: 同一棵仓库重算出来的锁必须逐字节一样。
    // 这里直接比两次 build_lock 的输出 (免去写临时文件 —— PE 上写文件要真路径)。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let rep: ptr = R(ws);
    sys_put_lit(scr, "fixture/store");
    let n: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n);
    if idn_pass2(ws, n, msg, 128) != IDN_OK {
        return false;
    }
    let root: u32 = sto_find(ws, n, "geom", "");
    let o1: u32 = build_lock(ws, n, root);
    let first: ptr = sys_alloc(4096);
    sys_copy(first, 0, rep, 0, o1);
    // 重扫一遍再算
    let n2: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n2);
    if idn_pass2(ws, n2, msg, 128) != IDN_OK {
        return false;
    }
    let root2: u32 = sto_find(ws, n2, "geom", "");
    let o2: u32 = build_lock(ws, n2, root2);
    return o1 == o2 && txt_eq(first, 0, o1, rep, 0, o2);
}

fn test_cli_lock_has_one_line_per_instance() -> bool {
    // geom 的闭包是 2 个实例 -> 锁里除表头外应当正好 2 行。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let rep: ptr = R(ws);
    sys_put_lit(scr, "fixture/store");
    let n: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n);
    idn_pass2(ws, n, msg, 128);
    let root: u32 = sto_find(ws, n, "geom", "");
    let o: u32 = build_lock(ws, n, root);
    let i: u32 = 0;
    let lines: u32 = 0;
    while i < o {
        if load8(rep, i) == 10 {
            lines = lines + 1;
        }
        i = i + 1;
    }
    return lines == 3;   // 表头 + 2 行
}

fn test_cli_diamond_dedups_to_one_instance() -> bool {
    // 菱形: diamond 同时 `use geom` 与 `use mathutil`, 而 geom 也依赖 mathutil。
    // 闭包里 mathutil 必须**只出现一次** —— 同一个实例摊两遍是错的 (它会让
    // "闭包里有几个包"这个数骗人)。夹具: fixture/store_diamond。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    let rep: ptr = R(ws);
    sys_put_lit(scr, "fixture/store_diamond");
    let n: u32 = sto_scan(ws, scr);
    if n != 3 {
        return false;
    }
    idn_pass1(ws, n);
    if idn_pass2(ws, n, msg, 128) != IDN_OK {
        return false;
    }
    let root: u32 = sto_find(ws, n, "diamond", "");
    let o: u32 = build_lock(ws, n, root);
    // 表头 + 3 个实例 = 4 行; mathutil 摊了两遍就会是 5 行。
    let i: u32 = 0;
    let lines: u32 = 0;
    while i < o {
        if load8(rep, i) == 10 {
            lines = lines + 1;
        }
        i = i + 1;
    }
    return lines == 4;
}

fn test_cli_tree_diamond_shares_same_geom_identity() -> bool {
    // 同一份 geom 源码, 在这个仓库里绑到 mathutil 0.1.0 -> 身份与 fixture/store
    // 里那份不同。这条把"身份含依赖的绑定"从 CLI 这一层再钉一次。
    let ws: ptr = sys_alloc(ws_size() as u64);
    let scr: ptr = ((ws as u64) + WS_SCR as u64) as ptr;
    let msg: ptr = ((ws as u64) + WS_TMP as u64 + 4096) as ptr;
    sys_put_lit(scr, "fixture/store_diamond");
    let n: u32 = sto_scan(ws, scr);
    idn_pass1(ws, n);
    if idn_pass2(ws, n, msg, 128) != IDN_OK {
        return false;
    }
    let g: u32 = sto_find(ws, n, "geom", "");
    if g == PKG_NONE {
        return false;
    }
    // fixture/store 里 geom 绑的是 mathutil 0.2.0, 身份前缀是 06b4cc0d3b1f136f
    return txt_eq_lit(pkg_id_hex(ws, g), 0, 16, "0f4bb3784d09714d");
}

pub fn selftest_cli() -> u32 {
    let f: u32 = 0;
    if !test_cli_spec_split_with_version() { f = f + 1; sys_write_str(1, "  FAIL cli_spec1\n"); }
    if !test_cli_spec_split_without_version() { f = f + 1; sys_write_str(1, "  FAIL cli_spec2\n"); }
    if !test_cli_verify_sees_identical_lock() { f = f + 1; sys_write_str(1, "  FAIL cli_lockstable\n"); }
    if !test_cli_lock_has_one_line_per_instance() { f = f + 1; sys_write_str(1, "  FAIL cli_locklines\n"); }
    return f;
}
