// loment/tools/lvm.lomt — LVM 的**自举镜像**：那份 IR 的第四个读者（docs/243）
//
// 判据（tools/lvm_twin_test.py）：同一份 `.ll` 喂**两边** —— 参考实现
// （`tools/lvm.py --ir`）与本程序（走自举链编成 ELF 后跑）—— **stdout 字节 + 退出码
// 相同**。与 `lomelf`/`lomelf.lomt` 那一对是**两种活**：那一格比的是产出的 ELF
// **逐字节**，这一格比的是**跑出来的行为** —— 所以这里**不必逐行镜像**参考实现的写法，
// 结构按 Loment 能花的钱来（没有字典、没有动态分配，全用固定表）。
//
// CLI:  lvm IN.ll [sw_cap]   （只吃 IR：Loment 侧没有前端，前端在 driver）
// 退出码 = 被解释程序自己的退出码；输入读不了 / 解析不了 = 2（与参考实现的 main 同）
// `sw_cap`（`docs/371`）：任意附加实参等于它就在 T0 上开对象表检查。故障退出码
// `100 + kind`，站点与 `llvm.trap` 同形。自举侧是**按地址**的（没有 SSA 能力表）。
//
// 与参考实现的关系（`docs/243` §2 那张表）：**整段跳过**的是 x86 编码、`Asm`、
// SSA→栈槽、重定位、ELF/PE 写出 —— 那些 Python 侧也一个都不用。留下的是**语言语义**：
// 按宽度截断、零/符号扩展、phi 取**前驱块**那一支的值。
//
// 已知边界（**点名拒**，不静默错算 —— 与 `lomelf.lomt` 同一条纪律）：
//   * `atomicrmw`：参考实现支持 `add`，这一份**没实现**（语料里 0 次）。宁可用不了，
//     不要算错 —— 真被喂到会报"这个指令 T0 没实现"。
//   * 间接调用（`call %x(...)`）：参考实现也拒（它的正则只认 `@name`）。
//   * 浮点 / `select` / `bitcast`：整条子集里没有（`lomelf.py` 头注那份子集清单）。
//   * `shl`/`lshr`/`ashr`/`and`/`or`/`xor` 实现了，但**语料里 0 次** —— 孪生判据覆盖不到，
//     记账在此。
//
// ---------------------------------------------------------------- 自举子集备忘
//
// ① `const` 的初值只吃**字面量**（`4 * 1024 * 1024` 解析不过）—— 所以下面每个数后面
//    都注明它是怎么算出来的；② **没有 `break`**，早退只能靠标志位或 `return`；
// ③ `x as u64 << 32` 会被读成泛型实参 `u64<…>`，必须写 `((x as u64) << 32)`；
// ⑤ 移位 / 比较 / 减法：**两边位宽必须一致**（`u64 << u32` 发出来的 IR，clang 直接拒：
//    `'%t' defined with type 'i32' but expected 'i64'`）。**参考实现也有这个毛病** ——
//    只是平时没人拿 clang 编过这种代码（`lomelf` 是宽松的，照收）。所以下面每个
//    `u64` 的移位量都显式 `as u64`。见 issue #316（这条与 `bool != bool` 那条都在里面）。
// ④ **没有模块级 `let`**（顶层只有 `module`/`use`/`choose`/`const`/`fn`）—— 所以
//    「可变状态」一律落在 arena 头部那 256 字节的格区里（照 `lomelf.lomt` 的做法）。

module lvm
choose runtime

use bytes

// ---------------------------------------------------------------- 表容量
//
// 固定表 + 超了**点名报错**（不是静默写坏邻表 —— 那个教训见 docs/200）。
// 下面的数**按语料实测取余量**（`lument_elf_test.CORPUS` 的最大值写在括号里）：
//   全局 37 · 函数 281 · 形参/函数 ≤10 · 块/函数 ≤139 · 指令全程序 ≤10659 · 调用深度 10
const MAX_GLOBALS: u32 = 256;        // (37)
const MAX_FUNCS: u32 = 512;          // (281)
const MAX_PARAMS: u32 = 2048;        // (每函数 ≤10)
const MAX_BLOCKS: u32 = 8192;        // (每函数 ≤139)
const MAX_INSTRS: u32 = 32768;       // (全程序 ≤10659)
const MAX_EDGES: u32 = 65536;        // 全程序的边（每条 br 1-2 条、switch N+1 条）
const MAX_VALS: u32 = 1024;          // 一帧里同时活着的 SSA 名 (每函数 ≤227)
const MAX_DEPTH: u32 = 32;           // 调用深度 (实测 10)

// VM 自己的地址空间（地址 = 这块里的**下标**，与参考实现的 `Mem` 同口径）
const MEM_SIZE: u32 = 4194304;
const GLOBAL_BASE: u32 = 65536;      // 全局从这儿往上放
//: 堆的上限 = 栈底 —— 帧占 [MEM_SIZE - MAX_DEPTH*FRAME_SIZE, MEM_SIZE)，堆不许越过去。
const STACK_LIMIT: u32 = 3145728;    // 4194304 - 32 * 32768

//: 每层调用一段自己的栈区（**按深度算基址**）。参考实现第一版每层都取同一段，
//: 于是被调者的 alloca 覆盖调用者的槽 —— 见 `lvm.py` `run` 里那段注释。
const FRAME_SIZE: u32 = 32768;

//: 每张记录的字节数
const GLOBAL_REC: u32 = 24;          // name_off,name_len,ty_off,ty_len,init_off,init_len
const FUNC_REC: u32 = 32;            // name_off,name_len,ret_off,ret_len,nparams,first_param,first_block,nblocks
const PARAM_REC: u32 = 16;           // ty_off,ty_len,name_off,name_len
// T1（`docs/247`）：块记录多一格 `count`（这一块被进过几次）。
const BLOCK_REC: u32 = 20;           // label_off,label_len,first_instr,ninstrs,count
// T1：指令记录多两格 —— 这条分支的边在边表里的**起点**与**条数**。
// 边表按解析期一次分好（每条 br/switch 的边数静态可知），于是运行时记一条边是
// `E_OFF + (first_edge + edge) * 4`，**O(1)**，不用查表。
const INSTR_REC: u32 = 32;           // dest_off,dest_len,text_off,text_len,kind,sub,first_edge,nedges
const EDGE_REC: u32 = 4;             // 一条边一个计数；边号 = 行号 - first_edge
const VAL_REC: u32 = 16;             // name_off,name_len,vlo,vhi   (u64 拆两半：没有 load64)

//: 帧内布局（相对帧基址）
//
// 一个 SSA 名 → 一个值。标量存 u64（拆两半）；聚合存**一段可读地址**（VM 地址）。
// 「是标量还是聚合」不存 —— 每个使用点上指令文本里写着类型，用不着问值本身。
const FR_NV: u32 = 0;                // 值个数
const FR_NEXT: u32 = 4;              // 槽/聚合 bump（帧内偏移）
const FR_VALS: u32 = 8;              // 值表起点
const FR_INIT: u32 = 16384;          // T2：槽的"写过没有"位图（1024 位 = 128 字节）
const FR_SLOTS: u32 = 16520;         // 8 + 1024 * 16 + 128 —— 槽/聚合区起点

//: 指令种类（解析期算好，存在记录里 —— 求值期别再逐字比）
const K_ALLOCA: u32 = 1;
const K_LOAD: u32 = 2;
const K_STORE: u32 = 3;
const K_GEP: u32 = 4;
const K_EXTRV: u32 = 5;
const K_INSV: u32 = 6;
const K_ICMP: u32 = 7;               // sub = 谓词码
const K_SDIV: u32 = 8;
const K_UDIV: u32 = 9;
const K_SREM: u32 = 10;
const K_UREM: u32 = 11;
const K_ADD: u32 = 12;
const K_SUB: u32 = 13;
const K_MUL: u32 = 14;
const K_AND: u32 = 15;
const K_OR: u32 = 16;
const K_XOR: u32 = 17;
const K_SHL: u32 = 18;
const K_LSHR: u32 = 19;
const K_ASHR: u32 = 20;
const K_TRUNC: u32 = 21;
const K_ZEXT: u32 = 22;
const K_SEXT: u32 = 23;
const K_PTRTOINT: u32 = 24;
const K_INTTOPTR: u32 = 25;
const K_CALL: u32 = 26;
const K_UNREACH: u32 = 27;
const K_PHI: u32 = 28;
const K_BR_UNCOND: u32 = 29;         // sub = 目标块号
const K_BR_COND: u32 = 30;           // sub = (真块号 << 16) | 假块号
const K_SWITCH: u32 = 31;
const K_RET: u32 = 32;
const K_ASMCALL: u32 = 33;

//: icmp 谓词码（顺序与 `lvm.py` 的 `_ICMP` 同；≥6 的这四个是**有符号**）
const P_EQ: u32 = 0;
const P_NE: u32 = 1;
const P_UGT: u32 = 2;
const P_UGE: u32 = 3;
const P_ULT: u32 = 4;
const P_ULE: u32 = 5;
const P_SGT: u32 = 6;
const P_SGE: u32 = 7;
const P_SLT: u32 = 8;
const P_SLE: u32 = 9;

//: 「没有」的哨兵（块号 / 函数号 / 帧）
const NONE: u32 = 4294967295;

//: 指令条数上限。**不是性能护栏，是"不许挂死"** —— 解释器进了死循环就得自己回来。
//: 语料里最重的一份（`lumtui_demo`）实测远在这之下；真撞上会**点名报**出当前函数与指令。
const STEP_CAP: u32 = 50000000;

//: **零页**：VM 地址 [0, GLOBAL_BASE) 永不分配（`vm_alloc` 从 `GLOBAL_BASE` 起），
//: 所以它恒为 0，可以直接当 `undef` / `null` 聚合值的字节来源 —— **读一次就被拷走**，
//: 不用为它分配任何东西。第一版给它每用一次分配一格，于是"循环体里有个 `undef` 聚合"
//: 变成了"每一轮吃一格帧"，`tour` 那一档在第 1023 轮把 32 KiB 的帧吃光。
const ZERO_ADDR: u32 = 0;
const ZERO_CAP: u32 = 65536;         // 零页大小 = GLOBAL_BASE

// ---------------------------------------------------------------- arena 布局
//
// 一块 arena 摆四样东西：输入文本 / VM 的内存 / 五张表 / argv。全部用**常量偏移**。
//
//   SRC  0         .. 4194304   输入 IR 文本（地址 = 输入里的偏移）
//   MEM  4194304   .. 8388608   VM 地址空间（地址 = 这一段的**下标**）
//   TAB  8388608   .. 9361408   五张表
//   ARGV 9361408   .. 9384192   /proc/self/cmdline 的落脚点
const SRCCAP: u32 = 4194304;
const MEM_OFF: u32 = 4194304;
//: 五张表的起址（后面每个数都注明算式）
const G_OFF: u32 = 8388608;                  // TAB
const F_OFF: u32 = 8394752;                  // + 256*24
const P_OFF: u32 = 8411136;                  // + 512*32
const B_OFF: u32 = 8443904;                  // + 2048*16
const I_OFF: u32 = 8607744;                  // + 8192*20
const E_OFF: u32 = 9656320;                  // + 32768*32
const ARGV_OFF: u32 = 9918464;               // + 65536*4
//: 格区**不能在 0** —— 输入文本就从 0 起，两者会打架。第一版把格区放在 arena 头 256 字节，
//: 于是 `read_file` 一读进来 ① 把输入的前 32 字节踩成格子的值、② 之后每次 `ctx_set`
//: 又踩一次；症状是解析器在垃圾上乱跑（报"全局表满了"）。格区挪到 ARGV 之后，
//: **arena 偏移 = 输入文本偏移**这条等式才成立（全篇的 span 都靠它）。
const CTX_OFF: u32 = 9934848;                // + 16384
const ARENA: u64 = 9935104;                  // + 256

// ---------------------------------------------------------------- 格区
//
// arena 头 256 字节里的格子（照 `lomelf.lomt`）。**没有模块级 `let`**，所以可变的
// 全局状态只能落在这儿。
const C_NSRC: u32 = 0;               // 输入字节数
const C_NG: u32 = 4;                 // 全局条数
const C_NF: u32 = 8;                 // 函数条数
const C_NP: u32 = 12;                // 形参条数
const C_NB: u32 = 16;                // 基本块条数
const C_NI: u32 = 20;                // 指令条数
const C_HEAP: u32 = 24;              // VM 堆游标
const C_DEPTH: u32 = 28;             // 当前调用深度
const C_STEPS: u32 = 96;             // 已经执行了多少条指令（见 STEP_CAP）
//: T1：剖面写到哪个 fd。**0 = 关**（0 号是 stdin，写剖面拿到的一定 ≥ 3）。
const C_PROF_FD: u32 = 104;
const C_NEDGE: u32 = 108;           // 边表已经用掉多少行

//: T0（`docs/243` §3.4）：VM **合成**的 `/proc/self/cmdline` 在哪儿。
//: 内容是**被解释程序自己的**命令行 —— 就是解释器被指到的那个输入路径，原样，后跟一个
//: NUL（内核给真进程的形状就是这样）。它本来就在 `ARGV` 区里躺着（那里装的是**解释器**
//: 自己的 cmdline，字段之间已经是 NUL 分隔），所以这里只记"起点在区里的偏移"与"连同末尾
//: NUL 的长度"—— 一个字节都不用搬。
const C_ARG0: u32 = 112;             // 输入路径在 ARGV 区里的偏移
const C_ARG0N: u32 = 116;            // 它连同末尾那个 NUL 的长度
const C_VFD_POS: u32 = 120;          // 合成文件的读游标
const C_VFD_OPEN: u32 = 124;         // 合成文件开着没有（0 = 没开）
//: 合成文件的 fd 号。**两边实现必须给同一个数**（`tools/lvm.py` 的 `VFD_BASE`）。
const VFD: u64 = 1000;

// ---------------------------------------------------------------- sw_cap（docs/371）
//
// 参考实现的 `SwCap` 落的是「对象表 + 能力 + 对象代」。自举侧没有 SSA 能力表
// （`VAL_REC` 只有 16 字节），所以这一份是**按地址**的那一半：每个地址问一句
// 「你归哪块对象」。换来的是同一套故障码、退出码与站点（`docs/360` B7）。
const C_SUB: u32 = 172;              // 1 = sw_cap 开着
const C_SITE_FI: u32 = 176;          // 当前函数下标（故障站点）
const C_SITE_BI: u32 = 180;          // 当前块下标
const C_SITE_J: u32 = 184;           // 块内指令序号
const C_PRIV: u32 = 188;             // __loment_* 的深入层数（特权帧）
const C_NOBJ: u32 = 192;             // 活对象条数
const C_NFOBJ: u32 = 196;            // 帧对象栈顶
const C_NRET: u32 = 200;             // 已归还对象条数
//: 绑定一次调用时写下的事件（`bind_call` -> 调用者读取）。
const C_BIND_PRIV: u32 = 204;
const C_BIND_HOOK: u32 = 208;        // 0 = 无、1 = __loment_alloc、2 = __loment_free
const C_BIND_A0LO: u32 = 212;
const C_BIND_A0HI: u32 = 216;
//: checkpoint（`docs/364`）：显式栈引擎的游标与快照参数。
const C_MODE: u32 = 220;             // 1 = 显式栈引擎
const C_CB: u32 = 224;               // 当前块（快照用；与续延记录同步）
const C_CJ: u32 = 228;               // 当前块内序号
const C_CPREV: u32 = 232;            // phi 的前驱块
const C_CFR: u32 = 236;              // 当前帧基址
const C_RO: u32 = 240;               // 聚合返回值的落点（本帧）
const C_RL: u32 = 244;
const C_CKPT_AT: u32 = 248;          // >0：在第这么多条指令之前停住
const C_IFHASH: u32 = 252;           // 输入文本的 FNV-1a（快照绑定字节码）

//: 对象表从 T2 表之后起（旧 `ARENA_T2` = 14137600）。排序数组 + 二分。
const OBJ_OFF: u32 = 14137600;
const MAX_OBJS: u32 = 4096;
//: 归还表：最近 1024 条（只为「裸地址回查」留一个有限窗口，与参考同一条纪律）。
const RET_OFF: u32 = 14219520;       // OBJ_OFF + 4096 * 20
const MAX_RET: u32 = 1024;
//: 帧对象栈：登记 alloca / 聚合暂存的**基址**，返回时按深度退掉。
const FOBJ_OFF: u32 = 14240000;      // RET_OFF + 1024 * 20
const MAX_FOBJ: u32 = 4096;
//: 每层深度的帧对象栈起点（MAX_DEPTH + 1 格）。
const FBASE_OFF: u32 = 14256384;     // FOBJ_OFF + 4096 * 4
//: checkpoint（`docs/364`）：每层一帧的续延记录，16 个 u32（64 字节）。
const CONT_OFF: u32 = 14256516;      // FBASE_OFF + 33 * 4
const CONT_REC: u32 = 16;
const MAX_CONT: u32 = 33;            // MAX_DEPTH + 1
const CONT_END: u32 = 14258628;      // CONT_OFF + 33 * 64
//: 快照头 16 字节 + 数字暂存。头：magic(4) / version / irhash / 保留。
const SNAP_HDR: u32 = 14258628;
const WNUM_SCRATCH: u32 = 14258660;  // SNAP_HDR + 32（只在报错时写 1 字节）
//: 恢复扩展里的名字暂存（最多 240 字节；扩展在**内存读完之后**，不能借 `m`）。
const NAME_SCRATCH: u32 = 14258692;  // SNAP_HDR + 64
//: `sw_tag`（`docs/364`）：对象标签并行数组（下标 = 对象表下标）+ 每帧值的
//: 「能力（对象基址, 标签）」表。两块都**追加在旧 arena 末尾之后**，所以既有偏移
//: 一个都不用挪；arena 的分配量随之涨到 `CAP_END`。
const TAG_OFF: u32 = 14982148;       // = ARENA_T2（旧 arena 末尾）
const CAP_OFF: u32 = 14998532;       // TAG_OFF + MAX_OBJS * 4
const CAP_SLOTS: u32 = 32768;        // MAX_DEPTH * MAX_VALS
const CAP_END: u32 = 15260676;       // CAP_OFF + CAP_SLOTS * 8
//: 指针存进内存之后的影子表（参考实现的 `SwCap.shadow`）：`addr / 对象基址 / 标签`。
//: 环形缓冲，查是从最新往回扫 —— 同一个槽被反复写时旧条目不会先被看到。
const SH_OFF: u32 = 15260676;        // = CAP_END
const SH_CAP: u32 = 4096;
const SH_END: u32 = 15309828;        // SH_OFF + SH_CAP * 12
//: 格表（`docs/375` §2.3）：dismemory 的体**不再是连续字节数组**，内容在一张
//: 开放寻址表里。每条 4 个 u32：体号、物理格号、字节、状态（0 空 / 1 用 / 2 墓碑）。
//: 逻辑格号加每颗体的摆法再取模才是物理格号 —— 换摆法只换桶，不换可观察量。
const CT_OFF: u32 = 15309828;        // = SH_END
const MAX_CT: u32 = 262144;          // 256 KiB 的非零字节（写 0 = 墓碑，退休时清扫）
const CT_END: u32 = 19504132;        // CT_OFF + MAX_CT * 16
//: 系统调用把格里的字节搬进/搬出时用的宿主暂存（不落在 guest 的地址空间里）。
const IOS_OFF: u32 = 19504132;       // = CT_END
const IOS_CAP: u32 = 65536;
const IOS_END: u32 = 19569668;       // IOS_OFF + IOS_CAP
const C_TAGSEQ: u32 = 64;           // 标签轮转序列（1 + seq % 15）
const C_SHN: u32 = 68;              // 影子表写了几条（环形下标 = 它 % SH_CAP）
const C_DSH: u32 = 72;              // 表示层摆法（`docs/375` §2.3；0 = 规范）

const OBJ_GLOBAL: u32 = 1;
const OBJ_BRK: u32 = 2;
const OBJ_ALLOCA: u32 = 3;
const OBJ_HEAP: u32 = 4;

fn ctx_get(a: ptr, k: u32) -> u32 {
    return load32(a, CTX_OFF + k);
}

fn ctx_set(a: ptr, k: u32, v: u32) {
    store32(a, CTX_OFF + k, v);
}

// ---------------------------------------------------------------- 运行时
//
// 与 `lomelf.lomt` 逐字同源的那几个：`die`/`sys_alloc`/`read_all`/`write_all`/`wstr`/
// `fail`/`cstr`/`argv_n`。**它们是解释器自己的系统调用**，不是被解释程序的 —— 后者走
// `vm_syscall` 那张表（`docs/243` §3.4）。

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn fail(msg: str) -> u32 {
    wstr(2, "lvm: ");
    wstr(2, msg);
    wstr(2, "\n");
    return die(2);
}

/// 带**原文**的报错。参考实现也是这么报的（`读未定义的值 %t7`）—— 只说"有个东西没定义"
/// 就得回去自己数第几行，那不是一条能用的报错。
fn fail_tok(a: ptr, msg: str, off: u32, len: u32) -> u32 {
    wstr(2, "lvm: ");
    wstr(2, msg);
    wstr(2, " ");
    if off + len <= SRCCAP {
        write_all(2, ptr_add(a, off), len as u64);
    }
    wstr(2, "\n");
    return die(2);
}

//: 读整个文件进 dst，返回读到的字节数；**打不开回 -1**（`#718`）。
//: 用 `open`(2) 而不是 `openat`(257)：前者参数少一格，`syscall4` 正好装得下。
//:
//: **0 是一个合法的字节数**（空文件），不能兼作错误码。从前两者共用 0，于是一份 0 字节的
//: IR 被报成"读不了输入" —— 它读得了，只是里面没有 `_start`（同一条路径上 T0/T2 一直报对，
//: 差别就在这句判断）。错误码要**分开**：那是"读不到"与"读到了、是空的"两件事。
fn read_file(path: ptr, dst: ptr, cap: u64) -> i64 {
    let fd: i64 = syscall4(2, path as u64, 0, 0);
    if fd < 0 {
        return 0 - 1;
    }
    let got: u64 = read_all(fd as u64, dst, cap);
    syscall4(3, fd as u64, 0, 0);
    return got as i64;
}

fn cstr(dst: ptr, s: str) -> ptr {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return dst;
}

/// 第 n 个 argv (0 = 程序名) 的 (起点 << 32) | 长度。
fn argv_n(buf: ptr, cap: u64, n: u32) -> u64 {
    let fd: i64 = syscall4(257, (0 as u64) - 100,
                           cstr(ptr_add(buf, 8192), "/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return 0;
    }
    let rn: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if rn <= 0 {
        return 0;
    }
    let m: u32 = rn as u32;
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    let hit: u64 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == n {
                hit = ((s as u64) << 32) | ((i - s) as u64);
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    if f == n {
        hit = ((s as u64) << 32) | ((m - s) as u64);
    }
    return hit;
}

// ---------------------------------------------------------------- 文本
//
// 记号字符。`-` 要算进来：LLVM IR 的立即数允许负号（`and i32 %x, -8`）。少了它，
// `-8` 会被量成长度 0 —— 那个坑 `lomelf.lomt` 上已经踩过一次（见那里的注释）。
// `@` `%` 也要算进来：操作数跨度靠它量（`@.str._start.0`、`%t12`）。
fn is_word(c: u32) -> bool {
    if c >= 97 && c <= 122 {
        return true;
    }
    if c >= 65 && c <= 90 {
        return true;
    }
    if c >= 48 && c <= 57 {
        return true;
    }
    return c == 95 || c == 46 || c == 64 || c == 37 || c == 45;
}

fn is_sp(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn skip_sp(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        if is_sp(load8(t, j)) {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

fn word_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        if is_word(load8(t, j)) {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

/// 从 i 起跳空白，认一个记号，返回 (起点 << 32) | 长度。
fn wspan(t: ptr, i: u32, n: u32) -> u64 {
    if ctx_get(t, C_EXEC) == 1 { ctx_set(t, C_MISS, ctx_get(t, C_MISS) + 1); }
    let s: u32 = skip_sp(t, i, n);
    let e: u32 = word_end(t, s, n);
    return ((s as u64) << 32) | ((e - s) as u64);
}

/// 去掉首尾空白，返回 (起点 << 32) | 长度。
fn trim_span(t: ptr, s: u32, e: u32) -> u64 {
    let i: u32 = s;
    let j: u32 = e;
    while i < j && is_sp(load8(t, i)) {
        i = i + 1;
    }
    while j > i && is_sp(load8(t, j - 1)) {
        j = j - 1;
    }
    return ((i as u64) << 32) | ((j - i) as u64);
}

/// 跳过指令文本的第一个词（算子），返回其后第一个非空白处。
/// **不写死算子长度** —— `getelementptr` 是 13 个字符不是 12，写错了不会报错，
/// 只会把算子尾巴当成类型读（`r`），然后在 GEP 上报"这一步没实现"。这类错一个都不要。
fn after_op(a: ptr, io: u32, e: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let w: u64 = wspan(a, io, e);
    return skip_sp(a, hi32(w) + lo32(w), e);
}

fn lo32(v: u64) -> u32 {
    return v as u32;
}

fn hi32(v: u64) -> u32 {
    return (v >> 32) as u32;
}

/// 两块文本（可不同基址）是否逐字节相同。
fn same(a: ptr, ao: u32, b: ptr, bo: u32, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, ao + i) != load8(b, bo + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// 输入文本里 [off, off+len) 是不是字面量 s。
fn eqw(a: ptr, off: u32, len: u32, s: str) -> bool {
    if len != str_len(s) {
        return false;
    }
    return same(a, off, str_ptr(s), 0, len);
}

/// [off, n) 是否以 s 开头（带边界）。
fn has_at(a: ptr, off: u32, n: u32, s: str) -> bool {
    let l: u32 = str_len(s);
    if off + l > n {
        return false;
    }
    return same(a, off, str_ptr(s), 0, l);
}

fn r2(a: ptr, base: u32, i: u32) -> u64 {
    return ((rd(a, base, i) as u64) << 32) | (rd(a, base, i + 1) as u64);
}

fn wr(m: ptr, base: u32, i: u32, v: u32) {
    store32(m, base + i * 4, v);
}

fn rd(a: ptr, base: u32, i: u32) -> u32 {
    return load32(a, base + i * 4);
}

/// 存一对 (偏移, 长度) 到记录里第 i 格起的两格。
fn w2(m: ptr, base: u32, i: u32, o: u32, l: u32) {
    wr(m, base, i, o);
    wr(m, base, i + 1, l);
}

fn index_of(a: ptr, s: u32, n: u32, ch: u32) -> u32 {
    let i: u32 = s;
    let go: u32 = 1;
    let hit: u32 = NONE;
    while i < n && go == 1 {
        if load8(a, i) == ch {
            hit = i;
            go = 0;
        } else {
            i = i + 1;
        }
    }
    return hit;
}

fn last_byte(a: ptr, s: u32, n: u32, ch: u32) -> u32 {
    let i: u32 = s;
    let hit: u32 = NONE;
    while i < n {
        if load8(a, i) == ch {
            hit = i;
        }
        i = i + 1;
    }
    return hit;
}

/// 括号配对：返回与 [i] 处那个开括号配对的**闭括号**位置（没有则 n）。
/// 只数**同一种**括号 —— 与 `lomelf.parse_type` 同一口径（它也只认外层那一种）。
fn match_close(a: ptr, i: u32, n: u32, open: u32, close: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(a, j);
        if c == open {
            d = d + 1;
        } else if c == close {
            d = d - 1;
            if d == 0 {
                go = 0;
            }
        }
        j = j + 1;
    }
    return j - 1;
}

/// 顶层（圆/方/花括号深度 0）逗号或 n 的位置。
fn seg_end(a: ptr, i: u32, n: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let d: u32 = 0;
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(a, j);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        } else if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        } else if c == 44 && d == 0 {
            go = 0;
        }
        if go == 1 {
            j = j + 1;
        }
    }
    return j;
}

/// 从 `i`（一个顶层逗号或 n）跳到下一段的起点。
fn seg_next(a: ptr, i: u32, n: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let j: u32 = i;
    if j < n && load8(a, j) == 44 {
        j = j + 1;
    }
    return skip_sp(a, j, n);
}

fn has_byte(a: ptr, s: u32, e: u32, ch: u32) -> bool {
    let i: u32 = s;
    while i < e {
        if load8(a, i) == ch {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn line_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    while j < n && load8(t, j) != 10 {
        j = j + 1;
    }
    if j > i && load8(t, j - 1) == 13 {
        return j - 1;                                    // CRLF：回车不算行内容
    }
    return j;
}

/// 括号没配平？（IR 的长指令可能跨行 —— 照 `lomelf.unbalanced` 并起来）
fn unbalanced(a: ptr, s: u32, e: u32) -> bool {
    let d: i32 = 0;
    let i: u32 = s;
    while i < e {
        let c: u32 = load8(a, i);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        } else if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        }
        i = i + 1;
    }
    return d > 0;
}

fn hexv(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return c - 55;
}

/// `-?[0-9]+` -> u64（负数取**补码**，与参考实现 `(n & mask)` 同口径）。
fn dec_u64(a: ptr, s: u32, e: u32) -> u64 {
    let i: u32 = skip_sp(a, s, e);
    let neg: u32 = 0;
    if i < e && load8(a, i) == 45 {
        neg = 1;
        i = i + 1;
    }
    let v: u64 = 0;
    while i < e && is_digit(load8(a, i)) {
        v = v * 10 + ((load8(a, i) - 48) as u64);
        i = i + 1;
    }
    if neg == 1 {
        return (0 as u64) - v;
    }
    return v;
}

// ---------------------------------------------------------------- 类型
//
// 子集：i1/i8/i16/i32/i64/ptr、`{T, …}`、`[N x T]`。**逐条镜像** `lomelf.parse_type`
// 与 `size_of` / `field_offset` —— 那三条是"聚合怎么摆"的真源，差一个字节两条路就对不上。

/// 从 off 起读一个类型，返回 (起点 << 32) | 长度。
/// `{`/`[` 走**外层那一种**括号的配对（与参考实现同一处取舍）。
fn ty_span(a: ptr, off: u32, n: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let i: u32 = skip_sp(a, off, n);
    if i >= n {
        return 0;
    }
    let c: u32 = load8(a, i);
    if c == 123 || c == 91 {
        let close: u32 = 125;
        if c == 91 {
            close = 93;
        }
        let d: u32 = 0;
        let j: u32 = i;
        let go: u32 = 1;
        while j < n && go == 1 {
            let ch: u32 = load8(a, j);
            if ch == c {
                d = d + 1;
            } else if ch == close {
                d = d - 1;
                if d == 0 {
                    go = 0;
                }
            }
            j = j + 1;
        }
        return ((i as u64) << 32) | ((j - i) as u64);
    }
    let j: u32 = word_end(a, i, n);
    return ((i as u64) << 32) | ((j - i) as u64);
}

fn is_agg(a: ptr, off: u32, len: u32) -> bool {
    if len == 0 {
        return false;
    }
    let c: u32 = load8(a, off);
    return c == 123 || c == 91;
}

/// 结构体里顶层字段个数。
fn fld_count(a: ptr, off: u32, len: u32) -> u32 {
    let n: u32 = off + len;
    let i: u32 = off + 1;
    let d: u32 = 1;
    let k: u32 = 0;
    let any: u32 = 0;
    while i < n {
        let c: u32 = load8(a, i);
        if c == 123 || c == 91 {
            d = d + 1;
        } else if c == 125 || c == 93 {
            d = d - 1;
            if d == 0 {
                if any == 1 {
                    k = k + 1;
                }
                return k;
            }
        } else if c == 44 && d == 1 {
            k = k + 1;
            any = 0;
        } else if d == 1 && is_sp(c) == false {
            any = 1;
        }
        i = i + 1;
    }
    return k;
}

/// 结构体里第 k 个字段的类型 span。
fn fld_ty(a: ptr, off: u32, len: u32, k: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let n: u32 = off + len;
    let i: u32 = off + 1;
    let d: u32 = 1;
    let s: u32 = i;
    let idx: u32 = 0;
    let res: u64 = 0;
    let go: u32 = 1;
    while i < n && go == 1 {
        let c: u32 = load8(a, i);
        if c == 123 || c == 91 {
            d = d + 1;
        } else if c == 125 || c == 93 {
            d = d - 1;
            if d == 0 {
                if idx == k {
                    res = trim_span(a, s, i);
                }
                go = 0;
            }
        } else if c == 44 && d == 1 {
            if idx == k {
                res = trim_span(a, s, i);
                go = 0;
            }
            idx = idx + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return res;
}

/// 结构体里第 k 个字段的**偏移**（对齐到它自己的大小；无尾部填充）。
fn fld_off(a: ptr, off: u32, len: u32, k: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let o: u32 = 0;
    let i: u32 = 0;
    while i < k {
        let f: u64 = fld_ty(a, off, len, i);
        let sz: u32 = ty_size(a, hi32(f), lo32(f));
        o = ((o + sz - 1) / sz) * sz + sz;
        i = i + 1;
    }
    let fk: u64 = fld_ty(a, off, len, k);
    let szk: u32 = ty_size(a, hi32(fk), lo32(fk));
    return ((o + szk - 1) / szk) * szk;
}

fn arr_count(a: ptr, off: u32, len: u32) -> u32 {
    let i: u32 = off + 1;
    let n: u32 = 0;
    while i < off + len && load8(a, i) != 120 {
        if is_digit(load8(a, i)) {
            n = n * 10 + (load8(a, i) - 48);
        }
        i = i + 1;
    }
    return n;
}

fn arr_elem(a: ptr, off: u32, len: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let i: u32 = off + 1;
    while i < off + len && load8(a, i) != 120 {
        i = i + 1;
    }
    return trim_span(a, i + 1, off + len - 1);
}

/// 类型文本 -> 字节数。**i1 占 1 字节**（与 `lomelf.SCALAR_SIZE` 的 "i1": 1 一致，
/// 不是 1 位 —— `n / 8` 会给出 0，那是个真踩过的坑）。
fn ty_size(a: ptr, off: u32, len: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let c: u32 = load8(a, off);
    if c == 105 {
        let n: u32 = 0;
        let j: u32 = off + 1;
        while j < off + len && is_digit(load8(a, j)) {
            n = n * 10 + (load8(a, j) - 48);
            j = j + 1;
        }
        if n < 8 {
            return 1;
        }
        return n / 8;
    }
    if c == 112 {
        return 8;                          // ptr
    }
    if c == 123 {
        let tot: u32 = 0;
        let nf: u32 = fld_count(a, off, len);
        let k: u32 = 0;
        while k < nf {
            let f: u64 = fld_ty(a, off, len, k);
            let sz: u32 = ty_size(a, hi32(f), lo32(f));
            tot = ((tot + sz - 1) / sz) * sz + sz;
            k = k + 1;
        }
        return tot;
    }
    if c == 91 {
        let et: u64 = arr_elem(a, off, len);
        return arr_count(a, off, len) * ty_size(a, hi32(et), lo32(et));
    }
    return 8;
}

// ---------------------------------------------------------------- VM 内存
//
// 地址 = 一段字节里的下标。`m` 就是那段字节的基址（arena + MEM_OFF）。

fn mr(m: ptr, p: u32, n: u32) -> u64 {
    if p + n > MEM_SIZE {
        return fail("读越界") as u64;
    }
    let v: u64 = 0;
    let i: u32 = 0;
    let sh: u32 = 0;
    while i < n {
        v = v | (((load8(m, p + i) as u64) << (sh as u64)));
        i = i + 1;
        sh = sh + 8;
    }
    return v;
}

fn mw(m: ptr, p: u32, n: u32, v: u64) {
    if p + n > MEM_SIZE {
        let _f: u32 = fail("写越界");
    } else {
        let i: u32 = 0;
        while i < n {
            store8(m, p + i, ((v >> ((i * 8) as u64)) & 255) as u8);
            i = i + 1;
        }
    }
}

fn mc(m: ptr, d: u32, s: u32, n: u32) {
    if d + n > MEM_SIZE || s + n > MEM_SIZE {
        let _f: u32 = fail("拷贝越界");
    } else {
        let i: u32 = 0;
        while i < n {
            store8(m, d + i, load8(m, s + i) as u8);
            i = i + 1;
        }
    }
}

fn mz(m: ptr, d: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(m, d + i, 0 as u8);
        i = i + 1;
    }
}

/// VM 堆分配（bump）。**越界点名报**，不静默写坏栈 —— `docs/200` 那条教训。
fn vm_alloc(a: ptr, n: u32, align: u32) -> u32 {
    let h: u32 = ctx_get(a, C_HEAP);
    let p: u32 = (h + align - 1) / align * align;
    let nx: u32 = p + n;
    if nx >= STACK_LIMIT {
        fail("VM 堆撞上栈 —— 地址空间用完了");
    }
    ctx_set(a, C_HEAP, nx);
    return p;
}

// ---------------------------------------------------------------- sw_cap：对象表
//
// 活对象按 base 升序放在 `OBJ_OFF`，每条 5 个 u32：base / limit / gen / alive / kind。
// 查地址 = 二分 + 向前看一格；归还 = 从活表搬到 `RET_OFF` 的最近 1024 条里。
// **不是**能力：`ptr` 到这一层只剩地址，洗过整数再复用地址的悬垂抓不住（`docs/362` §5.1）。

fn obj_base(a: ptr, o: u32) -> u32 { return rd(a, OBJ_OFF, o * 5); }
fn obj_limit(a: ptr, o: u32) -> u32 { return rd(a, OBJ_OFF, o * 5 + 1); }
fn obj_kind(a: ptr, o: u32) -> u32 { return rd(a, OBJ_OFF, o * 5 + 4); }
/// `sw_tag` 的 4 位标签（1..15；0 = 没有标签，`sw_cap` 全是 0）。并行数组，按对象下标。
fn obj_tag(a: ptr, o: u32) -> u32 { return rd(a, TAG_OFF, o); }

fn obj_put(a: ptr, o: u32, b: u32, l: u32, k: u32) {
    wr(a, OBJ_OFF, o * 5, b);
    wr(a, OBJ_OFF, o * 5 + 1, l);
    wr(a, OBJ_OFF, o * 5 + 2, 0);
    wr(a, OBJ_OFF, o * 5 + 3, 1);
    wr(a, OBJ_OFF, o * 5 + 4, k);
    wr(a, TAG_OFF, o, 0);
}

fn obj_copy(a: ptr, dst: u32, src: u32) {
    wr(a, OBJ_OFF, dst * 5, rd(a, OBJ_OFF, src * 5));
    wr(a, OBJ_OFF, dst * 5 + 1, rd(a, OBJ_OFF, src * 5 + 1));
    wr(a, OBJ_OFF, dst * 5 + 2, rd(a, OBJ_OFF, src * 5 + 2));
    wr(a, OBJ_OFF, dst * 5 + 3, rd(a, OBJ_OFF, src * 5 + 3));
    wr(a, OBJ_OFF, dst * 5 + 4, rd(a, OBJ_OFF, src * 5 + 4));
    wr(a, TAG_OFF, dst, rd(a, TAG_OFF, src));
}

//: `sw_tag` 的每帧值能力：`(对象基址, 标签)`，下标 = 深度 * MAX_VALS + 槽号。
//: 值为 0 表示「这一格没带着能力」—— 访问就退回按地址那一半（与参考的 `cap=None` 同）。
fn cap_at(a: ptr, fr: u32, i: u32) -> ptr {
    let d: u32 = (MEM_SIZE - fr) / FRAME_SIZE;
    return ptr_add(a, CAP_OFF + (d * MAX_VALS + i) * 8);
}

fn cap_put(a: ptr, fr: u32, i: u32, b: u32, t: u32) {
    let r: ptr = cap_at(a, fr, i);
    store32(r, 0, b);
    store32(r, 4, t);
}

fn cap_base(a: ptr, fr: u32, i: u32) -> u32 { return load32(cap_at(a, fr, i), 0); }
fn cap_tag(a: ptr, fr: u32, i: u32) -> u32 { return load32(cap_at(a, fr, i), 4); }

/// 类型是不是 `ptr`（影子表只在指针的存/取上工作）。
fn is_ptr_ty(a: ptr, to: u32, tl: u32) -> bool {
    let s: u32 = skip_sp(a, to, to + tl);
    if to + tl - s != 3 {
        return false;
    }
    return load8(a, s) == 112 && load8(a, s + 1) == 116 && load8(a, s + 2) == 114;
}

fn sh_at(a: ptr, i: u32) -> ptr {
    return ptr_add(a, SH_OFF + (i % SH_CAP) * 12);
}

fn sh_put(a: ptr, addr: u32, b: u32, t: u32) {
    let i: u32 = ctx_get(a, C_SHN);
    let r: ptr = sh_at(a, i);
    store32(r, 0, addr);
    store32(r, 4, b);
    store32(r, 8, t);
    ctx_set(a, C_SHN, i + 1);
}

/// 影子表里**最新**的一条：返回 `(标签 << 32) | 对象基址`；没有就是 0。
fn sh_get(a: ptr, addr: u32) -> u64 {
    let n: u32 = ctx_get(a, C_SHN);
    if n == 0 {
        return 0;
    }
    let lim: u32 = n;
    if lim > SH_CAP {
        lim = SH_CAP;
    }
    let k: u32 = 1;
    let out: u64 = 0;
    let go: u32 = 1;
    while k <= lim && go == 1 {
        let i: u32 = (n - k) % SH_CAP;
        let r: ptr = sh_at(a, i);
        if load32(r, 0) == addr {
            out = ((load32(r, 8) as u64) << 32) | (load32(r, 4) as u64);
            go = 0;
        }
        k = k + 1;
    }
    return out;
}

/// 对象归还时把影子表里**落在它体内**的条目作废（参考实现的 `_drop_shadow` 同形）。
/// 不这么做，帧槽的地址被下一次调用复用时，旧能力会从影子表里"复活"。
fn sh_drop(a: ptr, base: u32, limit: u32) {
    if ctx_get(a, C_SUB) != 2 {
        return;
    }
    let n: u32 = ctx_get(a, C_SHN);
    let lim: u32 = n;
    if lim > SH_CAP {
        lim = SH_CAP;
    }
    let k: u32 = 0;
    while k < lim {
        let i: u32 = (n - 1 - k) % SH_CAP;
        let r: ptr = sh_at(a, i);
        let ad: u32 = load32(r, 0);
        if ad >= base && ad < limit {
            store32(r, 0, NONE);
        }
        k = k + 1;
    }
}

fn ret_copy(a: ptr, dst: u32, src: u32) {
    wr(a, RET_OFF, dst * 5, rd(a, RET_OFF, src * 5));
    wr(a, RET_OFF, dst * 5 + 1, rd(a, RET_OFF, src * 5 + 1));
    wr(a, RET_OFF, dst * 5 + 2, rd(a, RET_OFF, src * 5 + 2));
    wr(a, RET_OFF, dst * 5 + 3, rd(a, RET_OFF, src * 5 + 3));
    wr(a, RET_OFF, dst * 5 + 4, rd(a, RET_OFF, src * 5 + 4));
}

/// 十进制输出一个 u32（`write_num` 在文件后面定义，这里先用 1 字节暂存自己来）。
fn wnum32(a: ptr, fd: u64, v: u32) {
    if v >= 10 {
        wnum32(a, fd, v / 10);
    }
    store8(a, WNUM_SCRATCH, ((v % 10) + 48) as u8);
    let _n: u64 = write_all(fd, ptr_add(a, WNUM_SCRATCH), 1);
}

//: 段错误详细化的"为什么"（`docs/366`）。
const FR_NULL: u32 = 1;
const FR_OVER: u32 = 2;
const FR_UNMAPPED: u32 = 3;
const FR_RETIRED: u32 = 4;

fn wspace(n: u32) {
    let i: u32 = 0;
    while i < n {
        wstr(2, " ");
        i = i + 1;
    }
}

fn wcarets(n: u32) {
    let i: u32 = 0;
    while i < n {
        wstr(2, "^");
        i = i + 1;
    }
}

fn obj_kind_word(k: u32) {
    if k == OBJ_GLOBAL {
        wstr(2, "global");
    } else if k == OBJ_BRK {
        wstr(2, "brk");
    } else if k == OBJ_ALLOCA {
        wstr(2, "alloca");
    } else {
        wstr(2, "heap");
    }
}

fn w_fn_name(a: ptr, fi: u32) {
    let fo: u32 = rd(a, F_OFF, fi * 8);
    let fl: u32 = rd(a, F_OFF, fi * 8 + 1);
    // 表里的函数名带 `@`（与 IR 同形）；站点打印**不带**。
    if fl > 1 {
        let _n: u64 = write_all(2, ptr_add(a, fo + 1), (fl - 1) as u64);
    }
}

fn w_blk_name(a: ptr, bi: u32) {
    let bo: u32 = rd(a, B_OFF, bi * 5);
    let bl: u32 = rd(a, B_OFF, bi * 5 + 1);
    let _n: u64 = write_all(2, ptr_add(a, bo), bl as u64);
}

/// 一条 F01/F02/F03：**100 + kind** 退出码 + `函数:块#序号`（与 `llvm.trap` 同形）。

/// `docs/366`：首行保持稳定（孪生/故障判据按它比），Lomenterr 形状的详细块跟在后面。
/// `io/il` 是当前指令的跨度，`oo/ol` 是指针操作数的跨度（插入符画在它下面）。
fn cap_fault(a: ptr, kind: u32, addr: u32, sz: u32, reason: u32,
             io: u32, il: u32, oo: u32, ol: u32) -> u32 {
    let fi: u32 = ctx_get(a, C_SITE_FI);
    let bi: u32 = ctx_get(a, C_SITE_BI);
    let j: u32 = ctx_get(a, C_SITE_J);
    // ---- 首行（稳定）
    wstr(2, "lvm: ");
    if kind == 1 {
        wstr(2, "F01 bounds violation");
    } else if kind == 2 {
        wstr(2, "F02 dangling reference");
    } else {
        wstr(2, "F03 null dereference");
    }
    wstr(2, " at ");
    w_fn_name(a, fi);
    wstr(2, ":");
    w_blk_name(a, bi);
    wstr(2, "#");
    wnum32(a, 2, j);
    wstr(2, " (addr=");
    wnum32(a, 2, addr);
    wstr(2, " size=");
    wnum32(a, 2, sz);
    wstr(2, ")\n");
    // ---- 详细块（Lomenterr 形状）
    wstr(2, "error[");
    if kind == 1 {
        wstr(2, "F01");
    } else if kind == 2 {
        wstr(2, "F02");
    } else {
        wstr(2, "F03");
    }
    wstr(2, "]: ");
    if kind == 1 {
        wstr(2, "访问越界（bounds）\n");
    } else if kind == 2 {
        wstr(2, "悬垂引用（dangling）\n");
    } else {
        wstr(2, "空指针解引用（null）\n");
    }
    wstr(2, "  --> IR:");
    w_fn_name(a, fi);
    wstr(2, ":");
    w_blk_name(a, bi);
    wstr(2, "#");
    wnum32(a, 2, j);
    wstr(2, "\n   |\n   |   ");
    let _i1: u64 = write_all(2, ptr_add(a, io), il as u64);
    wstr(2, "\n   |   ");
    if ol > 0 && oo >= io {
        wspace(oo - io);
        wcarets(ol);
        wstr(2, "  这里访问 ");
        wnum32(a, 2, sz);
        wstr(2, " 字节\n");
    }
    wstr(2, "   |\n");
    // 对象：按 reason 找活表 / 归还窗口
    let live: u32 = obj_find_live(a, addr);
    let dead: u32 = obj_find_retired(a, addr);
    if reason == FR_OVER && live != NONE {
        let b: u32 = obj_base(a, live);
        let l: u32 = obj_limit(a, live);
        wstr(2, "   = 对象 #");
        wnum32(a, 2, live + 1);
        wstr(2, "（");
        obj_kind_word(obj_kind(a, live));
        wstr(2, "）：base=");
        wnum32(a, 2, b);
        wstr(2, " limit=");
        wnum32(a, 2, l);
        wstr(2, "（");
        wnum32(a, 2, l - b);
        wstr(2, " 字节），第 ");
        wnum32(a, 2, rd(a, OBJ_OFF, live * 5 + 2));
        wstr(2, " 代，活着\n");
        wstr(2, "   = 事实：地址 ");
        wnum32(a, 2, addr);
        wstr(2, " 在对象内，偏移 ");
        wnum32(a, 2, addr - b);
        wstr(2, "；访问 ");
        wnum32(a, 2, sz);
        wstr(2, " 字节越过上限 ");
        wnum32(a, 2, addr - b + sz - (l - b));
        wstr(2, " 字节（右越界）\n");
    } else if reason == FR_RETIRED && dead != NONE {
        let db: u32 = rd(a, RET_OFF, dead * 5);
        let dl: u32 = rd(a, RET_OFF, dead * 5 + 1);
        wstr(2, "   = 已归还的那一个：对象（");
        obj_kind_word(rd(a, RET_OFF, dead * 5 + 4));
        wstr(2, "）：base=");
        wnum32(a, 2, db);
        wstr(2, " limit=");
        wnum32(a, 2, dl);
        wstr(2, "（");
        wnum32(a, 2, dl - db);
        wstr(2, " 字节），第 ");
        wnum32(a, 2, rd(a, RET_OFF, dead * 5 + 2));
        wstr(2, " 代，**已归还**\n");
        wstr(2, "   = 事实：地址 ");
        wnum32(a, 2, addr);
        wstr(2, " 落在已归还的那一块里；这次访问 ");
        wnum32(a, 2, sz);
        wstr(2, " 字节\n");
    } else if reason == FR_UNMAPPED {
        wstr(2, "   = 事实：没有任何对象覆盖地址 ");
        wnum32(a, 2, addr);
        wstr(2, "（访问 ");
        wnum32(a, 2, sz);
        wstr(2, " 字节）—— 地址不在对象表里\n");
        let prev: u32 = obj_find_prev(a, addr);
        if prev != NONE {
            let pb: u32 = obj_base(a, prev);
            let pl: u32 = obj_limit(a, prev);
            wstr(2, "   = 最近的活对象：#");
            wnum32(a, 2, prev + 1);
            wstr(2, "（");
            obj_kind_word(obj_kind(a, prev));
            wstr(2, "）：base=");
            wnum32(a, 2, pb);
            wstr(2, " limit=");
            wnum32(a, 2, pl);
            wstr(2, "；地址在它结束之后 ");
            let gap: u32 = 0;
            if addr > pl {
                gap = addr - pl;
            }
            wnum32(a, 2, gap);
            wstr(2, " 字节\n");
        }
    } else {
        wstr(2, "   = 事实：指针是 0（空指针），试图访问 ");
        wnum32(a, 2, sz);
        wstr(2, " 字节\n");
    }
    wstr(2, "   = 站点：函数 ");
    w_fn_name(a, fi);
    wstr(2, " / 块 ");
    w_blk_name(a, bi);
    wstr(2, " / 第 ");
    wnum32(a, 2, j);
    wstr(2, " 条指令；栈深 ");
    wnum32(a, 2, ctx_get(a, C_DEPTH));
    wstr(2, "\n   = 建议：");
    if kind == 1 {
        wstr(2, "检查下标与对象长度：这一次访问跨过了对象的上限。原生档在这条路径上是 UB，LVM 把它变成这句话；上限表见 docs/263。\n");
    } else if kind == 2 {
        wstr(2, "对象已经归还（代已加一），旧指针不能再解引用。原生档是 UB；按地址的基质只认地址归属（docs/362 §5.1）。\n");
    } else {
        wstr(2, "指针是 0。先判空，或查清这个指针为什么没被赋过值。\n");
    }
    let code: u64 = 100 as u64 + kind as u64;
    return die(code);
}

fn obj_find_pos(a: ptr, base: u32) -> u32 {
    let lo: u32 = 0;
    let hi: u32 = ctx_get(a, C_NOBJ);
    while lo < hi {
        let mid: u32 = (lo + hi) / 2;
        if obj_base(a, mid) < base {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn obj_retire_idx(a: ptr, idx: u32) {
    sh_drop(a, rd(a, OBJ_OFF, idx * 5), rd(a, OBJ_OFF, idx * 5 + 1));
    let n: u32 = ctx_get(a, C_NOBJ);
    let nr: u32 = ctx_get(a, C_NRET);
    if nr >= MAX_RET {
        let i: u32 = 1;
        while i < MAX_RET {
            ret_copy(a, i - 1, i);
            i = i + 1;
        }
        nr = MAX_RET - 1;
    }
    wr(a, RET_OFF, nr * 5, rd(a, OBJ_OFF, idx * 5));
    wr(a, RET_OFF, nr * 5 + 1, rd(a, OBJ_OFF, idx * 5 + 1));
    wr(a, RET_OFF, nr * 5 + 2, rd(a, OBJ_OFF, idx * 5 + 2) + 1);
    wr(a, RET_OFF, nr * 5 + 3, 0);
    wr(a, RET_OFF, nr * 5 + 4, rd(a, OBJ_OFF, idx * 5 + 4));
    ctx_set(a, C_NRET, nr + 1);
    let i2: u32 = idx;
    while i2 + 1 < n {
        obj_copy(a, i2, i2 + 1);
        i2 = i2 + 1;
    }
    ctx_set(a, C_NOBJ, n - 1);
}

fn obj_retire_base(a: ptr, base: u32) {
    let pos: u32 = obj_find_pos(a, base);
    let n: u32 = ctx_get(a, C_NOBJ);
    if pos < n && obj_base(a, pos) == base {
        if obj_kind(a, pos) != OBJ_GLOBAL {
            obj_retire_idx(a, pos);
        }
    }
}

/// 新对象。同 base 的旧对象先归还；全局永不被覆盖（那是基座的不变量）。
fn obj_new(a: ptr, base: u32, limit: u32, kind: u32) {
    let pos: u32 = obj_find_pos(a, base);
    let n: u32 = ctx_get(a, C_NOBJ);
    if pos < n && obj_base(a, pos) == base {
        if obj_kind(a, pos) == OBJ_GLOBAL {
            fail("sw_cap：新对象与全局重叠");
        }
        obj_retire_idx(a, pos);
    }
    let m: u32 = ctx_get(a, C_NOBJ);
    if m >= MAX_OBJS {
        fail("sw_cap 对象表满了");
    }
    let p2: u32 = obj_find_pos(a, base);
    let i: u32 = m;
    while i > p2 {
        obj_copy(a, i, i - 1);
        i = i - 1;
    }
    obj_put(a, p2, base, limit, kind);
    if ctx_get(a, C_SUB) == 2 {
        // 确定轮转：1..15。第 16 次分配回到 1 —— 4 位只有 15 个非零值，
        // 撞上时悬垂就漏（`docs/364` §2）。序列与参考实现同为「每次 new_obj 加一」。
        wr(a, TAG_OFF, p2, 1 + (ctx_get(a, C_TAGSEQ) % 15));
        ctx_set(a, C_TAGSEQ, ctx_get(a, C_TAGSEQ) + 1);
    }
    ctx_set(a, C_NOBJ, m + 1);
}

fn obj_find_live(a: ptr, addr: u32) -> u32 {
    let lo: u32 = 0;
    let hi: u32 = ctx_get(a, C_NOBJ);
    while lo < hi {
        let mid: u32 = (lo + hi) / 2;
        if obj_base(a, mid) <= addr {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    let i: u32 = lo;
    let found: u32 = NONE;
    let go: u32 = 1;
    while i > 0 && go == 1 {
        i = i - 1;
        if obj_base(a, i) <= addr && addr < obj_limit(a, i) {
            found = i;
            go = 0;
        }
    }
    return found;
}

/// 最后一个 `base <= addr` 的活对象（二分）。地址**越过**某个对象时，用它说清"最近的是谁"。
fn obj_find_prev(a: ptr, addr: u32) -> u32 {
    let lo: u32 = 0;
    let hi: u32 = ctx_get(a, C_NOBJ);
    while lo < hi {
        let mid: u32 = (lo + hi) / 2;
        if obj_base(a, mid) <= addr {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return NONE;
    }
    return lo - 1;
}

fn obj_find_retired(a: ptr, addr: u32) -> u32 {
    let nr: u32 = ctx_get(a, C_NRET);
    let i: u32 = nr;
    let found: u32 = NONE;
    while i > 0 && found == NONE {
        i = i - 1;
        let b: u32 = rd(a, RET_OFF, i * 5);
        let l: u32 = rd(a, RET_OFF, i * 5 + 1);
        if b <= addr && addr < l {
            found = i;
        }
    }
    return found;
}

/// `operand_text` 那一半：从一段 `类型 值` 里取出**值**的 (起点, 长度)。
fn operand_value_span(a: ptr, off: u32, n: u32) -> u64 {
    let ts: u64 = ty_span(a, off, n);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), n);
    return trim_span(a, vo, n);
}

/// 指针操作数的能力（`sw_tag`）：`%name` 查本帧的值表，`@g` 查全局对象。
/// 返回 `(标签 << 32) | 对象基址`；0 = 没有能力 —— 访问退回按地址那一半
/// （与参考实现的 `cap=None` 同一条路）。
fn operand_cap(a: ptr, m: ptr, fr: u32, vo: u32, vl: u32) -> u64 {
    if ctx_get(a, C_SUB) != 2 || vl == 0 {
        return 0;
    }
    let c: u32 = load8(a, vo);
    if c == 37 {                                         // %name
        let i: u32 = vfind(a, m, fr, vo, vl);
        if i == NONE {
            return 0;
        }
        let t: u32 = cap_tag(a, fr, i);
        if t == 0 {
            return 0;
        }
        return ((t as u64) << 32) | (cap_base(a, fr, i) as u64);
    }
    if c == 64 {                                         // @global
        let ga: u32 = gaddr(a, vo, vl);
        let pos: u32 = obj_find_pos(a, ga);
        if pos < ctx_get(a, C_NOBJ) && obj_base(a, pos) == ga {
            let t: u32 = obj_tag(a, pos);
            if t != 0 {
                return ((t as u64) << 32) | (ga as u64);
            }
        }
    }
    return 0;
}

/// 一个**对象基址**的能力（`alloca` / 分配器 / 返回基址的调用）。
fn cap_of_base(a: ptr, v: u64) -> u64 {
    if ctx_get(a, C_SUB) != 2 || v >= (MEM_SIZE as u64) {
        return 0;
    }
    let b: u32 = v as u32;
    let pos: u32 = obj_find_pos(a, b);
    if pos < ctx_get(a, C_NOBJ) && obj_base(a, pos) == b {
        let t: u32 = obj_tag(a, pos);
        if t != 0 {
            return ((t as u64) << 32) | (b as u64);
        }
    }
    return 0;
}

/// `getelementptr` 的结果保留**基指针**的能力（参考实现的 `_derive` 同形）。
fn gep_cap(a: ptr, m: ptr, fr: u32, io: u32, il: u32) -> u64 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    if has_at(a, p, e, "inbounds") {
        p = skip_sp(a, p + 8, e);
    }
    let ts: u64 = ty_span(a, p, e);
    let op: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let vs: u64 = operand_value_span(a, op, seg_end(a, op, e));
    return operand_cap(a, m, fr, hi32(vs) as u32, lo32(vs) as u32);
}

/// 一条指令**结果值**的能力：只有三种会产生带标签的指针。
fn result_cap(a: ptr, m: ptr, fr: u32, k: u32, to: u32, tl: u32, v: u64) -> u64 {
    if ctx_get(a, C_SUB) != 2 {
        return 0;
    }
    if k == K_ALLOCA || k == K_CALL {
        return cap_of_base(a, v);
    }
    if k == K_GEP {
        return gep_cap(a, m, fr, to, tl);
    }
    if k == K_LOAD {
        // 指针从内存读回来：影子表把它存进去时的能力还回来（参考的 `shadow` 同形）。
        let e: u32 = to + tl;
        let ts: u64 = ty_span(a, after_op(a, to, e), e);
        if !is_ptr_ty(a, hi32(ts) as u32, lo32(ts) as u32) {
            return 0;
        }
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let addr: u64 = operand_text(a, m, fr, p, e);
        return sh_get(a, addr as u32);
    }
    return 0;
}

/// `sw_tag` 的访问检查：比**4 位标签**，不是对象代（`docs/364` §2）。
/// 标签对上 ⇒ 按活对象判边界；对不上而「能力的对象」还在 ⇒ 按它判边界；
/// 否则就是悬垂。同标签的复用会漏 —— 那是声明里的概率，不是缺陷。
fn cap_check_tag(a: ptr, addr: u32, sz: u32, cb: u32, ct: u32,
                 io: u32, il: u32, oo: u32, ol: u32) {
    if ctx_get(a, C_SUB) != 2 || ctx_get(a, C_PRIV) != 0 {
        return;
    }
    let live: u32 = obj_find_live(a, addr);
    if live != NONE && obj_tag(a, live) == ct {
        if addr + sz > obj_limit(a, live) {
            let _c0: u32 = cap_fault(a, 1, addr, sz, FR_OVER, io, il, oo, ol);
        }
        return;
    }
    let pos: u32 = obj_find_pos(a, cb);
    if pos < ctx_get(a, C_NOBJ) && obj_base(a, pos) == cb && obj_tag(a, pos) == ct {
        if addr < cb {
            let _c1: u32 = cap_fault(a, 1, addr, sz, FR_OVER, io, il, oo, ol);
        }
        if addr + sz > obj_limit(a, pos) {
            let _c2: u32 = cap_fault(a, 1, addr, sz, FR_OVER, io, il, oo, ol);
        }
        return;
    }
    let _c3: u32 = cap_fault(a, 2, addr, sz, FR_RETIRED, io, il, oo, ol);
}

/// 一次访存前的 `cap_check`（`docs/360` P2/P3 的地址那一半）。
/// `io/il` 与 `oo/ol` 只喂 `docs/366` 的详细诊断，不参与判决。
fn cap_check(a: ptr, addr: u32, sz: u32, io: u32, il: u32, oo: u32, ol: u32) {
    if ctx_get(a, C_SUB) == 0 || ctx_get(a, C_PRIV) != 0 {
        return;
    }
    if addr == 0 && sz > 0 {
        let _c0: u32 = cap_fault(a, 3, addr, sz, FR_NULL, io, il, oo, ol);
    }
    let live: u32 = obj_find_live(a, addr);
    if live != NONE {
        let lk: u32 = obj_kind(a, live);
        if lk != OBJ_GLOBAL && lk != OBJ_BRK {
            if addr + sz > obj_limit(a, live) {
                let _c1: u32 = cap_fault(a, 1, addr, sz, FR_OVER, io, il, oo, ol);
            }
            return;
        }
    }
    let dead: u32 = obj_find_retired(a, addr);
    if dead != NONE {
        if live == NONE || rd(a, RET_OFF, dead * 5) > obj_base(a, live) {
            let _c2: u32 = cap_fault(a, 2, addr, sz, FR_RETIRED, io, il, oo, ol);
        }
    }
    if live != NONE {
        if addr + sz > obj_limit(a, live) {
            let _c3: u32 = cap_fault(a, 1, addr, sz, FR_OVER, io, il, oo, ol);
        }
        return;
    }
    let _c4: u32 = cap_fault(a, 1, addr, sz, FR_UNMAPPED, io, il, oo, ol);
}

/// 栈帧返回：这一帧登记过的对象全部归还。
fn frame_retire(a: ptr, d: u32) {
    if d_on(a) == 1 {
        let dq: u32 = rd(a, FBASE_OFF, d * 4);
        let dn: u32 = ctx_get(a, C_NFOBJ);
        while dq < dn {
            d_retire_body(a, rd(a, FOBJ_OFF, dq));
            dq = dq + 1;
        }
        ctx_set(a, C_NFOBJ, rd(a, FBASE_OFF, d * 4));
        return;
    }
    if ctx_get(a, C_SUB) == 0 {
        return;
    }
    let first: u32 = rd(a, FBASE_OFF, d * 4);
    let n: u32 = ctx_get(a, C_NFOBJ);
    let i: u32 = first;
    while i < n {
        obj_retire_base(a, rd(a, FOBJ_OFF, i));
        i = i + 1;
    }
    ctx_set(a, C_NFOBJ, first);
}

fn mask_bits(v: u64, bits: u32) -> u64 {
    if bits >= 64 {
        return v;
    }
    return v & ((((1 as u64) << (bits as u64))) - 1);
}

/// 有符号读：同一位串按**有符号**解释，再符号扩展回 64 位（比较/加减靠它）。
/// 用"翻符号位再按无符号比"那招更省 —— 见 `sgn_cmp`。
fn sgnb(v: u64, bits: u32) -> u64 {
    if bits >= 64 {
        return v;
    }
    return v ^ (((1 as u64) << ((bits - 1) as u64)));
}

// ---------------------------------------------------------------- 帧

fn fr_alloc(a: ptr, m: ptr, fr: u32, n: u32, align: u32) -> u32 {
    let cur: u32 = rd(m, fr, 1);
    let p: u32 = (cur + align - 1) / align * align;
    let nx: u32 = p + n;
    if nx > FRAME_SIZE {
        wstr(2, "lvm: 帧用完了（槽 / 聚合）—— 帧内已用 ");
        write_num(a, 2, cur); wstr(2, " + "); write_num(a, 2, n);
        wstr(2, " 超过 "); write_num(a, 2, FRAME_SIZE); wstr(2, "
");
        return die(2);
    }
    wr(m, fr, 1, nx);
    if ctx_get(a, C_SUB) != 0 {
        if ctx_get(a, C_NFOBJ) >= MAX_FOBJ {
            fail("sw_cap 帧对象栈满了");
        }
        obj_new(a, fr + p, fr + nx, OBJ_ALLOCA);
        wr(a, FOBJ_OFF, ctx_get(a, C_NFOBJ), fr + p);
        ctx_set(a, C_NFOBJ, ctx_get(a, C_NFOBJ) + 1);
    }
    return fr + p;
}

/// 一个聚合**暂存区**，按 SSA 名缓存（名字就是那把钥匙）。
///
/// 为什么不是"每次分配一格"：SSA 里一个名字**只被一条指令写**，所以同名的多次执行
/// （循环的每一轮）可以把同一格**反复覆写** —— 读者永远看到本轮写进去的那份。
/// 每次分配就会变成"每轮吃一格帧"，`tour` 实测第 1023 轮把 32 KiB 帧吃光。
fn fr_agg(a: ptr, m: ptr, fr: u32, no: u32, nl: u32, size: u32) -> u32 {
    let i: u32 = vfind(a, m, fr, no, nl);
    if i != NONE {
        if rd(m, fr + FR_VALS, i * 4 + 3) >= size {
            return rd(m, fr + FR_VALS, i * 4 + 2);
        }
    }
    let d: u32 = fr_alloc(a, m, fr, size, 8);
    let v: u64 = (d as u64) | (((size as u64)) << 32);
    if i == NONE {
        vput(a, m, fr, no, nl, v);
    } else {
        vset(a, m, fr, i, v);
    }
    return d;
}

fn vfind(a: ptr, m: ptr, fr: u32, no: u32, nl: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let n: u32 = rd(m, fr, 0);
    let i: u32 = 0;
    while i < n {
        let o: u32 = load32(m, fr + FR_VALS + i * VAL_REC);
        let l: u32 = load32(m, fr + FR_VALS + i * VAL_REC + 4);
        // ⚠ 名字偏移是**输入文本**里的（基址 `a`）—— 表在 VM 内存里，名字不在。
        if l == nl && same(a, no, a, o, nl) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

fn vput(a: ptr, m: ptr, fr: u32, no: u32, nl: u32, v: u64) {
    vputc(a, m, fr, no, nl, v, 0, 0);
}

/// 带能力的 `vput`（`sw_tag`）：标签随值走，访问时按它判（`docs/364` §2）。
fn vputc(a: ptr, m: ptr, fr: u32, no: u32, nl: u32, v: u64, cb: u32, ct: u32) {
    let n: u32 = rd(m, fr, 0);
    if n >= MAX_VALS {
        fail("一个帧里的值太多了");
    }
    store32(m, fr + FR_VALS + n * VAL_REC, no);
    store32(m, fr + FR_VALS + n * VAL_REC + 4, nl);
    store32(m, fr + FR_VALS + n * VAL_REC + 8, lo32(v));
    store32(m, fr + FR_VALS + n * VAL_REC + 12, hi32(v));
    if ctx_get(a, C_SUB) == 2 {
        cap_put(a, fr, n, cb, ct);   // 只有 sw_tag 才花这一笔；T2/普通档一个字节都不写
    }
    wr(m, fr, 0, n + 1);
}

/// 把一个**已经存在**的值改成新值（`phi` 每轮改写自己那一格）。
fn vset(a: ptr, m: ptr, fr: u32, i: u32, v: u64) {
    vsetc(a, m, fr, i, v, 0, 0);
}

fn vsetc(a: ptr, m: ptr, fr: u32, i: u32, v: u64, cb: u32, ct: u32) {
    store32(m, fr + FR_VALS + i * VAL_REC + 8, lo32(v));
    store32(m, fr + FR_VALS + i * VAL_REC + 12, hi32(v));
    if ctx_get(a, C_SUB) == 2 {
        cap_put(a, fr, i, cb, ct);
    }
}

/// 帧里第 i 条记录的**值**（低位在 +8，高位在 +12）。
/// ⚠ **不能用 `r2`**: 那个是给 span 用的（偏移在前），拿它读值会把两个 32 位半边颠倒 ——
/// 第一版就这么写，症状是"从帧里读回来的值全是乱的"，而程序**照样跑到底、不报错**。
fn vget(m: ptr, fr: u32, i: u32) -> u64 {
    let lo: u64 = rd(m, fr + FR_VALS, i * 4 + 2) as u64;
    let hi: u64 = rd(m, fr + FR_VALS, i * 4 + 3) as u64;
    return lo | (hi << 32);
}

/// 参数表第 k 条的第 f 格起的 (偏移, 长度)。
fn pspan(a: ptr, k: u32, f: u32) -> u64 {
    return r2(a, P_OFF, k * 4 + f);
}

// ---------------------------------------------------------------- 表查询

fn gaddr(a: ptr, no: u32, nl: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let ng: u32 = ctx_get(a, C_NG);
    let i: u32 = 0;
    while i < ng {
        let o: u32 = rd(a, G_OFF, i * 6);
        let l: u32 = rd(a, G_OFF, i * 6 + 1);
        if l == nl && same(a, no, a, o, nl) {
            return rd(a, G_OFF, i * 6 + 4);
        }
        i = i + 1;
    }
    return fail_tok(a, "未知全局", no, nl);
}

fn fn_find(a: ptr, no: u32, nl: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let nf: u32 = ctx_get(a, C_NF);
    let i: u32 = 0;
    while i < nf {
        let o: u32 = rd(a, F_OFF, i * 8);
        let l: u32 = rd(a, F_OFF, i * 8 + 1);
        if l == nl && same(a, no, a, o, nl) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

fn fn_find_lit(a: ptr, s: str) -> u32 {
    let nf: u32 = ctx_get(a, C_NF);
    let i: u32 = 0;
    while i < nf {
        let o: u32 = rd(a, F_OFF, i * 8);
        let l: u32 = rd(a, F_OFF, i * 8 + 1);
        if eqw(a, o, l, s) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

/// 某函数里标签文本 = [lo, lo+ll) 的那一块的**块号**（`switch` 用；热路径不用）。
fn blk_of(a: ptr, fi: u32, lo: u32, ll: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
    let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
    let i: u32 = 0;
    while i < nb {
        let o: u32 = rd(a, B_OFF, (fb + i) * 5);
        let l: u32 = rd(a, B_OFF, (fb + i) * 5 + 1);
        if l == ll && same(a, lo, a, o, ll) {
            return fb + i;
        }
        i = i + 1;
    }
    return NONE;
}

// ---------------------------------------------------------------- 解析
//
// **解析成表**，不边扫边解释：名字 / 类型 / 文本全是**输入文本里的 span**（子串不拷贝），
// 指令的种类在解析期算好。两趟：① 记录；② 把 `br` 的目标标签**解析成块号** ——
// 分支是热路径，不能每条都线性找块（`docs/243` §3.2）。

/// 指令的第一个词 -> (种类 << 32) | 副码。
fn kind_at(a: ptr, s: u32, e: u32) -> u64 {
    let w: u64 = wspan(a, s, e);
    let o: u32 = hi32(w);
    let l: u32 = lo32(w);
    if eqw(a, o, l, "alloca") {
        return (K_ALLOCA as u64) << 32;
    }
    if eqw(a, o, l, "load") {
        return (K_LOAD as u64) << 32;
    }
    if eqw(a, o, l, "store") {
        return (K_STORE as u64) << 32;
    }
    if eqw(a, o, l, "getelementptr") {
        return (K_GEP as u64) << 32;
    }
    if eqw(a, o, l, "extractvalue") {
        return (K_EXTRV as u64) << 32;
    }
    if eqw(a, o, l, "insertvalue") {
        return (K_INSV as u64) << 32;
    }
    if eqw(a, o, l, "icmp") {
        return ((K_ICMP as u64) << 32) | (icmp_pred(a, after_op(a, o, e), e) as u64);
    }
    if eqw(a, o, l, "sdiv") {
        return (K_SDIV as u64) << 32;
    }
    if eqw(a, o, l, "udiv") {
        return (K_UDIV as u64) << 32;
    }
    if eqw(a, o, l, "srem") {
        return (K_SREM as u64) << 32;
    }
    if eqw(a, o, l, "urem") {
        return (K_UREM as u64) << 32;
    }
    if eqw(a, o, l, "add") {
        return (K_ADD as u64) << 32;
    }
    if eqw(a, o, l, "sub") {
        return (K_SUB as u64) << 32;
    }
    if eqw(a, o, l, "mul") {
        return (K_MUL as u64) << 32;
    }
    if eqw(a, o, l, "and") {
        return (K_AND as u64) << 32;
    }
    if eqw(a, o, l, "or") {
        return (K_OR as u64) << 32;
    }
    if eqw(a, o, l, "xor") {
        return (K_XOR as u64) << 32;
    }
    if eqw(a, o, l, "shl") {
        return (K_SHL as u64) << 32;
    }
    if eqw(a, o, l, "lshr") {
        return (K_LSHR as u64) << 32;
    }
    if eqw(a, o, l, "ashr") {
        return (K_ASHR as u64) << 32;
    }
    if eqw(a, o, l, "trunc") {
        return (K_TRUNC as u64) << 32;
    }
    if eqw(a, o, l, "zext") {
        return (K_ZEXT as u64) << 32;
    }
    if eqw(a, o, l, "sext") {
        return (K_SEXT as u64) << 32;
    }
    if eqw(a, o, l, "ptrtoint") {
        return (K_PTRTOINT as u64) << 32;
    }
    if eqw(a, o, l, "inttoptr") {
        return (K_INTTOPTR as u64) << 32;
    }
    if eqw(a, o, l, "unreachable") {
        return (K_UNREACH as u64) << 32;
    }
    if eqw(a, o, l, "phi") {
        return (K_PHI as u64) << 32;
    }
    if eqw(a, o, l, "switch") {
        return (K_SWITCH as u64) << 32;
    }
    if eqw(a, o, l, "ret") {
        return (K_RET as u64) << 32;
    }
    if eqw(a, o, l, "br") {
        let p: u32 = after_op(a, o, e);
        if has_at(a, p, e, "label") {
            return (K_BR_UNCOND as u64) << 32;
        }
        return (K_BR_COND as u64) << 32;
    }
    if eqw(a, o, l, "call") {
        if is_asm_call(a, o, e) {
            return (K_ASMCALL as u64) << 32;
        }
        return (K_CALL as u64) << 32;
    }
    return 0;
}

fn icmp_pred(a: ptr, p: u32, e: u32) -> u32 {
    let s: u64 = wspan(a, p, e);
    let o: u32 = hi32(s);
    let l: u32 = lo32(s);
    if eqw(a, o, l, "eq") {
        return P_EQ;
    }
    if eqw(a, o, l, "ne") {
        return P_NE;
    }
    if eqw(a, o, l, "ugt") {
        return P_UGT;
    }
    if eqw(a, o, l, "uge") {
        return P_UGE;
    }
    if eqw(a, o, l, "ult") {
        return P_ULT;
    }
    if eqw(a, o, l, "ule") {
        return P_ULE;
    }
    if eqw(a, o, l, "sgt") {
        return P_SGT;
    }
    if eqw(a, o, l, "sge") {
        return P_SGE;
    }
    if eqw(a, o, l, "slt") {
        return P_SLT;
    }
    return P_SLE;
}

/// `call <retty> asm sideeffect …` ？跳过返回类型再看下一个词。
fn is_asm_call(a: ptr, s: u32, e: u32) -> bool {
    let p: u32 = after_op(a, s, e);
    if has_at(a, p, e, "void") {
        p = skip_sp(a, p + 4, e);
    } else {
        let ts: u64 = ty_span(a, p, e);
        p = skip_sp(a, hi32(ts) + lo32(ts), e);
    }
    return has_at(a, p, e, "asm");
}

/// 一条记录写进指令表，返回它的下标。
fn put_instr(a: ptr, do_: u32, dl: u32, to: u32, tl: u32, k: u32, sub: u32) -> u32 {
    let ni: u32 = ctx_get(a, C_NI);
    if ni >= MAX_INSTRS {
        fail("指令表满了");
    }
    wr(a, I_OFF, ni * 8, do_);
    wr(a, I_OFF, ni * 8 + 1, dl);
    wr(a, I_OFF, ni * 8 + 2, to);
    wr(a, I_OFF, ni * 8 + 3, tl);
    wr(a, I_OFF, ni * 8 + 4, k);
    wr(a, I_OFF, ni * 8 + 5, sub);
    wr(a, I_OFF, ni * 8 + 6, 0);                     // first_edge（解析收尾时回填）
    wr(a, I_OFF, ni * 8 + 7, 0);                     // nedges
    ctx_set(a, C_NI, ni + 1);
    return ni;
}

fn add_block(a: ptr, lo: u32, ll: u32) -> u32 {
    let nb: u32 = ctx_get(a, C_NB);
    if nb >= MAX_BLOCKS {
        fail("基本块表满了");
    }
    w2(a, B_OFF, nb * 5, lo, ll);
    wr(a, B_OFF, nb * 5 + 2, ctx_get(a, C_NI));   // first_instr（先记，收尾时才知个数）
    wr(a, B_OFF, nb * 5 + 3, 0);
    wr(a, B_OFF, nb * 5 + 4, 0);                     // T1：这一块被进过几次
    ctx_set(a, C_NB, nb + 1);
    return nb;
}

/// 数一段文本里 `label` 出现几次 —— `switch` 的边数靠它（`[...]` 里有几个 `label`
/// 就有几条 case 边，再加上外面那个 default）。
fn count_label(a: ptr, s: u32, e: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = s;
    while i + 5 <= e {
        if same(a, i, str_ptr("label"), 0, 5) {
            n = n + 1;
            i = i + 5;
        } else {
            i = i + 1;
        }
    }
    return n;
}

/// 给一条分支指令分 `n` 行边表，行号记在指令记录里。**O(1) 记账**就靠这个：
/// 运行时记一条边是 `E_OFF + (first_edge + edge) * 4`，不用查表（`docs/247` §4）。
fn edge_alloc(a: ptr, i: u32, n: u32) {
    let base: u32 = ctx_get(a, C_NEDGE);
    if base + n > MAX_EDGES {
        fail("边表满了 —— 抬 MAX_EDGES");
    }
    wr(a, I_OFF, i * 8 + 6, base);
    wr(a, I_OFF, i * 8 + 7, n);
    let k: u32 = 0;
    while k < n {
        wr(a, E_OFF, base + k, 0);
        k = k + 1;
    }
    ctx_set(a, C_NEDGE, base + n);
}

/// 把函数里所有 `br` 的目标标签解析成块号（第二趟）。分支在热路径上，这一步省不得。
/// T1 顺带**给每条分支分边表** —— 同一趟走完，不另开一轮。
fn resolve_brs(a: ptr, fi: u32, tso: u32, tsl: u32) {
    let nt: u32 = ctx_get(a, C_NI);
    let i: u32 = tso;
    while i < tsl {
        let k: u32 = rd(a, I_OFF, i * 8 + 4);
        if k == K_BR_UNCOND || k == K_BR_COND {
            let e: u32 = rd(a, I_OFF, i * 8 + 2) + rd(a, I_OFF, i * 8 + 3);
            let p: u32 = rd(a, I_OFF, i * 8 + 2);
            let sub: u32 = br_sub(a, fi, p, e, k);
            wr(a, I_OFF, i * 8 + 5, sub);
            if k == K_BR_UNCOND {
                edge_alloc(a, i, 1);
            } else {
                edge_alloc(a, i, 2);
            }
        } else if k == K_SWITCH {
            let to: u32 = rd(a, I_OFF, i * 8 + 2);
            let tl: u32 = rd(a, I_OFF, i * 8 + 3);
            edge_alloc(a, i, count_label(a, to, to + tl) + 1);
        }
        i = i + 1;
    }
}

fn br_sub(a: ptr, fi: u32, p: u32, e: u32, k: u32) -> u32 {
    if k == K_BR_UNCOND {
        let lab: u32 = lab_after(a, after_op(a, p, e), e);
        let lw: u64 = wspan(a, lab, e);
        return blk_of(a, fi, hi32(lw), lo32(lw));
    }
    let ts: u64 = ty_span(a, after_op(a, p, e), e);      // i1
    let q: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let qe: u32 = seg_end(a, q, e);
    let lp: u32 = lab_after(a, qe + 1, e);
    let lw: u64 = wspan(a, lp, e);
    let a1: u32 = blk_of(a, fi, hi32(lw), lo32(lw));
    let q2: u32 = seg_next(a, lp + lo32(lw), e);
    let qe2: u32 = seg_end(a, q2, e);
    let lp2: u32 = lab_after(a, q2, e);
    let lw2: u64 = wspan(a, lp2, e);
    let a2: u32 = blk_of(a, fi, hi32(lw2), lo32(lw2));
    return ((a1 & 65535) << 16) | (a2 & 65535);
}

/// `label %foo` 里 `%foo` 的起点（跳过 `label` 与 `%` 与空白）。
fn lab_after(a: ptr, p: u32, e: u32) -> u32 {
    let q: u32 = skip_sp(a, p, e);
    if has_at(a, q, e, "label") {
        q = skip_sp(a, q + 5, e);
    }
    if q < e && load8(a, q) == 37 {
        q = q + 1;
    }
    return q;
}

fn parse_global(a: ptr, s: u32, e: u32) {
    let ng: u32 = ctx_get(a, C_NG);
    if ng >= MAX_GLOBALS {
        fail("全局表满了");
    }
    let nt: u64 = wspan(a, s, e);                        // @name
    let p: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    if p < e && load8(a, p) == 61 {                      // '='
        p = p + 1;
    }
    p = skip_sp(a, p, e);
    // 属性关键字可以叠好几个：一次吃一个，直到吃不动
    let go: u32 = 1;
    while go == 1 {
        if has_at(a, p, e, "private") {
            p = skip_sp(a, p + 7, e);
        } else if has_at(a, p, e, "internal") {
            p = skip_sp(a, p + 8, e);
        } else if has_at(a, p, e, "external") {
            p = skip_sp(a, p + 8, e);
        } else if has_at(a, p, e, "unnamed_addr") {
            p = skip_sp(a, p + 12, e);
        } else if has_at(a, p, e, "dso_local") {
            p = skip_sp(a, p + 9, e);
        } else if has_at(a, p, e, "constant") {
            p = skip_sp(a, p + 8, e);
        } else if has_at(a, p, e, "global") {
            p = skip_sp(a, p + 6, e);
        } else if has_at(a, p, e, "common") {
            p = skip_sp(a, p + 6, e);
        } else {
            go = 0;
        }
    }
    let ts: u64 = ty_span(a, p, e);
    let is: u64 = trim_span(a, hi32(ts) + lo32(ts), e);
    w2(a, G_OFF, ng * 6, hi32(nt), lo32(nt));
    w2(a, G_OFF, ng * 6 + 2, hi32(ts), lo32(ts));
    w2(a, G_OFF, ng * 6 + 4, hi32(is), lo32(is));
    ctx_set(a, C_NG, ng + 1);
}

/// 解析一个函数。`i0` = 函数头之后那一行的起点；返回 `}` 之后那一行的起点。
fn parse_func(a: ptr, s: u32, e: u32, i0: u32, n: u32) -> u32 {
    let nf: u32 = ctx_get(a, C_NF);
    if nf >= MAX_FUNCS {
        fail("函数表满了");
    }
    let p: u32 = after_op(a, s, e);                      // 跳过 "define"
    if has_at(a, p, e, "internal") {
        p = skip_sp(a, p + 8, e);
    } else if has_at(a, p, e, "private") {
        p = skip_sp(a, p + 7, e);
    }
    let rt: u64 = ty_span(a, p, e);
    let np: u32 = skip_sp(a, hi32(rt) + lo32(rt), e);
    let nt: u64 = wspan(a, np, e);                       // @name（**含 @**）
    let op: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    let cp: u32 = 0;
    let pe: u32 = 0;
    if op < e && load8(a, op) == 40 {
        cp = op + 1;
        pe = match_close(a, op, e, 40, 41);
    } else {
        fail("函数头解析失败");
    }
    let first_p: u32 = ctx_get(a, C_NP);
    let count: u32 = 0;
    let q: u32 = skip_sp(a, cp, pe);
    while q < pe {
        let qe: u32 = seg_end(a, q, pe);
        let ts: u64 = ty_span(a, q, qe);
        let ns: u32 = skip_sp(a, hi32(ts) + lo32(ts), qe);
        let ne: u32 = word_end(a, ns, qe);
        if ctx_get(a, C_NP) >= MAX_PARAMS {
            fail("形参表满了");
        }
        w2(a, P_OFF, ctx_get(a, C_NP) * 4, hi32(ts), lo32(ts));
        w2(a, P_OFF, ctx_get(a, C_NP) * 4 + 2, ns, ne - ns);
        ctx_set(a, C_NP, ctx_get(a, C_NP) + 1);
        count = count + 1;
        q = seg_next(a, qe, pe);
    }
    let first_b: u32 = ctx_get(a, C_NB);
    let first_i: u32 = ctx_get(a, C_NI);
    w2(a, F_OFF, nf * 8, hi32(nt), lo32(nt));
    w2(a, F_OFF, nf * 8 + 2, hi32(rt), lo32(rt));
    wr(a, F_OFF, nf * 8 + 4, count);
    wr(a, F_OFF, nf * 8 + 5, first_p);
    wr(a, F_OFF, nf * 8 + 6, first_b);
    wr(a, F_OFF, nf * 8 + 7, 0);
    ctx_set(a, C_NF, nf + 1);

    // ---- 函数体：一行一行走，`}` 收尾
    let cur: u32 = NONE;
    let i: u32 = i0;
    let go: u32 = 1;
    while go == 1 {
        if i >= n {
            go = 0;
        } else {
            let e2: u32 = line_end(a, i, n);
            let s2: u32 = skip_sp(a, i, e2);
            i = e2 + 1;
            if s2 < e2 {
                let c0: u32 = load8(a, s2);
                if c0 == 59 || c0 == 33 {
                    // 注释 / 元数据
                } else if e2 - s2 == 1 && c0 == 125 {
                    go = 0;
                } else {
                    // 指令可能跨行（括号没配平）—— 并到配平为止
                    let e3: u32 = e2;
                    let ok: u32 = 1;
                    while ok == 1 {
                        if unbalanced(a, s2, e3) == false {
                            ok = 0;
                        } else if e3 + 1 >= n {
                            ok = 0;
                        } else {
                            e3 = line_end(a, e3 + 1, n);
                            i = e3 + 1;
                        }
                    }
                    if body_line(a, s2, e3, nf, cur) == 1 {
                        cur = ctx_get(a, C_NB) - 1;
                    }
                }
            }
        }
    }
    // 回填各块的指令条数
    let nb: u32 = ctx_get(a, C_NB) - first_b;
    let k: u32 = 0;
    while k < nb {
        let f: u32 = rd(a, B_OFF, (first_b + k) * 5 + 2);
        let nx: u32 = first_i;
        if k + 1 < nb {
            nx = rd(a, B_OFF, (first_b + k + 1) * 5 + 2);
        } else {
            nx = ctx_get(a, C_NI);
        }
        wr(a, B_OFF, (first_b + k) * 5 + 3, nx - f);
        k = k + 1;
    }
    wr(a, F_OFF, nf * 8 + 7, nb);
    resolve_brs(a, nf, first_i, ctx_get(a, C_NI));
    return i;
}

/// 函数体里的一行：块标签还是指令？返回 1 = 新块。
fn body_line(a: ptr, s: u32, e: u32, nf: u32, cur: u32) -> u32 {
    let last: u32 = e - 1;
    if load8(a, last) == 58 && has_byte(a, s, e, 61) == false {
        // `名称:` —— 块标签
        let lo: u32 = s;
        let ll: u32 = last - s;
        let b: u32 = add_block(a, lo, ll);
        wr(a, B_OFF, b * 5 + 2, ctx_get(a, C_NI));
        return 1;
    }
    let do_: u32 = NONE;
    let dl: u32 = 0;
    let to: u32 = s;
    let tl: u32 = e - s;
    if load8(a, s) == 37 {
        let nt: u64 = wspan(a, s, e);                    // %dest
        do_ = hi32(nt);
        dl = lo32(nt);
        let eq: u32 = index_of(a, do_ + dl, e, 61);      // '='
        to = skip_sp(a, eq + 1, e);
        tl = e - to;
    }
    let k: u64 = kind_at(a, to, e);
    put_instr(a, do_, dl, to, tl, hi32(k), lo32(k));
    return 0;
}

fn parse_all(a: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        let e: u32 = line_end(a, i, n);
        let s: u32 = skip_sp(a, i, e);
        if s < e {
            let c: u32 = load8(a, s);
            if c == 64 {
                parse_global(a, s, e);
                i = e + 1;
            } else if c != 59 && c != 33 && has_at(a, s, e, "define ") {
                i = parse_func(a, s, e, e + 1, n);
            } else {
                i = e + 1;
            }
        } else {
            i = e + 1;
        }
    }
}

// ---------------------------------------------------------------- 全局摆放
//
// 全局初值直接**写进 VM 内存**（不存原始字节），地址记在全局表里 —— 于是 `@name`
// 求值就是一次查表。摆法与参考实现 `_parse_init` 同一套规则（含"值文本前面可能还带着
// 类型"那条：LLVM 的数组元素里就这么印）。

fn init_bytes(a: ptr, m: ptr, s: u32, e: u32, va: u32) {
    let i: u32 = s + 2;                                  // 跳过 `c"`
    let k: u32 = va;
    while i < e && load8(a, i) != 34 {
        let hi: u32 = hexv(load8(a, i + 1));
        let lo: u32 = hexv(load8(a, i + 2));
        store8(m, k, (hi * 16 + lo) as u8);
        i = i + 3;
        k = k + 1;
    }
}

fn init_write(a: ptr, m: ptr, off: u32, len: u32, tyo: u32, tyl: u32, va: u32) -> u32 {
    let e: u32 = off + len;
    let s: u32 = skip_sp(a, off, e);
    if e - s >= 2 && load8(a, s) == 99 && load8(a, s + 1) == 34 {
        init_bytes(a, m, s, e, va);
        return 0;
    }
    if has_at(a, s, e, "zeroinitializer") {
        return 0;                                        // 调用方先清过零
    }
    // 值文本可能还带着类型前缀（数组元素 / 结构体字段常见）
    let vo: u32 = s;
    let ve: u32 = e;
    if e - s >= tyl && same(a, s, a, tyo, tyl) {
        vo = skip_sp(a, s + tyl, e);
    }
    let c: u32 = load8(a, tyo);
    if c == 105 || c == 112 {
        let sz: u32 = ty_size(a, tyo, tyl);
        let v: u64 = dec_u64(a, vo, ve);
        mw(m, va, sz, v);
        return 0;
    }
    let bo: u32 = skip_sp(a, vo, ve);
    let be: u64 = trim_span(a, bo, ve);
    let inner_s: u32 = hi32(be) + 1;
    let inner_e: u32 = hi32(be) + lo32(be) - 1;
    let k: u32 = 0;
    let p: u32 = skip_sp(a, inner_s, inner_e);
    if c == 91 {
        let n: u32 = arr_count(a, tyo, tyl);
        let et: u64 = arr_elem(a, tyo, tyl);
        let esz: u32 = ty_size(a, hi32(et), lo32(et));
        while p < inner_e && k < n {
            let q: u32 = seg_end(a, p, inner_e);
            init_write(a, m, p, q - p, hi32(et), lo32(et), va + k * esz);
            k = k + 1;
            p = seg_next(a, q, inner_e);
        }
        return 0;
    }
    if c == 123 {
        let nf: u32 = fld_count(a, tyo, tyl);
        while p < inner_e && k < nf {
            let q: u32 = seg_end(a, p, inner_e);
            let f: u64 = fld_ty(a, tyo, tyl, k);
            let fo: u32 = fld_off(a, tyo, tyl, k);
            init_write(a, m, p, q - p, hi32(f), lo32(f), va + fo);
            k = k + 1;
            p = seg_next(a, q, inner_e);
        }
        return 0;
    }
    return fail("全局初值 T0 不支持");
}

fn place_globals(a: ptr, m: ptr) {
    let ng: u32 = ctx_get(a, C_NG);
    let i: u32 = 0;
    while i < ng {
        let ts: u64 = r2(a, G_OFF, i * 6 + 2);
        let is: u64 = r2(a, G_OFF, i * 6 + 4);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let al: u32 = 8;
        if sz < 8 {
            al = sz;
        }
        if al < 1 {
            al = 1;
        }
        let va: u32 = vm_alloc(a, sz, al);
        mz(m, va, sz);
        init_write(a, m, hi32(is), lo32(is), hi32(ts), lo32(ts), va);
        let no: u32 = rd(a, G_OFF, i * 6);
        let nl: u32 = rd(a, G_OFF, i * 6 + 1);
        if d_on(a) == 1 {
            // 全局 = 一颗体；G 表不存地址，令牌进 GD（u64 拆两格）。
            let gbi: u32 = d_body_new(a, DK_GLOBAL, sz, va);
            let gtk: u64 = d_tok_new(a, gbi, 0);
            wr(a, GD_OFF, i * 2, d_tok_lo(gtk));
            wr(a, GD_OFF, i * 2 + 1, d_tok_hi(gtk));
            i = i + 1;
        } else {
        wr(a, G_OFF, i * 6 + 4, va);                     // 这一格改存**地址**
        if ctx_get(a, C_SUB) != 0 {
            // `@__loment_heap` 是**外层容器**：它盖住所有堆对象，登记它会让每个已归还
            // 的堆地址都被"救活"。堆对象自己一条条登记，所以这块跳过。
            if eqw(a, no, nl, "@__loment_heap") {
                // 参考实现**登记**这块外层容器；这一份按地址查归属，登记它会救活所有已归还的
                // 堆地址（见 `docs/362` §5.1 那条注释）。标签序列要对齐，所以只**吃掉一个号**。
                if ctx_get(a, C_SUB) == 2 {
                    ctx_set(a, C_TAGSEQ, ctx_get(a, C_TAGSEQ) + 1);
                }
            } else {
                obj_new(a, va, va + sz, OBJ_GLOBAL);
            }
        }
        i = i + 1;
        }
    }
}

// ---------------------------------------------------------------- 求值
//
// 值有两种，**用不着标记**：每个使用点的指令文本里写着类型，调用方知道自己要的是哪种。
//   标量 -> 值本身（u64，低位；按宽度截断归 `mask_bits`）
//   聚合 -> 一段**可读地址**（VM 地址），字节就在那儿

fn operand(a: ptr, m: ptr, fr: u32, tyo: u32, tyl: u32, vo: u32, vl: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    if vl == 0 {
        wstr(2, "lvm: 操作数缺失 @");
        write_num(a, 2, vo);
        wstr(2, " vl="); write_num(a, 2, vl);
        wstr(2, " 指令: [");
        write_all(2, ptr_add(a, ctx_get(a, 84)), ctx_get(a, 88) as u64);
        wstr(2, "] 前: [");
        write_all(2, ptr_add(a, vo - 24), 24);
        wstr(2, "][");
        write_all(2, ptr_add(a, vo), 24);
        wstr(2, "]
");
        return die(2) as u64;
    }
    let c: u32 = load8(a, vo);
    if c == 37 {                                         // %name
        let i: u32 = vfind(a, m, fr, vo, vl);
        if i == NONE {
            return fail_tok(a, "读未定义的值", vo, vl) as u64;
        }
        return vget(m, fr, i);
    }
    if c == 64 {                                         // @global
        if d_on(a) == 1 {
            return d_gaddr(a, vo, vl);
        }
        return gaddr(a, vo, vl) as u64;
    }
    if c == 117 || c == 110 {                            // undef / null
        if is_agg(a, tyo, tyl) {
            if ty_size(a, tyo, tyl) > ZERO_CAP {
                return fail_tok(a, "undef 聚合比零页还大:", vo, vl) as u64;
            }
            return ZERO_ADDR as u64;
        }
        return 0;
    }
    if c == 116 {                                        // true
        return 1;
    }
    if c == 102 {                                        // false
        return 0;
    }
    return dec_u64(a, vo, vo + vl);
}

/// 求一段 **`<类型> <值>`** 文本。类型的取舍与 `lomelf.parse_operand` 一致。
fn operand_text(a: ptr, m: ptr, fr: u32, off: u32, n: u32) -> u64 {
    let ts: u64 = ty_span(a, off, n);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), n);
    let vs: u64 = trim_span(a, vo, seg_end(a, vo, n));
    return operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
}

fn bits_of(a: ptr, tyo: u32, tyl: u32) -> u32 {
    return ty_size(a, tyo, tyl) * 8;
}

/// `sdiv`/`udiv`/`srem`/`urem`。**取余要减回去** —— 参考实现第一版只给 `srem` 减了、
/// `urem` 直接返回**商**，症状是"程序跑得完、退出码也对，只是每一位数都是商"。
fn divop(a: ptr, m: ptr, fr: u32, io: u32, il: u32, k: u32) -> u64 {
    let e: u32 = io + il;
    let w: u64 = wspan(a, io, e);
    let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let a1: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p, q)), lo32(trim_span(a, p, q)));
    let p2: u32 = seg_next(a, q, e);
    let a2: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p2, e)), lo32(trim_span(a, p2, e)));
    let bits: u32 = bits_of(a, hi32(ts), lo32(ts));
    if d_on(a) == 1 && (d_is_tok(a1) == 1 || d_is_tok(a2) == 1) {
        return d_fault(a, DF_NOADDR, a1, 0, 0, 8, 1, io, il, 0, 0) as u64;
    }
    let sgn: u32 = 0;
    if k == K_SDIV || k == K_SREM {
        sgn = 1;
    }
    let na: u64 = a1;
    let nb: u64 = a2;
    // ⚠ 这里**不能写 `bool != bool`** —— 自举侧把它的结果发成 `i64`（参考实现发 `i1`），
    // clang 直接拒（`'%t' defined with type 'i1' but expected 'i64'`）。用两个 u32 记符号
    // 就绕开了。**这是自举侧独有的**：参考实现这里发的是 `i1`。见 issue #316。
    let nga: u32 = 0;
    let ngb: u32 = 0;
    if sgn == 1 {
        if (a1 as i64) < 0 {
            na = (0 as u64) - a1;
            nga = 1;
        }
        if (a2 as i64) < 0 {
            nb = (0 as u64) - a2;
            ngb = 1;
        }
    }
    if nb == 0 {
        fail("除以零");
    }
    let qv: u64 = na / nb;
    if sgn == 1 && nga != ngb {
        return mask_bits_for(k, a1, a2, (0 as u64) - qv, bits);
    }
    return mask_bits_for(k, a1, a2, qv, bits);
}

fn mask_bits_for(k: u32, a1: u64, a2: u64, qv: u64, bits: u32) -> u64 {
    if k == K_SREM || k == K_UREM {
        return mask_bits(a1 - (a2 * qv), bits);
    }
    return mask_bits(qv, bits);
}

/// 算术/位运算。`shl`/`lshr`/`ashr` 的移位量 ≥ 位宽时按参考实现的口径收尾
/// （Python 那边是"先移位再截断"，位移 ≥64 得 0 或全 1）。
fn arith(a: ptr, m: ptr, fr: u32, io: u32, il: u32, k: u32) -> u64 {
    let e: u32 = io + il;
    let w: u64 = wspan(a, io, e);
    let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let a1: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p, q)), lo32(trim_span(a, p, q)));
    let p2: u32 = seg_next(a, q, e);
    let a2: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p2, e)), lo32(trim_span(a, p2, e)));
    let bits: u32 = bits_of(a, hi32(ts), lo32(ts));
    if d_on(a) == 1 && (d_is_tok(a1) == 1 || d_is_tok(a2) == 1) {
        if k == K_ADD {
            if d_is_tok(a1) == 1 && d_is_tok(a2) == 1 {
                return d_fault(a, DF_NOORDER, 0, 0, 0, 8, 0, io, il, 0, 0) as u64;
            }
            if d_is_tok(a1) == 1 {
                return d_derive(a, a1, a2 as u32, io, il, 0, 0);
            }
            return d_derive(a, a2, a1 as u32, io, il, 0, 0);
        }
        if k == K_SUB {
            if d_is_tok(a1) == 1 && d_is_tok(a2) == 1 {
                let x1: u32 = d_find(a, a1);
                let x2: u32 = d_find(a, a2);
                if x1 == NONE || x2 == NONE {
                    return d_fault(a, DF_DANGLING, 0, 0, 0, 8, 0, io, il, 0, 0) as u64;
                }
                let b1: u32 = rd(a, DT_OFF, x1 * 4 + 2);
                let b2: u32 = rd(a, DT_OFF, x2 * 4 + 2);
                if b1 != b2 {
                    return d_fault(a, DF_NOORDER, 0, 0, 0, 8, 0, io, il, 0, 0) as u64;
                }
                let o1: u32 = rd(a, DT_OFF, x1 * 4 + 3);
                let o2: u32 = rd(a, DT_OFF, x2 * 4 + 3);
                return mask_bits((o1 - o2) as u64, bits);
            }
            if d_is_tok(a1) == 1 {
                return d_derive(a, a1, (0 - a2) as u32, io, il, 0, 0);
            }
            return d_fault(a, DF_NOORDER, 0, 0, 0, 8, 0, io, il, 0, 0) as u64;
        }
        return d_fault(a, DF_NOADDR, 0, 0, 0, 8, 0, io, il, 0, 0) as u64;
    }
    // issue #717：移位量按**指令上写的宽度**读成有符号数 —— 负数不是值，是一个错。
    // 参考实现那边抛 `LvmError("移位量是负数")`；这里报同一句话（`fail` 退 2）。
    // 以前 `-1` 在这里是 u64 的最大值，于是静默返回一个值（`ashr` 走符号位那支），
    // 而参考实现抛一条 Python traceback —— 三种实现三种答案。
    if k == K_SHL || k == K_LSHR || k == K_ASHR {
        if (a2 & ((1 as u64) << ((bits - 1) as u64))) != 0 {
            return fail("移位量是负数") as u64;
        }
    }
    if k == K_ASHR {
        return mask_bits(ashr64(a1, a2, bits), bits);
    }
    if (k == K_SHL || k == K_LSHR) && a2 >= 64 {
        return 0;
    }
    let v: u64 = 0;
    if k == K_ADD {
        v = a1 + a2;
    } else if k == K_SUB {
        v = a1 - a2;
    } else if k == K_MUL {
        v = a1 * a2;
    } else if k == K_AND {
        v = a1 & a2;
    } else if k == K_OR {
        v = a1 | a2;
    } else if k == K_XOR {
        v = a1 ^ a2;
    } else if k == K_SHL {
        v = a1 << a2;
    } else {
        v = a1 >> a2;
    }
    return mask_bits(v, bits);
}

fn ashr64(a1: u64, a2: u64, bits: u32) -> u64 {
    let sign: u64 = a1 & (((1 as u64) << ((bits - 1) as u64)));
    if a2 >= 64 {
        if sign != 0 {
            return (0 as u64) - 1;
        }
        return 0;
    }
    let v: u64 = a1 >> a2;
    if sign == 0 {
        return v;
    }
    if a2 == 0 {
        return v;
    }
    if a2 >= (bits as u64) {
        return ((1 as u64) << (bits as u64)) - 1;
    }
    return v | ((((1 as u64) << a2) - 1) << (((bits as u64) - a2)));
}

/// 比较。有符号那四个走"翻符号位再按无符号比"——等价且不用做符号扩展。
fn icmp(a: ptr, m: ptr, fr: u32, io: u32, il: u32, sub: u32) -> u64 {
    let e: u32 = io + il;
    // ⚠ `icmp` 的谓词夹在算子和类型**中间**（`icmp ult i32 %a, %b`）—— 少跳这一格，
    // 类型就读成了 `ult`（`ty_size` 认不出，回落到 8 字节），而**操作数的跨度从
    // `i32 %a` 那个 `i` 起**，于是 `dec_u64` 读出 0：两边都成了常量，循环条件永远为真。
    let w: u64 = wspan(a, io, e);                                  // icmp
    let pd: u64 = wspan(a, hi32(w) + lo32(w), e);                  // 谓词
    let ts: u64 = ty_span(a, hi32(pd) + lo32(pd), e);              // 类型
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let a1: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p, q)), lo32(trim_span(a, p, q)));
    let p2: u32 = seg_next(a, q, e);
    let a2: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p2, e)), lo32(trim_span(a, p2, e)));
    let bits: u32 = bits_of(a, hi32(ts), lo32(ts));
    if d_on(a) == 1 && (d_is_tok(a1) == 1 || d_is_tok(a2) == 1) {
        if sub == P_EQ || sub == P_NE {
            let same1: u32 = 0;
            if d_is_tok(a1) == 1 && d_is_tok(a2) == 1 && a1 == a2 {
                same1 = 1;
            }
            if (sub == P_EQ && same1 == 1) || (sub == P_NE && same1 == 0) {
                return 1;
            }
            return 0;
        }
        if d_is_tok(a1) == 1 && d_is_tok(a2) == 1 {
            let x1: u32 = d_find(a, a1);
            let x2: u32 = d_find(a, a2);
            if x1 != NONE && x2 != NONE
                    && rd(a, DT_OFF, x1 * 4 + 2) == rd(a, DT_OFF, x2 * 4 + 2) {
                let o1: u64 = rd(a, DT_OFF, x1 * 4 + 3) as u64;
                let o2: u64 = rd(a, DT_OFF, x2 * 4 + 3) as u64;
                let r2: u32 = 0;
                if sub == P_UGT && o1 > o2 { r2 = 1; }
                if sub == P_UGE && o1 >= o2 { r2 = 1; }
                if sub == P_ULT && o1 < o2 { r2 = 1; }
                if sub == P_ULE && o1 <= o2 { r2 = 1; }
                if sub == P_SGT && o1 > o2 { r2 = 1; }
                if sub == P_SGE && o1 >= o2 { r2 = 1; }
                if sub == P_SLT && o1 < o2 { r2 = 1; }
                if sub == P_SLE && o1 <= o2 { r2 = 1; }
                return r2 as u64;
            }
        }
        return d_fault(a, DF_NOORDER, 0, 0, 0, 8, 0, io, il, 0, 0) as u64;
    }
    let sm: u64 = (1 as u64) << ((bits - 1) as u64);
    let x: u64 = a1 ^ sm;
    let y: u64 = a2 ^ sm;
    let r: u32 = 0;
    if sub == P_EQ {
        if a1 == a2 {
            r = 1;
        }
    } else if sub == P_NE {
        if a1 != a2 {
            r = 1;
        }
    } else if sub == P_UGT {
        if a1 > a2 {
            r = 1;
        }
    } else if sub == P_UGE {
        if a1 >= a2 {
            r = 1;
        }
    } else if sub == P_ULT {
        if a1 < a2 {
            r = 1;
        }
    } else if sub == P_ULE {
        if a1 <= a2 {
            r = 1;
        }
    } else if sub == P_SGT {
        if x > y {
            r = 1;
        }
    } else if sub == P_SGE {
        if x >= y {
            r = 1;
        }
    } else if sub == P_SLT {
        if x < y {
            r = 1;
        }
    } else if sub == P_SLE {
        if x <= y {
            r = 1;
        }
    }
    return r as u64;
}

fn cast_op(a: ptr, m: ptr, fr: u32, io: u32, il: u32, k: u32) -> u64 {
    let e: u32 = io + il;
    let w: u64 = wspan(a, io, e);                        // 算子（已经知道，跳过）
    let fts: u64 = ty_span(a, hi32(w) + lo32(w), e);
    let p: u32 = skip_sp(a, hi32(fts) + lo32(fts), e);
    // 转型的值后面跟的是 ` to <类型>`，**不是逗号** —— 值记号到空白为止
    // （参考实现的正则是 `(\w+) (\S+) to (\w+)`，`\S+` 就是这个意思）。
    let vs: u64 = trim_span(a, p, word_end(a, p, e));
    let a1: u64 = operand(a, m, fr, hi32(fts), lo32(fts), hi32(vs), lo32(vs));
    if k == K_PTRTOINT || k == K_INTTOPTR {
        if d_on(a) == 1 {
            return d_fault(a, DF_NOADDR, a1, 0, 0, 8, 1, io, il, 0, 0) as u64;
        }
        return a1;
    }
    if k == K_TRUNC {
        let tw: u64 = wspan(a, index_of(a, hi32(vs) + lo32(vs), e, 116) + 2, e);
        return mask_bits(a1, bits_of(a, hi32(tw), lo32(tw)));
    }
    let fbits: u32 = bits_of(a, hi32(fts), lo32(fts));
    if k == K_ZEXT {
        return mask_bits(a1, fbits);
    }
    // sext：先按源位宽取有符号值，再截到目标位宽
    let tw: u64 = wspan(a, index_of(a, hi32(vs) + lo32(vs), e, 116) + 2, e);
    let tbits: u32 = bits_of(a, hi32(tw), lo32(tw));
    let sv: u64 = a1;
    if fbits < 64 {
        let hi: u64 = sv & (((1 as u64) << ((fbits - 1) as u64)));
        if hi != 0 {
            sv = sv | (((0 as u64) - 1) - ((((1 as u64) << (fbits as u64))) - 1));
        }
    }
    return mask_bits(sv, tbits);
}

/// `getelementptr`。索引的走法与 `lvm.py._gep` **逐条同**：第 0 步是"把指针挪过
/// 整个基类型"，之后数组脱一层、结构体按**字段偏移**（只认常量下标）。
fn gep(a: ptr, m: ptr, fr: u32, io: u32, il: u32) -> u64 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    if has_at(a, p, e, "inbounds") {
        p = skip_sp(a, p + 8, e);
    }
    let ts: u64 = ty_span(a, p, e);
    let cur_o: u32 = hi32(ts);
    let cur_l: u32 = lo32(ts);
    let op: u32 = seg_next(a, cur_o + cur_l, e);
    let base: u64 = operand_text(a, m, fr, op, seg_end(a, op, e));
    let co_o: u32 = cur_o;
    let co_l: u32 = cur_l;
    let acc: u32 = 0;
    let k: u32 = 0;
    let q: u32 = seg_next(a, seg_end(a, op, e), e);
    while q < e {
        let qe: u32 = seg_end(a, q, e);
        let idx: u64 = operand_text(a, m, fr, q, qe);
        if k == 0 {
            acc = acc + (idx as u32) * ty_size(a, co_o, co_l);
        } else if load8(a, co_o) == 91 {
            let et: u64 = arr_elem(a, co_o, co_l);
            co_o = hi32(et);
            co_l = lo32(et);
            acc = acc + (idx as u32) * ty_size(a, co_o, co_l);
        } else if load8(a, co_o) == 123 {
            let f: u64 = fld_ty(a, co_o, co_l, idx as u32);
            acc = acc + fld_off(a, co_o, co_l, idx as u32);
            co_o = hi32(f);
            co_l = lo32(f);
        } else {
            return fail_tok(a, "GEP 的这一步 T0 没实现:", io, il) as u64;
        }
        k = k + 1;
        q = seg_next(a, qe, e);
    }
    if d_on(a) == 1 && d_is_tok(base) == 1 {
        return d_derive(a, base, acc, io, il, 0, 0);
    }
    return base + (acc as u64);
}

fn extractvalue(a: ptr, m: ptr, fr: u32, io: u32, il: u32, do_: u32, dl: u32) -> u64 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let vs: u64 = trim_span(a, p, q);
    let agg: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
    let p2: u32 = seg_next(a, q, e);
    let idx: u32 = dec_u64(a, p2, seg_end(a, p2, e)) as u32;
    let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
    let fo: u32 = fld_off(a, hi32(ts), lo32(ts), idx);
    let fsz: u32 = ty_size(a, hi32(f), lo32(f));
    if is_agg(a, hi32(f), lo32(f)) {
        let d: u32 = fr_agg(a, m, fr, do_, dl, fsz);
        mc(m, d, (agg as u32) + fo, fsz);
        return (d as u64) | (((fsz as u64)) << 32);
    }
    return mr(m, (agg as u32) + fo, fsz);
}

fn insertvalue(a: ptr, m: ptr, fr: u32, io: u32, il: u32, do_: u32, dl: u32) -> u64 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let bs: u64 = trim_span(a, p, q);
    let base: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(bs), lo32(bs));
    let p2: u32 = seg_next(a, q, e);
    let q2: u32 = seg_end(a, p2, e);
    let val: u64 = operand_text(a, m, fr, p2, q2);
    let p3: u32 = seg_next(a, q2, e);
    let idx: u32 = dec_u64(a, p3, seg_end(a, p3, e)) as u32;
    let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
    let fo: u32 = fld_off(a, hi32(ts), lo32(ts), idx);
    let fsz: u32 = ty_size(a, hi32(f), lo32(f));
    let d: u32 = fr_agg(a, m, fr, do_, dl, sz);
    mc(m, d, base as u32, sz);
    if is_agg(a, hi32(f), lo32(f)) {
        mc(m, d + fo, val as u32, fsz);
    } else {
        mw(m, d + fo, fsz, val);
    }
    return (d as u64) | (((sz as u64)) << 32);
}

/// 被解释程序唯一能出去的门（`docs/243` §3.4）。表里没有的**点名拒**。
/// `openat` 的那个路径**恰好**是 `/proc/self/cmdline` 吗（末尾的 NUL 也要对上）。
fn lit_is_cmdline(m: ptr, p: u32) -> bool {
    if load8(m, p + str_len("/proc/self/cmdline")) != 0 {
        return false;
    }
    return same(m, p, str_ptr("/proc/self/cmdline"), 0, str_len("/proc/self/cmdline"));
}

fn vm_syscall(a: ptr, m: ptr, nr: u64, x1: u64, x2: u64, x3: u64) -> u64 {
    if nr == 0 {                                         // read(fd, buf, count)
        // 解释器**没有真的文件描述符** —— 只认识 257 开的那个合成文件（`docs/243` §3.4）。
        // 别的 fd **点名拒**：VM 里没有文件系统，装作有就是给错答案。
        if ctx_get(a, C_VFD_OPEN) == 0 {
            fail("系统调用 read：合成文件还没打开");
        }
        if x1 != ctx_get(a, C_VFD_OPEN) as u64 {
            fail("系统调用 read：这个 fd 不是 VM 合成的那一个");
        }
        let rw: u32 = x3 as u32;
        let ro: u32 = ctx_get(a, C_ARG0);
        let rk: u32 = ctx_get(a, C_VFD_POS);
        let rl: u32 = ctx_get(a, C_ARG0N) - rk;
        if rw < rl {
            rl = rw;
        }
        let ab: ptr = ptr_add(a, ARGV_OFF);
        let ri: u32 = 0;
        if d_on(a) == 1 {
            let rloc: u64 = d_loc(a, x2, rw, 0, 0, 0, 0);
            let rbi: u32 = hi32(rloc);
            let roff: u32 = lo32(rloc);
            while ri < rl {
                d_cput(a, rbi, roff + ri, load8(ab, ro + rk + ri) as u32);
                ri = ri + 1;
            }
        } else {
            let rp: u32 = x2 as u32;
            if rp + rl > MEM_SIZE {
                fail("系统调用 read：越界");
            }
            while ri < rl {
                store8(m, rp + ri, load8(ab, ro + rk + ri) as u8);
                ri = ri + 1;
            }
        }
        ctx_set(a, C_VFD_POS, rk + rl);
        return rl as u64;
    }
    if nr == 3 {                                         // close(fd)
        if ctx_get(a, C_VFD_OPEN) == 0 || x1 != ctx_get(a, C_VFD_OPEN) as u64 {
            fail("系统调用 close：这个 fd 不是 VM 合成的那一个");
        }
        ctx_set(a, C_VFD_OPEN, 0);
        return 0;
    }
    if nr == 1 {                                         // write(fd, buf, count)
        let fd: u64 = x1;
        let n: u32 = x3 as u32;
        if d_on(a) == 1 {
            // 体里没有连续字节：按格搬进宿主暂存再交出去（每段 ≤ IOS_CAP）。
            let wloc: u64 = d_loc(a, x2, n, 0, 0, 0, 0);
            let wbi: u32 = hi32(wloc);
            let woff: u32 = lo32(wloc);
            let done: u32 = 0;
            while done < n {
                let chunk: u32 = n - done;
                if chunk > IOS_CAP {
                    chunk = IOS_CAP;
                }
                let k: u32 = 0;
                while k < chunk {
                    store8(ptr_add(a, IOS_OFF), k, d_cget(a, wbi, woff + done + k) as u8);
                    k = k + 1;
                }
                if fd == 1 || fd == 2 {
                    let _w: u64 = write_all(1, ptr_add(a, IOS_OFF), chunk as u64);
                }
                done = done + chunk;
            }
            return n as u64;
        }
        let buf: u32 = x2 as u32;
        if buf + n > MEM_SIZE {
            fail("write 越界");
        }
        if fd == 1 || fd == 2 {
            write_all(1, ptr_add(m, buf), n as u64);
        }
        return n as u64;
    }
    if nr == 12 && d_on(a) == 1 {
        let _f: u32 = d_fault(a, DF_NOORDER, x1, 0, 0, 8, 0, 0, 0, 0, 0);
        return 0;
    }
    if nr == 12 {                                        // brk(addr)
        let want: u32 = x1 as u32;
        let h: u32 = ctx_get(a, C_HEAP);
        if want != 0 && h <= want && want < STACK_LIMIT {
            if ctx_get(a, C_SUB) != 0 && want > h {
                // 与参考的 `grant_brk` 同形：同一块 `brk` 只登记一次，之后只延长上界。
                let pos: u32 = obj_find_pos(a, h);
                if pos < ctx_get(a, C_NOBJ) && obj_base(a, pos) == h
                        && obj_kind(a, pos) == OBJ_BRK {
                    wr(a, OBJ_OFF, pos * 5 + 1, want);
                } else {
                    obj_new(a, h, want, OBJ_BRK);
                }
            }
            ctx_set(a, C_HEAP, want);
        }
        return ctx_get(a, C_HEAP) as u64;
    }
    if nr == 39 {                                        // getpid
        // 如实转出去：这是**这台机器的事实**。
        return syscall4(39, 0, 0, 0) as u64;
    }
    if nr == 63 {                                        // uname(struct utsname *p)
        // ⚠ **合成，不转宿主** —— 它描述的是**目标平台**（`docs/243` §3.4）：
        // 宿主是什么都不影响，这里给的就是 `Linux`，判据 A 才有意义。
        if d_on(a) == 1 {
            let uloc: u64 = d_loc(a, x1, 390, 0, 0, 0, 0);
            let ubi: u32 = hi32(uloc);
            let uoff: u32 = lo32(uloc);
            d_zero(a, uloc, 390);
            d_cput(a, ubi, uoff, 76);          // L
            d_cput(a, ubi, uoff + 1, 105);     // i
            d_cput(a, ubi, uoff + 2, 110);     // n
            d_cput(a, ubi, uoff + 3, 117);     // u
            d_cput(a, ubi, uoff + 4, 120);     // x
            return 0;
        }
        let up: u32 = x1 as u32;
        if up + 390 > MEM_SIZE {
            fail("uname 越界");
        }
        mz(m, up, 390);
        store8(m, up, 76 as u8);          // L
        store8(m, up + 1, 105 as u8);     // i
        store8(m, up + 2, 110 as u8);     // n
        store8(m, up + 3, 117 as u8);     // u
        store8(m, up + 4, 120 as u8);     // x
        return 0;
    }
    if nr == 201 {                                       // time(NULL)
        if d_on(a) == 1 {
            // `docs/373`：dismemory 下时间也在观察代数里，按已执行指令数给虚拟秒。
            return (ctx_get(a, C_STEPS) / 1000) as u64;
        }
        return syscall4(201, 0, 0, 0) as u64;
    }
    if nr == 228 {                                       // clock_gettime(id, struct timespec *)
        // `lgc` 的预算读它（`docs/309`）。与 `tools/lvm.py` 那一条同一个口径：钟的
        // **绝对值**不是判决面（窗口只比先后与差），所以直接用宿主那一只。
        // Linux x86-64 的 `timespec` 是两个 i64（秒、纳秒）—— 按 guest 的字节序写回。
        let tb: ptr = ctx_get(a, C_TSBUF) as ptr;
        let tsloc: u64 = 0;
        let tsd: u32 = 0;
        let tsgo: u32 = 0;
        if d_on(a) == 1 {
            tsloc = d_loc(a, x2, 16, 0, 0, 0, 0);
            tsgo = 1;
        }
        let sec: u64 = 0;
        let nsec: u64 = 0;
        if d_on(a) == 1 {
            // 与参考同一条口径（`docs/373`）：1 条已执行指令 = 1 ms 的虚拟钟。
            let ns: u64 = (ctx_get(a, C_STEPS) as u64) * 1000000;
            sec = ns / 1000000000;
            nsec = ns % 1000000000;
        } else {
            let rr: i64 = syscall4(228, x1, tb as u64, 0);
            if rr < 0 {
                return rr as u64;                        // 与内核同侧：读不到就回负值
            }
            sec = mr(tb, 0, 8);
            nsec = mr(tb, 8, 8);
        }
        if tsgo == 1 {
            d_write(a, tsloc, 8, sec);
            d_write(a, tsloc + 8, 8, nsec);
        } else {
            mw(m, x2 as u32, 8, sec);
            mw(m, x2 as u32 + 8, 8, nsec);
        }
        return 0;
    }
    // ⚠ 317 在这里**不实现** —— 它在 Linux 上是 `seccomp` 不是 `getrandom`
    // （见 `tools/lvm.py` 同一处的注释，那是判据 A 纠出来的）。
    if nr == 257 {                                       // openat(dirfd, path, flags)
        // **只认识 `/proc/self/cmdline`**，而且给它的是**被解释程序自己的**命令行，
        // 不是解释器的（下面 `run` 里那段）。别的路径**点名拒**（`docs/243` §3.4）。
        if d_on(a) == 1 {
            let cloc: u64 = d_loc(a, x2, 1, 0, 0, 0, 0);
            if d_eq_lit(a, cloc, "/proc/self/cmdline") == 1 {
                ctx_set(a, C_VFD_OPEN, VFD as u32);
                ctx_set(a, C_VFD_POS, 0);
                return VFD;
            }
            wstr(2, "lvm: openat 只认识 /proc/self/cmdline（被解释程序自己的命令行）\n");
            return die(2) as u64;
        }
        let cpath: u32 = x2 as u32;
        if lit_is_cmdline(m, cpath) {
            ctx_set(a, C_VFD_OPEN, VFD as u32);
            ctx_set(a, C_VFD_POS, 0);
            return VFD;
        }
        wstr(2, "lvm: openat 只认识 /proc/self/cmdline（被解释程序自己的命令行）\n");
        return die(2) as u64;
    }
    if nr == 60 {                                        // exit(code)
        // ⚠ **退出前先把剖面落盘**。参考那侧靠异常把栈弹干净、由 `run_ir` 收尾再写；
        // 这一侧没有异常 —— 而语料里几乎每一份都是 `_start` 里直接 `exit`，
        // 于是"在 `run` 结尾写"那条路**一次都不会走到**（第一版就是这么空的文件）。
        let pfd: u32 = ctx_get(a, C_PROF_FD);
        if pfd != 0 {
            dump_profile(a, pfd as u64);
        }
        dump_stats(a);
        syscall4(60, x1 & 255, 0, 0);
        return 0;
    }
    wstr(2, "lvm: 系统调用表里没有 ");
    write_num(a, 2, nr as u32);
    wstr(2, "（docs/243 §3.4）
");
    return die(2) as u64;
}

fn do_asm(a: ptr, m: ptr, fr: u32, io: u32, il: u32) -> u64 {
    let e: u32 = io + il;
    let lp: u32 = last_byte(a, io, e, 40);               // 最后一个 '('
    let rp: u32 = last_byte(a, io, e, 41);               // 最后一个 ')'
    if lp == NONE || rp == NONE {
        fail("内联汇编解析不了");
    }
    let p: u32 = skip_sp(a, lp + 1, rp);
    if p >= rp {
        fail("系统调用没有号");
    }
    let q: u32 = seg_end(a, p, rp);
    let nr: u64 = operand_text(a, m, fr, p, q);
    let x1: u64 = 0;
    let x2: u64 = 0;
    let x3: u64 = 0;
    let c1: u32 = seg_next(a, q, rp);
    if c1 < rp {
        let d1: u32 = seg_end(a, c1, rp);
        x1 = operand_text(a, m, fr, c1, d1);
        let c2: u32 = seg_next(a, d1, rp);
        if c2 < rp {
            let d2: u32 = seg_end(a, c2, rp);
            x2 = operand_text(a, m, fr, c2, d2);
            let c3: u32 = seg_next(a, d2, rp);
            if c3 < rp {
                let d3: u32 = seg_end(a, c3, rp);
                x3 = operand_text(a, m, fr, c3, d3);
            }
        }
    }
    return vm_syscall(a, m, nr, x1, x2, x3);
}

/// 一个指令的求值（控制流那五条在 `exec_body` 里就地处理，不走这儿）。
// ---------------------------------------------------------------- dismemory（docs/373）
//
// **guest 的指针是一个不透明令牌**：高 8 位 `0xD1`，其余 48 位是**永不复用**的序号。
// 令牌表在运行期（`DT` 按令牌有序、`DR` 按 (体,偏移) 有序）：值里没有体号、没有偏移。
// 访存查表；派生查表再插入。体的数据用 `vm_alloc` 落在 VM 内存里，**三维坐标只在表里**。
//
// 这一档与 sw_cap 互斥；只在 T0 落地（T2 的折叠表里没有令牌那一层）。

//: ⚠ 这一族与 `sw_tag` 的格子都**必须 < 256**：T2 的编译表 `CC_OFF` 从
//: `CTX_OFF + 256` 起，越过 255 就会被编译期写穿（2026-11-21 实测 T2 全线红）。
const C_DIS: u32 = 32;              // 1 = dismemory 开着
const C_DTSLO: u32 = 36;            // 下一个令牌序号（u64 拆两半）
const C_DTSHI: u32 = 40;
const C_DNB: u32 = 44;              // 体条数
const C_DNT: u32 = 48;              // 令牌表条数（按令牌有序）
const C_DNR: u32 = 52;              // 反向表条数（按 (体,偏移) 有序）
const C_DROUND: u32 = 56;           // 重定位轮次（排版的起点偏移）
const C_DREL: u32 = 60;             // 每 K 条指令重定位一次（0 = 关）

const DB_OFF: u32 = 14258948;        // 体表 stride 12 u32
const MAX_DB: u32 = 4096;
const DT_OFF: u32 = 14455556;        // 令牌表 stride 4 u32：lo, hi, body, off
const MAX_DT: u32 = 16384;
const DR_OFF: u32 = 14717700;        // 反向表 stride 4 u32：body, off, lo, hi
const MAX_DR: u32 = 16384;
const GD_OFF: u32 = 14979844;        // 全局令牌（每全局 2 个 u32）
const MAX_GD: u32 = 256;

const DK_GLOBAL: u32 = 1;
const DK_ALLOCA: u32 = 2;
const DK_HEAP: u32 = 3;

const DF_BOUNDS: u32 = 1;
const DF_DANGLING: u32 = 2;
const DF_NULL: u32 = 3;
const DF_NOADDR: u32 = 4;
const DF_NOORDER: u32 = 5;
const DF_LIMIT: u32 = 6;

fn d_on(a: ptr) -> u32 {
    return ctx_get(a, C_DIS);
}

/// IR 里有没有 `; loment-memory: dismemory`（只扫一遍；输入 ≤ 4 MiB）。
fn d_marker(a: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i + 26 <= n {
        if has_at(a, i, n, "; loment-memory: dismemory") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn d_body(a: ptr, bi: u32, f: u32) -> u32 {
    return rd(a, DB_OFF, bi * 12 + f);
}

fn d_bset(a: ptr, bi: u32, f: u32, v: u32) {
    wr(a, DB_OFF, bi * 12 + f, v);
}

fn d_kind_word(k: u32) {
    if k == DK_GLOBAL {
        wstr(2, "global");
    } else if k == DK_ALLOCA {
        wstr(2, "alloca");
    } else {
        wstr(2, "heap");
    }
}

fn d_nib(a: ptr, nib: u32) {
    if nib < 10 {
        store8(a, WNUM_SCRATCH, (48 + nib) as u8);
    } else {
        store8(a, WNUM_SCRATCH, (87 + nib) as u8);
    }
    let _w: u64 = write_all(2, ptr_add(a, WNUM_SCRATCH), 1);
}

/// `%#x`：`0x` + 最少位数的十六进制（0 印成 `0x0`）。
fn d_whex(a: ptr, v: u64) {
    wstr(2, "0x");
    let started: u32 = 0;
    let i: u32 = 15;
    let go: u32 = 1;
    while go == 1 {
        let nib: u32 = ((v >> ((i * 4) as u64)) & 15) as u32;
        if nib != 0 {
            started = 1;
        }
        if started == 1 || i == 0 {
            d_nib(a, nib);
        }
        if i == 0 {
            go = 0;
        } else {
            i = i - 1;
        }
    }
}

fn d_whex16(a: ptr, v: u64) {
    wstr(2, "0x");
    let i: u32 = 15;
    let go: u32 = 1;
    while go == 1 {
        d_nib(a, ((v >> ((i * 4) as u64)) & 15) as u32);
        if i == 0 {
            go = 0;
        } else {
            i = i - 1;
        }
    }
}

fn d_is_tok(t: u64) -> u32 {
    if ((t >> 56) & 255) == 209 {
        return 1;
    }
    return 0;
}

fn d_tok_lo(t: u64) -> u32 { return (t & 4294967295) as u32; }
fn d_tok_hi(t: u64) -> u32 { return ((t >> 32) & 4294967295) as u32; }

fn d_ser_next(a: ptr) -> u64 {
    let lo: u32 = ctx_get(a, C_DTSLO) + 1;
    let hi: u32 = ctx_get(a, C_DTSHI);
    if lo == 0 {
        if hi >= 65536 {
            let _f: u32 = d_fault(a, DF_LIMIT, 0, 0, 0, 0, 8, 0, 0, 0, 0);
            return 0;
        }
        ctx_set(a, C_DTSHI, hi + 1);
    }
    ctx_set(a, C_DTSLO, lo);
    return ((209 as u64) << 56) | ((hi as u64) << 32) | (lo as u64);
}

fn d_tok_new(a: ptr, bi: u32, off: u32) -> u64 {
    // 反向表按 (体,偏移) 有序：同一个引用点只发一个令牌。
    let n: u32 = ctx_get(a, C_DNR);
    let lo: u32 = 0;
    let hi: u32 = n;
    while lo < hi {
        let mid: u32 = (lo + hi) / 2;
        let mb: u32 = rd(a, DR_OFF, mid * 4);
        let mo: u32 = rd(a, DR_OFF, mid * 4 + 1);
        if mb < bi || (mb == bi && mo < off) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < n && rd(a, DR_OFF, lo * 4) == bi && rd(a, DR_OFF, lo * 4 + 1) == off {
        return (((rd(a, DR_OFF, lo * 4 + 3) as u64)) << 32)
               | (rd(a, DR_OFF, lo * 4 + 2) as u64);
    }
    if n >= MAX_DR || ctx_get(a, C_DNT) >= MAX_DT {
        // 与参考对齐：容量用尽在 guest 看来是 **F06 身份预算**，不是工具崩溃。
        let _f: u32 = d_fault(a, DF_LIMIT, 0, bi, off, 1, 5, 0, 0, 0, 0);
        return 0;
    }
    let s: u64 = d_ser_next(a);
    let tl: u32 = d_tok_lo(s);
    let th: u32 = d_tok_hi(s);
    let i: u32 = n;
    while i > lo {
        wr(a, DR_OFF, i * 4, rd(a, DR_OFF, (i - 1) * 4));
        wr(a, DR_OFF, i * 4 + 1, rd(a, DR_OFF, (i - 1) * 4 + 1));
        wr(a, DR_OFF, i * 4 + 2, rd(a, DR_OFF, (i - 1) * 4 + 2));
        wr(a, DR_OFF, i * 4 + 3, rd(a, DR_OFF, (i - 1) * 4 + 3));
        i = i - 1;
    }
    wr(a, DR_OFF, lo * 4, bi);
    wr(a, DR_OFF, lo * 4 + 1, off);
    wr(a, DR_OFF, lo * 4 + 2, tl);
    wr(a, DR_OFF, lo * 4 + 3, th);
    ctx_set(a, C_DNR, n + 1);
    let m: u32 = ctx_get(a, C_DNT);
    let l2: u32 = 0;
    let h2: u32 = m;
    while l2 < h2 {
        let mid: u32 = (l2 + h2) / 2;
        let mh: u32 = rd(a, DT_OFF, mid * 4 + 1);
        let ml: u32 = rd(a, DT_OFF, mid * 4);
        if mh < th || (mh == th && ml < tl) {
            l2 = mid + 1;
        } else {
            h2 = mid;
        }
    }
    let j: u32 = m;
    while j > l2 {
        wr(a, DT_OFF, j * 4, rd(a, DT_OFF, (j - 1) * 4));
        wr(a, DT_OFF, j * 4 + 1, rd(a, DT_OFF, (j - 1) * 4 + 1));
        wr(a, DT_OFF, j * 4 + 2, rd(a, DT_OFF, (j - 1) * 4 + 2));
        wr(a, DT_OFF, j * 4 + 3, rd(a, DT_OFF, (j - 1) * 4 + 3));
        j = j - 1;
    }
    wr(a, DT_OFF, l2 * 4, tl);
    wr(a, DT_OFF, l2 * 4 + 1, th);
    wr(a, DT_OFF, l2 * 4 + 2, bi);
    wr(a, DT_OFF, l2 * 4 + 3, off);
    ctx_set(a, C_DNT, m + 1);
    return s;
}

/// 令牌 -> 令牌表下标（NONE = 不在表里）。
fn d_find(a: ptr, t: u64) -> u32 {
    let n: u32 = ctx_get(a, C_DNT);
    let tl: u32 = d_tok_lo(t);
    let th: u32 = d_tok_hi(t);
    let lo: u32 = 0;
    let hi: u32 = n;
    while lo < hi {
        let mid: u32 = (lo + hi) / 2;
        let mh: u32 = rd(a, DT_OFF, mid * 4 + 1);
        let ml: u32 = rd(a, DT_OFF, mid * 4);
        if mh < th || (mh == th && ml < tl) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < n && rd(a, DT_OFF, lo * 4) == tl && rd(a, DT_OFF, lo * 4 + 1) == th {
        return lo;
    }
    return NONE;
}

fn d_body_new(a: ptr, kind: u32, size: u32, data: u32) -> u32 {
    let n: u32 = ctx_get(a, C_DNB);
    if n >= MAX_DB {
        let _f: u32 = d_fault(a, DF_LIMIT, 0, n, 0, 0, 4, 0, 0, 0, 0);
        return 0;
    }
    let bi: u32 = n;
    d_bset(a, bi, 0, kind);
    d_bset(a, bi, 1, size);
    d_bset(a, bi, 2, data);
    let d: u32 = 1;
    while d * d * d < size {
        d = d + 1;
    }
    d_bset(a, bi, 3, d);
    d_bset(a, bi, 4, d);
    d_bset(a, bi, 5, (size + d * d - 1) / (d * d));
    d_bset(a, bi, 6, 0);
    d_bset(a, bi, 7, 0);
    d_bset(a, bi, 8, 0);
    d_bset(a, bi, 9, 1);
    let sh: u64 = 0;
    let dsh: u32 = ctx_get(a, C_DSH);
    if dsh != 0 {
        sh = ((dsh as u64) * 2654435761 + (bi as u64) * 40503) & 2147483647;
    }
    d_bset(a, bi, 10, sh as u32);
    ctx_set(a, C_DNB, n + 1);
    d_place(a, bi);
    if data != 0 {
        // 全局的初值先写在宿主暂存里（`place_globals`），这里按格搬进体。
        let m: ptr = ptr_add(a, MEM_OFF);
        let i: u32 = 0;
        while i < size {
            d_cput(a, bi, i, load8(m, data + i) as u32);
            i = i + 1;
        }
    }
    return bi;
}

fn d_overlap(a: ptr, x: u32, y: u32, z: u32, dx: u32, dy: u32, dz: u32, me: u32) -> u32 {
    let n: u32 = ctx_get(a, C_DNB);
    let i: u32 = 0;
    while i < n {
        if i != me && d_body(a, i, 9) == 1 {
            let bx: u32 = d_body(a, i, 6);
            let by: u32 = d_body(a, i, 7);
            let bz: u32 = d_body(a, i, 8);
            if x < bx + d_body(a, i, 3) && bx < x + dx
                    && y < by + d_body(a, i, 4) && by < y + dy
                    && z < bz + d_body(a, i, 5) && bz < z + dz {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn d_place(a: ptr, bi: u32) -> u32 {
    let dx: u32 = d_body(a, bi, 3);
    let dy: u32 = d_body(a, bi, 4);
    let dz: u32 = d_body(a, bi, 5);
    let x: u32 = ctx_get(a, C_DROUND);
    let y: u32 = 0;
    let z: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        if d_overlap(a, x, y, z, dx, dy, dz, bi) == 0 {
            d_bset(a, bi, 6, x);
            d_bset(a, bi, 7, y);
            d_bset(a, bi, 8, z);
            return 0;
        }
        x = x + dx;
        if x > 65536 {
            x = ctx_get(a, C_DROUND);
            y = y + dy;
            if y > 65536 {
                y = 0;
                z = z + dz;
            }
        }
    }
    return 0;
}

fn d_reloc(a: ptr) {
    ctx_set(a, C_DROUND, ctx_get(a, C_DROUND) + 1);
    let n: u32 = ctx_get(a, C_DNB);
    let i: u32 = 0;
    while i < n {
        if d_body(a, i, 9) == 1 {
            d_place(a, i);
        }
        i = i + 1;
    }
}

fn d_retire_body(a: ptr, bi: u32) {
    if bi >= ctx_get(a, C_DNB) || d_body(a, bi, 9) == 0 {
        return;
    }
    d_bset(a, bi, 9, 0);
    // 把这一颗体的令牌从两张有序表里删掉（令牌永不复用，不需要代号）。
    let n: u32 = ctx_get(a, C_DNT);
    let i: u32 = 0;
    let w: u32 = 0;
    while i < n {
        if rd(a, DT_OFF, i * 4 + 2) == bi {
            i = i + 1;
        } else {
            wr(a, DT_OFF, w * 4, rd(a, DT_OFF, i * 4));
            wr(a, DT_OFF, w * 4 + 1, rd(a, DT_OFF, i * 4 + 1));
            wr(a, DT_OFF, w * 4 + 2, rd(a, DT_OFF, i * 4 + 2));
            wr(a, DT_OFF, w * 4 + 3, rd(a, DT_OFF, i * 4 + 3));
            w = w + 1;
            i = i + 1;
        }
    }
    ctx_set(a, C_DNT, w);
    let r: u32 = ctx_get(a, C_DNR);
    let j: u32 = 0;
    let v: u32 = 0;
    while j < r {
        if rd(a, DR_OFF, j * 4) == bi {
            j = j + 1;
        } else {
            wr(a, DR_OFF, v * 4, rd(a, DR_OFF, j * 4));
            wr(a, DR_OFF, v * 4 + 1, rd(a, DR_OFF, j * 4 + 1));
            wr(a, DR_OFF, v * 4 + 2, rd(a, DR_OFF, j * 4 + 2));
            wr(a, DR_OFF, v * 4 + 3, rd(a, DR_OFF, j * 4 + 3));
            v = v + 1;
            j = j + 1;
        }
    }
    ctx_set(a, C_DNR, v);
    let c: u32 = 0;
    while c < MAX_CT {
        if rd(a, CT_OFF, c * 4 + 3) == 1 && rd(a, CT_OFF, c * 4) == bi {
            wr(a, CT_OFF, c * 4 + 3, 2);
        }
        c = c + 1;
    }
}

/// 令牌 -> (体号, 偏移) 的**打包值**（高 32 位体号，低 32 位偏移）。
/// 这一档没有"体数据地址"这种东西：访问一律按格走 `d_cget` / `d_cput`。
fn d_loc(a: ptr, t: u64, sz: u32, io: u32, il: u32, oo: u32, ol: u32) -> u64 {
    if t == 0 {
        let _f: u32 = d_fault(a, DF_NULL, t, 0, 0, sz, 0, io, il, oo, ol);
        return 0;
    }
    if d_is_tok(t) == 0 {
        let _f: u32 = d_fault(a, DF_NOADDR, t, 0, 0, sz, 1, io, il, oo, ol);
        return 0;
    }
    let ix: u32 = d_find(a, t);
    if ix == NONE {
        let _f: u32 = d_fault(a, DF_DANGLING, t, 0, 0, sz, 0, io, il, oo, ol);
        return 0;
    }
    let bi: u32 = rd(a, DT_OFF, ix * 4 + 2);
    let off: u32 = rd(a, DT_OFF, ix * 4 + 3);
    let size: u32 = d_body(a, bi, 1);
    if off + sz > size {
        let _f: u32 = d_fault(a, DF_BOUNDS, t, bi, off, sz, 0, io, il, oo, ol);
        return 0;
    }
    return ((bi as u64) << 32) | (off as u64);
}

/// 物理格号：逻辑格号加这一颗体的摆法，再对体尺寸取模（`docs/375` §2.3）。
fn d_cphys(a: ptr, bi: u32, cell: u32) -> u32 {
    let sz: u32 = d_body(a, bi, 1);
    if sz == 0 {
        return 0;
    }
    // u64 相加：镜像的体在 4 MiB 内，但这里不依赖那个边界（与参考的 Python 口径同）。
    let sum: u64 = (cell as u64) + (d_body(a, bi, 10) as u64);
    return (sum % (sz as u64)) as u32;
}

fn d_chash(bi: u32, ph: u32) -> u32 {
    let h: u64 = ((bi as u64) * 2654435761 + (ph as u64) * 2246822519) % (MAX_CT as u64);
    return h as u32;
}

/// 读一格。**没写过 = 0**：体是一张稀疏映射，零不落格。
fn d_cget(a: ptr, bi: u32, cell: u32) -> u32 {
    let ph: u32 = d_cphys(a, bi, cell);
    let h: u32 = d_chash(bi, ph);
    let i: u32 = 0;
    let out: u32 = 0;
    let stop: u32 = 0;
    while i < MAX_CT && stop == 0 {
        let q: u32 = h + i;
        if q >= MAX_CT {
            q = q - MAX_CT;
        }
        let st: u32 = rd(a, CT_OFF, q * 4 + 3);
        if st == 0 {
            stop = 1;
        } else if st == 1 {
            if rd(a, CT_OFF, q * 4) == bi && rd(a, CT_OFF, q * 4 + 1) == ph {
                out = rd(a, CT_OFF, q * 4 + 2);
                stop = 1;
            }
        }
        i = i + 1;
    }
    return out;
}

/// 写一格。写 0 = 把这一格删掉（墓碑），表满 → F06。
fn d_cput(a: ptr, bi: u32, cell: u32, v: u32) {
    let ph: u32 = d_cphys(a, bi, cell);
    let h: u32 = d_chash(bi, ph);
    let i: u32 = 0;
    let stop: u32 = 0;
    let empty: u32 = NONE;
    while i < MAX_CT && stop == 0 {
        let q: u32 = h + i;
        if q >= MAX_CT {
            q = q - MAX_CT;
        }
        let st: u32 = rd(a, CT_OFF, q * 4 + 3);
        if st == 0 {
            stop = 1;
            if empty == NONE {
                empty = q;
            }
        } else if st == 2 {
            if empty == NONE {
                empty = q;
            }
        } else if rd(a, CT_OFF, q * 4) == bi && rd(a, CT_OFF, q * 4 + 1) == ph {
            wr(a, CT_OFF, q * 4 + 2, v);
            if v == 0 {
                wr(a, CT_OFF, q * 4 + 3, 2);
            } else {
                wr(a, CT_OFF, q * 4 + 3, 1);
            }
            stop = 1;
        }
        i = i + 1;
    }
    if stop == 0 {
        let _f: u32 = d_fault(a, DF_LIMIT, 0, bi, ph, 1, 3, 0, 0, 0, 0);
        return;
    }
    if v != 0 && empty != NONE {
        wr(a, CT_OFF, empty * 4, bi);
        wr(a, CT_OFF, empty * 4 + 1, ph);
        wr(a, CT_OFF, empty * 4 + 2, v);
        wr(a, CT_OFF, empty * 4 + 3, 1);
    }
}

/// 按格读一个小端整数（`sz` ≤ 8）。
fn d_read(a: ptr, loc: u64, sz: u32) -> u64 {
    let bi: u32 = hi32(loc);
    let off: u32 = lo32(loc);
    let v: u64 = 0;
    let k: u32 = 0;
    while k < sz {
        v = v | ((d_cget(a, bi, off + k) as u64) << ((k * 8) as u64));
        k = k + 1;
    }
    return v;
}

fn d_write(a: ptr, loc: u64, sz: u32, v: u64) {
    let bi: u32 = hi32(loc);
    let off: u32 = lo32(loc);
    let k: u32 = 0;
    while k < sz {
        d_cput(a, bi, off + k, ((v >> ((k * 8) as u64)) & 255) as u32);
        k = k + 1;
    }
}

/// 体 -> 宿主（`host` 是 VM 内存里的偏移）。
fn d_copy_out(a: ptr, loc: u64, host: u32, n: u32) {
    let m: ptr = ptr_add(a, MEM_OFF);
    let bi: u32 = hi32(loc);
    let off: u32 = lo32(loc);
    let k: u32 = 0;
    while k < n {
        store8(m, host + k, d_cget(a, bi, off + k) as u8);
        k = k + 1;
    }
}

/// 宿主 -> 体。
fn d_copy_in(a: ptr, loc: u64, host: u32, n: u32) {
    let m: ptr = ptr_add(a, MEM_OFF);
    let bi: u32 = hi32(loc);
    let off: u32 = lo32(loc);
    let k: u32 = 0;
    while k < n {
        d_cput(a, bi, off + k, load8(m, host + k) as u32);
        k = k + 1;
    }
}

fn d_zero(a: ptr, loc: u64, n: u32) {
    let bi: u32 = hi32(loc);
    let off: u32 = lo32(loc);
    let k: u32 = 0;
    while k < n {
        d_cput(a, bi, off + k, 0);
        k = k + 1;
    }
}

/// 体里从 `loc` 起是不是这个字面量（含结尾 0）。
fn d_eq_lit(a: ptr, loc: u64, lit: str) -> u32 {
    let bi: u32 = hi32(loc);
    let off: u32 = lo32(loc);
    let n: u32 = str_len(lit);
    let i: u32 = 0;
    while i < n {
        if d_cget(a, bi, off + i) != (str_byte(lit, i) as u32) {
            return 0;
        }
        i = i + 1;
    }
    if d_cget(a, bi, off + n) != 0 {
        return 0;
    }
    return 1;
}

/// 令牌 + 整数：在表里派生一个新令牌（体内偏移）；出体 → F01。
fn d_derive(a: ptr, t: u64, delta: u32, io: u32, il: u32, oo: u32, ol: u32) -> u64 {
    let ix: u32 = d_find(a, t);
    if ix == NONE {
        let _f: u32 = d_fault(a, DF_DANGLING, t, 0, 0, 0, 0, io, il, oo, ol);
        return 0;
    }
    let bi: u32 = rd(a, DT_OFF, ix * 4 + 2);
    let off: u32 = rd(a, DT_OFF, ix * 4 + 3);
    let n: u32 = off + delta;
    if n > d_body(a, bi, 1) {
        let _f: u32 = d_fault(a, DF_BOUNDS, t, bi, n, 1, 0, io, il, oo, ol);
        return 0;
    }
    return d_tok_new(a, bi, n);
}

fn d_alloc_body(a: ptr, kind: u32, size: u32) -> u64 {
    let sz: u32 = size;
    if sz == 0 {
        sz = 1;
    }
    let bi: u32 = d_body_new(a, kind, sz, 0);
    return d_tok_new(a, bi, 0);
}

fn d_gaddr(a: ptr, no: u32, nl: u32) -> u64 {
    let ng: u32 = ctx_get(a, C_NG);
    let i: u32 = 0;
    while i < ng {
        let o: u32 = rd(a, G_OFF, i * 6);
        let l: u32 = rd(a, G_OFF, i * 6 + 1);
        if l == nl && same(a, no, a, o, nl) {
            return ((rd(a, GD_OFF, i * 2 + 1) as u64) << 32)
                   | (rd(a, GD_OFF, i * 2) as u64);
        }
        i = i + 1;
    }
    return 0;
}

/// 一条 dismemory fault：**首行**与参考逐字节同；详细块是同一形状的 Lomenterr 块。
fn d_fault(a: ptr, kind: u32, tok: u64, bi: u32, off: u32, sz: u32,
           reason: u32, io: u32, il: u32, oo: u32, ol: u32) -> u32 {
    let fi: u32 = ctx_get(a, C_SITE_FI);
    let bii: u32 = ctx_get(a, C_SITE_BI);
    let j: u32 = ctx_get(a, C_SITE_J);
    wstr(2, "lvm: ");
    if kind == DF_BOUNDS {
        wstr(2, "F01 bounds violation");
    } else if kind == DF_DANGLING {
        wstr(2, "F02 dangling reference");
    } else if kind == DF_NULL {
        wstr(2, "F03 null dereference");
    } else if kind == DF_NOADDR {
        wstr(2, "F04 no addresses");
    } else if kind == DF_NOORDER {
        wstr(2, "F05 no address space");
    } else {
        wstr(2, "F06 identity exhausted");
    }
    wstr(2, " at ");
    w_fn_name(a, fi);
    wstr(2, ":");
    w_blk_name(a, bii);
    wstr(2, "#");
    wnum32(a, 2, j);
    wstr(2, " (");
    if kind == DF_BOUNDS {
        wstr(2, "offset="); wnum32(a, 2, off);
        wstr(2, " size="); wnum32(a, 2, sz);
        wstr(2, " limit="); wnum32(a, 2, d_body(a, bi, 1));
    } else if kind == DF_DANGLING {
        wstr(2, "token=");
        d_whex(a, tok);
        wstr(2, " not live");
    } else if kind == DF_NULL {
        wstr(2, "size="); wnum32(a, 2, sz);
    } else if kind == DF_NOADDR {
        wstr(2, "handle used as a number");
    } else if kind == DF_NOORDER {
        wstr(2, "no global space");
    } else {
        wstr(2, "identity budget");
    }
    wstr(2, ")\n");
    wstr(2, "error[F0");
    wnum32(a, 2, kind);
    wstr(2, "]: ");
    if kind == DF_BOUNDS {
        wstr(2, "越出体的体积（这一档没有\"隔壁\"）\n");
    } else if kind == DF_DANGLING {
        wstr(2, "悬垂引用（dangling）\n");
    } else if kind == DF_NULL {
        wstr(2, "空指针解引用（null）\n");
    } else if kind == DF_NOADDR {
        wstr(2, "没有地址（no addresses）\n");
    } else if kind == DF_NOORDER {
        wstr(2, "没有全局空间（no address space）\n");
    } else {
        wstr(2, "身份预算用尽（identity exhausted）\n");
    }
    wstr(2, "  --> IR:");
    w_fn_name(a, fi);
    wstr(2, ":");
    w_blk_name(a, bii);
    wstr(2, "#");
    wnum32(a, 2, j);
    if il > 0 {
        wstr(2, "\n   |\n   |   ");
        let _i: u64 = write_all(2, ptr_add(a, io), il as u64);
    }
    wstr(2, "\n   | 令牌：");
    d_whex16(a, tok);
    if bi < ctx_get(a, C_DNB) {
        wstr(2, "\n   | 体：");
        d_kind_word(d_body(a, bi, 0));
        wstr(2, "（只报类别，不报编号与位置）");
        wstr(2, "\n   | 访问：令牌内偏移 ");
        wnum32(a, 2, off);
        wstr(2, "，宽 ");
        wnum32(a, 2, sz);
    }
    wstr(2, "\n   |\n   = 站点：函数 ");
    w_fn_name(a, fi);
    wstr(2, " / 块 ");
    w_blk_name(a, bii);
    wstr(2, " / 第 ");
    wnum32(a, 2, j);
    wstr(2, " 条指令；栈深 ");
    wnum32(a, 2, ctx_get(a, C_DEPTH));
    wstr(2, "\n   = 建议：体是实心长方体；任何跨越体表的访问都是 fault，跨体/整数化/排序同样如此。令牌永不复用。\n");
    return die((100 + kind) as u64);
}

fn eval_instr(a: ptr, m: ptr, fr: u32, cfr: u32, io: u32, il: u32, k: u32, sub: u32,
               do_: u32, dl: u32) -> u64 {
    if k == K_ALLOCA {
        let ts: u64 = ty_span(a, after_op(a, io, io + il), io + il);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        if d_on(a) == 1 {
            let atk: u64 = d_alloc_body(a, DK_ALLOCA, sz);
            let aix: u32 = d_find(a, atk);
            let abi: u32 = rd(a, DT_OFF, aix * 4 + 2);
            if ctx_get(a, C_NFOBJ) >= MAX_FOBJ {
                fail("dismemory 帧对象栈满了");
            }
            wr(a, FOBJ_OFF, ctx_get(a, C_NFOBJ), abi);
            ctx_set(a, C_NFOBJ, ctx_get(a, C_NFOBJ) + 1);
            return atk;
        }
        let s2: u32 = sz;
        if s2 < 8 {
            return fr_alloc(a, m, fr, 8, 8) as u64;  // 与参考实现的 max(SLOT, size) 同
        }
        return fr_alloc(a, m, fr, sz, 8) as u64;
    }
    if k == K_LOAD {
        let e: u32 = io + il;
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let addr: u64 = operand_text(a, m, fr, p, e);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        if d_on(a) == 1 {
            let dloc: u64 = d_loc(a, addr, sz, io, il, p, e - p);
            if is_agg(a, hi32(ts), lo32(ts)) {
                let d2: u32 = fr_agg(a, m, fr, do_, dl, sz);
                d_copy_out(a, dloc, d2, sz);
                return (d2 as u64) | (((sz as u64)) << 32);
            }
            return d_read(a, dloc, sz);
        }
        let lps: u64 = operand_value_span(a, p, e);
        let pc: u64 = operand_cap(a, m, fr, hi32(lps) as u32, lo32(lps) as u32);
        if hi32(pc) != 0 && addr != 0 {
            cap_check_tag(a, addr as u32, sz, lo32(pc) as u32, hi32(pc) as u32, io, il, p, e - p);
        } else {
            cap_check(a, addr as u32, sz, io, il, p, e - p);
        }
        if is_agg(a, hi32(ts), lo32(ts)) {
            let d: u32 = fr_agg(a, m, fr, do_, dl, sz);
            mc(m, d, addr as u32, sz);
            return (d as u64) | (((sz as u64)) << 32);
        }
        let lv: u64 = mr(m, addr as u32, sz);
        return lv;
    }
    if k == K_STORE {
        let e: u32 = io + il;
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let vs: u64 = trim_span(a, p, q);
        let val: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let ps: u32 = seg_next(a, q, e);
        let addr: u64 = operand_text(a, m, fr, ps, e);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        if d_on(a) == 1 {
            let dloc: u64 = d_loc(a, addr, sz, io, il, ps, e - ps);
            if is_agg(a, hi32(ts), lo32(ts)) {
                d_copy_in(a, dloc, val as u32, sz);
            } else {
                d_write(a, dloc, sz, val);
            }
            return 0;
        }
        let sps: u64 = operand_value_span(a, ps, e);
        let pc: u64 = operand_cap(a, m, fr, hi32(sps) as u32, lo32(sps) as u32);
        if hi32(pc) != 0 && addr != 0 {
            cap_check_tag(a, addr as u32, sz, lo32(pc) as u32, hi32(pc) as u32, io, il, ps, e - ps);
        } else {
            cap_check(a, addr as u32, sz, io, il, ps, e - ps);
        }
        if is_ptr_ty(a, hi32(ts) as u32, lo32(ts) as u32) {
            let vc: u64 = operand_cap(a, m, fr, hi32(vs) as u32, lo32(vs) as u32);
            if hi32(vc) != 0 {
                sh_put(a, addr as u32, lo32(vc) as u32, hi32(vc) as u32);
            }
        }
        if is_agg(a, hi32(ts), lo32(ts)) {
            mc(m, addr as u32, val as u32, sz);
        } else {
            mw(m, addr as u32, sz, val);
        }
        return 0;
    }
    if k == K_GEP {
        return gep(a, m, fr, io, il);
    }
    if k == K_EXTRV {
        return extractvalue(a, m, fr, io, il, do_, dl);
    }
    if k == K_INSV {
        return insertvalue(a, m, fr, io, il, do_, dl);
    }
    if k == K_ICMP {
        return icmp(a, m, fr, io, il, sub);
    }
    if k == K_SDIV || k == K_UDIV || k == K_SREM || k == K_UREM {
        return divop(a, m, fr, io, il, k);
    }
    if k >= K_ADD && k <= K_ASHR {
        return arith(a, m, fr, io, il, k);
    }
    if k >= K_TRUNC && k <= K_INTTOPTR {
        return cast_op(a, m, fr, io, il, k);
    }
    if k == K_CALL {
        return do_call(a, m, io, il, fr, do_, dl);
    }
    if k == K_ASMCALL {
        return do_asm(a, m, fr, io, il);
    }
    if k == K_UNREACH {
        fail("执行到 unreachable");
    }
    return fail_tok(a, "这个指令 T0 没实现:", io, il) as u64;
}

/// 绑定一次调用：解析名字/实参、建好被调帧、把事件写进格区。**不执行。**
/// 返回 `(fi << 32) | fr`；失败一律点名拒。递归引擎与显式栈引擎共用这一份。
fn bind_call(a: ptr, m: ptr, io: u32, il: u32, caller: u32, do_: u32, dl: u32) -> u64 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    let p2: u32 = 0;
    if has_at(a, p, e, "void") {
        p2 = skip_sp(a, p + 4, e);
    } else {
        let ts: u64 = ty_span(a, p, e);
        p2 = skip_sp(a, hi32(ts) + lo32(ts), e);
    }
    let nt: u64 = wspan(a, p2, e);                       // @name
    let no: u32 = hi32(nt) + 1;
    let nlen: u32 = lo32(nt) - 1;
    let is_priv: bool = has_at(a, no, no + nlen, "__loment_");
    let is_alloc: bool = eqw(a, no, nlen, "__loment_alloc");
    let is_free: bool = eqw(a, no, nlen, "__loment_free");
    let lp: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    if lp >= e || load8(a, lp) != 40 {
        fail("只认直接调用（间接调用 T0 不支持）");
    }
    let rp: u32 = match_close(a, lp, e, 40, 41);
    let fi: u32 = fn_find(a, hi32(nt), lo32(nt));
    if fi == NONE {
        fail("没有这个函数（extern 不接 FFI —— docs/243 §5）");
    }
    let npar: u32 = rd(a, F_OFF, fi * 8 + 4);
    let fpar: u32 = rd(a, F_OFF, fi * 8 + 5);
    let d: u32 = ctx_get(a, C_DEPTH) + 1;
    if d > MAX_DEPTH {
        fail("调用太深");
    }
    ctx_set(a, C_DEPTH, d);
    let fr: u32 = MEM_SIZE - d * FRAME_SIZE;
    wr(m, fr, 0, 0);
    wr(m, fr, 1, FR_SLOTS);
    let ap: u32 = skip_sp(a, lp + 1, rp);
    let k: u32 = 0;
    let a0: u64 = 0;
    while k < npar {
        if ap >= rp {
            // issue #716：实参个数与形参不符**是错**，三种实现用同一句话拒。
            fail("实参个数与形参不符");
        }
        let ae: u32 = seg_end(a, ap, rp);
        let pnm: u64 = pspan(a, fpar + k, 2);
        let av: u64 = operand_text(a, m, caller, ap, ae);
        let acs: u64 = operand_value_span(a, ap, ae);
        let ac: u64 = operand_cap(a, m, caller, hi32(acs) as u32, lo32(acs) as u32);
        if k == 0 {
            a0 = av;
        }
        vputc(a, m, fr, hi32(pnm), lo32(pnm), av,
              lo32(ac) as u32, hi32(ac) as u32);
        ap = seg_next(a, ae, rp);
        k = k + 1;
    }
    // 多出来的实参同样是错（以前这里只是**不读**它们 —— 与参考实现的 `zip` 一样静默）。
    if ap < rp {
        fail("实参个数与形参不符");
    }
    wr(a, FBASE_OFF, d * 4, ctx_get(a, C_NFOBJ));
    if is_priv {
        ctx_set(a, C_BIND_PRIV, 1);
    } else {
        ctx_set(a, C_BIND_PRIV, 0);
    }
    if is_alloc {
        ctx_set(a, C_BIND_HOOK, 1);
    } else if is_free {
        ctx_set(a, C_BIND_HOOK, 2);
    } else {
        ctx_set(a, C_BIND_HOOK, 0);
    }
    ctx_set(a, C_BIND_A0LO, lo32(a0));
    ctx_set(a, C_BIND_A0HI, hi32(a0));
    return ((fi as u64) << 32) | (fr as u64);
}

fn do_call(a: ptr, m: ptr, io: u32, il: u32, caller: u32, do_: u32, dl: u32) -> u64 {
    let b: u64 = bind_call(a, m, io, il, caller, do_, dl);
    let fi: u32 = hi32(b);
    let fr: u32 = lo32(b);
    let d: u32 = ctx_get(a, C_DEPTH);
    if d_on(a) == 1 && ctx_get(a, C_BIND_HOOK) != 0 {
        let hook: u32 = ctx_get(a, C_BIND_HOOK);
        let a0: u64 = ((ctx_get(a, C_BIND_A0HI) as u64) << 32)
                      | (ctx_get(a, C_BIND_A0LO) as u64);
        ctx_set(a, C_DEPTH, ctx_get(a, C_DEPTH) - 1);
        if hook == 1 {
            return d_alloc_body(a, DK_HEAP, a0 as u32);
        }
        let fxi: u32 = d_find(a, a0);
        if fxi != NONE {
            d_retire_body(a, rd(a, DT_OFF, fxi * 4 + 2));
        }
        return 0;
    }
    let is_priv: bool = ctx_get(a, C_BIND_PRIV) != 0;
    if is_priv {
        ctx_set(a, C_PRIV, ctx_get(a, C_PRIV) + 1);
    }
    let r: u64 = exec_body(a, m, fi, fr, caller, do_, dl);
    if is_priv {
        ctx_set(a, C_PRIV, ctx_get(a, C_PRIV) - 1);
    }
    if ctx_get(a, C_SUB) != 0 {
        let hook: u32 = ctx_get(a, C_BIND_HOOK);
        let a0: u64 = ((ctx_get(a, C_BIND_A0HI) as u64) << 32)
                      | (ctx_get(a, C_BIND_A0LO) as u64);
        if hook == 1 {
            obj_new(a, r as u32, (r as u32) + (a0 as u32), OBJ_HEAP);
        } else if hook == 2 {
            obj_retire_base(a, a0 as u32);
        }
    }
    ctx_set(a, C_DEPTH, d - 1);
    return r;
}

/// phi：取**前驱块**那一支。`prev` 是刚跳出来的那一块的块号。
fn phi_of(a: ptr, m: ptr, fr: u32, io: u32, il: u32, prev: u32) -> u64 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let po: u32 = rd(a, B_OFF, prev * 5);
    let pl: u32 = rd(a, B_OFF, prev * 5 + 1);
    let p: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
    let hit: u64 = 0;
    let found: u32 = 0;
    while p < e {
        let pe: u32 = match_close(a, p, e, 91, 93);      // '['
        let co: u32 = last_byte(a, p + 1, pe, 44);       // 里面最后一个逗号
        let lab: u64 = trim_span(a, co + 1, pe);         // `%entry`（**带 %**）
        // ⚠ 块标签表里存的是 `entry`（不带 %），而这里的记号是 `%entry` ——
        // 长度要减掉那一个 `%` 才对得上。第一版直接拿 `lo32(lab) == pl` 比，
        // 永远不等，于是每一个有 phi 的程序都报"没有来自前驱块的入边"。
        if lo32(lab) == pl + 1 && lo32(lab) > 1 {
            if same(a, hi32(lab) + 1, a, po, pl) {
                let vs: u64 = trim_span(a, p + 1, co);
                hit = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
                found = 1;
            }
        }
        p = seg_next(a, pe + 1, e);      // ⚠ 给的是 `]` 的位置，得先跨过它
    }
    if found == 0 {
        fail("phi 没有来自前驱块的入边");
    }
    return hit;
}

/// `switch <ty> <v>, label %d [ <ty> <n>, label %l … ]`。热路径上没有它 ——
/// 目标块用**线性找**（`blk_of`）就够了，语料里一共 3 条。
fn switch_of(a: ptr, m: ptr, fr: u32, io: u32, il: u32, fi: u32) -> u32 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let vs: u64 = trim_span(a, p, q);
    let v: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
    let bo: u32 = index_of(a, q, e, 91);                 // '['
    let be: u32 = match_close(a, bo, e, 91, 93);
    let dw: u64 = wspan(a, lab_after(a, q + 1, bo), bo);
    let dflt: u32 = blk_of(a, fi, hi32(dw), lo32(dw));
    let cp: u32 = skip_sp(a, bo + 1, be);
    // T1：**default 是最后一条边** —— 边号 = case 的条数（与解析期 `edge_alloc` 给的
    // `nedges = count_label + 1` 对得上）。第一版这里填的是 255 占位，于是 default 那一步
    // 的边号超界、被 `bump_edge` 静默跳过 —— 症状是**少一行**（`score entry 5 1 1`），
    // 而那正是孪生判据逐字节比出来的。
    // ⚠ 计数器**不能叫 `ce`** —— 循环体里已经有一个 `let ce` 是"这一条 case 的结束偏移"，
    // 而这一门**没有块作用域**（`docs/228`）：内层 `let` 会**静默遮住**外层同名变量，
    // 于是 `| ce` 用的是偏移（一个大数），边号超界被 `bump_edge` 跳过 —— 症状是镜像那边
    // **少一行**，而两边的 stdout 一字不差。这一处是孪生判据逐字节比出来的。
    let hit: u32 = (dflt << 16) | count_label(a, bo + 1, be);
    let ek: u32 = 0;
    while cp < be {
        let cty: u64 = ty_span(a, cp, be);
        let cvs: u64 = trim_span(a, hi32(cty) + lo32(cty), seg_end(a, hi32(cty) + lo32(cty), be));
        let ce: u32 = seg_end(a, cp, be);
        let lp: u32 = lab_after(a, ce + 1, be);
        let lw: u64 = wspan(a, lp, be);
        let cv: u64 = dec_u64(a, hi32(cvs), hi32(cvs) + lo32(cvs));
        if mask_bits(v, bits_of(a, hi32(cty), lo32(cty))) == cv {
            hit = (blk_of(a, fi, hi32(lw), lo32(lw)) << 16) | ek;
        }
        ek = ek + 1;
        cp = seg_next(a, lp + lo32(lw), be);
    }
    return hit;
}

/// 跑一个函数体。`fr` = 本帧基址（VM 地址），`cfr` = **调用者**的帧基址（NONE = 没有）。
/// `cfr` 是给聚合返回值用的：被调者的帧下一句就作废，值必须落到调用者那边。
/// 记一次块进入。**关着就一个字节都不写**（`docs/247` 判据 D）。
fn bump_block(a: ptr, bi: u32) {
    if ctx_get(a, C_PROF_FD) != 0 {
        wr(a, B_OFF, bi * 5 + 4, rd(a, B_OFF, bi * 5 + 4) + 1);
    }
}

/// 记一条边。边号由调用点给（`br` 无条件 0 / 条件 0真1假 / `switch` = case 次序，default 在最后）。
fn bump_edge(a: ptr, ii: u32, e: u32) {
    if ctx_get(a, C_PROF_FD) != 0 {
        let fe: u32 = rd(a, I_OFF, ii * 8 + 6);
        let ne: u32 = rd(a, I_OFF, ii * 8 + 7);
        if e < ne {
            wr(a, E_OFF, fe + e, rd(a, E_OFF, fe + e) + 1);
        }
    }
}

fn exec_body(a: ptr, m: ptr, fi: u32, fr: u32, cfr: u32, ro: u32, rl: u32) -> u64 {
    let bi: u32 = rd(a, F_OFF, fi * 8 + 6);
    let prev: u32 = NONE;
    let go: u32 = 1;
    ctx_set(a, C_SITE_FI, fi);
    while go == 1 {
        let here: u32 = bi;
        ctx_set(a, C_SITE_BI, bi);
        bump_block(a, bi);
        let io: u32 = rd(a, B_OFF, bi * 5 + 2);
        let ni: u32 = rd(a, B_OFF, bi * 5 + 3);
        let j: u32 = 0;
        let jumped: u32 = 0;
        while j < ni && jumped == 0 {
            let ii: u32 = io + j;
            // 站点是**每条指令**的：嵌套调用会把 C_SITE_FI 改成被调者，回来必须重新锚到本函数
            // （2026-11-21 实测：`mk` 返回后的悬垂被报成 `mk:entry#1`）。
            ctx_set(a, C_SITE_FI, fi);
            ctx_set(a, C_SITE_J, j);
            let k: u32 = rd(a, I_OFF, ii * 8 + 4);
            let sub: u32 = rd(a, I_OFF, ii * 8 + 5);
            let to: u32 = rd(a, I_OFF, ii * 8 + 2);
            let tl: u32 = rd(a, I_OFF, ii * 8 + 3);
            let do_: u32 = rd(a, I_OFF, ii * 8);
            let dl: u32 = rd(a, I_OFF, ii * 8 + 1);
            ctx_set(a, 84, to);
            ctx_set(a, 88, tl);
            let ns: u32 = ctx_get(a, C_STEPS) + 1;
            if ns > STEP_CAP {
                wstr(2, "lvm: 执行超过 "); write_num(a, 2, STEP_CAP);
                wstr(2, " 条指令，卡在 ");
                let fno: u32 = rd(a, F_OFF, fi * 8);
                write_all(2, ptr_add(a, fno), rd(a, F_OFF, fi * 8 + 1) as u64);
                wstr(2, " 的 [");
                write_all(2, ptr_add(a, to), tl as u64);
                wstr(2, "]
");
                return die(2) as u64;
            }
            ctx_set(a, C_STEPS, ns);
            if d_on(a) == 1 && ctx_get(a, C_DREL) != 0
                    && ns % ctx_get(a, C_DREL) == 0 {
                d_reloc(a);
            }
            if k == K_BR_UNCOND {
                bump_edge(a, ii, 0);
                prev = here;
                bi = sub;
                jumped = 1;
            } else if k == K_BR_COND {
                let e: u32 = to + tl;
                let ts: u64 = ty_span(a, after_op(a, to, e), e);
                let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
                let vs: u64 = trim_span(a, p, seg_end(a, p, e));
                let c: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
                prev = here;
                if c != 0 {
                    bump_edge(a, ii, 0);
                    bi = sub >> 16;
                } else {
                    bump_edge(a, ii, 1);
                    bi = sub & 65535;
                }
                jumped = 1;
            } else if k == K_SWITCH {
                let sv: u32 = switch_of(a, m, fr, to, tl, fi);
                bump_edge(a, ii, sv & 65535);
                prev = here;
                bi = sv >> 16;
                jumped = 1;
            } else if k == K_RET {
                return do_ret(a, m, fr, cfr, to, tl, ro, rl);
            } else if k == K_PHI {
                if dl > 0 {
                    let v: u64 = phi_of(a, m, fr, to, tl, prev);
                    let ex: u32 = vfind(a, m, fr, do_, dl);
                    if ex == NONE {
                        vput(a, m, fr, do_, dl, v);
                    } else {
                        vset(a, m, fr, ex, v);
                    }
                }
            } else {
                let v: u64 = eval_instr(a, m, fr, cfr, to, tl, k, sub, do_, dl);
                if dl > 0 {
                    let cp: u64 = result_cap(a, m, fr, k, to, tl, v);
                    let ex: u32 = vfind(a, m, fr, do_, dl);
                    if ex == NONE {
                        vputc(a, m, fr, do_, dl, v, lo32(cp) as u32, hi32(cp) as u32);
                    } else {
                        vsetc(a, m, fr, ex, v, lo32(cp) as u32, hi32(cp) as u32);
                    }
                }
            }
            j = j + 1;
        }
        if jumped == 0 {
            fail("块没有终结指令");
        }
    }
    return 0;
}

fn do_ret(a: ptr, m: ptr, fr: u32, cfr: u32, to: u32, tl: u32, ro: u32, rl: u32) -> u64 {
    frame_retire(a, ctx_get(a, C_DEPTH));
    let e: u32 = to + tl;
    let p: u32 = after_op(a, to, e);
    if p >= e {
        return 0;                                        // 裸 `ret`
    }
    if has_at(a, p, e, "void") {
        return 0;
    }
    let ts: u64 = ty_span(a, p, e);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
    let vs: u64 = trim_span(a, vo, e);
    if is_agg(a, hi32(ts), lo32(ts)) {
        if cfr == NONE {
            fail("没有调用者的聚合返回值");
        }
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let v: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let d: u32 = fr_agg(a, m, cfr, ro, rl, sz);
        mc(m, d, v as u32, sz);
        return (d as u64) | (((sz as u64)) << 32);
    }
    return operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
}

// ---------------------------------------------------------------- checkpoint（docs/364）
//
// 递归引擎的 guest 状态有一半分住在 Loment 自己的调用栈里；这一档把它搬进
// `CONT_OFF` 的续延记录：每层一帧 16 个 u32。快照 = ctx（256 B）+ 对象表 + 续延栈 +
// 4 MiB guest 内存；IR 表不存，恢复时重解析同一份输入。

fn cont_set(a: ptr, d: u32, i: u32, v: u32) {
    wr(a, CONT_OFF, d * CONT_REC + i, v);
}

fn cont_get(a: ptr, d: u32, i: u32) -> u32 {
    return rd(a, CONT_OFF, d * CONT_REC + i);
}

fn push_cont(a: ptr, d: u32, fi: u32, fr: u32, cfr: u32, ro: u32, rl: u32,
             bi: u32, do_: u32, dl: u32, priv: u32, hook: u32, a0: u64) {
    cont_set(a, d, 0, fi);
    cont_set(a, d, 1, fr);
    cont_set(a, d, 2, cfr);
    cont_set(a, d, 3, ro);
    cont_set(a, d, 4, rl);
    cont_set(a, d, 5, bi);
    cont_set(a, d, 6, 0);
    cont_set(a, d, 7, do_);
    cont_set(a, d, 8, dl);
    cont_set(a, d, 9, priv);
    cont_set(a, d, 10, hook);
    cont_set(a, d, 11, lo32(a0));
    cont_set(a, d, 12, hi32(a0));
    cont_set(a, d, 13, NONE);
}

fn store_val(a: ptr, m: ptr, fr: u32, do_: u32, dl: u32, v: u64) {
    store_valc(a, m, fr, do_, dl, v, 0, 0);
}

fn store_valc(a: ptr, m: ptr, fr: u32, do_: u32, dl: u32, v: u64,
              cb: u32, ct: u32) {
    if dl > 0 {
        let ex: u32 = vfind(a, m, fr, do_, dl);
        if ex == NONE {
            vputc(a, m, fr, do_, dl, v, cb, ct);
        } else {
            vsetc(a, m, fr, ex, v, cb, ct);
        }
    }
}

/// 显式栈引擎：与 `exec_body` 同语义，但调用**压栈**而不是递归。
fn exec_stack(a: ptr, m: ptr, fresh: u32) {
    if fresh == 1 {
        let fi: u32 = fn_find_lit(a, "@_start");
        if fi == NONE {
            fail("这份 IR 里没有 `_start`");
        }
        let fr: u32 = MEM_SIZE - FRAME_SIZE;
        wr(m, fr, 0, 0);
        wr(m, fr, 1, FR_SLOTS);
        ctx_set(a, C_DEPTH, 1);
        ctx_set(a, C_NFOBJ, 0);
        wr(a, FBASE_OFF, 4, 0);
        push_cont(a, 1, fi, fr, NONE, 0, 0, rd(a, F_OFF, fi * 8 + 6), 0, 0, 0, 0, 0);
    }
    while ctx_get(a, C_DEPTH) > 0 {
        let d: u32 = ctx_get(a, C_DEPTH);
        let fi: u32 = cont_get(a, d, 0);
        let fr: u32 = cont_get(a, d, 1);
        let cfr: u32 = cont_get(a, d, 2);
        let ro: u32 = cont_get(a, d, 3);
        let rl: u32 = cont_get(a, d, 4);
        let bi: u32 = cont_get(a, d, 5);
        let j: u32 = cont_get(a, d, 6);
        let do_: u32 = cont_get(a, d, 7);
        let dl: u32 = cont_get(a, d, 8);
        let at: u32 = ctx_get(a, C_CKPT_AT);
        if load32(a, SNAP_HDR + 60) != 0 && ctx_get(a, C_STEPS) >= at {
            snapshot_write(a, m);
            let _x: u32 = die(0);
        }
        let io: u32 = rd(a, B_OFF, bi * 5 + 2);
        let ni: u32 = rd(a, B_OFF, bi * 5 + 3);
        if j >= ni {
            fail("块没有终结指令");
        }
        if j == 0 {
            bump_block(a, bi);
        }
        ctx_set(a, C_SITE_FI, fi);
        ctx_set(a, C_SITE_BI, bi);
        ctx_set(a, C_SITE_J, j);
        let ii: u32 = io + j;
        let k: u32 = rd(a, I_OFF, ii * 8 + 4);
        let sub: u32 = rd(a, I_OFF, ii * 8 + 5);
        let to: u32 = rd(a, I_OFF, ii * 8 + 2);
        let tl: u32 = rd(a, I_OFF, ii * 8 + 3);
        let dst: u32 = rd(a, I_OFF, ii * 8);
        let dl2: u32 = rd(a, I_OFF, ii * 8 + 1);
        ctx_set(a, 84, to);
        ctx_set(a, 88, tl);
        let ns: u32 = ctx_get(a, C_STEPS) + 1;
        if ns > STEP_CAP {
            wstr(2, "lvm: 执行超过 ");
            write_num(a, 2, STEP_CAP);
            wstr(2, " 条指令，卡在 ");
            let fno: u32 = rd(a, F_OFF, fi * 8);
            write_all(2, ptr_add(a, fno), rd(a, F_OFF, fi * 8 + 1) as u64);
            wstr(2, " 的 [");
            write_all(2, ptr_add(a, to), tl as u64);
            wstr(2, "]
");
            let _s: u32 = die(2);
        }
        ctx_set(a, C_STEPS, ns);
        let prev: u32 = cont_get(a, d, 13);
        if k == K_BR_UNCOND {
            bump_edge(a, ii, 0);
            cont_set(a, d, 13, bi);
            cont_set(a, d, 5, sub);
            cont_set(a, d, 6, 0);
        } else if k == K_BR_COND {
            let e: u32 = to + tl;
            let ts: u64 = ty_span(a, after_op(a, to, e), e);
            let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
            let vs: u64 = trim_span(a, p, seg_end(a, p, e));
            let c: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
            cont_set(a, d, 13, bi);
            if c != 0 {
                bump_edge(a, ii, 0);
                cont_set(a, d, 5, sub >> 16);
            } else {
                bump_edge(a, ii, 1);
                cont_set(a, d, 5, sub & 65535);
            }
            cont_set(a, d, 6, 0);
        } else if k == K_SWITCH {
            let sv: u32 = switch_of(a, m, fr, to, tl, fi);
            bump_edge(a, ii, sv & 65535);
            cont_set(a, d, 13, bi);
            cont_set(a, d, 5, sv >> 16);
            cont_set(a, d, 6, 0);
        } else if k == K_RET {
            let v: u64 = do_ret(a, m, fr, cfr, to, tl, ro, rl);
            let priv: u32 = cont_get(a, d, 9);
            if priv != 0 {
                ctx_set(a, C_PRIV, ctx_get(a, C_PRIV) - 1);
            }
            if ctx_get(a, C_SUB) != 0 {
                let hook: u32 = cont_get(a, d, 10);
                let a0: u64 = ((cont_get(a, d, 12) as u64) << 32)
                              | (cont_get(a, d, 11) as u64);
                if hook == 1 {
                    obj_new(a, v as u32, (v as u32) + (a0 as u32), OBJ_HEAP);
                } else if hook == 2 {
                    obj_retire_base(a, a0 as u32);
                }
            }
            ctx_set(a, C_DEPTH, d - 1);
            if d > 1 {
                let cd: u32 = d - 1;
                store_val(a, m, cont_get(a, cd, 1), cont_get(a, cd, 7),
                          cont_get(a, cd, 8), v);
            }
        } else if k == K_PHI {
            if dl2 > 0 {
                let v: u64 = phi_of(a, m, fr, to, tl, prev);
                store_val(a, m, fr, dst, dl2, v);
            }
            cont_set(a, d, 6, j + 1);
        } else if k == K_CALL {
            cont_set(a, d, 5, bi);
            cont_set(a, d, 6, j + 1);
            cont_set(a, d, 7, dst);
            cont_set(a, d, 8, dl2);
            let b: u64 = bind_call(a, m, to, tl, fr, dst, dl2);
            let nfi: u32 = hi32(b);
            let priv: u32 = ctx_get(a, C_BIND_PRIV);
            let hook: u32 = ctx_get(a, C_BIND_HOOK);
            let a0: u64 = ((ctx_get(a, C_BIND_A0HI) as u64) << 32)
                          | (ctx_get(a, C_BIND_A0LO) as u64);
            if d_on(a) == 1 && hook != 0 {
                // 与递归引擎同一条（`docs/368` §1.5）：分配器是模型原生的 ——
                // 造一颗体 / 退休一颗体，不进去跑按地址写的运行期代码。
                let hv: u64 = 0;
                if hook == 1 {
                    hv = d_alloc_body(a, DK_HEAP, a0 as u32);
                } else {
                    let fxi: u32 = d_find(a, a0);
                    if fxi != NONE {
                        d_retire_body(a, rd(a, DT_OFF, fxi * 4 + 2));
                    }
                }
                ctx_set(a, C_DEPTH, d);
                store_val(a, m, fr, dst, dl2, hv);
                cont_set(a, d, 6, j + 1);
            } else {
                if priv != 0 {
                    ctx_set(a, C_PRIV, ctx_get(a, C_PRIV) + 1);
                }
                push_cont(a, d + 1, nfi, lo32(b), fr, dst, dl2,
                          rd(a, F_OFF, nfi * 8 + 6), 0, 0, priv, hook, a0);
            }
        } else if k == K_ASMCALL {
            let v: u64 = do_asm(a, m, fr, to, tl);
            store_val(a, m, fr, dst, dl2, v);
            cont_set(a, d, 6, j + 1);
        } else {
            let v: u64 = eval_instr(a, m, fr, cfr, to, tl, k, sub, dst, dl2);
            let cp: u64 = result_cap(a, m, fr, k, to, tl, v);
            store_valc(a, m, fr, dst, dl2, v, lo32(cp) as u32, hi32(cp) as u32);
            cont_set(a, d, 6, j + 1);
        }
    }
}

fn fnv32(a: ptr, n: u32) -> u32 {
    let h: u32 = 2166136261;
    let i: u32 = 0;
    while i < n {
        h = (h ^ (load8(a, i) as u32)) * 16777619;
        i = i + 1;
    }
    return h;
}

fn read_exact(fd: u64, p: ptr, n: u32) -> u32 {
    let off: u32 = 0;
    while off < n {
        let got: i64 = syscall4(0, fd, ((p as u64) + (off as u64)), (n - off) as u64);
        if got <= 0 {
            return 0;
        }
        off = off + (got as u32);
    }
    return 1;
}

/// 快照（共同格式，docs/372）：头 16 B + ctx 256 B + 全局表 + 对象表 +
/// 续延栈 2112 B + guest 内存 4 MiB + 扩展（帧名字段 + 四个空段）。
fn wu32(f: u64, a: ptr, v: u32) {
    store32(a, SNAP_HDR + 16, v);
    let _n: u64 = write_all(f, ptr_add(a, SNAP_HDR + 16), 4);
}

fn wname(f: u64, a: ptr, off: u32, len: u32) {
    wu32(f, a, len);
    if len > 0 {
        let _n: u64 = write_all(f, ptr_add(a, off), len as u64);
    }
}

fn ru32(f: u64, a: ptr) -> u32 {
    if read_exact(f, ptr_add(a, SNAP_HDR + 16), 4) == 0 {
        fail("checkpoint：文件截断了");
    }
    return load32(a, SNAP_HDR + 16);
}

/// 恢复一个**活**对象（按 base 插进有序表；gen 用文件里的）。
fn obj_restore(a: ptr, base: u32, limit: u32, gen: u32, kind: u32) {
    let n: u32 = ctx_get(a, C_NOBJ);
    if n >= MAX_OBJS {
        fail("checkpoint：对象表满了");
    }
    let pos: u32 = obj_find_pos(a, base);
    let i: u32 = n;
    while i > pos {
        obj_copy(a, i, i - 1);
        i = i - 1;
    }
    obj_put(a, pos, base, limit, kind);
    wr(a, OBJ_OFF, pos * 5 + 2, gen);
    ctx_set(a, C_NOBJ, n + 1);
}

/// 恢复一条**已归还**对象（只进最近 1024 条的窗口）。
fn ret_restore(a: ptr, base: u32, limit: u32, gen: u32, kind: u32) {
    let nr: u32 = ctx_get(a, C_NRET);
    if nr >= MAX_RET {
        let i: u32 = 1;
        while i < MAX_RET {
            ret_copy(a, i - 1, i);
            i = i + 1;
        }
        nr = MAX_RET - 1;
    }
    wr(a, RET_OFF, nr * 5, base);
    wr(a, RET_OFF, nr * 5 + 1, limit);
    wr(a, RET_OFF, nr * 5 + 2, gen);
    wr(a, RET_OFF, nr * 5 + 3, 0);
    wr(a, RET_OFF, nr * 5 + 4, kind);
    ctx_set(a, C_NRET, nr + 1);
}

/// 共同格式的 PC 用**名字**：两边解析出来的块号可能不同（自举比参考少一个块）。
fn fn_find_name(a: ptr, m: ptr, no: u32, nl: u32) -> u32 {
    if nl == 0 {
        return NONE;
    }
    let nf: u32 = ctx_get(a, C_NF);
    let i: u32 = 0;
    while i < nf {
        let o: u32 = rd(a, F_OFF, i * 8);
        let l: u32 = rd(a, F_OFF, i * 8 + 1);
        // F 表的名字带 `@`；共同格式里不带。
        if l == nl + 1 && same(a, o + 1, m, no, nl) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

fn blk_find_name(a: ptr, fi: u32, m: ptr, no: u32, nl: u32) -> u32 {
    if fi == NONE || nl == 0 {
        return NONE;
    }
    let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
    let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
    let i: u32 = 0;
    while i < nb {
        let o: u32 = rd(a, B_OFF, (fb + i) * 5);
        let l: u32 = rd(a, B_OFF, (fb + i) * 5 + 1);
        if l == nl && same(a, o, m, no, nl) {
            return fb + i;
        }
        i = i + 1;
    }
    return NONE;
}

/// 按名字把全局表的 `+4` 补成地址（`place_globals` 在恢复时被跳过）。
fn gpatch(a: ptr, m: ptr, no: u32, nl: u32, addr: u32) {
    let ng: u32 = ctx_get(a, C_NG);
    let i: u32 = 0;
    let hit: u32 = 0;
    while i < ng && hit == 0 {
        let o: u32 = rd(a, G_OFF, i * 6);
        let l: u32 = rd(a, G_OFF, i * 6 + 1);
        if l == nl && same(a, o, m, no, nl) {
            wr(a, G_OFF, i * 6 + 4, addr);
            hit = 1;
        }
        i = i + 1;
    }
    if hit == 0 {
        fail("checkpoint：全局表对不上");
    }
}

/// 从恢复出来的对象表重建每帧的 alloca 列表（按帧地址区间分组）。
fn frame_obj_rebuild(a: ptr) {
    ctx_set(a, C_NFOBJ, 0);
    let d: u32 = 1;
    let depth: u32 = ctx_get(a, C_DEPTH);
    while d <= depth {
        // 与 `frame_retire` / `bind_call` 同一个下标单位：**第 d*4 个字**，
        // 不是 `FBASE_OFF + d*4` 字节（2026-11-21：恢复后一返回就把整张表当成这帧的）。
        wr(a, FBASE_OFF, d * 4, ctx_get(a, C_NFOBJ));
        let fbase: u32 = MEM_SIZE - d * FRAME_SIZE;
        let i: u32 = 0;
        let nobj: u32 = ctx_get(a, C_NOBJ);
        while i < nobj {
            if obj_kind(a, i) == OBJ_ALLOCA {
                let b: u32 = obj_base(a, i);
                if b >= fbase && b < fbase + FRAME_SIZE {
                    wr(a, FOBJ_OFF, ctx_get(a, C_NFOBJ), b);
                    ctx_set(a, C_NFOBJ, ctx_get(a, C_NFOBJ) + 1);
                }
            }
            i = i + 1;
        }
        d = d + 1;
    }
}

fn snapshot_write(a: ptr, m: ptr) {
    let po: u32 = load32(a, SNAP_HDR + 40);
    let pl: u32 = load32(a, SNAP_HDR + 44);
    if pl == 0 {
        fail("checkpoint：没给输出路径（ckpt-out=...）");
    }
    let fd: i64 = syscall4(2, ptr_add(a, ARGV_OFF + po) as u64, 577, 420);
    if fd < 0 {
        fail("checkpoint：写不了快照");
    }
    let f: u64 = fd as u64;
    store8(a, SNAP_HDR, 76);          // L
    store8(a, SNAP_HDR + 1, 86);      // V
    store8(a, SNAP_HDR + 2, 77);      // M
    store8(a, SNAP_HDR + 3, 67);      // C
    store32(a, SNAP_HDR + 4, 1);      // version
    store32(a, SNAP_HDR + 8, ctx_get(a, C_IFHASH));
    if d_on(a) == 1 {
        store32(a, SNAP_HDR + 12, 3);               // 3 = dismemory（docs/375 §2.5）
    } else {
        store32(a, SNAP_HDR + 12, ctx_get(a, C_SUB));   // 0 = none / 1 = sw_cap / 2 = sw_tag
    }
    let _a: u64 = write_all(f, ptr_add(a, SNAP_HDR), 16);
    let _b: u64 = write_all(f, ptr_add(a, CTX_OFF), 256);
    // 全局表：名字 + 地址（`+4` 是 place_globals 写的地址）。
    let ng: u32 = ctx_get(a, C_NG);
    wu32(f, a, ng);
    let i: u32 = 0;
    while i < ng {
        wname(f, a, rd(a, G_OFF, i * 6), rd(a, G_OFF, i * 6 + 1));
        wu32(f, a, rd(a, G_OFF, i * 6 + 4));
        i = i + 1;
    }
    // 对象：活的在前，归还的在后（共同格式的 kind 码与自举的 OBJ_* 同数）。
    let nlive: u32 = ctx_get(a, C_NOBJ);
    let nret: u32 = ctx_get(a, C_NRET);
    wu32(f, a, nlive + nret);
    i = 0;
    while i < nlive {
        wu32(f, a, i + 1);
        wu32(f, a, obj_base(a, i));
        wu32(f, a, obj_limit(a, i));
        wu32(f, a, rd(a, OBJ_OFF, i * 5 + 2));
        wu32(f, a, 1);
        wu32(f, a, obj_kind(a, i));
        wu32(f, a, 0);
        i = i + 1;
    }
    i = 0;
    while i < nret {
        wu32(f, a, 2147483648 + i);
        wu32(f, a, rd(a, RET_OFF, i * 5));
        wu32(f, a, rd(a, RET_OFF, i * 5 + 1));
        wu32(f, a, rd(a, RET_OFF, i * 5 + 2));
        wu32(f, a, 0);
        wu32(f, a, rd(a, RET_OFF, i * 5 + 4));
        wu32(f, a, 0);
        i = i + 1;
    }
    wu32(f, a, nlive + nret + 1);
    wu32(f, a, 0);
    let _c: u64 = write_all(f, ptr_add(a, CONT_OFF),
                            (MAX_CONT * CONT_REC * 4) as u64);
    let _e: u64 = write_all(f, m, MEM_SIZE as u64);
    // 最小扩展：LVEX / version 1 / npending 0 / ncaps 0 / nshadow 0 / nvfd 0 / nargv 0
    store8(a, SNAP_HDR + 16, 76);
    store8(a, SNAP_HDR + 17, 86);
    store8(a, SNAP_HDR + 18, 69);
    store8(a, SNAP_HDR + 19, 88);
    store32(a, SNAP_HDR + 20, 1);
    store32(a, SNAP_HDR + 24, 0);
    let _x: u64 = write_all(f, ptr_add(a, SNAP_HDR + 16), 12);
    // 帧的**名字**（函数 / 块 / 前驱）：两边解析出来的下标可能差一格。
    wu32(f, a, ctx_get(a, C_DEPTH));
    let d: u32 = 1;
    while d <= ctx_get(a, C_DEPTH) {
        let fi: u32 = cont_get(a, d, 0);
        let fo: u32 = rd(a, F_OFF, fi * 8);
        let fl: u32 = rd(a, F_OFF, fi * 8 + 1);
        if fl > 1 {
            wname(f, a, fo + 1, fl - 1);     // 去掉 `@`
        } else {
            wu32(f, a, 0);
        }
        let bi: u32 = cont_get(a, d, 5);
        wname(f, a, rd(a, B_OFF, bi * 5), rd(a, B_OFF, bi * 5 + 1));
        let pv: u32 = cont_get(a, d, 13);
        if pv == NONE {
            wu32(f, a, 0);
        } else {
            wname(f, a, rd(a, B_OFF, pv * 5), rd(a, B_OFF, pv * 5 + 1));
        }
        d = d + 1;
    }
    // caps / shadow：镜像按地址重建能力，写空段（参考侧读侧照样跳过）。
    wu32(f, a, 0);
    wu32(f, a, 0);
    // 合成文件（被解释程序自己的 `/proc/self/cmdline`）：**连同读游标与字节**。
    // W5（`docs/360` §4）：停在 read 中间的 guest，恢复后要从同一位置接着读。
    if ctx_get(a, C_VFD_OPEN) != 0 {
        wu32(f, a, 1);
        wu32(f, a, ctx_get(a, C_VFD_OPEN));         // fd（两个实现的 VFD 都是 1000）
        wu32(f, a, ctx_get(a, C_VFD_POS));
        // `C_ARG0` 是 **ARGV 区内的相对偏移**（`vm_syscall` 的 read 也是这么用的）。
        wname(f, a, ARGV_OFF + ctx_get(a, C_ARG0), ctx_get(a, C_ARG0N));
    } else {
        wu32(f, a, 0);
    }
    // argv：guest 的命令行字段（去掉末尾 NUL），恢复侧据此重建之后新开的 cmdline。
    if ctx_get(a, C_ARG0N) > 1 {
        wu32(f, a, 1);
        wname(f, a, ARGV_OFF + ctx_get(a, C_ARG0), ctx_get(a, C_ARG0N) - 1);
    } else {
        wu32(f, a, 0);
    }

    if d_on(a) == 1 {
        // ---- dismemory 段（`docs/375` §2.5）：帧是密排的（同今天那份 4 MiB），
        // 体内容不在里面 —— 这里补上全局令牌 / 体表 / 格表 / 令牌表 / 帧对象栈 / 序号。
        let ng2: u32 = ctx_get(a, C_NG);
        wu32(f, a, ng2);
        i = 0;
        while i < ng2 {
            wu32(f, a, rd(a, GD_OFF, i * 2));
            wu32(f, a, rd(a, GD_OFF, i * 2 + 1));
            i = i + 1;
        }
        let nb2: u32 = ctx_get(a, C_DNB);
        wu32(f, a, nb2);
        i = 0;
        while i < nb2 {
            wu32(f, a, d_body(a, i, 0));
            wu32(f, a, d_body(a, i, 1));
            wu32(f, a, d_body(a, i, 10));
            wu32(f, a, d_body(a, i, 9));
            i = i + 1;
        }
        let nc2: u32 = 0;
        i = 0;
        while i < MAX_CT {
            if rd(a, CT_OFF, i * 4 + 3) == 1 {
                nc2 = nc2 + 1;
            }
            i = i + 1;
        }
        wu32(f, a, nc2);
        i = 0;
        while i < MAX_CT {
            if rd(a, CT_OFF, i * 4 + 3) == 1 {
                let cb: u32 = rd(a, CT_OFF, i * 4);
                let cp: u32 = rd(a, CT_OFF, i * 4 + 1);
                let sz: u32 = d_body(a, cb, 1);
                let cl: u32 = cp;
                if sz > 0 {
                    let sh: u32 = d_body(a, cb, 10) % sz;
                    cl = (cp + sz - sh) % sz;
                }
                wu32(f, a, cb);
                wu32(f, a, cl);
                wu32(f, a, rd(a, CT_OFF, i * 4 + 2));
            }
            i = i + 1;
        }
        let nt2: u32 = ctx_get(a, C_DNT);
        wu32(f, a, nt2);
        i = 0;
        while i < nt2 {
            wu32(f, a, rd(a, DT_OFF, i * 4));
            wu32(f, a, rd(a, DT_OFF, i * 4 + 1));
            wu32(f, a, rd(a, DT_OFF, i * 4 + 2));
            wu32(f, a, rd(a, DT_OFF, i * 4 + 3));
            i = i + 1;
        }
        let nr2: u32 = ctx_get(a, C_DNR);
        wu32(f, a, nr2);
        i = 0;
        while i < nr2 {
            wu32(f, a, rd(a, DR_OFF, i * 4));
            wu32(f, a, rd(a, DR_OFF, i * 4 + 1));
            wu32(f, a, rd(a, DR_OFF, i * 4 + 2));
            wu32(f, a, rd(a, DR_OFF, i * 4 + 3));
            i = i + 1;
        }
        let nfo2: u32 = ctx_get(a, C_NFOBJ);
        wu32(f, a, nfo2);
        i = 0;
        while i < nfo2 {
            wu32(f, a, rd(a, FOBJ_OFF, i));
            i = i + 1;
        }
        let dep2: u32 = ctx_get(a, C_DEPTH);
        wu32(f, a, dep2);
        i = 1;
        while i <= dep2 {
            wu32(f, a, rd(a, FBASE_OFF, i * 4));
            i = i + 1;
        }
        wu32(f, a, ctx_get(a, C_DTSLO));
        wu32(f, a, ctx_get(a, C_DTSHI));
    }
    if ctx_get(a, C_SUB) == 2 {
        // ---- sw_tag（`docs/364`）：对象 4 位标签 / 每帧值能力 / 影子表，三块整段。
        let _a1: u64 = write_all(f, ptr_add(a, TAG_OFF), (MAX_OBJS * 4) as u64);
        let _a2: u64 = write_all(f, ptr_add(a, CAP_OFF), (CAP_SLOTS * 8) as u64);
        let _a3: u64 = write_all(f, ptr_add(a, SH_OFF), (SH_CAP * 12) as u64);
    }
    let _f: i64 = syscall4(3, f, 0, 0);
}

fn snap_read_dis(a: ptr, f: u64) {
    let ng2: u32 = ru32(f, a);
    if ng2 != ctx_get(a, C_NG) {
        fail("checkpoint：全局数与快照不符");
    }
    let i: u32 = 0;
    while i < ng2 {
        wr(a, GD_OFF, i * 2, ru32(f, a));
        wr(a, GD_OFF, i * 2 + 1, ru32(f, a));
        i = i + 1;
    }
    let nb2: u32 = ru32(f, a);
    if nb2 > MAX_DB {
        fail("checkpoint：体表超过镜像上限");
    }
    i = 0;
    while i < nb2 {
        let kind: u32 = ru32(f, a);
        let size: u32 = ru32(f, a);
        let sh: u32 = ru32(f, a);
        let alive: u32 = ru32(f, a);
        d_bset(a, i, 0, kind);
        d_bset(a, i, 1, size);
        d_bset(a, i, 10, sh);
        d_bset(a, i, 9, alive);
        let dd: u32 = 1;
        while dd * dd * dd < size {
            dd = dd + 1;
        }
        d_bset(a, i, 3, dd);
        d_bset(a, i, 4, dd);
        d_bset(a, i, 5, (size + dd * dd - 1) / (dd * dd));
        d_bset(a, i, 6, 0);
        d_bset(a, i, 7, 0);
        d_bset(a, i, 8, 0);
        d_place(a, i);
        i = i + 1;
    }
    ctx_set(a, C_DNB, nb2);
    i = 0;
    while i < MAX_CT {
        wr(a, CT_OFF, i * 4 + 2, 0);
        wr(a, CT_OFF, i * 4 + 3, 0);
        i = i + 1;
    }
    let nc2: u32 = ru32(f, a);
    i = 0;
    while i < nc2 {
        let cb: u32 = ru32(f, a);
        let cl: u32 = ru32(f, a);
        let bv: u32 = ru32(f, a);
        d_cput(a, cb, cl, bv);
        i = i + 1;
    }
    let nt2: u32 = ru32(f, a);
    if nt2 > MAX_DT {
        fail("checkpoint：令牌表超过镜像上限");
    }
    i = 0;
    while i < nt2 {
        wr(a, DT_OFF, i * 4, ru32(f, a));
        wr(a, DT_OFF, i * 4 + 1, ru32(f, a));
        wr(a, DT_OFF, i * 4 + 2, ru32(f, a));
        wr(a, DT_OFF, i * 4 + 3, ru32(f, a));
        i = i + 1;
    }
    ctx_set(a, C_DNT, nt2);
    let nr2: u32 = ru32(f, a);
    if nr2 > MAX_DR {
        fail("checkpoint：反向表超过镜像上限");
    }
    i = 0;
    while i < nr2 {
        wr(a, DR_OFF, i * 4, ru32(f, a));
        wr(a, DR_OFF, i * 4 + 1, ru32(f, a));
        wr(a, DR_OFF, i * 4 + 2, ru32(f, a));
        wr(a, DR_OFF, i * 4 + 3, ru32(f, a));
        i = i + 1;
    }
    ctx_set(a, C_DNR, nr2);
    let nfo2: u32 = ru32(f, a);
    if nfo2 > MAX_FOBJ {
        fail("checkpoint：帧对象栈超过镜像上限");
    }
    i = 0;
    while i < nfo2 {
        wr(a, FOBJ_OFF, i, ru32(f, a));
        i = i + 1;
    }
    ctx_set(a, C_NFOBJ, nfo2);
    let dep2: u32 = ru32(f, a);
    if dep2 > MAX_DEPTH {
        fail("checkpoint：深度超过镜像上限");
    }
    i = 1;
    while i <= dep2 {
        wr(a, FBASE_OFF, i * 4, ru32(f, a));
        i = i + 1;
    }
    ctx_set(a, C_DTSLO, ru32(f, a));
    ctx_set(a, C_DTSHI, ru32(f, a));
}

fn snapshot_read(a: ptr, m: ptr, po: u32, pl: u32) {
    let fd: i64 = syscall4(2, ptr_add(a, ARGV_OFF + po) as u64, 0, 0);
    if fd < 0 {
        fail("checkpoint：读不了快照");
    }
    let f: u64 = fd as u64;
    if read_exact(f, ptr_add(a, SNAP_HDR), 16) == 0 {
        fail("checkpoint：快照头读不全");
    }
    if load8(a, SNAP_HDR) != 76 || load8(a, SNAP_HDR + 1) != 86
            || load8(a, SNAP_HDR + 2) != 77 || load8(a, SNAP_HDR + 3) != 67 {
        fail("checkpoint：魔数不对");
    }
    if load32(a, SNAP_HDR + 4) != 1 {
        fail("checkpoint：不认识的版本");
    }
    if load32(a, SNAP_HDR + 8) != ctx_get(a, C_IFHASH) {
        fail("checkpoint：IR 与快照不匹配（字节码换了）");
    }
    let flags: u32 = load32(a, SNAP_HDR + 12);
    // 自己进程的 cmdline 位置不能被快照里的值覆盖（那是参考侧的数）。
    let my_arg0: u32 = ctx_get(a, C_ARG0);
    let my_arg0n: u32 = ctx_get(a, C_ARG0N);
    if read_exact(f, ptr_add(a, CTX_OFF), 256) == 0 {
        fail("checkpoint：ctx 读不全");
    }
    ctx_set(a, C_ARG0, my_arg0);
    ctx_set(a, C_ARG0N, my_arg0n);
    ctx_set(a, C_SUB, 0);
    if flags == 1 || flags == 2 {
        ctx_set(a, C_SUB, flags);
    }
    ctx_set(a, C_NOBJ, 0);
    ctx_set(a, C_NRET, 0);
    // 全局表：按名字补地址
    let ng: u32 = ru32(f, a);
    let i: u32 = 0;
    while i < ng {
        let nl: u32 = ru32(f, a);
        if nl > 240 {
            fail("checkpoint：全局名太长");
        }
        if read_exact(f, m, nl) == 0 {
            fail("checkpoint：全局名读不全");
        }
        gpatch(a, m, 0, nl, ru32(f, a));
        i = i + 1;
    }
    // 对象表
    let n: u32 = ru32(f, a);
    i = 0;
    while i < n {
        if read_exact(f, m, 28) == 0 {
            fail("checkpoint：对象表读不全");
        }
        let base: u32 = load32(m, 4);
        let limit: u32 = load32(m, 8);
        let gen: u32 = load32(m, 12);
        let alive: u32 = load32(m, 16);
        let kind: u32 = load32(m, 20);
        let k: u32 = kind;
        if k > 4 {
            k = OBJ_GLOBAL;
        }
        if alive != 0 {
            obj_restore(a, base, limit, gen, k);
        } else {
            ret_restore(a, base, limit, gen, k);
        }
        i = i + 1;
    }
    let _no: u32 = ru32(f, a);
    let _ts: u32 = ru32(f, a);
    if read_exact(f, ptr_add(a, CONT_OFF), MAX_CONT * CONT_REC * 4) == 0 {
        fail("checkpoint：续延栈读不全");
    }
    if read_exact(f, m, MEM_SIZE) == 0 {
        fail("checkpoint：内存读不全");
    }
    // 可选扩展：头 12 字节 + 帧名字段（函数 / 块 / 前驱）。
    if read_exact(f, ptr_add(a, SNAP_HDR + 16), 12) == 1 {
        if load8(a, SNAP_HDR + 16) != 76 || load8(a, SNAP_HDR + 17) != 86
                || load8(a, SNAP_HDR + 18) != 69 || load8(a, SNAP_HDR + 19) != 88 {
            fail("checkpoint：扩展魔数不对");
        }
        if load32(a, SNAP_HDR + 24) != 0 {
            fail("checkpoint：跨实现恢复不支持停在 phi 中途（docs/372）");
        }
        let nf: u32 = ru32(f, a);
        if nf >= MAX_CONT {
            fail("checkpoint：续延栈太深");
        }
        if nf != ctx_get(a, C_DEPTH) {
            fail("checkpoint：帧数与深度不一致");
        }
        let d: u32 = 1;
        while d <= nf {
            let fl: u32 = ru32(f, a);
            if fl > 240 {
                fail("checkpoint：函数名太长");
            }
            if fl > 0 && read_exact(f, ptr_add(a, NAME_SCRATCH), fl) == 0 {
                fail("checkpoint：函数名读不全");
            }
            let fi: u32 = fn_find_name(a, ptr_add(a, NAME_SCRATCH), 0, fl);
            let bl: u32 = ru32(f, a);
            if bl > 240 {
                fail("checkpoint：块名太长");
            }
            if bl > 0 && read_exact(f, ptr_add(a, NAME_SCRATCH), bl) == 0 {
                fail("checkpoint：块名读不全");
            }
            let bi: u32 = blk_find_name(a, fi, ptr_add(a, NAME_SCRATCH), 0, bl);
            let pn: u32 = ru32(f, a);
            let pv: u32 = NONE;
            if pn > 0 {
                if pn > 240 {
                    fail("checkpoint：前驱名太长");
                }
                if read_exact(f, ptr_add(a, NAME_SCRATCH), pn) == 0 {
                    fail("checkpoint：前驱名读不全");
                }
                pv = blk_find_name(a, fi, ptr_add(a, NAME_SCRATCH), 0, pn);
                if pv == NONE {
                    fail("checkpoint：前驱块名字对不上");
                }
            }
            if fi == NONE || bi == NONE {
                fail("checkpoint：函数/块名字对不上");
            }
            cont_set(a, d, 0, fi);
            cont_set(a, d, 5, bi);
            cont_set(a, d, 13, pv);
            d = d + 1;
        }
        // caps：跳过 —— 镜像的能力按地址重建（`docs/372` §2 的保真度边界）。
        let nc: u32 = ru32(f, a);
        let ci: u32 = 0;
        while ci < nc {
            let _cd: u32 = ru32(f, a);
            let cn: u32 = ru32(f, a);
            if cn > 240 {
                fail("checkpoint：能力名太长");
            }
            if cn > 0 && read_exact(f, ptr_add(a, NAME_SCRATCH), cn) == 0 {
                fail("checkpoint：能力名读不全");
            }
            let _co: u32 = ru32(f, a);
            let _cg: u32 = ru32(f, a);
            let _ct: u32 = ru32(f, a);
            ci = ci + 1;
        }
        // shadow：跳过 —— 同一条理由。
        let ns: u32 = ru32(f, a);
        let si: u32 = 0;
        while si < ns {
            let _sa: u32 = ru32(f, a);
            let _so: u32 = ru32(f, a);
            let _sg: u32 = ru32(f, a);
            let _st: u32 = ru32(f, a);
            si = si + 1;
        }
        // 合成文件：采用快照里的 fd / 读游标 / 字节（W5，`docs/360` §4）。
        let nv: u32 = ru32(f, a);
        if nv > 0 {
            let vfd: u32 = ru32(f, a);
            let vpos: u32 = ru32(f, a);
            let vlen: u32 = ru32(f, a);
            if vlen > 8192 {
                fail("checkpoint：命令行太长");
            }
            if vlen > 0 && read_exact(f, ptr_add(a, ARGV_OFF), vlen) == 0 {
                fail("checkpoint：命令行读不全");
            }
            ctx_set(a, C_ARG0, 0);
            ctx_set(a, C_ARG0N, vlen);
            ctx_set(a, C_VFD_POS, vpos);
            ctx_set(a, C_VFD_OPEN, vfd);
            let vi: u32 = 1;
            while vi < nv {
                let _vf: u32 = ru32(f, a);
                let _vp: u32 = ru32(f, a);
                let vl: u32 = ru32(f, a);
                if vl > 8192 {
                    fail("checkpoint：命令行太长");
                }
                if vl > 0 && read_exact(f, ptr_add(a, ARGV_OFF), vl) == 0 {
                    fail("checkpoint：命令行读不全");
                }
                vi = vi + 1;
            }
        }
        // argv：把被解释程序自己的命令行重建到 ARGV 区 —— 恢复之后**新开**的 cmdline
        // 拿到的是同一份字节，不是解释器进程的那一份。
        let na: u32 = ru32(f, a);
        if na > 0 {
            let wt: u32 = 0;
            let first: u32 = 0;
            let ai2: u32 = 0;
            while ai2 < na {
                let al: u32 = ru32(f, a);
                if wt + al + 1 > 8192 {
                    fail("checkpoint：命令行太长");
                }
                if al > 0 && read_exact(f, ptr_add(a, ARGV_OFF + wt), al) == 0 {
                    fail("checkpoint：命令行读不全");
                }
                store8(a, ARGV_OFF + wt + al, 0 as u8);
                if ai2 == 0 {
                    first = wt;
                }
                wt = wt + al + 1;
                ai2 = ai2 + 1;
            }
            ctx_set(a, C_ARG0, first);
            ctx_set(a, C_ARG0N, wt - first);
        }
    }
    if flags == 3 {
        snap_read_dis(a, f);
    } else {
        if flags == 2 {
            // sw_tag 的三张表（与写端同一段、同一顺序）。
            if read_exact(f, ptr_add(a, TAG_OFF), MAX_OBJS * 4) == 0 {
                fail("checkpoint：标签表读不全");
            }
            if read_exact(f, ptr_add(a, CAP_OFF), CAP_SLOTS * 8) == 0 {
                fail("checkpoint：能力表读不全");
            }
            if read_exact(f, ptr_add(a, SH_OFF), SH_CAP * 12) == 0 {
                fail("checkpoint：影子表读不全");
            }
        }
        frame_obj_rebuild(a);
    }
    let _c: i64 = syscall4(3, f, 0, 0);
}

/// `argv_n` 的那一格若以 `prefix` 开头，返回值的 span；否则 `0`。
fn arg_tail(ab: ptr, f: u64, prefix: str) -> u64 {
    let off: u32 = hi32(f);
    let len: u32 = lo32(f);
    let pl: u32 = str_len(prefix) as u32;
    if len > pl && has_at(ab, off, off + len, prefix) {
        return (((off + pl) as u64) << 32) | ((len - pl) as u64);
    }
    return 0;
}

/// 这一格是不是解释器自己的选项（不是剖面/统计的文件名）。
fn is_opt_arg(ab: ptr, f: u64) -> bool {
    if lo32(f) == 0 {
        return false;
    }
    if eqw(ab, hi32(f), lo32(f), "sw_cap") {
        return true;
    }
    if eqw(ab, hi32(f), lo32(f), "sw_tag") {
        return true;
    }
    if lo32(arg_tail(ab, f, "ckpt=")) > 0 {
        return true;
    }
    if lo32(arg_tail(ab, f, "ckpt-out=")) > 0 {
        return true;
    }
    if lo32(arg_tail(ab, f, "resume=")) > 0 {
        return true;
    }
    // `docs/373`：重定位档。**必须在这里认**，否则它会被当成第二个位置实参（剖面文件），
    // 于是 `relocate=0` 变成一个被写出来的文件名 —— 实测在工作目录里留下了这三个空文件。
    if lo32(arg_tail(ab, f, "relocate=")) > 0 {
        return true;
    }
    return false;
}

// ---------------------------------------------------------------- T1：剖面（`docs/247`）

fn wlit(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

/// 把输入文本里的一段直接写出去 —— 剖面里的名字/标签就是那一段，不拷贝。
fn wspan_out(fd: u64, a: ptr, off: u32, len: u32) {
    if len > 0 {
        let n: u64 = write_all(fd, ptr_add(a, off), len as u64);
        let _x: u64 = n;
    }
}

/// 调用指令里的被调名（**去掉 `@`**，与参考那侧 `f.name` 同形）。
fn callee_span(a: ptr, to: u32, tl: u32) -> u64 {
    let e: u32 = to + tl;
    let i: u32 = index_of(a, to, e, 64);
    if i == NONE {
        return 0;
    }
    let j: u32 = word_end(a, i + 1, e);
    return (((i + 1) as u64) << 32) | ((j - i - 1) as u64);
}

/// 三个段各走一遍表。**顺序 = 解析顺序**（函数 → 块 → 指令）—— 参考那侧也改成按它走，
/// 两边的产物才逐字节比得了（`docs/247` §4 记了为什么不是按名字排序）。
fn dump_stats(a: ptr) {
    let fd: u32 = ctx_get(a, C_STATS_FD);
    if fd != 0 {
        write_num(a, fd as u64, ctx_get(a, C_MISS));
        wstr(fd as u64, "
");
        syscall4(3, fd as u64, 0, 0);
        ctx_set(a, C_STATS_FD, 0);
    }
}

fn dump_profile(a: ptr, fd: u64) {
    wlit(fd, "# lvm profile v1
");
    wlit(fd, "# site = (function, block, instruction-index-in-block); a block is (function, block)
");
    wlit(fd, "# order = IR parse order (function -> block -> instruction), not sorted by name
");
    wlit(fd, "[blocks]
");
    let fi: u32 = 0;
    while fi < ctx_get(a, C_NF) {
        let no: u32 = rd(a, F_OFF, fi * 8);
        let nl: u32 = rd(a, F_OFF, fi * 8 + 1);
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let b: u32 = 0;
        while b < nb {
            let cnt: u32 = rd(a, B_OFF, (fb + b) * 5 + 4);
            if cnt > 0 {
                wspan_out(fd, a, no + 1, nl - 1);
                wlit(fd, "	");
                wspan_out(fd, a, rd(a, B_OFF, (fb + b) * 5), rd(a, B_OFF, (fb + b) * 5 + 1));
                wlit(fd, "	");
                write_num(a, fd, cnt);
                wlit(fd, "
");
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
    wlit(fd, "[edges]
");
    fi = 0;
    while fi < ctx_get(a, C_NF) {
        let no: u32 = rd(a, F_OFF, fi * 8);
        let nl: u32 = rd(a, F_OFF, fi * 8 + 1);
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let b: u32 = 0;
        while b < nb {
            let bo: u32 = rd(a, B_OFF, (fb + b) * 5);
            let bl: u32 = rd(a, B_OFF, (fb + b) * 5 + 1);
            let io: u32 = rd(a, B_OFF, (fb + b) * 5 + 2);
            let ni: u32 = rd(a, B_OFF, (fb + b) * 5 + 3);
            let j: u32 = 0;
            while j < ni {
                let fe: u32 = rd(a, I_OFF, (io + j) * 8 + 6);
                let ne: u32 = rd(a, I_OFF, (io + j) * 8 + 7);
                let e2: u32 = 0;
                while e2 < ne {
                    let c: u32 = rd(a, E_OFF, fe + e2);
                    if c > 0 {
                        wspan_out(fd, a, no + 1, nl - 1);
                        wlit(fd, "	");
                        wspan_out(fd, a, bo, bl);
                        wlit(fd, "	");
                        write_num(a, fd, j);
                        wlit(fd, "	");
                        write_num(a, fd, e2);
                        wlit(fd, "	");
                        write_num(a, fd, c);
                        wlit(fd, "
");
                    }
                    e2 = e2 + 1;
                }
                j = j + 1;
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
    wlit(fd, "[calls]
");
    fi = 0;
    while fi < ctx_get(a, C_NF) {
        let no: u32 = rd(a, F_OFF, fi * 8);
        let nl: u32 = rd(a, F_OFF, fi * 8 + 1);
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let b: u32 = 0;
        while b < nb {
            let cnt: u32 = rd(a, B_OFF, (fb + b) * 5 + 4);
            if cnt > 0 {
                let bo: u32 = rd(a, B_OFF, (fb + b) * 5);
                let bl: u32 = rd(a, B_OFF, (fb + b) * 5 + 1);
                let io: u32 = rd(a, B_OFF, (fb + b) * 5 + 2);
                let ni: u32 = rd(a, B_OFF, (fb + b) * 5 + 3);
                let j: u32 = 0;
                while j < ni {
                    if rd(a, I_OFF, (io + j) * 8 + 4) == K_CALL {
                        // 一个调用点的次数 = 它所在块的次数（块里每条指令都跟着块走一次）。
                        let cs: u64 = callee_span(a, rd(a, I_OFF, (io + j) * 8 + 2),
                                                  rd(a, I_OFF, (io + j) * 8 + 3));
                        if lo32(cs) > 0 {
                            wspan_out(fd, a, no + 1, nl - 1);
                            wlit(fd, "	");
                            wspan_out(fd, a, bo, bl);
                            wlit(fd, "	");
                            write_num(a, fd, j);
                            wlit(fd, "	");
                            wspan_out(fd, a, hi32(cs), lo32(cs));
                            wlit(fd, "	");
                            write_num(a, fd, cnt);
                            wlit(fd, "
");
                        }
                    }
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
}

// ---------------------------------------------------------------- 前门

fn write_num(a: ptr, fd: u64, v: u32) -> u64 {
    if v >= 10 {
        write_num(a, fd, v / 10);
    }
    let b: ptr = ptr_add(a, CTX_OFF + 240);
    store8(b, 0, (48 + (v % 10)) as u8);
    return write_all(fd, b, 1);
}

// ---------------------------------------------------------------- T2（docs/259 §7，#586）
//
// 镜像的 T0 在**执行期**重解操作数与类型文本：每个 SSA 操作数一次线性 `vfind`、
// 每指令若干次 `ty_span`/`seg_end`/`seg_next`/`ty_size` 扫描。T2 把这一次解码
// **搬到执行之前**：解析完、全局落位之后，把每条指令的操作数/类型/目标块折成
// 一张编译表，执行期只读表。
//
// **不进紧凑形** —— 镜像是直接吃文本 IR 的，表在每次启动时重建；表只由 IR 决定。

//: 编译表（追加在旧 arena 之后）
//: `const` 只吃字面量（本语言没有常量表达式）—— 下面的算式写在注释里。
const T2_OFF: u32 = 9935104;                   // 旧 ARENA 的末尾
const CC_OFF: u32 = 9935104;                   // T2_OFF；每指令 12 个 u32（48 B）
const COP_OFF: u32 = 11507968;                 // CC_OFF + 32768*48；操作数描述符 4 u32
const CX_OFF: u32 = 13605120;                  // COP_OFF + 131072*16；附加池
const CSL_OFF: u32 = 13867264;                 // CX_OFF + 65536*4；槽名表 2 u32
const FS2_OFF: u32 = 14129408;                 // CSL_OFF + 32768*8；每函数 4 u32
const ARENA_T2: u64 = 14982148;                // NAME_SCRATCH + 256（docs/372 的共同快照）

//: 编译记录 12 格
const CR_KIND: u32 = 0;
const CR_SUB: u32 = 1;
const CR_DEST: u32 = 2;                        // 槽号；NONE = 无
const CR_NOPS: u32 = 3;
const CR_OPS: u32 = 4;                         // 操作数池下标
const CR_BITS: u32 = 5;
const CR_SIZE: u32 = 6;
const CR_AUX: u32 = 7;
const CR_AUX2: u32 = 8;
const CR_XB: u32 = 9;                          // 附加池下标
const CR_XN: u32 = 10;
const CR_FLAGS: u32 = 11;                      // 1 = 聚合结果

//: 操作数描述符种类
const CO_SLOT: u32 = 0;                        // a=槽号 b=name_off c=name_len
const CO_IMM: u32 = 1;                         // a=lo b=hi
const CO_ZAGG: u32 = 2;                        // a=size
const CO_GADDR: u32 = 3;                       // a=addr
const K_CERR: u32 = 34;                        // 编译期解不了，执行到才报

//: 格区里 T2 用的几格
const C_TIER: u32 = 128;                       // 1 = T2
const C_CII: u32 = 132;                        // 当前指令下标（编译/执行期）
const C_CFI: u32 = 136;                        // 当前函数下标（编译期）
const C_COMPILE: u32 = 140;                    // 1 = 正在建表
const C_MISS: u32 = 144;                       // 执行期仍发生的文本解码次数
const C_NSLOT: u32 = 148;                      // 槽表已用
const C_NCOP: u32 = 152;                       // 操作数池已用
const C_NCX: u32 = 156;                        // 附加池已用
const C_EXEC: u32 = 160;                       // 1 = 正在执行（计数器只在这段里加）
const C_STATS_FD: u32 = 164;                   // 解码计数写到哪个 fd（0 = 不写）
//: `clock_gettime`（228）的 timespec 暂存（`docs/309`）：宿主写出 16 字节，解释器再
//: 按 guest 的 `struct timespec`（两个 i64）搬进 guest 内存。**一块就够** —— VM 是单线程、
//: 每次调用都当场读完，不跨调用保留。
const C_TSBUF: u32 = 168;

// ---------------------------------------------------------------- T2：编译表
//
// 表都在 arena 里（`T2_OFF` 之后）。建表在 `place_globals` 之后 —— `@global` 的地址
// 那时才有值（同 `docs/259` §4.3）。

fn t2_cr(a: ptr, ii: u32, f: u32) -> u32 {
    return rd(a, CC_OFF, ii * 12 + f);
}

fn t2_crw(a: ptr, ii: u32, f: u32, v: u32) {
    store32(a, CC_OFF + ii * 48 + f * 4, v);
}

fn t2_copr(a: ptr, i: u32, f: u32) -> u32 {
    return rd(a, COP_OFF, i * 4 + f);
}

fn t2_copw(a: ptr, i: u32, f: u32, v: u32) {
    store32(a, COP_OFF + i * 16 + f * 4, v);
}

fn t2_xr(a: ptr, i: u32) -> u32 {
    return rd(a, CX_OFF, i);
}

fn t2_xw(a: ptr, i: u32, v: u32) {
    store32(a, CX_OFF + i * 4, v);
}

fn t2_fs(a: ptr, fi: u32, f: u32) -> u32 {
    return rd(a, FS2_OFF, fi * 4 + f);
}

fn t2_fsw(a: ptr, fi: u32, f: u32, v: u32) {
    store32(a, FS2_OFF + fi * 16 + f * 4, v);
}

fn t2_slotr(a: ptr, i: u32, f: u32) -> u32 {
    return rd(a, CSL_OFF, i * 2 + f);
}

fn t2_slotw(a: ptr, i: u32, f: u32, v: u32) {
    store32(a, CSL_OFF + i * 8 + f * 4, v);
}

/// 一个函数里按名字找槽；没有就加。**名字是 SSA 名（不带 `%`）**。
fn t2_slot_add(a: ptr, fi: u32, no: u32, nl: u32) -> u32 {
    let s0: u32 = t2_fs(a, fi, 0);
    let n: u32 = t2_fs(a, fi, 1);
    let i: u32 = 0;
    while i < n {
        let idx: u32 = s0 + i;
        let o: u32 = t2_slotr(a, idx, 0);
        let l: u32 = t2_slotr(a, idx, 1);
        if l == nl {
            if same(a, no, a, o, nl) {
                return idx - s0;
            }
        }
        i = i + 1;
    }
    let idx: u32 = ctx_get(a, C_NSLOT);
    if idx >= 32768 {
        fail("T2 槽表满了");
    }
    t2_slotw(a, idx, 0, no);
    t2_slotw(a, idx, 1, nl);
    ctx_set(a, C_NSLOT, idx + 1);
    t2_fsw(a, fi, 1, n + 1);
    return idx - s0;
}

fn t2_slot_find(a: ptr, fi: u32, no: u32, nl: u32) -> u32 {
    let s0: u32 = t2_fs(a, fi, 0);
    let n: u32 = t2_fs(a, fi, 1);
    let i: u32 = 0;
    while i < n {
        let idx: u32 = s0 + i;
        if t2_slotr(a, idx, 1) == nl {
            if same(a, no, a, t2_slotr(a, idx, 0), nl) {
                return idx - s0;
            }
        }
        i = i + 1;
    }
    return NONE;
}

fn t2_cop_add(a: ptr, kind: u32, x: u32, y: u32, z: u32) -> u32 {
    let i: u32 = ctx_get(a, C_NCOP);
    if i >= 131072 {
        fail("T2 操作数池满了");
    }
    t2_copw(a, i, 0, kind);
    t2_copw(a, i, 1, x);
    t2_copw(a, i, 2, y);
    t2_copw(a, i, 3, z);
    ctx_set(a, C_NCOP, i + 1);
    return i;
}

fn t2_x_add(a: ptr, v: u32) -> u32 {
    let i: u32 = ctx_get(a, C_NCX);
    if i >= 65536 {
        fail("T2 附加池满了");
    }
    t2_xw(a, i, v);
    ctx_set(a, C_NCX, i + 1);
    return i;
}

/// 一条 **`<类型> <值>`** 操作数 -> 描述符下标。**编译期做，执行期只读表。**
fn t2_coperand(a: ptr, fi: u32, tyo: u32, tyl: u32, vo: u32, vl: u32) -> u32 {
    if vl == 0 {
        return t2_cop_add(a, CO_IMM, 0, 0, 0);
    }
    let c: u32 = load8(a, vo);
    if c == 37 {                                          // %name
        let s: u32 = t2_slot_add(a, fi, vo, vl);
        return t2_cop_add(a, CO_SLOT, s, vo, vl);
    }
    if c == 64 {                                          // @global
        return t2_cop_add(a, CO_GADDR, gaddr(a, vo, vl), 0, 0);
    }
    if c == 117 || c == 110 {                             // undef / null
        if is_agg(a, tyo, tyl) {
            return t2_cop_add(a, CO_ZAGG, ty_size(a, tyo, tyl), 0, 0);
        }
        return t2_cop_add(a, CO_IMM, 0, 0, 0);
    }
    if c == 116 {                                         // true
        return t2_cop_add(a, CO_IMM, 1, 0, 0);
    }
    if c == 102 {                                         // false
        return t2_cop_add(a, CO_IMM, 0, 0, 0);
    }
    let v: u64 = dec_u64(a, vo, vo + vl);
    return t2_cop_add(a, CO_IMM, lo32(v), hi32(v), 0);
}

fn t2_coperand_text(a: ptr, fi: u32, off: u32, n: u32) -> u32 {
    let ts: u64 = ty_span(a, off, n);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), n);
    let vs: u64 = trim_span(a, vo, seg_end(a, vo, n));
    return t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
}

/// 目标值（`do_/dl`）-> 槽号；没有目标返回 NONE。
fn t2_dest(a: ptr, fi: u32, do_: u32, dl: u32) -> u32 {
    if dl == 0 {
        return NONE;
    }
    return t2_slot_add(a, fi, do_, dl);
}

/// 把一条指令折成编译记录。解不出来的指令记成 K_CERR，执行到才报 ——
/// 与 T0 的接受集合保持一致（不可达的坏指令不是错，`docs/259` §4.4）。
fn t2_compile_instr(a: ptr, fi: u32, ii: u32) -> u32 {
    let io: u32 = rd(a, I_OFF, ii * 8 + 2);
    let il: u32 = rd(a, I_OFF, ii * 8 + 3);
    let k: u32 = rd(a, I_OFF, ii * 8 + 4);
    let sub: u32 = rd(a, I_OFF, ii * 8 + 5);
    let do_: u32 = rd(a, I_OFF, ii * 8);
    let dl: u32 = rd(a, I_OFF, ii * 8 + 1);
    let e: u32 = io + il;
    t2_crw(a, ii, CR_KIND, k);
    t2_crw(a, ii, CR_SUB, sub);
    t2_crw(a, ii, CR_DEST, t2_dest(a, fi, do_, dl));
    t2_crw(a, ii, CR_NOPS, 0);
    t2_crw(a, ii, CR_OPS, 0);
    t2_crw(a, ii, CR_BITS, 0);
    t2_crw(a, ii, CR_SIZE, 0);
    t2_crw(a, ii, CR_AUX, 0);
    t2_crw(a, ii, CR_AUX2, 0);
    t2_crw(a, ii, CR_XB, 0);
    t2_crw(a, ii, CR_XN, 0);
    t2_crw(a, ii, CR_FLAGS, 0);

    if k == K_ALLOCA {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        return 0;
    }
    if k == K_LOAD {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        t2_crw(a, ii, CR_OPS, t2_coperand_text(a, fi, p, e));
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        if is_agg(a, hi32(ts), lo32(ts)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    if k == K_STORE {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let vs: u64 = trim_span(a, p, q);
        let vop: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let aop: u32 = t2_coperand_text(a, fi, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, vop);
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_AUX, aop);                       // 第二个操作数（地址）
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        if is_agg(a, hi32(ts), lo32(ts)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    if k == K_GEP {
        t2_compile_gep(a, fi, ii, io, il);
        return 0;
    }
    if k == K_EXTRV {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let vs: u64 = trim_span(a, p, q);
        let op: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let p2: u32 = seg_next(a, q, e);
        let idx: u32 = dec_u64(a, p2, seg_end(a, p2, e)) as u32;
        let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
        t2_crw(a, ii, CR_OPS, op);
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_AUX, fld_off(a, hi32(ts), lo32(ts), idx));
        t2_crw(a, ii, CR_AUX2, ty_size(a, hi32(f), lo32(f)));
        if is_agg(a, hi32(f), lo32(f)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    if k == K_INSV {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let bs: u64 = trim_span(a, p, q);
        let bop: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(bs), lo32(bs));
        let p2: u32 = seg_next(a, q, e);
        let q2: u32 = seg_end(a, p2, e);
        let vop: u32 = t2_coperand_text(a, fi, p2, q2);
        let p3: u32 = seg_next(a, q2, e);
        let idx: u32 = dec_u64(a, p3, seg_end(a, p3, e)) as u32;
        let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
        t2_crw(a, ii, CR_OPS, bop);
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_SIZE, sz);
        t2_crw(a, ii, CR_AUX, fld_off(a, hi32(ts), lo32(ts), idx));
        t2_crw(a, ii, CR_AUX2, ty_size(a, hi32(f), lo32(f)));
        if is_agg(a, hi32(f), lo32(f)) {
            t2_crw(a, ii, CR_FLAGS, 2);
        }
        return 0;
    }
    if k == K_ICMP {
        let w: u64 = wspan(a, io, e);
        let pd: u64 = wspan(a, hi32(w) + lo32(w), e);
        let ts: u64 = ty_span(a, hi32(pd) + lo32(pd), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let a1: u64 = trim_span(a, p, q);
        let a2: u64 = trim_span(a, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a1), lo32(a1)));
        t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a2), lo32(a2));
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(ts), lo32(ts)) * 8);
        return 0;
    }
    if k == K_SDIV || k == K_UDIV || k == K_SREM || k == K_UREM {
        let w: u64 = wspan(a, io, e);
        let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let a1: u64 = trim_span(a, p, q);
        let a2: u64 = trim_span(a, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a1), lo32(a1)));
        t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a2), lo32(a2));
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(ts), lo32(ts)) * 8);
        return 0;
    }
    if k >= K_ADD && k <= K_ASHR {
        let w: u64 = wspan(a, io, e);
        let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let a1: u64 = trim_span(a, p, q);
        let a2: u64 = trim_span(a, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a1), lo32(a1)));
        t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a2), lo32(a2));
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(ts), lo32(ts)) * 8);
        return 0;
    }
    if k >= K_TRUNC && k <= K_INTTOPTR {
        let w: u64 = wspan(a, io, e);
        let fts: u64 = ty_span(a, hi32(w) + lo32(w), e);
        let p: u32 = skip_sp(a, hi32(fts) + lo32(fts), e);
        let vs: u64 = trim_span(a, p, word_end(a, p, e));
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(fts), lo32(fts),
                                          hi32(vs), lo32(vs)));
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(fts), lo32(fts)) * 8);
        if k == K_TRUNC || k == K_SEXT {
            let tw: u64 = wspan(a, index_of(a, hi32(vs) + lo32(vs), e, 116) + 2, e);
            t2_crw(a, ii, CR_AUX, ty_size(a, hi32(tw), lo32(tw)) * 8);
        }
        return 0;
    }
    if k == K_CALL {
        t2_compile_call(a, fi, ii, io, il);
        return 0;
    }
    if k == K_ASMCALL {
        t2_compile_asm(a, fi, ii, io, il);
        return 0;
    }
    if k == K_PHI {
        t2_compile_phi(a, fi, ii, io, il);
        return 0;
    }
    if k == K_BR_COND || k == K_SWITCH || k == K_RET {
        t2_compile_ctrl(a, ii, io, il);
        return 0;
    }
    if k == K_BR_UNCOND || k == K_UNREACH {
        return 0;
    }
    return 0;
}

fn t2_compile_gep(a: ptr, fi: u32, ii: u32, io: u32, il: u32) -> u32 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    if has_at(a, p, e, "inbounds") {
        p = skip_sp(a, p + 8, e);
    }
    let ts: u64 = ty_span(a, p, e);
    let cur_o: u32 = hi32(ts);
    let cur_l: u32 = lo32(ts);
    let op: u32 = seg_next(a, cur_o + cur_l, e);
    let base: u32 = t2_coperand_text(a, fi, op, seg_end(a, op, e));
    t2_crw(a, ii, CR_OPS, base);
    let n: u32 = 1;
    let xb: u32 = ctx_get(a, C_NCX);
    let q: u32 = seg_next(a, seg_end(a, op, e), e);
    let k: u32 = 0;
    while q < e {
        let qe: u32 = seg_end(a, q, e);
        let iop: u32 = t2_coperand_text(a, fi, q, qe);
        if k == 0 {
            t2_x_add(a, 1);
            t2_x_add(a, ty_size(a, cur_o, cur_l));
        } else if load8(a, cur_o) == 91 {
            let et: u64 = arr_elem(a, cur_o, cur_l);
            cur_o = hi32(et);
            cur_l = lo32(et);
            t2_x_add(a, 1);
            t2_x_add(a, ty_size(a, cur_o, cur_l));
        } else if load8(a, cur_o) == 123 {
            let idx: u64 = t2_imm(a, iop);
            if t2_copr(a, iop, 0) != CO_IMM {
                t2_cerr(a, ii, 4, io, il);
                return 0;
            }
            t2_x_add(a, 0);
            t2_x_add(a, fld_off(a, cur_o, cur_l, idx as u32));
            let f: u64 = fld_ty(a, cur_o, cur_l, idx as u32);
            cur_o = hi32(f);
            cur_l = lo32(f);
        } else {
            t2_cerr(a, ii, 4, io, il);
            return 0;
        }
        k = k + 1;
        q = seg_next(a, qe, e);
    }
    t2_crw(a, ii, CR_NOPS, n + k);
    t2_crw(a, ii, CR_XB, xb);
    t2_crw(a, ii, CR_XN, k * 2);
    return 0;
}

fn t2_cerr(a: ptr, ii: u32, code: u32, io: u32, il: u32) {
    t2_crw(a, ii, CR_KIND, 34);                            // K_CERR
    t2_crw(a, ii, CR_AUX, code);
    t2_crw(a, ii, CR_AUX2, io);
    t2_crw(a, ii, CR_SUB, il);
    t2_crw(a, ii, CR_DEST, NONE);
    t2_crw(a, ii, CR_NOPS, 0);
}

fn t2_compile_call(a: ptr, fi: u32, ii: u32, io: u32, il: u32) -> u32 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    let p2: u32 = 0;
    if has_at(a, p, e, "void") {
        p2 = skip_sp(a, p + 4, e);
    } else {
        let ts: u64 = ty_span(a, p, e);
        p2 = skip_sp(a, hi32(ts) + lo32(ts), e);
    }
    let nt: u64 = wspan(a, p2, e);
    let lp: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    if lp >= e || load8(a, lp) != 40 {
        t2_cerr(a, ii, 3, io, il);
        return 0;
    }
    let rp: u32 = match_close(a, lp, e, 40, 41);
    let callee: u32 = fn_find(a, hi32(nt), lo32(nt));
    if callee == NONE {
        t2_cerr(a, ii, 2, io, il);
        return 0;
    }
    let npar: u32 = rd(a, F_OFF, callee * 8 + 4);
    let first_op: u32 = ctx_get(a, C_NCOP);
    let ap: u32 = skip_sp(a, lp + 1, rp);
    let n: u32 = 0;
    while ap < rp {
        let ae: u32 = seg_end(a, ap, rp);
        t2_coperand_text(a, fi, ap, ae);
        ap = seg_next(a, ae, rp);
        n = n + 1;
    }
    if n != npar {
        t2_cerr(a, ii, 1, io, il);
        return 0;
    }
    t2_crw(a, ii, CR_OPS, first_op);
    t2_crw(a, ii, CR_NOPS, n);
    t2_crw(a, ii, CR_AUX, npar);
    t2_crw(a, ii, CR_AUX2, callee);
    return 0;
}

fn t2_compile_asm(a: ptr, fi: u32, ii: u32, io: u32, il: u32) -> u32 {
    let e: u32 = io + il;
    let lp: u32 = last_byte(a, io, e, 40);
    let rp: u32 = last_byte(a, io, e, 41);
    if lp == NONE || rp == NONE {
        t2_cerr(a, ii, 7, io, il);
        return 0;
    }
    let p: u32 = skip_sp(a, lp + 1, rp);
    if p >= rp {
        t2_cerr(a, ii, 8, io, il);
        return 0;
    }
    let first_op: u32 = ctx_get(a, C_NCOP);
    let q: u32 = seg_end(a, p, rp);
    t2_coperand_text(a, fi, p, q);
    let n: u32 = 1;
    let c1: u32 = seg_next(a, q, rp);
    if c1 < rp {
        let d1: u32 = seg_end(a, c1, rp);
        t2_coperand_text(a, fi, c1, d1);
        n = n + 1;
        let c2: u32 = seg_next(a, d1, rp);
        if c2 < rp {
            let d2: u32 = seg_end(a, c2, rp);
            t2_coperand_text(a, fi, c2, d2);
            n = n + 1;
            let c3: u32 = seg_next(a, d2, rp);
            if c3 < rp {
                let d3: u32 = seg_end(a, c3, rp);
                t2_coperand_text(a, fi, c3, d3);
                n = n + 1;
            }
        }
    }
    t2_crw(a, ii, CR_OPS, first_op);
    t2_crw(a, ii, CR_NOPS, n);
    return 0;
}

fn t2_compile_phi(a: ptr, fi: u32, ii: u32, io: u32, il: u32) {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
    let xb: u32 = ctx_get(a, C_NCX);
    let n: u32 = 0;
    while p < e {
        let pe: u32 = match_close(a, p, e, 91, 93);
        let co: u32 = last_byte(a, p + 1, pe, 44);
        let lab: u64 = trim_span(a, co + 1, pe);
        let vs: u64 = trim_span(a, p + 1, co);
        let op: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let bi: u32 = blk_of(a, fi, hi32(lab) + 1, lo32(lab) - 1);
        t2_x_add(a, bi);
        t2_x_add(a, op);
        n = n + 1;
        p = seg_next(a, pe + 1, e);
    }
    t2_crw(a, ii, CR_XB, xb);
    t2_crw(a, ii, CR_XN, n * 2);
}

fn t2_compile_ctrl(a: ptr, ii: u32, io: u32, il: u32) -> u32 {
    let k: u32 = rd(a, I_OFF, ii * 8 + 4);
    let e: u32 = io + il;
    if k == K_BR_COND {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let vs: u64 = trim_span(a, p, seg_end(a, p, e));
        // 条件操作数单独存一个池下标：`sub` 里已经有两个块号，放不下。
        t2_crw(a, ii, CR_OPS, t2_coperand(a, ctx_get(a, C_CFI), hi32(ts), lo32(ts),
                                          hi32(vs), lo32(vs)));
        t2_crw(a, ii, CR_NOPS, 1);
        return 0;
    }
    if k == K_RET {
        let p: u32 = after_op(a, io, e);
        if p >= e || has_at(a, p, e, "void") {
            return 0;
        }
        let ts: u64 = ty_span(a, p, e);
        let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
        let vs: u64 = trim_span(a, vo, e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, ctx_get(a, C_CFI), hi32(ts), lo32(ts),
                                          hi32(vs), lo32(vs)));
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        if is_agg(a, hi32(ts), lo32(ts)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    // switch
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let vs: u64 = trim_span(a, p, q);
    t2_crw(a, ii, CR_AUX, t2_coperand(a, ctx_get(a, C_CFI), hi32(ts), lo32(ts),
                                      hi32(vs), lo32(vs)));
    let bo: u32 = index_of(a, q, e, 91);
    let be: u32 = match_close(a, bo, e, 91, 93);
    let dw: u64 = wspan(a, lab_after(a, q + 1, bo), bo);
    let dflt: u32 = blk_of(a, ctx_get(a, C_CFI), hi32(dw), lo32(dw));
    let xb: u32 = ctx_get(a, C_NCX);
    let cp: u32 = skip_sp(a, bo + 1, be);
    let n: u32 = 0;
    while cp < be {
        let cty: u64 = ty_span(a, cp, be);
        let cvs: u64 = trim_span(a, hi32(cty) + lo32(cty),
                                 seg_end(a, hi32(cty) + lo32(cty), be));
        let ce: u32 = seg_end(a, cp, be);
        let lp: u32 = lab_after(a, ce + 1, be);
        let lw: u64 = wspan(a, lp, be);
        let cv: u64 = dec_u64(a, hi32(cvs), hi32(cvs) + lo32(cvs));
        t2_x_add(a, lo32(cv));
        t2_x_add(a, hi32(cv));
        t2_x_add(a, blk_of(a, ctx_get(a, C_CFI), hi32(lw), lo32(lw)));
        t2_x_add(a, ty_size(a, hi32(cty), lo32(cty)) * 8);
        n = n + 1;
        cp = seg_next(a, lp + lo32(lw), be);
    }
    t2_crw(a, ii, CR_XB, xb);
    t2_crw(a, ii, CR_XN, n * 4);
    t2_crw(a, ii, CR_AUX2, dflt);
    return 0;
}

/// 整份程序建表。**必须在 `place_globals` 之后**（`@global` 的地址那时才有）。
fn t2_compile_all(a: ptr) {
    ctx_set(a, C_COMPILE, 1);
    ctx_set(a, C_NSLOT, 0);
    ctx_set(a, C_NCOP, 0);
    ctx_set(a, C_NCX, 0);
    let nf: u32 = ctx_get(a, C_NF);
    let fi: u32 = 0;
    while fi < nf {
        t2_fsw(a, fi, 0, ctx_get(a, C_NSLOT));
        t2_fsw(a, fi, 1, 0);
        ctx_set(a, C_CFI, fi);
        let np: u32 = rd(a, F_OFF, fi * 8 + 4);
        let fpar: u32 = rd(a, F_OFF, fi * 8 + 5);
        let k: u32 = 0;
        while k < np {
            let pnm: u64 = pspan(a, fpar + k, 2);
            t2_slot_add(a, fi, hi32(pnm), lo32(pnm));
            k = k + 1;
        }
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let bi: u32 = 0;
        while bi < nb {
            let ii0: u32 = rd(a, B_OFF, (fb + bi) * 5 + 2);
            let ni: u32 = rd(a, B_OFF, (fb + bi) * 5 + 3);
            let j: u32 = 0;
            while j < ni {
                ctx_set(a, C_CII, ii0 + j);
                t2_compile_instr(a, fi, ii0 + j);
                j = j + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    ctx_set(a, C_COMPILE, 0);
}

// ---------------------------------------------------------------- T2：执行
//
// 读编译表，**不再读任何操作数/类型文本**。语义与 `exec_body` 逐条对齐；错的时机
// 与错的句子也一样（不可达代码里的坏指令只在执行到时报）。

fn t2_initd(m: ptr, fr: u32, slot: u32) -> bool {
    let b: u32 = load8(m, fr + FR_INIT + slot / 8);
    return (b & ((1 as u32) << (slot % 8))) != 0;
}

fn t2_mark(m: ptr, fr: u32, slot: u32) {
    let p: u32 = fr + FR_INIT + slot / 8;
    let b: u32 = load8(m, p);
    store8(m, p, (b | ((1 as u32) << (slot % 8))) as u8);
}

fn t2_frame_init(a: ptr, m: ptr, fr: u32, fi: u32) {
    let s0: u32 = t2_fs(a, fi, 0);
    let n: u32 = t2_fs(a, fi, 1);
    wr(m, fr, 0, n);
    wr(m, fr, 1, FR_SLOTS);
    mz(m, fr + FR_INIT, 128);
    let i: u32 = 0;
    while i < n {
        let idx: u32 = s0 + i;
        store32(m, fr + FR_VALS + i * VAL_REC, t2_slotr(a, idx, 0));
        store32(m, fr + FR_VALS + i * VAL_REC + 4, t2_slotr(a, idx, 1));
        store32(m, fr + FR_VALS + i * VAL_REC + 8, 0);
        store32(m, fr + FR_VALS + i * VAL_REC + 12, 0);
        i = i + 1;
    }
}

fn t2_setd(a: ptr, m: ptr, fr: u32, slot: u32, v: u64) {
    if slot != NONE {
        vset(a, m, fr, slot, v);
        t2_mark(m, fr, slot);
    }
}

fn t2_imm(a: ptr, i: u32) -> u64 {
    return (t2_copr(a, i, 1) as u64) | ((t2_copr(a, i, 2) as u64) << 32);
}

fn t2_getop(a: ptr, m: ptr, fr: u32, i: u32) -> u64 {
    let kind: u32 = t2_copr(a, i, 0);
    if kind == CO_SLOT {
        let s: u32 = t2_copr(a, i, 1);
        if t2_initd(m, fr, s) == false {
            return fail_tok(a, "读未定义的值", t2_copr(a, i, 2), t2_copr(a, i, 3)) as u64;
        }
        return vget(m, fr, s);
    }
    if kind == CO_IMM {
        return (t2_copr(a, i, 1) as u64) | ((t2_copr(a, i, 2) as u64) << 32);
    }
    if kind == CO_ZAGG {
        return ZERO_ADDR as u64;
    }
    return t2_copr(a, i, 1) as u64;                        // CO_GADDR
}

/// 一个聚合值在**当前帧**里的暂存格（按槽缓存）。与 `fr_agg` 同一套理由：
/// 同名多次执行复用同一格，不是每轮吃一格。
fn t2_fr_agg(a: ptr, m: ptr, fr: u32, slot: u32, size: u32) -> u32 {
    if slot != NONE && t2_initd(m, fr, slot) {
        let v: u64 = vget(m, fr, slot);
        if hi32(v) >= size {
            return lo32(v);
        }
    }
    let d: u32 = fr_alloc(a, m, fr, size, 8);
    t2_setd(a, m, fr, slot, (d as u64) | (((size as u64)) << 32));
    return d;
}

fn t2_arith(k: u32, a1: u64, a2: u64, bits: u32) -> u64 {
    if k == K_SHL || k == K_LSHR || k == K_ASHR {
        if (a2 & ((1 as u64) << ((bits - 1) as u64))) != 0 {
            return fail("移位量是负数") as u64;
        }
    }
    if k == K_ASHR {
        return mask_bits(ashr64(a1, a2, bits), bits);
    }
    if (k == K_SHL || k == K_LSHR) && a2 >= 64 {
        return 0;
    }
    let v: u64 = 0;
    if k == K_ADD {
        v = a1 + a2;
    } else if k == K_SUB {
        v = a1 - a2;
    } else if k == K_MUL {
        v = a1 * a2;
    } else if k == K_AND {
        v = a1 & a2;
    } else if k == K_OR {
        v = a1 | a2;
    } else if k == K_XOR {
        v = a1 ^ a2;
    } else if k == K_SHL {
        v = a1 << a2;
    } else {
        v = a1 >> a2;
    }
    return mask_bits(v, bits);
}

fn t2_div(a: ptr, k: u32, a1: u64, a2: u64, bits: u32) -> u64 {
    let sgn: u32 = 0;
    if k == K_SDIV || k == K_SREM {
        sgn = 1;
    }
    let na: u64 = a1;
    let nb: u64 = a2;
    let nga: u32 = 0;
    let ngb: u32 = 0;
    if sgn == 1 {
        if (a1 as i64) < 0 {
            na = (0 as u64) - a1;
            nga = 1;
        }
        if (a2 as i64) < 0 {
            nb = (0 as u64) - a2;
            ngb = 1;
        }
    }
    if nb == 0 {
        fail("除以零");
    }
    let qv: u64 = na / nb;
    if sgn == 1 && nga != ngb {
        return mask_bits_for(k, a1, a2, (0 as u64) - qv, bits);
    }
    return mask_bits_for(k, a1, a2, qv, bits);
}

fn t2_icmp(sub: u32, a1: u64, a2: u64, bits: u32) -> u64 {
    let sm: u64 = (1 as u64) << ((bits - 1) as u64);
    let x: u64 = a1 ^ sm;
    let y: u64 = a2 ^ sm;
    let r: u32 = 0;
    if sub == P_EQ {
        if a1 == a2 {
            r = 1;
        }
    } else if sub == P_NE {
        if a1 != a2 {
            r = 1;
        }
    } else if sub == P_UGT {
        if a1 > a2 {
            r = 1;
        }
    } else if sub == P_UGE {
        if a1 >= a2 {
            r = 1;
        }
    } else if sub == P_ULT {
        if a1 < a2 {
            r = 1;
        }
    } else if sub == P_ULE {
        if a1 <= a2 {
            r = 1;
        }
    } else if sub == P_SGT {
        if x > y {
            r = 1;
        }
    } else if sub == P_SGE {
        if x >= y {
            r = 1;
        }
    } else if sub == P_SLT {
        if x < y {
            r = 1;
        }
    } else if sub == P_SLE {
        if x <= y {
            r = 1;
        }
    }
    return r as u64;
}

fn t2_cast(k: u32, a1: u64, fbits: u32, tbits: u32) -> u64 {
    if k == K_PTRTOINT || k == K_INTTOPTR {
        return a1;
    }
    if k == K_TRUNC {
        return mask_bits(a1, tbits);
    }
    if k == K_ZEXT {
        return mask_bits(a1, fbits);
    }
    let sv: u64 = a1;
    if fbits < 64 {
        let hi: u64 = sv & (((1 as u64) << ((fbits - 1) as u64)));
        if hi != 0 {
            sv = sv | (((0 as u64) - 1) - ((((1 as u64) << (fbits as u64))) - 1));
        }
    }
    return mask_bits(sv, tbits);
}

fn t2_cerr_msg(a: ptr, code: u32, io: u32, il: u32) -> u64 {
    if code == 1 {
        fail("实参个数与形参不符");
    }
    if code == 2 {
        fail("没有这个函数（extern 不接 FFI —— docs/243 §5）");
    }
    if code == 3 {
        fail("只认直接调用（间接调用 T0 不支持）");
    }
    if code == 4 {
        return fail_tok(a, "GEP 的这一步 T0 没实现:", io, il) as u64;
    }
    if code == 7 {
        fail("内联汇编解析不了");
    }
    if code == 8 {
        fail("系统调用没有号");
    }
    return fail_tok(a, "这个指令 T0 没实现:", io, il) as u64;
}

fn t2_insv(a: ptr, m: ptr, fr: u32, ii: u32, dest: u32, ops: u32) -> u64 {
    let base: u64 = t2_getop(a, m, fr, ops);
    let val: u64 = t2_getop(a, m, fr, ops + 1);
    let sz: u32 = t2_cr(a, ii, CR_SIZE);
    let fo: u32 = t2_cr(a, ii, CR_AUX);
    let fsz: u32 = t2_cr(a, ii, CR_AUX2);
    let d: u32 = t2_fr_agg(a, m, fr, dest, sz);
    mc(m, d, base as u32, sz);
    if (t2_cr(a, ii, CR_FLAGS) & 2) != 0 {
        mc(m, d + fo, val as u32, fsz);
    } else {
        mw(m, d + fo, fsz, val);
    }
    return (d as u64) | (((sz as u64)) << 32);
}

fn t2_eval(a: ptr, m: ptr, fr: u32, cfr: u32, ii: u32) -> u64 {
    let k: u32 = t2_cr(a, ii, CR_KIND);
    let ops: u32 = t2_cr(a, ii, CR_OPS);
    let dest: u32 = t2_cr(a, ii, CR_DEST);
    if k == K_CERR {
        return t2_cerr_msg(a, t2_cr(a, ii, CR_AUX), t2_cr(a, ii, CR_AUX2),
                           t2_cr(a, ii, CR_SUB));
    }
    if k == K_ALLOCA {
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        if sz < 8 {
            return fr_alloc(a, m, fr, 8, 8) as u64;
        }
        return fr_alloc(a, m, fr, sz, 8) as u64;
    }
    if k == K_LOAD {
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        let addr: u64 = t2_getop(a, m, fr, ops);
        if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
            let d: u32 = t2_fr_agg(a, m, fr, dest, sz);
            mc(m, d, addr as u32, sz);
            return (d as u64) | (((sz as u64)) << 32);
        }
        return mr(m, addr as u32, sz);
    }
    if k == K_STORE {
        let v: u64 = t2_getop(a, m, fr, ops);
        let addr: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_AUX));
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
            mc(m, addr as u32, v as u32, sz);
        } else {
            mw(m, addr as u32, sz, v);
        }
        return 0;
    }
    if k == K_GEP {
        let base: u64 = t2_getop(a, m, fr, ops);
        let xb: u32 = t2_cr(a, ii, CR_XB);
        let xn: u32 = t2_cr(a, ii, CR_XN);
        let acc: u32 = 0;
        let s: u32 = 0;
        while s < xn {
            let kind: u32 = t2_xr(a, xb + s);
            let val: u32 = t2_xr(a, xb + s + 1);
            if kind == 1 {
                let idx: u64 = t2_getop(a, m, fr, ops + 1 + s / 2);
                acc = acc + (idx as u32) * val;
            } else {
                acc = acc + val;
            }
            s = s + 2;
        }
        return base + (acc as u64);
    }
    if k == K_EXTRV {
        let agg: u64 = t2_getop(a, m, fr, ops);
        let fo: u32 = t2_cr(a, ii, CR_AUX);
        let fsz: u32 = t2_cr(a, ii, CR_AUX2);
        if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
            let d: u32 = t2_fr_agg(a, m, fr, dest, fsz);
            mc(m, d, (agg as u32) + fo, fsz);
            return (d as u64) | (((fsz as u64)) << 32);
        }
        return mr(m, (agg as u32) + fo, fsz);
    }
    if k == K_INSV {
        return t2_insv(a, m, fr, ii, dest, ops);
    }
    if k == K_ICMP {
        let a1: u64 = t2_getop(a, m, fr, ops);
        let a2: u64 = t2_getop(a, m, fr, ops + 1);
        return t2_icmp(t2_cr(a, ii, CR_SUB), a1, a2, t2_cr(a, ii, CR_BITS));
    }
    if k == K_SDIV || k == K_UDIV || k == K_SREM || k == K_UREM {
        let a1: u64 = t2_getop(a, m, fr, ops);
        let a2: u64 = t2_getop(a, m, fr, ops + 1);
        return t2_div(a, k, a1, a2, t2_cr(a, ii, CR_BITS));
    }
    if k >= K_ADD && k <= K_ASHR {
        let a1: u64 = t2_getop(a, m, fr, ops);
        let a2: u64 = t2_getop(a, m, fr, ops + 1);
        return t2_arith(k, a1, a2, t2_cr(a, ii, CR_BITS));
    }
    if k >= K_TRUNC && k <= K_INTTOPTR {
        let a1: u64 = t2_getop(a, m, fr, ops);
        return t2_cast(k, a1, t2_cr(a, ii, CR_BITS), t2_cr(a, ii, CR_AUX));
    }
    if k == K_CALL {
        return t2_call(a, m, fr, ii);
    }
    if k == K_ASMCALL {
        let n: u32 = t2_cr(a, ii, CR_NOPS);
        let nr: u64 = t2_getop(a, m, fr, ops);
        let x1: u64 = 0;
        let x2: u64 = 0;
        let x3: u64 = 0;
        if n > 1 {
            x1 = t2_getop(a, m, fr, ops + 1);
        }
        if n > 2 {
            x2 = t2_getop(a, m, fr, ops + 2);
        }
        if n > 3 {
            x3 = t2_getop(a, m, fr, ops + 3);
        }
        return vm_syscall(a, m, nr, x1, x2, x3);
    }
    if k == K_UNREACH {
        fail("执行到 unreachable");
    }
    return fail_tok(a, "这个指令 T0 没实现:", rd(a, I_OFF, ii * 8 + 2),
                    rd(a, I_OFF, ii * 8 + 3)) as u64;
}

fn t2_call(a: ptr, m: ptr, fr: u32, ii: u32) -> u64 {
    let callee: u32 = t2_cr(a, ii, CR_AUX2);
    let npar: u32 = t2_cr(a, ii, CR_AUX);
    let ops: u32 = t2_cr(a, ii, CR_OPS);
    let d: u32 = ctx_get(a, C_DEPTH) + 1;
    if d > MAX_DEPTH {
        fail("调用太深");
    }
    ctx_set(a, C_DEPTH, d);
    let nfr: u32 = MEM_SIZE - d * FRAME_SIZE;
    t2_frame_init(a, m, nfr, callee);
    let k: u32 = 0;
    while k < npar {
        let v: u64 = t2_getop(a, m, fr, ops + k);
        if k < t2_fs(a, callee, 1) {
            vset(a, m, nfr, k, v);
            t2_mark(m, nfr, k);
        }
        k = k + 1;
    }
    let r: u64 = t2_exec(a, m, callee, nfr, fr, t2_cr(a, ii, CR_DEST),
                         ctx_get(a, C_CII));
    ctx_set(a, C_DEPTH, d - 1);
    return r;
}

fn t2_ret(a: ptr, m: ptr, fr: u32, cfr: u32, ii: u32, ro: u32, rl: u32) -> u64 {
    let n: u32 = t2_cr(a, ii, CR_NOPS);
    if n == 0 {
        return 0;
    }
    let v: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_OPS));
    if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
        if cfr == NONE {
            fail("没有调用者的聚合返回值");
        }
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        let d: u32 = t2_fr_agg(a, m, cfr, ro, sz);
        mc(m, d, v as u32, sz);
        return (d as u64) | (((sz as u64)) << 32);
    }
    return v;
}

fn t2_exec(a: ptr, m: ptr, fi: u32, fr: u32, cfr: u32, ro: u32, rl: u32) -> u64 {
    let bi: u32 = rd(a, F_OFF, fi * 8 + 6);
    let prev: u32 = NONE;
    let go: u32 = 1;
    while go == 1 {
        let here: u32 = bi;
        bump_block(a, bi);
        let io: u32 = rd(a, B_OFF, bi * 5 + 2);
        let ni: u32 = rd(a, B_OFF, bi * 5 + 3);
        let j: u32 = 0;
        let jumped: u32 = 0;
        while j < ni && jumped == 0 {
            let ii: u32 = io + j;
            ctx_set(a, C_CII, ii);
            let ns: u32 = ctx_get(a, C_STEPS) + 1;
            if ns > STEP_CAP {
                wstr(2, "lvm: 执行超过 "); write_num(a, 2, STEP_CAP);
                wstr(2, " 条指令，卡在 ");
                let fno: u32 = rd(a, F_OFF, fi * 8);
                write_all(2, ptr_add(a, fno), rd(a, F_OFF, fi * 8 + 1) as u64);
                wstr(2, " 的 [");
                let to: u32 = rd(a, I_OFF, ii * 8 + 2);
                write_all(2, ptr_add(a, to), rd(a, I_OFF, ii * 8 + 3) as u64);
                wstr(2, "]\n");
                return die(2) as u64;
            }
            ctx_set(a, C_STEPS, ns);
            let k: u32 = t2_cr(a, ii, CR_KIND);
            if k == K_BR_UNCOND {
                bump_edge(a, ii, 0);
                prev = here;
                bi = t2_cr(a, ii, CR_SUB);
                jumped = 1;
            } else if k == K_BR_COND {
                let c: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_OPS));
                let sub: u32 = t2_cr(a, ii, CR_SUB);
                prev = here;
                if c != 0 {
                    bump_edge(a, ii, 0);
                    bi = sub >> 16;
                } else {
                    bump_edge(a, ii, 1);
                    bi = sub & 65535;
                }
                jumped = 1;
            } else if k == K_SWITCH {
                let v: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_AUX));
                let xb: u32 = t2_cr(a, ii, CR_XB);
                let xn: u32 = t2_cr(a, ii, CR_XN);
                let tgt: u32 = t2_cr(a, ii, CR_AUX2);
                let e: u32 = xn / 4;
                let s: u32 = 0;
                while s < xn {
                    let cv: u64 = (t2_xr(a, xb + s) as u64) |
                                  ((t2_xr(a, xb + s + 1) as u64) << 32);
                    let bits: u32 = t2_xr(a, xb + s + 3);
                    if mask_bits(v, bits) == cv {
                        tgt = t2_xr(a, xb + s + 2);
                        e = s / 4;
                        s = xn;
                    } else {
                        s = s + 4;
                    }
                }
                bump_edge(a, ii, e);
                prev = here;
                bi = tgt;
                jumped = 1;
            } else if k == K_RET {
                return t2_ret(a, m, fr, cfr, ii, ro, rl);
            } else if k == K_PHI {
                let xb: u32 = t2_cr(a, ii, CR_XB);
                let xn: u32 = t2_cr(a, ii, CR_XN);
                let s: u32 = 0;
                let hit: u32 = 0;
                let found: u32 = 0;
                while s < xn {
                    if t2_xr(a, xb + s) == prev {
                        hit = t2_xr(a, xb + s + 1);
                        found = 1;
                        s = xn;
                    } else {
                        s = s + 2;
                    }
                }
                if found == 0 {
                    fail("phi 没有来自前驱块的入边");
                }
                t2_setd(a, m, fr, t2_cr(a, ii, CR_DEST), t2_getop(a, m, fr, hit));
            } else {
                let v: u64 = t2_eval(a, m, fr, cfr, ii);
                t2_setd(a, m, fr, t2_cr(a, ii, CR_DEST), v);
            }
            j = j + 1;
        }
        if jumped == 0 {
            fail("块没有终结指令");
        }
    }
    return 0;
}

fn run(a: ptr) -> u32 {
    let m: ptr = ptr_add(a, MEM_OFF);
    let ab: ptr = ptr_add(a, ARGV_OFF);
    let f1: u64 = argv_n(ab, 8192, 1);
    if lo32(f1) == 0 {
        wstr(2, "用法: lvm IN.ll\n");
        return 2;
    }
    // VM 合成的 `/proc/self/cmdline`（`docs/243` §3.4）：**被解释程序自己的**命令行 ——
    // 就是上面那个输入路径，原样。它已经躺在 ARGV 区里了，只要把"起点 + 连同末尾 NUL 的
    // 长度"记下来；末尾那个 NUL 补写一次，好让 `read` 出去的字节数不取决于命令行怎么结尾。
    store8(ab, hi32(f1) + lo32(f1), 0 as u8);
    ctx_set(a, C_ARG0, hi32(f1));
    ctx_set(a, C_ARG0N, lo32(f1) + 1);
    // 路径就在 argv 缓冲里（NUL 结尾），而那个缓冲在输入区**之外** —— 直接用它。
    let n: i64 = read_file(ptr_add(ab, hi32(f1)), a, SRCCAP as u64);
    if n < 0 {
        return fail("读不了输入");
    }
    ctx_set(a, C_NSRC, n as u32);
    ctx_set(a, C_IFHASH, fnv32(a, n as u32));
    ctx_set(a, C_DIS, 0);
    ctx_set(a, C_DTSLO, 0);
    ctx_set(a, C_DTSHI, 0);
    ctx_set(a, C_DNB, 0);
    ctx_set(a, C_DNT, 0);
    ctx_set(a, C_DNR, 0);
    ctx_set(a, C_DROUND, 0);
    ctx_set(a, C_DREL, 0);
    ctx_set(a, C_DSH, 0);
    if d_marker(a, n as u32) == 1 {
        ctx_set(a, C_DIS, 1);
    }
    // 附加实参（位置 2..10）：`sw_cap` / `sw_tag` / `ckpt=N` / `ckpt-out=PATH` / `resume=PATH`。
    // 它们可以落在任何一格（第 2 格平常是剖面文件），所以开文件前要跳过。
    let f2: u64 = argv_n(ab, 8192, 2);
    let f3: u64 = argv_n(ab, 8192, 3);
    let f4: u64 = argv_n(ab, 8192, 4);
    ctx_set(a, C_SUB, 0);
    ctx_set(a, C_MODE, 0);
    ctx_set(a, C_CKPT_AT, 0);
    store32(a, SNAP_HDR + 40, 0);
    store32(a, SNAP_HDR + 44, 0);
    store32(a, SNAP_HDR + 48, 0);
    store32(a, SNAP_HDR + 52, 0);
    store32(a, SNAP_HDR + 56, 0);
    store32(a, SNAP_HDR + 60, 0);        // 本次命令行给了 `ckpt=` 没有（0 也是合法停点）
    let ai: u32 = 2;
    while ai <= 10 {
        let f: u64 = argv_n(ab, 8192, ai);
        if lo32(f) > 0 {
            if eqw(ab, hi32(f), lo32(f), "sw_cap") {
                ctx_set(a, C_SUB, 1);
            }
            if eqw(ab, hi32(f), lo32(f), "sw_tag") {
                ctx_set(a, C_SUB, 2);
                ctx_set(a, C_TAGSEQ, 0);
            }
            let c: u64 = arg_tail(ab, f, "ckpt=");
            if lo32(c) > 0 {
                ctx_set(a, C_CKPT_AT, dec_u64(ab, hi32(c), hi32(c) + lo32(c)) as u32);
                store32(a, SNAP_HDR + 60, 1);
                ctx_set(a, C_MODE, 1);
            }
            let o: u64 = arg_tail(ab, f, "ckpt-out=");
            if lo32(o) > 0 {
                store32(a, SNAP_HDR + 40, hi32(o));
                store32(a, SNAP_HDR + 44, lo32(o));
                ctx_set(a, C_MODE, 1);
            }
            let dk: u64 = arg_tail(ab, f, "relocate=");
            if lo32(dk) > 0 {
                ctx_set(a, C_DREL, dec_u64(ab, hi32(dk), hi32(dk) + lo32(dk)) as u32);
            }
            let sf: u64 = arg_tail(ab, f, "shuffle=");
            if lo32(sf) > 0 {
                ctx_set(a, C_DSH, dec_u64(ab, hi32(sf), hi32(sf) + lo32(sf)) as u32);
            }
            let r: u64 = arg_tail(ab, f, "resume=");
            if lo32(r) > 0 {
                store32(a, SNAP_HDR + 48, hi32(r));
                store32(a, SNAP_HDR + 52, lo32(r));
                store32(a, SNAP_HDR + 56, 1);
                ctx_set(a, C_MODE, 1);
            }
        }
        ai = ai + 1;
    }
    // T1（`docs/247`）：第二个实参（有的话）= 剖面写到哪个文件。**不给就不记**。
    if lo32(f2) != 0 && !is_opt_arg(ab, f2) {
        // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577，mode 0644 = 420
        let pfd: i64 = syscall4(2, ptr_add(ab, hi32(f2)) as u64, 577, 420);
        if pfd < 0 {
            return fail("写不了剖面文件");
        }
        ctx_set(a, C_PROF_FD, pfd as u32);
    }
    if load32(a, SNAP_HDR + 56) == 0 {
        ctx_set(a, C_HEAP, GLOBAL_BASE);
        ctx_set(a, C_DEPTH, 0);
        ctx_set(a, C_NOBJ, 0);
        ctx_set(a, C_NFOBJ, 0);
        ctx_set(a, C_NRET, 0);
        ctx_set(a, C_PRIV, 0);
        ctx_set(a, C_STEPS, 0);
    }
    ctx_set(a, C_TIER, 0);
    parse_all(a, n as u32);
    if load32(a, SNAP_HDR + 56) == 1 {
        let cli_sub: u32 = ctx_get(a, C_SUB);
        let cli_at: u32 = ctx_get(a, C_CKPT_AT);
        snapshot_read(a, m, load32(a, SNAP_HDR + 48), load32(a, SNAP_HDR + 52));
        if ctx_get(a, C_SUB) != cli_sub {
            return fail("checkpoint：基质与快照不匹配（resume 要带同一档）");
        }
        // 快照里的 `ckpt=` 是**上一次**的；恢复时以本次命令行为准（不写就是跑到完）。
        ctx_set(a, C_CKPT_AT, cli_at);
    } else {
        place_globals(a, m);
    }
    // T2（`docs/259` §7，#586）：第三个实参写 `t2` 就先把操作数/类型折成表再跑。
    if lo32(f4) > 0 && !is_opt_arg(ab, f4) {
        let sfd: i64 = syscall4(2, ptr_add(ab, hi32(f4)) as u64, 577, 420);
        if sfd >= 0 {
            ctx_set(a, C_STATS_FD, sfd as u32);
        }
    }
    if lo32(f3) > 0 && eqw(ab, hi32(f3), lo32(f3), "t2") {
        ctx_set(a, C_TIER, 1);
        t2_compile_all(a);
    }
    if ctx_get(a, C_SUB) != 0 && ctx_get(a, C_TIER) == 1 {
        return fail("sw_cap 只在 T0（docs/371）");
    }
    if ctx_get(a, C_DIS) != 0 && ctx_get(a, C_SUB) != 0 {
        return fail("dismemory 与基质（sw_cap）不叠加（docs/373 §1.6）");
    }
    if ctx_get(a, C_DIS) != 0 && ctx_get(a, C_TIER) == 1 {
        return fail("dismemory 只在 T0（docs/373）");
    }
    if ctx_get(a, C_MODE) == 1 {
        if ctx_get(a, C_PROF_FD) != 0 || ctx_get(a, C_STATS_FD) != 0 {
            return fail("checkpoint 不记剖面/计数（docs/364）");
        }
        if ctx_get(a, C_TIER) != 0 {
            return fail("checkpoint 只在 T0（docs/364）");
        }
        let fresh: u32 = 0;
        if load32(a, SNAP_HDR + 56) == 0 {
            fresh = 1;
        }
        ctx_set(a, C_MISS, 0);
        ctx_set(a, C_EXEC, 1);
        exec_stack(a, m, fresh);
        ctx_set(a, C_EXEC, 0);
        return 0;
    }
    let fi: u32 = fn_find_lit(a, "@_start");
    if fi == NONE {
        return fail("这份 IR 里没有 `_start`");
    }
    ctx_set(a, C_DEPTH, 1);
    ctx_set(a, C_MISS, 0);
    ctx_set(a, C_EXEC, 1);
    wr(a, FBASE_OFF, 4, ctx_get(a, C_NFOBJ));            // 深度 1 的帧对象栈起点
    let fr: u32 = MEM_SIZE - FRAME_SIZE;
    if ctx_get(a, C_TIER) == 1 {
        t2_frame_init(a, m, fr, fi);
        t2_exec(a, m, fi, fr, NONE, NONE, 0);
    } else {
        wr(m, fr, 0, 0);
        wr(m, fr, 1, FR_SLOTS);
        exec_body(a, m, fi, fr, NONE, 0, 0);
    }
    ctx_set(a, C_EXEC, 0);
    dump_stats(a);
    let pfd2: u32 = ctx_get(a, C_PROF_FD);
    if pfd2 != 0 {
        dump_profile(a, pfd2 as u64);
        syscall4(3, pfd2 as u64, 0, 0);
    }
    return 0;
}

fn _start() -> u32 {
    // 末尾多留 `sw_tag` 的标签/能力表（`TAG_OFF` / `CAP_OFF`）—— 既有偏移一个都不挪。
    let a: ptr = sys_alloc(IOS_END as u64) as ptr;
    if a as u64 == 0 {
        return fail("oom (brk 失败)");
    }
    // `clock_gettime` 的 timespec 暂存（`docs/309`）：**16 字节，一次就够**。
    let tsv: u64 = sys_alloc(16);
    if tsv == 0 {
        return fail("oom (brk 失败)");
    }
    ctx_set(a, C_TSBUF, tsv as u32);
    return die(run(a) as u64);
}
