fn scope_match(o: Opt) -> u32 {
    let x: u32 = 1;
    match o {
        Opt::Some(x) => {
            let y: u32 = x + 1;
            return y + x;
        }
        Opt::None => {
            return x;
        }
    }
}

fn scope_iflet(o: Opt) -> u32 {
    let x: u32 = 1;
    if let Opt::Some(x) = o {
        let y: u32 = x + 1;
        return y + x;
    }
    return x;
}
