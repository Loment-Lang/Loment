// 它是**带实现的单元** (`--impl`, docs/186): 带正文的函数是真 `pub fn`，
// 没带正文的仍是 `extern fn` (实现在源语言那一侧, docs/173 §2)。
// 源对象: unit=verbs language=loment potato=v6

module verbs
choose runtime

// ---- 由正文翻译出来的实现 (docs/186: natural -> Loment, tools/nltrans.py)
fn nl_write_num(fd: u64, v: i64) {
    let buf: ptr = alloc(24);
    let start: u32 = 0;
    let x: u64 = 0;
    let zero: i64 = 0;
    if v < zero {
        store8(buf, 0, 45 as u8);
        start = 1;
        x = (zero - v) as u64;
    } else {
        x = v as u64;
    }
    let n: u32 = start;
    if x == 0 {
        store8(buf, n, 48 as u8);
        n = n + 1;
    }
    while x > 0 {
        store8(buf, n, (48 + ((x % 10) as u32)) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < (n - start) / 2 {
        let lo: u8 = load8(buf, start + i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, start + i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    syscall4(1, fd, buf as u64, n as u64);
}

pub fn _start() {
    let buf: ptr = alloc(2);
    store8(buf, 0 as u32, 65 as u8);
    store8(buf, 1 as u32, 10 as u8);
    syscall4(1, 1, str_ptr("verbs: ") as u64, str_len("verbs: ") as u64);
    nl_write_num(1, load8(buf, 0) as i64);
    syscall4(1, 1, str_ptr(" ") as u64, str_len(" ") as u64);
    syscall4(1 as u64, 1 as u64, buf as u64, 2 as u64);
    syscall4(60 as u64, 0 as u64, 0 as u64, 0 as u64);
}
