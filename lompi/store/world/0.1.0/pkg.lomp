// world/pkg.lomp — 库清单（给人看的两个标签；机器身份是内容哈希）。
module pkg

pub fn name() -> str {
    return "world";
}

pub fn version() -> str {
    return "0.1.0";
}

/// 这个包对**运行期**的需求（`docs/323`）。编译器读它来判断"`no_runtime` 的根能不能
/// 用这个包"；模块自己写的 `choose runtime` 优先。取值只有 `runtime` / `no_runtime`。
pub fn runtime() -> str {
    return "runtime";
}
