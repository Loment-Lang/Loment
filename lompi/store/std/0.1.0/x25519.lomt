// std/x25519.lomt — Curve25519 上的 X25519（RFC 7748）
//
// 为什么标准库要有它: TLS 1.3、SSH、WireGuard 的密钥交换都是 X25519 —— 客户端与
// 服务端各发一个 32 字节公钥，双方各算一次就得到同一个共享秘密。没有它，安全协议
// 的第一层就拼不起来。
//
// 实现路线: TweetNaCl 的那套 16×16 位有符号肢体（每个域元素 16 个 i64），乘法的
// 中间积用 64 位装。选它而不是 51 位肢体，是因为本语言里没有 u128：16 位肢体的
// 乘积最大 2^30，16 个累加也只有 2^34，稳稳落在 i64 里；归约用 38 倍折叠。
//
// 常数时间: 标量位只用来做条件交换（cswap 用掩码整体选），没有按位分支 —— 这条
// 是这条曲线在真实使用里最要紧的性质（时间侧信道会直接泄漏私钥）。
//
// 布局: 一个域元素 = 128 字节（16 × i64 小端）。所有内部函数按**基址 + 偏移**
// 操作（不使用 `ptr_add`：`loment.py test` 的 Rust 翻译不生成 unsafe 块）。
// 调用方给 `sc`（`x25519_scratch()` 字节）。
//
// 命名: 公开 x25519_*, 内部 xq_*。自检 test_x25519_*（RFC 7748 向量，无系统调用）。

module x25519

use "mem.lomt"

/// 一个域元素的字节数（16 个 16 位肢体，按 i64 存）。
pub const X25519_GF: u32 = 128;
/// 标量/点/输出的字节数。
pub const X25519_BYTES: u32 = 32;

const XQ_X: u32 = 0;
const XQ_A: u32 = 128;
const XQ_B: u32 = 256;
const XQ_C: u32 = 384;
const XQ_D: u32 = 512;
const XQ_E: u32 = 640;
const XQ_F: u32 = 768;
const XQ_PROD: u32 = 896;
const XQ_Z: u32 = 1152;
const XQ_T: u32 = 1184;
const XQ_M: u32 = 1312;
const XQ_INV: u32 = 1440;
const XQ_K121665: u32 = 1568;
const XQ_SCRATCH: u32 = 2048;

/// 内部工作区需要的字节数。
pub fn x25519_scratch() -> u32 {
    return XQ_SCRATCH;
}

fn xq_get(x: ptr, o: u32, i: u32) -> i64 {
    return mem_load64(x, o + i * 8) as i64;
}

fn xq_put(x: ptr, o: u32, i: u32, v: i64) {
    mem_store64(x, o + i * 8, v as u64);
}

fn xq_zero(x: ptr, o: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        xq_put(x, o, i, 0 as i64);
        i = i + 1;
    }
    return 1;
}

fn xq_one(x: ptr, o: u32) -> u32 {
    xq_zero(x, o);
    xq_put(x, o, 0, 1 as i64);
    return 1;
}

fn xq_copy(x: ptr, dst: u32, src: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        xq_put(x, dst, i, xq_get(x, src, i));
        i = i + 1;
    }
    return 1;
}

/// 进位到 [-2^15, 2^15)，第 16 个肢体折回第 0 个（乘 38，因为 2^256 ≡ 38 mod p）。
fn xq_carry(x: ptr, o: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        let v: i64 = xq_get(x, o, i) + (65536 as i64);
        let c: i64 = v >> 16;
        let t: i64 = c - (1 as i64);
        if i < 15 {
            xq_put(x, o, i + 1, xq_get(x, o, i + 1) + t);
        } else {
            xq_put(x, o, 0, xq_get(x, o, 0) + t * (38 as i64));
        }
        xq_put(x, o, i, v - (c << 16));
        i = i + 1;
    }
    return 1;
}

/// 常数时间的条件交换：b = 1 时交换 p/q。
fn xq_sel(x: ptr, p: u32, q: u32, b: u32) -> u32 {
    let m: i64 = 0 as i64 - (b as i64);
    let i: u32 = 0;
    while i < 16 {
        let t: i64 = m & (xq_get(x, p, i) ^ xq_get(x, q, i));
        xq_put(x, p, i, xq_get(x, p, i) ^ t);
        xq_put(x, q, i, xq_get(x, q, i) ^ t);
        i = i + 1;
    }
    return 1;
}

fn xq_add(x: ptr, o: u32, a: u32, b: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        xq_put(x, o, i, xq_get(x, a, i) + xq_get(x, b, i));
        i = i + 1;
    }
    return 1;
}

fn xq_sub(x: ptr, o: u32, a: u32, b: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        xq_put(x, o, i, xq_get(x, a, i) - xq_get(x, b, i));
        i = i + 1;
    }
    return 1;
}

/// o = a * b mod 2^255-19；中间积落在 XQ_PROD。
fn xq_mul(x: ptr, o: u32, a: u32, b: u32) -> u32 {
    let i: u32 = 0;
    while i < 31 {
        mem_store64(x, XQ_PROD + i * 8, 0 as u64);
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        let ai: i64 = xq_get(x, a, i);
        let j: u32 = 0;
        while j < 16 {
            let cur: i64 = mem_load64(x, XQ_PROD + (i + j) * 8) as i64;
            mem_store64(x, XQ_PROD + (i + j) * 8, (cur + ai * xq_get(x, b, j)) as u64);
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < 15 {
        let lo: i64 = mem_load64(x, XQ_PROD + i * 8) as i64;
        let hi: i64 = mem_load64(x, XQ_PROD + (i + 16) * 8) as i64;
        mem_store64(x, XQ_PROD + i * 8, (lo + hi * (38 as i64)) as u64);
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        xq_put(x, o, i, mem_load64(x, XQ_PROD + i * 8) as i64);
        i = i + 1;
    }
    xq_carry(x, o);
    xq_carry(x, o);
    return 1;
}

fn xq_sq(x: ptr, o: u32, a: u32) -> u32 {
    return xq_mul(x, o, a, a);
}

/// o = 1/a（a^(p-2)，TweetNaCl 的 254/250 链）。
fn xq_inv(x: ptr, o: u32, a: u32) -> u32 {
    xq_copy(x, XQ_INV, a);
    let k: i64 = 253 as i64;
    while k >= 0 {
        xq_sq(x, XQ_INV, XQ_INV);
        if k != (2 as i64) && k != (4 as i64) {
            xq_mul(x, XQ_INV, XQ_INV, a);
        }
        k = k - 1;
    }
    return xq_copy(x, o, XQ_INV);
}

/// 压缩成 32 字节（模 p 之后小端）。
fn xq_pack(x: ptr, o: ptr, n: u32) -> u32 {
    xq_copy(x, XQ_T, n);
    xq_carry(x, XQ_T);
    xq_carry(x, XQ_T);
    xq_carry(x, XQ_T);
    let round: u32 = 0;
    while round < 2 {
        xq_put(x, XQ_M, 0, xq_get(x, XQ_T, 0) - (65517 as i64));
        let i: u32 = 1;
        while i < 15 {
            let prev: i64 = (xq_get(x, XQ_M, i - 1) >> 16) & (1 as i64);
            xq_put(x, XQ_M, i, xq_get(x, XQ_T, i) - (65535 as i64) - prev);
            xq_put(x, XQ_M, i - 1, xq_get(x, XQ_M, i - 1) & (65535 as i64));
            i = i + 1;
        }
        let prev15: i64 = (xq_get(x, XQ_M, 14) >> 16) & (1 as i64);
        xq_put(x, XQ_M, 15, xq_get(x, XQ_T, 15) - (32767 as i64) - prev15);
        let b: u32 = ((xq_get(x, XQ_M, 15) >> 16) & (1 as i64)) as u32;
        xq_put(x, XQ_M, 14, xq_get(x, XQ_M, 14) & (65535 as i64));
        xq_sel(x, XQ_T, XQ_M, 1 - b);
        round = round + 1;
    }
    let i2: u32 = 0;
    while i2 < 16 {
        let v: i64 = xq_get(x, XQ_T, i2);
        store8(o, 2 * i2, (v & (255 as i64)) as u8);
        store8(o, 2 * i2 + 1, ((v >> 8) & (255 as i64)) as u8);
        i2 = i2 + 1;
    }
    return 1;
}

fn xq_unpack(x: ptr, o: u32, n: ptr) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        let lo: i64 = load8(n, 2 * i) as i64;
        let hi: i64 = load8(n, 2 * i + 1) as i64;
        xq_put(x, o, i, lo + (hi << 8));
        i = i + 1;
    }
    xq_put(x, o, 15, xq_get(x, o, 15) & (32767 as i64));
    return 1;
}

/// 常数 121665 的域元素（ladder 里 a24 的那一步）。
fn xq_k121665(x: ptr) -> u32 {
    xq_zero(x, XQ_K121665);
    xq_put(x, XQ_K121665, 0, 56129 as i64);
    xq_put(x, XQ_K121665, 1, 1 as i64);
    return 1;
}

/// RFC 7748 的 Montgomery ladder，输出 32 字节。
pub fn x25519(scalar: ptr, point: ptr, out: ptr, sc: ptr) -> u32 {
    let i: u32 = 0;
    while i < 32 {
        store8(sc, XQ_Z + i, load8(scalar, i) as u8);
        i = i + 1;
    }
    store8(sc, XQ_Z, (load8(sc, XQ_Z) & 248) as u8);
    store8(sc, XQ_Z + 31, ((load8(sc, XQ_Z + 31) & 127) | 64) as u8);

    xq_unpack(sc, XQ_X, point);
    xq_copy(sc, XQ_B, XQ_X);
    xq_zero(sc, XQ_A);
    xq_zero(sc, XQ_C);
    xq_zero(sc, XQ_D);
    xq_one(sc, XQ_A);
    xq_one(sc, XQ_D);
    xq_k121665(sc);

    let bit: i64 = 254 as i64;
    while bit >= 0 {
        let byte_i: u32 = (bit >> 3) as u32;
        let sh: u32 = (bit & (7 as i64)) as u32;
        let r: u32 = ((load8(sc, XQ_Z + byte_i) >> sh) & 1) as u32;
        xq_sel(sc, XQ_A, XQ_B, r);
        xq_sel(sc, XQ_C, XQ_D, r);
        xq_add(sc, XQ_E, XQ_A, XQ_C);
        xq_sub(sc, XQ_A, XQ_A, XQ_C);
        xq_add(sc, XQ_C, XQ_B, XQ_D);
        xq_sub(sc, XQ_B, XQ_B, XQ_D);
        xq_sq(sc, XQ_D, XQ_E);
        xq_sq(sc, XQ_F, XQ_A);
        xq_mul(sc, XQ_A, XQ_C, XQ_A);
        xq_mul(sc, XQ_C, XQ_B, XQ_E);
        xq_add(sc, XQ_E, XQ_A, XQ_C);
        xq_sub(sc, XQ_A, XQ_A, XQ_C);
        xq_sq(sc, XQ_B, XQ_A);
        xq_sub(sc, XQ_C, XQ_D, XQ_F);
        xq_mul(sc, XQ_A, XQ_C, XQ_K121665);
        xq_add(sc, XQ_A, XQ_A, XQ_D);
        xq_mul(sc, XQ_C, XQ_C, XQ_A);
        xq_mul(sc, XQ_A, XQ_D, XQ_F);
        xq_mul(sc, XQ_D, XQ_B, XQ_X);
        xq_sq(sc, XQ_B, XQ_E);
        xq_sel(sc, XQ_A, XQ_B, r);
        xq_sel(sc, XQ_C, XQ_D, r);
        bit = bit - 1;
    }

    xq_inv(sc, XQ_C, XQ_C);
    xq_mul(sc, XQ_A, XQ_A, XQ_C);
    return xq_pack(sc, out, XQ_A);
}

/// 基点（u = 9）上的标量乘 —— 公钥推导与 ECDH 两端都用它。
pub fn x25519_base(scalar: ptr, out: ptr, sc: ptr) -> u32 {
    let p: ptr = alloc(32);
    let i: u32 = 0;
    while i < 32 {
        store8(p, i, 0 as u8);
        i = i + 1;
    }
    store8(p, 0, 9 as u8);
    return x25519(scalar, p, out, sc);
}

// ---------------------------------------------------------------- 自检

fn xq_hex_nib(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return 0;
}

fn xq_hex_in(out: ptr, s: str) -> u32 {
    let n: u32 = str_len(s) / 2;
    let i: u32 = 0;
    while i < n {
        let hi: u32 = xq_hex_nib(str_byte(s, 2 * i) as u32);
        let lo: u32 = xq_hex_nib(str_byte(s, 2 * i + 1) as u32);
        store8(out, i, (hi * 16 + lo) as u8);
        i = i + 1;
    }
    return n;
}

fn xq_eq_bytes(a: ptr, b: ptr, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_x25519_base_point() -> bool {
    let sc: ptr = alloc(x25519_scratch());
    let a: ptr = alloc(32);
    let want: ptr = alloc(32);
    let got: ptr = alloc(32);
    xq_hex_in(a, "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
    xq_hex_in(want, "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a");
    x25519_base(a, got, sc);
    return xq_eq_bytes(got, want, 32);
}

fn test_x25519_shared_secret() -> bool {
    let sc: ptr = alloc(x25519_scratch());
    let a: ptr = alloc(32);
    let b: ptr = alloc(32);
    let pa: ptr = alloc(32);
    let pb: ptr = alloc(32);
    let s1: ptr = alloc(32);
    let s2: ptr = alloc(32);
    let want: ptr = alloc(32);
    xq_hex_in(a, "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
    xq_hex_in(b, "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb");
    xq_hex_in(pa, "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a");
    xq_hex_in(pb, "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f");
    xq_hex_in(want, "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742");
    x25519(a, pb, s1, sc);
    x25519(b, pa, s2, sc);
    if !xq_eq_bytes(s1, s2, 32) {
        return false;
    }
    return xq_eq_bytes(s1, want, 32) && xq_eq_bytes(s2, want, 32);
}

fn test_x25519_iterated_one() -> bool {
    // RFC 7748 §5.2 的第一次迭代：k = u = 09 00 … 00 -> 422c8e7a…
    let sc: ptr = alloc(x25519_scratch());
    let k: ptr = alloc(32);
    let u: ptr = alloc(32);
    let want: ptr = alloc(32);
    let got: ptr = alloc(32);
    let i: u32 = 0;
    while i < 32 {
        store8(k, i, 0 as u8);
        store8(u, i, 0 as u8);
        i = i + 1;
    }
    store8(k, 0, 9 as u8);
    store8(u, 0, 9 as u8);
    xq_hex_in(want, "422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079");
    x25519(k, u, got, sc);
    return xq_eq_bytes(got, want, 32);
}
