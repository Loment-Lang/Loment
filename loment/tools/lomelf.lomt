// loment/tools/lomelf.lomt — Loment 版原生 ELF 后端 (无 Python, docs/167)
//
// 判据 (tools/loment_elf_test.py 的 test_lomelf_selfhost_matches_reference):
// 同一份 `.ll` 喂本程序 (走种子自举链编成 ELF 后跑) 与 tools/lomelf.py,
// **产出的 ELF 逐字节相同**。这是"编译一个 Loment 程序不再需要一个 C 编译器"的那一格。
//
// CLI:  lomelf IN.ll OUT        (无选项; 参考实现的 -o/--check 是它自己的便利, 不镜像)
// 退出码 0 = OK / 1 = 输入不支持或解析失败 / 2 = 用法错误
//
// 与参考实现 (tools/lomelf.py) 的关系: **逐条镜像**, 包括那些看起来啰嗦的地方 ——
// 判据是字节相同, 任何"我这版写得更漂亮"的发挥都会让判据红。参考实现就是这格的规格书。
//
// 已知边界 (与参考实现头注同源, 逐条记账):
//   * 调用约定是我们自己的 (实参走栈), 不是 System V;
//   * 聚合返回值 / 间接调用 / 浮点不支持 (报错退出, 不静默错编)。
//
// 自举子集注意 (docs/150 的两条自举链缺口): 不写 `(a + b as T) as U`, 变量不叫 `fn`。

module lomelf
choose runtime

use bytes
use win_shim_data

// ---------------------------------------------------------------- PE 目标
//
// 与 tools/lomelf.py 的 --target pe 逐字对齐。四个节**钉在固定 RVA**，所以
// `__win_syscall` 里对 IAT 与静态状态的取址全是编译期常量 —— 那段机器码与布局完全无关，
// 直接从 win_shim_data（`tools/lomelf.py --dump-win-shim` 生成）拷进 .text 即可。
// 节间**不能留空洞**：加载器会报"不是有效的 Win32 应用程序"，所以每节的 VirtualSize
// 一直铺到下一节起点。
const PE_TEXT_RVA: u32 = 0x1000;
const PE_IDATA_RVA: u32 = 0x1000000;
const PE_DATA_RVA: u32 = 0x2000000;
const PE_STATE_RVA: u32 = 0x3000000;
const PE_SEC_ALIGN: u32 = 0x1000;
const PE_FILE_ALIGN: u32 = 0x200;
const PE_WS_SIZE: u32 = 1139984;   // 与参考实现的 WS_SIZE 对齐（`poll`/`select` 的
                                   // fd_set 与影子集 + `sendmsg`/`recvmsg` 的 64 KiB
                                   // 散列暂存 + `epoll` 的实例表）
const PE_IMPORT_DESC: u32 = 60;    // 导入描述符表的字节数 = 20 × (DLL 数 + 全零终止项)
                                   // （kernel32 + ws2_32 ⇒ 两条描述符；写死 40 会让
                                   //   镜像的 PE 与参考差这一格 —— 判据当场抓）
const PE_LIT_OFF: u32 = 0x1000;    // "/proc/self/cmdline" 在 .idata 内的偏移
const PE_IMG_BASE: u64 = 5368709120;   // 0x140000000 —— 只在实际落绝对地址时才加
                                       // （表里存的是 RVA：u32 装不下这个基址）

// ---------------------------------------------------------------- 内存布局

// ---- 2026-09-19: 输入缓冲从 2 MiB 抬到 4 MiB（`docs/192` 记的那条待办）
//
// 起因不是猜的: **自举种子自己长过了 2 MiB**（`loment/build/selfhost_driver.ll`,
// 上一版余量只剩 1377 B —— 那次给 comefor 补两处守卫就顶出去了）。种子必须喂给 lomelf
// （`bootstrap.sh` 的 1/4 步），所以这条上限就是**种子的上限**。抬法是把布局整体重排:
// 输入 / 代码 / 输出三块各给 4 MiB（输入装得下种子, 代码与输出按同比例给, 免得
// "输入收下了、产物却装不下"那种一半的失败）。表区与全局数据不动。
const M_ARGV: u32 = 0;             // 8192
const M_IN: u32 = 8192;            // 4 MiB 输入 .ll 文本
const M_TXT: u32 = 4202496;        // 4 MiB 代码缓冲
const M_OUT: u32 = 8396800;        // 4 MiB 输出 ELF
const M_GB: u32 = 12591104;        // 1 MiB 全局数据
const M_TAB: u32 = 13639680;       // 4 MiB 表区
const M_OBJ: u32 = 17833984;       // 4 MiB 外部目标文件 (.o) 暂存 (docs/173, 一次一个)
// **归档暂存**（`docs/173` 阶段 2，`FujoJTOP/loment#405`）：`.a` 要整包驻留（定点选择要
// 反复扫它），而成员得拷进 `M_OBJ` 再摆 —— 两块不能是同一块。与 `M_OBJ` 同尺寸：真库
// （zlib 的 150 KB）离上限很远，上限在这里是给"来的不是库"那种输入一个**响亮的**界。
const M_AR: u32 = 22028288;        // 4 MiB 归档暂存
const ARENA: u64 = 26222592;

const IN_CAP: u32 = 4194304;
//: `--diag-out PATH` 的落点：**argv 暂存块的最后 1 KiB**（`pbuf` 一共 64 KiB，
//: 它的 0..65536 是路径区，再往后才是代码缓冲）。给启动器传进来的那条诊断文件路径用,
//: 免得与输入 / 输出 / `--link` 三个落点抢 —— 那三块都是按 argv 长度算出来的。
const DIAGB_OFF: u32 = 64512;
const OUT_CAP: u32 = 4194304;
const GB_CAP: u32 = 1048576;
const OBJ_CAP: u32 = 4194304;
const AR_CAP: u32 = 4194304;

// 表区内的格 (相对 M_TAB)
const C_NG: u32 = 0;
const C_GB: u32 = 4;
const C_BSS: u32 = 8;
const C_NLBL: u32 = 12;
const C_NFIX: u32 = 16;
const C_NSLOT: u32 = 20;
const C_NALLOC: u32 = 24;
const C_FRAME: u32 = 28;
const C_TYLEN: u32 = 32;
const C_TYOFF: u32 = 36;
const C_VLOFF: u32 = 40;
const C_VLLEN: u32 = 44;
const C_DESTO: u32 = 48;
const C_DESTL: u32 = 52;
const C_RETL: u32 = 56;
const C_NPHI: u32 = 60;
const C_CURBO: u32 = 64;           // 当前基本块名 (phi 前驱匹配用)
const C_CURBL: u32 = 68;
const C_FNO: u32 = 72;             // 当前函数名
const C_FNL: u32 = 76;
const C_CC: u32 = 80;
const C_CSS: u32 = 84;
const C_PE: u32 = 88;              // 1 = 出 PE (Windows)，0 = 出 ELF
const C_SHIM: u32 = 92;            // PE：`__win_syscall` 在代码缓冲里的偏移
const C_NEXT: u32 = 96;            // 外部函数 (declare) 个数 (docs/173)
const C_EXTN: u32 = 100;           // 外部符号名池游标 (相对输入缓冲起点)
const C_NFREL: u32 = 104;          // 外部目标文件里的重定位条数 (docs/173 阶段 2)
const C_NOBJ: u32 = 108;           // 已摆好的外部对象个数
const C_NNEED: u32 = 112;          // 归档定点的**需要集**条数 (docs/173 阶段 2, #405)
const C_NMEM: u32 = 116;           // 归档**挑中**的成员条数

// 表起址 (相对 M_TAB); 格区 256 字节
//
// ---- 2026-09-20: 全局表从 2048 抬到 4096（`docs/200` 记的那条墙）
//
// 与上面那条输入缓冲**同一个病**: 种子又长过了一格, 这次撞的是全局表。参考实现给每一条
// 字符串字面量发一个 `.str.<函数>.<序号>` 全局（**不按内容去重**），所以"驱动链里多几十个
// 字符串字面量"就等于"全局表多几十条"。种子一旦超过 2048 条, `gadd` 那里**没有任何边界
// 检查**（它是单调 bump）—— 第 2049 条起直接写进**标签表**里, 症状不是报错, 是
// `lomelf: 未定义的标签: `（标签表被改坏, 查出来是个空名字）。
//
// 抬法是**整条表区往后挪**: 全局表 +65536（= 32 × 2048）, 回填表再 +458752
// （= 28 × 16384 —— 加完守卫之后它当场说出来自己是第二张满的, 见 `docs/200` §2）。
// 两张表都给完之后, 表尾最后一个偏移从 1785608 涨到 2244360, 于是**表区跟着从 2 MiB
// 抬到 4 MiB**, `M_OBJ` / `ARENA` 依次后移（与 `docs/192` §2 抬输入缓冲同一条式子）。
// `TB_G_MAX` 是给判据读的（`loment_genesis_test::test_seed_fits_lomelf_table_caps`）——
// 与 `IN_CAP` 那条同一种"把余量变成看得见的预算"。
const TB_G_MAX: u32 = 4096;        // 全局表条数上限（判据按它数种子里的 `@x = `）
const TB_G: u32 = 256;             // 全局表 stride 32 × TB_G_MAX
const G_NOFF: u32 = 0;
const G_NLEN: u32 = 4;
const G_TOFF: u32 = 8;
const G_TLEN: u32 = 12;
const G_SIZE: u32 = 16;
const G_DOFF: u32 = 20;
const G_ADDR: u32 = 24;
const G_ZERO: u32 = 28;

// 每张表的**容量**单独一个常量: ① 表满时要报错（下面各 `*_add` 的守卫）; ②
// `loment_genesis_test::test_seed_fits_lomelf_table_caps` 按它数种子 —— **不另抄一份数**,
// 与 `IN_CAP` / `test_m85_codegen_table_capacity` 同一条纪律。
// ---- 2026-10-10: 标签表从 16384 抬到 32768（`docs/200` 记的那条墙的下一次）
//
// 同一个病第三次: 种子又长过了一格。这次撞标签表时**余量只剩 9**（并 main 之后
// 16375/16384）—— 任何一笔让自举编译器自己多出两位数的基本块/字符串全局的改动都会
// 顶破它（实测: 给入口发一个 `"stackrealign"` 属性就多 3 个全局 + 9 个基本块, 当场
// 16387）。抬法同前: **整条表区往后挪** `24 × 16384 = 393216`（`TB_FIX` 及其后的
// `TB_SLOT` / `TB_ALLOC` / `TB_ARG` / `TB_PHI` / `TB_IDATA` / `TB_EXT` / `TB_OBJ` /
// `TB_FREL` 一起移), 表尾从 2244360 涨到 2637576 —— 仍在 4 MiB 表区内, 所以
// `M_OBJ` / `ARENA` 这次**不用动**。
//
// **同一抬法当时在另一条分支上也做了一遍**（`docs/222` §7 的自举侧 v11 `surfaces`，
// 多 193 条标签）—— 两边数一模一样，并进 main 时这一处按一份落地，不是两抬。
const TB_LBL_MAX: u32 = 32768;     // 标签表条数
const TB_FIX_MAX: u32 = 32768;     // 回填表条数
const TB_SLOT_MAX: u32 = 32768;    // 槽表条数（每函数清）
const TB_ALLOC_MAX: u32 = 8192;    // alloca 表条数（每函数清）
const TB_PHI_MAX: u32 = 512;       // phi 表条数（每函数清）

const TB_LBL: u32 = 131328;          // 标签表 stride 24 × TB_LBL_MAX: (函数名, 块名, 地址)
const L_NOFF: u32 = 0;
const L_NLEN: u32 = 4;
const L_ADDR: u32 = 8;
const L_BOFF: u32 = 12;            // 基本块名 (函数级标签留 0)
const L_BLEN: u32 = 16;

const TB_FIX: u32 = 917760;        // 回填表 stride 28 × TB_FIX_MAX（16384 → 32768, docs/200 §3）
const F_SITE: u32 = 0;
const F_KIND: u32 = 4;
const F_NOFF: u32 = 8;
const F_NLEN: u32 = 12;
const F_BOFF: u32 = 16;
const F_BLEN: u32 = 20;

const TB_SLOT: u32 = 1835264;       // 槽表 stride 16 × 32768 (每函数清)
const S_NOFF: u32 = 0;
const S_NLEN: u32 = 4;
const S_OFF: u32 = 8;

const TB_ALLOC: u32 = 2359552;     // alloca 表 stride 16 × 8192 (每函数清)
const A_NOFF: u32 = 0;
const A_NLEN: u32 = 4;
const A_OFF: u32 = 8;
const A_SIZE: u32 = 12;

const TB_ARG: u32 = 2490624;       // 调用实参暂存 (每个 24 字节)

const TB_PHI: u32 = 2491008;       // phi 表 stride 16 × 512 (每函数清)
const TB_IDATA: u32 = 2499200;      // PE: 导入表 blob 的落点（4115 字节，走 hex 搬进来）
const PH_BOFF: u32 = 0;            // 所属基本块名
const PH_BLEN: u32 = 4;
const PH_IOFF: u32 = 8;            // phi 指令的起始偏移
const PH_ILEN: u32 = 12;

// 外部函数表 (docs/173): `declare` 出来的符号名, 偏移指向**输入文本** (与标签表同基)。
const TB_EXT: u32 = 2504704;       // stride 8 × 4096: (起点, 长度)
const E_NOFF: u32 = 0;
const E_NLEN: u32 = 4;

// 外部对象表 (docs/173 阶段 2): 每个对象在**代码缓冲**里的起点。它的基址 = TEXT_VADDR + 该值。
const TB_OBJ: u32 = 2505504;       // stride 8 × 256
const O_TEXT: u32 = 0;             // 该对象的代码在缓冲里的偏移 (16 对齐)
const O_DATA: u32 = 4;             // 该对象的**数据节**在数据缓冲 (gb) 里的起点 (16 对齐)

// 外部重定位表 (docs/173 阶段 2): 先**全部记下来**, 等所有对象都摆好、标签都立好, 再统一应用
// —— 因为 `a.o` 里的重定位可能指向只有 `b.o` 知道的地址。
const TB_FREL: u32 = 2506504;      // stride 32 × 4096
const F2_OBJ: u32 = 0;             // 对象号 (索引 TB_OBJ)
const F2_AT: u32 = 4;              // 被重定位节在该对象代码里的起点
const F2_OFF: u32 = 8;             // r_offset (节内偏移)
const F2_TY: u32 = 12;             // 重定位类型 (ELF 的 R_X86_64_* 编号)
const F2_NOFF: u32 = 16;           // 目标符号名 (名字池内偏移, 与标签表同基)
const F2_NLEN: u32 = 20;
const F2_ADD: u32 = 24;            // 加数 (i32 位型)
const F2_IN: u32 = 28;             // 0 = 落在**代码**上 (写 txt); 1 = 落在**数据**上 (写 gb)

// **归档那两张表**（`docs/173` 阶段 2，`FujoJTOP/loment#405`）。两张都借 `TB_EXT` 的
// (起点, 长度) 形状 —— 一样的 8 字节、一样的访问器。
//
// 上界**都是点名拒**（`need_add` / `ar_take` 里那条守卫）：真库的需要集是几十个量级、
// 挑中的成员也是十几个，撞上是"来的不是库"，那种输入该听见名字而不是少挑几个成员。
const NEED_MAX: u32 = 2048;        // 需要集条数上限
const TB_NEED: u32 = 2637600;      // stride 8 × NEED_MAX: (名字池起点, 长度)
const MEM_MAX: u32 = 1024;         // 归档挑中的成员上限
const TB_MEM: u32 = 2653984;       // stride 8 × MEM_MAX: (在 M_AR 里的起点, 长度)

// ---------------------------------------------------------------- 常量

const TEXT_VADDR: u32 = 4194304;   // 0x400000
// **数据段在代码缓冲之后**（`docs/253`，2026-10-16）。原先钉在 `0x600000`，文本段于是
// 只有 `0x400000..0x600000` 这 2 MiB 可用 —— 而**越界不报错**：多出来的代码盖在数据段上，
// 产物一启动就段错误（0 字节输出），看起来像编译器坏了。实测 2026-10-15：`main` 自己
// 已占 2 084 579 / 2 097 152（99.4%），任何一笔中等改动都会顶破它。
//
// 现在钉在 `TEXT_VADDR + OUT_CAP`：那个间隔**就是代码缓冲本身的容量**，不是拍出来的数。
// 于是文本段的容量变成了 `OUT_CAP`，而它**有守卫**（驱动里那段，与 `TB_LBL_MAX` 那几个
// 同一个纪律：满了就点名退出，不往下写）。
// **必须与 `tools/lomelf.py` 的 `TEXT_CAP` / `ELF_DATA_VADDR` 同一个数** —— 两边产物要
// 逐字节相同（`loment_elf_test` 的镜像那几格钉着）。
const DATA_VADDR: u32 = 8388608;   // 0x800000 = TEXT_VADDR + OUT_CAP
const NO: u32 = 4294967295;
const PHI: u64 = 4294967296;

const RAX: u32 = 0;
const RCX: u32 = 1;
const RDX: u32 = 2;
const RBX: u32 = 3;                // 只为 extern 调用点的 `rsp` 对齐 (SysV；见 do_call_extern)
const RSP: u32 = 4;
const RBP: u32 = 5;
const RSI: u32 = 6;
const RDI: u32 = 7;
const R8: u32 = 8;                 // 只为 System V 的第 5、6 个实参寄存器 (docs/173)
const R9: u32 = 9;

const ADD: u32 = 0;
const SUB: u32 = 5;
const AND_: u32 = 4;               // Group1 的 /4 = and（`and rsp, -16` 那个）
const LOCAL_PREFIX: u32 = 5;       // `$` + 4 字节对象号（见 `copy_local_name`）
const CMP: u32 = 7;

fn hi32(v: u64) -> u32 {
    return (v / PHI) as u32;
}

fn lo32(v: u64) -> u32 {
    return (v % PHI) as u32;
}

fn pk16(a: u32, b: u32) -> u64 {
    return (a as u64) * PHI + (b as u64);
}

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

/// 面向用户的失败消息: `loment: <msg>` 换行。**前缀是 `loment`, 不是 `lomelf`** ——
/// 用户敲的是 `loment build/run`; `lomelf` 是这个包里的链接器组件名, 对他说不指向任何
/// 他手上的东西 (issue #8)。
fn fail(msg: str) -> u32 {
    wstr(2, "loment: ");
    wstr(2, msg);
    wstr(2, "\n");
    return die(1);
}

/// 同 `fail`, 消息后面接一段**已经量好的字节** (token 原文)。
fn faill(msg: str, tail: ptr, n: u32) -> u32 {
    wstr(2, "loment: ");
    wstr(2, msg);
    write_all(2, tail, n as u64);
    wstr(2, "\n");
    return die(1);
}

/// 同 `fail`, 消息后面接一个 **NUL 结尾**的路径 (`--link` 那一批拿到的都是 cstr)。
fn failc(msg: str, cpath: ptr) -> u32 {
    wstr(2, "loment: ");
    wstr(2, msg);
    write_cstr(2, cpath, 0);
    wstr(2, "\n");
    return die(1);
}

fn fail_line(t: ptr, ls: u32, le: u32) -> u32 {
    return faill("this instruction is not supported: ", ptr_add(t, ls), le - ls);
}

/// 一个字节的低 8 位按**小写十六进制两位**写出去（JSON 里写 `\u00XX` 要用）。
fn whex2(fd: u64, v: u32) -> u64 {
    let t: ptr = sys_alloc(2) as ptr;
    let hi: u32 = (v / 16) % 16;
    let lo: u32 = v % 16;
    if hi > 9 {
        store8(t, 0, (87 + hi) as u8);
    } else {
        store8(t, 0, (48 + hi) as u8);
    }
    if lo > 9 {
        store8(t, 1, (87 + lo) as u8);
    } else {
        store8(t, 1, (48 + lo) as u8);
    }
    return write_all(fd, t, 2);
}

/// 把 `p[0..n]` 按 **JSON 字符串**写出（含两侧引号）。
///
/// 路径里完全可能有 `\`（Windows 就是这样）或控制字节 —— 不转义写出来的就不是合法
/// JSON，下游 `lomenterr` 会整行解析失败，而那种失败**看起来像没有诊断**。
fn wjson_str(fd: u64, p: ptr, n: u32) -> u64 {
    let _q: u64 = wstr(fd, "\"");
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i) as u32;
        if c == 34 {
            let _a: u64 = wstr(fd, "\\\"");
        } else if c == 92 {
            let _b: u64 = wstr(fd, "\\\\");
        } else if c < 32 {
            let _c: u64 = wstr(fd, "\\u00");
            let _d: u64 = whex2(fd, c);
        } else {
            let _e: u64 = write_all(fd, ptr_add(p, i), 1);
        }
        i = i + 1;
    }
    return wstr(fd, "\"");
}

/// 写不了产物时的**结构化诊断**: 一行 JSON，与编译器 `--diag-out` 同一种记录
/// （`file` / `line` / `col` / `code` / `message`）。`line` 是 0 —— 这条诊断不属于
/// 源码的哪一行，报错器据此不印 `:行号`、也不去源里切那两行。
///
/// `dp` 是启动器给的诊断文件路径（NUL 结尾）；`outp[0..outn)` 是写不出去的那条路径。
fn emit_wfail(dp: ptr, outp: ptr, outn: u32) -> u64 {
    let fd: i64 = open_wo(dp);
    if fd < 0 {
        return 0;
    }
    let u: u64 = fd as u64;
    let _a: u64 = wstr(u, "{\"file\":");
    let _b: u64 = wjson_str(u, outp, outn);
    let _c: u64 = wstr(u, ",\"line\":0,\"col\":0,\"code\":\"E032\",\"message\":");
    let _d: u64 = wjson_str(u, outp, outn);
    let _e: u64 = wstr(u, "}\n");
    syscall4(3, u, 0, 0);
    return 1;
}

/// 第 n 个 argv (0 = 程序名) 的 (起点 << 32) | 长度。
fn cstr(dst: ptr, s: str) -> ptr {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return dst;
}

fn argv_n(buf: ptr, cap: u64, n: u32) -> u64 {
    let fd: i64 = syscall4(257, (0 as u64) - 100,
                           cstr(ptr_add(buf, 8192), "/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return 0;
    }
    let rn: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if rn <= 0 {
        return 0;
    }
    let m: u32 = rn as u32;
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    let hit: u64 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == n {
                hit = (s as u64) * PHI + ((i - s) as u64);
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    if f == n {
        hit = (s as u64) * PHI + ((m - s) as u64);
    }
    return hit;
}

fn open_ro(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 0);
}

fn open_wo(path: ptr) -> i64 {
    return syscall6(257, (0 as u64) - 100, path as u64, 577, 420, 0);
}

// ---------------------------------------------------------------- 文本小工具

/// 记号字符。**`-` 要算进来** —— LLVM IR 的立即数允许负号（`and i32 %x, -8`），
/// 而操作数的跨度就是靠这个函数量出来的。少了它，`-8` 会被量成**长度 0**：
/// 常量物化读到空串，于是**镜像发 `0`、参考发 `-8`** —— 两份链接器逐字节那条判据当场红。
/// 第一份带负立即数的 IR 是 `gc_manual` 的分配器（`and i32 %need0, -8`），
/// 在那之前这条路径**从来没有被走过**，所以它一直没露出来。
/// 只有注释里还有个 `->`，而 `lower` 对 `;` 开头的行整行返回，碰不到这里。
fn is_word(c: u32) -> u32 {
    if c >= 97 && c <= 122 {
        return 1;
    }
    if c >= 65 && c <= 90 {
        return 1;
    }
    if c >= 48 && c <= 57 {
        return 1;
    }
    if c == 95 || c == 46 || c == 64 || c == 37 || c == 45 {
        return 1;
    }
    return 0;
}

fn skip_sp(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c == 32 || c == 9 || c == 13 {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

fn word_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        if is_word(load8(t, j)) == 0 {
            go = 0;
        } else {
            j = j + 1;
        }
    }
    return j;
}

fn lit_at(t: ptr, i: u32, n: u32, lit: str) -> u32 {
    let L: u32 = str_len(lit);
    if i + L > n {
        return 0;
    }
    let k: u32 = 0;
    while k < L {
        if load8(t, i + k) != load8(str_ptr(lit), k) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

fn span_eq(t: ptr, a: u32, alen: u32, b: u32, blen: u32) -> u32 {
    if alen != blen {
        return 0;
    }
    let k: u32 = 0;
    while k < alen {
        if load8(t, a + k) != load8(t, b + k) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

fn line_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    while j < n {
        if load8(t, j) == 10 {
            return j;
        }
        j = j + 1;
    }
    return n;
}

fn balanced(t: ptr, a: u32, b: u32) -> u32 {
    let d: u32 = 0;
    let k: u32 = a;
    while k < b {
        let c: u32 = load8(t, k);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        }
        if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        }
        k = k + 1;
    }
    if d == 0 {
        return 1;
    }
    return 0;
}

/// 一条指令的结束位置: 括号不闭合就继续收下一行 (自举 codegen 的 switch 是多行的)。
fn logical_end(t: ptr, i: u32, n: u32) -> u32 {
    let e: u32 = line_end(t, i, n);
    let go: u32 = 1;
    while go == 1 {
        if balanced(t, i, e) == 1 {
            go = 0;
        } else {
            if e >= n {
                go = 0;
            } else {
                e = line_end(t, e + 1, n);
            }
        }
    }
    return e;
}

/// 去掉行尾的**元数据附着**（`, !dbg !12`）—— M59 的 `--debug` 才有（`docs/167` §7）。
///
/// 与参考实现 `lomelf.py` 的 `strip_meta` **同判**: 附着只长在**指令末尾**（`!` 开头的
/// 定义行在扫描里整行跳过, 所以 `!` 不进操作数位置）, 于是"末尾的**顶层**逗号 + 紧随一个
/// `!`"就一定是附着。引号数为**奇**时整行不动 —— 那是字符串还没合上。
///
/// **为什么非去不可**: 留着它, 实参个数就会算多（`icmp` / `store` 那几处按顶层逗号切）,
/// 而参考侧不去是 `ValueError`、自举侧不去是编出错的机器码 —— 两边错法不同, 逐字节判据
/// 也兜不住。去掉之后 `--debug` 与不带 `--debug` 的 IR 在**指令这一层**逐字节同,
/// 于是**原生产物两者字节相同**（`docs/167` §7 那句话的落地）。
fn strip_meta(t: ptr, a: u32, e: u32) -> u32 {
    // 引号没合上就别动: 行尾的 `, !x` 是字符串的内容
    let q: u32 = 0;
    let k: u32 = a;
    while k < e {
        if load8(t, k) == 34 {
            q = q + 1;
        }
        k = k + 1;
    }
    if q % 2 == 1 {
        return e;
    }
    let go: u32 = 1;
    while go == 1 {
        // 末尾空白先跳掉
        let z: u32 = e;
        let zg: u32 = 1;
        while z > a && zg == 1 {
            let cz: u32 = load8(t, z - 1);
            if cz == 32 || cz == 9 || cz == 13 {
                z = z - 1;
            } else {
                zg = 0;
            }
        }
        // 从后往前找**顶层**逗号 (括号/花括号/方括号深度为 0 的那一层)
        let j: u32 = z;
        let dep: i32 = 0;
        let cut: u32 = 0;
        let found: u32 = 0;
        let jg: u32 = 1;
        while j > a && jg == 1 {
            let cj: u32 = load8(t, j - 1);
            if cj == 41 || cj == 125 || cj == 93 {
                dep = dep + 1;
            } else {
                if cj == 40 || cj == 123 || cj == 91 {
                    dep = dep - 1;
                } else {
                    if cj == 44 && dep == 0 {
                        cut = j - 1;
                        found = 1;
                        jg = 0;
                    }
                }
            }
            j = j - 1;
        }
        if found == 0 {
            return e;
        }
        // 逗号右边第一个非空白必须是 `!` —— 不是就不是附着, 原样返回
        let nb: u32 = skip_sp(t, cut + 1, z);
        if nb < z && load8(t, nb) == 33 {
            e = cut;
        } else {
            return e;
        }
    }
    return e;
}

/// 64 位字面量 (IR 里的常量可以是 2^32 这种; u32 版会截断)。
fn num64_at(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = skip_sp(t, i, n);
    let neg: u32 = 0;
    if j < n && load8(t, j) == 45 {
        neg = 1;
        j = j + 1;
    }
    let v: u64 = 0;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c >= 48 && c <= 57 {
            v = v * 10 + ((c - 48) as u64);
            j = j + 1;
        } else {
            go = 0;
        }
    }
    if neg == 1 {
        v = (0 as u64) - v;
    }
    return v;
}

fn num_at(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = skip_sp(t, i, n);
    let neg: u32 = 0;
    if j < n && load8(t, j) == 45 {
        neg = 1;
        j = j + 1;
    }
    let v: u32 = 0;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            j = j + 1;
        } else {
            go = 0;
        }
    }
    if neg == 1 {
        v = 4294967296 - v;
    }
    return pk16(j, v);
}

// ---------------------------------------------------------------- 类型

fn type_span(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = skip_sp(t, i, n);
    let c: u32 = load8(t, j);
    if c == 123 || c == 91 {
        let open: u32 = c;
        let close: u32 = 125;
        if open == 91 {
            close = 93;
        }
        let d: u32 = 0;
        let k: u32 = j;
        let done: u32 = 0;
        while k < n && done == 0 {
            let ch: u32 = load8(t, k);
            if ch == open {
                d = d + 1;
            }
            if ch == close {
                d = d - 1;
            }
            k = k + 1;
            if d == 0 {
                done = 1;
            }
        }
        return pk16(j, k - j);
    }
    let e: u32 = word_end(t, j, n);
    return pk16(j, e - j);
}

fn scalar_size(t: ptr, off: u32, len: u32) -> u32 {
    if len == 2 && load8(t, off) == 105 {
        let c: u32 = load8(t, off + 1);
        if c == 49 || c == 56 {
            return 1;
        }
    }
    if len == 3 && load8(t, off) == 105 {
        let c2: u32 = load8(t, off + 2);
        if c2 == 54 {
            return 2;
        }
        if c2 == 50 {
            return 4;
        }
        if c2 == 52 {
            return 8;
        }
    }
    if len == 3 && load8(t, off) == 112 && load8(t, off + 2) == 114 {
        return 8;
    }
    return 0;
}

fn arr_n(t: ptr, off: u32, len: u32) -> u32 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let v: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let c: u32 = load8(t, i);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            i = i + 1;
        } else {
            go = 0;
        }
    }
    return v;
}

fn arr_elem(t: ptr, off: u32, len: u32) -> u64 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let go: u32 = 1;
    while i < end && go == 1 {
        if load8(t, i) == 120 {
            go = 0;
        } else {
            i = i + 1;
        }
    }
    return type_span(t, i + 1, end);
}

/// 代码/数据在**表里**用什么基址：ELF 用绝对 vaddr，PE 用 RVA。
/// PE 的 0x140000000 装不进 u32，所以只在真要落 8 字节绝对地址的地方才加回去。
fn txt_base(tab: ptr) -> u32 {
    if cell(tab, C_PE) == 1 {
        return PE_TEXT_RVA;
    }
    return TEXT_VADDR;
}

fn data_base(tab: ptr) -> u32 {
    if cell(tab, C_PE) == 1 {
        return PE_DATA_RVA;
    }
    return DATA_VADDR;
}

fn align_to(v: u32, a: u32) -> u32 {
    if a == 0 {
        return v;
    }
    let r: u32 = v % a;
    if r == 0 {
        return v;
    }
    return v + (a - r);
}

// ---------------------------------------------------------------- hex blob

fn hexval(ch: u32) -> u32 {
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48;
        }
    }
    return ch - 87;                 // 'a'..'f'
}

/// 把 hex 串解成字节写进缓冲；返回新的游标。
/// win_shim_data 里那两段数据（shim 机器码、导入表）都与布局无关，所以在 Loment 源码里
/// 以 hex 字面量形式带着走 —— 镜像是独立二进制，不该在运行时去读仓库里的文件。
fn blob_copy(out: ptr, c: u32, hx: str) -> u32 {
    let n: u32 = str_len(hx) / 2;
    let d: u32 = c;
    let i: u32 = 0;
    while i < n {
        let hi: u32 = hexval(str_byte(hx, i * 2) as u32);
        let lo: u32 = hexval(str_byte(hx, i * 2 + 1) as u32);
        let b: u32 = hi * 16 + lo;
        store8(out, d, b as u8);
        d = d + 1;
        i = i + 1;
    }
    return d;
}

fn ty_size(t: ptr, off: u32, len: u32) -> u32 {
    let c: u32 = load8(t, off);
    if c == 123 {
        let i: u32 = off + 1;
        let end: u32 = off + len - 1;
        let sz: u32 = 0;
        let go: u32 = 1;
        while i < end && go == 1 {
            let j: u32 = skip_sp(t, i, end);
            if j >= end {
                go = 0;
            } else {
                if load8(t, j) == 44 {
                    j = j + 1;
                }
                let fs: u64 = type_span(t, j, end);
                let fo: u32 = hi32(fs);
                let fl: u32 = lo32(fs);
                sz = align_to(sz, ty_size(t, fo, fl)) + ty_size(t, fo, fl);
                i = fo + fl;
            }
        }
        return sz;
    }
    if c == 91 {
        let es: u64 = arr_elem(t, off, len);
        return arr_n(t, off, len) * ty_size(t, hi32(es), lo32(es));
    }
    return scalar_size(t, off, len);
}

fn field_off(t: ptr, off: u32, len: u32, idx: u32) -> u32 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let sz: u32 = 0;
    let k: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let j: u32 = skip_sp(t, i, end);
        if j >= end {
            return NO;
        }
        if load8(t, j) == 44 {
            j = j + 1;
        }
        let fs: u64 = type_span(t, j, end);
        let fo: u32 = hi32(fs);
        let fl: u32 = lo32(fs);
        let fsz: u32 = ty_size(t, fo, fl);
        let aoff: u32 = align_to(sz, fsz);
        if k == idx {
            return aoff;
        }
        sz = aoff + fsz;
        k = k + 1;
        i = fo + fl;
    }
    return NO;
}

fn field_ty(t: ptr, off: u32, len: u32, idx: u32) -> u64 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let k: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let j: u32 = skip_sp(t, i, end);
        if j >= end {
            return pk16(NO, NO);
        }
        if load8(t, j) == 44 {
            j = j + 1;
        }
        let fs: u64 = type_span(t, j, end);
        if k == idx {
            return fs;
        }
        k = k + 1;
        i = hi32(fs) + lo32(fs);
    }
    return pk16(NO, NO);
}

fn is_agg(t: ptr, off: u32, len: u32) -> u32 {
    let c: u32 = load8(t, off);
    if c == 123 || c == 91 {
        return 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 表

fn cell(tab: ptr, off: u32) -> u32 {
    return load32(tab, off);
}

fn setcell(tab: ptr, off: u32, v: u32) {
    store32(tab, off, v);
}

fn lbl_add(tab: ptr, noff: u32, nlen: u32, boff: u32, blen: u32, addr: u32) {
    let k: u32 = cell(tab, C_NLBL);
    // 表满 = **响亮地退出**, 不是往下写。这几张表都是**单调 bump**, 一旦越过自己的容量
    // 就踩进下一张表 —— 症状离现场很远（2026-09-20 实测: 全局表越界 38 条, 报出来的是
    // "未定义的标签: "，空白名字, 因为标签表被写坏了)。与 `IN_CAP` 那条守卫同一个纪律。
    if k >= TB_LBL_MAX {
        let _f: u32 = fail("the label table is full -- raise TB_LBL_MAX in loment/tools/lomelf.lomt");
    }
    let base: u32 = TB_LBL + k * 24;
    store32(tab, base + L_NOFF, noff);
    store32(tab, base + L_NLEN, nlen);
    store32(tab, base + L_ADDR, addr);
    store32(tab, base + L_BOFF, boff);
    store32(tab, base + L_BLEN, blen);
    setcell(tab, C_NLBL, k + 1);
}

fn lbl_find(tab: ptr, t: ptr, noff: u32, nlen: u32, boff: u32, blen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NLBL);
    while k < n {
        let base: u32 = TB_LBL + k * 24;
        if span_eq(t, load32(tab, base + L_NOFF), load32(tab, base + L_NLEN), noff, nlen) == 1
            && span_eq(t, load32(tab, base + L_BOFF), load32(tab, base + L_BLEN), boff, blen) == 1 {
            return load32(tab, base + L_ADDR);
        }
        k = k + 1;
    }
    return NO;
}

fn fix_add(tab: ptr, site: u32, kind: u32, noff: u32, nlen: u32, boff: u32, blen: u32) {
    let k: u32 = cell(tab, C_NFIX);
    if k >= TB_FIX_MAX {
        let _f: u32 = fail("the backfill table is full -- raise TB_FIX_MAX in loment/tools/lomelf.lomt");
    }
    let base: u32 = TB_FIX + k * 28;
    store32(tab, base + F_SITE, site);
    store32(tab, base + F_KIND, kind);
    store32(tab, base + F_NOFF, noff);
    store32(tab, base + F_NLEN, nlen);
    store32(tab, base + F_BOFF, boff);
    store32(tab, base + F_BLEN, blen);
    setcell(tab, C_NFIX, k + 1);
}

fn slot_find(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NSLOT);
    while k < n {
        let base: u32 = TB_SLOT + k * 16;
        if span_eq(t, load32(tab, base + S_NOFF), load32(tab, base + S_NLEN), noff, nlen) == 1 {
            return load32(tab, base + S_OFF);
        }
        k = k + 1;
    }
    return NO;
}

fn slot_has(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    if slot_find(tab, t, noff, nlen) == NO {
        return 0;
    }
    return 1;
}

fn slot_put(tab: ptr, noff: u32, nlen: u32, off: u32) {
    let k: u32 = cell(tab, C_NSLOT);
    if k >= TB_SLOT_MAX {
        let _f: u32 = fail("the slot table is full -- raise TB_SLOT_MAX in loment/tools/lomelf.lomt");
    }
    let base: u32 = TB_SLOT + k * 16;
    store32(tab, base + S_NOFF, noff);
    store32(tab, base + S_NLEN, nlen);
    store32(tab, base + S_OFF, off);
    setcell(tab, C_NSLOT, k + 1);
}

fn alloc_find(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NALLOC);
    while k < n {
        let base: u32 = TB_ALLOC + k * 16;
        if span_eq(t, load32(tab, base + A_NOFF), load32(tab, base + A_NLEN), noff, nlen) == 1 {
            return load32(tab, base + A_OFF);
        }
        k = k + 1;
    }
    return NO;
}

fn alloc_put(tab: ptr, noff: u32, nlen: u32, off: u32, size: u32) {
    let k: u32 = cell(tab, C_NALLOC);
    if k >= TB_ALLOC_MAX {
        let _f: u32 = fail("the alloca table is full (one function) -- raise TB_ALLOC_MAX in loment/tools/lomelf.lomt");
    }
    let base: u32 = TB_ALLOC + k * 16;
    store32(tab, base + A_NOFF, noff);
    store32(tab, base + A_NLEN, nlen);
    store32(tab, base + A_OFF, off);
    store32(tab, base + A_SIZE, size);
    setcell(tab, C_NALLOC, k + 1);
}

// ---------------------------------------------------------------- x86-64 编码
// 所有发射函数把"代码缓冲游标"作为参数收下并返回新游标 (Loment 没有可变全局)。

fn e1(out: ptr, c: u32, b: u32) -> u32 {
    store8(out, c, b as u8);
    return c + 1;
}

fn e4(out: ptr, c: u32, v: u32) -> u32 {
    let d: u32 = e1(out, c, v % 256);
    d = e1(out, d, (v / 256) % 256);
    d = e1(out, d, (v / 65536) % 256);
    return e1(out, d, (v / 16777216) % 256);
}

fn e8(out: ptr, c: u32, v: u64) -> u32 {
    let d: u32 = c;
    let x: u64 = v;
    let i: u32 = 0;
    while i < 8 {
        d = e1(out, d, (x % 256) as u32);
        x = x / 256;
        i = i + 1;
    }
    return d;
}

fn rex(w: u32, r: u32, x: u32, b: u32) -> u32 {
    let v: u32 = 64 + w * 8 + (r / 8) * 4 + (x / 8) * 2 + (b / 8);
    if v == 64 {
        return 0;
    }
    return v;
}

fn em_rex(out: ptr, c: u32, v: u32) -> u32 {
    if v == 0 {
        return c;
    }
    return e1(out, c, v);
}

fn em_mem(out: ptr, c: u32, reg_field: u32, base: u32, disp: u32) -> u32 {
    let d: u32 = e1(out, c, 128 + (reg_field % 8) * 8 + (base % 8));
    if base % 8 == 4 {
        d = e1(out, d, 36);
    }
    return e4(out, d, disp);
}

fn em_modrm3(out: ptr, c: u32, reg: u32, rm: u32) -> u32 {
    return e1(out, c, 192 + (reg % 8) * 8 + (rm % 8));
}

fn em_mov_rr(out: ptr, c: u32, dst: u32, src: u32, w: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(w, src, 0, dst));
    d = e1(out, d, 137);
    return em_modrm3(out, d, src, dst);
}

fn em_mov_ri64(out: ptr, c: u32, dst: u32, imm: u64) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, dst));
    d = e1(out, d, 184 + dst % 8);
    return e8(out, d, imm);
}

fn em_mov_ri32(out: ptr, c: u32, dst: u32, imm: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, dst));
    d = e1(out, d, 184 + dst % 8);
    return e4(out, d, imm);
}

fn em_mov_rm(out: ptr, c: u32, dst: u32, base: u32, disp: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, dst, 0, base));
    d = e1(out, d, 139);
    return em_mem(out, d, dst, base, disp);
}

fn em_mov_mr(out: ptr, c: u32, base: u32, disp: u32, src: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, src, 0, base));
    d = e1(out, d, 137);
    return em_mem(out, d, src, base, disp);
}

fn em_lea(out: ptr, c: u32, dst: u32, base: u32, disp: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, dst, 0, base));
    d = e1(out, d, 141);
    return em_mem(out, d, dst, base, disp);
}

fn em_alu_rr(out: ptr, c: u32, op: u32, dst: u32, src: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, src, 0, dst));
    d = e1(out, d, op);
    return em_modrm3(out, d, src, dst);
}

fn em_alu_ri(out: ptr, c: u32, digit: u32, dst: u32, imm: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, dst));
    d = e1(out, d, 129);
    d = em_modrm3(out, d, digit, dst);
    return e4(out, d, imm);
}

fn em_imul_rr(out: ptr, c: u32, dst: u32, src: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, dst, 0, src));
    d = e1(out, d, 15);
    d = e1(out, d, 175);
    return em_modrm3(out, d, dst, src);
}

/// 发一条 jcc, 立即数留空; 返回立即数的偏移 (调用方自己回填相对距离)。
fn em_jcc_raw(out: ptr, c: u32, cond: u32) -> u32 {
    let d: u32 = e1(out, c, 15);
    d = e1(out, d, 128 + cond);
    let at: u32 = d;
    d = e4(out, d, 0);
    return at;
}

fn em_push(out: ptr, c: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, reg));
    return e1(out, d, 80 + reg % 8);
}

fn em_pop(out: ptr, c: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, reg));
    return e1(out, d, 88 + reg % 8);
}

fn em_load_sized(out: ptr, c: u32, reg: u32, base: u32, disp: u32, size: u32) -> u32 {
    if size == 8 {
        return em_mov_rm(out, c, reg, base, disp);
    }
    let d: u32 = em_rex(out, c, rex(0, reg, 0, base));
    if size == 4 {
        d = e1(out, d, 139);
        return em_mem(out, d, reg, base, disp);
    }
    d = e1(out, d, 15);
    if size == 1 {
        d = e1(out, d, 182);
    } else {
        d = e1(out, d, 183);
    }
    return em_mem(out, d, reg, base, disp);
}

fn em_store_sized(out: ptr, c: u32, base: u32, disp: u32, src: u32, size: u32) -> u32 {
    if size == 8 {
        return em_mov_mr(out, c, base, disp, src);
    }
    let d: u32 = c;
    if size == 2 {
        d = e1(out, d, 102);
    }
    d = em_rex(out, d, rex(0, src, 0, base));
    if size == 1 {
        d = e1(out, d, 136);
    } else {
        d = e1(out, d, 137);
    }
    return em_mem(out, d, src, base, disp);
}

fn em_zext64(out: ptr, c: u32, reg: u32, size: u32) -> u32 {
    if size >= 8 {
        return c;
    }
    if size == 4 {
        return em_mov_rr(out, c, reg, reg, 0);
    }
    let d: u32 = em_rex(out, c, rex(0, reg, 0, reg));
    d = e1(out, d, 15);
    if size == 2 {
        d = e1(out, d, 183);
    } else {
        d = e1(out, d, 182);
    }
    return em_modrm3(out, d, reg, reg);
}

fn em_sext64(out: ptr, c: u32, reg: u32, size: u32) -> u32 {
    if size >= 8 {
        return c;
    }
    let d: u32 = em_rex(out, c, rex(1, reg, 0, reg));
    if size == 4 {
        d = e1(out, d, 99);
        return em_modrm3(out, d, reg, reg);
    }
    d = e1(out, d, 15);
    if size == 2 {
        d = e1(out, d, 191);
    } else {
        d = e1(out, d, 190);
    }
    return em_modrm3(out, d, reg, reg);
}

fn em_copy(out: ptr, c: u32, dst: u32, src: u32, n: u32) -> u32 {
    let d: u32 = em_mov_rr(out, c, RDI, dst, 1);
    d = em_mov_rr(out, d, RSI, src, 1);
    d = em_mov_ri64(out, d, RCX, n as u64);
    d = e1(out, d, 243);
    return e1(out, d, 164);
}

fn em_call_lbl(out: ptr, c: u32, tab: ptr, noff: u32, nlen: u32) -> u32 {
    let d: u32 = e1(out, c, 232);
    fix_add(tab, d, 0, noff, nlen, 0, 0);
    return e4(out, d, 0);
}

/// 跳到基本块 (名字 = 函数名 + 块名)。
fn em_jmp_blk(out: ptr, c: u32, tab: ptr, fo: u32, fl: u32, bo: u32, bl: u32) -> u32 {
    let d: u32 = e1(out, c, 233);
    fix_add(tab, d, 0, fo, fl, bo, bl);
    return e4(out, d, 0);
}

fn em_jcc_blk(out: ptr, c: u32, cond: u32, tab: ptr, fo: u32, fl: u32,
              bo: u32, bl: u32) -> u32 {
    let d: u32 = e1(out, c, 15);
    d = e1(out, d, 128 + cond);
    fix_add(tab, d, 0, fo, fl, bo, bl);
    return e4(out, d, 0);
}

fn em_mov_abs(out: ptr, c: u32, tab: ptr, reg: u32, noff: u32, nlen: u32) -> u32 {
    let d: u32 = em_mov_ri64(out, c, reg, 0);
    fix_add(tab, d - 8, 1, noff, nlen, 0, 0);
    return d;
}

// ---------------------------------------------------------------- 取值 / 存值

fn emit_get(tab: ptr, out: ptr, c: u32, t: ptr, tyo: u32, tyl: u32,
            vo: u32, vl: u32, reg: u32) -> u32 {
    let sz: u32 = ty_size(t, tyo, tyl);
    let c0: u32 = load8(t, vo);
    let d: u32 = c;
    if c0 == 37 {
        // **alloca 的"值"就是它的地址** —— `store ptr %p.buf, ptr %p.addr`（L0 提升出来的
        // 产物就是这一条）。`emit_get_ptr` 一直在查 `alloc_find`，这一格漏了 —— 于是那份
        // 产物在参考侧报"未定义的 SSA 值"，在这儿**静默**按槽表查空（FujoJTOP/loment#239）。
        // 走这条**不落 zext**（与参考侧同形，否则两边 ELF 不逐字节同）。
        let ao: u32 = alloc_find(tab, t, vo, vl);
        if ao != NO {
            return em_lea(out, c, reg, RBP, ao);
        }
        let so: u32 = slot_find(tab, t, vo, vl);
        d = em_load_sized(out, d, reg, RBP, so, sz);
    } else {
        if c0 == 64 {
            d = em_mov_abs(out, d, tab, reg, vo, vl);
            if sz != 8 {
                d = em_load_sized(out, d, reg, reg, 0, sz);
            }
        } else {
            if c0 == 116 {
                d = em_mov_ri32(out, d, reg, 1);
            } else {
                if c0 == 102 || c0 == 110 || c0 == 117 {
                    d = em_mov_ri32(out, d, reg, 0);
                } else {
                    let nv: u64 = num64_at(t, vo, vo + vl);
                    d = em_mov_ri64(out, d, reg, nv);
                }
            }
        }
    }
    return em_zext64(out, d, reg, sz);
}

fn emit_get_signed(tab: ptr, out: ptr, c: u32, t: ptr, tyo: u32, tyl: u32,
                   vo: u32, vl: u32, reg: u32) -> u32 {
    let d: u32 = emit_get(tab, out, c, t, tyo, tyl, vo, vl, reg);
    return em_sext64(out, d, reg, ty_size(t, tyo, tyl));
}

fn emit_get_ptr(tab: ptr, out: ptr, c: u32, t: ptr, vo: u32, vl: u32, reg: u32) -> u32 {
    let so: u32 = alloc_find(tab, t, vo, vl);
    if so != NO {
        return em_lea(out, c, reg, RBP, so);
    }
    let s2: u32 = slot_find(tab, t, vo, vl);
    if s2 != NO {
        return em_mov_rm(out, c, reg, RBP, s2);
    }
    if load8(t, vo) == 64 {
        return em_mov_abs(out, c, tab, reg, vo, vl);
    }
    wstr(2, "loment: this pointer value cannot be resolved: ");
    write_all(2, ptr_add(t, vo), vl as u64);
    wstr(2, " @fn=");
    write_all(2, ptr_add(t, cell(tab, C_FNO)), cell(tab, C_FNL) as u64);
    wstr(2, " nalloc=");
    wdec(2, ptr_add(t, IN_CAP - 64), cell(tab, C_NALLOC));
    wstr(2, " nslot=");
    wdec(2, ptr_add(t, IN_CAP - 64), cell(tab, C_NSLOT));
    wstr(2, "
");
    return die(1);
}

fn emit_agg_addr(tab: ptr, out: ptr, c: u32, t: ptr, vo: u32, vl: u32, reg: u32) -> u32 {
    let so: u32 = alloc_find(tab, t, vo, vl);
    if so != NO {
        return em_lea(out, c, reg, RBP, so);
    }
    let s2: u32 = slot_find(tab, t, vo, vl);
    if s2 != NO {
        return em_lea(out, c, reg, RBP, s2);
    }
    if load8(t, vo) == 64 {
        return em_mov_abs(out, c, tab, reg, vo, vl);
    }
    return c;
}

fn emit_put(tab: ptr, out: ptr, c: u32, t: ptr, doff: u32, dlen: u32, reg: u32) -> u32 {
    let so: u32 = slot_find(tab, t, doff, dlen);
    return em_mov_mr(out, c, RBP, so, reg);
}

/// 解析 `类型 值` 直接写进调用者给的记录 (tyo/tyl/vo/vl); 返回其后游标。
fn opnd_rec(tab: ptr, t: ptr, i: u32, n: u32, rec: u32) -> u32 {
    let ts: u64 = type_span(t, i, n);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let j: u32 = skip_sp(t, to + tl, n);
    store32(tab, rec, to);
    store32(tab, rec + 4, tl);
    store32(tab, rec + 8, j);
    let ve: u32 = word_end(t, j, n);
    store32(tab, rec + 12, ve - j);
    return ve;
}

/// 解析 `类型 值` 进格; 返回其后游标。
fn opnd(tab: ptr, t: ptr, i: u32, n: u32) -> u32 {
    let ts: u64 = type_span(t, i, n);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let j: u32 = skip_sp(t, to + tl, n);
    let ve: u32 = word_end(t, j, n);
    store32(tab, C_TYOFF, to);
    store32(tab, C_TYLEN, tl);
    store32(tab, C_VLOFF, j);
    store32(tab, C_VLLEN, ve - j);
    return ve;
}

fn skip_comma(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = skip_sp(t, i, n);
    if j < n && load8(t, j) == 44 {
        j = skip_sp(t, j + 1, n);
    }
    return j;
}

// ---------------------------------------------------------------- 结果尺寸

fn size_after_to(t: ptr, i: u32, n: u32) -> u32 {
    let le: u32 = line_end(t, i, n);
    let j: u32 = i;
    let found: u32 = 0;
    while j < le && found == 0 {
        if lit_at(t, j, le, " to ") == 1 {
            found = 1;
        } else {
            j = j + 1;
        }
    }
    if found == 0 {
        return 0;
    }
    let ts: u64 = type_span(t, j + 4, le);
    return ty_size(t, hi32(ts), lo32(ts));
}

fn result_size(t: ptr, i: u32, n: u32) -> u32 {
    if lit_at(t, i, n, "alloca ") == 1 {
        return 8;
    }
    if lit_at(t, i, n, "load ") == 1 {
        let ts: u64 = type_span(t, i + 5, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "getelementptr") == 1 {
        return 8;
    }
    if lit_at(t, i, n, "extractvalue ") == 1 {
        let ts: u64 = type_span(t, i + 13, n);
        let fo: u32 = hi32(ts);
        let fl: u32 = lo32(ts);
        let k: u32 = skip_comma(t, fo + fl, n);
        let nx: u64 = num_at(t, k, n);
        let fts: u64 = field_ty(t, fo, fl, lo32(nx));
        return ty_size(t, hi32(fts), lo32(fts));
    }
    if lit_at(t, i, n, "insertvalue ") == 1 {
        let ts: u64 = type_span(t, i + 12, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "call ") == 1 {
        let j: u32 = skip_sp(t, i + 5, n);
        if lit_at(t, j, n, "void") == 1 {
            return 0;
        }
        let ts: u64 = type_span(t, j, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "trunc ") == 1 || lit_at(t, i, n, "zext ") == 1
        || lit_at(t, i, n, "sext ") == 1 || lit_at(t, i, n, "ptrtoint ") == 1
        || lit_at(t, i, n, "inttoptr ") == 1 {
        return size_after_to(t, i, n);
    }
    if lit_at(t, i, n, "icmp ") == 1 {
        return 1;
    }
    if lit_at(t, i, n, "phi ") == 1 {
        let ts: u64 = type_span(t, i + 4, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if lit_at(t, i, n, "atomicrmw ") == 1 {
        let j: u32 = skip_sp(t, i + 10, n);
        let j2: u32 = skip_sp(t, word_end(t, j, n), n);
        let ts: u64 = type_span(t, j2, n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    if binop_ty(t, i, n, "add") == 1 || binop_ty(t, i, n, "sub") == 1
        || binop_ty(t, i, n, "mul") == 1 || binop_ty(t, i, n, "and") == 1
        || binop_ty(t, i, n, "or") == 1 || binop_ty(t, i, n, "xor") == 1
        || binop_ty(t, i, n, "sdiv") == 1 || binop_ty(t, i, n, "udiv") == 1
        || binop_ty(t, i, n, "srem") == 1 || binop_ty(t, i, n, "urem") == 1
        || binop_ty(t, i, n, "shl") == 1 || binop_ty(t, i, n, "lshr") == 1
        || binop_ty(t, i, n, "ashr") == 1 {
        let ts: u64 = type_span(t, binop_ty_at(t, i, n), n);
        return ty_size(t, hi32(ts), lo32(ts));
    }
    return 0;
}

/// 二元运算名的长度 (用于跳到类型); 不匹配返回 0。
fn binop_ty_at(t: ptr, i: u32, n: u32) -> u32 {
    if binop_ty(t, i, n, "add") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "sub") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "mul") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "and") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "xor") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "sdiv") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "udiv") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "srem") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "urem") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "shl") == 1 {
        return i + 4;
    }
    if binop_ty(t, i, n, "lshr") == 1 {
        return i + 5;
    }
    if binop_ty(t, i, n, "ashr") == 1 {
        return i + 5;
    }
    return i + 3;
}

/// 匹配 "op " 前缀且后面不是别的单词字符。
fn binop_ty(t: ptr, i: u32, n: u32, op: str) -> u32 {
    let L: u32 = str_len(op);
    if i + L >= n {
        return 0;
    }
    if lit_at(t, i, n, op) == 0 {
        return 0;
    }
    if load8(t, i + L) != 32 {
        return 0;
    }
    return 1;
}

// ---------------------------------------------------------------- 全局收集

/// 从 `i` 起跳过**含换行**的空白。
///
/// `skip_sp` 只吃空格/制表/回车 —— 它按行工作。跨行的东西（自举 codegen 的 `switch`
/// 就是多行的）里必须用这一个, 否则指针停在 `\n` 上不动。
fn ws_after(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c == 32 || c == 9 || c == 13 || c == 10 {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

/// 跳过空白（含换行）-> 吃掉一个逗号 -> 再跳过空白（含换行）。
fn ws_after_comma(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = ws_after(t, i, n);
    if j < n && load8(t, j) == 44 {
        j = ws_after(t, j + 1, n);
    }
    return j;
}

/// `[a, e)` 去掉尾随空白（含换行）之后的末端。
fn trim_end(t: ptr, a: u32, e: u32) -> u32 {
    let z: u32 = e;
    let go: u32 = 1;
    while z > a && go == 1 {
        let c: u32 = load8(t, z - 1);
        if c == 32 || c == 9 || c == 13 || c == 10 {
            z = z - 1;
        } else {
            go = 0;
        }
    }
    return z;
}

/// `[i, e)` 里**顶层**（`{`/`[`/`(` 深度 0）那个逗号的位置; 没有就到 `e`。
/// 用来把一个聚合初值切成一项一项。
fn item_end(t: ptr, i: u32, e: u32) -> u32 {
    let d: i32 = 0;
    let k: u32 = i;
    let stop: u32 = 0;
    while k < e && stop == 0 {
        let c: u32 = load8(t, k);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        }
        if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        }
        if c == 44 && d == 0 {
            stop = 1;
        } else {
            k = k + 1;
        }
    }
    return k;
}

/// 十进制整数, 按 **64 位**累计。
///
/// `num_at` 用不了: 它的累加器是 u32, 值 ≥ 2^32 会被静默截断, 而全局初值里有
/// `4294967296` 这种（issue #102 那张表）。负数按 2^64 取补, 与参考实现的 `n & mask` 同。
fn num64(t: ptr, i: u32, n: u32) -> u64 {
    let j: u32 = ws_after(t, i, n);
    let neg: u32 = 0;
    if j < n && load8(t, j) == 45 {
        neg = 1;
        j = j + 1;
    }
    let v: u64 = 0;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(t, j);
        if c >= 48 && c <= 57 {
            v = v * 10 + ((c - 48) as u64);
            j = j + 1;
        } else {
            go = 0;
        }
    }
    if neg == 1 {
        return 0 - v;
    }
    return v;
}

/// 从 `a` 起写零到 `e`（不含）。
fn zero_fill(gb: ptr, a: u32, e: u32) {
    let k: u32 = a;
    while k < e {
        store8(gb, k, 0);
        k = k + 1;
    }
}

/// 结构体第 `idx` 个字段的**类型文本**跨度; 越界返回 `pk16(NO, 0)`。
/// 与 `field_off` 同一次遍历, 只是一个要字节偏移、一个要类型文本。
fn field_span(t: ptr, off: u32, len: u32, idx: u32) -> u64 {
    let i: u32 = off + 1;
    let end: u32 = off + len - 1;
    let k: u32 = 0;
    let go: u32 = 1;
    while i < end && go == 1 {
        let j: u32 = skip_sp(t, i, end);
        if j >= end {
            go = 0;
        } else {
            if load8(t, j) == 44 {
                j = j + 1;
            }
            let fs: u64 = type_span(t, j, end);
            if k == idx {
                return fs;
            }
            k = k + 1;
            i = hi32(fs) + lo32(fs);
        }
    }
    return pk16(NO, 0);
}

/// 按**类型**把全局初值文本写成字节, 返回写出的字节数。
///
/// 与参考实现 `tools/lomelf.py` 的 `_parse_init` **同判** —— 两边产物必须逐字节同,
/// 判据是 `loment_elf_test.py` 那条镜像对拍。
///
/// 为什么不是原来那种"取一个数、按类型宽度铺开"（issue #102）:
///   1. 它用 `pow256(b)` 做除法, 而 `pow256` 是 u32 —— 宽度 ≥ 5 时 `256^b` 回绕成 0,
///      `v / 0` 当场 trap（SIGILL）。元素类型 64 位的全局正好走这条, 而能力域表
///      `@__loment_caps` 就是那个形状: 于是**凡是用能力域的程序都链不出来**。
///   2. 它**不认聚合初值**: 数组/结构体只拿到 `num_at` 在 `[` 上读出的 0, 也就是错编译。
fn emit_init(t: ptr, gb: ptr, at: u32, tyo: u32, tyl: u32, io: u32, il: u32) -> u32 {
    let end: u32 = io + il;
    let sz: u32 = ty_size(t, tyo, tyl);
    let p: u32 = io;
    if io < end {
        p = ws_after(t, io, end);
    }
    // ---- `c"..."`
    if p + 1 < end && load8(t, p) == 99 && load8(t, p + 1) == 34 {
        let o1: u32 = at;
        let q1: u32 = p + 2;
        while q1 < end && load8(t, q1) != 34 {
            if load8(t, q1) == 92 {
                store8(gb, o1, (hexv(load8(t, q1 + 1)) * 16 + hexv(load8(t, q1 + 2))) as u8);
                o1 = o1 + 1;
                q1 = q1 + 3;
            } else {
                store8(gb, o1, load8(t, q1) as u8);
                o1 = o1 + 1;
                q1 = q1 + 1;
            }
        }
        return o1 - at;
    }
    // ---- 全零（或压根没写初值 —— `@x = external global i32` 这种声明）
    if io >= end || lit_at(t, p, end, "zeroinitializer") == 1 {
        zero_fill(gb, at, at + sz);
        return sz;
    }
    // ---- 值文本: 剥掉可能带的类型前缀
    let v: u32 = p;
    if span_eq(t, tyo, tyl, v, tyl) == 1 {
        v = ws_after(t, v + tyl, end);
    }
    let tyc: u32 = load8(t, tyo);
    if tyc == 91 {
        // 数组 `[a, b, c]` —— 每一项自己带类型
        if v >= end || load8(t, v) != 91 {
            let _f: u32 = fail("数组初值不以 `[` 开头 —— 自举镜像链接器链不了这份 IR");
        }
        let last: u32 = trim_end(t, v + 1, end) - 1;
        let it: u32 = v + 1;
        let o2: u32 = at;
        while it < last {
            let ie: u32 = item_end(t, it, last);
            let es: u64 = type_span(t, it, ie);
            let eo: u32 = hi32(es);
            let el: u32 = lo32(es);
            o2 = o2 + emit_init(t, gb, o2, eo, el, eo + el, ie - (eo + el));
            if ie < last {
                it = ws_after(t, ie + 1, last);
            } else {
                it = last;
            }
        }
        if o2 - at != sz {
            let _f: u32 = fail("数组初值长度与类型不符 —— 自举镜像链接器链不了这份 IR");
        }
        return sz;
    }
    if tyc == 123 {
        // 结构体 `{a, b}`。字段类型**以 ty 为准**（`_fields` 那一侧的判据）; 值文本自带
        // 类型前缀时以它为准 —— 与参考实现同一句 `rest` 判断。
        if v >= end || load8(t, v) != 123 {
            let _f: u32 = fail("结构体初值不以 `{` 开头 —— 自举镜像链接器链不了这份 IR");
        }
        let last2: u32 = trim_end(t, v + 1, end) - 1;
        let it2: u32 = v + 1;
        let fi: u32 = 0;
        let o3: u32 = at;
        while it2 < last2 {
            let ie2: u32 = item_end(t, it2, last2);
            let foff: u32 = field_off(t, tyo, tyl, fi);
            let fs: u64 = field_span(t, tyo, tyl, fi);
            if foff == NO || hi32(fs) == NO {
                let _f: u32 = fail("结构体初值字段数超过类型 —— 自举镜像链接器链不了这份 IR");
            }
            while o3 < at + foff {
                store8(gb, o3, 0);        // 字段间的对齐空洞 LLVM 不写, 自己补
                o3 = o3 + 1;
            }
            let ip: u32 = ws_after(t, it2, ie2);
            let vt: u64 = type_span(t, ip, ie2);
            let vo: u32 = hi32(vt);
            let vl: u32 = lo32(vt);
            let rest: u32 = ws_after(t, vo + vl, ie2);
            if rest < ie2 {
                o3 = o3 + emit_init(t, gb, o3, vo, vl, rest, ie2 - rest);
            } else {
                o3 = o3 + emit_init(t, gb, o3, hi32(fs), lo32(fs), it2, ie2 - it2);
            }
            fi = fi + 1;
            if ie2 < last2 {
                it2 = ws_after(t, ie2 + 1, last2);
            } else {
                it2 = last2;
            }
        }
        zero_fill(gb, o3, at + sz);        // 尾随填充
        return sz;
    }
    // ---- 标量
    if sz == 0 {
        let _f: u32 = fail("标量初值遇上了不认识的类型 —— 自举镜像链接器链不了这份 IR");
    }
    // 只吃 `-?[0-9]+`, 与参考实现同。别的一律**点名拒** —— `null` / `true` / `undef`
    // 这类在这个子集里没有值可言, 静默按 0 写就是错编译（"报错, 不要错编译"）。
    let d0: u32 = v;
    if d0 < end && load8(t, d0) == 45 {
        d0 = d0 + 1;
    }
    let ndig: u32 = 0;
    while d0 < end && load8(t, d0) >= 48 && load8(t, d0) <= 57 {
        d0 = d0 + 1;
        ndig = ndig + 1;
    }
    if ndig == 0 || ws_after(t, d0, end) < end {
        let _f: u32 = fail("标量初值不是十进制整数 —— 自举镜像链接器链不了这份 IR");
    }
    let nv: u64 = num64(t, v, end);
    let lo: u32 = lo32(nv);
    let hi: u32 = hi32(nv);
    let b: u32 = 0;
    while b < sz {
        let byte: u32 = 0;
        if b < 4 {
            byte = (lo / pow256(b)) % 256;
        } else {
            byte = (hi / pow256(b - 4)) % 256;
        }
        store8(gb, at + b, byte as u8);
        b = b + 1;
    }
    return sz;
}

/// 收集一个全局声明 (行 [ls,le)); 返回其数据字节数, 并把数据写进 gb。
fn one_global(tab: ptr, t: ptr, gb: ptr, ls: u32, le: u32) -> u32 {
    let noff: u32 = ls;                       // 含前导 '@' —— 与参考实现的 g.name 同名
    let nlen: u32 = word_end(t, noff, le) - noff;
    let i: u32 = skip_sp(t, word_end(t, noff, le), le);
    // 跳过 '='
    let j: u32 = skip_sp(t, i + 1, le);
    // 跳过限定词
    let go: u32 = 1;
    while go == 1 {
        let we: u32 = word_end(t, j, le);
        if lit_at(t, j, we, "private") == 1 || lit_at(t, j, we, "internal") == 1
            || lit_at(t, j, we, "external") == 1 || lit_at(t, j, we, "unnamed_addr") == 1
            || lit_at(t, j, we, "dso_local") == 1 || lit_at(t, j, we, "constant") == 1
            || lit_at(t, j, we, "global") == 1 || lit_at(t, j, we, "common") == 1 {
            j = skip_sp(t, we, le);
        } else {
            go = 0;
        }
    }
    let ts: u64 = type_span(t, j, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let tysz: u32 = ty_size(t, to, tl);
    let k: u32 = skip_sp(t, to + tl, le);
    let doff: u32 = align_to(cell(tab, C_GB), 8);
    let zero: u32 = 0;
    let sz: u32 = emit_init(t, gb, doff, to, tl, k, le - k);
    // 全零 -> bss。与参考实现同判: 判据是**内容长度 + 内容**, 不是 `zeroinitializer`
    // 关键字（`if g.data != b"\0" * size_of(g.ty)`）—— 长度不等于类型大小的一律进 data,
    // 例如 `c"..."` 比它那个数组类型短的时候。
    let nz: u32 = 0;
    if sz != tysz {
        nz = 1;
    }
    let q: u32 = 0;
    while q < sz {
        if load8(gb, doff + q) != 0 {
            nz = 1;
        }
        q = q + 1;
    }
    if nz == 0 {
        zero = 1;
    } else {
        setcell(tab, C_GB, doff + sz);
    }
    let gi: u32 = cell(tab, C_NG);
    if gi >= TB_G_MAX {
        let _f: u32 = fail("the global table is full -- raise TB_G_MAX in loment/tools/lomelf.lomt");
    }
    let gbase: u32 = TB_G + gi * 32;
    store32(tab, gbase + G_NOFF, noff);
    store32(tab, gbase + G_NLEN, nlen);
    store32(tab, gbase + G_TOFF, to);
    store32(tab, gbase + G_TLEN, tl);
    store32(tab, gbase + G_SIZE, sz);
    store32(tab, gbase + G_DOFF, doff);
    store32(tab, gbase + G_ADDR, 0);
    store32(tab, gbase + G_ZERO, zero);
    setcell(tab, C_NG, gi + 1);
    return sz;
}

fn hexv(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return 0;
}

fn pow256(b: u32) -> u32 {
    let v: u32 = 1;
    let i: u32 = 0;
    while i < b {
        v = v * 256;
        i = i + 1;
    }
    return v;
}

/// 第一遍: 扫全文, 收集全局。lc = 行数。
fn collect_globals(tab: ptr, t: ptr, n: u32, gb: ptr) {
    let i: u32 = 0;
    while i < n {
        let le: u32 = line_end(t, i, n);
        let ls: u32 = skip_sp(t, i, le);
        if ls < le && load8(t, ls) == 64 {
            one_global(tab, t, gb, ls, le);
        }
        i = le + 1;
    }
}

/// 第二遍: 定位 (有内容的进 data, 全零的进 bss), 并登记成标签。
fn place_globals(tab: ptr, t: ptr) {
    let n: u32 = cell(tab, C_NG);
    let i: u32 = 0;
    while i < n {
        let gbase: u32 = TB_G + i * 32;
        if load32(tab, gbase + G_ZERO) == 0 {
            store32(tab, gbase + G_ADDR, data_base(tab) + load32(tab, gbase + G_DOFF));
            lbl_add(tab, load32(tab, gbase + G_NOFF), load32(tab, gbase + G_NLEN), 0, 0,
                    load32(tab, gbase + G_ADDR));
        }
        i = i + 1;
    }
    // **零初始化的那些（bss）故意留到 `place_bss`** —— 见那里的理由。
}

/// **bss 的地址必须等外部对象的数据节摆完才算**（`docs/219` §8b 第 1 条）。
///
/// 原先它和上面那些一起算，值是 `data_base + dlen + bss`，而 `dlen` 是**那一刻**的数据
/// 长度。外部对象的数据节是**之后**追加到同一个数据段里的 —— 于是 `@__loment_heap`
/// （64 KiB，正是堆）会**和对象的数据重叠**：在堆上写一个字节就踩坏了别人的 `.rodata`。
/// 链接期一切正常、跑起来才错，**判据抓不到**，所以顺序必须对。
fn place_bss(tab: ptr, t: ptr) {
    let n: u32 = cell(tab, C_NG);
    let dlen: u32 = align_to(cell(tab, C_GB), 8);
    let bss: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let gbase: u32 = TB_G + i * 32;
        if load32(tab, gbase + G_ZERO) == 1 {
            bss = align_to(bss, 8);
            store32(tab, gbase + G_ADDR, data_base(tab) + dlen + bss);
            bss = bss + align_to(load32(tab, gbase + G_SIZE), 8);
        }
        i = i + 1;
    }
    setcell(tab, C_BSS, bss);
    i = 0;
    while i < n {
        let gbase: u32 = TB_G + i * 32;
        if load32(tab, gbase + G_ZERO) == 1 {
            lbl_add(tab, load32(tab, gbase + G_NOFF), load32(tab, gbase + G_NLEN), 0, 0,
                    load32(tab, gbase + G_ADDR));
        }
        i = i + 1;
    }
}

// ---------------------------------------------------------------- 指令降级

fn line_dest(t: ptr, ls: u32, le: u32) -> u64 {
    let i: u32 = skip_sp(t, ls, le);
    if i >= le {
        return 0;
    }
    if load8(t, i) != 37 {
        return 0;
    }
    let we: u32 = word_end(t, i, le);
    let j: u32 = skip_sp(t, we, le);
    if j < le && load8(t, j) == 61 {
        return pk16(i, we - i);
    }
    return 0;
}

fn lower(tab: ptr, out: ptr, c: u32, t: ptr, ls: u32, le: u32) -> u32 {
    let i: u32 = skip_sp(t, ls, le);
    if i >= le {
        return c;
    }
    if load8(t, i) == 59 {
        return c;
    }
    // `#dbg_declare` / `#dbg_value` / `#dbg_assign` / `#dbg_label`（M59 的调试记录）——
    // **不是指令**: 原生产物不留行表 (`docs/167` §7), 所以跟 `;` 注释一样整行跳过。
    // 不跳会落到末尾的 `fail_line`（"不支持的指令"），于是 `--debug` 的 IR 根本链不出来 ——
    // 而文档说的是"被忽略"。与参考实现 `lomelf.py` 的 `parse_ll` 同判。
    if lit_at(t, i, le, "#dbg") == 1 {
        return c;
    }
    if load8(t, i) == 125 {
        return c;
    }
    // 基本块标签 `name:` —— 本档没有分支, 只跳过 (br/phi 是下一档)
    let e: u32 = le;
    while e > i && (load8(t, e - 1) == 32 || load8(t, e - 1) == 9 || load8(t, e - 1) == 13) {
        e = e - 1;
    }
    if e > i && load8(t, e - 1) == 58 {
        return c;
    }
    if lit_at(t, i, le, "alloca ") == 1 {
        return c;
    }
    if lit_at(t, i, le, "store ") == 1 {
        return do_store(tab, out, c, t, i + 6, le);
    }
    if lit_at(t, i, le, "load ") == 1 {
        return do_load(tab, out, c, t, i + 5, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "getelementptr") == 1 {
        return do_gep(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "extractvalue ") == 1 {
        return do_extract(tab, out, c, t, i + 13, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "insertvalue ") == 1 {
        return do_insert(tab, out, c, t, i + 12, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "icmp ") == 1 {
        return do_icmp(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "phi ") == 1 {
        return c;
    }
    if lit_at(t, i, le, "br") == 1 {
        return do_br(tab, out, c, t, i, le);
    }
    if lit_at(t, i, le, "switch ") == 1 {
        return do_switch(tab, out, c, t, i, le);
    }
    if lit_at(t, i, le, "atomicrmw ") == 1 {
        return do_atomic(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if binop_ty(t, i, le, "add") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 1);
    }
    if binop_ty(t, i, le, "sub") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 41);
    }
    if binop_ty(t, i, le, "mul") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 0);
    }
    if binop_ty(t, i, le, "and") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 33);
    }
    if binop_ty(t, i, le, "xor") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 4, 49);
    }
    if binop_ty(t, i, le, "or") == 1 {
        return do_alu(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 3, 9);
    }
    if binop_ty(t, i, le, "sdiv") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 13);
    }
    if binop_ty(t, i, le, "udiv") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 5);
    }
    if binop_ty(t, i, le, "srem") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 29);
    }
    if binop_ty(t, i, le, "urem") == 1 {
        return do_div(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 21);
    }
    if binop_ty(t, i, le, "shl") == 1 {
        return do_shift(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 36);
    }
    if binop_ty(t, i, le, "lshr") == 1 {
        return do_shift(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 45);
    }
    if binop_ty(t, i, le, "ashr") == 1 {
        return do_shift(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 121);
    }
    if lit_at(t, i, le, "trunc ") == 1 || lit_at(t, i, le, "zext ") == 1
        || lit_at(t, i, le, "sext ") == 1 {
        return do_cast(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "ptrtoint ") == 1 {
        return do_ptrcast(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 0);
    }
    if lit_at(t, i, le, "inttoptr ") == 1 {
        return do_ptrcast(tab, out, c, t, i, le, load32(tab, C_DESTO), load32(tab, C_DESTL), 1);
    }
    if lit_at(t, i, le, "call ") == 1 {
        return do_call(tab, out, c, t, i + 5, le, load32(tab, C_DESTO), load32(tab, C_DESTL));
    }
    if lit_at(t, i, le, "ret") == 1 {
        return do_ret(tab, out, c, t, i, le);
    }
    if lit_at(t, i, le, "unreachable") == 1 {
        let d: u32 = e1(out, c, 15);
        return e1(out, d, 11);
    }
    return fail_line(t, ls, le);
}

fn fetch_ptr_operand(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, reg: u32) -> u32 {
    let pe: u32 = opnd(tab, t, i, le);
    return emit_get_ptr(tab, out, c, t, load32(tab, C_VLOFF), load32(tab, C_VLLEN), reg);
}

fn do_load(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let j: u32 = skip_comma(t, to + tl, le);
    if is_agg(t, to, tl) == 1 {
        let d: u32 = emit_agg_addr(tab, out, c, t, doff, dlen, RDI);
        d = fetch_ptr_operand(tab, out, d, t, j, le, RSI);
        return em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
    }
    let sz: u32 = ty_size(t, to, tl);
    let d: u32 = fetch_ptr_operand(tab, out, c, t, j, le, RAX);
    d = em_load_sized(out, d, RAX, RAX, 0, sz);
    d = em_zext64(out, d, RAX, sz);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_store(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, i + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let k: u32 = skip_comma(t, ve, le);
    if is_agg(t, to, tl) == 1 {
        let d: u32 = fetch_ptr_operand(tab, out, c, t, k, le, RDI);
        d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
        return em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
    }
    let sz: u32 = ty_size(t, to, tl);
    let d: u32 = emit_get(tab, out, c, t, to, tl, vs, ve - vs, RAX);
    d = fetch_ptr_operand(tab, out, d, t, k, le, RCX);
    return em_store_sized(out, d, RCX, 0, RAX, sz);
}

fn do_gep(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let j: u32 = skip_sp(t, i + 13, le);
    if lit_at(t, j, le, "inbounds") == 1 {
        j = skip_sp(t, j + 8, le);
    }
    let ts: u64 = type_span(t, j, le);
    let co: u32 = hi32(ts);
    let cl: u32 = lo32(ts);
    let k: u32 = skip_comma(t, co + cl, le);
    let pe: u32 = opnd(tab, t, k, le);
    let d: u32 = emit_get_ptr(tab, out, c, t, load32(tab, C_VLOFF), load32(tab, C_VLLEN), RAX);
    let cur_o: u32 = co;
    let cur_l: u32 = cl;
    let k2: u32 = skip_comma(t, pe, le);
    while k2 < le {
        let ie: u32 = opnd(tab, t, k2, le);
        let vo: u32 = load32(tab, C_VLOFF);
        let vl: u32 = load32(tab, C_VLLEN);
        let to: u32 = load32(tab, C_TYOFF);
        let tl: u32 = load32(tab, C_TYLEN);
        // GEP 的下标是**符号扩展**的 (`#313`) —— `emit_get` 按设计零扩展, 所以这里用
        // `emit_get_signed`: `getelementptr i8, ptr %p, i32 -4` 要的是 `%p - 4`,
        // 零扩展会把它变成 `%p + 4294967292`。结构体那条路不受影响 (`field_off` +
        // `em_alu_ri` 本来就符号扩展)。**与参考实现同形**, 否则 ELF 不逐字节同。
        d = emit_get_signed(tab, out, d, t, to, tl, vo, vl, RCX);
        if load8(t, cur_o) == 91 {
            let es: u64 = arr_elem(t, cur_o, cur_l);
            let step: u32 = ty_size(t, hi32(es), lo32(es));
            cur_o = hi32(es);
            cur_l = lo32(es);
            if step != 1 {
                d = em_mov_ri64(out, d, RDX, step as u64);
                d = em_imul_rr(out, d, RCX, RDX);
            }
            d = em_alu_rr(out, d, 1, RAX, RCX);
        } else {
            if load8(t, cur_o) == 123 {
                let nx2: u64 = num_at(t, vo, le);
                let idx2: u32 = lo32(nx2);
                let fo2: u32 = field_off(t, cur_o, cur_l, idx2);
                if fo2 != 0 {
                    d = em_alu_ri(out, d, ADD, RAX, fo2);
                }
                let fts2: u64 = field_ty(t, cur_o, cur_l, idx2);
                cur_o = hi32(fts2);
                cur_l = lo32(fts2);
            } else {
                let step2: u32 = ty_size(t, cur_o, cur_l);
                if step2 != 1 {
                    d = em_mov_ri64(out, d, RDX, step2 as u64);
                    d = em_imul_rr(out, d, RCX, RDX);
                }
                d = em_alu_rr(out, d, 1, RAX, RCX);
            }
        }
        k2 = skip_comma(t, ie, le);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_extract(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let ao: u32 = hi32(ts);
    let al: u32 = lo32(ts);
    let j: u32 = skip_sp(t, ao + al, le);
    let ve: u32 = word_end(t, j, le);
    let k: u32 = skip_comma(t, ve, le);
    let nx: u64 = num_at(t, k, le);
    let idx: u32 = lo32(nx);
    let off: u32 = field_off(t, ao, al, idx);
    let fts: u64 = field_ty(t, ao, al, idx);
    let fo: u32 = hi32(fts);
    let fl: u32 = lo32(fts);
    let d: u32 = c;
    if is_agg(t, fo, fl) == 1 {
        d = emit_agg_addr(tab, out, d, t, doff, dlen, RDI);
        d = emit_agg_addr(tab, out, d, t, j, ve - j, RAX);
        d = em_lea(out, d, RSI, RAX, off);
        return em_copy(out, d, RDI, RSI, ty_size(t, fo, fl));
    }
    let fs: u32 = ty_size(t, fo, fl);
    d = emit_agg_addr(tab, out, d, t, j, ve - j, RAX);
    d = em_load_sized(out, d, RAX, RAX, off, fs);
    d = em_zext64(out, d, RAX, fs);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_insert(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ts: u64 = type_span(t, i, le);
    let ao: u32 = hi32(ts);
    let al: u32 = lo32(ts);
    let sz: u32 = ty_size(t, ao, al);
    let j: u32 = skip_sp(t, ao + al, le);
    let ae: u32 = word_end(t, j, le);
    let k: u32 = skip_comma(t, ae, le);
    let ety: u64 = type_span(t, k, le);
    let eo: u32 = hi32(ety);
    let el: u32 = lo32(ety);
    let evs: u32 = skip_sp(t, eo + el, le);
    let eve: u32 = word_end(t, evs, le);
    let k2: u32 = skip_comma(t, eve, le);
    let nx: u64 = num_at(t, k2, le);
    let off: u32 = field_off(t, ao, al, lo32(nx));
    let so: u32 = slot_find(tab, t, doff, dlen);
    let d: u32 = c;
    if lit_at(t, j, ae, "undef") == 1 {
        d = em_lea(out, d, RDI, RBP, so);
        d = em_mov_ri64(out, d, RCX, sz as u64);
        d = em_mov_ri32(out, d, RAX, 0);
        d = e1(out, d, 243);
        d = e1(out, d, 170);
    } else {
        d = em_lea(out, d, RDI, RBP, so);
        d = emit_agg_addr(tab, out, d, t, j, ae - j, RSI);
        d = em_copy(out, d, RDI, RSI, sz);
    }
    if is_agg(t, eo, el) == 1 {
        d = em_lea(out, d, RDI, RBP, so);
        if off != 0 {
            d = em_alu_ri(out, d, ADD, RDI, off);
        }
        d = emit_agg_addr(tab, out, d, t, evs, eve - evs, RSI);
        return em_copy(out, d, RDI, RSI, ty_size(t, eo, el));
    }
    let es: u32 = ty_size(t, eo, el);
    d = emit_get(tab, out, d, t, eo, el, evs, eve - evs, RAX);
    return em_store_sized(out, d, RBP, so + off, RAX, es);
}

fn nargs_of(t: ptr, lp: u32, rp: u32) -> u32 {
    let a: u32 = skip_sp(t, lp + 1, rp);
    let n: u32 = 0;
    while a < rp {
        let ts: u64 = type_span(t, a, rp);
        let j: u32 = skip_sp(t, hi32(ts) + lo32(ts), rp);
        let ve: u32 = word_end(t, j, rp);
        a = skip_comma(t, ve, rp);
        n = n + 1;
    }
    return n;
}

/// 第 k 个实参的起点 (越界返回 rp)。
fn arg_start(t: ptr, lp: u32, rp: u32, k: u32) -> u32 {
    let a: u32 = skip_sp(t, lp + 1, rp);
    let i: u32 = 0;
    while i < k && a < rp {
        let ts: u64 = type_span(t, a, rp);
        let j: u32 = skip_sp(t, hi32(ts) + lo32(ts), rp);
        let ve: u32 = word_end(t, j, rp);
        a = skip_comma(t, ve, rp);
        i = i + 1;
    }
    return a;
}

/// 实参列表的括号区间: 写入 lp/rp 并返回; 找不到返回 0。
fn arg_parens(t: ptr, from: u32, le: u32) -> u64 {
    let lp: u32 = 0;
    let k: u32 = from;
    while k < le {
        if load8(t, k) == 40 && lp == 0 {
            lp = k;
        }
        k = k + 1;
    }
    if lp == 0 {
        return 0;
    }
    let rp: u32 = lp;
    let k2: u32 = lp;
    while k2 < le {
        if load8(t, k2) == 41 {
            rp = k2;
        }
        k2 = k2 + 1;
    }
    return pk16(lp, rp);
}

fn do_call(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let j: u32 = skip_sp(t, i, le);
    let has_ret: u32 = 1;
    let ret_agg: u32 = 0;
    if lit_at(t, j, le, "void") == 1 {
        has_ret = 0;
        j = skip_sp(t, j + 4, le);
    } else {
        let ts: u64 = type_span(t, j, le);
        if is_agg(t, hi32(ts), lo32(ts)) == 1 {
            ret_agg = 1;
        }
        j = skip_sp(t, hi32(ts) + lo32(ts), le);
    }
    if lit_at(t, j, le, "asm ") == 1 {
        // **按 asm 的第一个词分派** (M84): `syscall` 是内联汇编本身, `thread_spawn @入口`
        // 是链接器自己发的定制序列 (docs/245)。参考实现 `_call` 是同一个分派点。
        let qn: u32 = 0;
        let q1: u32 = 0;
        let kk: u32 = j;
        while kk < le {
            if load8(t, kk) == 34 {
                if qn == 0 {
                    q1 = kk;
                }
                qn = qn + 1;
            }
            kk = kk + 1;
        }
        if q1 > 0 && lit_at(t, q1 + 1, le, "thread_spawn") == 1 {
            return do_call_spawn(tab, out, c, t, j, le, doff, dlen);
        }
        return do_call_asm(tab, out, c, t, j, le, doff, dlen);
    }
    let cs: u32 = j;
    let ce: u32 = word_end(t, j, le);
    let pr: u64 = arg_parens(t, ce, le);
    let lp: u32 = hi32(pr);
    let rp: u32 = lo32(pr);
    let nargs: u32 = nargs_of(t, lp, rp);
    // ---- 外部函数 (docs/173): 实参走**寄存器**, 不走我们自己的栈约定。
    if ext_has(tab, t, cs + 1, ce - cs - 1) == 1 {
        return do_call_extern(tab, out, c, t, lp, rp, nargs, cs, ce, has_ret + ret_agg * 2);
    }
    let total: u32 = 0;
    let q: u32 = 0;
    while q < nargs {
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        if is_agg(t, to, tl) == 1 {
            total = total + align_to(ty_size(t, to, tl), 8);
        } else {
            total = total + 8;
        }
        q = q + 1;
    }
    if ret_agg == 1 {
        total = total + 8;                        // 隐藏结果指针那 8 字节
    }
    let d: u32 = c;
    q = nargs;
    while q > 0 {
        q = q - 1;
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        let vs: u32 = skip_sp(t, to + tl, rp);
        let ve: u32 = word_end(t, vs, rp);
        if is_agg(t, to, tl) == 1 {
            d = em_alu_ri(out, d, SUB, RSP, align_to(ty_size(t, to, tl), 8));
            d = em_mov_rr(out, d, RDI, RSP, 1);
            d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
            d = em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
        } else {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
            d = em_push(out, d, RAX);
        }
    }
    if ret_agg == 1 {
        d = em_lea(out, d, RAX, RBP, slot_find(tab, t, doff, dlen));
        d = em_push(out, d, RAX);
    }
    if lit_at(t, cs, ce, "@llvm.trap") == 1 {
        d = e1(out, d, 15);
        d = e1(out, d, 11);
    } else {
        d = em_call_lbl(out, d, tab, cs + 1, ce - cs - 1);
    }
    if total != 0 {
        d = em_alu_ri(out, d, ADD, RSP, total);
    }
    if has_ret == 1 && ret_agg == 0 {
        d = emit_put(tab, out, d, t, doff, dlen, RAX);
    }
    return d;
}

/// 内联汇编 syscall: `asm sideeffect "syscall", "={ax},{ax},{di},...", (args)`。
fn asm_code(t: ptr, s: u32, e: u32) -> u32 {
    if e - s == 2 && load8(t, s) == 97 && load8(t, s + 1) == 120 {
        return 1;                                   // ax
    }
    if e - s == 2 && load8(t, s) == 100 && load8(t, s + 1) == 105 {
        return 2;                                   // di
    }
    if e - s == 2 && load8(t, s) == 115 && load8(t, s + 1) == 105 {
        return 3;                                   // si
    }
    if e - s == 2 && load8(t, s) == 100 && load8(t, s + 1) == 120 {
        return 4;                                   // dx
    }
    if e - s == 3 && load8(t, s) == 114 && load8(t, s + 1) == 49 && load8(t, s + 2) == 48 {
        return 5;                                   // r10
    }
    if e - s == 2 && load8(t, s) == 114 && load8(t, s + 1) == 56 {
        return 6;                                   // r8
    }
    if e - s == 2 && load8(t, s) == 114 && load8(t, s + 1) == 57 {
        return 7;                                   // r9（Linux 第 6 个实参，syscall7 用满）
    }
    return 0;
}

fn asm_reg(code: u32) -> u32 {
    if code == 1 {
        return RAX;
    }
    if code == 2 {
        return RDI;
    }
    if code == 3 {
        return RSI;
    }
    if code == 4 {
        return RDX;
    }
    if code == 5 {
        return 10;
    }
    if code == 7 {
        return 9;                               // r9
    }
    return 8;
}

/// 第 k 个实参对应的寄存器码 (约束里按顺序数, 跳过 ={..} 与 ~{..})。
fn arg_code(t: ptr, p3: u32, p4: u32, k: u32) -> u32 {
    let ci: u32 = p3 + 1;
    let ai: u32 = 0;
    let out: u32 = 0;
    while ci < p4 {
        if load8(t, ci) == 123 {
            let re: u32 = ci + 1;
            let re2: u32 = re;
            while re2 < p4 && load8(t, re2) != 125 {
                re2 = re2 + 1;
            }
            if ci >= p3 + 2 {
                let prev: u32 = load8(t, ci - 1);
                if prev != 61 && prev != 126 {
                    if ai == k {
                        out = asm_code(t, re, re2);
                    }
                    ai = ai + 1;
                }
            }
            ci = re2 + 1;
        } else {
            ci = ci + 1;
        }
    }
    return out;
}

fn do_call_asm(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    // 前四个引号: "syscall" 与 "约束"
    let nq: u32 = 0;
    let p3: u32 = 0;
    let p4: u32 = 0;
    let k: u32 = i;
    while k < le {
        if load8(t, k) == 34 {
            if nq == 2 {
                p3 = k;
            }
            if nq == 3 {
                p4 = k;
            }
            nq = nq + 1;
        }
        k = k + 1;
    }
    if p3 == 0 || p4 == 0 {
        return fail("the inline-assembly constraint string cannot be parsed");
    }
    let pr: u64 = arg_parens(t, p4, le);
    let lp: u32 = hi32(pr);
    let rp: u32 = lo32(pr);
    let nargs: u32 = nargs_of(t, lp, rp);
    let d: u32 = c;
    // rax 最后写, 其余先写
    let code: u32 = 2;
    while code <= 7 {
        let q: u32 = 0;
        while q < nargs {
            if arg_code(t, p3, p4, q) == code {
                let a2: u32 = arg_start(t, lp, rp, q);
                let ts: u64 = type_span(t, a2, rp);
                let to: u32 = hi32(ts);
                let tl: u32 = lo32(ts);
                let vs: u32 = skip_sp(t, to + tl, rp);
                let ve: u32 = word_end(t, vs, rp);
                d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, asm_reg(code));
            }
            q = q + 1;
        }
        code = code + 1;
    }
    let q2: u32 = 0;
    while q2 < nargs {
        if arg_code(t, p3, p4, q2) == 1 {
            let a2: u32 = arg_start(t, lp, rp, q2);
            let ts: u64 = type_span(t, a2, rp);
            let to: u32 = hi32(ts);
            let tl: u32 = lo32(ts);
            let vs: u32 = skip_sp(t, to + tl, rp);
            let ve: u32 = word_end(t, vs, rp);
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        }
        q2 = q2 + 1;
    }
    if cell(tab, C_PE) == 1 {
        // Windows 没有 syscall 指令：改成 call __win_syscall，由 shim 按号派发
        let d2: u32 = e1(out, d, 232);          // E8
        let disp: u32 = cell(tab, C_SHIM) - (d2 + 4);
        d = e4(out, d2, disp);
    } else {
        d = e1(out, d, 15);
        d = e1(out, d, 5);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

/// `thread_spawn @入口` (M84, docs/245) —— 与参考实现 `Emitter._call_spawn`
/// (`../tools/lomelf.py` 的 `_SPAWN_HEAD` / `_SPAWN_TAIL` + 中间那条 `Asm.call`)
/// **逐字节相同**。两处必须一起改: `loment_elf_test` 的孪生那格拿同一份 `.ll` 比两份 ELF。
///
/// ```asm
///   BF 00 0F 05 00    mov  edi, 331520   ; CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM
///   31 D2             xor  edx, edx      ; ptid  = NULL
///   45 31 D2          xor  r10d, r10d    ; ctid  = NULL
///   45 31 C0          xor  r8d, r8d      ; newtls = 0
///   B8 38 00 00 00    mov  eax, 56       ; clone
///   0F 05             syscall
///   48 85 C0          test rax, rax
///   75 35             jne  .parent       ; 跳过下面 53 字节
///   48 89 E5          mov  rbp, rsp      ; 子线程换掉继承来的 rbp (硬事实一)
///   41 51             push r9            ; 实参 → 被调方的第 0 个形参槽
///   E8 rel32          call 入口          ; **直接调用** —— 静态调用图不变
///   41 89 C5          mov  r13d, eax     ; 存住入口的返回值
///   4D 85 E4          test r12, r12      ; 有完成通知地址吗
///   74 19             jz   .no_done      ; 跳过下面 25 字节
///   F0 41 FF 04 24    lock incl [r12]    ; 原子加一 (也是释放屏障)
///   44 89 E7          mov  edi, r12d
///   B8 CA 00 00 00    mov  eax, 202      ; futex
///   BE 81 00 00 00    mov  esi, 129      ; FUTEX_WAKE|FUTEX_PRIVATE_FLAG
///   BA 01 00 00 00    mov  edx, 1
///   0F 05             syscall
///   44 89 EF          .no_done: mov edi, r13d
///   B8 3C 00 00 00    mov  eax, 60       ; exit (**不是** exit_group: 后者杀掉整组)
///   0F 05             syscall
/// ```
/// 进门前 `emit_get` 已把**第 0 个操作数取进 rsi**（栈顶）、**第 1 个取进 r9**
/// （子线程实参）、**第 2 个取进 r12**（完成通知地址, 0 = 不要通知）。r9/r12 是仅有的
/// 两个能把值安全带过 `clone` 又不与 `clone` 自己那五个实参寄存器冲突的寄存器。
///
/// **通知那一段只有在编译器站得的位置才做得了**: 入口是 Loment 写的, 它一 `return`,
/// 控制权就回到这段尾声 —— 所以 `join` 的握手是**产物保证的**, 不靠工作线程自觉。
fn do_call_spawn(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32,
                 doff: u32, dlen: u32) -> u32 {
    if cell(tab, C_PE) == 1 {
        return fail("thread_spawn is for ELF targets only -- Windows has no clone");
    }
    // asm 名字: 第 1、2 个引号之间 = `thread_spawn @入口`
    let nq: u32 = 0;
    let q1: u32 = 0;
    let q2: u32 = 0;
    let k: u32 = i;
    while k < le {
        if load8(t, k) == 34 {
            if nq == 0 {
                q1 = k;
            }
            if nq == 1 {
                q2 = k;
            }
            nq = nq + 1;
        }
        k = k + 1;
    }
    let eo: u32 = q1 + 15;                       // 引号(1) + "thread_spawn"(12) + 空格(1) + "@"(1)
    if q2 <= eo || q2 >= le {
        return fail("the assembly given to thread_spawn has no entry label in it");
    }
    // 操作数表: 约束串里没有括号, 所以第 2 个引号之后的**第一个** `(` 就是它
    let pr: u64 = arg_parens(t, q2, le);
    let lp: u32 = hi32(pr);
    let rp: u32 = lo32(pr);
    let nargs: u32 = nargs_of(t, lp, rp);
    let d: u32 = c;
    let q: u32 = 0;
    while q < nargs {
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        let vs: u32 = skip_sp(t, to + tl, rp);
        let ve: u32 = word_end(t, vs, rp);
        if q == 0 {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RSI);    // rsi = 栈顶
        } else if q == 1 {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, 9);      // r9  = 子线程实参
        } else {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, 12);     // r12 = 完成通知地址
        }
        q = q + 1;
    }
    // ---- 头 (_SPAWN_HEAD)
    d = e1(out, d, 191); d = e1(out, d, 0); d = e1(out, d, 15);
    d = e1(out, d, 5); d = e1(out, d, 0);                      // BF 00 0F 05 00
    d = e1(out, d, 49); d = e1(out, d, 210);                   // 31 D2
    d = e1(out, d, 69); d = e1(out, d, 49); d = e1(out, d, 210);   // 45 31 D2
    d = e1(out, d, 69); d = e1(out, d, 49); d = e1(out, d, 192);   // 45 31 C0
    d = e1(out, d, 184); d = e1(out, d, 56);
    d = e1(out, d, 0); d = e1(out, d, 0); d = e1(out, d, 0);   // B8 38 00 00 00
    d = e1(out, d, 15); d = e1(out, d, 5);                     // 0F 05
    d = e1(out, d, 72); d = e1(out, d, 133); d = e1(out, d, 192);  // 48 85 C0
    d = e1(out, d, 117); d = e1(out, d, 53);                   // 75 35
    d = e1(out, d, 72); d = e1(out, d, 137); d = e1(out, d, 229);  // 48 89 E5
    d = e1(out, d, 65); d = e1(out, d, 81);                    // 41 51
    // ---- 直接调用 (那条 `E8` 落在符号表上, 与普通调用同一条回填路)
    d = em_call_lbl(out, d, tab, eo, q2 - eo);
    // ---- 尾 (_SPAWN_TAIL)
    d = e1(out, d, 65); d = e1(out, d, 137); d = e1(out, d, 197);  // 41 89 C5
    d = e1(out, d, 77); d = e1(out, d, 133); d = e1(out, d, 228);  // 4D 85 E4
    d = e1(out, d, 116); d = e1(out, d, 25);                   // 74 19
    d = e1(out, d, 240); d = e1(out, d, 65); d = e1(out, d, 255);
    d = e1(out, d, 4); d = e1(out, d, 36);                     // F0 41 FF 04 24
    d = e1(out, d, 68); d = e1(out, d, 137); d = e1(out, d, 231);  // 44 89 E7
    d = e1(out, d, 184); d = e1(out, d, 202);
    d = e1(out, d, 0); d = e1(out, d, 0); d = e1(out, d, 0);   // B8 CA 00 00 00
    d = e1(out, d, 190); d = e1(out, d, 129);
    d = e1(out, d, 0); d = e1(out, d, 0); d = e1(out, d, 0);   // BE 81 00 00 00
    d = e1(out, d, 186); d = e1(out, d, 1);
    d = e1(out, d, 0); d = e1(out, d, 0); d = e1(out, d, 0);   // BA 01 00 00 00
    d = e1(out, d, 15); d = e1(out, d, 5);                     // 0F 05
    d = e1(out, d, 68); d = e1(out, d, 137); d = e1(out, d, 239);  // 44 89 EF
    d = e1(out, d, 184); d = e1(out, d, 60);
    d = e1(out, d, 0); d = e1(out, d, 0); d = e1(out, d, 0);   // B8 3C 00 00 00
    d = e1(out, d, 15); d = e1(out, d, 5);                     // 0F 05
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_cast(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let kind: u32 = 0;
    let bs: u32 = i + 6;
    if lit_at(t, i, le, "zext ") == 1 {
        kind = 1;
        bs = i + 5;
    }
    if lit_at(t, i, le, "sext ") == 1 {
        kind = 2;
        bs = i + 5;
    }
    let fts: u64 = type_span(t, bs, le);
    let fo: u32 = hi32(fts);
    let fl: u32 = lo32(fts);
    let vs: u32 = skip_sp(t, fo + fl, le);
    let ve: u32 = word_end(t, vs, le);
    let tsz: u32 = size_after_to(t, i, le);
    let fsz: u32 = ty_size(t, fo, fl);
    let d: u32 = emit_get(tab, out, c, t, fo, fl, vs, ve - vs, RAX);
    if kind == 1 {
        d = em_zext64(out, d, RAX, fsz);
    }
    if kind == 2 {
        d = em_sext64(out, d, RAX, fsz);
    }
    if tsz < 8 {
        d = em_zext64(out, d, RAX, tsz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_ptrcast(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
              to_ptr: u32) -> u32 {
    let bs: u32 = i + 9;
    if to_ptr == 1 {
        bs = i + 8;
    }
    let fts: u64 = type_span(t, bs, le);
    let fo: u32 = hi32(fts);
    let fl: u32 = lo32(fts);
    let vs: u32 = skip_sp(t, fo + fl, le);
    let ve: u32 = word_end(t, vs, le);
    let tsz: u32 = size_after_to(t, i, le);
    let d: u32 = c;
    if to_ptr == 1 {
        d = emit_get(tab, out, d, t, fo, fl, vs, ve - vs, RAX);
    } else {
        d = emit_get_ptr(tab, out, d, t, vs, ve - vs, RAX);
    }
    if tsz < 8 {
        d = em_zext64(out, d, RAX, tsz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_ret(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let j: u32 = skip_sp(t, i + 3, le);
    let d: u32 = c;
    if lit_at(t, j, le, "void") == 0 {
        let ts: u64 = type_span(t, j, le);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        let vs: u32 = skip_sp(t, to + tl, le);
        let ve: u32 = word_end(t, vs, le);
        if is_agg(t, to, tl) == 1 {
            d = em_mov_rm(out, d, RDI, RBP, 16);          // 取隐藏结果指针
            d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
            d = em_copy(out, d, RDI, RSI, ty_size(t, to, tl));
            d = em_mov_rm(out, d, RAX, RBP, 16);
        } else {
            d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        }
    }
    d = e1(out, d, 201);
    return e1(out, d, 195);
}

// ---------------------------------------------------------------- 函数发射

/// 本函数第一个 `{` 与末尾 `}` 之间的行区内, 规划帧 (槽 + alloca)。
fn plan_frame(tab: ptr, t: ptr, fs: u32, fe: u32) {
    setcell(tab, C_NPHI, 0);
    let i: u32 = fs;
    let cbo: u32 = 0;
    let cbl: u32 = 0;
    while i < fe {
        let ls: u32 = skip_sp(t, i, fe);
        let le: u32 = logical_end(t, i, fe);
        // 基本块标签?
        let e2: u32 = le;
        let go2: u32 = 1;
        while e2 > ls && go2 == 1 {
            let c2: u32 = load8(t, e2 - 1);
            if c2 == 32 || c2 == 9 || c2 == 13 {
                e2 = e2 - 1;
            } else {
                go2 = 0;
            }
        }
        let is_blk: u32 = 0;
        if e2 > ls && load8(t, e2 - 1) == 58 {
            is_blk = 1;
        }
        if is_blk == 1 {
            cbo = ls;
            cbl = e2 - 1 - ls;
        }
        let dst: u64 = line_dest(t, ls, le);
        if dst != 0 {
            let dd: u32 = skip_sp(t, hi32(dst) + lo32(dst), le);
            let dd2: u32 = skip_sp(t, dd + 1, le);
            if lit_at(t, dd2, le, "phi ") == 1 {
                let k: u32 = cell(tab, C_NPHI);
                if k >= TB_PHI_MAX {
                    let _f: u32 = fail("the phi table is full (one function) -- raise TB_PHI_MAX in loment/tools/lomelf.lomt");
                }
                let pb: u32 = TB_PHI + k * 16;
                store32(tab, pb + PH_BOFF, cbo);
                store32(tab, pb + PH_BLEN, cbl);
                store32(tab, pb + PH_IOFF, hi32(dst));
                store32(tab, pb + PH_ILEN, le - hi32(dst));
                setcell(tab, C_NPHI, k + 1);
            }
        }
        if dst != 0 {
            let do: u32 = hi32(dst);
            let dl: u32 = lo32(dst);
            let op: u32 = skip_sp(t, do + dl, le);
            let op2: u32 = skip_sp(t, op + 1, le);
            if lit_at(t, op2, le, "alloca ") == 1 {
                let ts: u64 = type_span(t, op2 + 7, le);
                let sz: u32 = ty_size(t, hi32(ts), lo32(ts));
                let fr: u32 = align_to(cell(tab, C_FRAME), 8) + align_to(sz, 8);
                setcell(tab, C_FRAME, fr);
                alloc_put(tab, do, dl, 0 - fr, sz);
            } else {
                if slot_has(tab, t, do, dl) == 0 {
                    let rs: u32 = result_size(t, op2, le);
                    if rs != 0 {
                        let fr: u32 = align_to(cell(tab, C_FRAME), 8) + align_to(rs, 8);
                        setcell(tab, C_FRAME, fr);
                        slot_put(tab, do, dl, 0 - fr);
                    }
                }
            }
        }
        i = le + 1;
    }
}

/// 函数头: `define [internal] RET @name(PARAMS) {`; 记下参数槽。
fn plan_params(tab: ptr, t: ptr, ls: u32, le: u32) -> u32 {
    let j: u32 = skip_sp(t, ls + 6, le);
    if lit_at(t, j, le, "internal") == 1 {
        j = skip_sp(t, j + 8, le);
    }
    if lit_at(t, j, le, "private") == 1 {
        j = skip_sp(t, j + 7, le);
    }
    let rts: u64 = type_span(t, j, le);
    let j2: u32 = skip_sp(t, hi32(rts) + lo32(rts), le);
    let ns: u32 = j2 + 1;
    let ne: u32 = word_end(t, ns, le);
    let lp: u32 = skip_sp(t, ne, le);
    let rp: u32 = le;
    let k: u32 = lp;
    while k < le {
        if load8(t, k) == 41 {
            rp = k;
        }
        k = k + 1;
    }
    let arg: u32 = 16;
    if is_agg(t, hi32(rts), lo32(rts)) == 1 {
        arg = 24;                                 // 隐藏结果指针占 [rbp+16]
    }
    let a: u32 = skip_sp(t, lp + 1, rp);
    while a < rp {
        let ae: u32 = opnd(tab, t, a, rp);
        let to: u32 = load32(tab, C_TYOFF);
        let tl: u32 = load32(tab, C_TYLEN);
        let vs: u32 = load32(tab, C_VLOFF);
        let vl: u32 = load32(tab, C_VLLEN);
        let sz: u32 = ty_size(t, to, tl);
        let esz: u32 = sz;
        if esz < 8 {
            esz = 8;
        }
        slot_put(tab, vs, vl, arg);
        arg = arg + align_to(esz, 8);
        a = skip_comma(t, ae, rp);
    }
    return ns;
}

// ---------------------------------------------------------------- 外部目标文件 (FFI, docs/173)
//
// 与 tools/lomelf.py 的 ForeignObject / compile_ll 后半段逐字对齐。第 1 阶段只认
// **静态、freestanding 的 ELF64 可重定位对象**: 取代码节的字节 + 它导出的全局符号。
// 两条边界**硬失败**而不是猜 (猜的后果是"调到一个错地址", 那是运行期崩溃而不是编译期报错):
//
//   * 对象里有重定位 -> 报错 (第 1 阶段不做跨对象重定位);
//   * 对象引用未定义符号 (典型是 libc 的 printf/malloc) -> 报错 (不链 libc)。
//
// **为什么代码节要认 `.text.*`**: clang 把所有函数塞进一个 `.text`, 但 rustc/LLVM 默认
// **按函数分节** (每个函数一个 `.text.<名字>`), 此时 `.text` 本身是空的。只认 `.text`
// 会把 Rust 那一族直接判成"没有代码节" (参考侧实测就是这么红的)。所以把所有代码节
// **按节表顺序拼成一块**, 并记下每节在拼接结果里的起点。

fn rd16(p: ptr, off: u32) -> u32 {
    let a: u32 = load8(p, off) as u32;
    let b: u32 = load8(p, off + 1) as u32;
    return a + b * 256;
}

fn rd64(p: ptr, off: u32) -> u64 {
    let lo: u64 = load32(p, off) as u64;
    let hi: u64 = load32(p, off + 4) as u64;
    return lo + hi * PHI;
}

/// 写到 NUL 为止 (外部文件里的 C 字符串)。上限 4096 —— 畸形输入不许读飞。
fn write_cstr(fd: u64, p: ptr, off: u32) -> u64 {
    let n: u32 = 0;
    while n < 4096 && load8(p, off + n) != 0 {
        n = n + 1;
    }
    return write_all(fd, ptr_add(p, off), n as u64);
}

fn cstr_len(p: ptr, off: u32) -> u32 {
    let n: u32 = 0;
    while n < 4096 && load8(p, off + n) != 0 {
        n = n + 1;
    }
    return n;
}

/// 把 16 对齐的缝隙显式**清零**。
///
/// 参考实现是 `while len(buf) % 16: buf.append(0)` —— 那些补齐字节**会进最终的 ELF**
/// (build_elf 从 [0, tlen) 整段拷)。自举侧若只是跳到对齐位置而**不写**, 拷出去的是 arena
/// 里的残留字节: 首次分配恰好是内核给的零页, 于是能对上, 但那**不是**一段可靠的性质 ——
/// 只要 arena 被复用过一次就会悄悄变得与参考不同。所以这里明写。
fn pad_zero(p: ptr, from: u32, to: u32) {
    let k: u32 = from;
    while k < to {
        store8(p, k, 0 as u8);
        k = k + 1;
    }
}

// ELF64 节头字段 (相对节头起点的偏移) 与节表定位。字段偏移见 Elf64_Shdr:
// sh_name@0 sh_type@4 sh_flags@8 sh_addr@16 sh_offset@24 sh_size@32 sh_link@40
// sh_info@44 sh_addralign@48 sh_entsize@56 (共 64 字节)。
fn sec_hdr(raw: ptr, k: u32) -> u32 {
    return load32(raw, 40) + k * rd16(raw, 58);
}

fn sh_type(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 4);
}

fn sh_off(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 24);
}

fn sh_size(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 32);
}

fn sh_link(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 40);
}

fn sh_info(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 44);
}

fn sh_flags(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 8);
}

/// `sh_addralign`（`#612`）：节的对齐要求。原先这里没有它，所有节一律按 16 摆 ——
/// 一个要求 32/64 对齐的 `.rodata.cst32` 就会落在 `16 (mod 32)` 上，AVX 的
/// `vmovdqa` 第一次取常数就 #GP。参考实现同一条。
fn sh_align(raw: ptr, k: u32) -> u32 {
    return load32(raw, sec_hdr(raw, k) + 48);
}

/// **元数据节**（`.eh_frame` / `.debug*` / `.comment` / `.note*`）：代码引用不到它们，
/// 丢掉无损。**与参考实现 `_META_SEC` 同一份名单** —— "摆哪些节"两边必须一致，
/// 否则同一次链接两侧产物不同（镜像判据逐字节比）。
fn is_meta_sec(raw: ptr, noff: u32) -> u32 {
    let n: u32 = cstr_len(raw, noff);
    if n >= 9 && lit_at(raw, noff, noff + 9, ".eh_frame") == 1 { return 1; }
    if n >= 6 && lit_at(raw, noff, noff + 6, ".debug") == 1 { return 1; }
    if n >= 8 && lit_at(raw, noff, noff + 8, ".comment") == 1 { return 1; }
    if n >= 5 && lit_at(raw, noff, noff + 5, ".note") == 1 { return 1; }
    return 0;
}

/// 该节是不是要摆的**数据节**：`SHF_ALLOC`(0x2) 且类型 PROGBITS(1)/NOBITS(8)，
/// 不是代码节、不是元数据节、非空。**与参考实现那条筛选一一对应**（镜像判据钉）。
fn is_data_sec(raw: ptr, k: u32) -> u32 {
    if sh_type(raw, k) != 1 && sh_type(raw, k) != 8 { return 0; }
    if sh_flags(raw, k) % 4 < 2 { return 0; }              // SHF_ALLOC = 0x2
    if is_code_sec(raw, sec_name(raw, k)) == 1 { return 0; }
    if is_meta_sec(raw, sec_name(raw, k)) == 1 { return 0; }
    if sh_size(raw, k) == 0 { return 0; }
    return 1;
}

/// 第 k 节在该对象**数据块**里的起点（数据节按节表顺序拼接、每节按自己的
/// `sh_addralign` 对齐，至少 16）。与 `sec_at` 同一形状，只是筛的是 `is_data_sec`。
fn dsec_at(raw: ptr, k: u32) -> u32 {
    let cur: u32 = 0;
    let i: u32 = 0;
    while i < k {
        if is_data_sec(raw, i) == 1 {
            let al: u32 = sh_align(raw, i);
            if al < 16 { al = 16; }
            cur = align_to(cur, al) + sh_size(raw, i);
        }
        i = i + 1;
    }
    let al2: u32 = sh_align(raw, k);
    if al2 < 16 { al2 = 16; }
    return align_to(cur, al2);
}

/// 把节符号的**合成名**写进名字池：`$` + 对象号 + `.` + 节号（四个字节，**不是**文本）。
/// **节符号**（`STT_SECTION`）的 `st_name` 是 0，名字靠 `shndx` 认 —— clang 对"指向
/// `.rodata` 里某个常量"的重定位就是引用它。
///
/// ⚠ 名字必须**按对象**唯一：只用节号的话，两个对象各有 `.rodata` 时第二个会被
/// "先来的为准"挡掉、指到**第一个对象的节**上（静默算错地址）。参考实现同一条理由。
fn put_secname(t: ptr, at: u32, oi: u32, shndx: u32) -> u32 {
    if at + 4 >= IN_CAP {
        return fail("the input buffer has no room left for section symbol names");
    }
    store8(t, at, 36 as u8);              // '$'
    store8(t, at + 1, oi as u8);
    store8(t, at + 2, 46 as u8);          // '.'
    store8(t, at + 3, shndx as u8);
    return at + 4;
}

fn sh_num(raw: ptr) -> u32 {
    return rd16(raw, 60);
}

/// 第 k 节的**节名**在文件里的偏移 (取自 .shstrtab)。
fn sec_name(raw: ptr, k: u32) -> u32 {
    return sh_off(raw, rd16(raw, 62)) + load32(raw, sec_hdr(raw, k));
}

/// `.text` 或 `.text.*` —— 见上面"为什么必须认 .text.*"。
fn is_code_sec(raw: ptr, noff: u32) -> u32 {
    if load8(raw, noff) != 46 || load8(raw, noff + 1) != 116 || load8(raw, noff + 2) != 101
        || load8(raw, noff + 3) != 120 || load8(raw, noff + 4) != 116 {
        return 0;
    }
    if load8(raw, noff + 5) == 0 || load8(raw, noff + 5) == 46 {
        return 1;
    }
    return 0;
}

fn has_code(raw: ptr) -> u32 {
    let ns: u32 = sh_num(raw);
    let i: u32 = 0;
    while i < ns {
        if sh_type(raw, i) == 1 && is_code_sec(raw, sec_name(raw, i)) == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 第 k 节在**拼接后的外部代码**里的起点: 它之前每个代码节先对齐 16 再累加长度。
/// 与参考实现里 `while len(buf) % 16: buf.append(0); s["at"] = len(buf)` 同一件事。
fn sec_at(raw: ptr, k: u32) -> u32 {
    let cur: u32 = 0;
    let i: u32 = 0;
    while i < k {
        if sh_type(raw, i) == 1 && is_code_sec(raw, sec_name(raw, i)) == 1 {
            cur = align_to(cur, 16) + sh_size(raw, i);
        }
        i = i + 1;
    }
    return align_to(cur, 16);
}

// ---------------------------------------------------------------- 外部符号名 (declare)

fn ext_add(tab: ptr, noff: u32, nlen: u32) {
    let k: u32 = cell(tab, C_NEXT);
    let base: u32 = TB_EXT + k * 8;
    store32(tab, base + E_NOFF, noff);
    store32(tab, base + E_NLEN, nlen);
    setcell(tab, C_NEXT, k + 1);
}

fn ext_has(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NEXT);
    while k < n {
        let base: u32 = TB_EXT + k * 8;
        if span_eq(t, load32(tab, base + E_NOFF), load32(tab, base + E_NLEN), noff, nlen) == 1 {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

/// 扫 `declare` 行, 记下外部符号名 (docs/173)。`llvm.*` **不是外部函数**: 运行期块里有
/// `declare void @llvm.trap()`, 而 do_call 对它是特判 (发 ud2)。把它收进来会抢进 C ABI
/// 那条路, 于是 `call llvm.trap` 在回填时报"未定义的标签" —— 参考侧实测把 elf 判据从
/// 7/7 打到 4/7。所以这里滤掉 (除 llvm.* 之外没有别的内建 declare)。
fn collect_externs(tab: ptr, t: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        let le: u32 = line_end(t, i, n);
        let ls: u32 = skip_sp(t, i, le);
        if lit_at(t, ls, le, "declare ") == 1 {
            let j: u32 = ls + 8;
            while j < le && load8(t, j) != 64 {
                j = j + 1;
            }
            if j < le {
                let ne: u32 = word_end(t, j + 1, le);
                if lit_at(t, j + 1, ne, "llvm.") == 0 {
                    ext_add(tab, j + 1, ne - (j + 1));
                }
            }
        }
        i = le + 1;
    }
}

// ---------------------------------------------------------------- C ABI 调用点 (docs/173)

/// System V AMD64 整数实参寄存器: rdi rsi rdx rcx r8 r9。我们**自己的**约定是实参走栈,
/// 这一套只给 extern 调用点。
fn c_arg_reg(k: u32) -> u32 {
    if k == 0 {
        return RDI;
    }
    if k == 1 {
        return RSI;
    }
    if k == 2 {
        return RDX;
    }
    if k == 3 {
        return RCX;
    }
    if k == 4 {
        return R8;
    }
    return R9;
}

/// extern 调用: 实参进寄存器, 不走我们自己的栈约定。
///
/// 求值顺序**从右往左**: 逐个算进 RAX 再 push, 然后**从左往右** pop 进目标寄存器 ——
/// 这样 push 完栈顶正好是第 0 个实参, pop 的先后与寄存器顺序自然对齐。**不能**直接
/// 一个个 `emit_get(..., RDI)`: emit_get 内部要用 RAX/RCX 求值, 会把前面已经放好的
/// 寄存器踩掉。
///
/// flags: bit0 = 有返回值, bit1 = 返回值是聚合 (第 1 阶段直接拒)。
fn do_call_extern(tab: ptr, out: ptr, c: u32, t: ptr, lp: u32, rp: u32, nargs: u32,
                  cs: u32, ce: u32, flags: u32) -> u32 {
    if nargs > 6 {
        return fail("extern call: stage 1 takes at most 6 arguments");
    }
    if flags % 4 >= 2 {
        return fail("extern call: stage 1 does not take an aggregate return value");
    }
    let d: u32 = c;
    let q: u32 = nargs;
    while q > 0 {
        q = q - 1;
        let a2: u32 = arg_start(t, lp, rp, q);
        let ts: u64 = type_span(t, a2, rp);
        let to: u32 = hi32(ts);
        let tl: u32 = lo32(ts);
        if is_agg(t, to, tl) == 1 {
            return fail("extern call: stage 1 does not take an aggregate argument");
        }
        let vs: u32 = skip_sp(t, to + tl, rp);
        let ve: u32 = word_end(t, vs, rp);
        d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        d = em_push(out, d, RAX);
    }
    let k: u32 = 0;
    while k < nargs {
        d = em_pop(out, d, c_arg_reg(k));
        k = k + 1;
    }
    // ⚠ **C ABI 要求 `call` 那一刻 `rsp ≡ 0 (mod 16)`**（System V）—— 与参考实现
    // `tools/lomelf.py` 的 `_call` 同一处、同三条、同序。不修的话，**任何用到 16 字节 SSE
    // 存的 C 函数当场 `#GP`**（`si_code=SI_KERNEL`、`si_addr=NULL` —— 那不是段越界，是
    // **对不齐**）：实测 zlib 的 `compress` 就死在 `movaps %xmm0,-0x70(%rbp)` 上
    // （`FujoJTOP/loment#359`）。用 RBX 存原 rsp：SysV 的**被调方保存**寄存器，C 返回时
    // 仍是原值；而 Loment 生成的代码不用 rbx。这三条之间只有这一次 C 调用（实参早已求值完、
    // 压弹已平衡），所以嵌套调用踩不到它 —— **对齐必须是 `call` 前的最后一步**。
    d = em_mov_rr(out, d, RBX, RSP, 1);
    d = em_alu_ri(out, d, AND_, RSP, 4294967280);
    d = em_call_lbl(out, d, tab, cs + 1, ce - cs - 1);
    d = em_mov_rr(out, d, RSP, RBX, 1);
    // **返回值照旧落回目标槽** —— 与内部调用同一步。少了这一句, 调用结果**丢掉**, 后面
    // 读到的是那个槽的旧值: 症状是"程序能跑、结果是假 0" (参考侧实测第一版就是这样:
    // `c_add(3,4) + c_mul(5,6)` 退出码 0 而不是 37)。
    if flags % 2 == 1 {
        d = emit_put(tab, out, d, t, cell(tab, C_DESTO), cell(tab, C_DESTL), RAX);
    }
    return d;
}

// ---------------------------------------------------------------- 读一个外部目标文件

/// 读 `path` 那个 `.o`, 把它的代码节接到代码缓冲之后, 并为它导出的符号立标签。
/// 返回新的代码缓冲游标。四条边界都是**硬失败** (与参考实现同口径, docs/173 §3)。
/// 这个节是不是"**要处理的**重定位节"：SHT_RELA、非空、而且**被重定位的那个节不是
/// 元数据节**。
///
/// 元数据节（`.eh_frame` / `.debug*` / `.comment` / `.note`）我们**不摆**，代码也引用不到
/// 它们 —— 它们上面的重定位**丢掉无损**。这与参考实现 `_META_SEC` 那条一一对应。
///
/// ⚠ **不排除的话，自举侧会硬拒任何一个 clang 编出来的 `.o`**：它们都带
/// `.rela.eh_frame`。参考侧照收、自举侧当场报"重定位指向非代码节" —— 两侧在
/// "能链什么"上直接分叉（`FujoJTOP/loment#359` 实测到的第二条不一致）。
///
/// ⚠ 类型与长度先判、再去读 `sh_info` —— **不靠 `&&` 短路**（自举侧两个操作数都会被求值，
/// 于是 `sec_name` 会拿着一个非 RELA 节的 `sh_info` 去读名字）。
fn is_rela_to_lay(raw: ptr, k: u32, ns: u32) -> u32 {
    if sh_type(raw, k) != 4 { return 0; }
    if sh_size(raw, k) == 0 { return 0; }
    let tgt: u32 = sh_info(raw, k);
    if tgt >= ns { return 1; }              // 越界的目标：留给原来那条错误分支去报
    if is_meta_sec(raw, sec_name(raw, tgt)) == 1 { return 0; }
    return 1;
}

/// 读一个 `--link` 文件进缓冲，返回字节数。**读不了就死在这里**（名字说到 `path` 上）——
/// 所以返回值永远是"真的读到了这么多"。
///
/// 与"这个文件是什么"分开（`peek_vs_obj` / `check_obj`）：归档与目标文件都要先读进来才能
/// 看魔数，两者读法一模一样。
fn read_link_file(path: ptr, buf: ptr, cap: u32) -> u32 {
    let fd: i64 = open_ro(path);
    if fd < 0 {
        return failc("cannot open the foreign object file: ", path);
    }
    let rn: u64 = read_all(fd as u64, buf, cap as u64);
    syscall4(3, fd as u64, 0, 0);
    if rn == 0 {
        return failc("the foreign object file is empty: ", path);
    }
    if rn >= (cap as u64) {
        return failc("the foreign object file is larger than the 4 MiB limit: ", path);
    }
    return lo32(rn);
}

/// 这个文件是 `ar` 归档吗 —— 看**内容**不看后缀（`.a`/`.o`/无后缀在各家工具链里并不统一，
/// 而两个魔数都极短且不可能互串）。参考实现 `load_foreign` 同一条。
fn is_archive(mem: ptr, n: u32) -> u32 {
    if n < 8 {
        return 0;
    }
    if load8(mem, 0) != 33 || load8(mem, 1) != 60 {
        return 0;
    }
    if load8(mem, 2) != 97 || load8(mem, 3) != 114 {
        return 0;
    }
    if load8(mem, 4) != 99 || load8(mem, 5) != 104 || load8(mem, 6) != 62 {
        return 0;
    }
    return 1;
}

/// 直接给的 `.o` 的校验（归档成员不在这里 —— 它们用不了时是**当它不在池子里**，
/// 那是 `obj_usable` 的事）。三条判据与参考实现 `ForeignObject._load` 抛 `Unsupported`
/// 的那几处逐字相同。
fn check_obj(path: ptr, mem: ptr) -> u32 {
    if load8(mem, 0) != 127 || load8(mem, 1) != 69 || load8(mem, 2) != 76
        || load8(mem, 3) != 70 || load8(mem, 4) != 2 || load8(mem, 5) != 1 {
        return failc("not an ELF64 little-endian object file: ", path);
    }
    if rd16(mem, 16) != 1 {
        return failc("not a relocatable object file (ET_REL): ", path);
    }
    if has_code(mem) == 0 {
        return failc("the object file has no code section (.text / .text.*): ", path);
    }
    return 0;
}

/// 摆一个**已经在内存里**的外部对象：代码节接在自己的代码之后、数据节接在数据段之后、
/// 导出符号立标签、重定位登记下来（应用要等所有对象都摆好，见 `apply_relocs`）。
///
/// **归档成员走这里**（`docs/173` 阶段 2）：它们没有自己的文件，字节是从 `.a` 里拷进
/// `M_OBJ` 的。与"从文件读"那一半（`link_object`）分开，是因为两处**只有读的那一段不同**
/// —— 校验、摆节、立标签、端口门计数全在这一半里，两侧共用同一份（"逐条镜像"那条纪律：
/// 多一份就是多一份要同时改的东西）。
fn link_object_mem(tab: ptr, t: ptr, txt: ptr, gb: ptr, d: u32, mem: ptr, ap: u32) -> u32 {
    // **未定义符号在这里不再是错误** (阶段 2): 它可能由**另一个对象**提供 —— 那正是多目标
    // 文件 C 库的形状 (`a.o` 调 `b.o`)。判定推迟到"所有对象都摆好、重定位都应用完"。
    // 之前那两段 (未定义就报错 / 见重定位就报错) 是在没有重定位能力时的硬拒; 现在两条都
    // 换成了**真的去做**, 做不出来才报 —— 免得从"硬拒"退化成"静默忽略重定位"(那是错编)。
    let ns: u32 = sh_num(mem);
    // 接在我们自己的代码之后（按对象代码节的**最大对齐要求**，至少 16；`#612`）。
    // **先拼字节, 再立标签** —— 标签地址 = 起点 + 节错 + 符号值, 所以要先把每节的起点算出来。
    let tmax: u32 = 16;
    let iq: u32 = 0;
    while iq < ns {
        if sh_type(mem, iq) == 1 && is_code_sec(mem, sec_name(mem, iq)) == 1 {
            let al: u32 = sh_align(mem, iq);
            if al > tmax { tmax = al; }
        }
        iq = iq + 1;
    }
    let at0: u32 = align_to(d, tmax);
    pad_zero(txt, d, at0);
    // 记下这个对象的代码在缓冲里的起点 —— 重定位要按它算 `S + A - P`, 而**应用**要等到
    // 所有对象都摆好 (见 apply_relocs)。
    let oi: u32 = cell(tab, C_NOBJ);
    store32(tab, TB_OBJ + oi * 8 + O_TEXT, at0);
    setcell(tab, C_NOBJ, oi + 1);
    let dd: u32 = at0;
    let i3: u32 = 0;
    while i3 < ns {
        if sh_type(mem, i3) == 1 && is_code_sec(mem, sec_name(mem, i3)) == 1 {
            let al3: u32 = sh_align(mem, i3);
            if al3 < 16 { al3 = 16; }
            let nd: u32 = align_to(dd, al3);
            pad_zero(txt, dd, nd);
            dd = nd;
            copy_n(txt, dd, mem, sh_off(mem, i3), sh_size(mem, i3));
            dd = dd + sh_size(mem, i3);
        }
        i3 = i3 + 1;
    }
    // **数据节**（`docs/219` §8b 第 1 条）：接在**数据缓冲** `gb` 的当前游标之后。
    // 真实 C 库的字符串常量、常量表、结构体都在这里；不摆它们，代码里那条
    // `lea rdi, [rip + .L.str]` 就没有标签可指（症状是"引用了未定义的符号 .L.str"，
    // 一句"不支持的节"都看不到 ⇒ 这是**读得进来**的门槛，不是摆放的门槛）。
    // `.bss`(NOBITS) 按零字节摆进数据段（与参考实现同一取舍，代价是文件变大）。
    let dmax: u32 = 16;
    let iq2: u32 = 0;
    while iq2 < ns {
        if is_data_sec(mem, iq2) == 1 {
            let al4: u32 = sh_align(mem, iq2);
            if al4 > dmax { dmax = al4; }
        }
        iq2 = iq2 + 1;
    }
    let gb0: u32 = align_to(cell(tab, C_GB), dmax);
    pad_zero(gb, cell(tab, C_GB), gb0);
    let db: u32 = gb0;
    let i6: u32 = 0;
    while i6 < ns {
        if is_data_sec(mem, i6) == 1 {
            let al5: u32 = sh_align(mem, i6);
            if al5 < 16 { al5 = 16; }
            let nd2: u32 = align_to(db, al5);
            pad_zero(gb, db, nd2);
            db = nd2;
            if sh_type(mem, i6) == 1 {
                copy_n(gb, db, mem, sh_off(mem, i6), sh_size(mem, i6));
            } else {
                pad_zero(gb, db, db + sh_size(mem, i6));
            }
            db = db + sh_size(mem, i6);
        }
        i6 = i6 + 1;
    }
    setcell(tab, C_GB, db);
    store32(tab, TB_OBJ + oi * 8 + O_DATA, gb0);
    // **端口门**（`docs/222` §4，2026-10-12 用户定）：本对象里未定义符号的条数 ——
    // 判据与参考实现 `tools/lomelf.py` 的 `ForeignObject.undefined` 逐字相同
    // （`shndx == 0` 且 GLOBAL/WEAK 且有名字）。见下面那个 `else if`。
    let np: u32 = 0;
    let i4: u32 = 0;
    while i4 < ns {
        if sh_type(mem, i4) == 2 {
            let link2: u32 = sh_link(mem, i4);
            if link2 < ns {
                let stro2: u32 = sh_off(mem, link2);
                let so2: u32 = sh_off(mem, i4);
                let cnt2: u32 = sh_size(mem, i4) / 24;
                let k2: u32 = 0;
                while k2 < cnt2 {
                    let o2: u32 = so2 + k2 * 24;
                    let nmoff2: u32 = load32(mem, o2);
                    let shndx: u32 = rd16(mem, o2 + 6);
                    // **`st_info` 的高 4 位是绑定, 低 4 位是类型** (`(bind << 4) | type`)。
                    // 原文这里是 `% 16` —— 取到的是**类型**: 收定义时靠"类型是 FUNC/OBJECT"
                    // 误打误撞能对, 但判"未定义的符号是不是全局的"就整个失效 (实测它让归档的
                    // 固定点选不出成员)。与参考实现同一次修掉。
                    let bind: u32 = (load8(mem, o2 + 4) as u32) / 16;
                    // GLOBAL(1) / WEAK(2), 且落在某个代码节里。shndx 可以是保留值
                    // (SHN_ABS=0xfff1 等), 比节表长 —— 直接拿去索引会读飞, 所以先比大小。
                    if shndx != 0 && shndx < ns {
                        let code_sec: u32 = 0;
                        if sh_type(mem, shndx) == 1
                            && is_code_sec(mem, sec_name(mem, shndx)) == 1 {
                            code_sec = 1;
                        }
                        if code_sec == 1 && nmoff2 != 0 && (bind == 1 || bind == 2) {
                            // 名字必须拷进**输入缓冲尾部**的名字池: 标签表存的是偏移, 而
                            // lbl_find 拿输入缓冲当基 —— 名字留在 .o 的缓冲里, 下一个 .o
                            // 一读进来就被盖掉了。
                            let noff: u32 = copy_name(tab, t, mem, stro2 + nmoff2);
                            let nl: u32 = cstr_len(mem, stro2 + nmoff2);
                            if lbl_find(tab, t, noff, nl, 0, 0) == NO {
                                let val: u32 = lo32(rd64(mem, o2 + 8));
                                lbl_add(tab, noff, nl, 0, 0,
                                        TEXT_VADDR + at0 + sec_at(mem, shndx) + val);
                            }
                        } else if code_sec == 1 || is_data_sec(mem, shndx) == 1 {
                            // **数据节里的符号一律收（含局部）**：`.L.str` 就是 `bind=0` 的
                            // `STT_OBJECT`；**节符号**（`st_name` 为 0）两边都给一个按对象
                            // 唯一的合成名（参考实现 `$<对象名>$sec<k>`，这里 `$<对象号>.<节号>`）
                            // —— 名字不进产物，两侧只要各自自洽。
                            let noff: u32 = 0;
                            let nl: u32 = 0;
                            if nmoff2 == 0 {
                                // ⚠ `put_secname` 返回的是**末尾**（好推进游标）—— 标签名要的是
                                // **起点**，所以两处必须分开取。写成 `noff = put_secname(...)`
                                // 会让标签名读成名字**后面**那 4 个字节，于是登记与查找各落在
                                // 不同位置、永远对不上（实测就是这么红的）。
                                let cur: u32 = cell(tab, C_EXTN);
                                noff = cur;
                                nl = 4;
                                setcell(tab, C_EXTN, put_secname(t, cur, oi, shndx));
                            } else {
                                // **局部**（`bind == 0`）一律**按对象改名** —— 与参考实现
                                // 同一条、与查找处同一个函数。见 `copy_local_name` 的说明。
                                if bind == 0 {
                                    noff = copy_local_name(tab, t, mem, stro2 + nmoff2, oi);
                                    nl = cstr_len(mem, stro2 + nmoff2) + LOCAL_PREFIX;
                                } else {
                                    noff = copy_name(tab, t, mem, stro2 + nmoff2);
                                    nl = cstr_len(mem, stro2 + nmoff2);
                                }
                            }
                            if lbl_find(tab, t, noff, nl, 0, 0) == NO {
                                let val: u32 = lo32(rd64(mem, o2 + 8));
                                if code_sec == 1 {
                                    lbl_add(tab, noff, nl, 0, 0,
                                            TEXT_VADDR + at0 + sec_at(mem, shndx) + val);
                                } else {
                                    lbl_add(tab, noff, nl, 0, 0,
                                            data_base(tab) + gb0 + dsec_at(mem, shndx) + val);
                                }
                            }
                        }
                    } else if shndx == 0 {
                        // **未定义符号**：数一条。只要有一条，这个对象就带着**通向世界的
                        // 端口**（`docs/222` §4 那一维的价）—— 那条路还没完工
                        // （`docs/219` §8b 的 S2），所以下面**默认拒**。
                        // **自闭合的对象走不到这里**：`docs/173` 一直在发的 FFI 形状、
                        // `docs/177` 那 10 个语言，对象里一条未定义符号都没有。
                        if nmoff2 != 0 && (bind == 1 || bind == 2) {
                            np = np + 1;
                        }
                    }
                    k2 = k2 + 1;
                }
            }
        }
        i4 = i4 + 1;
    }
    // **端口门**：这个对象带端口、而调用方没有显式放开 ⇒ **点名拒**（不是静默丢掉那些
    // 符号 —— 丢掉会在回填时报一句"引用了未定义的符号"，用户看到的是"符号找不到"而不是
    // "这扇门关着"，方向完全错了）。放开只有一条路：`--allow-ports`。
    //
    // **`#406` 开闸（2026-10-17）之后默认仍然是拒**：链接器不知道渠道（它是一只被启动器
    // 调起来的独立工具），所以"默认拒 + 启动器显式开"这条形状不变 —— 变的是启动器**两个
    // 渠道都传那面旗**（`tools/loment_dist.py`）。与参考实现同一条口径。
    if ap == 0 && np != 0 {
        wstr(2, "loment: this foreign object carries undefined symbols (ports to the outside world),
");
        wstr(2, "and the linker does not take those by default. The linker does not know the channel
");
        wstr(2, "(it is a standalone tool the launcher calls), so the default is always to refuse;
");
        wstr(2, "both channels' launchers pass --allow-ports (docs/222 sec 4.5, opened 2026-10-17).
");
        wstr(2, "Calling this linker directly needs the flag. A self-contained object (one with no
");
        wstr(2, "undefined symbols) is unaffected.
");
        return die(1);
    }
    // 重定位**只记不应用** (docs/173 阶段 2): 应用要等所有对象都摆好、标签都立好 ——
    // `a.o` 里的重定位可能指向只有 `b.o` 知道的地址。只认参考实现认的那六种; 其余**硬拒**
    // (不认识的类型猜一个偏移 = 跳到错地址, 那是运行期崩溃不是编译期报错)。落在非代码节上的
    // 也拒 —— 本档不摆那些节, 静默算出来的地址是错的。
    let i5: u32 = 0;
    while i5 < ns {
        if is_rela_to_lay(mem, i5, ns) == 1 {
            let tgt: u32 = sh_info(mem, i5);                  // sh_info = 被重定位的节
            let in_data: u32 = 0;
            if tgt < ns && is_data_sec(mem, tgt) == 1 {
                in_data = 1;                                  // 落在数据节上: 写 gb
            } else if tgt >= ns || sh_type(mem, tgt) != 1
                || is_code_sec(mem, sec_name(mem, tgt)) == 0 {
                wstr(2, "loment: a relocation points at a section that is neither code nor data\n");
                return die(1);
            }
            let tsecat: u32 = sec_at(mem, tgt);
            if in_data == 1 {
                tsecat = dsec_at(mem, tgt);
            }
            // **两个不同的偏移, 别搞混** (第一版就在这里错了两次):
            //   `symsec` 是**符号表**节号; 符号记录在 `sh_off(symsec) + 下标*24`;
            //   名字串却在**它 `sh_link` 指向的 `.strtab`** 里 —— 与符号表**不是同一节**。
            //   拿符号表的偏移去查名字, 得到的是空串或垃圾, 报错里就印出一串乱码/空白。
            let symsec: u32 = sh_link(mem, i5);
            let symoff0: u32 = sh_off(mem, symsec);
            let stro3: u32 = sh_off(mem, sh_link(mem, symsec));
            let ents: u32 = sh_size(mem, i5) / 24;
            let k5: u32 = 0;
            while k5 < ents {
                let o5: u32 = sh_off(mem, i5) + k5 * 24;
                let roff: u32 = lo32(rd64(mem, o5));
                let rinfo: u64 = rd64(mem, o5 + 8);
                let ty: u32 = lo32(rinfo);
                let si: u32 = hi32(rinfo);
                if ty != 1 && ty != 2 && ty != 4 && ty != 10 && ty != 11 && ty != 24 {
                    wstr(2, "loment: unknown relocation type (docs/173 section 3)\n");
                    return die(1);
                }
                let symoff: u32 = symoff0 + si * 24;
                let nmoff3: u32 = load32(mem, symoff);
                let noff3: u32 = 0;
                let nlen3: u32 = 0;
                if nmoff3 == 0 {
                    // **节符号**：`st_name` 是 0，名字靠 `shndx` 认 —— 与上面登记时
                    // 同一套按对象唯一的合成名（两边必须用同一个，否则查不到）。
                    // ⚠ 与登记处同一条：起点与游标是两个值，别把返回值当起点。
                    let cur: u32 = cell(tab, C_EXTN);
                    noff3 = cur;
                    nlen3 = 4;
                    setcell(tab, C_EXTN, put_secname(t, cur, oi, rd16(mem, symoff + 6)));
                } else {
                    // **与登记处同一套**：局部符号按对象改名（`bind` 在符号记录的第 4 字节
                    // 高 4 位）。两处必须一致，否则查不到 —— 见 `copy_local_name`。
                    if (load8(mem, symoff + 4) as u32) / 16 == 0 {
                        nlen3 = cstr_len(mem, stro3 + nmoff3) + LOCAL_PREFIX;
                        noff3 = copy_local_name(tab, t, mem, stro3 + nmoff3, oi);
                    } else {
                        nlen3 = cstr_len(mem, stro3 + nmoff3);
                        noff3 = copy_name(tab, t, mem, stro3 + nmoff3);
                    }
                }
                let fi: u32 = cell(tab, C_NFREL);
                let fb: u32 = TB_FREL + fi * 32;
                store32(tab, fb + F2_OBJ, oi);
                store32(tab, fb + F2_AT, tsecat);
                store32(tab, fb + F2_OFF, roff);
                store32(tab, fb + F2_TY, ty);
                store32(tab, fb + F2_NOFF, noff3);
                store32(tab, fb + F2_NLEN, nlen3);
                store32(tab, fb + F2_ADD, lo32(rd64(mem, o5 + 16)));
                store32(tab, fb + F2_IN, in_data);
                setcell(tab, C_NFREL, fi + 1);
                k5 = k5 + 1;
            }
        }
        i5 = i5 + 1;
    }
    return dd;
}

// ---------------------------------------------------------------- ar 归档 (docs/173 阶段 2)

/// `ar` 归档里挑成员 —— **定点选择**，与参考实现 `Archive.select` 逐条同义
/// （`docs/219` §8b 的 S2；`FujoJTOP/loment#405`）。
///
/// 规则：某成员**定义**了当前需要集里的某个符号就收它，收完把它**未定义**的符号也加进
/// 需求，重复到不再变化。**不整包收** —— 整包收会把 `gz*` 那些成员的 `fopen`/`printf`
/// 一并拖进来，于是端口门把**整个库**拒掉。真库里几乎总有那么一两个成员带着无关的 libc
/// 依赖，所以"多目标文件 C 库"这条判据能不能过，就看这一条选得对不对。
///
/// **三件事要按参考实现的那个次序来**（次序不同，产物就不同）：
///   ① 需要集从一开始就是 `IR 里 declare 的外部符号 ∪ 直接给的 .o 的未定义符号`；
///   ② 每一趟**按归档顺序**扫还没被收的成员；
///   ③ 被收下的成员**按收下的次序**排（不是按归档里的次序）。
///
/// 名字一律先拷进名字池（`copy_name`）再进需要集：成员的名字活在归档缓冲里，而下一趟
/// 拷成员进 `M_OBJ` 就会把它盖掉。
fn need_add(tab: ptr, t: ptr, noff: u32, nlen: u32) {
    let k: u32 = cell(tab, C_NNEED);
    if k >= NEED_MAX {
        // 点名拒（"超限报错退出，绝不静默丢"）。真库的需要集是几十个量级；到这里说明
        // 来的不是"一个库"，那也不该悄悄少挑几个成员。
        let _f: u32 = fail("more needed symbols than the table holds (NEED_MAX) -- the object file is too large for this linker");
    }
    let base: u32 = TB_NEED + k * 8;
    store32(tab, base + E_NOFF, noff);
    store32(tab, base + E_NLEN, nlen);
    setcell(tab, C_NNEED, k + 1);
}

/// 两个**不同缓冲**里的名字相等吗。`span_eq` 只在**同一个**缓冲里比，而"需要集"的名字
/// 住在输入缓冲（名字池）里、"成员"的名字住在 `M_OBJ` 里 —— 两边不同缓冲，拿 `span_eq`
/// 去比就是拿 `M_OBJ` 的偏移去索引输入缓冲：**实测**它一个成员都挑不出来（症状是
/// "未定义的标签: compress"，而归档那一段一句话都没说）。
fn nm_eq(pa: ptr, a: u32, alen: u32, pb: ptr, b: u32, blen: u32) -> u32 {
    if alen != blen {
        return 0;
    }
    let k: u32 = 0;
    while k < alen {
        if load8(pa, a + k) != load8(pb, b + k) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

fn need_has(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NNEED);
    while k < n {
        let base: u32 = TB_NEED + k * 8;
        if span_eq(t, load32(tab, base + E_NOFF), load32(tab, base + E_NLEN), noff, nlen) == 1 {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

/// 把一个名字从**别的缓冲**（`p`）拷进名字池再加进需要集 —— 成员的名字都在归档缓冲或
/// `M_OBJ` 里，两者都会被下一趟覆盖。
fn need_add_ptr(tab: ptr, t: ptr, p: ptr, off: u32) {
    let nlen: u32 = cstr_len(p, off);
    let noff: u32 = copy_name(tab, t, p, off);
    need_add(tab, t, noff, nlen);
}

/// 需要集的**起点**：这份 IR 里 `declare` 的那些外部符号（`TB_EXT` 里已经有它们了 ——
/// 参考实现同一个来源：`{x for x in externs if not x.startswith("llvm.")}`）。
fn need_from_externs(tab: ptr, t: ptr) {
    let k: u32 = 0;
    let n: u32 = cell(tab, C_NEXT);
    while k < n {
        let base: u32 = TB_EXT + k * 8;
        need_add(tab, t, load32(tab, base + E_NOFF), load32(tab, base + E_NLEN));
        k = k + 1;
    }
}

/// 一个成员（或直接给的 `.o`）**能不能用**：与参考实现 `ForeignObject._load` 抛
/// `Unsupported` 的那几处同一条判据（ELF64 小端、`ET_REL`、有代码节）。用不了的在定点那
/// 一趟里**当它不在池子里** —— 参考实现就是 `except Unsupported: continue`。
fn obj_usable(mem: ptr) -> u32 {
    if load8(mem, 0) != 127 || load8(mem, 1) != 69 || load8(mem, 2) != 76 {
        return 0;
    }
    if load8(mem, 3) != 70 || load8(mem, 4) != 2 || load8(mem, 5) != 1 {
        return 0;
    }
    if rd16(mem, 16) != 1 {
        return 0;
    }
    return has_code(mem);
}

/// 扫一个对象的符号表：**是否定义了需要集里的某个符号**（定义在代码节里的 GLOBAL/WEAK，
/// 与参考实现的 `syms` 同一个口径），顺带（`add`）把它的**未定义**符号加进需要集
/// （GLOBAL/WEAK 且 `shndx == 0`，与 `undefined` 同一个口径）。
///
/// 两者放在一趟里，是因为两处在符号表上的走法**逐字相同** —— 分成两个函数就是两份要走偏
/// 的代码，而这个文件里"两份要走偏的代码"正是判据要挡的东西。
fn obj_syms(tab: ptr, t: ptr, mem: ptr, add: u32) -> u32 {
    let ns: u32 = sh_num(mem);
    let hit: u32 = 0;
    let i4: u32 = 0;
    while i4 < ns {
        if sh_type(mem, i4) == 2 {
            let link2: u32 = sh_link(mem, i4);
            if link2 < ns {
                let stro2: u32 = sh_off(mem, link2);
                let so2: u32 = sh_off(mem, i4);
                let cnt2: u32 = sh_size(mem, i4) / 24;
                let k2: u32 = 0;
                while k2 < cnt2 {
                    let o2: u32 = so2 + k2 * 24;
                    let nmoff2: u32 = load32(mem, o2);
                    let shndx: u32 = rd16(mem, o2 + 6);
                    let bind: u32 = (load8(mem, o2 + 4) as u32) / 16;
                    if nmoff2 != 0 && (bind == 1 || bind == 2) {
                        if shndx == 0 {
                            if add == 1 {
                                let uoff: u32 = copy_name(tab, t, mem, stro2 + nmoff2);
                                let ulen: u32 = cstr_len(mem, stro2 + nmoff2);
                                if need_has(tab, t, uoff, ulen) == 0 {
                                    need_add(tab, t, uoff, ulen);
                                }
                            }
                        } else if shndx < ns {
                            if sh_type(mem, shndx) == 1
                                && is_code_sec(mem, sec_name(mem, shndx)) == 1 {
                                // **只在名字对得上时才拷**：这一趟是热路径上的，
                                // 每个成员几十条符号。
                                let dlen: u32 = cstr_len(mem, stro2 + nmoff2);
                                let k3: u32 = 0;
                                let nn: u32 = cell(tab, C_NNEED);
                                while k3 < nn {
                                    let b3: u32 = TB_NEED + k3 * 8;
                                    let poff: u32 = load32(tab, b3 + E_NOFF);
                                    let plen: u32 = load32(tab, b3 + E_NLEN);
                                    if nm_eq(t, poff, plen, mem, stro2 + nmoff2, dlen) == 1 {
                                        hit = 1;
                                    }
                                    k3 = k3 + 1;
                                }
                            }
                        }
                    }
                    k2 = k2 + 1;
                }
            }
        }
        i4 = i4 + 1;
    }
    return hit;
}

/// `ar` 头：60 字节，长度在 48..58（十进制文本）、以 `` `\n ``（0x60 0x0A）收尾。
/// 返回 `下一成员头 << 32 | 成员长度`；**走到了尾返回 0**。
///
/// 两种"不对"要分开：**尾**（`pos + 60 > n`，返回 0，调用方收工）与**头损坏**（还在中间
/// 却不以 `` `\n `` 收尾、或长度不是数字）—— 后者**点名拒**，与参考实现
/// `归档成员头损坏` / `归档成员长度不是数字` 同一处置（静默停下会让"少摆几个成员"以
/// "未定义的标签"的形式在**别处**冒出来，方向就错了）。
fn ar_member(mem: ptr, pos: u32, n: u32) -> u64 {
    if pos + 60 > n {
        return 0;
    }
    if load8(mem, pos + 58) != 96 || load8(mem, pos + 59) != 10 {
        let _f: u32 = fail("the archive member header is corrupt (it does not end with a newline)");
    }
    // 长度格是十进制文本，填法是空格；**两边的空格都跳**（GNU 右填、别的实现左填），
    // 与参考实现的 `int(s.strip())` 同一个宽容度。
    let s0: u32 = pos + 48;
    let s1: u32 = s0 + 10;
    let sz: u32 = 0;
    let nd: u32 = 0;
    let d: u32 = s0;
    while d < s1 {
        let c: u32 = load8(mem, d);
        if c >= 48 && c <= 57 {
            sz = sz * 10 + (c - 48);
            nd = nd + 1;
        }
        d = d + 1;
    }
    if nd == 0 {
        let _f: u32 = fail("the archive member length is not a number");
    }
    // 数据按**偶数**对齐：奇数长度补一个字节（ar 的规定，不是我们挑的）。
    // 打包：高 32 位 = **下一成员头**的位置，低 32 位 = 成员长度（不含那个填充字节）。
    // 数据起点不放进包里 —— 调用方手里就有 `pos`，`pos + 60` 比解包更省。
    return ((pos + 60 + sz + (sz % 2)) as u64) * 4294967296 + sz as u64;
}

/// **挑成员并摆**（`docs/173` 阶段 2，`FujoJTOP/loment#405`）：定点选择，再按**挑中的次序**
/// 逐个摆。字节已经在 `arb` 里（调用方读过 —— 归档先读进 `M_OBJ` 看魔数，是归档再拷进
/// `M_AR`：`M_OBJ` 要留给成员自己，每个成员都要拷进去，那一整套 ELF 助手才用得上）。
fn link_archive(tab: ptr, t: ptr, txt: ptr, gb: ptr, d: u32, objs: ptr, arb: ptr,
                an: u32, ap: u32) -> u32 {
    // ---- 定点：反复扫整包，收"定义了需要集里某个符号"的成员，直到一趟收不到新的。
    // **一趟里按归档顺序收**、被收下的按收下的次序排 —— 与参考实现 `Archive.select` 的
    // 那两层循环逐条同义（次序不同，产物就不同）。
    let seen: u32 = 0;
    let changed: u32 = 1;
    while changed == 1 {
        changed = 0;
        let pos: u32 = 8;
        let go: u32 = 1;
        while go == 1 {
            let pack: u64 = ar_member(arb, pos, an);
            if pack == 0 {
                go = 0;
            } else {
                seen = seen + 1;
                let doff: u32 = pos + 60;
                let dlen: u32 = lo32(pack);
                if ar_is_elf(arb, doff) == 1 {
                    if ar_taken(tab, doff) == 0 {
                        // 成员拷进 `M_OBJ` 再扫 —— 那一整套 ELF 助手都按"对象在缓冲起点"
                        // 写的，参数化它们要动几十处调用点。
                        if dlen >= OBJ_CAP {
                            let _f: u32 = fail("an archive member is larger than the 4 MiB limit");
                        }
                        copy_n(objs, 0, arb, doff, dlen);
                        if obj_usable(objs) == 1 {
                            if obj_syms(tab, t, objs, 0) == 1 {
                                ar_take(tab, doff, dlen);
                                let _u: u32 = obj_syms(tab, t, objs, 1);
                                changed = 1;
                            }
                        }
                    }
                }
                pos = hi32(pack);
            }
        }
    }
    // **空归档**是错（参考实现：`归档里没有成员`），而"一个都没挑中"**不是** ——
    // 那说明这份归档里没有这个程序要的东西，后面按"未定义的标签"报出来，方向才对。
    if seen == 0 {
        wstr(2, "loment: the archive holds no members\n");
        return die(1);
    }
    // ---- 按**挑中的次序**摆（`TB_MEM` 里登记的就是那个次序）。
    let nmem: u32 = cell(tab, C_NMEM);
    let i: u32 = 0;
    let nd: u32 = d;
    while i < nmem {
        let base: u32 = TB_MEM + i * 8;
        let doff2: u32 = load32(tab, base + E_NOFF);
        let dlen2: u32 = load32(tab, base + E_NLEN);
        if dlen2 >= OBJ_CAP {
            let _f: u32 = fail("an archive member is larger than the 4 MiB limit");
        }
        copy_n(objs, 0, arb, doff2, dlen2);
        nd = link_object_mem(tab, t, txt, gb, nd, objs, ap);
        i = i + 1;
    }
    return nd;
}

fn ar_is_elf(arb: ptr, off: u32) -> u32 {
    if load8(arb, off) != 127 || load8(arb, off + 1) != 69 {
        return 0;
    }
    if load8(arb, off + 2) != 76 || load8(arb, off + 3) != 70 {
        return 0;
    }
    return 1;
}

/// 这个成员已经被挑过了吗（`TB_MEM` 里按数据起点查 —— 一趟里同一个起点只可能出现一次）。
fn ar_taken(tab: ptr, doff: u32) -> u32 {
    let i: u32 = 0;
    let n: u32 = cell(tab, C_NMEM);
    while i < n {
        let base: u32 = TB_MEM + i * 8;
        if load32(tab, base + E_NOFF) == doff {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn ar_take(tab: ptr, doff: u32, dlen: u32) {
    let k: u32 = cell(tab, C_NMEM);
    if k >= MEM_MAX {
        let _f: u32 = fail("the archive members picked exceed the limit (MEM_MAX) -- the archive is too large for this linker");
    }
    let base: u32 = TB_MEM + k * 8;
    store32(tab, base + E_NOFF, doff);
    store32(tab, base + E_NLEN, dlen);
    setcell(tab, C_NMEM, k + 1);
}

/// 应用外部目标文件的全部重定位。**必须在所有对象都摆好、标签都立好之后**跑 (docs/173 阶段 2)。
///
/// `PC64` 这里按**零扩展**写 (参考实现按有符号)。实测到不了这条路 —— 它只出现在数据节的
/// 64 位 PC 相对引用上, 而落在非代码节的重定位我们**一开始就拒了**。留个记号免得以后有人
/// 以为两边逐位一致。
fn apply_relocs(tab: ptr, t: ptr, txt: ptr, gb: ptr) -> u32 {
    let n: u32 = cell(tab, C_NFREL);
    let i: u32 = 0;
    while i < n {
        let base: u32 = TB_FREL + i * 32;
        let oi: u32 = load32(tab, base + F2_OBJ);
        let target: u32 = lbl_find(tab, t, load32(tab, base + F2_NOFF),
                                   load32(tab, base + F2_NLEN), 0, 0);
        if target == NO {
            // **到链接结束才判"没人定义"**: 这是"多目标文件 C 库"与"引用 libc"的分界线 ——
            // 前者由另一个对象提供, 后者到链接结束都空着。
            wstr(2, "loment: undefined symbol ");
            write_all(2, ptr_add(t, load32(tab, base + F2_NOFF)),
                      load32(tab, base + F2_NLEN) as u64);
            wstr(2, " -- nothing provides it by the end of the link (this stage still does not link libc)\n");
            return die(1);
        }
        // **两条路**（`docs/219` §8b 第 1 条）：`F2_IN` 说这条重定位的**落点**在哪 ——
        // 0 = 代码缓冲 `txt`（基址 `TEXT_VADDR`），1 = 数据缓冲 `gb`（基址 `data_base`）。
        // 算的是同一套 `S + A` / `S + A - P`，只是写到不同的缓冲、P 用不同的基址。
        let in_data: u32 = load32(tab, base + F2_IN);
        let site: u32 = 0;
        let p: u32 = 0;
        let buf: ptr = txt;
        if in_data == 1 {
            site = load32(tab, TB_OBJ + oi * 8 + O_DATA)
                   + load32(tab, base + F2_AT) + load32(tab, base + F2_OFF);
            p = data_base(tab) + site;
            buf = gb;
        } else {
            site = load32(tab, TB_OBJ + oi * 8 + O_TEXT)
                   + load32(tab, base + F2_AT) + load32(tab, base + F2_OFF);
            p = TEXT_VADDR + site;                            // 公式里的 P
        }
        let val: u32 = target + load32(tab, base + F2_ADD);   // 公式里的 S + A
        let ty: u32 = load32(tab, base + F2_TY);
        if ty == 2 || ty == 4 {
            store32(buf, site, val - p);                      // PC32 / PLT32
        } else if ty == 24 {
            w64(buf, site, (val - p) as u64);                 // PC64
        } else if ty == 1 {
            w64(buf, site, val as u64);                       // 64
        } else {
            store32(buf, site, val);                          // 32 / 32S
        }
        i = i + 1;
    }
    return 0;
}

/// 把外部符号名拷进输入缓冲尾部的名字池, 返回它在 `t` 里的偏移。
/// 把一个**局部**符号名按对象改名后放进名字池（`$` + 4 字节对象号 + 原名），返回**起点**。
///
/// **为什么必须改**（2026-10-15，`FujoJTOP/loment#359`）：`.LC0` / `.L.str` / `my_version`
/// 这种局部名字**每个成员里都有**，而标签表是**按名字**查的、而且"先来的为准" —— 不改名时，
/// 第二个成员的 `.LC0` 会解析到**第一个成员的** `.LC0` 上：**静默指错地址**，不报任何错。
/// 实测：zlib 的 `deflate.o` 排在 `zutil.o` 之前时，`zlibVersion()` 返回的指针就落到
/// deflate.o 的常量上。与上面那条节符号**同一个道理**（S1f 当时只修了节符号）。
///
/// ⚠ **登记处与查找处必须用这同一个函数**（`link_object` 与 `apply_relocs` 各一处）——
/// 只改一半的症状是"查不到"，与"静默指错"是两种不同的坏。
///
/// 前缀是**二进制**（不是十进制文本）：名字池里的条目是**按长度**比的（`lbl_find` 走
/// `span_eq`），不靠 NUL 结尾，所以这里怎么高效怎么来。前缀 1+4 字节 = `LOCAL_PREFIX`。
fn copy_local_name(tab: ptr, t: ptr, p: ptr, off: u32, oi: u32) -> u32 {
    let cur: u32 = cell(tab, C_EXTN);
    let n: u32 = cstr_len(p, off);
    if cur + n + LOCAL_PREFIX >= IN_CAP {
        return fail("the input buffer has no room left for external symbol names");
    }
    store8(t, cur, 36 as u8);
    store8(t, cur + 1, (oi % 256) as u8);
    store8(t, cur + 2, ((oi / 256) % 256) as u8);
    store8(t, cur + 3, ((oi / 65536) % 256) as u8);
    store8(t, cur + 4, ((oi / 16777216) % 256) as u8);
    let k: u32 = 0;
    while k < n {
        store8(t, cur + LOCAL_PREFIX + k, load8(p, off + k) as u8);
        k = k + 1;
    }
    setcell(tab, C_EXTN, cur + LOCAL_PREFIX + n);
    return cur;
}

fn copy_name(tab: ptr, t: ptr, p: ptr, off: u32) -> u32 {
    let cur: u32 = cell(tab, C_EXTN);
    let n: u32 = cstr_len(p, off);
    if cur + n >= IN_CAP {
        return fail("the input buffer has no room left for external symbol names");
    }
    let k: u32 = 0;
    while k < n {
        store8(t, cur + k, load8(p, off + k) as u8);
        k = k + 1;
    }
    setcell(tab, C_EXTN, cur + n);
    return cur;
}

// ---------------------------------------------------------------- 落盘与回填

fn w16(p: ptr, off: u32, v: u32) {
    store8(p, off, (v % 256) as u8);
    store8(p, off + 1, ((v / 256) % 256) as u8);
}

/// 写一条 64 字节的 `Elf64_Shdr`（`#606`）。字段偏移与 `sec_hdr` 的注释同一张表。
fn shdr_out(ob: ptr, at: u32, noff: u32, typ: u32, flags: u32, addr: u32,
            off: u32, size: u32, link: u32, info: u32, al: u32, entsize: u32) {
    w32(ob, at, noff);
    w32(ob, at + 4, typ);
    w64(ob, at + 8, flags as u64);
    w64(ob, at + 16, addr as u64);
    w64(ob, at + 24, off as u64);
    w64(ob, at + 32, size as u64);
    w32(ob, at + 40, link);
    w32(ob, at + 44, info);
    w64(ob, at + 48, al as u64);
    w64(ob, at + 56, entsize as u64);
}

fn w32(p: ptr, off: u32, v: u32) {
    store8(p, off, (v % 256) as u8);
    store8(p, off + 1, ((v / 256) % 256) as u8);
    store8(p, off + 2, ((v / 65536) % 256) as u8);
    store8(p, off + 3, ((v / 16777216) % 256) as u8);
}

fn w64(p: ptr, off: u32, v: u64) {
    let x: u64 = v;
    let i: u32 = 0;
    while i < 8 {
        store8(p, off + i, (x % 256) as u8);
        x = x / 256;
        i = i + 1;
    }
}

/// 把回填表里的 rel32/abs64 落到代码缓冲上。
fn resolve_fixups(tab: ptr, t: ptr, txt: ptr) -> u32 {
    let n: u32 = cell(tab, C_NFIX);
    let i: u32 = 0;
    while i < n {
        let base: u32 = TB_FIX + i * 28;
        let site: u32 = load32(tab, base + F_SITE);
        let kind: u32 = load32(tab, base + F_KIND);
        let no: u32 = load32(tab, base + F_NOFF);
        let nl: u32 = load32(tab, base + F_NLEN);
        let addr: u32 = lbl_find(tab, t, no, nl, load32(tab, base + F_BOFF),
                                 load32(tab, base + F_BLEN));
        if addr == NO {
            wstr(2, "loment: undefined label: ");
            write_all(2, ptr_add(t, no), nl as u64);
            wstr(2, "\n");
            return die(1);
        }
        if kind == 1 {
            if cell(tab, C_PE) == 1 {
                w64(txt, site, PE_IMG_BASE + (addr as u64));
            } else {
                w64(txt, site, addr as u64);
            }
        } else {
            w32(txt, site, addr - (txt_base(tab) + site + 4));
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- V2 共享对象 (docs/183 §4)
//
// 与参考实现 (tools/lomelf.py 的 `SharedObject` / `build_dynamic_tables` /
// `build_elf_dynamic`) **逐条镜像** —— 判据是产物逐字节相同。
//
// `.so` 的字节**一个也不进产物**: 我们只读它的**导出表**, 产物里留下 `DT_NEEDED` 与
// PLT; 跑起来的时候由系统的 loader 把 `.so` 映射进来、按名字解析、把地址填进 GOT。

const EXP_MAX: u32 = 8192;         // 导出表条数上限
const TB_EXP: u32 = 2662176;       // stride 12 × EXP_MAX: (名字池起点, 长度, 标志)
const X_NOFF: u32 = 0;
const X_NLEN: u32 = 4;
const X_FLAG: u32 = 8;             // bit0 = 默认版本 / bit1 = 数据符号
const X_SIZE: u32 = 12;
const IMP_MAX: u32 = 1024;         // 导入表条数上限
const TB_IMP: u32 = 2760480;       // stride 8 × IMP_MAX: (名字池起点, 长度)

const C_NSHARED: u32 = 120;        // 0/1 —— 这一版一次只能链一个 `.so`
const C_SONOFF: u32 = 124;         // SONAME 在名字池里的起点与长度
const C_SONLEN: u32 = 128;
const C_NEXP: u32 = 132;           // 导出表条数
const C_NIMP: u32 = 136;           // 导入表条数
const C_PLTA: u32 = 140;           // PLT 起点 (vaddr)
const C_INTERP: u32 = 144;         // `.interp` 的 vaddr
const C_GOTA: u32 = 148;           // `.got.plt` 的 vaddr
const C_DYNA: u32 = 152;           // `.dynamic` 的 vaddr
const C_TAILV: u32 = 156;          // 尾部那一段 (GOT + .dynamic) 的 vaddr
const C_DYNSTRA: u32 = 160;        // `.dynstr` / `.dynsym` / `.hash` / `.gnu.hash` /
const C_DSLEN: u32 = 164;          //   `.rela.plt` 的 vaddr 与 `.dynstr` 长度
const C_SYMA: u32 = 168;
const C_HASHA: u32 = 172;
const C_GNUA: u32 = 176;
const C_RELAA: u32 = 180;
const C_NEEDOFF: u32 = 184;        // DT_NEEDED 的值 = SONAME 在 `.dynstr` 里的偏移

fn is_shared(mem: ptr, n: u32) -> u32 {
    if n < 64 {
        return 0;
    }
    if load8(mem, 0) != 127 || load8(mem, 1) != 69 || load8(mem, 2) != 76
        || load8(mem, 3) != 70 || load8(mem, 4) != 2 || load8(mem, 5) != 1 {
        return 0;
    }
    if rd16(mem, 16) == 3 {
        return 1;
    }
    return 0;
}

fn put_lit(p: ptr, at: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(p, at + i, str_byte(s, i) as u8);
        i = i + 1;
    }
    return at + n;
}

/// 把 `src[off..off+len)` 写进 `dst` 的 `at`，返回新游标。`cap` 是**目标缓冲**的上限
/// —— 名字池住在输入缓冲里，越界就踩到下一张缓冲（与 `put_name` 同一条纪律）。
fn put_bytes(dst: ptr, at: u32, src: ptr, off: u32, len: u32, cap: u32) -> u32 {
    if at + len >= cap {
        let _f: u32 = fail("缓冲没有空间放共享对象的名字");
    }
    let i: u32 = 0;
    while i < len {
        store8(dst, at + i, load8(src, off + i) as u8);
        i = i + 1;
    }
    return at + len;
}

/// 记一条导出。同名可能有多条（不同版本）：**默认版本优先**，非默认的不覆盖它 ——
/// 与参考实现的 `SharedObject.__init__` 同一条规则。
fn exp_add(tab: ptr, t: ptr, src: ptr, off: u32, len: u32, typ: u32, hidden: u32) -> u32 {
    let n: u32 = cell(tab, C_NEXP);
    let k: u32 = 0;
    while k < n {
        let base: u32 = TB_EXP + k * X_SIZE;
        if nm_eq(t, load32(tab, base + X_NOFF), load32(tab, base + X_NLEN), src, off, len) == 1 {
            let f: u32 = load32(tab, base + X_FLAG);
            if f % 2 == 0 && hidden == 0 {
                store32(tab, base + X_FLAG, f - f % 2 + 1);
            }
            return 0;
        }
        k = k + 1;
    }
    if n >= EXP_MAX {
        let _f2: u32 = fail("共享对象导出表满了 — 抬高 EXP_MAX");
    }
    let cur: u32 = cell(tab, C_EXTN);
    let nx: u32 = put_bytes(t, cur, src, off, len, IN_CAP);
    setcell(tab, C_EXTN, nx);
    let base2: u32 = TB_EXP + n * X_SIZE;
    store32(tab, base2 + X_NOFF, cur);
    store32(tab, base2 + X_NLEN, len);
    let isdef: u32 = 1 - hidden;
    let isobj: u32 = 0;
    if typ == 1 {
        isobj = 1;
    }
    store32(tab, base2 + X_FLAG, isdef + isobj * 2);
    setcell(tab, C_NEXP, n + 1);
    return 0;
}

/// 查一个导出：返回 `标志 + 1`（0 = 没有这个名字）—— 加一是为了把"找到了但标志是 0"
/// 与"没找到"分开。
fn exp_find(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let n: u32 = cell(tab, C_NEXP);
    let k: u32 = 0;
    while k < n {
        let base: u32 = TB_EXP + k * X_SIZE;
        if span_eq(t, load32(tab, base + X_NOFF), load32(tab, base + X_NLEN), noff, nlen) == 1 {
            return load32(tab, base + X_FLAG) + 1;
        }
        k = k + 1;
    }
    return 0;
}

/// `[off, off+span)` 在文件里吗（`#593`）。用 u64 算：`u32` 的加法回绕会把
/// "越界 4 GiB" 算成 "在界内"，而那正是 issue 里 `sto + sono` 的形状。
fn so_fits(n: u32, off: u32, span: u64) -> u32 {
    if (off as u64) + span > (n as u64) {
        return 0;
    }
    return 1;
}

/// 一份共享对象读不下去时的一句话 + 退出。与参考实现抛 `Unsupported` 同一个口径：
/// **用户拿到文件名和哪张表越界**，而不是一个信号、或者"被 strip 掉了?"这种错诊断。
fn so_bad(pname: ptr, what: str) -> u32 {
    wstr(2, "loment: 共享对象是截断或损坏的 —— ");
    wstr(2, what);
    wstr(2, ": ");
    write_cstr(2, pname, 0);
    wstr(2, "\n");
    return die(1);
}

/// 读一个 `.so` 的**导出表**与 SONAME。**不搬它的任何字节**。
fn so_load(tab: ptr, t: ptr, mem: ptr, n: u32, pname: ptr) -> u32 {
    // **每一次读之前都要问一句在不在文件里**（`#593`）。`load8`/`load32` 是裸内建、
    // 没有边界；而 `mem` 是 4 MiB 的暂存区。少了这些检查，一个 176 字节的坏文件能让
    // 链接器读出去（SIGSEGV），或者读到**上一个 `--link` 文件留下的字节** ——
    // 后者的症状是一句指错方向的诊断（"被 strip 掉了?"）。
    // 有界之后就不必再清零暂存区：`n` 之外的那些字节再也走不到。
    if n < 64 {
        return so_bad(pname, "ELF 头不足 64 字节");
    }
    let phoff: u32 = load32(mem, 32);
    let phen: u32 = rd16(mem, 54);
    let phn: u32 = rd16(mem, 56);
    if phn != 0 && phen < 56 {
        return so_bad(pname, "程序头条目小于 56 字节");
    }
    let pspan: u64 = (phn as u64) * (phen as u64);
    if so_fits(n, phoff, pspan) == 0 {
        return so_bad(pname, "程序头表");
    }
    let dyno: u32 = NO;
    let dynl: u32 = 0;
    let k: u32 = 0;
    while k < phn {
        let o: u32 = phoff + k * phen;
        if load32(mem, o) == 2 {
            dyno = load32(mem, o + 8);
            dynl = load32(mem, o + 32);
        }
        k = k + 1;
    }
    if dyno == NO {
        wstr(2, "loment: 共享对象没有 PT_DYNAMIC: ");
        write_cstr(2, pname, 0);
        wstr(2, "\n");
        return die(1);
    }
    if so_fits(n, dyno, dynl as u64) == 0 {
        return so_bad(pname, "PT_DYNAMIC 指向的区间");
    }
    // `.dynamic` 里我们只要两样：SONAME 与 STRTAB 的 vaddr。
    let strv: u32 = 0;
    let sono: u32 = NO;
    let p: u32 = dyno;
    let dend: u32 = dyno + dynl;
    while p + 16 <= dend {
        let tag: u32 = load32(mem, p);
        let val: u32 = load32(mem, p + 8);
        if tag == 0 {
            p = dend;
        } else {
            if tag == 5 {
                strv = val;
            }
            if tag == 14 {
                sono = val;
            }
            p = p + 16;
        }
    }
    // vaddr -> 文件偏移（落在哪个 PT_LOAD 里）。与参考实现 `voff` 同一条。
    let sto: u32 = NO;
    k = 0;
    while k < phn {
        let o2: u32 = phoff + k * phen;
        if load32(mem, o2) == 1 {
            let va: u32 = load32(mem, o2 + 16);
            let fs: u32 = load32(mem, o2 + 32);
            let fo: u32 = load32(mem, o2 + 8);
            if strv >= va && strv < va + fs {
                sto = fo + (strv - va);
            }
        }
        k = k + 1;
    }
    // **两件不同的事，两句话**（`#594`）。原先写的是 `if strv != 0 && sto == NO` ——
    // 于是 `strv == 0`（没有 DT_STRTAB）**恰好跳过**这条守卫，而下一行照样拿 `sto`
    // 当文件偏移用：`sto + sono` 在 u32 上回绕，SONAME 就从 ELF 头那几个字节里读，
    // 链接器还退 0、写出一个永远加载不了的产物。
    if strv == 0 {
        return so_bad(pname, "动态表里没有 DT_STRTAB");
    }
    if sto == NO {
        wstr(2, "loment: 共享对象的 .dynamic 里有个地址落在任何 PT_LOAD 之外: ");
        write_cstr(2, pname, 0);
        wstr(2, "\n");
        return die(1);
    }
    // SONAME：没有就用**文件名**（loader 按那个找）。
    let son_o: u32 = cell(tab, C_EXTN);
    if sono == NO {
        let bn: u32 = 0;
        let q: u32 = 0;
        while load8(pname, q) != 0 {
            if load8(pname, q) == 47 {
                bn = q + 1;
            }
            q = q + 1;
        }
        setcell(tab, C_EXTN, put_bytes(t, son_o, pname, bn, q - bn, IN_CAP));
        setcell(tab, C_SONOFF, son_o);
        setcell(tab, C_SONLEN, q - bn);
    } else {
        // `sto + sono` 要么回绕、要么越界 —— 两种都不能拿去当偏移（`#594`）。
        let son_at: u32 = sto + sono;
        if son_at < sto {
            return so_bad(pname, "DT_SONAME 的偏移回绕");
        }
        if so_fits(n, son_at, 1) == 0 {
            return so_bad(pname, "DT_SONAME 指向的位置");
        }
        // **在这里数、带 `n` 这个上限**：`cstr_len` 只看 4096 字节，够不到文件尾时
        // 它会一路扫过暂存区（`#593`）。
        let sl: u32 = 0;
        while son_at + sl < n && sl < 4096 && load8(mem, son_at + sl) != 0 {
            sl = sl + 1;
        }
        setcell(tab, C_EXTN, put_bytes(t, son_o, mem, son_at, sl, IN_CAP));
        setcell(tab, C_SONOFF, son_o);
        setcell(tab, C_SONLEN, sl);
    }
    // 节头：`.dynsym`(11) / `.gnu.version`(0x6FFFFFFF)，`.dynstr` 就是 `.dynsym` 的
    // `sh_link`（与参考实现 `byname[".dynstr"]` 指同一节）。
    let shoff: u32 = load32(mem, 40);
    let shen: u32 = rd16(mem, 58);
    let shn: u32 = sh_num(mem);
    if shen < 64 {
        return so_bad(pname, "节头条目小于 64 字节");
    }
    if so_fits(n, shoff, (shn as u64) * (shen as u64)) == 0 {
        return so_bad(pname, "节头表");
    }
    let dsi: u32 = NO;
    let vsi: u32 = NO;
    k = 0;
    while k < shn {
        let ty: u32 = sh_type(mem, k);
        if ty == 11 {
            dsi = k;
        }
        if ty == 1879048191 {
            vsi = k;
        }
        k = k + 1;
    }
    if dsi == NO {
        wstr(2, "loment: 共享对象没有 .dynsym（被 strip 掉了?）—— 这一版只读带节头的 .so: ");
        write_cstr(2, pname, 0);
        wstr(2, "\n");
        return die(1);
    }
    let dsli: u32 = sh_link(mem, dsi);
    if dsli >= shn {
        return so_bad(pname, ".dynsym 的 sh_link 指到一个不存在的节");
    }
    let dso: u32 = sh_off(mem, dsi);
    let dssz: u32 = sh_size(mem, dsi);
    let dsn: u32 = dssz / 24;
    let dstr: u32 = sh_off(mem, dsli);
    let dstrsz: u32 = sh_size(mem, dsli);
    if so_fits(n, dso, dssz as u64) == 0 {
        return so_bad(pname, ".dynsym 表");
    }
    if so_fits(n, dstr, dstrsz as u64) == 0 {
        return so_bad(pname, ".dynstr 表");
    }
    let vso: u32 = 0;
    let vsn: u32 = 0;
    if vsi != NO {
        vso = sh_off(mem, vsi);
        let vssz: u32 = sh_size(mem, vsi);
        vsn = vssz / 2;
        if so_fits(n, vso, ((vssz / 2) * 2) as u64) == 0 {
            return so_bad(pname, ".gnu.version 表");
        }
    }
    k = 1;
    while k < dsn {
        let o3: u32 = dso + k * 24;
        let noff: u32 = load32(mem, o3);
        let info: u32 = load8(mem, o3 + 4) as u32;
        let shndx: u32 = rd16(mem, o3 + 6);
        // `shndx == 0` 是**它自己的依赖**（如 libc.so.6），不是它能给人的东西。
        if shndx != 0 && noff != 0 {
            let bind: u32 = info / 16;
            let typ: u32 = info % 16;
            if bind == 1 || bind == 2 {
                if typ == 1 || typ == 2 {
                    // 名字相对 `.dynstr` 的起点：**两端都要在那一节里面**（`#593`）。
                    let npos: u32 = dstr + noff;
                    if npos < dstr || npos >= dstr + dstrsz {
                        return so_bad(pname, "导出名偏移越出 .dynstr");
                    }
                    let nl: u32 = 0;
                    while npos + nl < dstr + dstrsz && nl < 4096
                            && load8(mem, npos + nl) != 0 {
                        nl = nl + 1;
                    }
                    let hid: u32 = 0;
                    if k < vsn {
                        if rd16(mem, vso + k * 2) >= 32768 {
                            hid = 1;
                        }
                    }
                    let _a: u32 = exp_add(tab, t, mem, npos, nl, typ, hid);
                }
            }
        }
        k = k + 1;
    }
    if cell(tab, C_NEXP) == 0 {
        wstr(2, "loment: 共享对象没有可用的导出（GLOBAL/WEAK 的 FUNC/OBJECT）: ");
        write_cstr(2, pname, 0);
        wstr(2, "\n");
        return die(1);
    }
    return 0;
}

fn imp_has(tab: ptr, t: ptr, noff: u32, nlen: u32) -> u32 {
    let n: u32 = cell(tab, C_NIMP);
    let k: u32 = 0;
    while k < n {
        let base: u32 = TB_IMP + k * 8;
        if span_eq(t, load32(tab, base), load32(tab, base + 4), noff, nlen) == 1 {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

fn imp_add(tab: ptr, noff: u32, nlen: u32) {
    let n: u32 = cell(tab, C_NIMP);
    if n >= IMP_MAX {
        let _f: u32 = fail("导入表满了 — 抬高 IMP_MAX");
    }
    store32(tab, TB_IMP + n * 8, noff);
    store32(tab, TB_IMP + n * 8 + 4, nlen);
    setcell(tab, C_NIMP, n + 1);
}

/// 字节序比较（两个字串都在 `t` 里）。**只要"小于"这一个谓词** —— 自举侧的负数与
/// 布尔比较那两格有别扭（issue #224 / #316），别去碰。
fn nm_less(t: ptr, a: u32, al: u32, b: u32, bl: u32) -> u32 {
    let k: u32 = 0;
    while k < al && k < bl {
        let x: u32 = load8(t, a + k) as u32;
        let y: u32 = load8(t, b + k) as u32;
        if x < y {
            return 1;
        }
        if x > y {
            return 0;
        }
        k = k + 1;
    }
    if al < bl {
        return 1;
    }
    return 0;
}

/// 插入排序 —— **参考实现是 `sorted(...)`**：导入的次序决定 PLT 桩与符号号的分配，
/// 所以这里必须给出同一个次序（字节序）。
fn imp_sort(tab: ptr, t: ptr) {
    let n: u32 = cell(tab, C_NIMP);
    let i: u32 = 1;
    while i < n {
        let j: u32 = i;
        let go: u32 = 1;
        while go == 1 && j > 0 {
            let pa: u32 = TB_IMP + (j - 1) * 8;
            let pb: u32 = TB_IMP + j * 8;
            if nm_less(t, load32(tab, pb), load32(tab, pb + 4),
                       load32(tab, pa), load32(tab, pa + 4)) == 1 {
                let to: u32 = load32(tab, pa);
                let tl: u32 = load32(tab, pa + 4);
                store32(tab, pa, load32(tab, pb));
                store32(tab, pa + 4, load32(tab, pb + 4));
                store32(tab, pb, to);
                store32(tab, pb + 4, tl);
                j = j - 1;
            } else {
                go = 0;
            }
        }
        i = i + 1;
    }
}

/// 把**没有定义**的标签挑成导入，查导出表（查不到就**点名拒** —— 不留给运行时崩），
/// 排序，然后给每个导入立一个 PLT 桩的标签。返回 PLT 起点（没有共享对象时返回 0）。
fn collect_imports(tab: ptr, t: ptr, tlen: u32) -> u32 {
    if cell(tab, C_NSHARED) == 0 {
        return 0;
    }
    let n: u32 = cell(tab, C_NFIX);
    let i: u32 = 0;
    while i < n {
        let base: u32 = TB_FIX + i * 28;
        let no: u32 = load32(tab, base + F_NOFF);
        let nl: u32 = load32(tab, base + F_NLEN);
        let bo: u32 = load32(tab, base + F_BOFF);
        let bl: u32 = load32(tab, base + F_BLEN);
        if lbl_find(tab, t, no, nl, bo, bl) == NO {
            if imp_has(tab, t, no, nl) == 0 {
                let f: u32 = exp_find(tab, t, no, nl);
                if f == 0 {
                    wstr(2, "loment: 共享对象里没有导出 ");
                    write_all(2, ptr_add(t, no), nl as u64);
                    wstr(2, " —— 动态链接只在导出表里找名字\n");
                    return die(1);
                }
                let fl: u32 = f - 1;
                if fl % 2 == 0 {
                    wstr(2, "loment: 只以非默认版本导出 ");
                    write_all(2, ptr_add(t, no), nl as u64);
                    wstr(2, " —— 未加版本的引用绑不上它（docs/183 §4 V2）\n");
                    return die(1);
                }
                if (fl / 2) % 2 == 1 {
                    wstr(2, "loment: 那是数据符号 ");
                    write_all(2, ptr_add(t, no), nl as u64);
                    wstr(2, " —— 数据导入要 GOT 间接，这一版只做函数导入\n");
                    return die(1);
                }
                imp_add(tab, no, nl);
            }
        }
        i = i + 1;
    }
    imp_sort(tab, t);
    let cnt: u32 = cell(tab, C_NIMP);
    let plt_at: u32 = align_to(TEXT_VADDR + tlen, 16);
    let k: u32 = 0;
    while k < cnt {
        let b2: u32 = TB_IMP + k * 8;
        lbl_add(tab, load32(tab, b2), load32(tab, b2 + 4), 0, 0, plt_at + 16 * (k + 1));
        k = k + 1;
    }
    setcell(tab, C_PLTA, plt_at);
    return plt_at;
}

/// 把 PLT 与那几张表接在代码后面（`txt`），把每个 vaddr/长度记进 cells 交给
/// `build_elf_dynamic`。布局与参考实现 `build_dynamic_tables` **逐字节相同**。
fn emit_dyn_tail(tab: ptr, t: ptr, txt: ptr, tlen: u32, dlen: u32, bss: u32) -> u32 {
    let n: u32 = cell(tab, C_NIMP);
    let plt_at: u32 = cell(tab, C_PLTA);
    let tail_v: u32 = align_to(DATA_VADDR + dlen + bss, 4096);
    let got_at: u32 = tail_v;
    let interp_at: u32 = plt_at + 16 * (n + 1);
    let dynstr_at: u32 = interp_at + 28;
    let dsl: u32 = 0;
    let k: u32 = 0;
    while k < n {
        dsl = dsl + load32(tab, TB_IMP + k * 8 + 4) + 1;
        k = k + 1;
    }
    // 1(开头的 0) + 各导入 + SONAME + 结尾那个 0
    let dslen: u32 = 1 + dsl + cell(tab, C_SONLEN) + 1 + 1;
    let dynsym_at: u32 = align_to(dynstr_at + dslen, 8);
    let hash_at: u32 = align_to(dynsym_at + 24 * (n + 1), 8);
    let gnu_at: u32 = align_to(hash_at + 12 + 4 * (n + 1), 8);
    let rela_at: u32 = align_to(gnu_at + 28, 8);
    let tail_end: u32 = rela_at + 24 * n;
    let p0: u32 = plt_at - TEXT_VADDR;
    pad_zero(txt, tlen, p0);
    // ---- PLT：16 字节一格。PLT0 + 每个导入一格。rip 相对位移相对**指令末尾**。
    store8(txt, p0, 255 as u8);
    store8(txt, p0 + 1, 53 as u8);
    w32(txt, p0 + 2, (got_at + 8) - (plt_at + 6));
    store8(txt, p0 + 6, 255 as u8);
    store8(txt, p0 + 7, 37 as u8);
    w32(txt, p0 + 8, (got_at + 16) - (plt_at + 12));
    store8(txt, p0 + 12, 15 as u8);
    store8(txt, p0 + 13, 31 as u8);
    store8(txt, p0 + 14, 64 as u8);
    store8(txt, p0 + 15, 0 as u8);
    k = 0;
    while k < n {
        let sa: u32 = p0 + 16 * (k + 1);
        store8(txt, sa, 255 as u8);
        store8(txt, sa + 1, 37 as u8);
        w32(txt, sa + 2, (got_at + 8 * (k + 3)) - (plt_at + 16 * (k + 1) + 6));
        store8(txt, sa + 6, 104 as u8);
        w32(txt, sa + 7, k);
        store8(txt, sa + 11, 233 as u8);
        w32(txt, sa + 12, p0 - (sa + 16));
        k = k + 1;
    }
    // ---- `.interp`
    let ip: u32 = interp_at - TEXT_VADDR;
    let ip2: u32 = put_lit(txt, ip, "/lib64/ld-linux-x86-64.so.2");
    store8(txt, ip2, 0 as u8);
    // ---- `.dynstr`：0 号空串, 然后每个导入, 然后 SONAME, 再补一个 0。
    let dp: u32 = dynstr_at - TEXT_VADDR;
    store8(txt, dp, 0 as u8);
    let dcur: u32 = dp + 1;
    k = 0;
    while k < n {
        let b2: u32 = TB_IMP + k * 8;
        dcur = put_bytes(txt, dcur, t, load32(tab, b2), load32(tab, b2 + 4), OUT_CAP);
        store8(txt, dcur, 0 as u8);
        dcur = dcur + 1;
        k = k + 1;
    }
    dcur = put_bytes(txt, dcur, t, cell(tab, C_SONOFF), cell(tab, C_SONLEN), OUT_CAP);
    store8(txt, dcur, 0 as u8);
    store8(txt, dcur + 1, 0 as u8);
    dcur = dcur + 2;
    // ---- `.dynsym`：0 号空符号, 然后每个导入一个 STB_GLOBAL|STT_FUNC、shndx = 0。
    let sy: u32 = dynsym_at - TEXT_VADDR;
    pad_zero(txt, dcur, sy);
    let nm2: u32 = 1;
    k = 0;
    while k < n {
        let sa2: u32 = sy + 24 * (k + 1);
        w32(txt, sa2, nm2);
        store8(txt, sa2 + 4, 18 as u8);
        store8(txt, sa2 + 5, 0 as u8);
        store8(txt, sa2 + 6, 0 as u8);
        store8(txt, sa2 + 7, 0 as u8);
        w64(txt, sa2 + 8, 0 as u64);
        w64(txt, sa2 + 16, 0 as u64);
        nm2 = nm2 + load32(tab, TB_IMP + k * 8 + 4) + 1;
        k = k + 1;
    }
    // ---- SysV `.hash`：我们不导出任何符号, 表是退化的（1 个桶、链全 0）。
    let ha: u32 = hash_at - TEXT_VADDR;
    let ga: u32 = gnu_at - TEXT_VADDR;
    pad_zero(txt, sy + 24 * (n + 1), ga);
    w32(txt, ha, 1);
    w32(txt, ha + 4, 1 + n);
    w32(txt, ha + 8, 0);
    // ---- GNU hash：同样退化（symoffset = nsyms, 一张 bloom, 一个空桶）。
    w32(txt, ga, 1);
    w32(txt, ga + 4, 1 + n);
    w32(txt, ga + 8, 1);
    w32(txt, ga + 12, 6);
    w64(txt, ga + 16, 0 as u64);
    w32(txt, ga + 24, 0);
    // ---- `.rela.plt`：`r_info = (符号号 << 32) | R_X86_64_JUMP_SLOT(7)`。
    let ra: u32 = rela_at - TEXT_VADDR;
    pad_zero(txt, ga + 28, ra);
    k = 0;
    while k < n {
        w64(txt, ra + 24 * k, (got_at + 8 * (k + 3)) as u64);
        let ri: u64 = (k + 1) as u64 * PHI + 7 as u64;
        w64(txt, ra + 24 * k + 8, ri);
        w64(txt, ra + 24 * k + 16, 0 as u64);
        k = k + 1;
    }
    setcell(tab, C_INTERP, interp_at);
    setcell(tab, C_GOTA, got_at);
    setcell(tab, C_DYNA, got_at + 8 * (3 + n));
    setcell(tab, C_TAILV, tail_v);
    setcell(tab, C_DYNSTRA, dynstr_at);
    setcell(tab, C_DSLEN, dslen);
    setcell(tab, C_NEEDOFF, 1 + dsl);
    setcell(tab, C_SYMA, dynsym_at);
    setcell(tab, C_HASHA, hash_at);
    setcell(tab, C_GNUA, gnu_at);
    setcell(tab, C_RELAA, rela_at);
    return tail_end - TEXT_VADDR;
}

fn phdr_t(ob: ptr, at: u32, typ: u32, flags: u32, off: u32, vaddr: u32,
          fsz: u32, msz: u32, al: u32) {
    w32(ob, at, typ);
    w32(ob, at + 4, flags);
    w64(ob, at + 8, off as u64);
    w64(ob, at + 16, vaddr as u64);
    w64(ob, at + 24, vaddr as u64);
    w64(ob, at + 32, fsz as u64);
    w64(ob, at + 40, msz as u64);
    w64(ob, at + 48, al as u64);
}

/// 组装**动态链接**的 ELF：八条程序头（INTERP + 四个 LOAD + DYNAMIC + GNU_RELRO +
/// GNU_STACK）。文件头那一页单开一条**只读** LOAD（`#608`）—— 原先它和代码同一条 R|X，
/// 于是 ELF 头与程序头表落在可执行页里。
///
/// **第一个 `PT_LOAD` 必须从文件偏移 0 起**：内核用
/// `AT_PHDR = (首个 PT_LOAD 的 p_vaddr - p_offset) + e_phoff` 告诉 loader 程序头在哪；
/// 这一页不进 LOAD 的话, `AT_PHDR` 就落在未映射的地址上, loader 连一行 `LD_DEBUG`
/// 都来不及打就没了（实测）。
///
/// **尾部那一段（`.got.plt` + `.dynamic`）单开一条 RW LOAD, 落在 BSS 之后** ——
/// 紧接着 `data` 的是 BSS, 里面是运行时自己的全局（FFI 的 arena 就是 1 MiB）；GOT 摆
/// 在那里, 程序第一次往全局里写就把它覆盖了（实测 GOT 里被写成了输入数据）。
/// 同一段罩进 **`PT_GNU_RELRO`**（`#608`）：`DF_BIND_NOW` 已发，加载器做完重定位后
/// 把 GOT/.dynamic 变成只读。
fn build_elf_dynamic(tab: ptr, ob: ptr, txt: ptr, tlen: u32, gb: ptr, dlen: u32,
                     bss: u32) -> u32 {
    let text_off: u32 = 4096;
    let data_off: u32 = align_to(text_off + tlen, 4096);
    let tail_off: u32 = align_to(data_off + dlen, 4096);
    let tail_v: u32 = cell(tab, C_TAILV);
    let dyn_a: u32 = cell(tab, C_DYNA);
    // 14 条 `DT_*`（多出来的那条是 `DT_DEBUG`，`#607`）× 16 字节。
    let dyn_l: u32 = 224;
    let tail_l: u32 = (dyn_a - tail_v) + dyn_l;
    let file_end: u32 = tail_off + tail_l;
    // 节头表在**不加载的尾部**（`#606`），与参考实现同序同字节。
    let shstr_off: u32 = file_end;
    let shstr_len: u32 = 80;
    let shoff: u32 = align_to(shstr_off + shstr_len, 8);
    store8(ob, 0, 127 as u8);
    store8(ob, 1, 69 as u8);
    store8(ob, 2, 76 as u8);
    store8(ob, 3, 70 as u8);
    store8(ob, 4, 2 as u8);
    store8(ob, 5, 1 as u8);
    store8(ob, 6, 1 as u8);
    store8(ob, 7, 0 as u8);
    let z: u32 = 8;
    while z < 16 {
        store8(ob, z, 0 as u8);
        z = z + 1;
    }
    store8(ob, 16, 2 as u8);
    store8(ob, 17, 0 as u8);
    store8(ob, 18, 62 as u8);
    store8(ob, 19, 0 as u8);
    w32(ob, 20, 1);
    w64(ob, 24, TEXT_VADDR as u64);
    w64(ob, 32, 64);
    w64(ob, 40, shoff as u64);
    w32(ob, 48, 0);
    store8(ob, 52, 64 as u8);
    store8(ob, 53, 0 as u8);
    store8(ob, 54, 56 as u8);
    store8(ob, 55, 0 as u8);
    // e_phnum = 8（多出来的是文件头那页的只读 LOAD 与 GNU_RELRO，`#608`）
    store8(ob, 56, 8 as u8);
    store8(ob, 57, 0 as u8);
    // e_shentsize = 64, e_shnum = 11, e_shstrndx = 10（`#606`）
    w16(ob, 58, 64);
    w16(ob, 60, 11);
    w16(ob, 62, 10);
    // 程序头：INTERP / LOAD(R, 文件头页) / LOAD(RX) / LOAD(RW data) / LOAD(RW tail) /
    // DYNAMIC / GNU_RELRO / GNU_STACK。第一个 LOAD 仍从偏移 0 起（`AT_PHDR` 靠它）。
    phdr_t(ob, 64, 3, 4, text_off + (cell(tab, C_INTERP) - TEXT_VADDR),
           cell(tab, C_INTERP), 28, 28, 1);
    phdr_t(ob, 120, 1, 4, 0, TEXT_VADDR - text_off, text_off, text_off, 4096);
    phdr_t(ob, 176, 1, 5, text_off, TEXT_VADDR, tlen, tlen, 4096);
    phdr_t(ob, 232, 1, 6, data_off, DATA_VADDR, dlen, dlen + bss, 4096);
    phdr_t(ob, 288, 1, 6, tail_off, tail_v, tail_l, tail_l, 4096);
    phdr_t(ob, 344, 2, 6, tail_off + (dyn_a - tail_v), dyn_a, dyn_l, dyn_l, 4096);
    phdr_t(ob, 400, 1685382482, 4, tail_off, tail_v, tail_l, tail_l, 1);
    phdr_t(ob, 456, 1685382481, 6, 0, 0, 0, 0, 16);
    copy_n(ob, text_off, txt, 0, tlen);
    copy_n(ob, data_off, gb, 0, dlen);
    // ---- `.got.plt`（尾部段的开头）
    let n: u32 = cell(tab, C_NIMP);
    let plt_at: u32 = cell(tab, C_PLTA);
    w64(ob, tail_off, dyn_a as u64);
    w64(ob, tail_off + 8, 0 as u64);
    w64(ob, tail_off + 16, 0 as u64);
    let k: u32 = 0;
    while k < n {
        w64(ob, tail_off + 8 * (k + 3), (plt_at + 16 * (k + 1) + 6) as u64);
        k = k + 1;
    }
    // ---- `.dynamic`
    let d: u32 = tail_off + 8 * (3 + n);
    w64(ob, d, 1 as u64);
    w64(ob, d + 8, cell(tab, C_NEEDOFF) as u64);
    w64(ob, d + 16, 4 as u64);
    w64(ob, d + 24, cell(tab, C_HASHA) as u64);
    w64(ob, d + 32, 1879047925 as u64);
    w64(ob, d + 40, cell(tab, C_GNUA) as u64);
    w64(ob, d + 48, 5 as u64);
    w64(ob, d + 56, cell(tab, C_DYNSTRA) as u64);
    w64(ob, d + 64, 10 as u64);
    w64(ob, d + 72, cell(tab, C_DSLEN) as u64);
    w64(ob, d + 80, 6 as u64);
    w64(ob, d + 88, cell(tab, C_SYMA) as u64);
    w64(ob, d + 96, 11 as u64);
    w64(ob, d + 104, 24 as u64);
    w64(ob, d + 112, 3 as u64);
    w64(ob, d + 120, cell(tab, C_GOTA) as u64);
    w64(ob, d + 128, 23 as u64);
    w64(ob, d + 136, cell(tab, C_RELAA) as u64);
    w64(ob, d + 144, 2 as u64);
    w64(ob, d + 152, (24 * n) as u64);
    w64(ob, d + 160, 20 as u64);
    w64(ob, d + 168, 7 as u64);
    w64(ob, d + 176, 30 as u64);
    w64(ob, d + 184, 8 as u64);
    // `DT_DEBUG`（`#607`）：loader 往这里写 `r_debug`，调试器靠它看已加载的共享对象。
    w64(ob, d + 192, 21 as u64);
    w64(ob, d + 200, 0 as u64);
    w64(ob, d + 208, 0 as u64);
    w64(ob, d + 216, 0 as u64);
    // ---- `.shstrtab`（顺序与参考实现一致）
    store8(ob, shstr_off, 0 as u8);
    let sn: u32 = put_lit(ob, shstr_off + 1, ".text");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".data");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".bss");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".interp");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".dynstr");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".dynsym");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".rela.plt");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".got.plt");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".dynamic");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".shstrtab");
    store8(ob, sn, 0 as u8);
    // ---- 节头表（11 条 × 64 字节）。0 号是保留的空节。
    pad_zero(ob, shstr_off + shstr_len, shoff);
    pad_zero(ob, shoff, shoff + 64);
    let ip: u32 = cell(tab, C_INTERP);
    let ds: u32 = cell(tab, C_DYNSTRA);
    let sy: u32 = cell(tab, C_SYMA);
    let ra: u32 = cell(tab, C_RELAA);
    let ga: u32 = cell(tab, C_GOTA);
    shdr_out(ob, shoff + 64, 1, 1, 6, TEXT_VADDR, text_off, tlen, 0, 0, 16, 0);
    shdr_out(ob, shoff + 128, 7, 1, 3, DATA_VADDR, data_off, dlen, 0, 0, 16, 0);
    shdr_out(ob, shoff + 192, 13, 8, 3, DATA_VADDR + dlen, data_off + dlen,
             bss, 0, 0, 8, 0);
    shdr_out(ob, shoff + 256, 18, 1, 2, ip, text_off + (ip - TEXT_VADDR),
             28, 0, 0, 1, 0);
    shdr_out(ob, shoff + 320, 26, 3, 2, ds, text_off + (ds - TEXT_VADDR),
             cell(tab, C_DSLEN), 0, 0, 1, 0);
    shdr_out(ob, shoff + 384, 34, 11, 2, sy, text_off + (sy - TEXT_VADDR),
             24 * (n + 1), 5, 1, 8, 24);
    shdr_out(ob, shoff + 448, 42, 4, 2, ra, text_off + (ra - TEXT_VADDR),
             24 * n, 6, 8, 8, 24);
    shdr_out(ob, shoff + 512, 52, 1, 3, ga, tail_off + (ga - tail_v),
             8 * (3 + n), 0, 0, 8, 0);
    shdr_out(ob, shoff + 576, 61, 6, 3, dyn_a, tail_off + (dyn_a - tail_v),
             dyn_l, 5, 0, 8, 16);
    shdr_out(ob, shoff + 640, 70, 3, 0, 0, shstr_off, shstr_len, 0, 0, 1, 0);
    return shoff + 704;
}

/// 组装 ELF: 头 + 两个 PT_LOAD。返回文件总长。
fn build_elf(tab: ptr, ob: ptr, txt: ptr, tlen: u32, gb: ptr, dlen: u32, bss: u32) -> u32 {
    let text_off: u32 = 4096;
    let data_off: u32 = align_to(text_off + tlen, 4096);
    let file_end: u32 = data_off + dlen;
    // 节头表放在**不加载的尾部**（`#606`）：执行不需要，`objdump -d` / `readelf -r` /
    // `strip` 全按它找 `.text`。`.shstrtab` 的内容与顺序必须与参考实现逐字节一致。
    let shstr_off: u32 = file_end;
    let shstr_len: u32 = 28;
    let shoff: u32 = align_to(shstr_off + shstr_len, 8);
    // e_ident
    store8(ob, 0, 127 as u8);
    store8(ob, 1, 69 as u8);
    store8(ob, 2, 76 as u8);
    store8(ob, 3, 70 as u8);
    store8(ob, 4, 2 as u8);
    store8(ob, 5, 1 as u8);
    store8(ob, 6, 1 as u8);
    store8(ob, 7, 0 as u8);
    let z: u32 = 8;
    while z < 16 {
        store8(ob, z, 0 as u8);
        z = z + 1;
    }
    // e_type=2, e_machine=0x3E, e_version=1
    store8(ob, 16, 2 as u8);
    store8(ob, 17, 0 as u8);
    store8(ob, 18, 62 as u8);
    store8(ob, 19, 0 as u8);
    w32(ob, 20, 1);
    // e_entry = TEXT_VADDR (入口桩在代码缓冲起始处)
    w64(ob, 24, TEXT_VADDR as u64);
    // e_phoff = 64
    w64(ob, 32, 64);
    // e_shoff = 节头表起点
    w64(ob, 40, shoff as u64);
    // e_flags = 0
    w32(ob, 48, 0);
    // e_ehsize = 64
    store8(ob, 52, 64 as u8);
    store8(ob, 53, 0 as u8);
    // e_phentsize = 56
    store8(ob, 54, 56 as u8);
    store8(ob, 55, 0 as u8);
    // e_phnum = 2
    store8(ob, 56, 2 as u8);
    store8(ob, 57, 0 as u8);
    // e_shentsize = 64, e_shnum = 5, e_shstrndx = 4
    w16(ob, 58, 64);
    w16(ob, 60, 5);
    w16(ob, 62, 4);
    // phdr 0: text (R+X)
    phdr(ob, 64, 5, text_off, TEXT_VADDR, tlen, tlen);
    // phdr 1: data (R+W)
    phdr(ob, 120, 6, data_off, DATA_VADDR, dlen, dlen + bss);
    // 拷文本与数据
    copy_n(ob, text_off, txt, 0, tlen);
    copy_n(ob, data_off, gb, 0, dlen);
    // ---- `.shstrtab`：0 号空串, 然后按节表顺序的名字。
    store8(ob, shstr_off, 0 as u8);
    let sn: u32 = put_lit(ob, shstr_off + 1, ".text");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".data");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".bss");
    store8(ob, sn, 0 as u8);
    sn = put_lit(ob, sn + 1, ".shstrtab");
    store8(ob, sn, 0 as u8);
    // ---- 节头表（5 条 × 64 字节）。0 号是保留的空节。
    pad_zero(ob, shstr_off + shstr_len, shoff);
    pad_zero(ob, shoff, shoff + 64);
    shdr_out(ob, shoff + 64, 1, 1, 6, TEXT_VADDR, text_off, tlen, 0, 0, 16, 0);
    shdr_out(ob, shoff + 128, 7, 1, 3, DATA_VADDR, data_off, dlen, 0, 0, 16, 0);
    shdr_out(ob, shoff + 192, 13, 8, 3, DATA_VADDR + dlen, data_off + dlen,
             bss, 0, 0, 8, 0);
    shdr_out(ob, shoff + 256, 18, 3, 0, 0, shstr_off, shstr_len, 0, 0, 1, 0);
    return shoff + 320;
}

// ---------------------------------------------------------------- PE 写出

fn pe_sec(ob: ptr, at: u32, nm: str, vs: u32, va: u32, rs: u32, rp: u32, ch: u32) {
    let i: u32 = 0;
    while i < 8 {
        store8(ob, at + i, 0 as u8);
        i = i + 1;
    }
    i = 0;
    while i < str_len(nm) {
        store8(ob, at + i, str_byte(nm, i) as u8);
        i = i + 1;
    }
    w32(ob, at + 8, vs);
    w32(ob, at + 12, va);
    w32(ob, at + 16, rs);
    w32(ob, at + 20, rp);
    w32(ob, at + 36, ch);
}

/// 组装 PE: DOS 头 + PE 头 + 三个有文件的节。返回文件总长。
/// 节表按 RVA 升序；每节的 VirtualSize 铺到下一节起点 —— 节间有空洞加载器会拒收。
/// 入口桩在代码缓冲最前，所以 AddressOfEntryPoint 恒为 PE_TEXT_RVA。
fn build_pe(ob: ptr, txt: ptr, tlen: u32, gb: ptr, dlen: u32, idata: ptr, ilen: u32) -> u32 {
    let opt: u32 = 88;                                   // 64 + 4 + 20
    let st: u32 = 328;                                   // 节表起址
    let toff: u32 = align_to(st + 120, PE_FILE_ALIGN);
    let ioff: u32 = toff + align_to(tlen, PE_FILE_ALIGN);
    let doff: u32 = ioff + align_to(ilen, PE_FILE_ALIGN);
    let isize: u32 = align_to(PE_STATE_RVA + PE_WS_SIZE, PE_SEC_ALIGN);
    let i: u32 = 0;
    while i < st + 120 {
        store8(ob, i, 0 as u8);
        i = i + 1;
    }
    store8(ob, 0, 77 as u8);                             // 'M'
    store8(ob, 1, 90 as u8);                             // 'Z'
    store8(ob, 60, 64 as u8);                            // e_lfanew = 0x40
    store8(ob, 64, 80 as u8);                            // 'P'
    store8(ob, 65, 69 as u8);                            // 'E'
    store8(ob, 68, 100 as u8);                           // Machine 0x8664
    store8(ob, 69, 134 as u8);
    store8(ob, 70, 3 as u8);                             // NumberOfSections
    store8(ob, 84, 240 as u8);                           // SizeOfOptionalHeader
    store8(ob, 86, 34 as u8);                            // Characteristics 0x22
    store8(ob, opt + 0, 11 as u8);                       // Magic 0x20B
    store8(ob, opt + 1, 2 as u8);
    store8(ob, opt + 2, 14 as u8);                       // MajorLinkerVersion
    w32(ob, opt + 16, PE_TEXT_RVA);                      // AddressOfEntryPoint
    w32(ob, opt + 20, PE_TEXT_RVA);                      // BaseOfCode
    w32(ob, opt + 24, 0x40000000);                       // ImageBase = 0x140000000
    w32(ob, opt + 28, 1);
    w32(ob, opt + 32, PE_SEC_ALIGN);
    w32(ob, opt + 36, PE_FILE_ALIGN);
    store8(ob, opt + 40, 6 as u8);                       // MajorOperatingSystemVersion
    store8(ob, opt + 48, 6 as u8);                       // MajorSubsystemVersion
    w32(ob, opt + 56, isize);                            // SizeOfImage (PE32+: 56)
    w32(ob, opt + 60, toff);                             // SizeOfHeaders (PE32+: 60)
    store8(ob, opt + 68, 3 as u8);                       // Subsystem: console
    w32(ob, opt + 72, 16777216);                         // StackReserve 16 MiB
    w32(ob, opt + 80, 1048576);                          // StackCommit 1 MiB
    w32(ob, opt + 88, 1048576);                          // HeapReserve
    w32(ob, opt + 96, 4096);                             // HeapCommit
    w32(ob, opt + 108, 16);                              // NumberOfRvaAndSizes
    w32(ob, opt + 120, PE_IDATA_RVA);                    // DataDirectory[1] = Import
    w32(ob, opt + 124, PE_IMPORT_DESC);
    pe_sec(ob, st, ".text", PE_IDATA_RVA - PE_TEXT_RVA, PE_TEXT_RVA,
           align_to(tlen, PE_FILE_ALIGN), toff, 0x60000020);
    pe_sec(ob, st + 40, ".idata", PE_DATA_RVA - PE_IDATA_RVA, PE_IDATA_RVA,
           align_to(ilen, PE_FILE_ALIGN), ioff, 0xC0000040);
    pe_sec(ob, st + 80, ".data", PE_STATE_RVA - PE_DATA_RVA + PE_WS_SIZE, PE_DATA_RVA,
           align_to(dlen, PE_FILE_ALIGN), doff, 0xC0000040);
    copy_n(ob, toff, txt, 0, tlen);
    copy_n(ob, ioff, idata, 0, ilen);
    copy_n(ob, doff, gb, 0, dlen);
    return doff + align_to(dlen, PE_FILE_ALIGN);
}

fn phdr(ob: ptr, at: u32, flags: u32, off: u32, vaddr: u32, filesz: u32, memsz: u32) {
    w32(ob, at, 1);
    w32(ob, at + 4, flags);
    w64(ob, at + 8, off as u64);
    w64(ob, at + 16, vaddr as u64);
    w64(ob, at + 24, vaddr as u64);
    w64(ob, at + 32, filesz as u64);
    w64(ob, at + 40, memsz as u64);
    w64(ob, at + 48, 4096);
}

fn copy_n(dst: ptr, doff: u32, src: ptr, soff: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, doff + i, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

// ---------------------------------------------------------------- 函数发射

/// 入口桩: `call _start; mov eax,60; mov edi,0; syscall` —— 用户态入口不能 return。
fn find_start(t: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let r: u32 = NO;
    while i + 6 < n {
        if lit_at(t, i, n, "_start") == 1 {
            if load8(t, i - 1) == 64 {
                r = i;
            }
        }
        i = i + 1;
    }
    return r;
}

/// ELF 入口桩。`tlsn`/`tls` **带外部对象时才用**（`docs/219` S2）：
/// `-fstack-protector` 编出来的库（发行版的 zlib 就是）会读 **`fs:0x28`** 取栈金丝雀，
/// 而没有 TLS 时 `fs` 是 0 —— 那是去读地址 `0x28`，未映射，**一进去就段错误**。
/// 所以先 `arch_prctl(ARCH_SET_FS, &__loment_tls)` 把 `fs` 指过来。
/// 金丝雀**不需要是随机数**：入口存一次、出口比一次，中间没人改，永远相等。
fn em_entry_stub(out: ptr, c: u32, tab: ptr, ss: u32, tlsn: u32, tls: u32) -> u32 {
    let d: u32 = c;
    if tls != 0 {
        d = e1(out, d, 184);                       // b8
        d = e1(out, d, 158);                       // 9e  -> mov eax, 158 (arch_prctl)
        d = e1(out, d, 0); d = e1(out, d, 0); d = e1(out, d, 0);
        d = e1(out, d, 191);                       // bf
        d = e1(out, d, 2);                         // 02  -> mov edi, 0x1002 (ARCH_SET_FS)
        d = e1(out, d, 16); d = e1(out, d, 0); d = e1(out, d, 0);
        d = e1(out, d, 72);                        // 48
        d = e1(out, d, 190);                       // be  -> movabs rsi, &__loment_tls
        fix_add(tab, d, 1, tlsn, 12, 0, 0);        // kind 1 = abs64（写 64 位绝对地址）
        d = d + 8;
        d = e1(out, d, 15);                        // 0f
        d = e1(out, d, 5);                         // 05  -> syscall
    }
    d = em_call_lbl(out, d, tab, ss, 6);
    d = em_mov_ri32(out, d, RAX, 60);
    d = em_mov_ri32(out, d, RDI, 0);
    d = e1(out, d, 15);
    return e1(out, d, 5);
}

/// PE 入口桩: `sub rsp,0x28; call _start; mov eax,60; mov edi,0; call __win_syscall; ud2`。
/// 长度固定（26 字节）—— 最后那个 `call` 的 rel32 恒为 +2（跳过 ud2 落到 shim 上），
/// 所以入口桩不需要知道 shim 的绝对位置；返回后 `d` 正好就是 shim 起点。
fn em_entry_stub_pe(out: ptr, c: u32, tab: ptr, ss: u32) -> u32 {
    let d: u32 = e1(out, c, 72);                // 48
    d = e1(out, d, 131);                        // 83
    d = e1(out, d, 236);                        // EC
    d = e1(out, d, 40);                         // 28   sub rsp, 0x28
    d = em_call_lbl(out, d, tab, ss, 6);        // call _start
    d = em_mov_ri32(out, d, RAX, 60);           // mov eax, 60
    d = em_mov_ri32(out, d, RDI, 0);            // mov edi, 0
    d = e1(out, d, 232);                        // E8   call __win_syscall
    d = e4(out, d, 2);                          // rel32 = +2
    d = e1(out, d, 15);                         // 0F
    return e1(out, d, 11);                      // 0B   ud2
}

// ---------------------------------------------------------------- 分支与算术

/// 下一个 `label %X` 的 (名起点 << 32) | 名长度。
fn next_label(t: ptr, from: u32, le: u32) -> u64 {
    let k: u32 = from;
    let found: u32 = 0;
    while k < le && found == 0 {
        if lit_at(t, k, le, "label") == 1 {
            found = 1;
        } else {
            k = k + 1;
        }
    }
    if found == 0 {
        return pk16(0, 0);
    }
    let q: u32 = skip_sp(t, k + 5, le);
    if q < le && load8(t, q) == 37 {
        q = q + 1;
    }
    let e: u32 = word_end(t, q, le);
    return pk16(q, e - q);
}

/// 给目标块的每个 phi 写入来自**当前块**的入边值。
///
/// **两趟，不是一趟。** LLVM 的 phi 是**同时**赋值：同一前驱上的若干 phi 按
/// "读旧值、写新值"一次完成。一趟顺序写会当场自我覆盖 —— 最典型的是
/// `%cur = phi [.., %nxt]` 与 `%prev = phi [.., %cur]` 这一对（链表遍历的标准写法）：
/// 先写 `%cur` 再读 `%cur` 给 `%prev`，`%prev` 拿到的是 `%nxt`。
///
/// 实测（2026-09-25）：这一条让 `__loment_free` 的插入**每步都以为走到了链尾**，
/// 于是每次都插在头部 —— 空闲链表恒为 1 个节点，`gc_auto` 因此回收不掉、arena 涨到 OOM。
/// 所以这一趟暂存不是优化，是语义。
///
/// 暂存用 `push`/`pop`（各 1 字节），不占帧 —— 栈本来就是现成的暂存区，
/// 而 pop 反序正好把顺序还原。参考侧 `tools/lomelf.py` 同一形态，
/// 两边的产物才逐字节相同。
fn emit_phis(tab: ptr, out: ptr, c: u32, t: ptr, le: u32, tbo: u32, tbl: u32) -> u32 {
    let d: u32 = c;
    let n: u32 = cell(tab, C_NPHI);
    let curbo: u32 = cell(tab, C_CURBO);
    let curbl: u32 = cell(tab, C_CURBL);
    let i: u32 = 0;
    while i < n {                              // 第一趟: 入边值 -> 栈
        let base: u32 = TB_PHI + i * 16;
        if span_eq(t, load32(tab, base + PH_BOFF), load32(tab, base + PH_BLEN), tbo, tbl) == 1 {
            let io: u32 = load32(tab, base + PH_IOFF);
            let ie: u32 = io + load32(tab, base + PH_ILEN);
            let dlen: u32 = word_end(t, io, ie) - io;
            let q: u32 = skip_sp(t, io + dlen, ie);
            let q2: u32 = skip_sp(t, q + 1, ie);
            let ts: u64 = type_span(t, q2 + 4, ie);
            let ptyo: u32 = hi32(ts);
            let ptyl: u32 = lo32(ts);
            let k: u32 = ptyo + ptyl;
            while k < ie {
                if load8(t, k) == 91 {
                    let vs: u32 = skip_sp(t, k + 1, ie);
                    let ve: u32 = word_end(t, vs, ie);
                    let lb: u32 = skip_comma(t, ve, ie);
                    let l2: u32 = lb;
                    if l2 < ie && load8(t, l2) == 37 {
                        l2 = l2 + 1;
                    }
                    let l2e: u32 = word_end(t, l2, ie);
                    if span_eq(t, l2, l2e - l2, curbo, curbl) == 1 {
                        if is_agg(t, ptyo, ptyl) == 1 {
                            d = emit_agg_addr(tab, out, d, t, vs, ve - vs, RSI);
                            d = e1(out, d, 86);            // push rsi
                        } else {
                            d = emit_get(tab, out, d, t, ptyo, ptyl, vs, ve - vs, RAX);
                            d = e1(out, d, 80);            // push rax
                        }
                    }
                    while k < ie && load8(t, k) != 93 {
                        k = k + 1;
                    }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    let j: u32 = n;
    while j > 0 {                              // 第二趟: 反序取回 (栈是 LIFO) -> 目标
        j = j - 1;
        let base2: u32 = TB_PHI + j * 16;
        if span_eq(t, load32(tab, base2 + PH_BOFF), load32(tab, base2 + PH_BLEN), tbo, tbl) == 1 {
            let io2: u32 = load32(tab, base2 + PH_IOFF);
            let ie2: u32 = io2 + load32(tab, base2 + PH_ILEN);
            let dlen2: u32 = word_end(t, io2, ie2) - io2;
            let qq: u32 = skip_sp(t, io2 + dlen2, ie2);
            let qq2: u32 = skip_sp(t, qq + 1, ie2);
            let ts2: u64 = type_span(t, qq2 + 4, ie2);
            let ptyo2: u32 = hi32(ts2);
            let ptyl2: u32 = lo32(ts2);
            let k2: u32 = ptyo2 + ptyl2;
            while k2 < ie2 {
                if load8(t, k2) == 91 {
                    let vs2: u32 = skip_sp(t, k2 + 1, ie2);
                    let ve2: u32 = word_end(t, vs2, ie2);
                    let lb2: u32 = skip_comma(t, ve2, ie2);
                    let m2: u32 = lb2;
                    if m2 < ie2 && load8(t, m2) == 37 {
                        m2 = m2 + 1;
                    }
                    let m2e: u32 = word_end(t, m2, ie2);
                    if span_eq(t, m2, m2e - m2, curbo, curbl) == 1 {
                        if is_agg(t, ptyo2, ptyl2) == 1 {
                            let so: u32 = slot_find(tab, t, io2, dlen2);
                            d = e1(out, d, 94);            // pop rsi
                            d = em_lea(out, d, RDI, RBP, so);
                            d = em_copy(out, d, RDI, RSI, ty_size(t, ptyo2, ptyl2));
                        } else {
                            d = e1(out, d, 88);            // pop rax
                            d = emit_put(tab, out, d, t, io2, dlen2, RAX);
                        }
                    }
                    while k2 < ie2 && load8(t, k2) != 93 {
                        k2 = k2 + 1;
                    }
                }
                k2 = k2 + 1;
            }
        }
    }
    return d;
}

fn jump_to(tab: ptr, out: ptr, c: u32, t: ptr, le: u32, tbo: u32, tbl: u32) -> u32 {
    let d: u32 = emit_phis(tab, out, c, t, le, tbo, tbl);
    return em_jmp_blk(out, d, tab, cell(tab, C_FNO), cell(tab, C_FNL), tbo, tbl);
}

fn do_br(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let b: u32 = skip_sp(t, i + 2, le);
    if lit_at(t, b, le, "label") == 1 {
        let L: u64 = next_label(t, b, le);
        return jump_to(tab, out, c, t, le, hi32(L), lo32(L));
    }
    let ts: u64 = type_span(t, b, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let d: u32 = emit_get(tab, out, c, t, to, tl, vs, ve - vs, RAX);
    d = e1(out, d, 133);
    d = e1(out, d, 192);                       // test eax, eax
    let A: u64 = next_label(t, ve, le);
    let B: u64 = next_label(t, hi32(A) + lo32(A), le);
    d = emit_phis(tab, out, d, t, le, hi32(A), lo32(A));
    d = em_jcc_blk(out, d, 5, tab, cell(tab, C_FNO), cell(tab, C_FNL), hi32(A), lo32(A));
    return jump_to(tab, out, d, t, le, hi32(B), lo32(B));
}

fn do_switch(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32) -> u32 {
    let ts: u64 = type_span(t, i + 7, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let d: u32 = emit_get(tab, out, c, t, to, tl, vs, ve - vs, RAX);
    let D: u64 = next_label(t, ve, le);
    let lb: u32 = 0;
    let k: u32 = ve;
    while k < le {
        if load8(t, k) == 91 && lb == 0 {
            lb = k;
        }
        k = k + 1;
    }
    let rb: u32 = lb;
    let k2: u32 = lb;
    while k2 < le {
        if load8(t, k2) == 93 {
            rb = k2;
        }
        k2 = k2 + 1;
    }
    // 逐条 case。**case 表可以跨行** —— 自举 codegen 的 `switch` 就是多行的, 而进来的 `le`
    // 是 `logical_end`（跨行指令的末端）。所以这里的空白跳过必须吃 `\n`; `skip_sp` 不吃,
    // 它按行工作。
    //
    // 2026-10-16 之前这里用的是 `skip_sp` / `skip_comma`: `q` 停在换行上, `next_label`
    // 找不到 `label` 退回 `(0,0)`, 于是 `q = skip_comma(t, 0, rb)` = **0** —— 从头重来。
    // 每绕一圈发一条回填, 32768 圈之后报"回填表满了", 看起来像容量问题。不是: **空 case
    // 表**（只把 `]` 写到下一行）一条回填都不需要, 照样打满。见 issue #2 / #10。
    let q: u32 = ws_after(t, lb + 1, rb);
    while q < rb {
        let cts: u64 = type_span(t, q, rb);
        let co: u32 = hi32(cts);
        let cl: u32 = lo32(cts);
        let ns: u32 = skip_sp(t, co + cl, rb);
        let nx: u64 = num_at(t, ns, rb);
        let num: u32 = lo32(nx);
        let L: u64 = next_label(t, hi32(nx), rb);
        let qn: u32 = 0;
        if hi32(L) == 0 {
            qn = rb;                       // 没有下一条 case 了 —— 停, 不能回到 0
        } else {
            d = em_alu_ri(out, d, CMP, RAX, num);
            let jsite: u32 = em_jcc_raw(out, d, 5);
            d = jsite + 4;
            d = emit_phis(tab, out, d, t, le, hi32(L), lo32(L));
            d = em_jmp_blk(out, d, tab, cell(tab, C_FNO), cell(tab, C_FNL), hi32(L), lo32(L));
            w32(out, jsite, d - (jsite + 4));
            qn = ws_after_comma(t, hi32(L) + lo32(L), rb);
            if qn <= q {
                qn = rb;                   // 没前进就停 —— 死循环的兜底
            }
        }
        q = qn;
    }
    return jump_to(tab, out, d, t, le, hi32(D), lo32(D));
}

/// `icmp <谓词> <类型> <a>, <b>`。
fn do_icmp(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    let ps: u32 = skip_sp(t, i + 5, le);
    let pe: u32 = word_end(t, ps, le);
    let cond: u32 = icmp_cond(t, ps, pe);
    let signed: u32 = icmp_signed(t, ps, pe);
    let ts: u64 = type_span(t, pe, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let bs: u32 = skip_comma(t, ve, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = c;
    if signed == 1 {
        d = emit_get_signed(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        d = emit_get_signed(tab, out, d, t, to, tl, bs, be - bs, RCX);
    } else {
        d = emit_get(tab, out, d, t, to, tl, vs, ve - vs, RAX);
        d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
    }
    d = em_alu_rr(out, d, 57, RAX, RCX);
    d = em_setcc(out, d, cond, RAX);
    d = em_zext64(out, d, RAX, 1);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn em_setcc(out: ptr, c: u32, cond: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(0, 0, 0, reg));
    d = e1(out, d, 15);
    d = e1(out, d, 144 + cond);
    return em_modrm3(out, d, 0, reg);
}

fn icmp_cond(t: ptr, s: u32, e: u32) -> u32 {
    if lit_at(t, s, e, "eq") == 1 {
        return 4;
    }
    if lit_at(t, s, e, "ne") == 1 {
        return 5;
    }
    if lit_at(t, s, e, "ugt") == 1 {
        return 7;
    }
    if lit_at(t, s, e, "uge") == 1 {
        return 3;
    }
    if lit_at(t, s, e, "ult") == 1 {
        return 2;
    }
    if lit_at(t, s, e, "ule") == 1 {
        return 6;
    }
    if lit_at(t, s, e, "sgt") == 1 {
        return 15;
    }
    if lit_at(t, s, e, "sge") == 1 {
        return 13;
    }
    if lit_at(t, s, e, "slt") == 1 {
        return 12;
    }
    if lit_at(t, s, e, "sle") == 1 {
        return 14;
    }
    return 4;
}

fn icmp_signed(t: ptr, s: u32, e: u32) -> u32 {
    if e - s >= 2 && load8(t, s) == 115 {
        return 1;
    }
    return 0;
}

/// 二元运算: a 放 RAX, b 放 RCX; 返回 b 的起点, 类型与 a 的跨度进格。
fn binops(tab: ptr, t: ptr, i: u32, le: u32, oplen: u32) -> u32 {
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let vs: u32 = skip_sp(t, to + tl, le);
    let ve: u32 = word_end(t, vs, le);
    let bs: u32 = skip_comma(t, ve, le);
    store32(tab, C_TYOFF, to);
    store32(tab, C_TYLEN, tl);
    store32(tab, C_VLOFF, vs);
    store32(tab, C_VLLEN, ve - vs);
    return bs;
}

fn do_alu(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
          oplen: u32, opcode: u32) -> u32 {
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let ao: u32 = skip_sp(t, to + tl, le);
    let al: u32 = word_end(t, ao, le) - ao;
    let bs: u32 = skip_comma(t, ao + al, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = emit_get(tab, out, c, t, to, tl, ao, al, RAX);
    d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
    if opcode == 0 {
        d = em_imul_rr(out, d, RAX, RCX);
    } else {
        d = em_alu_rr(out, d, opcode, RAX, RCX);
    }
    let sz: u32 = ty_size(t, to, tl);
    if sz < 8 {
        d = em_zext64(out, d, RAX, sz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn em_group3(out: ptr, c: u32, digit: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, reg));
    d = e1(out, d, 247);
    return em_modrm3(out, d, digit, reg);
}

fn do_div(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
          opts: u32) -> u32 {
    // 形参上限 10: oplen/signed/is_rem 打包进一个 (checker/codegen 的硬限额)
    let oplen: u32 = opts % 8;
    let signed: u32 = (opts / 8) % 2;
    let is_rem: u32 = opts / 16;
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let ao: u32 = skip_sp(t, to + tl, le);
    let al: u32 = word_end(t, ao, le) - ao;
    let bs: u32 = skip_comma(t, ao + al, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = c;
    if signed == 1 {
        d = emit_get_signed(tab, out, d, t, to, tl, ao, al, RAX);
        d = emit_get_signed(tab, out, d, t, to, tl, bs, be - bs, RCX);
        d = e1(out, d, 72);
        d = e1(out, d, 153);                     // cqo
    } else {
        d = emit_get(tab, out, d, t, to, tl, ao, al, RAX);
        d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
        d = em_mov_ri32(out, d, RDX, 0);
    }
    let digit: u32 = 6;
    if signed == 1 {
        digit = 7;
    }
    d = em_group3(out, d, digit, RCX);
    let sel: u32 = RAX;
    if is_rem == 1 {
        sel = RDX;
    }
    let sz: u32 = ty_size(t, to, tl);
    if sz < 8 {
        d = em_zext64(out, d, sel, sz);
    }
    return emit_put(tab, out, d, t, doff, dlen, sel);
}

fn em_shift_cl(out: ptr, c: u32, digit: u32, reg: u32) -> u32 {
    let d: u32 = em_rex(out, c, rex(1, 0, 0, reg));
    d = e1(out, d, 211);
    return em_modrm3(out, d, digit, reg);
}

fn do_shift(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32,
            opts: u32) -> u32 {
    // 同上: oplen/digit/is_ashr 打包
    let oplen: u32 = opts % 8;
    let digit: u32 = (opts / 8) % 8;
    let is_ashr: u32 = opts / 64;
    let ts: u64 = type_span(t, i + oplen, le);
    let to: u32 = hi32(ts);
    let tl: u32 = lo32(ts);
    let ao: u32 = skip_sp(t, to + tl, le);
    let al: u32 = word_end(t, ao, le) - ao;
    let bs: u32 = skip_comma(t, ao + al, le);
    let be: u32 = word_end(t, bs, le);
    let d: u32 = c;
    if is_ashr == 1 {
        d = emit_get_signed(tab, out, d, t, to, tl, ao, al, RAX);
    } else {
        d = emit_get(tab, out, d, t, to, tl, ao, al, RAX);
    }
    d = emit_get(tab, out, d, t, to, tl, bs, be - bs, RCX);
    d = em_shift_cl(out, d, digit, RAX);
    let sz: u32 = ty_size(t, to, tl);
    if sz < 8 {
        d = em_zext64(out, d, RAX, sz);
    }
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn do_atomic(tab: ptr, out: ptr, c: u32, t: ptr, i: u32, le: u32, doff: u32, dlen: u32) -> u32 {
    // `i` 指着 `atomicrmw`, 后面还有**一个操作名**才轮到类型:
    // `atomicrmw add ptr %v, i32 1 seq_cst`。所以跳过的是 `atomicrmw add ` (14), 不是
    // `atomicrmw ` (10) —— 少跳这 4 个字节时读到的"类型"是 `add`, 于是
    // `skip_sp(po + pl)` 落在 `ptr` 上, `emit_get_ptr` 拿着值为 `ptr` 去查表, 报的是一句
    // "指针值查不到: ptr"（离现场很远）。参考实现的正则 `atomicrmw\s+add\s+(\w+)` 里
    // 一直有那个 `add`, 所以这是镜像单方面的漏抄 —— 而**没有任何语料用过 `atomic_add`**,
    // 于是它一直潜伏到 2026-10-14 线程那笔（探针的原子累加第一次把这条路走通）。
    let a: u32 = i + 14;
    let pty: u64 = type_span(t, a, le);
    let po: u32 = hi32(pty);
    let pl: u32 = lo32(pty);
    let ps: u32 = skip_sp(t, po + pl, le);
    let pe: u32 = word_end(t, ps, le);
    let b: u32 = skip_comma(t, pe, le);
    let vty: u64 = type_span(t, b, le);
    let vo: u32 = hi32(vty);
    let vl: u32 = lo32(vty);
    let vs: u32 = skip_sp(t, vo + vl, le);
    let ve: u32 = word_end(t, vs, le);
    let d: u32 = emit_get_ptr(tab, out, c, t, ps, pe - ps, RCX);
    d = emit_get(tab, out, d, t, vo, vl, vs, ve - vs, RAX);
    d = e1(out, d, 240);                          // lock
    d = em_rex(out, d, rex(1, RAX, 0, RCX));
    d = e1(out, d, 15);
    d = e1(out, d, 193);                          // xadd
    d = em_mem(out, d, RAX, RCX, 0);
    return emit_put(tab, out, d, t, doff, dlen, RAX);
}

fn emit_func(tab: ptr, out: ptr, c: u32, t: ptr, ls: u32, le: u32, bs: u32, be: u32) -> u32 {
    setcell(tab, C_NSLOT, 0);
    setcell(tab, C_NALLOC, 0);
    setcell(tab, C_FRAME, 0);
    let ns: u32 = plan_params(tab, t, ls, le);
    let ne: u32 = word_end(t, ns, le);
    plan_frame(tab, t, bs, be);
    lbl_add(tab, ns, ne - ns, 0, 0, txt_base(tab) + c);
    setcell(tab, C_FNO, ns);
    setcell(tab, C_FNL, ne - ns);
    let d: u32 = e1(out, c, 85);          // push rbp
    d = e1(out, d, 72);                   // REX.W
    d = e1(out, d, 137);                  // mov rbp, rsp
    d = e1(out, d, 229);
    if cell(tab, C_FRAME) != 0 {
        d = em_alu_ri(out, d, SUB, RSP, cell(tab, C_FRAME));
    }
    let i: u32 = bs;
    while i < be {
        let ls2: u32 = skip_sp(t, i, be);
        let le2: u32 = logical_end(t, i, be);
        // M59 的元数据附着 (`--debug`) 去掉再判读 —— 但**推进仍按原行尾** (`i = le2 + 1`)
        let me2: u32 = strip_meta(t, ls2, le2);
        // 基本块标签 -> 登记代码位置
        let e3: u32 = me2;
        let go3: u32 = 1;
        while e3 > ls2 && go3 == 1 {
            let c3: u32 = load8(t, e3 - 1);
            if c3 == 32 || c3 == 9 || c3 == 13 {
                e3 = e3 - 1;
            } else {
                go3 = 0;
            }
        }
        if e3 > ls2 && load8(t, e3 - 1) == 58 && line_dest(t, ls2, me2) == 0 {
            setcell(tab, C_CURBO, ls2);
            setcell(tab, C_CURBL, e3 - 1 - ls2);
            lbl_add(tab, cell(tab, C_FNO), cell(tab, C_FNL), ls2, e3 - 1 - ls2,
                    txt_base(tab) + d);
        } else {
            let dst: u64 = line_dest(t, ls2, me2);
            store32(tab, C_DESTO, hi32(dst));
            store32(tab, C_DESTL, lo32(dst));
            if dst != 0 {
                let op: u32 = skip_sp(t, hi32(dst) + lo32(dst), me2);
                let op2: u32 = skip_sp(t, op + 1, me2);
                d = lower(tab, out, d, t, op2, me2);
            } else {
                d = lower(tab, out, d, t, ls2, me2);
            }
        }
        i = le2 + 1;
    }
    return d;
}

/// 把字面量的字节写进 `t` 的 `at` 处（不含结尾 0），返回写到的位置。
/// 收编面那三个名字用它进名字池 —— 与 `copy_name` 同一条理由：标签表存的是**偏移**，
/// 而 `lbl_find` 拿输入缓冲当基，所以名字必须落在 `t` 里。
fn put_name(t: ptr, at: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    // 与 `copy_name` 同一条守卫: 名字池住在**输入缓冲**里，越界就踩到下一张缓冲 ——
    // **响亮地退出**，不静默写坏（与 `IN_CAP` 那条同一个纪律）。
    if at + n >= IN_CAP {
        return fail("the input buffer has no room left for the conscripted names");
    }
    let i: u32 = 0;
    while i < n {
        store8(t, at + i, str_byte(s, i) as u8);
        i = i + 1;
    }
    return at + n;
}

/// **收编面**（`docs/219` §6 第 1 条）：C 世界里那几个"**可闭合**"的名字，由**我们**提供。
///
/// **hex 与 `tools/lomelf.py` 的 `Emitter.emit_conscript` 逐字节相同** —— 那边是
/// `emit(...)` 的字面字节，这里是同一串的十六进制。`loment_elf_test` 的自举镜像那格
/// **逐字节比两份产物**，所以两处**必须一起改**：动一条指令就要重算 hex（内部的 rel32
/// 是手算好的字面位移，不是回填出来的）。
///
/// 三个入口在整段里的偏移是 `0` / `29` / `54`（`memcpy` 29 字节、`memset` 25、`memcmp` 48）。
/// 发一个"**换 ABI 的薄壳**"（`docs/219` §2.1）：C 按 System V 把实参放在 `rdi`，
/// 而我们自己的函数**从栈上取**（调用方 `push`、被调方从 `[rbp+16]` 起）——
/// 所以壳是 `push rbp; push rdi; call <tgt>; add rsp,8; pop rbp; ret`。
///
/// 与参考实现 `Emitter.emit_conscript` 里那两段**逐字节相同**：`call` 的 rel32 是
/// **回填**出来的（不是字面量 —— 目标地址随布局变），两侧的回填口径也一样。
fn emit_abi_wrapper(tab: ptr, out: ptr, c: u32, t: ptr, nm: u32, nl: u32, ts: u32, tl: u32) -> u32 {
    lbl_add(tab, nm, nl, 0, 0, txt_base(tab) + c);
    let d: u32 = blob_copy(out, c, "5557e800000000");   // push rbp; push rdi; call <占位>
    fix_add(tab, c + 3, 0, ts, tl, 0, 0);               // rel32 落在 `E8` 的下一字节
    return blob_copy(out, d, "4883c4085dc3");           // add rsp,8; pop rbp; ret
}

fn emit_conscript(tab: ptr, out: ptr, c: u32, t: ptr) -> u32 {
    let p0: u32 = cell(tab, C_EXTN);
    let p1: u32 = put_name(t, p0, "memcpy");
    let p2: u32 = put_name(t, p1, "memset");
    let p3: u32 = put_name(t, p2, "memcmp");
    let p4: u32 = put_name(t, p3, "__stack_chk_fail");
    setcell(tab, C_EXTN, p4);
    // 三段是 `memcpy`(35) / `memset`(31) / `memcmp`(48)，`__stack_chk_fail`(2) 在 114。
    // `memcpy`/`memset` 比上一版长了 6 字节 —— 它们现在把**原起点**放进 rax 再返回
    // （C 的 `memcpy`/`memset` 返回 `void*`），循环里 `rdi` 被推到末尾、rax 被字节搬运占用，
    // 所以借 `r8`（调用者保存）存一下。两侧同一串字节，参考实现那边有逐条注释。
    lbl_add(tab, p0, 6, 0, 0, txt_base(tab) + c);
    lbl_add(tab, p1, 6, 0, 0, txt_base(tab) + c + 35);
    lbl_add(tab, p2, 6, 0, 0, txt_base(tab) + c + 66);
    lbl_add(tab, p3, 16, 0, 0, txt_base(tab) + c + 114);
    let d: u32 = blob_copy(out, c, "4989f84885d20f84130000008a06880748ffc648ffc748ffca0f85edffffff4c89c0c34989f84885d20f840f00000040883748ffc748ffca0f85f1ffffff4c89c0c34885d20f841b0000008a078a0e38c80f851200000048ffc748ffc648ffca0f85e5ffffff31c0c30fb6c00fb6c929c8c30f0b");
    // ---- malloc / free：**内存那一条不收编，是"划掉"**（docs/219 §2.1）----
    // **只在堆在的时候发** —— 底下调的是 `@__loment_alloc` / `@__loment_free`；没有它们
    // 就没有"我们的堆"，发了会悬着一个未定义的调用。判据是**这份 IR 里有没有那两条定义**：
    // `lbl_find` 比的是**内容**（`span_eq`），所以把名字写进名字池、拿这段 span 去查即可 ——
    // 不必复用函数定义那一处 span。
    // `put_name` 返回的是**末尾**偏移，所以每个名字的**起点**是它前一次的返回值：
    // 起点依次是 `hn` / `a1` / `a2` / `a3`。长度写死（14/13/6/4）—— 与名字本身同生共死。
    let hn: u32 = cell(tab, C_EXTN);
    let a1: u32 = put_name(t, hn, "__loment_alloc");     // 14 字节
    let a2: u32 = put_name(t, a1, "__loment_free");      // 13
    let a3: u32 = put_name(t, a2, "malloc");             // 6
    let a4: u32 = put_name(t, a3, "free");               // 4
    setcell(tab, C_EXTN, a4);
    let dd: u32 = d;
    if lbl_find(tab, t, hn, 14, 0, 0) != NO {
        dd = emit_abi_wrapper(tab, out, dd, t, a2, 6, hn, 14);
    }
    if lbl_find(tab, t, a1, 13, 0, 0) != NO {
        dd = emit_abi_wrapper(tab, out, dd, t, a3, 4, a1, 13);
    }
    return dd;
}

fn emit_all(tab: ptr, out: ptr, c: u32, t: ptr, n: u32, tlsn: u32, tls: u32) -> u32 {
    let ss: u32 = find_start(t, n);
    if ss == NO {
        return fail("the unit has no `_start` entry point -- declare `fn _start()`, or `command_main` together with a command declaration");
    }
    let d: u32 = c;
    if cell(tab, C_PE) == 1 {
        d = em_entry_stub_pe(out, c, tab, ss);
        setcell(tab, C_SHIM, d);                // syscall 站点按这个偏移算 rel32
        let rn: u32 = n_shim();
        let k: u32 = 0;
        while k < rn {
            d = blob_copy(out, d, shim_part(k));
            k = k + 1;
        }
    } else {
        d = em_entry_stub(out, c, tab, ss, tlsn, tls);
    }
    let i: u32 = 0;
    while i < n {
        let le: u32 = line_end(t, i, n);
        let ls: u32 = skip_sp(t, i, le);
        if lit_at(t, ls, le, "define ") == 1 {
            let bs: u32 = le + 1;
            let bs2: u32 = bs;
            let j: u32 = bs;
            let be: u32 = bs;
            let go: u32 = 1;
            while j < n && go == 1 {
                let je: u32 = line_end(t, j, n);
                let js: u32 = skip_sp(t, j, je);
                if js < je && load8(t, js) == 125 {
                    be = je;
                    go = 0;
                } else {
                    j = je + 1;
                }
            }
            d = emit_func(tab, out, d, t, ls, le, bs2, be);
            i = be + 1;
        } else {
            i = le + 1;
        }
    }
    return d;
}

// ---------------------------------------------------------------- 主程序

fn wdec(fd: u64, tmp: ptr, v: u32) -> u64 {
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        return write_all(fd, tmp, 1);
    }
    while x > 0 {
        let dg: u32 = x % 10;
        store8(tmp, d, (48 + dg) as u8);
        x = x / 10;
        d = d + 1;
    }
    let buf: ptr = ptr_add(tmp, 32);
    let q: u32 = 0;
    while q < d {
        store8(buf, q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    return write_all(fd, buf, d as u64);
}

fn _start() -> u32 {
    let mem: ptr = sys_alloc(ARENA) as ptr;
    if mem as u64 == 0 {
        return fail("out of memory (brk failed)");
    }
    let rc: u32 = run(mem);
    return die(rc as u64);
}

fn run(mem: ptr) -> u32 {
    let ab: ptr = ptr_add(mem, M_ARGV);
    let a1: u64 = argv_n(ab, 8192, 1);
    let o1: u64 = argv_n(ab, 8192, 2);
    if a1 == 0 || o1 == 0 {
        wstr(2, "loment: usage: loment-lomelf IN.ll OUT [--diag-out PATH] [--link OBJ ...] (normally reached through `loment build`)\n");
        return die(2);
    }
    // 多出来的实参只可能是启动器透传的 `--link FILE.o` (docs/173 FFI)。**必须解析**:
    // 不看 argv[3..] 的话 `--link` 会被**静静忽略**, 然后在回填时报一句 "未定义的标签:
    // c_add" —— 用户看到的是"符号找不到"而不是"这个功能没实现", 方向完全错了。
    //
    // **必须先收完再读输入**: argv_n 每次都把 `/proc/self/cmdline` 重新读进 argv 缓冲,
    // 而它存放路径字符串的落点 (argv 缓冲 + 8192) **正是输入缓冲的起点** —— 读过输入之后
    // 再调 argv_n 会把输入的头 19 个字节踩掉。
    //
    // **判的是 lo32(长度) 不是整个返回值**: `/proc/self/cmdline` 以 NUL 结尾, 于是 argv_n
    // 的收尾那句 (`if f == n`) 会给出一个**长度 0 的命中** —— 打包值 `m * PHI` 非零。
    // 只判 `!= 0` 会把**每一次正常调用**都当成"多了个实参", 实测把 loment_elf_test 从 7/7
    // 打到 5/7 (两条都是"镜像退出 2")。
    let pbuf: ptr = ptr_add(mem, M_TXT);
    let nlink: u32 = 0;
    // `--allow-ports`（`docs/222` §4 的端口门）：默认**不收**带未定义符号的外源对象。
    // 开发通道与判据显式写它；发行版启动器永不写（`tools/loment_dist.py`）。
    let ap: u32 = 0;
    // 启动器给的 `--diag-out` 路径（0 = 没给）。写不了产物时那一份结构化诊断就写到它里面。
    let dg: u32 = 0;
    let obase: u32 = lo32(a1) + 8 + lo32(o1) + 8;   // 与下面的 pout 对齐
    let ok: u32 = 3;
    let go: u32 = 1;
    while go == 1 {
        let av: u64 = argv_n(ab, 8192, ok);
        if lo32(av) == 0 {
            go = 0;
        } else {
            // `--allow-ports`（`docs/222` §4 的端口门）：不带参数，只把门放开。**先认它**
            // —— 两条都不带参数、长度不同，判在 `--link` 之前免得将来有人把 `--link` 的
            // 名字判宽了、把这一条吞掉。
            if lo32(av) == 13 && lit_at(ab, hi32(av), hi32(av) + 13, "--allow-ports") == 1 {
                ap = 1;
                ok = ok + 1;
            } else if lo32(av) == 6 && lit_at(ab, hi32(av), hi32(av) + 6, "--link") == 1 {
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --link needs a file name\n");
                    return die(2);
                }
                let dst: u32 = obase + nlink * 1024;
                if dst + 1024 > DIAGB_OFF {
                    wstr(2, "loment: too many --link files\n");
                    return die(2);
                }
                let j: u32 = 0;
                while j < lo32(pv) {
                    store8(pbuf, dst + j, load8(ab, hi32(pv) + j) as u8);
                    j = j + 1;
                }
                store8(pbuf, dst + lo32(pv), 0 as u8);
                nlink = nlink + 1;
                ok = ok + 2;
            } else if lo32(av) == 10
                    && lit_at(ab, hi32(av), hi32(av) + 10, "--diag-out") == 1 {
                // 启动器给的那条诊断文件。**路径存在 pbuf 的最后 1 KiB**（`DIAGB_OFF`），
                // 与输入/输出/`--link` 那三个按 argv 长度算出来的落点不抢。
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --diag-out needs a file name\n");
                    return die(2);
                }
                let j0: u32 = 0;
                while j0 < lo32(pv) {
                    store8(pbuf, DIAGB_OFF + j0, load8(ab, hi32(pv) + j0) as u8);
                    j0 = j0 + 1;
                }
                store8(pbuf, DIAGB_OFF + lo32(pv), 0 as u8);
                dg = 1;
                ok = ok + 2;
            } else {
                wstr(2, "loment: unknown option ");
                write_all(2, ptr_add(ab, hi32(av)), lo32(av) as u64);
                wstr(2, "\n");
                return die(2);
            }
        }
    }
    let inb: ptr = ptr_add(mem, M_IN);
    let ino: u32 = hi32(a1);
    let inn: u32 = lo32(a1);
    let oo: u32 = hi32(o1);
    let ol: u32 = lo32(o1);
    // 先把两个路径拷到稳定缓冲 (argv 的 cmdline 缓冲在后面会被读入覆盖)
    let pin: u32 = 0;
    let i: u32 = 0;
    while i < inn {
        store8(pbuf, pin + i, load8(ab, ino + i) as u8);
        i = i + 1;
    }
    store8(pbuf, pin + inn, 0 as u8);
    let pout: u32 = inn + 8;
    i = 0;
    while i < ol {
        store8(pbuf, pout + i, load8(ab, oo + i) as u8);
        i = i + 1;
    }
    store8(pbuf, pout + ol, 0 as u8);
    let fd: i64 = open_ro(ptr_add(pbuf, pin));
    if fd < 0 {
        return fail("cannot open the input file");
    }
    let n: u64 = read_all(fd as u64, inb, IN_CAP as u64);
    syscall4(3, fd as u64, 0, 0);
    if n == 0 {
        return fail("the input file is empty");
    }
    // **读满上限 = 文件还有剩** —— `read_all` 读够 `cap` 就停，它不知道文件多长。
    // 不检查的后果不是"少几条指令"：`.ll` 是逐行语法，截断点之后的函数定义凭空消失，
    // 汇编出来的是一个**缺胳膊少腿、跑起来就段错误**的可执行文件。
    // 2026-09-18 实测（docs/192）：同一份 `.ll`，这边段错误、clang 汇编完全正常 ——
    // 责任就在这一行。与 `copy_name` 那条守卫、与驱动程序里 `MAX_USE` / `MAX_ADDIN`
    // 的注解是同一条纪律：**超限报错退出，绝不静默丢**。
    if n >= IN_CAP as u64 {
        return fail("the input .ll does not fit in the input buffer (it is too large for this linker)");
    }
    let tab: ptr = ptr_add(mem, M_TAB);
    let gb: ptr = ptr_add(mem, M_GB);
    let txt: ptr = ptr_add(mem, M_TXT + 65536);
    let ob: ptr = ptr_add(mem, M_OUT);
    // 输出名以 `.exe` 结尾 = 出 PE（Windows），否则出 ELF。参考实现用 --target，
    // 镜像这边按后缀走 —— 发行包的启动器本来就按平台给不同的输出名。
    let pe: u32 = 0;
    if ol >= 4 {
        if load8(pbuf, pout + ol - 4) == 46 {
            if load8(pbuf, pout + ol - 3) == 101 {
                if load8(pbuf, pout + ol - 2) == 120 {
                    if load8(pbuf, pout + ol - 1) == 101 {
                        pe = 1;
                    }
                }
            }
        }
    }
    if nlink != 0 && pe == 1 {
        wstr(2, "loment: --link takes ELF objects only for now\n");
        return die(2);
    }
    setcell(tab, C_PE, pe);
    // 外部符号名池的游标: 从输入文本的**末尾**开始, 见 copy_name。
    setcell(tab, C_EXTN, n as u32);
    // **阶段 0（V2，`docs/183` §4）**：先扫一遍 `--link` 的文件里有没有共享对象。
    // 这一步必须**在入口桩之前**，因为"要不要自己装 TLS"取决于它：
    //   * 静态链外部 `.o` 时**要装**（`fs:0x28` 得落在一块可读写的 TLS 里）；
    //   * 动态链时**不能装** —— `fs` 归 `ld.so` 管，指向 glibc 的整块 TLS
    //     （`errno`/`tcache`/栈金丝雀都在里面）。再 `arch_prctl(ARCH_SET_FS)` 一次就把
    //     它顶掉了，症状是 zlib 一路调到 libc 的 `malloc` 时读到垃圾线程指针。
    let nobj: u32 = 0;
    let nshared: u32 = 0;
    if nlink != 0 && pe == 0 {
        let s0: u32 = 0;
        while s0 < nlink {
            let p0: ptr = ptr_add(pbuf, obase + s0 * 1024);
            let ln0: u32 = read_link_file(p0, ptr_add(mem, M_OBJ), OBJ_CAP);
            if is_shared(ptr_add(mem, M_OBJ), ln0) == 1 {
                if nshared != 0 {
                    wstr(2, "loment: 一次只能链一个共享对象\n");
                    return die(1);
                }
                if ap == 0 {
                    wstr(2, "loment: 这份产物带了通向世界的端口（共享对象），链接器默认不收。\n");
                    wstr(2, "loment: 开发通道要它得显式写 --allow-ports；发行版里这条路是关着的（docs/219 §8c）\n");
                    return die(1);
                }
                let _r: u32 = so_load(tab, inb, ptr_add(mem, M_OBJ), ln0, p0);
                nshared = 1;
            } else {
                nobj = nobj + 1;
            }
            s0 = s0 + 1;
        }
        setcell(tab, C_NSHARED, nshared);
    }
    collect_globals(tab, inb, n as u32, gb);
    collect_externs(tab, inb, n as u32);
    place_globals(tab, inb);
    // **TLS 的名字先写进名字池**：入口桩要用它（`arch_prctl` 的目标），而标签要等
    // TLS 块摆好（在对象之后）才立 —— 回填在最后一步，所以中间这段时间"有名无址"是对的。
    let tlsn: u32 = cell(tab, C_EXTN);
    let tls: u32 = 0;
    if nobj != 0 && nshared == 0 {
        setcell(tab, C_EXTN, put_name(inb, tlsn, "__loment_tls"));
        tls = 1;
    }
    let tlen0: u32 = emit_all(tab, txt, 0, inb, n as u32, tlsn, tls);
    // **收编面**（`docs/219` §6）：链里带了外部对象，就把"可闭合"那几个名字提供出来，
    // 于是它们不再是未定义符号 —— 从表上划掉。粒度是"有没有外部对象"，与参考实现
    // `tools/lomelf.py` 的 `compile_ll` 同一处判断、同一段字节（`loment_elf_test` 的自举
    // 镜像那格逐字节钉）。**顺序与那边一致**：我们的代码 -> 收编面 -> 外部对象。
    let tlen: u32 = tlen0;
    if nobj != 0 {
        tlen = emit_conscript(tab, txt, tlen, inb);
    }
    // 外部目标文件 (docs/173): 代码节接在我们自己的代码之后, **数据节接在数据段之后**,
    // 导出符号立标签。
    //
    // **两趟**（`FujoJTOP/loment#405`）。参考实现在 `compile_ll` 里就是这个次序，
    // 次序不同产物就不同：
    //   ① **需要集**：这份 IR 里 `declare` 的外部符号 ∪ 直接给的 `.o` 的未定义符号
    //      —— 归档的定点选择要它（"我的 a.o 引用归档成员里的 b"正是靠这一条接上的）；
    //   ② 先按参数顺序**摆直接对象**，再按同样顺序**处理归档** —— 参考实现那份是
    //      `flat = list(direct) + 各归档挑出来的成员`，**直接对象一律排在归档前面**。
    let tobj: ptr = ptr_add(mem, M_OBJ);
    let arb: ptr = ptr_add(mem, M_AR);
    let got: u32 = 0;
    if nlink != 0 {
        need_from_externs(tab, inb);
        while got < nlink {
            let p0: ptr = ptr_add(pbuf, obase + got * 1024);
            let ln0: u32 = read_link_file(p0, tobj, OBJ_CAP);
            if is_archive(tobj, ln0) == 0 {
                // **共享对象不参与布局**（V2）：它的字节一个也不进产物，这里只跳过。
                if is_shared(tobj, ln0) == 0 {
                    check_obj(p0, tobj);      // 不是归档就得是能用的 `.o`（否则拒在这里）
                    let _u: u32 = obj_syms(tab, inb, tobj, 1);
                }
            }
            got = got + 1;
        }
        // ① 直接对象
        got = 0;
        while got < nlink {
            let p0: ptr = ptr_add(pbuf, obase + got * 1024);
            let ln1: u32 = read_link_file(p0, tobj, OBJ_CAP);
            if is_archive(tobj, ln1) == 0 {
                if is_shared(tobj, ln1) == 0 {
                    check_obj(p0, tobj);
                    tlen = link_object_mem(tab, inb, txt, gb, tlen, tobj, ap);
                }
            }
            got = got + 1;
        }
        // ② 归档：整包读进 `M_AR`（成员要一个个拷进 `M_OBJ` 再摆），定点挑成员再摆。
        got = 0;
        while got < nlink {
            let ln2: u32 = read_link_file(ptr_add(pbuf, obase + got * 1024), tobj, OBJ_CAP);
            if is_archive(tobj, ln2) == 1 {
                copy_n(arb, 0, tobj, 0, ln2);
                tlen = link_archive(tab, inb, txt, gb, tlen, tobj, arb, ln2, ap);
            }
            got = got + 1;
        }
    }
    // **文本段满了就点名退出**（`docs/253`，2026-10-16）。数据段钉在 `TEXT_VADDR + OUT_CAP`，
    // 所以文本一旦超过 `OUT_CAP` 就会盖到数据段上 —— 而原先**盖上去不报错**：产物一启动
    // 就段错误（0 字节输出），看起来像编译器坏了。与 `TB_LBL_MAX` / `TB_FIX_MAX` / `IN_CAP`
    // 那几条守卫同一个纪律：**满了就说出来，不往下写**。参考实现 `tools/lomelf.py` 的
    // `compile_ll` 末尾同一条、同一个数（那边的常量叫 `TEXT_CAP`）。
    if tlen > OUT_CAP {
        let _f: u32 = fail("文本段满了 — 抬 OUT_CAP (loment/tools/lomelf.lomt) 与 tools/lomelf.py 的 TEXT_CAP/ELF_DATA_VADDR");
    }
    // **bss 的地址与标签必须等到这里**（`docs/219` §8b 第 1 条）—— 位置见 `place_bss`。
    // **TLS 块**（`docs/219` S2）：接在对象数据之后、与参考实现同一处、同样 256 字节。
    // 必须在 `place_bss` **之前** —— bss 的地址是按数据段当前长度算的。
    if nobj != 0 && nshared == 0 {
        let t0: u32 = align_to(cell(tab, C_GB), 16);
        pad_zero(gb, cell(tab, C_GB), t0);
        pad_zero(gb, t0, t0 + 256);
        setcell(tab, C_GB, t0 + 256);
        lbl_add(tab, tlsn, 12, 0, 0, data_base(tab) + t0);
    }
    place_bss(tab, inb);
    // 外部对象的重定位: **所有对象都摆好了**才应用 (docs/173 阶段 2)。
    let rr: u32 = apply_relocs(tab, inb, txt, gb);
    if rr != 0 {
        return rr;
    }
    // **导入**（V2）：所有标签都立好了才挑得出"谁还没定义"。每个导入立一个 PLT 桩的
    // 标签，于是 `resolve_fixups` 把它们指到桩上（而不是报"未定义的标签"）。
    if nshared != 0 {
        let _pa: u32 = collect_imports(tab, inb, tlen);
    }
    let r: u32 = resolve_fixups(tab, inb, txt);
    if r != 0 {
        return r;
    }
    let dlen: u32 = align_to(cell(tab, C_GB), 8);
    let total: u32 = 0;
    if nshared != 0 {
        tlen = emit_dyn_tail(tab, inb, txt, tlen, dlen, cell(tab, C_BSS));
        // **尾部那几张表也算进文本段**（上面那道 `OUT_CAP` 检查在它之前跑的）——
        // 数据段钉在 `TEXT_VADDR + OUT_CAP`，超了就会盖上去，而**盖上去不报错**。
        if tlen > OUT_CAP {
            let _f: u32 = fail("文本段+动态表超过 OUT_CAP — 抬 OUT_CAP (loment/tools/lomelf.lomt) 与 tools/lomelf.py 的 TEXT_CAP/ELF_DATA_VADDR");
        }
        total = build_elf_dynamic(tab, ob, txt, tlen, gb, dlen, cell(tab, C_BSS));
    } else if pe == 1 {
        let idata: ptr = ptr_add(tab, TB_IDATA);
        let dd: u32 = 0;
        let rn: u32 = n_idata();
        let k: u32 = 0;
        while k < rn {
            dd = blob_copy(idata, dd, idata_part(k));
            k = k + 1;
        }
        total = build_pe(ob, txt, tlen, gb, dlen, idata, dd);
    } else {
        total = build_elf(tab, ob, txt, tlen, gb, dlen, cell(tab, C_BSS));
    }
    // **点名那个写不出去的文件**: 说"写不了输出"而不说是哪个, 读者手上唯一有用的
    // 那条信息(路径)就没了 —— 而这条最常撞上的起因正是"输出目录不存在", 一看路径就明白
    // (issue #8 的第二条评论)。
    let ofd: i64 = open_wo(ptr_add(pbuf, pout));
    if ofd < 0 {
        // 结构化那一份先落地（有 `--diag-out` 才写），再由 `failc` 打那一行给人看 ——
        // 两个受众都要，理由与驱动程序那边同一条。
        if dg == 1 {
            let _g: u64 = emit_wfail(ptr_add(pbuf, DIAGB_OFF), ptr_add(pbuf, pout), ol);
        }
        return failc("cannot write the output file: ", ptr_add(pbuf, pout));
    }
    write_all(ofd as u64, ob, total as u64);
    syscall4(3, ofd as u64, 0, 0);
    return 0;
}
