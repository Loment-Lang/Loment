// os/alarm.lomt — 进程级定时器: `alarm` 与 `setitimer`
//
// 为什么需要它: 这两条是最老的定时接口，老到很多东西仍然只认它们 —— 超时保护、
// 批处理里的"跑太久就打断"、以及那些用 `SIGALRM` 当心跳的守护进程。它们和
// timerfd 的差别是**交付方式**: alarm 到点给你**一个信号**（打断正在跑的代码），
// timerfd 到点给你**一个可读的 fd**（你自己决定什么时候读）。要"打断"的场合
// 只有这一条路。
//
// 三条必须知道的语义:
//   * `alarm(0)` 表示**取消**，返回"上一个闹钟还剩几秒" —— 不是"立刻响"。
//   * 闹钟**按进程算**，不按线程；同一时刻只有一个 REAL 定时器，重复设置会**替换**
//     （不是叠加）。
//   * `exec` 会**清掉** `alarm`（未到期的闹钟不跨 exec），`setitimer` 同样。
//     子进程 fork 之后也不继承 —— "父进程设的闹钟把子进程打断"是要刻意做的，
//     不是默认。
//
// 结构体 `struct itimerval`（x86-64 32 字节）:
//   偏移 0   interval（重复周期，全 0 = 一次性的）
//   偏移 16  value（第一次到点的时刻）
//   每段是 `{i64 tv_sec, i64 tv_usec}` —— 微秒, 不是纳秒。
//
// 边界: 号是 x86-64 Linux 的。**本模块不装信号处理函数**（那要 `rt_sigaction` 与
// 还原桩，见 os/signal 的边界）; 调用方要么接受默认动作, 要么自己在别处装处理器。
// 自检只验纯逻辑（结构体打包与解码）。
//
// 命名: 公开 al_*, 内部 alq_。自检 test_alarm_*。

module alarm

use timeabi

/// 真实时间（墙上时钟）。
pub const AL_ITIMER_REAL: u32 = 0;
/// 进程用户态 CPU 时间。
pub const AL_ITIMER_VIRTUAL: u32 = 1;
/// 进程 + 系统 CPU 时间。
pub const AL_ITIMER_PROF: u32 = 2;
/// `struct itimerval` 的字节数。
pub const AL_IVAL_BYTES: u32 = 32;

const ALQ_SYS_PAUSE: u64 = 34;
const ALQ_SYS_ALARM: u64 = 37;
const ALQ_SYS_SETITIMER: u64 = 38;

fn alq_ld64(p: ptr, off: u32) -> u64 {
    let v: u64 = 0;
    let b: u32 = 0;
    while b < 8 {
        v = v | ((load8(p, off + b) as u64) << (8 * b));
        b = b + 1;
    }
    return v;
}

/// 打一个完整的 `itimerval`。两段都是"秒 + 微秒"。
pub fn al_ival_pack(buf: ptr, isec: u64, iusec: u64, vsec: u64, vusec: u64) -> u32 {
    return ta_ival_pack(buf, isec, iusec, vsec, vusec);
}

/// 把 interval 段（前 16 字节）拷进 out，返回 16。
pub fn al_ival_interval(buf: ptr, out: ptr) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        store8(out, i, load8(buf, i) as u8);
        i = i + 1;
    }
    return 16;
}

/// 把 value 段（偏移 16 的 16 字节）拷进 out，返回 16。
pub fn al_ival_value(buf: ptr, out: ptr) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        store8(out, i, load8(buf, 16 + i) as u8);
        i = i + 1;
    }
    return 16;
}

/// 第 off 段（0 = interval，16 = value）的秒。
pub fn al_ival_sec(buf: ptr, off: u32) -> u64 {
    if off == 0 {
        return ta_ival_interval_sec(buf);
    }
    return ta_ival_value_sec(buf);
}

/// 第 off 段的微秒。
pub fn al_ival_usec(buf: ptr, off: u32) -> u64 {
    if off == 0 {
        return ta_ival_interval_usec(buf);
    }
    return ta_ival_value_usec(buf);
}

/// `alarm(seconds)`：给本进程装一个"seconds 秒后发 SIGALRM"的闹钟。
/// 返回**上一个闹钟剩余秒数**（0 = 之前没有闹钟）。`seconds == 0` 是取消。
pub fn al_alarm(seconds: u32) -> u64 {
    return syscall4(ALQ_SYS_ALARM, seconds as u64, 0, 0) as u64;
}

/// `setitimer(which, new, old)`。`new` 与 `old` 都是调用方给的 32 字节;
/// `old` 可以为 0（不要旧值）。
pub fn al_setitimer(which: u32, new_iv: ptr, old_iv: ptr) -> i64 {
    return syscall4(ALQ_SYS_SETITIMER, which as u64, new_iv as u64, old_iv as u64);
}

/// 睡到下一个信号。**返回值永远是 -1**（只会被信号打断才回来）——
/// 这正是"等着被 alarm 叫醒"的形状。
pub fn al_pause() -> i64 {
    return syscall4(ALQ_SYS_PAUSE, 0, 0, 0);
}

// ---------------------------------------------------------------- 自检

fn test_alarm_pack_roundtrip() -> bool {
    let b: ptr = alloc(32);
    let n: u32 = al_ival_pack(b, 2, 500000, 1, 250000);
    return n == 32 && al_ival_sec(b, 0) == 2 && al_ival_usec(b, 0) == 500000
        && al_ival_sec(b, 16) == 1 && al_ival_usec(b, 16) == 250000;
}

fn test_alarm_pack_layout() -> bool {
    // 微秒在每段的 +8 —— 与 timespec 的纳秒同一个位置, 但单位不同。
    let b: ptr = alloc(32);
    al_ival_pack(b, 0, 1, 0, 0);
    return load8(b, 8) == 1 && load8(b, 0) == 0;
}

fn test_alarm_interval_copy() -> bool {
    let b: ptr = alloc(32);
    let o: ptr = alloc(16);
    al_ival_pack(b, 3, 4, 5, 6);
    let n: u32 = al_ival_interval(b, o);
    return n == 16 && alq_ld64(o, 0) == 3 && alq_ld64(o, 8) == 4;
}

fn test_alarm_value_copy() -> bool {
    let b: ptr = alloc(32);
    let o: ptr = alloc(16);
    al_ival_pack(b, 3, 4, 5, 6);
    let n: u32 = al_ival_value(b, o);
    return n == 16 && alq_ld64(o, 0) == 5 && alq_ld64(o, 8) == 6;
}
