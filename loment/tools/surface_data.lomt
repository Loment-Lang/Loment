    if k == 480 { return "Name a type that is in the table (`loment types` prints all of them - the one people reach for is `f32`/`f64`)."; }
    if k == 482 { return "To carry a fraction, **scale to integers**: `let x: u32 = 314;` for 3.14, with the point handled by arithmetic you write (`docs/228`)."; }
    if k == 484 { return "If you truly need floating point, keep the value on the C ABI side and pass it through `extern fn` (`docs/173`) - floats are legal in the ABI, not in the language's type table."; }
    if k == 481 { return "把类型换成表里真有的一个（`loment types` 列全部；最常要换掉的是 `f32`/`f64`）。"; }
    if k == 483 { return "要表示小数就**放大成整数**：`let x: u32 = 314;` 表示 3.14，定点运算自己做（`docs/228`）。"; }
    if k == 485 { return "非得用浮点：把那个值留在 C ABI 那一侧，用 `extern fn` 传进传出（`docs/173`）—— ABI 上浮点是合法的，语言里的类型不是。"; }
    if k == 496 { return "Check the path: the `<file>` in `loment check <file>` has to be that file (a relative path is relative to the **current directory**, nothing else)."; }
    if k == 498 { return "If you handed it a directory, hand it a file: a directory is not source. To see what a directory holds, use `loment ls <dir>`."; }
    if k == 500 { return "If the file is empty, write the source into it; and check you can read it (`chmod +r`)."; }
    if k == 502 { return "A path that is too long, or carries a wildcard (`*`) the shell did not expand, also lands here - the compiler sees the literal text."; }
    if k == 497 { return "核对路径：`loment check <file>` 里的 `<file>` 要真的是那个文件（相对路径是相对**当前目录**，不是相对别的什么）。"; }
    if k == 499 { return "给的是目录就换成文件：目录本身不是源。想看一个目录里有什么，用 `loment ls <目录>`。"; }
    if k == 501 { return "文件是空的就把源码写进去；另外确认它有读权限（`chmod +r`）。"; }
    if k == 503 { return "路径太长或带了通配符（`*`）也会落到这里 —— shell 没展开时编译器看到的是那个字面量。"; }
    if k == 512 { return "Create the directory first: `mkdir -p out`, then `loment build a.lomt -o out/a`."; }
    if k == 514 { return "Pick another landing spot: `-o a` (no directory) writes into the current directory."; }
    if k == 516 { return "Check you can write in that directory (`touch out/x` settles it); if not, use another one."; }
    if k == 518 { return "On Windows a failed write is sometimes **the exe you are overwriting still running** - close it and build again."; }
    if k == 513 { return "先建目录：`mkdir -p out` 再 `loment build a.lomt -o out/a`。"; }
    if k == 515 { return "换个落点：`-o a`（不写目录）会落在当前目录。"; }
    if k == 517 { return "确认那个目录你能写（`touch out/x` 试一下就知道了），必要时换个目录。"; }
    if k == 519 { return "Windows 上「写不了」有时是**那个 exe 正在运行** —— 先关掉它再编。"; }
    if k == 528 { return "Split the facade: if one `use` pulls in too much, break it into layers (the files under `loment/lib/` are the model)."; }
    if k == 530 { return "`use` also has a per-file limit (310 lines) - over that is this code."; }
    if k == 532 { return "If it is the number of declarations, cut the unit into modules so each has its own tables."; }
    if k == 534 { return "If it genuinely cannot be cut, open an issue: the limits are constants, and raising one has a paper trail."; }
    if k == 529 { return "把门面拆小：一个 `use` 拉进来的东西太多就分几层（`loment/lib/` 里那些就是样板）。"; }
    if k == 531 { return "`use` 条数也有上限（一个文件 310 条）—— 超过就是这条。"; }
    if k == 533 { return "声明那么多函数/类型的话，把单元切成几个模块，各自有自己的表。"; }
    if k == 535 { return "确实切不动就拿这事开个 issue：上限是常量，抬它有账可查（`docs/158` 记着每次抬高的实测）。"; }
    return "";
}

/// 这个码有几条修法（0 = 表里没有这个码）。**语言不进键** —— 两个语言槽的条数
/// 由生成器硬失败钉成相等，所以一个数就够。
pub fn code_nfix(c: u32) -> u32 {
    if c == 1 { return 4; }
    if c == 2 { return 4; }
    if c == 3 { return 3; }
    if c == 4 { return 4; }
    if c == 5 { return 3; }
    if c == 6 { return 4; }
    if c == 7 { return 4; }
    if c == 8 { return 4; }
    if c == 9 { return 3; }
    if c == 10 { return 3; }
    if c == 11 { return 3; }
    if c == 12 { return 4; }
    if c == 13 { return 4; }
    if c == 14 { return 3; }
    if c == 15 { return 4; }
    if c == 16 { return 4; }
    if c == 17 { return 4; }
    if c == 18 { return 4; }
    if c == 19 { return 4; }
    if c == 20 { return 3; }
    if c == 21 { return 4; }
    if c == 22 { return 5; }
    if c == 23 { return 3; }
    if c == 24 { return 5; }
    if c == 25 { return 3; }
    if c == 26 { return 4; }
    if c == 27 { return 3; }
    if c == 28 { return 4; }
    if c == 29 { return 3; }
    if c == 30 { return 3; }
    if c == 31 { return 4; }
    if c == 32 { return 4; }
    if c == 33 { return 4; }
    return 0;
}

// ---------------------------------------------------------------- 语言卡
// **键集 == `potato_from.LANGS`**（判据钉着）：翻译线加一门语言而这里没跟上,
// 症状是"新语言的文件报错时只字不提怎么翻" —— 静默缺口。

pub fn lang_count() -> u32 { return 8; }

pub fn decl_word_count() -> u32 { return 3; }

/// 声明的第 `i` 个词（`choose` / `write` / `grammar`）—— 词序是两边共享的契约。
pub fn decl_word(i: u32) -> str {
    if i == 0 { return "choose"; }
    if i == 1 { return "write"; }
    if i == 2 { return "grammar"; }
    return "";
}

pub fn alias_count() -> u32 { return 19; }

/// 第 `i` 个语法别名（报错器按**小写**比 —— 作者写 `C#` 还是 `c#` 都该认）。
pub fn alias_word(i: u32) -> str {
    if i == 0 { return "c"; }
    if i == 1 { return "c#"; }
    if i == 2 { return "c++"; }
    if i == 3 { return "cc"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "cs"; }
    if i == 6 { return "csharp"; }
    if i == 7 { return "cxx"; }
    if i == 8 { return "go"; }
    if i == 9 { return "golang"; }
    if i == 10 { return "java"; }
    if i == 11 { return "loment"; }
    if i == 12 { return "lument"; }
    if i == 13 { return "natural"; }
    if i == 14 { return "nl"; }
    if i == 15 { return "py"; }
    if i == 16 { return "python"; }
    if i == 17 { return "rs"; }
    if i == 18 { return "rust"; }
    return "";
}

/// 该别名对应的语言（= `LANG_CARDS` 的键 / `potato_from.LANGS` 的键）。
