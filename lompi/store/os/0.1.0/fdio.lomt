// os/io.lomt — 不比 libc 差的 fd 读写: EINTR 重试、短写补完、pread/pwrite、readv/writev
//
// 为什么需要它: 裸的 `read(2)`/`write(2)` 有三个坑，而且三个都不报错 ——
//   * **EINTR**（-4）：被信号打断，不是失败，接着来就是。把它当失败，程序会随机丢数据；
//   * **短写**：`write` 返回比你以为的少，是**正常**的（管道、终端、socket 都会），
//     不补完就是半个记录写进文件；
//   * **读写不挪偏移**：两个线程同一个 fd 各自读，`read` 会把位置一起推走；要互不干扰
//     得用 `pread`/`pwrite`。
// 这一层把这三件事各做对一次，调用方就不用在自己的每个循环里再抄一遍。
//
// 覆盖: read / write / pread / pwrite / readv / writev，以及 iovec 的布置。
//
// 边界（刻意划的）:
//   * **不缓冲** —— 这不是 `stdio`，没有行缓冲与 flush；要缓冲的用 `host/fs` 那类；
//   * 不把 EAGAIN（-11）当失败也不重试 —— 非阻塞 fd 上那是"现在没有"，
//     重试就变成了忙等；调用方拿到 -11 应该去等事件；
//   * 号是 x86-64 Linux 的。自检只验纯布置逻辑。
//
// 命名: 公开 io2_*, 内部 ioq_*（`io_` 前缀已经被 `system/iouring` 占了）。

module fdio

pub const IO2_EINTR: i64 = -4;
pub const IO2_EAGAIN: i64 = -11;

const IOQ_SYS_READ: u64 = 0;
const IOQ_SYS_WRITE: u64 = 1;
const IOQ_SYS_PREAD: u64 = 17;
const IOQ_SYS_PWRITE: u64 = 18;
const IOQ_SYS_READV: u64 = 19;
const IOQ_SYS_WRITEV: u64 = 20;

/// 一个 iovec 的字节数（base u64 + len u64）。
pub const IO2_IOV_BYTES: u32 = 16;

fn ioq_st64(p: ptr, v: u64) -> u32 {
    let b: u32 = 0;
    while b < 8 {
        store8(p, b, ((v >> (8 * b)) & 255) as u8);
        b = b + 1;
    }
    return 8;
}

// ---------------------------------------------------------------- iovec（纯）

/// 布置第 `index` 个 iovec: base 与 len 各 8 字节。返回新游标（字节偏移）。
pub fn io2_iov_set(iov: ptr, index: u32, base: u64, len: u64) -> u32 {
    let off: u32 = index * IO2_IOV_BYTES;
    let _a: u32 = ioq_st64(((iov as u64) + (off as u64)) as ptr, base);
    let bptr: ptr = ((iov as u64) + (off as u64) + 8) as ptr;
    let _b: u32 = ioq_st64(bptr, len);
    return off + IO2_IOV_BYTES;
}

/// 读回第 `index` 个 iovec 的 base。
pub fn io2_iov_base(iov: ptr, index: u32) -> u64 {
    let off: u64 = (index * IO2_IOV_BYTES) as u64;
    let v: u64 = 0;
    let b: u32 = 0;
    while b < 8 {
        v = v | ((load8(iov, (off as u32) + b) as u64) << (8 * b));
        b = b + 1;
    }
    return v;
}

/// 读回第 `index` 个 iovec 的 len。
pub fn io2_iov_len(iov: ptr, index: u32) -> u64 {
    let off: u32 = index * IO2_IOV_BYTES + 8;
    let v: u64 = 0;
    let b: u32 = 0;
    while b < 8 {
        v = v | ((load8(iov, off + b) as u64) << (8 * b));
        b = b + 1;
    }
    return v;
}

/// 一次 write 之后是不是"写了但没写完"。
pub fn io2_short_write(n: i64, want: u64) -> bool {
    return n >= 0 && (n as u64) < want;
}

// ---------------------------------------------------------------- 读写

/// `read`，EINTR 自动重试。返回值与系统调用一致（0 = EOF，负数 = errno 取反）。
pub fn io2_read(fd: u64, buf: ptr, cap: u64) -> i64 {
    let r: i64 = syscall4(IOQ_SYS_READ, fd, buf as u64, cap);
    while r == IO2_EINTR {
        r = syscall4(IOQ_SYS_READ, fd, buf as u64, cap);
    }
    return r;
}

/// 把 `n` 个字节**写完**。返回写下去的字节数；出错时返回已经写下去的那部分
/// （调用方拿它和 `n` 比就知道是不是短写）。
pub fn io2_write(fd: u64, buf: ptr, n: u64) -> i64 {
    let done: i64 = 0;
    let total: i64 = n as i64;
    while done < total {
        let rest: u64 = (total - done) as u64;
        let at: u64 = (buf as u64) + (done as u64);
        let r: i64 = syscall4(IOQ_SYS_WRITE, fd, at, rest);
        while r == IO2_EINTR {
            r = syscall4(IOQ_SYS_WRITE, fd, at, rest);
        }
        if r <= 0 {
            return done;
        }
        done = done + r;
    }
    return done;
}

/// `pread` —— 读的同时不挪 fd 的偏移（多线程共用一个 fd 时用它）。
pub fn io2_pread(fd: u64, buf: ptr, cap: u64, off: u64) -> i64 {
    let r: i64 = syscall6(IOQ_SYS_PREAD, fd, buf as u64, cap, off, 0);
    while r == IO2_EINTR {
        r = syscall6(IOQ_SYS_PREAD, fd, buf as u64, cap, off, 0);
    }
    return r;
}

/// `pwrite`。
pub fn io2_pwrite(fd: u64, buf: ptr, n: u64, off: u64) -> i64 {
    let r: i64 = syscall6(IOQ_SYS_PWRITE, fd, buf as u64, n, off, 0);
    while r == IO2_EINTR {
        r = syscall6(IOQ_SYS_PWRITE, fd, buf as u64, n, off, 0);
    }
    return r;
}

/// 一次散布读（iov 见 `io2_iov_set`）。
pub fn io2_readv(fd: u64, iov: ptr, iovcnt: u64) -> i64 {
    let r: i64 = syscall4(IOQ_SYS_READV, fd, iov as u64, iovcnt);
    while r == IO2_EINTR {
        r = syscall4(IOQ_SYS_READV, fd, iov as u64, iovcnt);
    }
    return r;
}

/// 一次散布写。
pub fn io2_writev(fd: u64, iov: ptr, iovcnt: u64) -> i64 {
    let r: i64 = syscall4(IOQ_SYS_WRITEV, fd, iov as u64, iovcnt);
    while r == IO2_EINTR {
        r = syscall4(IOQ_SYS_WRITEV, fd, iov as u64, iovcnt);
    }
    return r;
}

// ---------------------------------------------------------------- 自检

fn test_io_iov_set() -> bool {
    let iov: ptr = alloc(32);
    let cur: u32 = io2_iov_set(iov, 1, 4096, 100);
    return cur == 32 && io2_iov_base(iov, 1) == 4096 && io2_iov_len(iov, 1) == 100;
}

fn test_io_iov_two() -> bool {
    let iov: ptr = alloc(32);
    let _a: u32 = io2_iov_set(iov, 0, 1, 2);
    let _b: u32 = io2_iov_set(iov, 1, 3, 4);
    return io2_iov_base(iov, 0) == 1 && io2_iov_len(iov, 0) == 2
        && io2_iov_base(iov, 1) == 3 && io2_iov_len(iov, 1) == 4;
}

fn test_io_short_write() -> bool {
    return io2_short_write(3, 10) && !io2_short_write(10, 10)
        && !io2_short_write(11, 10) && !io2_short_write(-4, 10);
}
