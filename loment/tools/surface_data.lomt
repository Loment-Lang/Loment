// ---------------------------------------------------------------- 语言卡
// **键集 == `potato_from.LANGS`**（判据钉着）：翻译线加一门语言而这里没跟上,
// 症状是"新语言的文件报错时只字不提怎么翻" —— 静默缺口。

pub fn lang_count() -> u32 { return 8; }

pub fn decl_word_count() -> u32 { return 3; }

/// 声明的第 `i` 个词（`choose` / `write` / `grammar`）—— 词序是两边共享的契约。
pub fn decl_word(i: u32) -> str {
    if i == 0 { return "choose"; }
    if i == 1 { return "write"; }
    if i == 2 { return "grammar"; }
    return "";
}

pub fn alias_count() -> u32 { return 26; }

/// 第 `i` 个语法别名（报错器按**小写**比 —— 作者写 `C#` 还是 `c#` 都该认）。
pub fn alias_word(i: u32) -> str {
    if i == 0 { return "c"; }
    if i == 1 { return "c#"; }
    if i == 2 { return "c++"; }
    if i == 3 { return "cc"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "cs"; }
    if i == 6 { return "csharp"; }
    if i == 7 { return "cxx"; }
    if i == 8 { return "go"; }
    if i == 9 { return "golang"; }
    if i == 10 { return "java"; }
    if i == 11 { return "loment"; }
    if i == 12 { return "lument"; }
    if i == 13 { return "natural"; }
    if i == 14 { return "nl"; }
    if i == 15 { return "py"; }
    if i == 16 { return "python"; }
    if i == 17 { return "rs"; }
    if i == 18 { return "rust"; }
    if i == 19 { return "tur"; }
    if i == 20 { return "tur1"; }
    if i == 21 { return "tur2"; }
    if i == 22 { return "tur2026.1"; }
    if i == 23 { return "tur2026.2"; }
    if i == 24 { return "tur2026.3"; }
    if i == 25 { return "tur3"; }
    return "";
}

/// 该别名对应的语言（= `LANG_CARDS` 的键 / `potato_from.LANGS` 的键）。
