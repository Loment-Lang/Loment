    if i == 0 { return "c"; }
    if i == 1 { return "csharp"; }
    if i == 2 { return "cpp"; }
    if i == 3 { return "cpp"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "csharp"; }
    if i == 6 { return "csharp"; }
    if i == 7 { return "cpp"; }
    if i == 8 { return "go"; }
    if i == 9 { return "go"; }
    if i == 10 { return "java"; }
    if i == 11 { return "loment"; }
    if i == 12 { return "natural"; }
    if i == 13 { return "natural"; }
    if i == 14 { return "natural"; }
    if i == 15 { return "python"; }
    if i == 16 { return "python"; }
    if i == 17 { return "rust"; }
    if i == 18 { return "rust"; }
    return "";
}

pub fn lang_key(i: u32) -> str {
    if i == 0 { return "cpp"; }
    if i == 1 { return "c"; }
    if i == 2 { return "csharp"; }
    if i == 3 { return "java"; }
    if i == 4 { return "go"; }
    if i == 5 { return "rust"; }
    if i == 6 { return "python"; }
