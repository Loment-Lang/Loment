// std/sha512.lomt — SHA-512 (FIPS 180-4)
//
// 与 SHA-256 同族但字宽是 64 位: 80 轮、128 字节的块、128 位长度字段、128 位摘要。
// 为什么还要它而不是"用 SHA-256 就够了": 在 64 位机器上它**更快** (字的宽度与机器
// 一致), 而且抗碰撞余量更大。有了它, sha512/256 之类的截断变体也就顺手能拼。
//
// 表怎么来的: 80 个 K 是**前 80 个素数立方根小数部分的前 64 位**; H 的 8 个初值同理
// (前 8 个素数平方根的前 64 位)。全部由整数算法算出 (整数牛顿法开方/开立方),
// 不经过浮点, 也不是手抄。
//
// 布局 (调用方给 ctx, 852 字节):
//   [0..64]    H0..H7 (u64)
//   [64..80]   已处理字节数 (低/高 u64)
//   [80..208]  128 字节块缓冲
//   [208..212] 缓冲已用
//   [212..852] w[80] (u64 工作区)
//
// 命名: 公开 sha512_*, 内部 s5_*。自检 test_sha512_*。

module sha512

use "mem.lomt"

pub const SHA512_CTX: u32 = 852;
pub const SHA512_DIGEST: u32 = 64;

const S5_BUF: u32 = 80;
const S5_USED: u32 = 208;
const S5_LENLO: u32 = 64;
const S5_LENHI: u32 = 72;
const S5_W: u32 = 212;

fn sha512_k_hex() -> str {
    return "";
}

fn s5_hv(c: u32) -> u64 {
    if c >= 48 && c <= 57 {
        return (c - 48) as u64;
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as u64;
    }
    return 0 as u64;

}
fn sha512_k(i: u32) -> u64 {
    let s: str = sha512_k_hex();
    let base: u32 = i * 16;
    let v: u64 = 0 as u64;
    let j: u32 = 0;
    while j < 16 {
        v = (v << 4) | s5_hv(str_byte(s, base + j));
        j = j + 1;
    }
    return v;
}

fn s5_rotr(v: u64, n: u32) -> u64 {
    return (v >> n) | (v << (64 - n));
}

fn s5_bswap(v: u64) -> u64 {
    let x: u64 = ((v & 255 as u64) << 56) | ((v & 65280 as u64) << 40)
        | ((v & 16711680 as u64) << 24) | ((v & 4278190080) << 8);
    let y: u64 = ((v >> 8) & 4278190080) | ((v >> 24) & 16711680 as u64)
        | ((v >> 40) & 65280 as u64) | ((v >> 56) & 255 as u64);
    return x | y;
}

fn s5_h(ctx: ptr, i: u32) -> u64 {
    return mem_load64(ctx, 8 * i);
}

fn s5_set_h(ctx: ptr, i: u32, v: u64) {
    mem_store64(ctx, 8 * i, v);
}

fn s5_w(ctx: ptr, i: u32) -> u64 {
    return mem_load64(ctx, S5_W + 8 * i);
}

fn s5_set_w(ctx: ptr, i: u32, v: u64) {
    mem_store64(ctx, S5_W + 8 * i, v);
}

pub fn sha512_init(ctx: ptr) {
    s5_set_h(ctx, 0, 0x6A09E667F3BCC908);
    s5_set_h(ctx, 1, 0xBB67AE8584CAA73B);
    s5_set_h(ctx, 2, 0x3C6EF372FE94F82B);
    s5_set_h(ctx, 3, 0xA54FF53A5F1D36F1);
    s5_set_h(ctx, 4, 0x510E527FADE682D1);
    s5_set_h(ctx, 5, 0x9B05688C2B3E6C1F);
    s5_set_h(ctx, 6, 0x1F83D9ABFB41BD6B);
    s5_set_h(ctx, 7, 0x5BE0CD19137E2179);
    mem_store64(ctx, S5_LENLO, 0 as u64);
    mem_store64(ctx, S5_LENHI, 0 as u64);
    mem_store32(ctx, S5_USED, 0);
}

fn s5_compress(ctx: ptr) {
    let i: u32 = 0;
    while i < 16 {
        s5_set_w(ctx, i, s5_bswap(mem_load64(ctx, S5_BUF + 8 * i)));
        i = i + 1;
    }
    i = 16;
    while i < 80 {
        let x: u64 = s5_w(ctx, i - 15);
        let y: u64 = s5_w(ctx, i - 2);
        let s0: u64 = s5_rotr(x, 1) ^ s5_rotr(x, 8) ^ (x >> 7);
        let s1: u64 = s5_rotr(y, 19) ^ s5_rotr(y, 61) ^ (y >> 6);
        s5_set_w(ctx, i, s5_w(ctx, i - 16) + s0 + s5_w(ctx, i - 7) + s1);
        i = i + 1;
    }
    let a: u64 = s5_h(ctx, 0);
    let b: u64 = s5_h(ctx, 1);
    let c: u64 = s5_h(ctx, 2);
    let d: u64 = s5_h(ctx, 3);
    let e: u64 = s5_h(ctx, 4);
    let f: u64 = s5_h(ctx, 5);
    let g: u64 = s5_h(ctx, 6);
    let h: u64 = s5_h(ctx, 7);
    i = 0;
    while i < 80 {
        let bs: u64 = s5_rotr(e, 14) ^ s5_rotr(e, 18) ^ s5_rotr(e, 41);
        let ch: u64 = (e & f) ^ ((e ^ 18446744073709551615) & g);
        let t1: u64 = h + bs + ch + sha512_k(i) + s5_w(ctx, i);
        let asig: u64 = s5_rotr(a, 28) ^ s5_rotr(a, 34) ^ s5_rotr(a, 39);
        let maj: u64 = (a & b) ^ (a & c) ^ (b & c);
        let t2: u64 = asig + maj;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        i = i + 1;
    }
    s5_set_h(ctx, 0, s5_h(ctx, 0) + a);
    s5_set_h(ctx, 1, s5_h(ctx, 1) + b);
    s5_set_h(ctx, 2, s5_h(ctx, 2) + c);
    s5_set_h(ctx, 3, s5_h(ctx, 3) + d);
    s5_set_h(ctx, 4, s5_h(ctx, 4) + e);
    s5_set_h(ctx, 5, s5_h(ctx, 5) + f);
    s5_set_h(ctx, 6, s5_h(ctx, 6) + g);
    s5_set_h(ctx, 7, s5_h(ctx, 7) + h);
}

pub fn sha512_update(ctx: ptr, d: ptr, o: u32, n: u32) {
    let used: u32 = mem_load32(ctx, S5_USED);
    let lo: u64 = mem_load64(ctx, S5_LENLO) + (n as u64);
    let carry: u64 = 0 as u64;
    if lo < mem_load64(ctx, S5_LENLO) {
        carry = 1 as u64;
    }
    mem_store64(ctx, S5_LENLO, lo);
    mem_store64(ctx, S5_LENHI, mem_load64(ctx, S5_LENHI) + carry);
    let i: u32 = 0;
    while i < n {
        let space: u32 = 128 - used;
        let take: u32 = n - i;
        let m: u32 = take;
        if m > space {
            m = space;
        }
        mem_copy(ctx, S5_BUF + used, d, o + i, m);
        used = used + m;
        i = i + m;
        if used == 128 {
            s5_compress(ctx);
            used = 0;
        }
    }
    mem_store32(ctx, S5_USED, used);
}

pub fn sha512_final(ctx: ptr, out: ptr) {
    let used: u32 = mem_load32(ctx, S5_USED);
    let bl: u64 = mem_load64(ctx, S5_LENLO);
    let bh: u64 = mem_load64(ctx, S5_LENHI);
    store8(ctx, S5_BUF + used, 128 as u8);
    used = used + 1;
    if used > 112 {
        let z: u32 = used;
        while z < 128 {
            store8(ctx, S5_BUF + z, 0 as u8);
            z = z + 1;
        }
        s5_compress(ctx);
        used = 0;
    }
    let z2: u32 = used;
    while z2 < 112 {
        store8(ctx, S5_BUF + z2, 0 as u8);
        z2 = z2 + 1;
    }
    // 128 位**大端**比特长度
    let lo8: u64 = bl << 3;
    let hi8: u64 = (bh << 3) | (bl >> 61);
    mem_store64(ctx, S5_BUF + 112, s5_bswap(hi8));
    mem_store64(ctx, S5_BUF + 120, s5_bswap(lo8));
    s5_compress(ctx);
    let i: u32 = 0;
    while i < 8 {
        mem_store64(out, 8 * i, s5_bswap(s5_h(ctx, i)));
        i = i + 1;
    }
    mem_store32(ctx, S5_USED, 0);
}

pub fn sha512(d: ptr, o: u32, n: u32, out: ptr, ctx: ptr) {
    sha512_init(ctx);
    sha512_update(ctx, d, o, n);
    sha512_final(ctx, out);
}

pub fn sha512_str(s: str, out: ptr, ctx: ptr) {
    sha512(str_ptr(s), 0, str_len(s), out, ctx);
}

/// 摘要 -> 128 个小写十六进制字符。
pub fn sha512_hex(out: ptr, o: u32, digest: ptr) -> u32 {
    let i: u32 = 0;
    while i < 64 {
        let v: u32 = load8(digest, i);
        store8(out, o + 2 * i, s5_hexch((v >> 4) & 15) as u8);
        store8(out, o + 2 * i + 1, s5_hexch(v & 15) as u8);
        i = i + 1;
    }
    return 128;
}

fn s5_hexch(v: u32) -> u32 {
    if v < 10 {
        return 48 + v;
    }
    return 87 + v;
}

// ---------------------------------------------------------------- 自检

fn test_sha512_k_table() -> bool {
    return sha512_k(0) == 0x428A2F98D728AE22
        && sha512_k(1) == 0x7137449123EF65CD
        && sha512_k(79) == 0x6C44198C4A475817;

}
fn test_sha512_init_state() -> bool {
    let ctx: ptr = alloc(SHA512_CTX);
    sha512_init(ctx);
    return s5_h(ctx, 0) == 0x6A09E667F3BCC908
        && s5_h(ctx, 7) == 0x5BE0CD19137E2179;
}

fn test_sha512_bswap() -> bool {
    return s5_bswap(0x0102030405060708) == 0x0807060504030201
        && s5_bswap(0 as u64) == 0 as u64
        && s5_bswap(18446744073709551615) == 18446744073709551615;
}

fn test_sha512_vector_empty() -> bool {
    // cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce
    // 47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e
    let ctx: ptr = alloc(SHA512_CTX);
    let out: ptr = alloc(SHA512_DIGEST);
    let hex: ptr = alloc(140);
    sha512_init(ctx);
    sha512_final(ctx, out);
    sha512_hex(hex, 0, out);
    let want: str = "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e";
    return mem_eq(hex, 0, str_ptr(want), 0, 128);

}
fn test_sha512_vector_abc() -> bool {
    let ctx: ptr = alloc(SHA512_CTX);
    let out: ptr = alloc(SHA512_DIGEST);
    let hex: ptr = alloc(140);
    let s: str = "abc";
    sha512_str(s, out, ctx);
    sha512_hex(hex, 0, out);
    let want: str = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f";
    return mem_eq(hex, 0, str_ptr(want), 0, 128);
}

fn test_sha512_vector_two_blocks() -> bool {
    // "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    //   = 8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018
    //     501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909
    let ctx: ptr = alloc(SHA512_CTX);
    let out: ptr = alloc(SHA512_DIGEST);
    let hex: ptr = alloc(140);
    let s: str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    sha512_str(s, out, ctx);
    sha512_hex(hex, 0, out);
    let want: str = "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909";
    return mem_eq(hex, 0, str_ptr(want), 0, 128);

}
fn test_sha512_streaming_matches_oneshot() -> bool {
    let c1: ptr = alloc(SHA512_CTX);
    let c2: ptr = alloc(SHA512_CTX);
    let d: ptr = alloc(300);
    let o1: ptr = alloc(SHA512_DIGEST);
    let o2: ptr = alloc(SHA512_DIGEST);
    let i: u32 = 0;
    while i < 300 {
        store8(d, i, ((i * 67 + 5) % 256) as u8);
        i = i + 1;
    }
    sha512(d, 0, 300, o1, c1);
    sha512_init(c2);
    sha512_update(c2, d, 0, 127);
    sha512_update(c2, d, 127, 1);
    sha512_update(c2, d, 128, 172);
    sha512_final(c2, o2);
    return mem_eq(o1, 0, o2, 0, 64);

}
fn test_sha512_block_boundaries() -> bool {
    let ctx: ptr = alloc(SHA512_CTX);
    let d: ptr = alloc(128);
    let a: ptr = alloc(SHA512_DIGEST);
    let b: ptr = alloc(SHA512_DIGEST);
    let c: ptr = alloc(SHA512_DIGEST);
    mem_fill(d, 0, 128, 88);
    sha512(d, 0, 111, a, ctx);
    sha512(d, 0, 112, b, ctx);
    sha512(d, 0, 128, c, ctx);
    return mem_eq(a, 0, b, 0, 64) == false && mem_eq(b, 0, c, 0, 64) == false
        && mem_eq(a, 0, c, 0, 64) == false;

}
fn test_sha512_one_bit_change() -> bool {
    let ctx: ptr = alloc(SHA512_CTX);
    let d: ptr = alloc(16);
    let a: ptr = alloc(SHA512_DIGEST);
    let b: ptr = alloc(SHA512_DIGEST);
    mem_fill(d, 0, 16, 0);
    sha512(d, 0, 16, a, ctx);
    store8(d, 8, 1 as u8);
    sha512(d, 0, 16, b, ctx);
    return mem_eq(a, 0, b, 0, 64) == false;

}
fn test_sha512_hex_is_lowercase_hex() -> bool {
    let ctx: ptr = alloc(SHA512_CTX);
    let out: ptr = alloc(SHA512_DIGEST);
    let hex: ptr = alloc(140);
    let d: ptr = alloc(16);
    mem_fill(d, 0, 16, 3);
    sha512(d, 0, 16, out, ctx);
    let n: u32 = sha512_hex(hex, 0, out);
    let i: u32 = 0;
    let ok: u32 = 1;
    while i < 128 {
        let c: u32 = load8(hex, i);
        if (c < 48 || c > 57) && (c < 97 || c > 102) {
            ok = 0;
        }
        i = i + 1;
    }
    return n == 128 && ok == 1;

}