// std/env.lomt — 环境块 / argv 的解析 (\0 分隔的连续字节区)
//
// 为什么需要它: 进程拿到的环境变量与 argv 在系统层就是**一串 NUL 结尾的字节**, 不是
// 字符串数组。`getenv` 那种一律 malloc 的接口在无 libc 的目标上不存在。所以这一层
// 只做一件事: **在一块只读字节区上做窗口代数** —— 不复制、不分配、不改动调用方缓冲。
//
// 约定 (整个模块就这一条):
//   块 = `[条目\0条目\0...条目\0\0]`, 双 NUL 收尾; 也接受"最后一个条目后没有 NUL"
//   (块长度 `n` 同时充当收边)。条目内**第一个 `=` 之前是键, 之后是值**; 没有 `=` 的
//   条目是"只有键, 值为空"(那种条目在 argv 里正常, 在环境块里少见但合法)。
//
// **键必须整段相等**: `env_get(..., "PATH", ...)` 绝不能命中 `PATHX=1`。前缀命中是
// 环境变量查找里最经典的 bug —— 它平时正确、只在某台机器上装了个名字带前缀的变量时
// 才发作。下面的自检专门钉这一条。
//
// 诚实清单 (不做什么, 为什么):
//   - **不解析引号 / 转义 / `$VAR` 展开**。那属于 shell 的语义, 环境块里没有它们 ——
//     把 shell 规则塞进来会让"值里本来就有 `$`"变成静默的错。
//   - **不区分大小写**: Windows 的环境变量名不区分大小写, POSIX 区分。这里按**字节
//     精确**比 (即 POSIX 语义), 因为区分是"更像字节"的那一边, 而忽略大小写是上层策略。
//   - **不做去重/覆盖**: 块里若有同名键, `env_get` 返回**第一个**。环境块的语义是"进程
//     拿到的样子", 由调用方决定信不信。
//   - `env_argv0_dir` **不解析 `PATH`**: 只在 argv[0] 里找最后一个分隔符。`argv[0]` 是
//     "prog"(无目录) 时返回 0, 那是"当前目录" —— 怎么补全由调用方决定。
//
// 命名: 公开 env_*, 内部 en_*。自检 test_env_*。

module env

use "mem.lomt"

pub const ENV_OK: u32 = 0;
/// 参数不合法 (下标越界 / 缓冲太短)。
pub const ENV_ERR: u32 = 4294967295;
/// "没有" (键不存在 / 条目没有 `=`)。与 ENV_ERR 分开 —— 找不到不是错误。
pub const ENV_NO: u32 = 4294967294;

// ---------------------------------------------------------------- 工具

/// 目录分隔符: `/` 与 `\\` 都认 (Windows 与 POSIX)。
fn en_is_sep(c: u32) -> bool {
    return c == 47 || c == 92;
}

/// 块里第 `i` 个字节起、到下一个 NUL 或块尾的长度 (即该条目的长度)。
/// 调用方应先知道 i 指着条目开头 —— 本函数不跳过前面的条目。
fn en_run_len(buf: ptr, n: u32, i: u32) -> u32 {
    let j: u32 = i;
    while j < n && load8(buf, j) != 0 {
        j = j + 1;
    }
    return j - i;
}

/// 条目里 `=` 相对条目起点的偏移; 没有 `=` 给 ENV_NO。
fn en_eq_at(buf: ptr, off: u32, len: u32) -> u32 {
    let i: u32 = 0;
    while i < len {
        if load8(buf, off + i) == 61 {
            return i;
        }
        i = i + 1;
    }
    return ENV_NO;
}

// ---------------------------------------------------------------- 计数与取条目

/// 块里有几个条目。**遇到空条目就停** —— 那正是双 NUL 收尾里的第二个 NUL。
pub fn env_count(buf: ptr, n: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    let go: u32 = 1;
    while i < n && go == 1 {
        let l: u32 = en_run_len(buf, n, i);
        if l == 0 {
            go = 0;
        } else {
            c = c + 1;
            i = i + l + 1;
        }
    }
    return c;
}

/// 取第 `idx` 个条目, 把它的**(起点偏移, 长度)** 写进两个 u32 里。
/// 下标越界 -> ENV_ERR (不写输出)。
pub fn env_at(buf: ptr, n: u32, idx: u32, out_off: ptr, out_len: ptr) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    let go: u32 = 1;
    let off: u32 = 0;
    let len: u32 = 0;
    let found: u32 = 0;
    while i < n && go == 1 {
        let l: u32 = en_run_len(buf, n, i);
        if l == 0 {
            go = 0;
        } else if c == idx {
            off = i;
            len = l;
            found = 1;
            go = 0;
        } else {
            c = c + 1;
            i = i + l + 1;
        }
    }
    if found == 0 {
        return ENV_ERR;
    }
    mem_store32(out_off, 0, off);
    mem_store32(out_len, 0, len);
    return ENV_OK;
}

/// 条目的键长度 (第一个 `=` 之前的字节数)。**没有 `=` 时就是整段长度** —— 那是个
/// "只有键"的条目, 值长度为 0, 用 env_val_off 能把它和 "`=` 后面空" 区分开。
pub fn env_key_len(buf: ptr, off: u32, len: u32) -> u32 {
    let k: u32 = en_eq_at(buf, off, len);
    if k == ENV_NO {
        return len;
    }
    return k;
}

/// 条目值的起点偏移 (绝对)。没有 `=` -> ENV_NO。
pub fn env_val_off(buf: ptr, off: u32, len: u32) -> u32 {
    let k: u32 = en_eq_at(buf, off, len);
    if k == ENV_NO {
        return ENV_NO;
    }
    return off + k + 1;
}

/// 条目值的长度。没有 `=` -> ENV_NO。
pub fn env_val_len(buf: ptr, off: u32, len: u32) -> u32 {
    let k: u32 = en_eq_at(buf, off, len);
    if k == ENV_NO {
        return ENV_NO;
    }
    return len - k - 1;
}

// ---------------------------------------------------------------- 按键查找

/// 按**整段键名**取值, 拷进 `out` 的偏移 0 处, 返回值的长度。
/// 找不到 -> ENV_NO; 找到但值为空 -> 0 (合法结果, 不是错)。
pub fn env_get(buf: ptr, n: u32, key: str, out: ptr) -> u32 {
    let kl: u32 = str_len(key);
    let kp: ptr = str_ptr(key);
    let i: u32 = 0;
    let go: u32 = 1;
    let res: u32 = ENV_NO;
    while i < n && go == 1 {
        let l: u32 = en_run_len(buf, n, i);
        if l == 0 {
            go = 0;
        } else {
            let e: u32 = en_eq_at(buf, i, l);
            let klen: u32 = l;
            let vlen: u32 = 0;
            let voff: u32 = i + l;
            if e != ENV_NO {
                klen = e;
                voff = i + e + 1;
                vlen = l - e - 1;
            }
            // **整段相等**: 先比长度再比字节 —— 长度不同直接跳过, 免得前缀命中。
            if klen == kl && mem_eq(buf, i, kp, 0, kl) {
                mem_copy(out, 0, buf, voff, vlen);
                res = vlen;
                go = 0;
            } else {
                i = i + l + 1;
            }
        }
    }
    return res;
}

// ---------------------------------------------------------------- argv

/// argv 的条目数 (与环境块同构: NUL 分隔, 通常没有 `=`, 也没有尾双 NUL ——
/// 但本函数靠**长度 n** 收边, 两种收尾都认)。
pub fn env_argc(buf: ptr, n: u32) -> u32 {
    return env_count(buf, n);
}

/// 第 idx 个 argv 条目拷进 out, 返回长度; 越界 -> ENV_ERR。
pub fn env_arg(buf: ptr, n: u32, idx: u32, out: ptr) -> u32 {
    let off: ptr = alloc(8);
    let len: ptr = alloc(8);
    let r: u32 = env_at(buf, n, idx, off, len);
    if r != ENV_OK {
        return ENV_ERR;
    }
    let o: u32 = mem_load32(off, 0);
    let l: u32 = mem_load32(len, 0);
    mem_copy(out, 0, buf, o, l);
    return l;
}

/// 从 argv[0] 反推它所在的目录 (不含尾部斜杠)。
///
/// 返回目录长度; **0 表示"没有目录部分"** (argv[0] 里一个分隔符都没有, 或者只有
/// 分隔符在前 —— 例如 "/prog" 的目录是根, 习惯上写成空串)。`out` 至少 str_len(argv0) 字节。
pub fn env_argv0_dir(argv0: str, out: ptr) -> u32 {
    let n: u32 = str_len(argv0);
    let p: ptr = str_ptr(argv0);
    let last: u32 = ENV_NO;
    let i: u32 = 0;
    while i < n {
        if en_is_sep(load8(p, i)) {
            last = i;
        }
        i = i + 1;
    }
    if last == ENV_NO {
        return 0;
    }
    mem_copy(out, 0, p, 0, last);
    return last;
}

// ---------------------------------------------------------------- 自检

/// 把 s 抄到 d 的 o 处, 返回新的写指针 (自检装配夹具用)。
fn en_puts(d: ptr, o: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    mem_copy(d, o, str_ptr(s), 0, n);
    return o + n;
}

/// 夹具 A: `"A=1\0BB=22\0CCC=\0\0"`, 返回总长。
/// **NUL 一律运行期 store8 写** —— 字符串字面量里的 `\0` 不是合法转义。
fn mk_a(d: ptr) -> u32 {
    let w: u32 = en_puts(d, 0, "A=1");
    store8(d, w, 0 as u8);
    w = w + 1;
    w = en_puts(d, w, "BB=22");
    store8(d, w, 0 as u8);
    w = w + 1;
    w = en_puts(d, w, "CCC=");
    store8(d, w, 0 as u8);
    w = w + 1;
    store8(d, w, 0 as u8); // 双 NUL 收尾
    w = w + 1;
    return w;
}

/// 夹具 B: `"PATH=1\0PATHX=2\0"` —— 专测前缀不误命中。
fn mk_b(d: ptr) -> u32 {
    let w: u32 = en_puts(d, 0, "PATH=1");
    store8(d, w, 0 as u8);
    w = w + 1;
    w = en_puts(d, w, "PATHX=2");
    store8(d, w, 0 as u8);
    w = w + 1;
    return w;
}

fn test_env_count_basic() -> bool {
    let d: ptr = alloc(64);
    let n: u32 = mk_a(d);
    return n == 16 && env_count(d, n) == 3;
}

fn test_env_at_entries() -> bool {
    let d: ptr = alloc(64);
    let n: u32 = mk_a(d);
    let off: ptr = alloc(8);
    let len: ptr = alloc(8);
    let ok: u32 = 1;
    if env_at(d, n, 0, off, len) != ENV_OK || mem_load32(off, 0) != 0 || mem_load32(len, 0) != 3 {
        ok = 0;
    }
    if env_at(d, n, 1, off, len) != ENV_OK || mem_load32(off, 0) != 4 || mem_load32(len, 0) != 5 {
        ok = 0;
    }
    if env_at(d, n, 2, off, len) != ENV_OK || mem_load32(off, 0) != 10 || mem_load32(len, 0) != 4 {
        ok = 0;
    }
    return ok == 1;
}

fn test_env_at_out_of_range() -> bool {
    let d: ptr = alloc(64);
    let n: u32 = mk_a(d);
    let off: ptr = alloc(8);
    let len: ptr = alloc(8);
    return env_at(d, n, 3, off, len) == ENV_ERR && env_at(d, n, 100, off, len) == ENV_ERR;
}

fn test_env_get_basic_value() -> bool {
    let d: ptr = alloc(64);
    let n: u32 = mk_a(d);
    let out: ptr = alloc(32);
    let l1: u32 = env_get(d, n, "A", out);
    let ok1: bool = l1 == 1 && load8(out, 0) == 49; // "1"
    let l2: u32 = env_get(d, n, "BB", out);
    let ok2: bool = l2 == 2 && load8(out, 0) == 50 && load8(out, 1) == 50; // "22"
    let l3: u32 = env_get(d, n, "CCC", out);
    let ok3: bool = l3 == 0; // 空值, 不是错
    return ok1 && ok2 && ok3;
}

fn test_env_get_prefix_not_matched() -> bool {
    // **这个模块最容易写错的一条**: "PATH" 绝不能不命中 "PATHX=2"。
    let d: ptr = alloc(64);
    let n: u32 = mk_b(d);
    let out: ptr = alloc(32);
    let l: u32 = env_get(d, n, "PATH", out);
    let ok: bool = l == 1 && load8(out, 0) == 49; // 必须是 "1" 不是 "2"
    // 反过来 PATHX 要拿到 2。
    let l2: u32 = env_get(d, n, "PATHX", out);
    let ok2: bool = l2 == 1 && load8(out, 0) == 50;
    // PATHPATH 这种不存在的要 ENV_NO。
    let l3: u32 = env_get(d, n, "PATHPATH", out);
    return ok && ok2 && l3 == ENV_NO;
}

fn test_env_get_missing_is_no() -> bool {
    let d: ptr = alloc(64);
    let n: u32 = mk_a(d);
    let out: ptr = alloc(32);
    return env_get(d, n, "ZZZ", out) == ENV_NO && env_get(d, n, "", out) == ENV_NO;
}

fn test_env_key_len_and_val_off() -> bool {
    let d: ptr = alloc(64);
    let n: u32 = mk_a(d);
    // "A=1" 起点 0 长 3: 键长 1, 值起点 2, 值长 1。
    let ok1: bool = env_key_len(d, 0, 3) == 1 && env_val_off(d, 0, 3) == 2 && env_val_len(d, 0, 3) == 1;
    // "CCC=" 起点 10 长 4: 键长 3, 值起点 14, 值长 0。
    let ok2: bool = env_key_len(d, 10, 4) == 3 && env_val_off(d, 10, 4) == 14 && env_val_len(d, 10, 4) == 0;
    return ok1 && ok2;
}

fn test_env_no_equals_entry() -> bool {
    // "FLAG" 这种没有 `=` 的条目: 键长=整段, 值不存在 (ENV_NO)。
    let d: ptr = alloc(64);
    let w: u32 = en_puts(d, 0, "FLAG");
    store8(d, w, 0 as u8);
    w = w + 1;
    store8(d, w, 0 as u8);
    w = w + 1;
    let out: ptr = alloc(32);
    let ok: bool = env_key_len(d, 0, 4) == 4 && env_val_off(d, 0, 4) == ENV_NO;
    let l: u32 = env_get(d, w, "FLAG", out);
    return ok && l == 0 && env_count(d, w) == 1;
}

fn test_env_count_stops_at_double_nul() -> bool {
    // 双 NUL 之后的字节**不算条目** —— 即便那里还有看起来像变量的东西。
    let d: ptr = alloc(64);
    let w: u32 = mk_a(d);
    w = en_puts(d, 16, "SHOULD=NOT"); // 越过双 NUL 再写
    store8(d, w, 0 as u8);
    w = w + 1;
    let out: ptr = alloc(32);
    return env_count(d, w) == 3 && env_get(d, w, "SHOULD", out) == ENV_NO;
}

fn test_env_empty_block() -> bool {
    let d: ptr = alloc(16);
    store8(d, 0, 0 as u8);
    let off: ptr = alloc(8);
    let len: ptr = alloc(8);
    return env_count(d, 0) == 0 && env_count(d, 1) == 0 && env_at(d, 1, 0, off, len) == ENV_ERR;
}

fn test_env_no_trailing_nul() -> bool {
    // 块尾没有 NUL, 靠长度收边 —— 最后一个条目仍要数到。
    let d: ptr = alloc(64);
    let w: u32 = en_puts(d, 0, "K=V");
    return env_count(d, w) == 1 && env_get(d, w, "K", alloc(8)) == 1;
}

fn test_env_argv_aliases() -> bool {
    // argv 与环境块同构: argc 复用 env_count, arg 复用 env_at。
    let d: ptr = alloc(64);
    let w: u32 = en_puts(d, 0, "prog");
    store8(d, w, 0 as u8);
    w = w + 1;
    w = en_puts(d, w, "arg1");
    store8(d, w, 0 as u8);
    w = w + 1;
    w = en_puts(d, w, "arg2");
    let out: ptr = alloc(32);
    let a0: u32 = env_arg(d, w, 0, out);
    let ok0: bool = a0 == 4 && load8(out, 0) == 112; // 'p'
    let a2: u32 = env_arg(d, w, 2, out);
    let ok2: bool = a2 == 4 && load8(out, 3) == 50; // '2'
    return env_argc(d, w) == 3 && ok0 && ok2 && env_arg(d, w, 9, out) == ENV_ERR;
}

fn test_env_argv0_dir_posix() -> bool {
    let out: ptr = alloc(64);
    let n: u32 = env_argv0_dir("/usr/bin/prog", out);
    let want: str = "/usr/bin";
    return n == 8 && mem_eq(out, 0, str_ptr(want), 0, 8);
}

fn test_env_argv0_dir_windows() -> bool {
    // `\\` 是合法转义 (反斜杠), 所以字面量这里写的是两个反斜杠 -> 一个。
    let out: ptr = alloc(64);
    let n: u32 = env_argv0_dir("C:\\a\\b.exe", out);
    let want: str = "C:\\a";
    return n == 4 && mem_eq(out, 0, str_ptr(want), 0, 4);
}

fn test_env_argv0_dir_boundaries() -> bool {
    let out: ptr = alloc(64);
    // 无分隔符 -> 0
    let a: u32 = env_argv0_dir("prog", out);
    // 只有分隔符在前 -> 目录是根, 长度 0
    let b: u32 = env_argv0_dir("/prog", out);
    let c: u32 = env_argv0_dir("\\", out);
    let d: u32 = env_argv0_dir("", out);
    // 混合分隔符: 取最后一个, 得到 "a\\b"
    let e: u32 = env_argv0_dir("a\\b/c", out);
    let want: str = "a\\b";
    return a == 0 && b == 0 && c == 0 && d == 0 && e == 3
        && mem_eq(out, 0, str_ptr(want), 0, 3);
}
