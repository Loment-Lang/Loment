// loment/tools/lomcli.lomt — Loment 自举 CLI 前端 (docs/169)
//
// 为什么用 Loment 写而不写在启动器的 shell 里: 启动器有两份 (bin/loment 是 bash,
// bin/loment.cmd 是 batch), 命令写在那里就得**写两遍并保持同步**。写在这里只写一遍,
// 两个启动器各加一行转发即可 —— 与 lomfmt/lomdoc/lomelf 同一条路数。
//
// 判据 (tools/loment_cli_test.py): 链成 PE 后**在本机原生跑**, 逐条验命令的输出与退出码,
// 并钉住"启动器认得的命令 == 这里列出的命令"不漂移。
//
// CLI:
//   lomcli <command> [args]      命令见 `lomcli help`
//   退出码: 0 = 成功 / 1 = 失败 / 2 = 用法错误
//
// 只用 8 个跨平台 syscall (read/write/close/brk/exit/getdents64/openat/newfstatat),
// 所以同一份源码在 ELF 与 PE 上行为一致。**PE 上 newfstatat 只填 st_mode** (实测
// 2026-09-15: st_size 恒为 0), 所以文件大小一律靠"读到底数出来", 不看 stat。

module lomcli
choose runtime

use bytes
use sha256
use surface_data

// ---------------------------------------------------------------- 内存布局
// 单块 brk 内存 + 命名偏移。Loment 没有可变全局也没有 out 参数, 所以跨函数共享的状态
// 一律靠这块内存 (与 lompkg.lomt / lomstatus.lomt 同法)。

const M_CELL: u32 = 0;             // 全局格 (C_*), 128
const M_OUT: u32 = 128;            // 短串/数字暂存, 4096
const M_ARGV: u32 = 4224;          // /proc/self/cmdline
const M_P1: u32 = 69760;           // 路径缓冲 1
const M_P2: u32 = 70784;           // 路径缓冲 2
const M_P3: u32 = 71808;           // 路径缓冲 3
const M_STB: u32 = 72832;          // struct stat, 256
const M_DIRBUF: u32 = 73088;       // getdents64 缓冲
const M_LSP: u32 = 105856;         // 目录递归: 每深度路径 (MAXD × PATH_CAP)
const M_LSN: u32 = 122240;         // 目录递归: 每深度名字池 (MAXD × 4096)
const M_LST: u32 = 187776;         // 目录递归: 每深度类型位 (MAXD × 256)
const M_FILE: u32 = 191872;        // 文件内容
const M_SHA: u32 = 454016;         // sha256 状态 (1024)
const M_DIG: u32 = 455040;         // sha256 摘要 (32)
const M_TMP: u32 = 455072;         // 通用暂存 (拼路径用)

const ARGV_CAP: u32 = 65536;
const PATH_CAP: u32 = 1024;
const DIR_CAP: u32 = 32768;
const FILE_CAP: u32 = 262144;
const ARENA_CAP: u64 = 470000;

const MAXD: u32 = 16;              // 目录递归深度上限
const ENT_CAP: u32 = 256;          // 一个目录最多记这么多条
const NPOOL: u32 = 4096;           // 每深度的名字池字节数

// 全局格 (M_CELL 内)
const C_COLOR: u32 = 0;            // 1 = 上色
const C_ERR: u32 = 8;              // 本次命令的错误计数
const C_ARGLEN: u32 = 20;          // /proc/self/cmdline 的真实字节数

const S_IFMT: u32 = 61440;
const S_IFDIR: u32 = 16384;
const NOTFOUND: u32 = 4294967295;

// ---------------------------------------------------------------- 系统调用

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn wbytes(fd: u64, p: ptr, n: u32) -> u64 {
    return write_all(fd, p, n as u64);
}

// 打印一个 NUL 结尾的运行期缓冲。Loment 没有 ptr -> str 的转换, 也没有"由 ptr+len 造 str"
// 的内建, 所以凡是**算出来的**文本一律走 wbuf, 不走 wstr (wstr 只吃字面量)。
fn wbuf(fd: u64, p: ptr) -> u64 {
    return write_all(fd, p, strlen_n(p) as u64);
}

fn open_ro(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 0);
}

// O_WRONLY|O_CREAT|O_TRUNC = 577, 0644 = 420
fn open_wo(path: ptr) -> i64 {
    return syscall6(257, (0 as u64) - 100, path as u64, 577, 420, 0);
}

fn close_fd(fd: i64) {
    syscall4(3, fd as u64, 0, 0);
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn stat_mode(p: ptr, stb: ptr) -> u32 {
    let r: i64 = syscall4(262, (0 as u64) - 100, p as u64, stb as u64);
    if r < 0 {
        return NOTFOUND;
    }
    return load32(stb, 24) & S_IFMT;
}

fn finish(rc: u64) -> u32 {
    syscall4(60, rc, 0, 0);
    return 0;
}

// ---------------------------------------------------------------- 文本工具

fn strlen_n(p: ptr) -> u32 {
    let n: u32 = 0;
    while load8(p, n) != 0 {
        n = n + 1;
    }
    return n;
}

fn put(dst: ptr, s: str) {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
}

fn put_n(dst: ptr, p: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
}


// 把一个 NUL 结尾的字节范围与字面量比内容
fn eq_cstr(p: ptr, n: u32, s: str) -> bool {
    if n != str_len(s) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(p, i) != load8(str_ptr(s), i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn starts_with(p: ptr, n: u32, s: str) -> bool {
    let m: u32 = str_len(s);
    if n < m {
        return false;
    }
    let i: u32 = 0;
    while i < m {
        if load8(p, i) != load8(str_ptr(s), i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}


fn digit(c: u32) -> bool {
    if c >= 48 && c <= 57 {
        return true;
    }
    return false;
}

fn alpha(c: u32) -> bool {
    if c >= 97 && c <= 122 {
        return true;
    }
    if c >= 65 && c <= 90 {
        return true;
    }
    if c == 95 {
        return true;
    }
    return false;
}

// ---------------------------------------------------------------- 输出

fn wdec(mem: ptr, fd: u64, v: u32) {
    let buf: ptr = ptr_add(mem, M_OUT);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(buf, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(buf, n, (48 + x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    let i: u32 = 0;
    while i < n / 2 {
        let lo: u8 = load8(buf, i) as u8;
        let hi: u8 = load8(buf, n - 1 - i) as u8;
        store8(buf, i, hi);
        store8(buf, n - 1 - i, lo);
        i = i + 1;
    }
    write_all(fd, buf, n as u64);
}




// 右侧补空格到 w 列。只用 ASCII 串 —— 全角字符按字节数补会对不齐。
fn wpad(fd: u64, s: str, w: u32) {
    wstr(fd, s);
    let n: u32 = str_len(s);
    let k: u32 = 0;
    while n + k < w {
        wstr(fd, " ");
        k = k + 1;
    }
}

// 一段 UTF-8 的**显示宽度**: 三/四字节的字符按两列算 (CJK), 其余一列。
fn dwidth(p: ptr, n: u32) -> u32 {
    let w: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c >= 240 {
            w = w + 2;
            i = i + 4;
        } else if c >= 224 {
            w = w + 2;
            i = i + 3;
        } else if c >= 192 {
            w = w + 1;
            i = i + 2;
        } else {
            w = w + 1;
            i = i + 1;
        }
    }
    return w;
}

// 右侧补空格到 w **列** —— 中英混排的列对齐靠它, 不靠 wpad。
fn wpadx(fd: u64, s: str, w: u32) {
    wstr(fd, s);
    let d: u32 = dwidth(str_ptr(s), str_len(s));
    let k: u32 = 0;
    while d + k < w {
        wstr(fd, " ");
        k = k + 1;
    }
}

// ---------------------------------------------------------------- 颜色

fn color_on(mem: ptr) -> bool {
    if load32(mem, M_CELL + C_COLOR) == 1 {
        return true;
    }
    return false;
}

fn col(mem: ptr, fd: u64, code: str) {
    if color_on(mem) {
        let b: ptr = ptr_add(mem, M_OUT);
        store8(b, 0, 27 as u8);
        store8(b, 1, 91 as u8);
        let n: u32 = str_len(code);
        let i: u32 = 0;
        while i < n {
            store8(b, 2 + i, load8(str_ptr(code), i) as u8);
            i = i + 1;
        }
        store8(b, 2 + n, 109 as u8);
        write_all(fd, b, (3 + n) as u64);
    }
}

fn colr(mem: ptr, fd: u64) {
    col(mem, fd, "0");
}


fn bold(mem: ptr, fd: u64) {
    col(mem, fd, "1");
}

fn cyan(mem: ptr, fd: u64) {
    col(mem, fd, "1;36");
}

fn green(mem: ptr, fd: u64) {
    col(mem, fd, "1;32");
}

fn red(mem: ptr, fd: u64) {
    col(mem, fd, "1;31");
}

fn yellow(mem: ptr, fd: u64) {
    col(mem, fd, "1;33");
}

fn gray(mem: ptr, fd: u64) {
    col(mem, fd, "1;30");
}

// ---------------------------------------------------------------- argv

fn split_argv(mem: ptr, buf: ptr) -> u32 {
    let m: u32 = load32(mem, M_CELL + C_ARGLEN);
    let i: u32 = 0;
    let n: u32 = 0;
    if m > 0 {
        n = 1;
    }
    while i < m {
        if load8(buf, i) == 0 {
            n = n + 1;
        }
        i = i + 1;
    }
    // 末尾的 NUL 后面还有一个空串, 不算一个参数
    if m > 0 && load8(buf, m - 1) == 0 {
        n = n - 1;
    }
    return n;
}

// 第 k 个参数起点 (NUL 结尾的字节范围), 返回下标或 NOTFOUND
fn arg_at(mem: ptr, buf: ptr, k: u32) -> u32 {
    let m: u32 = load32(mem, M_CELL + C_ARGLEN);
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == k {
                return s;
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return NOTFOUND;
}

// ---------------------------------------------------------------- 文件

// 读一个文件到 dst, 返回字节数; 失败返回 NOTFOUND
fn slurp(path: ptr, dst: ptr, cap: u32) -> u32 {
    let fd: i64 = open_ro(path);
    if fd < 0 {
        return NOTFOUND;
    }
    let n: u64 = read_all(fd as u64, dst, cap as u64);
    close_fd(fd);
    return n as u32;
}

// 取 argv[0] 所在的目录 (带结尾分隔符) 写进 dst
fn self_dir(argv0: ptr, dst: ptr) {
    let n: u32 = strlen_n(argv0);
    let i: u32 = 0;
    let last: u32 = 0;
    while i < n {
        let c: u32 = load8(argv0, i);
        if c == 47 || c == 92 {
            last = i + 1;
        }
        i = i + 1;
    }
    let k: u32 = 0;
    while k < last {
        store8(dst, k, load8(argv0, k) as u8);
        k = k + 1;
    }
    store8(dst, last, 0 as u8);
}

// 包内工具定位: <bindir><name> 或 <bindir><name>.exe, 命中就把路径写进 dst
fn tool_path(bindir: ptr, name: str, dst: ptr, stb: ptr) -> bool {
    let bn: u32 = strlen_n(bindir);
    put_n(dst, bindir, bn);
    let tail: ptr = ptr_add(dst, bn);
    put(tail, name);
    if stat_mode(dst, stb) != NOTFOUND {
        return true;
    }
    put(tail, name);
    let tn: u32 = str_len(name);
    store8(tail, tn, 46 as u8);
    store8(tail, tn + 1, 101 as u8);
    store8(tail, tn + 2, 120 as u8);
    store8(tail, tn + 3, 101 as u8);
    store8(tail, tn + 4, 0 as u8);
    if stat_mode(dst, stb) != NOTFOUND {
        return true;
    }
    store8(dst, 0, 0 as u8);
    return false;
}

// ---------------------------------------------------------------- 目录

// 列目录。**先把整层读完再递归** —— getdents64 缓冲是全局共享的, 边读边递归会让子目录
// 的读覆盖父目录还没处理完的条目 (lompkg.lomt 当初就踩过这个, 见 docs/168 §5)。
// 所以每层有自己的名字池 (M_LSN) 与类型位 (M_LST), 按 depth 切片。
fn ls_dir(mem: ptr, fd: u64, dir: ptr, recursive: u32, depth: u32) -> u32 {
    if depth >= MAXD {
        return 0;
    }
    let base: ptr = ptr_add(mem, M_LSP + depth * PATH_CAP);
    let dn: u32 = strlen_n(dir);
    put_n(base, dir, dn);
    if dn > 0 {
        let lc: u32 = load8(base, dn - 1);
        if lc != 47 && lc != 92 {
            store8(base, dn, 47 as u8);
            store8(base, dn + 1, 0 as u8);
        }
    }
    let fd2: i64 = open_ro(base);
    if fd2 < 0 {
        return 0;
    }
    // ---- 第一遍: 读完整层
    let pool: ptr = ptr_add(mem, M_LSN + depth * NPOOL);
    let typs: ptr = ptr_add(mem, M_LST + depth * ENT_CAP);
    let nent: u32 = 0;
    let poff: u32 = 0;
    let dirbuf: ptr = ptr_add(mem, M_DIRBUF);
    let going: u32 = 1;
    while going == 1 {
        let rn: i64 = syscall4(217, fd2 as u64, dirbuf as u64, DIR_CAP as u64);
        if rn <= 0 {
            going = 0;
        } else {
            let total: u32 = rn as u32;
            let off: u32 = 0;
            while off < total {
                let reclen: u32 = load16(dirbuf, off + 16);
                if reclen == 0 {
                    off = total;
                } else {
                    let dtype: u32 = load8(dirbuf, off + 18);
                    let np: ptr = ptr_add(dirbuf, off + 19);
                    let nl: u32 = strlen_n(np);
                    let skip: u32 = 0;
                    if nl == 1 && load8(np, 0) == 46 {
                        skip = 1;
                    }
                    if nl == 2 && load8(np, 0) == 46 && load8(np, 1) == 46 {
                        skip = 1;
                    }
                    if skip == 0 && nent < ENT_CAP && poff + nl + 1 < NPOOL {
                        put_n(ptr_add(pool, poff), np, nl);
                        poff = poff + nl + 1;
                        store8(typs, nent, dtype as u8);
                        nent = nent + 1;
                    }
                    off = off + reclen;
                }
            }
        }
    }
    close_fd(fd2);

    // ---- 第二遍: 打印 + 递归 (这层已读完, 缓冲随便用)
    let i: u32 = 0;
    let cur: u32 = 0;
    while i < nent {
        let np: ptr = ptr_add(pool, cur);
        let nl: u32 = strlen_n(np);
        let isdir: u32 = 0;
        if load8(typs, i) == 4 {
            isdir = 1;
        }
        let d: u32 = 0;
        while d < depth {
            wstr(fd, "  ");
            d = d + 1;
        }
        if isdir == 1 {
            cyan(mem, fd);
        }
        wbytes(fd, np, nl);
        if isdir == 1 {
            wstr(fd, "/");
            colr(mem, fd);
        }
        wstr(fd, "\n");
        if recursive == 1 && isdir == 1 {
            let child: ptr = ptr_add(mem, M_LSP + (depth + 1) * PATH_CAP);
            let bl: u32 = strlen_n(base);
            put_n(child, base, bl);
            put_n(ptr_add(child, bl), np, nl);
            ls_dir(mem, fd, child, 1, depth + 1);
        }
        cur = cur + nl + 1;
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 帮助版面

fn sec(mem: ptr, fd: u64, title: str) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, title);
    colr(mem, fd);
    wstr(fd, "\n");
}

fn row(mem: ptr, fd: u64, name: str, args: str, desc: str) {
    wstr(fd, "  ");
    bold(mem, fd);
    wpad(fd, name, 9);
    colr(mem, fd);
    wstr(fd, " ");
    gray(mem, fd);
    wpad(fd, args, 17);
    colr(mem, fd);
    wstr(fd, " ");
    wstr(fd, desc);
    wstr(fd, "\n");
}

// 去掉前缀 (banner 里已经有个 Loment, 别再重复一行)
fn after_prefix(p: ptr, s: str) -> ptr {
    if starts_with(p, strlen_n(p), s) {
        return ptr_add(p, str_len(s));
    }
    return p;
}

fn banner(mem: ptr, fd: u64, ver: ptr) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, "Loment");
    colr(mem, fd);
    wstr(fd, "  ");
    bold(mem, fd);
    wbuf(fd, after_prefix(ver, "Loment "));
    colr(mem, fd);
    wstr(fd, "  ");
    gray(mem, fd);
    wstr(fd, "loment-cli");
    colr(mem, fd);
    wstr(fd, "\n");
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "usage  loment <command> [args]");
    colr(mem, fd);
    wstr(fd, "\n");
}

fn catalog(mem: ptr, fd: u64) {
    sec(mem, fd, "COMPILE & RUN");
    row(mem, fd, "ir", "FILE", "print LLVM IR to stdout");
    row(mem, fd, "check", "FILE", "check only, discard IR (diagnostics on stderr)");
    row(mem, fd, "build", "FILE [-o NAME] [--link OBJ...] [--opt]", "compile and link to an executable");
    row(mem, fd, "run", "FILE [--link OBJ...] [--opt]", "compile, link and run");
    row(mem, fd, "version", "", "print the version line");
    row(mem, fd, "lsp", "", "language server over stdio");
    sec(mem, fd, "SOURCE TOOLS");
    row(mem, fd, "fmt", "FILE", "format (prints the result, does not touch the file)");
    row(mem, fd, "doc", "FILE", "API docs from /// comments");
    row(mem, fd, "skill", "[--print]", "the AI-agent guide (its path, or the whole text)");
    sec(mem, fd, "READ SOURCE");
    row(mem, fd, "cat", "FILE", "print with line numbers");
    row(mem, fd, "stat", "FILE", "lines / bytes / longest line");
    row(mem, fd, "count", "FILE", "fn / struct / enum counts");
    row(mem, fd, "fns", "FILE", "list function signatures");
    row(mem, fd, "tokens", "FILE", "token histogram");
    row(mem, fd, "grep", "PAT FILE", "substring search, with line numbers");
    row(mem, fd, "todo", "FILE", "list TODO / FIXME / XXX");
    row(mem, fd, "hash", "FILE", "sha256 content hash");
    sec(mem, fd, "PROJECT");
    row(mem, fd, "ls", "[DIR]", "list a directory (directories get a trailing /)");
    row(mem, fd, "tree", "[DIR]", "recursive directory tree");
    row(mem, fd, "new", "NAME", "write a hello skeleton");
    row(mem, fd, "examples", "", "list the examples shipped in this package");
    row(mem, fd, "example", "NAME", "print one example");
    sec(mem, fd, "LANGUAGE REFERENCE");
    row(mem, fd, "syntax", "", "syntax cheat-sheet");
    row(mem, fd, "builtins", "", "builtin function table");
    row(mem, fd, "types", "", "type table");
    row(mem, fd, "keywords", "", "keywords");
    row(mem, fd, "caps", "", "capability / guard");
    row(mem, fd, "codes", "", "error code table E1-E23");
    row(mem, fd, "explain", "CODE", "one error code explained");
    row(mem, fd, "cheat", "", "one-page cheat sheet");
    sec(mem, fd, "THIS INSTALL");
    row(mem, fd, "tools", "", "tools in this package: present or missing");
    row(mem, fd, "where", "[TOOL]", "absolute path of a tool");
    row(mem, fd, "env", "", "install prefix and environment");
    row(mem, fd, "doctor", "", "health check: is everything in place");
    row(mem, fd, "about", "", "build info");
    row(mem, fd, "color", "[on|off]", "ANSI colour switch");
    row(mem, fd, "commands", "", "every command name (for completion)");
    row(mem, fd, "help", "[COMMAND]", "this page, or one command");
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "loment help <command> for one command  .  loment commands for the names");
    colr(mem, fd);
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "e.g.  loment run hi.lomt  .  loment skill --print  .  loment explain E4");
    colr(mem, fd);
    wstr(fd, "\n\n");
}

// 命令名清单 —— 与 catalog 必须一致 (判据 tools/loment_cli_test.py 钉住)
fn names_dump(fd: u64) {
    wstr(fd, "ir\ncheck\nbuild\nrun\nversion\nlsp\n");
    wstr(fd, "fmt\ndoc\nskill\n");
    wstr(fd, "cat\nstat\ncount\nfns\ntokens\ngrep\ntodo\nhash\n");
    wstr(fd, "ls\ntree\nnew\nexamples\nexample\n");
    wstr(fd, "syntax\nbuiltins\ntypes\nkeywords\ncaps\ncodes\nexplain\ncheat\n");
    wstr(fd, "tools\nwhere\nenv\ndoctor\nabout\ncolor\ncommands\nhelp\n");
}

fn usage_line(mem: ptr, fd: u64, name: str, args: str, desc: str) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, "loment ");
    wstr(fd, name);
    colr(mem, fd);
    if str_len(args) > 0 {
        wstr(fd, " ");
        gray(mem, fd);
        wstr(fd, args);
        colr(mem, fd);
    }
    wstr(fd, "\n\n  ");
    wstr(fd, desc);
    wstr(fd, "\n\n");
}

fn help_of(mem: ptr, fd: u64, cmd: ptr, n: u32) -> u32 {
    if eq_cstr(cmd, n, "ir") {
        usage_line(mem, fd, "ir", "FILE", "Compile to LLVM IR and print it to stdout. No linking, nothing written.");
        return 0;
    }
    if eq_cstr(cmd, n, "check") {
        usage_line(mem, fd, "check", "FILE", "Check only. Diagnostics go to stderr, the IR is discarded, so no file is\n  produced. Non-zero exit code = there were diagnostics.");
        return 0;
    }
    if eq_cstr(cmd, n, "build") {
        usage_line(mem, fd, "build", "FILE [-o NAME] [--link OBJ...] [--opt]", "Compile and link to an executable.\n  -o takes a name WITHOUT an extension: -o hi gives hi.exe on Windows, hi on Linux.\n  --link OBJ adds a foreign ELF object (FFI): give the .o you compiled yourself.\n  A self-contained object needs nothing else. An object that carries undefined symbols is\n  refused by default; the launcher passes --allow-ports in both channels (open since\n  2026-10-17, docs/222 sec 4.5). Calling the self-hosted lomelf directly needs that flag.\n  --opt hands the IR to clang -O2 when clang is installed (ELF) -- the same optimizer C\n  and Rust use; without clang it says so and falls back to the self-hosted lomelf linker.");
        return 0;
    }
    if eq_cstr(cmd, n, "run") {
        usage_line(mem, fd, "run", "FILE [--link OBJ...] [--opt]", "Compile, link and run. The exit code is the program's own exit code.\n  --link OBJ adds a foreign ELF object (FFI), same rules as build.\n  --opt: same as build (clang -O2 when installed, ELF).");
        return 0;
    }
    if eq_cstr(cmd, n, "fmt") {
        usage_line(mem, fd, "fmt", "FILE", "Format and print the result to stdout (the file itself is untouched).");
        return 0;
    }
    if eq_cstr(cmd, n, "grep") {
        usage_line(mem, fd, "grep", "PAT FILE", "Find PAT in FILE as a SUBSTRING (not a regex) and print `line: text`.\n  No match -> exit code 1.");
        return 0;
    }
    if eq_cstr(cmd, n, "new") {
        usage_line(mem, fd, "new", "NAME", "Write a hello skeleton to NAME.lomt that runs with `loment run`.\n  Refuses to overwrite an existing file (exit code 1).");
        return 0;
    }
    if eq_cstr(cmd, n, "ls") {
        usage_line(mem, fd, "ls", "[DIR]", "List a directory. Directories are coloured and get a trailing `/`.\n  Defaults to the current directory.");
        return 0;
    }
    if eq_cstr(cmd, n, "tree") {
        usage_line(mem, fd, "tree", "[DIR]", "Recursive directory tree; indentation shows depth.");
        return 0;
    }
    if eq_cstr(cmd, n, "color") {
        usage_line(mem, fd, "color", "[on|off]", "ANSI colour switch. With no argument it prints the current setting.\n  Default is on - for piped output use `color off` or --no-color.");
        return 0;
    }
    if eq_cstr(cmd, n, "explain") {
        usage_line(mem, fd, "explain", "CODE", "Give it an error code (E4, e4 or 4 all work) and it prints what it means\n  and what to change.");
        return 0;
    }
    if eq_cstr(cmd, n, "skill") {
        usage_line(mem, fd, "skill", "[--print]", "The AI-agent guide. No argument prints its path, --print prints the text.");
        return 0;
    }
    if eq_cstr(cmd, n, "help") {
        usage_line(mem, fd, "help", "[COMMAND]", "No argument prints the overview; with a command name it prints that one.");
        return 0;
    }
    if eq_cstr(cmd, n, "commands") {
        usage_line(mem, fd, "commands", "", "One command name per line (for completion scripts).");
        return 0;
    }
    if eq_cstr(cmd, n, "doctor") {
        usage_line(mem, fd, "doctor", "", "Check that every component in the package is present and that the shared\n  files are readable. Exit code 0 = all green, 1 = something is missing.");
        return 0;
    }
    if eq_cstr(cmd, n, "hash") {
        usage_line(mem, fd, "hash", "FILE", "Print the file's sha256 hex digest (the digest alone, no file name - so it\n  can be fed to `sha256sum -c`).");
        return 0;
    }
    if eq_cstr(cmd, n, "example") {
        usage_line(mem, fd, "example", "NAME", "Print the whole of the bundled example NAME.lomt.");
        return 0;
    }
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "no manual page for this one: ");
    colr(mem, fd);
    bold(mem, fd);
    wbytes(fd, cmd, n);
    colr(mem, fd);
    wstr(fd, "\n");
    wstr(fd, "\n  ");
    gray(mem, fd);
    wstr(fd, "try `loment commands` for every name, or `loment help` for the overview.");
    colr(mem, fd);
    wstr(fd, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 版本/环境

fn version_text(mem: ptr, bindir: ptr, dst: ptr) -> u32 {
    let p: ptr = ptr_add(mem, M_TMP);
    let bn: u32 = strlen_n(bindir);
    let k: u32 = 0;
    while k < bn {
        store8(p, k, load8(bindir, k) as u8);
        k = k + 1;
    }
        let bp: ptr = ptr_add(p, bn);
    put(bp, "..");
    put(ptr_add(bp, 2), "/share/loment/version");
    let n: u32 = slurp(p, dst, 256);
    if n == NOTFOUND {
        put(dst, "unknown");
        return 6;
    }
    // 只取第一行
    let i: u32 = 0;
    while i < n {
        if load8(dst, i) == 10 {
            store8(dst, i, 0 as u8);
            return i;
        }
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return n;
}

// ---------------------------------------------------------------- 小工具


fn err_path(mem: ptr, a: str, p: ptr) -> u32 {
    red(mem, 2);
    wstr(2, "loment: ");
    colr(mem, 2);
    wstr(2, a);
    wbytes(2, p, strlen_n(p));
    wstr(2, "\n");
    return 1;
}

fn err_usage(mem: ptr, msg: str) -> u32 {
    red(mem, 2);
    wstr(2, "loment: ");
    colr(mem, 2);
    wstr(2, msg);
    wstr(2, "\n");
    gray(mem, 2);
    wstr(2, "  try `loment help ");
    colr(mem, 2);
    return 2;
}

fn arg_copy(mem: ptr, ab: ptr, k: u32, dst: ptr) -> u32 {
    let o: u32 = arg_at(mem, ab, k);
    if o == NOTFOUND {
        store8(dst, 0, 0 as u8);
        return NOTFOUND;
    }
    let n: u32 = strlen_n(ptr_add(ab, o));
    put_n(dst, ptr_add(ab, o), n);
    return n;
}

/// `X/bin/` -> `X/`；`bin/` -> 空（即"当前目录"）；没有分隔符 -> 空。
///
/// **为什么需要它**: 分享目录原先写成 `<bindir>/../share/loment/` —— 同一个目录，但
/// `loment env`、`loment examples`、`loment example` 把它**当路径打给用户看**，于是屏幕上
/// 出现 `.../bin/../share/loment/examples/`。归一化在这里做一次，三个命令的输出一起正。
fn dir_up(src: ptr, dst: ptr) -> u32 {
    let n: u32 = strlen_n(src);
    let e: u32 = n;
    while e > 0 && (load8(src, e - 1) == 47 || load8(src, e - 1) == 92) {
        e = e - 1;
    }
    let cut: u32 = 0;
    let i: u32 = 0;
    while i < e {
        let c: u32 = load8(src, i);
        if c == 47 || c == 92 {
            cut = i + 1;
        }
        i = i + 1;
    }
    put_n(dst, src, cut);
    return cut;
}

// <pkg>/share/loment/ 写进 dst
fn share_dir(mem: ptr, ab: ptr, dst: ptr) -> u32 {
    let b: ptr = ptr_add(mem, M_TMP);
    let o: u32 = arg_at(mem, ab, 0);
    self_dir(ptr_add(ab, o), b);
    // 归一化: 取 bindir 的上一级，而不是拼一个 `..` 让用户去读它。
    // 直接写进 dst —— 不能再要一块暂存: 调用方可能正拿着 M_P1..P3 里的某一块
    // (`do_env` 就把 M_P3 当 bindir 传进来), 在 share_dir 里动它们会把它擦掉。
    let dn: u32 = dir_up(b, dst);
    put(ptr_add(dst, dn), "share/loment/");
    return strlen_n(dst);
}

// 读 argv[k] 这个文件到 M_FILE, 返回长度; 找不到打错误并返回 NOTFOUND
fn read_arg(mem: ptr, ab: ptr, k: u32) -> u32 {
    let path: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, k, path);
    let stb: ptr = ptr_add(mem, M_STB);
    let mode: u32 = stat_mode(path, stb);
    if mode == S_IFDIR {
        err_path(mem, "not a file: ", path);
        return NOTFOUND;
    }
    let n: u32 = slurp(path, ptr_add(mem, M_FILE), FILE_CAP);
    if n == NOTFOUND {
        err_path(mem, "cannot open ", path);
        return NOTFOUND;
    }
    return n;
}

fn kv(mem: ptr, fd: u64, k: str, v: u32) {
    wstr(fd, "  ");
    gray(mem, fd);
    wpadx(fd, k, 12);
    colr(mem, fd);
    bold(mem, fd);
    wdec(mem, fd, v);
    colr(mem, fd);
    wstr(fd, "\n");
}

// 值是运行期缓冲的版本 (路径、版本号这些算出来的文本)
fn kvb(mem: ptr, fd: u64, k: str, v: ptr) {
    wstr(fd, "  ");
    gray(mem, fd);
    wpadx(fd, k, 12);
    colr(mem, fd);
    bold(mem, fd);
    wbuf(fd, v);
    colr(mem, fd);
    wstr(fd, "\n");
}

fn kvs(mem: ptr, fd: u64, k: str, v: str) {
    wstr(fd, "  ");
    gray(mem, fd);
    wpadx(fd, k, 12);
    colr(mem, fd);
    bold(mem, fd);
    wstr(fd, v);
    colr(mem, fd);
    wstr(fd, "\n");
}

fn title(mem: ptr, fd: u64, t: str) {
    wstr(fd, "\n  ");
    cyan(mem, fd);
    wstr(fd, t);
    colr(mem, fd);
    wstr(fd, "\n");
}

// ---------------------------------------------------------------- 导航命令

fn do_help(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let ver: ptr = ptr_add(mem, M_P2);
    let bindir: ptr = ptr_add(mem, M_P3);
    version_text(mem, bindir_from(mem, ab, bindir), ver);
    banner(mem, 1, ver);
    if argc >= 3 {
        let o: u32 = arg_at(mem, ab, 2);
        return help_of(mem, 1, ptr_add(ab, o), strlen_n(ptr_add(ab, o)));
    }
    catalog(mem, 1);
    return 0;
}

fn bindir_from(mem: ptr, ab: ptr, dst: ptr) -> ptr {
    let o: u32 = arg_at(mem, ab, 0);
    self_dir(ptr_add(ab, o), dst);
    return dst;
}

fn do_commands(mem: ptr, ab: ptr, argc: u32) -> u32 {
    names_dump(1);
    return 0;
}

fn do_version(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let ver: ptr = ptr_add(mem, M_P2);
    version_text(mem, bindir_from(mem, ab, bindir), ver);
    wbuf(1, ver);
    wstr(1, "\n");
    return 0;
}

fn do_about(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let ver: ptr = ptr_add(mem, M_P2);
    bindir_from(mem, ab, bindir);
    version_text(mem, bindir, ver);
    title(mem, 1, "Loment");
    kvb(mem, 1, "version", ver);
    kvs(mem, 1, "entry", "loment-cli (a Loment self-hosted binary)");
    kvb(mem, 1, "installed", bindir);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "This CLI is itself written in Loment: source loment/tools/lomcli.lomt,");
    wstr(1, "\n  and it uses only 8 cross-platform syscalls.");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// 包内应当就位的工具。**几个**只有这一处说，循环上界、`present: n / N` 的分母、以及
// "缺一个就退 1"的门槛都从它来 —— 原先分母与门槛各写死一个 `6`，而 `tool_name` 有 7 项，
// 于是**缺一个组件仍报绿且退 0**（`ok` 为 6 时 `6 < 6` 是假）。加工具时漏改任何一处，
// 症状都是"这条检查没有分辨力"，而当时没有任何判据会红。
const TOOL_N: u32 = 7;

fn tool_name(i: u32) -> str {
    if i == 0 {
        return "loment-driver";
    }
    if i == 1 {
        return "loment-lsp";
    }
    if i == 2 {
        return "loment-fmt";
    }
    if i == 3 {
        return "loment-doc";
    }
    if i == 4 {
        return "loment-lomelf";
    }
    if i == 5 {
        return "loment-cli";
    }
    if i == 6 {
        return "lomenterr";
    }
    return "";
}

/// 缺这个组件**具体会怎样**。**不是一句通用的"build/run 会坏"** —— 对报错器那句是假话:
/// 它缺席只是退回编译器的裸诊断, 编译/链接照样能用 (docs/182 §6 那条"落到内置要说出来")。
fn tool_hint(i: u32) -> str {
    if i == 6 {
        return "-> errors fall back to the compiler's plain lines";
    }
    return "-> loment build/run will not work";
}

fn do_tools(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let p: ptr = ptr_add(mem, M_P2);
    let stb: ptr = ptr_add(mem, M_STB);
    bindir_from(mem, ab, bindir);
    title(mem, 1, "Tools in this package");
    let i: u32 = 0;
    let ok: u32 = 0;
    while i < TOOL_N {
        let nm: str = tool_name(i);
        if tool_path(bindir, nm, p, stb) {
            wstr(1, "  ");
            green(mem, 1);
            wstr(1, "[ok] ");
            colr(mem, 1);
            wpad(1, nm, 18);
            gray(mem, 1);
            wstr(1, "present");
            colr(mem, 1);
            wstr(1, "\n");
            ok = ok + 1;
        } else {
            wstr(1, "  ");
            red(mem, 1);
            wstr(1, "[--] ");
            colr(mem, 1);
            wpad(1, nm, 18);
            gray(mem, 1);
            wstr(1, "MISSING");
            colr(mem, 1);
            wstr(1, "\n");
        }
        i = i + 1;
    }
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "present: ");
    colr(mem, 1);
    bold(mem, 1);
    wdec(mem, 1, ok);
    colr(mem, 1);
    gray(mem, 1);
    wstr(1, " / ");
    wdec(mem, 1, TOOL_N);
    colr(mem, 1);
    wstr(1, "\n\n");
    if ok < TOOL_N {
        return 1;
    }
    return 0;
}

fn do_where(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let p: ptr = ptr_add(mem, M_P2);
    let stb: ptr = ptr_add(mem, M_STB);
    bindir_from(mem, ab, bindir);
    if argc < 3 {
        wbuf(1, bindir);
        wstr(1, "\n");
        return 0;
    }
    let name: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, 2, name);
    let nm: str = "";
    if eq_cstr(name, strlen_n(name), "driver") {
        nm = "loment-driver";
    } else if eq_cstr(name, strlen_n(name), "lsp") {
        nm = "loment-lsp";
    } else if eq_cstr(name, strlen_n(name), "fmt") {
        nm = "loment-fmt";
    } else if eq_cstr(name, strlen_n(name), "doc") {
        nm = "loment-doc";
    } else if eq_cstr(name, strlen_n(name), "lomelf") {
        nm = "loment-lomelf";
    } else if eq_cstr(name, strlen_n(name), "cli") {
        nm = "loment-cli";
    } else if eq_cstr(name, strlen_n(name), "lompi") {
        nm = "lompi";
    } else if eq_cstr(name, strlen_n(name), "err") {
        nm = "lomenterr";
    } else {
        return err2_unknown(mem, name);
    }
    if tool_path(bindir, nm, p, stb) {
        wbuf(1, p);
        wstr(1, "\n");
        return 0;
    }
    let q: ptr = ptr_add(mem, M_P1);
    let bn: u32 = strlen_n(bindir);
    put_n(q, bindir, bn);
    put(ptr_add(q, bn), nm);
    err_path(mem, "not found: ", q);
    return 1;
}

fn err2_unknown(mem: ptr, name: ptr) -> u32 {
    err_path(mem, "no such tool: ", name);
    gray(mem, 2);
    wstr(2, "  driver / lsp / fmt / doc / lomelf / cli / err");
    colr(mem, 2);
    wstr(2, "\n");
    return 2;
}

fn do_env(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let share: ptr = ptr_add(mem, M_P2);
    let ver: ptr = ptr_add(mem, M_P1);
    bindir_from(mem, ab, bindir);
    share_dir(mem, ab, share);
    version_text(mem, bindir, ver);
    title(mem, 1, "Environment");
    kvb(mem, 1, "bin dir", bindir);
    kvb(mem, 1, "share dir", share);
    kvb(mem, 1, "version", ver);
    kvs(mem, 1, "paths from", "argv[0] - the CLI locates itself, it reads no env vars");
    return 0;
}

fn do_doctor(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let bindir: ptr = ptr_add(mem, M_P3);
    let p: ptr = ptr_add(mem, M_P2);
    let stb: ptr = ptr_add(mem, M_STB);
    let ver: ptr = ptr_add(mem, M_P1);
    bindir_from(mem, ab, bindir);
    title(mem, 1, "Health check");
    let bad: u32 = 0;
    let i: u32 = 0;
    while i < 7 {
        let nm: str = tool_name(i);
        if tool_path(bindir, nm, p, stb) {
            wstr(1, "  ");
            green(mem, 1);
            wstr(1, "ok       ");
            colr(mem, 1);
            wstr(1, nm);
            wstr(1, "\n");
        } else {
            wstr(1, "  ");
            red(mem, 1);
            wstr(1, "MISSING  ");
            colr(mem, 1);
            wstr(1, nm);
            wstr(1, "  ");
            gray(mem, 1);
            wstr(1, tool_hint(i));
            colr(mem, 1);
            wstr(1, "\n");
            bad = bad + 1;
        }
        i = i + 1;
    }
    version_text(mem, bindir, ver);
    if eq_cstr(ver, strlen_n(ver), "unknown") {
        wstr(1, "  ");
        red(mem, 1);
        wstr(1, "MISSING  ");
        colr(mem, 1);
        wstr(1, "share/loment/version");
        wstr(1, "\n");
        bad = bad + 1;
    } else {
        wstr(1, "  ");
        green(mem, 1);
        wstr(1, "ok       ");
        colr(mem, 1);
        wstr(1, "version ");
        wbuf(1, ver);
        wstr(1, "\n");
    }
    wstr(1, "\n");
    if bad == 0 {
        green(mem, 1);
        wstr(1, "  all green");
        colr(mem, 1);
        wstr(1, "\n\n");
        return 0;
    }
    red(mem, 1);
    wstr(1, "  ");
    wdec(mem, 1, bad);
    wstr(1, " missing - reinstall, or put the file back under bin/");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 1;
}

fn do_color(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc >= 3 {
        let a: ptr = ptr_add(mem, M_P1);
        arg_copy(mem, ab, 2, a);
        let n: u32 = strlen_n(a);
        if eq_cstr(a, n, "on") {
            store32(mem, M_CELL + C_COLOR, 1);
        } else if eq_cstr(a, n, "off") {
            store32(mem, M_CELL + C_COLOR, 0);
        } else {
            return err_usage(mem, "color takes on or off");
        }
    }
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "colour ");
    colr(mem, 1);
    if color_on(mem) {
        green(mem, 1);
        wstr(1, "on");
    } else {
        red(mem, 1);
        wstr(1, "off");
    }
    colr(mem, 1);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "Default is on. For clean piped output use --no-color, or `loment color off` first.");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 错误码

/// 一列: `  E22   <ASCII 一行说明>`。码这一列宽 5、左对齐 —— 与旧的手抄 `codrow` 同形,
/// 只是码由数字拼出来 (表里存的是数, 见 surface_data 的注解)。
fn codrow_n(mem: ptr, fd: u64, c: u32, desc: str) {
    wstr(fd, "  ");
    yellow(mem, fd);
    wstr(fd, "E");
    wdec(mem, fd, c);
    let d: u32 = 1;
    let x: u32 = c;
    while x >= 10 {
        x = x / 10;
        d = d + 1;
    }
    let k: u32 = 0;
    while 1 + d + k < 5 {
        wstr(fd, " ");
        k = k + 1;
    }
    colr(mem, fd);
    wstr(fd, desc);
    wstr(fd, "\n");
}

// 速查表的行: 头一列是中文词, 按显示宽度对齐
fn termrow(mem: ptr, fd: u64, term: str, desc: str) {
    wstr(fd, "  ");
    yellow(mem, fd);
    wpadx(fd, term, 10);
    // wpadx 只补到宽度 10 就停 —— 首列本身 ≥10 的项会与 desc 粘在一起
    // (control flow / * capability / * program/ABI 就是这么粘的)。补一个分隔空格。
    wstr(fd, " ");
    colr(mem, fd);
    wstr(fd, desc);
    wstr(fd, "\n");
}

fn do_codes(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Loment error codes");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "Codes are grouped by WHAT TO DO, not by wording. The compiler prints e.g.");
    wstr(1, "\n    `E2 @13 line 4: x`  -  E2 is E002, @13 is the 13th token.");
    colr(mem, 1);
    wstr(1, "\n\n");
    // **不手抄**: 表在 surface_data (由 tools/loment_diag.py --dump-surface 生成; 唯一真源
    // 是那里的 RULES + ASCII_ONE_LINER)。这里原先抄了 23 条 `codrow`, 与那份表是同一件事的
    // 两个副本 —— 而本仓那四个静默 bug 全出自"同一份清单抄第二遍" (docs/179 7.3)。加一个码
    // 忘了改这里, 表现是"新码在 `loment codes` 里凭空消失", 没有任何判据会红。
    // 码从 1 起**连续编号** (loment_diag 的 RULES 就是这么给的; 那条不变式有判据钉着,
    // 见 loment_tools_test 的 test_code_tables_cover_the_same_codes), 所以 n_codes()
    // 也**就是最后一个码**。
    let c: u32 = 1;
    while c <= n_codes() {
        codrow_n(mem, 1, c, code_ascii(c));
        c = c + 1;
    }
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "loment explain E4 for one of them in detail.");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn parse_code(p: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    if n > 0 && (load8(p, 0) == 69 || load8(p, 0) == 101) {
        i = 1;
    }
    let v: u32 = 0;
    let got: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if digit(c) {
            v = v * 10 + (c - 48);
            got = 1;
        } else {
            return 0;
        }
        i = i + 1;
    }
    if got == 0 {
        return 0;
    }
    return v;
}

fn do_explain(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "explain takes an error code, e.g. E4");
    }
    let a: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, 2, a);
    let code: u32 = parse_code(a, strlen_n(a));
    // 上界**问 surface_data**, 不写死 —— 写死一个数字就是又一份"同一件事的第二个副本",
    // 下一个码加进去时它会静默变成错的 (docs/182 5.2)。
    if code == 0 || code > n_codes() {
        return err_usage(mem, "explain takes an error code (see `loment codes`)");
    }
    wstr(1, "\n  ");
    yellow(mem, 1);
    wstr(1, "E");
    wdec(mem, 1, code);
    colr(mem, 1);
    wstr(1, "\n\n  ");
    // **每个码都先给一行真话**：原先的长文只覆盖 8/23 个码，其余落进一个通用兜底 ——
    // 用户敲 `loment explain E7` 拿到的是"去 `loment codes` 那张表里找"，而不是这个码
    // 什么意思。这一行来自 surface_data（真源是 `loment_diag.ASCII_ONE_LINER`），所以
    // "表里加了新码而 explain 说不出话"不可能再发生。CLI 必须纯 ASCII，所以给 ASCII 那一份；
    // 中文的完整说明卡由 `loment check` 经报错器渲染（docs/182 §11）。
    gray(mem, 1);
    wstr(1, code_ascii(code));
    colr(mem, 1);
    wstr(1, "\n");
    if code == 1 {
        wstr(1, "\n  Type mismatch.");
        wstr(1, "\n");
        wstr(1, "\n    Common cases: the value returned does not match the declaration; an enum payload");
        wstr(1, "\n    has the wrong type; a builtin got an argument of the wrong type.");
        wstr(1, "\n    Fix: check the signature; conversions must be written explicitly with `as`.");
    }
    else if code == 2 {
        wstr(1, "\n  Something is not declared.");
        wstr(1, "\n");
        wstr(1, "\n    The three most common:");
        wstr(1, "\n      1. `let x = 1;` - there is no type inference, write `let x: u32 = 1;`");
        wstr(1, "\n      2. a misspelt function name, or a missing `pub` (cross-module needs pub)");
        wstr(1, "\n      3. used before defined - inside a module, define before use");
        wstr(1, "\n    Note: a generic fn whose T cannot be inferred also reports E2, and that message");
        wstr(1, "\n    is misleading.");
    }
    else if code == 3 {
        wstr(1, "\n  Wrong number of arguments.");
        wstr(1, "\n");
        wstr(1, "\n    Fix: count the parameters and the arguments; there are at most 10 parameters.");
    }
    else if code == 4 {
        wstr(1, "\n  Capability domain problem.");
        wstr(1, "\n");
        wstr(1, "\n    `capability c : disk[0..4]` declares the domain, `guard c(i);` uses it.");
        wstr(1, "\n    A literal out of range is a compile-time error; anything else is checked at run time.");
        wstr(1, "\n    Fix: check whether [lo..hi] contains that index.");
    }
    else if code == 8 {
        wstr(1, "\n  match / enum problem.");
        wstr(1, "\n");
        wstr(1, "\n    Three common cases:");
        wstr(1, "\n      1. the arm body was written as an expression - it must be a BLOCK:");
        wstr(1, "\n         `E::A => { return 0; }`");
        wstr(1, "\n      2. a generic enum needs the monomorphised name: `Result_i64_u32::Ok(v)`");
        wstr(1, "\n      3. not exhaustive, and no `_` arm");
    }
    else if code == 18 {
        wstr(1, "\n  `use` does not resolve.");
        wstr(1, "\n");
        wstr(1, "\n    Two forms: `use name` or `use \"path.lomt\"` - neither takes a semicolon.");
        wstr(1, "\n    Fix: make sure the file is under loment/lib, examples, selfhost or tools;");
        wstr(1, "\n    a sibling file in your own directory needs the path form.");
    }
    else if code == 19 {
        wstr(1, "\n  Parse error.");
        wstr(1, "\n");
        wstr(1, "\n    The message gives `line:col`; go and fix that line.");
        wstr(1, "\n    The two most common: a stray semicolon after `use x;`, and a valueless `return;`");
        wstr(1, "\n    (it must be `return <expr>;`).");
        wstr(1, "\n    Note: one parse error aborts the whole check, so later diagnostics never appear -");
        wstr(1, "\n    fix one thing at a time.");
    }
    else if code == 20 {
        wstr(1, "\n  Too many `use` in one file (the limit is 300).");
        wstr(1, "\n");
        wstr(1, "\n    A facade that re-exports a whole library hits this. Split it into a few files");
        wstr(1, "\n    that each re-export a group, then have the facade `use` those.");
        wstr(1, "\n    The limit is per file, and it is loud on purpose: a silently dropped import");
        wstr(1, "\n    shows up later as a bogus undefined function (E2) with no hint of the cause.");
    }
    else {
        wstr(1, "\n  Full card (what / why / 3+ fixes / supported vs not) is rendered by");
        wstr(1, " `loment check` - it is in Chinese because the diagnostics are.");
    }
    wstr(1, "\n\n  ");
    gray(mem, 1);
    wstr(1, "full table: loment codes   .   syntax: loment syntax   .   guide: loment skill --print");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 语言速查

fn do_syntax(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Loment syntax cheat-sheet");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "Surface syntax is Rust-flavored, plus one extra layer: capability domains.");
    colr(mem, 1);
    wstr(1, "\n\n");
    termrow(mem, 1, "module", "first line `module <name>` (no semicolon)");
    termrow(mem, 1, "import", "`use name` / `use \"path.lomt\"` - neither takes a semicolon");
    termrow(mem, 1, "fn", "`fn f(a: u32, b: str) -> u32 { ... }`, no `->` when nothing is returned, <= 10 params");
    termrow(mem, 1, "pub", "add `pub` to be visible across modules");
    termrow(mem, 1, "const", "`const NAME: u32 = 3;` - the initialiser must be an integer literal");
    termrow(mem, 1, "let", "`let x: u32 = e;` - the type annotation is mandatory, there is no inference");
    termrow(mem, 1, "control flow", "if / else if / else / while / for i in lo..hi");
    termrow(mem, 1, "return", "`return <expr>;` - it must carry a value, there is no bare `return;`");
    termrow(mem, 1, "struct", "`struct S { a: u32 }`, literal `S { a: 1 }`, field access `s.a`");
    termrow(mem, 1, "enum", "`enum E { A, B(u32) }`, construct `E::B(3)`");
    termrow(mem, 1, "match", "arm bodies are BLOCKS, not expressions; must be exhaustive or have `_`");
    termrow(mem, 1, "array", "`[u8; 16]`, literal `[1, 2, 3]`, index xs[0] is readable and writable");
    termrow(mem, 1, "slice", "param `[T]` / `mut [T]`, pass `&xs` / `&mut xs`, `slice_len(s)`");
    termrow(mem, 1, "generics", "`fn max_of<T>(a: T, b: T) -> T`, monomorphised at compile time");
    termrow(mem, 1, "trait", "`trait M { fn m(self) -> u32; }` + `impl M for S`, static dispatch");
    termrow(mem, 1, "types", "u8..u64 i8..i64 bool ptr str, struct names, [T; N], [T], mut [T]");
    termrow(mem, 1, "cast", "`x as u64` - int<->pointer casts must be written explicitly");
    termrow(mem, 1, "string", "\"...\", escapes are only \\n \\t \\\" \\\\ - there is NO \\x escape");
    termrow(mem, 1, "comment", "// and /* */, /// is a doc comment (loment doc extracts it)");
    termrow(mem, 1, "entry", "freestanding entry is `_start`, it takes no arguments; exit with syscall4(60, ...)");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "traps: loment cheat   .   builtins: loment builtins   .   error codes: loment codes");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_builtins(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Builtin functions (all of them, there is nothing else)");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "No standard library: no String / Vec / HashMap, no I/O wrappers, no printf.");
    colr(mem, 1);
    wstr(1, "\n\n");
    termrow(mem, 1, "str_len", "str_len(s: str) -> u32   byte length");
    termrow(mem, 1, "str_byte", "str_byte(s: str, i: u32) -> u32   the i-th byte");
    termrow(mem, 1, "str_eq", "str_eq(a: str, b: str) -> bool   content comparison");
    termrow(mem, 1, "str_concat", "str_concat(a, b) -> str   concatenation (bump heap is only 64 KiB)");
    termrow(mem, 1, "str_ptr", "str_ptr(s: str) -> ptr   data pointer (feed it to syscall)");
    termrow(mem, 1, "alloc", "alloc(n: u32) -> ptr   bump heap (64 KiB ceiling)");
    termrow(mem, 1, "free", "free(p: ptr) -> u32   placeholder, the bump heap does not reclaim");
    termrow(mem, 1, "load8", "load8(p: ptr, off: u32) -> u32   read a byte");
    termrow(mem, 1, "store8", "store8(p: ptr, off: u32, v: u8) -> u32   write a byte");
    termrow(mem, 1, "ptr_add", "ptr_add(p: ptr, n: u32) -> ptr   (also ptr_sub)");
    termrow(mem, 1, "slice_len", "slice_len(s: [T]) -> u32");
    termrow(mem, 1, "panic", "panic(code: u32) -> u32   does not return");
    termrow(mem, 1, "atomic", "atomic_add(p: ptr, n: u32) -> u32");
    termrow(mem, 1, "get_bits", "get_bits(v: u8, hi, lo) / set_bits(v: u8, hi, lo, x)");
    termrow(mem, 1, "inb/outb", "port I/O - only the Rust transpile path supports it, not the native one");
    termrow(mem, 1, "syscall4", "syscall4(nr: u64, a0, a1, a2) -> i64   raw syscall (rax/rdi/rsi/rdx)");
    termrow(mem, 1, "syscall6", "syscall6(nr: u64, a0..a4) -> i64");
    termrow(mem, 1, "thread_spawn", "thread_spawn(\"worker\", stack_top, arg, done) -> i64   a real thread (ELF only)");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "to print a number, copy write_dec from `loment example tour` - there is no printf.");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_types(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Types");
    termrow(mem, 1, "unsigned", "u8 u16 u32 u64");
    termrow(mem, 1, "signed", "i8 i16 i32 i64");
    termrow(mem, 1, "bool", "bool - conditions must be this");
    termrow(mem, 1, "ptr", "ptr - a raw pointer; offset with ptr_add");
    termrow(mem, 1, "str", "str - immutable, operate on it with the str_* builtins");
    termrow(mem, 1, "array", "[T; N] fixed length, the index is readable and writable");
    termrow(mem, 1, "slice", "[T] read-only / mut [T] writable, used as a parameter, pass &xs / &mut xs");
    termrow(mem, 1, "aggregate", "struct name / enum name (generic ones need the monomorphised name)");
    termrow(mem, 1, "prelude", "Option / Result - generic enums, propagate with `?`");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "casts are always `x as T`; there are no implicit conversions. Loment has no type\n  inference, so `let` must carry a type.");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_keywords(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Keywords");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "Those marked * are Loment's own, Rust does not have them.");
    colr(mem, 1);
    wstr(1, "\n\n");
    termrow(mem, 1, "structure", "module  use  fn  const  let  pub  struct  enum  trait  impl");
    termrow(mem, 1, "control", "if  else  while  for  in  match  return  break  continue");
    termrow(mem, 1, "types", "u8 u16 u32 u64 i8 i16 i32 i64 bool ptr str mut");
    termrow(mem, 1, "patterns", "if let  _  as  self");
    termrow(mem, 1, "* capability", "capability  guard  revocable  excluded");
    termrow(mem, 1, "* program/ABI", "choose  addin  comefor  byuse  extern  interrupt  register");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "capability domains are the one genuinely new thing: loment caps   .   full table: loment syntax");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_caps(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "Capability domains (capability / guard)");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "The one semantic layer Loment adds on top of Rust.");
    colr(mem, 1);
    wstr(1, "\n\n");
    termrow(mem, 1, "meaning", "guard cap(e) evaluates e to an index -> outside [lo, hi] it traps");
    termrow(mem, 1, "when", "a literal out of range is a COMPILE-time error (E4); anything else is a run-time check");
    termrow(mem, 1, "revocable", "a flag in the declaration and the domain description table");
    termrow(mem, 1, "excluded", "declares space as out of bounds; using it reports E5");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "honest limit: `guard` only constrains the INDEX to the domain, it is NOT authorisation -\n  it does not check whether the current subject holds that capability. Subject-to-capability\n  binding lives in the kernel.");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_cheat(mem: ptr, ab: ptr, argc: u32) -> u32 {
    title(mem, 1, "One-page cheat sheet");
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "Ordered by how easily they bite - the first two are the worst (item 2 is SILENT: check passes, it crashes at run time).");
    colr(mem, 1);
    wstr(1, "\n\n");
    termrow(mem, 1, "1", "match arm bodies must be BLOCKS: `E::A => { return 0; }`, not `E::A => 0,`");
    termrow(mem, 1, "2", "** a non-void function falling off its end -> SIGILL at run time: check passes, then Illegal instruction. The last statement must be a return");
    termrow(mem, 1, "3", "there is no bare `return;` - either `return <expr>;` or finish with if/else");
    termrow(mem, 1, "4", "write generic enum patterns with the monomorphised name: `Result_i64_u32::Ok(v)`");
    termrow(mem, 1, "5", "a generic fn whose T cannot be inferred reports E2 (misleading) - bind a typed `let` first");
    termrow(mem, 1, "6", "a struct literal cannot be passed as an argument directly: `let x: S = S { ... };` first");
    termrow(mem, 1, "7", "a struct literal in a condition needs parentheses");
    termrow(mem, 1, "8", "define before use inside a module, do not rely on forward references");
    termrow(mem, 1, "9", "one parse error aborts the whole check - fix one thing at a time");
    termrow(mem, 1, "10", "`==` on struct/enum: the checker allows it, the native backend rejects it - compare fields");
    termrow(mem, 1, "11", "a `const` initialiser must be an integer literal and cannot reference another const");
    termrow(mem, 1, "12", "there are no string constants: for a label write `pub fn name() -> str { return \"x\"; }`");
    termrow(mem, 1, "13", "`use` is not followed by a semicolon");
    termrow(mem, 1, "14", "string escapes are only \\n \\t \\\" \\\\ - there is no \\x / \\0");
    termrow(mem, 1, "15", "`let` must carry a type; there is no inference and no implicit conversion");
    termrow(mem, 1, "17", "**non-ASCII output garbles on a Windows console**: the PE writes bytes straight to it and Windows decodes them with the codepage (936/GBK on Chinese Windows) - print ASCII only");
    termrow(mem, 1, "16", "the `mut` in `let mut x` is an ORDINARY IDENTIFIER, not a keyword - do not write it (the syntax error points somewhere else)");
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "the whole guide: loment skill --print (a copy ships in the package too)");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// ---------------------------------------------------------------- 读源码

fn lnrow(mem: ptr, fd: u64, no: u32, p: ptr, n: u32) {
    gray(mem, fd);
    wpad_num(mem, fd, no, 5);
    wstr(fd, "  ");
    colr(mem, fd);
    wbytes(fd, p, n);
    wstr(fd, "\n");
}

fn wpad_num(mem: ptr, fd: u64, v: u32, w: u32) {
    let d: u32 = 1;
    let x: u32 = v;
    while x >= 10 {
        x = x / 10;
        d = d + 1;
    }
    let k: u32 = 0;
    while d + k < w {
        wstr(fd, " ");
        k = k + 1;
    }
    wdec(mem, fd, v);
}

// 带行号打印
fn print_numbered(mem: ptr, fd: u64, p: ptr, n: u32) {
    let i: u32 = 0;
    let ls: u32 = 0;
    let no: u32 = 1;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let len: u32 = i - ls;
            lnrow(mem, fd, no, ptr_add(p, ls), len);
            no = no + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
}

fn do_cat(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "cat needs a file name");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    print_numbered(mem, 1, p, n);
    return 0;
}

// ---------------------------------------------------------------- 边界操作 (`docs/205` R5)

/// 跳过空白与注释。**词的边界只由 token 决定**, 与两个 token 之间隔了什么无关 ——
/// 少了这一步, `f /* c */ (` 在字节扫描与真词法器那里就是两个答案。
fn skip_trivia(p: ptr, n: u32, i: u32) -> u32 {
    let k: u32 = i;
    let go: u32 = 1;
    while go == 1 && k < n {
        let c: u32 = load8(p, k);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            k = k + 1;
        } else if c == 47 && k + 1 < n && load8(p, k + 1) == 47 {
            while k < n && load8(p, k) != 10 {
                k = k + 1;
            }
        } else if c == 47 && k + 1 < n && load8(p, k + 1) == 42 {
            k = k + 2;
            while k + 1 < n && !(load8(p, k) == 42 && load8(p, k + 1) == 47) {
                k = k + 1;
            }
            if k + 1 < n {
                k = k + 2;
            } else {
                k = n;
            }
        } else {
            go = 0;
        }
    }
    return k;
}

fn eq_rng(a: ptr, b: ptr, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// (q, m) 这个名字被**调用**了几次: 该标识符之后 (跳过空白/注释) 紧跟 `(`。
///
/// 数的是**词法**事实 —— 不看它是不是真的函数、是不是真的越界。`docs/204` R5 要的
/// 就是这个: "可 grep、可计数、可审计"。**边界可见 ≠ 边界正确**, 那后半句是人的事。
fn cnt_calls(p: ptr, n: u32, q: ptr, m: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    //: 上一个 token 是不是 `fn` —— `fn NAME(` 是**声明**, 不是调用。
    //: 少了这一步, 谁定义了一个叫 `ptr_add` 的函数, 就会凭空多出一次"越界"。
    let prevfn: u32 = 0;
    while i < n {
        let ch: u32 = load8(p, i);
        if alpha(ch) {
            let s: u32 = i;
            while i < n && (alpha(load8(p, i)) || digit(load8(p, i))) {
                i = i + 1;
            }
            let l: u32 = i - s;
            if l == m && prevfn == 0 && eq_rng(ptr_add(p, s), q, m) {
                let j: u32 = skip_trivia(p, n, i);
                if j < n && load8(p, j) == 40 {
                    c = c + 1;
                }
            }
            if eq_cstr(ptr_add(p, s), l, "fn") {
                prevfn = 1;
            } else {
                prevfn = 0;
            }
        } else if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            // 空白不是 token —— 它**不打断**"上一个 token 是 fn" (`fn\nNAME(`)。
            i = i + 1;
        } else if ch == 34 {
            i = i + 1;
            while i < n && load8(p, i) != 34 {
                if load8(p, i) == 92 && i + 1 < n {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
        } else if ch == 47 && i + 1 < n && load8(p, i + 1) == 47 {
            while i < n && load8(p, i) != 10 {
                i = i + 1;
            }
        } else if ch == 47 && i + 1 < n && load8(p, i + 1) == 42 {
            i = i + 2;
            while i + 1 < n && !(load8(p, i) == 42 && load8(p, i + 1) == 47) {
                i = i + 1;
            }
            i = i + 2;
        } else {
            // 标点/数字是新 token —— 上一个 token 不再是 `fn`。
            prevfn = 0;
            i = i + 1;
        }
    }
    return c;
}

fn do_stat(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "stat needs a file name");
    }
    let path: ptr = ptr_add(mem, M_P1);
    arg_copy(mem, ab, 2, path);
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let lines: u32 = 0;
    let blanks: u32 = 0;
    let maxl: u32 = 0;
    let i: u32 = 0;
    let ls: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let len: u32 = i - ls;
            if len > 0 && load8(p, ls + len - 1) == 13 {
                len = len - 1;
            }
            lines = lines + 1;
            if len == 0 {
                blanks = blanks + 1;
            }
            if len > maxl {
                maxl = len;
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    title(mem, 1, "Source statistics");
    kvb(mem, 1, "file", path);
    kv(mem, 1, "bytes", n);
    kv(mem, 1, "lines", lines);
    kv(mem, 1, "blank", blanks);
    kv(mem, 1, "non-blank", lines - blanks);
    kv(mem, 1, "longest line", maxl);

    // ---- 边界操作 (`docs/205` R5) -------------------------------------------------
    // "越过语言保证的每一步, 都在**词法上**显式、且可计数"。`unsafe` 不是关键字
    // (R5 的裁决是"抄意图, 形态要定"), 所以这条边界由下面这几族**名字**划出来 ——
    // 于是它可 grep、可计数、可审计: 一个工程可以规定"裸指针只许出现在这三个文件"。
    // 数的全是**写出来了没有**, 不是"危不危险" —— 后者要类型, 那是编译器的事。
    let n_sys: u32 = cnt_calls(p, n, str_ptr("syscall4"), str_len("syscall4"))
                   + cnt_calls(p, n, str_ptr("syscall6"), str_len("syscall6"))
                   + cnt_calls(p, n, str_ptr("syscall7"), str_len("syscall7"));
    let n_ptr: u32 = cnt_calls(p, n, str_ptr("ptr_add"), str_len("ptr_add"))
                   + cnt_calls(p, n, str_ptr("ptr_sub"), str_len("ptr_sub"))
                   + cnt_calls(p, n, str_ptr("str_ptr"), str_len("str_ptr"));
    // 第三族不行: `extern fn` 的名字是**本单元自己声明的** (`docs/173`), 没有固定清单,
    // 所以一边数声明、一边对每个声明过的名字数调用点。声明处那个 `(` 也被数进去过, 减掉。
    let n_extd: u32 = 0;
    let n_extc: u32 = 0;
    let i2: u32 = 0;
    while i2 < n {
        let ch: u32 = load8(p, i2);
        if alpha(ch) {
            let s: u32 = i2;
            while i2 < n && (alpha(load8(p, i2)) || digit(load8(p, i2))) {
                i2 = i2 + 1;
            }
            if eq_cstr(ptr_add(p, s), i2 - s, "extern") {
                let k: u32 = skip_trivia(p, n, i2);
                if k + 2 <= n && starts_with(ptr_add(p, k), n - k, "fn")
                        && (k + 2 >= n || (!alpha(load8(p, k + 2)) && !digit(load8(p, k + 2)))) {
                    let q: u32 = skip_trivia(p, n, k + 2);
                    let nl: u32 = 0;
                    while q + nl < n && (alpha(load8(p, q + nl)) || digit(load8(p, q + nl))) {
                        nl = nl + 1;
                    }
                    if nl > 0 {
                        n_extd = n_extd + 1;
                        // `cnt_calls` 已经把声明处 (`extern fn NAME(`) 排除掉了, 不必再减一。
                        n_extc = n_extc + cnt_calls(p, n, ptr_add(p, q), nl);
                    }
                }
            }
        } else if ch == 34 {
            i2 = i2 + 1;
            while i2 < n && load8(p, i2) != 34 {
                if load8(p, i2) == 92 && i2 + 1 < n {
                    i2 = i2 + 1;
                }
                i2 = i2 + 1;
            }
            i2 = i2 + 1;
        } else if ch == 47 && i2 + 1 < n && load8(p, i2 + 1) == 47 {
            while i2 < n && load8(p, i2) != 10 {
                i2 = i2 + 1;
            }
        } else if ch == 47 && i2 + 1 < n && load8(p, i2 + 1) == 42 {
            i2 = i2 + 2;
            while i2 + 1 < n && !(load8(p, i2) == 42 && load8(p, i2 + 1) == 47) {
                i2 = i2 + 1;
            }
            i2 = i2 + 2;
        } else {
            i2 = i2 + 1;
        }
    }
    title(mem, 1, "Boundary operations");
    kv(mem, 1, "extern fn declared", n_extd);
    kv(mem, 1, "extern call sites", n_extc);
    kv(mem, 1, "syscalls", n_sys);
    kv(mem, 1, "raw ptr transforms", n_ptr);
    kv(mem, 1, "total sites", n_extc + n_sys + n_ptr);
    return 0;
}

fn do_count(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "count needs a file name");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let nf: u32 = 0;
    let ns: u32 = 0;
    let ne: u32 = 0;
    let nt: u32 = 0;
    let nc: u32 = 0;
    let ng: u32 = 0;
    let i: u32 = 0;
    let ls: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let line: ptr = ptr_add(p, ls);
            let len: u32 = i - ls;
            if len > 0 && load8(line, len - 1) == 13 {
                len = len - 1;
            }
            // 跳到首个非空白
            let k: u32 = 0;
            while k < len && (load8(line, k) == 32 || load8(line, k) == 9) {
                k = k + 1;
            }
            let s: ptr = ptr_add(line, k);
            let sl: u32 = len - k;
            if k < len {
                if starts_with(s, sl, "pub ") {
                    if starts_with(ptr_add(s, 4), sl - 4, "fn ") {
                        nf = nf + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "struct ") {
                        ns = ns + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "enum ") {
                        ne = ne + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "trait ") {
                        nt = nt + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "const ") {
                        nc = nc + 1;
                    }
                    if starts_with(ptr_add(s, 4), sl - 4, "capability ") {
                        ng = ng + 1;
                    }
                } else {
                    if starts_with(s, sl, "fn ") {
                        nf = nf + 1;
                    }
                    if starts_with(s, sl, "struct ") {
                        ns = ns + 1;
                    }
                    if starts_with(s, sl, "enum ") {
                        ne = ne + 1;
                    }
                    if starts_with(s, sl, "trait ") {
                        nt = nt + 1;
                    }
                    if starts_with(s, sl, "const ") {
                        nc = nc + 1;
                    }
                    if starts_with(s, sl, "capability ") {
                        ng = ng + 1;
                    }
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    title(mem, 1, "Declaration counts");
    kv(mem, 1, "fn", nf);
    kv(mem, 1, "struct", ns);
    kv(mem, 1, "enum", ne);
    kv(mem, 1, "trait", nt);
    kv(mem, 1, "const", nc);
    kv(mem, 1, "capability", ng);
    return 0;
}

fn do_fns(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "fns needs a file name");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    title(mem, 1, "Function signatures");
    let i: u32 = 0;
    let ls: u32 = 0;
    let no: u32 = 1;
    let cnt: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let line: ptr = ptr_add(p, ls);
            let len: u32 = i - ls;
            if len > 0 && load8(line, len - 1) == 13 {
                len = len - 1;
            }
            let k: u32 = 0;
            while k < len && (load8(line, k) == 32 || load8(line, k) == 9) {
                k = k + 1;
            }
            let s: ptr = ptr_add(line, k);
            let sl: u32 = len - k;
            let isfn: u32 = 0;
            let off: u32 = 0;
            if starts_with(s, sl, "fn ") {
                isfn = 1;
            }
            if starts_with(s, sl, "pub fn ") {
                isfn = 1;
                off = 4;
            }
            if isfn == 1 {
                // 打到 `{` 为止
                let e: u32 = off;
                while e < sl && load8(s, e) != 123 {
                    e = e + 1;
                }
                let m: u32 = e;
                while m > off && load8(s, m - 1) == 32 {
                    m = m - 1;
                }
                gray(mem, 1);
                wpad_num(mem, 1, no, 5);
                wstr(1, "  ");
                colr(mem, 1);
                wbytes(1, ptr_add(s, off), m - off);
                wstr(1, "\n");
                cnt = cnt + 1;
            }
            no = no + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
    wstr(1, "\n  ");
    gray(mem, 1);
    wdec(mem, 1, cnt);
    wstr(1, " function(s)");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_tokens(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "tokens needs a file name");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let nid: u32 = 0;
    let nkw: u32 = 0;
    let nnum: u32 = 0;
    let nstr: u32 = 0;
    let ncom: u32 = 0;
    let nop: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i);
        if c == 47 && i + 1 < n && load8(p, i + 1) == 47 {
            while i < n && load8(p, i) != 10 {
                i = i + 1;
            }
            ncom = ncom + 1;
        } else if c == 47 && i + 1 < n && load8(p, i + 1) == 42 {
            i = i + 2;
            while i + 1 < n && !(load8(p, i) == 42 && load8(p, i + 1) == 47) {
                i = i + 1;
            }
            i = i + 2;
            ncom = ncom + 1;
        } else if c == 34 {
            i = i + 1;
            while i < n && load8(p, i) != 34 {
                if load8(p, i) == 92 && i + 1 < n {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
            nstr = nstr + 1;
        } else if alpha(c) {
            let s: u32 = i;
            while i < n && (alpha(load8(p, i)) || digit(load8(p, i))) {
                i = i + 1;
            }
            if is_kw(p, s, i - s) {
                nkw = nkw + 1;
            } else {
                nid = nid + 1;
            }
        } else if digit(c) {
            while i < n && digit(load8(p, i)) {
                i = i + 1;
            }
            nnum = nnum + 1;
        } else if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1;
        } else {
            nop = nop + 1;
            i = i + 1;
        }
    }
    title(mem, 1, "Token histogram");
    kv(mem, 1, "identifiers", nid);
    kv(mem, 1, "keywords", nkw);
    kv(mem, 1, "numbers", nnum);
    kv(mem, 1, "strings", nstr);
    kv(mem, 1, "comments", ncom);
    kv(mem, 1, "operators/punct", nop);
    return 0;
}

fn is_kw(p: ptr, off: u32, n: u32) -> bool {
    let s: ptr = ptr_add(p, off);
    if eq_cstr(s, n, "module") || eq_cstr(s, n, "use") || eq_cstr(s, n, "fn") {
        return true;
    }
    if eq_cstr(s, n, "const") || eq_cstr(s, n, "let") || eq_cstr(s, n, "pub") {
        return true;
    }
    if eq_cstr(s, n, "struct") || eq_cstr(s, n, "enum") || eq_cstr(s, n, "trait") {
        return true;
    }
    if eq_cstr(s, n, "impl") || eq_cstr(s, n, "if") || eq_cstr(s, n, "else") {
        return true;
    }
    if eq_cstr(s, n, "while") || eq_cstr(s, n, "for") || eq_cstr(s, n, "in") {
        return true;
    }
    if eq_cstr(s, n, "match") || eq_cstr(s, n, "return") || eq_cstr(s, n, "break") {
        return true;
    }
    if eq_cstr(s, n, "continue") || eq_cstr(s, n, "as") || eq_cstr(s, n, "mut") {
        return true;
    }
    if eq_cstr(s, n, "capability") || eq_cstr(s, n, "guard") || eq_cstr(s, n, "self") {
        return true;
    }
    if eq_cstr(s, n, "revocable") || eq_cstr(s, n, "excluded") {
        return true;
    }
    return false;
}

fn do_grep(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 4 {
        return err_usage(mem, "grep takes two arguments: <PAT> <FILE>");
    }
    let pat: ptr = ptr_add(mem, M_P2);
    let pn: u32 = arg_copy(mem, ab, 2, pat);
    if pn == NOTFOUND || pn == 0 {
        return err_usage(mem, "the grep pattern cannot be empty");
    }
    let n: u32 = read_arg(mem, ab, 3);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let hits: u32 = scan_hits(mem, p, n, pat, 1);
    if hits == 0 {
        return 1;
    }
    return 0;
}

// needle 由调用方给出 (NUL 结尾)
fn scan_hits(mem: ptr, p: ptr, n: u32, pat: ptr, show: u32) -> u32 {
    let pl: u32 = strlen_n(pat);
    let i: u32 = 0;
    let ls: u32 = 0;
    let no: u32 = 1;
    let hits: u32 = 0;
    while i <= n {
        let eol: u32 = 0;
        if i == n {
            // 结尾的空段不算一行 —— 文件以换行结尾时, 别多报一行出来
            if ls < n {
                eol = 1;
            }
        } else if load8(p, i) == 10 {
            eol = 1;
        }
        if eol == 1 {
            let line: ptr = ptr_add(p, ls);
            let len: u32 = i - ls;
            if len > 0 && load8(line, len - 1) == 13 {
                len = len - 1;
            }
            if find_bytes(line, len, pat, pl) != NOTFOUND {
                hits = hits + 1;
                if show == 1 {
                    yellow(mem, 1);
                    wpad_num(mem, 1, no, 5);
                    colr(mem, 1);
                    wstr(1, ": ");
                    wbytes(1, line, len);
                    wstr(1, "\n");
                }
            }
            no = no + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
    return hits;
}

fn find_bytes(p: ptr, n: u32, q: ptr, m: u32) -> u32 {
    if m == 0 || n < m {
        return NOTFOUND;
    }
    let i: u32 = 0;
    while i + m <= n {
        let k: u32 = 0;
        let eq: u32 = 1;
        while k < m {
            if load8(p, i + k) != load8(q, k) {
                eq = 0;
            }
            k = k + 1;
        }
        if eq == 1 {
            return i;
        }
        i = i + 1;
    }
    return NOTFOUND;
}

// ---------------------------------------------------------------- 工程

fn do_todo(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "todo needs a file name");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let p: ptr = ptr_add(mem, M_FILE);
    let a: ptr = ptr_add(mem, M_P1);
    put(a, "TODO");
    let hits: u32 = scan_hits(mem, p, n, a, 1);
    put(a, "FIXME");
    let h2: u32 = scan_hits(mem, p, n, a, 1);
    put(a, "XXX");
    let h3: u32 = scan_hits(mem, p, n, a, 1);
    wstr(1, "\n  ");
    gray(mem, 1);
    wdec(mem, 1, hits + h2 + h3);
    wstr(1, " found");
    colr(mem, 1);
    wstr(1, "\n\n");
    if hits + h2 + h3 == 0 {
        return 1;
    }
    return 0;
}

fn do_hash(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "hash needs a file name");
    }
    let n: u32 = read_arg(mem, ab, 2);
    if n == NOTFOUND {
        return 1;
    }
    let st: ptr = ptr_add(mem, M_SHA);
    let dg: ptr = ptr_add(mem, M_DIG);
    sha_init(st);
    sha_update(st, ptr_add(mem, M_FILE), n);
    sha_final(st, dg);
    let out: ptr = ptr_add(mem, M_OUT);
    hex_dig(dg, out);
    write_all(1, out, 64);
    wstr(1, "\n");
    return 0;
}

fn do_new(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "new needs a name");
    }
    let nm: ptr = ptr_add(mem, M_P1);
    let nn: u32 = arg_copy(mem, ab, 2, nm);
    if nn == NOTFOUND || nn == 0 {
        return err_usage(mem, "the name cannot be empty");
    }
    let path: ptr = ptr_add(mem, M_P2);
    put_n(path, nm, nn);
    put(ptr_add(path, nn), ".lomt");
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(path, stb) != NOTFOUND {
        return err_path(mem, "already exists, not overwriting: ", path);
    }
    let fd: i64 = open_wo(path);
    if fd < 0 {
        return err_path(mem, "cannot write ", path);
    }
    wfd(fd, "module ");
    wfdp(fd, nm);
    wfd(fd, "\n\nfn _start() {\n    let s: str = \"hello from Loment\\n\";\n");
    wfd(fd, "    syscall4(1, 1, str_ptr(s) as u64, str_len(s) as u64);\n");
    wfd(fd, "    syscall4(60, 0, 0, 0);\n}\n");
    close_fd(fd);
    green(mem, 1);
    wstr(1, "  wrote ");
    colr(mem, 1);
    wbuf(1, path);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "run it:  loment run ");
    wbuf(1, path);
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

// 写一个 NUL 结尾的字节范围到 fd
fn wfd(fd: i64, s: str) {
    write_all(fd as u64, str_ptr(s), str_len(s) as u64);
}

fn wfdp(fd: i64, p: ptr) {
    write_all(fd as u64, p, strlen_n(p) as u64);
}

fn do_examples(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let dir: ptr = ptr_add(mem, M_P2);
    share_dir(mem, ab, dir);
    let dn: u32 = strlen_n(dir);
    put(ptr_add(dir, dn), "examples/");
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(dir, stb) != S_IFDIR {
        err_path(mem, "no examples directory in this package: ", dir);
        return 1;
    }
    title(mem, 1, "Examples");
    kvb(mem, 1, "location", dir);
    wstr(1, "\n");
    ls_dir(mem, 1, dir, 0, 0);
    wstr(1, "\n  ");
    gray(mem, 1);
    wstr(1, "try one: loment example tour");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn do_example(mem: ptr, ab: ptr, argc: u32) -> u32 {
    if argc < 3 {
        return err_usage(mem, "example needs a name, e.g. tour");
    }
    let dir: ptr = ptr_add(mem, M_P2);
    share_dir(mem, ab, dir);
    let dn: u32 = strlen_n(dir);
    put(ptr_add(dir, dn), "examples/");
    let d2: u32 = strlen_n(dir);
    let nm: ptr = ptr_add(mem, M_P1);
    let nn: u32 = arg_copy(mem, ab, 2, nm);
    put_n(ptr_add(dir, d2), nm, nn);
    put(ptr_add(dir, d2 + nn), ".lomt");
    let n: u32 = slurp(dir, ptr_add(mem, M_FILE), FILE_CAP);
    if n == NOTFOUND {
        err_path(mem, "no such example: ", dir);
        return 1;
    }
    write_all(1, ptr_add(mem, M_FILE), n as u64);
    return 0;
}

fn do_ls(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let dir: ptr = ptr_add(mem, M_P1);
    if argc >= 3 {
        arg_copy(mem, ab, 2, dir);
    } else {
        put(dir, "./");
    }
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(dir, stb) == NOTFOUND {
        return err_path(mem, "cannot open ", dir);
    }
    ls_dir(mem, 1, dir, 0, 0);
    return 0;
}

fn do_tree(mem: ptr, ab: ptr, argc: u32) -> u32 {
    let dir: ptr = ptr_add(mem, M_P1);
    if argc >= 3 {
        arg_copy(mem, ab, 2, dir);
    } else {
        put(dir, "./");
    }
    let stb: ptr = ptr_add(mem, M_STB);
    if stat_mode(dir, stb) == NOTFOUND {
        return err_path(mem, "cannot open ", dir);
    }
    cyan(mem, 1);
    wbuf(1, dir);
    colr(mem, 1);
    wstr(1, "\n");
    ls_dir(mem, 1, dir, 1, 1);
    return 0;
}

// ---------------------------------------------------------------- 分发

// 把全局开关 (--no-color / -C) 从 argv 里**紧凑掉**, 就地左移。这样后面所有按下标取参数的
// 逻辑都不用改 —— 否则 `loment --no-color cat f` 会把 f 当成 argv[2] 的下一个。
fn strip_flags(mem: ptr, ab: ptr) -> u32 {
    let lend: u32 = load32(mem, M_CELL + C_ARGLEN);
    let src: u32 = 0;
    let dst: u32 = 0;
    let argc: u32 = 0;
    while src < lend {
        let e: u32 = src;
        while e < lend && load8(ab, e) != 0 {
            e = e + 1;
        }
        let n: u32 = e - src;
        let drop: u32 = 0;
        if n == 10 && eq_cstr(ptr_add(ab, src), n, "--no-color") {
            drop = 1;
        }
        if n == 2 && eq_cstr(ptr_add(ab, src), n, "-C") {
            drop = 1;
        }
        if drop == 0 {
            let k: u32 = 0;
            while k < n {
                store8(ab, dst + k, load8(ab, src + k) as u8);
                k = k + 1;
            }
            store8(ab, dst + n, 0 as u8);
            dst = dst + n + 1;
            argc = argc + 1;
        }
        src = e + 1;
    }
    store8(ab, dst, 0 as u8);
    store32(mem, M_CELL + C_ARGLEN, dst);
    return argc;
}

fn dispatch(mem: ptr, ab: ptr, argc: u32) -> u32 {
    // 全局开关: --no-color / -C (位置任意)
    let i: u32 = 1;
    while i < argc {
        let o: u32 = arg_at(mem, ab, i);
        if o != NOTFOUND {
            let p: ptr = ptr_add(ab, o);
            let pn: u32 = strlen_n(p);
            if eq_cstr(p, pn, "--no-color") || eq_cstr(p, pn, "-C") {
                store32(mem, M_CELL + C_COLOR, 0);
            }
        }
        i = i + 1;
    }
    let nac: u32 = strip_flags(mem, ab);
    if nac < 2 {
        return do_help(mem, ab, nac);
    }
    let co: u32 = arg_at(mem, ab, 1);
    let cmd: ptr = ptr_add(ab, co);
    let n: u32 = strlen_n(cmd);

    if eq_cstr(cmd, n, "help") {
        return do_help(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "commands") {
        return do_commands(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "version") {
        return do_version(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "about") {
        return do_about(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "tools") {
        return do_tools(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "where") {
        return do_where(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "env") {
        return do_env(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "doctor") {
        return do_doctor(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "color") {
        return do_color(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "codes") {
        return do_codes(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "explain") {
        return do_explain(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "syntax") {
        return do_syntax(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "builtins") {
        return do_builtins(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "types") {
        return do_types(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "keywords") {
        return do_keywords(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "caps") {
        return do_caps(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "cheat") {
        return do_cheat(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "cat") {
        return do_cat(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "stat") {
        return do_stat(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "count") {
        return do_count(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "fns") {
        return do_fns(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "tokens") {
        return do_tokens(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "grep") {
        return do_grep(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "todo") {
        return do_todo(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "hash") {
        return do_hash(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "new") {
        return do_new(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "examples") {
        return do_examples(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "example") {
        return do_example(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "ls") {
        return do_ls(mem, ab, nac);
    }
    if eq_cstr(cmd, n, "tree") {
        return do_tree(mem, ab, nac);
    }
    // 这些由启动器直接转发给对应工具, 到不了这里; 但手工调用 loment-cli 时要给个交代
    if eq_cstr(cmd, n, "ir") || eq_cstr(cmd, n, "check") || eq_cstr(cmd, n, "build") {
        return delegate_note(mem, cmd, n, "loment-driver");
    }
    if eq_cstr(cmd, n, "run") {
        return delegate_note(mem, cmd, n, "loment-driver + loment-lomelf");
    }
    if eq_cstr(cmd, n, "fmt") {
        return delegate_note(mem, cmd, n, "loment-fmt");
    }
    if eq_cstr(cmd, n, "doc") {
        return delegate_note(mem, cmd, n, "loment-doc");
    }
    if eq_cstr(cmd, n, "lsp") {
        return delegate_note(mem, cmd, n, "loment-lsp");
    }
    if eq_cstr(cmd, n, "skill") {
        return delegate_note(mem, cmd, n, "share/loment/skill/SKILL.md");
    }

    red(mem, 2);
    wstr(2, "loment: ");
    colr(mem, 2);
    wstr(2, "unknown command ");
    bold(mem, 2);
    wbytes(2, cmd, n);
    colr(mem, 2);
    wstr(2, "\n");
    gray(mem, 2);
    wstr(2, "  try `loment help` - or `loment commands` for the names\n");
    colr(mem, 2);
    return 2;
}

fn delegate_note(mem: ptr, cmd: ptr, n: u32, who: str) -> u32 {
    wstr(1, "  ");
    gray(mem, 1);
    wstr(1, "loment ");
    wbytes(1, cmd, n);
    wstr(1, " is forwarded by the launcher straight to ");
    wstr(1, who);
    wstr(1, ", it does not go through loment-cli.");
    wstr(1, "\n  Just run loment ");
    wbytes(1, cmd, n);
    wstr(1, " ...");
    colr(mem, 1);
    wstr(1, "\n\n");
    return 0;
}

fn _start() -> u32 {
    let memv: u64 = sys_alloc(ARENA_CAP);
    if memv == 0 {
        return finish(1);
    }
    let mem: ptr = memv as ptr;
    store32(mem, M_CELL + C_COLOR, 1);
    store32(mem, M_CELL + C_ERR, 0);
    let ab: ptr = ptr_add(mem, M_ARGV);
    let cpath: ptr = ptr_add(mem, M_P3);
    put(cpath, "/proc/self/cmdline");
    let fd: i64 = open_ro(cpath);
    let rn: u64 = 0;
    if fd >= 0 {
        rn = read_all(fd as u64, ab, (ARGV_CAP - 1) as u64);
        close_fd(fd);
    }
    store8(ab, rn as u32, 0 as u8);
    store32(mem, M_CELL + C_ARGLEN, rn as u32);
    let argc: u32 = split_argv(mem, ab);
    let rc: u32 = dispatch(mem, ab, argc);
    return finish(rc as u64);
}

