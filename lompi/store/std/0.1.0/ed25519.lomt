    return 1;
}

// ---------------------------------------------------------------- 点运算

/// p = p + q（扩展坐标，四个域元素一组）。
fn eq_add_points(x: ptr, p: u32, q: u32) -> u32 {
    eq_sub(x, ED_G1, p + 128, p);
    eq_sub(x, ED_G2, q + 128, q);
    eq_mul(x, ED_G1, ED_G1, ED_G2);
    eq_add(x, ED_G2, p, p + 128);
    eq_add(x, ED_G3, q, q + 128);
    eq_mul(x, ED_G2, ED_G2, ED_G3);
    eq_mul(x, ED_G3, p + 384, q + 384);
    eq_mul(x, ED_G3, ED_G3, ED_CD2);
    eq_mul(x, ED_G4, p + 256, q + 256);
    eq_add(x, ED_G4, ED_G4, ED_G4);
    eq_sub(x, ED_G5, ED_G2, ED_G1);
    eq_sub(x, ED_G6, ED_G4, ED_G3);
    eq_add(x, ED_G7, ED_G4, ED_G3);
    eq_add(x, ED_G8, ED_G2, ED_G1);
    eq_mul(x, p, ED_G5, ED_G6);
    eq_mul(x, p + 128, ED_G8, ED_G7);
    eq_mul(x, p + 256, ED_G7, ED_G6);
    eq_mul(x, p + 384, ED_G5, ED_G8);
    return 1;
}

fn eq_cswap(x: ptr, p: u32, q: u32, b: u32) -> u32 {
    eq_sel(x, p, q, b);
    eq_sel(x, p + 128, q + 128, b);
    eq_sel(x, p + 256, q + 256, b);
    eq_sel(x, p + 384, q + 384, b);
    return 1;
}

fn eq_scalarmult(x: ptr, p: u32, q: u32, s: ptr) -> u32 {
    eq_zero(x, p);
    eq_one(x, p + 128);
    eq_one(x, p + 256);
    eq_zero(x, p + 384);
    let i: i64 = 255 as i64;
    while i >= 0 {
        let by: u32 = (i >> 3) as u32;
        let sh: u32 = (i & (7 as i64)) as u32;
        let b: u32 = ((load8(s, by) >> sh) & 1) as u32;
        eq_cswap(x, p, q, b);
        eq_add_points(x, q, p);
        eq_add_points(x, p, p);
        eq_cswap(x, p, q, b);
        i = i - 1;
    }
    return 1;
}

fn eq_scalarbase(x: ptr, p: u32, s: ptr) -> u32 {
    eq_copy(x, ED_Q, ED_CX);
    eq_copy(x, ED_Q + 128, ED_CY);
    eq_one(x, ED_Q + 256);
    eq_mul(x, ED_Q + 384, ED_CX, ED_CY);
    return eq_scalarmult(x, p, ED_Q, s);
}

fn eq_pack_point(x: ptr, out: ptr, oo: u32, p: u32) -> u32 {
    eq_inv(x, ED_G7, p + 256);
    eq_mul(x, ED_G6, p, ED_G7);
    eq_mul(x, ED_G5, p + 128, ED_G7);
    eq_pack(x, out, oo, ED_G5);
    if eq_parity(x, ED_G6) == 1 {
        store8(out, oo + 31, (load8(out, oo + 31) ^ 128) as u8);
    }
    return 1;
}

/// 解压公钥并取负（TweetNaCl 的 unpackneg）。0 = 成功。
fn eq_unpackneg(x: ptr, r: u32, pk: ptr) -> u32 {
    eq_one(x, r + 256);
    eq_unpack(x, r + 128, pk);
    eq_sq(x, ED_NUM, r + 128);
    eq_mul(x, ED_DEN, ED_NUM, ED_CD);
    eq_sub(x, ED_NUM, ED_NUM, r + 256);
    eq_add(x, ED_DEN, r + 256, ED_DEN);
    eq_sq(x, ED_DEN2, ED_DEN);
    eq_sq(x, ED_DEN4, ED_DEN2);
    eq_mul(x, ED_DEN6, ED_DEN4, ED_DEN2);
    eq_mul(x, ED_T, ED_DEN6, ED_NUM);
    eq_mul(x, ED_T, ED_T, ED_DEN);
    eq_pow2523(x, ED_T, ED_T);
    eq_mul(x, ED_T, ED_T, ED_NUM);
    eq_mul(x, ED_T, ED_T, ED_DEN);
    eq_mul(x, ED_T, ED_T, ED_DEN);
    eq_mul(x, r, ED_T, ED_DEN);
    eq_sq(x, ED_CHK, r);
    eq_mul(x, ED_CHK, ED_CHK, ED_DEN);
    if !eq_eq25519(x, ED_CHK, ED_NUM) {
        eq_mul(x, r, r, ED_CI);
    }
    eq_sq(x, ED_CHK, r);
    eq_mul(x, ED_CHK, ED_CHK, ED_DEN);
    if !eq_eq25519(x, ED_CHK, ED_NUM) {
        return 1;
    }
    let sign_bit: u32 = ((load8(pk, 31) >> 7) & 1) as u32;
    if eq_parity(x, r) == sign_bit {
        eq_neg(x, r, r);
    }
    eq_mul(x, r + 384, r, r + 128);
    return 0;
}

// ---------------------------------------------------------------- 标量模 L

fn eq_l(i: u32) -> i64 {
    if i == 0 { return 237 as i64; }
    if i == 1 { return 211 as i64; }
    if i == 2 { return 245 as i64; }
    if i == 3 { return 92 as i64; }
    if i == 4 { return 26 as i64; }
    if i == 5 { return 99 as i64; }
    if i == 6 { return 18 as i64; }
    if i == 7 { return 88 as i64; }
    if i == 8 { return 214 as i64; }
    if i == 9 { return 156 as i64; }
    if i == 10 { return 247 as i64; }
    if i == 11 { return 162 as i64; }
    if i == 12 { return 222 as i64; }
    if i == 13 { return 249 as i64; }
    if i == 14 { return 222 as i64; }
    if i == 15 { return 20 as i64; }
    if i == 31 { return 16 as i64; }
    return 0 as i64;
}

/// x[0..64]（i64）模 L，结果 32 字节写到 out。
fn eq_modl(x: ptr, out: ptr) -> u32 {
    let i: i64 = 63 as i64;
    while i >= 32 {
        let carry: i64 = 0;
        let base: i64 = i - 32;
        let j: i64 = i - 32;
        while j < i - 12 {
            let idx: u32 = (j * 8) as u32;
            let xi: i64 = mem_load64(x, ED_X + (i * 8) as u32) as i64;
            let v: i64 = (mem_load64(x, ED_X + idx) as i64) + carry
                - (16 as i64) * xi * eq_l((j - base) as u32);
            mem_store64(x, ED_X + idx, v as u64);
            carry = (v + 128) >> 8;
            mem_store64(x, ED_X + idx, (v - carry * 256) as u64);
            j = j + 1;
        }
        let idx2: u32 = (j * 8) as u32;
        mem_store64(x, ED_X + idx2,
                    ((mem_load64(x, ED_X + idx2) as i64) + carry) as u64);
        mem_store64(x, ED_X + (i * 8) as u32, 0 as u64);
        i = i - 1;
    }
    let c2: i64 = 0;
    let j2: i64 = 0;
    while j2 < 32 {
        let idx3: u32 = (j2 * 8) as u32;
        let x31: i64 = mem_load64(x, ED_X + 248) as i64;
        let v2: i64 = (mem_load64(x, ED_X + idx3) as i64) + c2
            - ((x31 >> 4) * eq_l(j2 as u32));
        c2 = v2 >> 8;
        mem_store64(x, ED_X + idx3, (v2 - c2 * 256) as u64);
        j2 = j2 + 1;
    }
    let j3: i64 = 0;
    while j3 < 32 {
        let idx4: u32 = (j3 * 8) as u32;
        mem_store64(x, ED_X + idx4,
                    ((mem_load64(x, ED_X + idx4) as i64) - c2 * eq_l(j3 as u32)) as u64);
        j3 = j3 + 1;
    }
    let i2: i64 = 0;
    while i2 < 32 {
        let idx5: u32 = (i2 * 8) as u32;
        let lo: i64 = mem_load64(x, ED_X + idx5) as i64;
        let next: i64 = mem_load64(x, ED_X + idx5 + 8) as i64;
        mem_store64(x, ED_X + idx5 + 8, (next + (lo >> 8)) as u64);
        store8(out, i2 as u32, (lo & (255 as i64)) as u8);
        i2 = i2 + 1;
    }
    return 1;
}

/// 把 64 字节归约成 32 字节标量（就地写到同一缓冲）。
fn eq_reduce(x: ptr, buf: ptr) -> u32 {
    let i: u32 = 0;
    while i < 64 {
        mem_store64(x, ED_X + i * 8, (load8(buf, i) as u64));
        i = i + 1;
    }
    return eq_modl(x, buf);
}

// ---------------------------------------------------------------- 公开面

/// 从 32 字节 seed 导出 32 字节公钥。
pub fn ed_public(seed: ptr, pk: ptr, sc: ptr) -> u32 {
    let h: ptr = alloc(64);
    let ctx: ptr = alloc(852);
    sha512(seed, 0, 32, h, ctx);
    store8(h, 0, (load8(h, 0) & 248) as u8);
    store8(h, 31, ((load8(h, 31) & 127) | 64) as u8);
    eq_consts(sc);
    eq_scalarbase(sc, ED_P, h);
    return eq_pack_point(sc, pk, 0, ED_P);
}

/// 签名：sig = R || S（64 字节）。
pub fn ed_sign(seed: ptr, msg: ptr, n: u32, sig: ptr, sc: ptr) -> u32 {
    let pk: ptr = alloc(32);
    let d: ptr = alloc(64);
    let r: ptr = alloc(64);
    let h: ptr = alloc(64);
    let s32: ptr = alloc(32);
    let ctx: ptr = alloc(852);
    eq_consts(sc);
    ed_public(seed, pk, sc);
    sha512(seed, 0, 32, d, ctx);
    store8(d, 0, (load8(d, 0) & 248) as u8);
    store8(d, 31, ((load8(d, 31) & 127) | 64) as u8);

    sha512_init(ctx);
    sha512_update(ctx, d, 32, 32);
    sha512_update(ctx, msg, 0, n);
    sha512_final(ctx, r);
    eq_reduce(sc, r);

    eq_scalarbase(sc, ED_P, r);
    eq_pack_point(sc, sig, 0, ED_P);

    sha512_init(ctx);
    sha512_update(ctx, sig, 0, 32);
    sha512_update(ctx, pk, 0, 32);
    sha512_update(ctx, msg, 0, n);
    sha512_final(ctx, h);
    eq_reduce(sc, h);

    let k: u32 = 0;
    while k < 64 {
        mem_store64(sc, ED_X + k * 8, 0 as u64);
        k = k + 1;
    }
    k = 0;
    while k < 32 {
        mem_store64(sc, ED_X + k * 8, load8(r, k) as u64);
        k = k + 1;
    }
    k = 0;
    while k < 32 {
        let hk: i64 = load8(h, k) as i64;
        let j: u32 = 0;
        while j < 32 {
            let didx: u32 = ED_X + (k + j) * 8;
            let dk: i64 = load8(d, j) as i64;
            mem_store64(sc, didx, ((mem_load64(sc, didx) as i64) + hk * dk) as u64);
            j = j + 1;
        }
        k = k + 1;
    }
    eq_modl(sc, s32);
    k = 0;
    while k < 32 {
        store8(sig, 32 + k, load8(s32, k) as u8);
        k = k + 1;
    }
    return 1;
}

/// 验签：0 = 有效，1 = 无效。
pub fn ed_verify(pk: ptr, msg: ptr, n: u32, sig: ptr, sc: ptr) -> u32 {
    let h: ptr = alloc(64);
    let s32: ptr = alloc(32);
    let t32: ptr = alloc(32);
    let ctx: ptr = alloc(852);
    eq_consts(sc);
    if eq_unpackneg(sc, ED_Q, pk) != 0 {
        return 1;
    }
    sha512_init(ctx);
    sha512_update(ctx, sig, 0, 32);
    sha512_update(ctx, pk, 0, 32);
    sha512_update(ctx, msg, 0, n);
    sha512_final(ctx, h);
    eq_reduce(sc, h);

    eq_scalarmult(sc, ED_P, ED_Q, h);
    let i: u32 = 0;
    while i < 32 {
        store8(s32, i, load8(sig, 32 + i) as u8);
        i = i + 1;
    }
    eq_scalarbase(sc, ED_P2, s32);
    eq_add_points(sc, ED_P, ED_P2);
    eq_pack_point(sc, t32, 0, ED_P);
    i = 0;
    while i < 32 {
        if load8(t32, i) != load8(sig, i) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 自检

fn eq_hex_nib(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return 0;
}

fn eq_hex_in(out: ptr, s: str) -> u32 {
    let n: u32 = str_len(s) / 2;
    let i: u32 = 0;
    while i < n {
        let hi: u32 = eq_hex_nib(str_byte(s, 2 * i) as u32);
        let lo: u32 = eq_hex_nib(str_byte(s, 2 * i + 1) as u32);
        store8(out, i, (hi * 16 + lo) as u8);
        i = i + 1;
    }
    return n;
}

fn eq_eq_bytes(a: ptr, b: ptr, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_ed25519_public_key() -> bool {
    let sc: ptr = alloc(ed_scratch());
    let seed: ptr = alloc(32);
    let want: ptr = alloc(32);
    let got: ptr = alloc(32);
    eq_hex_in(seed, "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60");
    eq_hex_in(want, "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");
    ed_public(seed, got, sc);
    return eq_eq_bytes(got, want, 32);
}

fn test_ed25519_sign_vector() -> bool {
    // RFC 8032 §7.1 test 2: message 0x72.
    let sc: ptr = alloc(ed_scratch());
    let seed: ptr = alloc(32);
    let msg: ptr = alloc(1);
    let want: ptr = alloc(64);
    let got: ptr = alloc(64);
    eq_hex_in(seed, "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb");
    store8(msg, 0, 114 as u8);
    eq_hex_in(want, "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00");
    ed_sign(seed, msg, 1, got, sc);
    return eq_eq_bytes(got, want, 64);
}

fn test_ed25519_verify_and_tamper() -> bool {
    let sc: ptr = alloc(ed_scratch());
    let seed: ptr = alloc(32);
    let msg: ptr = alloc(3);
    let pk: ptr = alloc(32);
    let sig: ptr = alloc(64);
    eq_hex_in(seed, "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb");
    store8(msg, 0, 97 as u8);
    store8(msg, 1, 98 as u8);
    store8(msg, 2, 99 as u8);
    ed_public(seed, pk, sc);
    ed_sign(seed, msg, 3, sig, sc);
    if ed_verify(pk, msg, 3, sig, sc) != 0 {
        return false;
    }
    store8(sig, 7, (load8(sig, 7) ^ 1) as u8);
    return ed_verify(pk, msg, 3, sig, sc) == 1;
}

fn test_ed25519_empty_message() -> bool {
    let sc: ptr = alloc(ed_scratch());
    let seed: ptr = alloc(32);
    let msg: ptr = alloc(1);
    let pk: ptr = alloc(32);
    let sig: ptr = alloc(64);
    eq_hex_in(seed, "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60");
    ed_public(seed, pk, sc);
    ed_sign(seed, msg, 0, sig, sc);
    return ed_verify(pk, msg, 0, sig, sc) == 0;
}
