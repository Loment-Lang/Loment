// std/poly.lomt — 实系数多项式（double，系数低次在前）
//
// 为什么单独一份: `matrix` 是整数矩阵、`bigdec` 是十进制大数，都不管"c0 + c1 x + …"。
// 多项式求值/求导/求根是数值代码里出现频率最高的一小组操作，而且**Horner 写法**
// （从最高次往下乘加）是"少一次乘法、少一次舍入"的那一种 —— 值得写成一份。
//
// 表示: `c[0] + c[1] x + ... + c[n-1] x^(n-1)`，每个系数是 double 的位（u64），连续存放。
// 求导后是 n-1 个系数；积分后是 n+1 个（常数项由调用方给）。
//
// 不做的: 复数根、重根判定、Sturm 序列 —— 那些要复平面与精确有理数；本层只做实数。
//
// 命名: 公开 po_*, 内部 po_*。自检 test_poly_*。

module poly

use f64
use f64conv

pub const PO_ERR: u32 = 4294967295;

fn po_c(c: ptr, i: u32) -> u64 {
    return mem_load64(c, i * 8);
}

/// Horner 求值。
pub fn po_eval(c: ptr, n: u32, x: u64) -> u64 {
    if n == 0 {
        return F64_POS_ZERO;
    }
    let v: u64 = po_c(c, n - 1);
    let i: u32 = n - 1;
    while i > 0 {
        v = f64_add(f64_mul(v, x), po_c(c, i - 1));
        i = i - 1;
    }
    return v;
}

/// 导函数在 x 处的值（不求导数组）。
pub fn po_eval_deriv(c: ptr, n: u32, x: u64) -> u64 {
    if n <= 1 {
        return F64_POS_ZERO;
    }
    let v: u64 = f64_mul(po_c(c, n - 1), f64conv_from_i64((n - 1) as i64));
    let i: u32 = n - 1;
    while i > 1 {
        v = f64_add(f64_mul(v, x), f64_mul(po_c(c, i - 1), f64conv_from_i64((i - 1) as i64)));
        i = i - 1;
    }
    return v;
}

/// 求导：把 n 个系数变成 n-1 个（n <= 1 时写 0 个）。
pub fn po_deriv(r: ptr, c: ptr, n: u32) -> u32 {
    if n <= 1 {
        return 0;
    }
    let i: u32 = 1;
    while i < n {
        mem_store64(r, (i - 1) * 8,
            f64_mul(po_c(c, i), f64conv_from_i64(i as i64)));
        i = i + 1;
    }
    return n - 1;
}

/// 积分：n 个系数变成 n+1 个，常数项是 `k`。返回 n+1。
pub fn po_integral(r: ptr, c: ptr, n: u32, k: u64) -> u32 {
    mem_store64(r, 0, k);
    let i: u32 = 0;
    while i < n {
        mem_store64(r, (i + 1) * 8,
            f64_div(po_c(c, i), f64conv_from_i64((i + 1) as i64)));
        i = i + 1;
    }
    return n + 1;
}

/// 牛顿法求根。`tol` 是"步长绝对值"的阈值；迭代 `iters` 次。
pub fn po_newton(c: ptr, n: u32, x0: u64, iters: u32, tol: u64) -> u64 {
    let x: u64 = x0;
    let i: u32 = 0;
    let going: u32 = 1;
    while going == 1 && i < iters {
        let f: u64 = po_eval(c, n, x);
        let d: u64 = po_eval_deriv(c, n, x);
        if f64_eq(d, F64_POS_ZERO) {
            going = 0;
        } else {
            let step: u64 = f64_div(f, d);
            x = f64_sub(x, step);
            if f64_lt(f64_abs(step), tol) {
                going = 0;
            }
            i = i + 1;
        }
    }
    return x;
}

/// 二分法求根：要求 `f(a)` 与 `f(b)` 异号。没有变号返回 `PO_ERR`。
pub fn po_bisect(c: ptr, n: u32, a: u64, b: u64, iters: u32) -> u64 {
    let fa: u64 = po_eval(c, n, a);
    let fb: u64 = po_eval(c, n, b);
    if f64_eq(fa, F64_POS_ZERO) {
        return a;
    }
    if f64_eq(fb, F64_POS_ZERO) {
        return b;
    }
    let sa: u32 = 0;
    if f64_lt(fa, F64_POS_ZERO) { sa = 1; }
    let sb: u32 = 0;
    if f64_lt(fb, F64_POS_ZERO) { sb = 1; }
    if sa == sb {
        return 4294967295;
    }
    let lo: u64 = a;
    let hi: u64 = b;
    let i: u32 = 0;
    while i < iters {
        let mid: u64 = f64_mul(f64_add(lo, hi), F64_HALF);
        let fm: u64 = po_eval(c, n, mid);
        if f64_eq(fm, F64_POS_ZERO) {
            return mid;
        }
        let sm: u32 = 0;
        if f64_lt(fm, F64_POS_ZERO) { sm = 1; }
        if sm == sa {
            lo = mid;
        } else {
            hi = mid;
        }
        i = i + 1;
    }
    return f64_mul(f64_add(lo, hi), F64_HALF);
}

// ---------------------------------------------------------------- 自检

fn test_poly_eval() -> bool {
    // 2 + 3x + 4x^2，x=2 -> 24
    let c: ptr = alloc(24);
    mem_store64(c, 0, f64conv_from_i64(2 as i64));
    mem_store64(c, 8, f64conv_from_i64(3 as i64));
    mem_store64(c, 16, f64conv_from_i64(4 as i64));
    return f64_eq(po_eval(c, 3, f64conv_from_i64(2 as i64)),
                  f64conv_from_i64(24 as i64));
}

fn test_poly_deriv() -> bool {
    let c: ptr = alloc(24);
    let d: ptr = alloc(24);
    mem_store64(c, 0, f64conv_from_i64(2 as i64));
    mem_store64(c, 8, f64conv_from_i64(3 as i64));
    mem_store64(c, 16, f64conv_from_i64(4 as i64));
    if po_deriv(d, c, 3) != 2 {
        return false;
    }
    // 3 + 8x，x=2 -> 19
    return f64_eq(po_eval_deriv(c, 3, f64conv_from_i64(2 as i64)),
                  f64conv_from_i64(19 as i64));
}

fn test_poly_bisect() -> bool {
    // x^2 - 2 在 [1,2] 的根 = sqrt(2)
    let c: ptr = alloc(24);
    mem_store64(c, 0, f64conv_from_i64(0 as i64 - 2));
    mem_store64(c, 8, F64_POS_ZERO);
    mem_store64(c, 16, F64_ONE);
    let r: u64 = po_bisect(c, 3, F64_ONE, F64_TWO, 80);
    let d: u64 = f64_abs(f64_sub(r, 0x3FF6A09E667F3BCD)); // sqrt2
    return f64_lt(d, 0x3D719799812DEA11); // 1e-12
}
