module parser
choose runtime

// M80: Loment 版 parser —— 消费 M79 的 token 记录, 产出规范 AST dump。
// 覆盖: module / fn 签名 + 函数体 (let/set/ret/if/while/guard/表达式语句)
//       + 表达式 (int/bool/id/call/bin/un/cast/field/idx, 优先级同 lomentc)。
// dump 由 tools/loment_p8_test.py 与 Python 版逐字符对照。
use bytes
use lexer

pub fn tok_kind(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20);
}

pub fn tok_start(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 4);
}

pub fn tok_len(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 8);
}

/// token 原文是否等于 s。
fn tok_is(src: ptr, t: ptr, i: u32, s: str) -> bool {
    if tok_len(t, i) != str_len(s) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(s) {
        if load8(src, tok_start(t, i) + k) != str_byte(s, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn puts(out: ptr, o: u32, s: str) -> u32 {
    let i: u32 = 0;
    while i < str_len(s) {
        store8(out, o, str_byte(s, i) as u8);
        o = o + 1;
        i = i + 1;
    }
    return o;
}

fn put_tok(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u32 {
    let s: u32 = tok_start(t, i);
    let n: u32 = tok_len(t, i);
    let k: u32 = 0;
    while k < n {
        store8(out, o, load8(src, s + k) as u8);
        o = o + 1;
        k = k + 1;
    }
    return o;
}

fn hex_val(c: u32) -> u64 {
    if c >= 48 && c <= 57 {
        return (c - 48) as u64;
    }
    if c >= 65 && c <= 70 {
        return (c - 55) as u64;
    }
    return (c - 87) as u64;
}

fn put_dec(out: ptr, o: u32, v: u64) -> u32 {
    if v == 0 {
        store8(out, o, 48 as u8);
        return o + 1;
    }
    let d: u64 = 1;
    while d <= v / 10 {
        d = d * 10;
    }
    while d > 0 {
        store8(out, o, (48 + (v / d) % 10) as u8);
        o = o + 1;
        d = d / 10;
    }
    return o;
}

/// 整数字面量 -> 规范 dump。`0x…` 也化成十进制 —— 参考实现的 IntLit.value 已是数值,
/// dump 出的是 `(int 4096)`; 照抄原文会得到 `(int 0x1000)`, 与源文写法挂钩就不叫规范形了。
fn put_num(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u32 {
    let s: u32 = tok_start(t, i);
    let n: u32 = tok_len(t, i);
    if n > 2 && load8(src, s) == 48 && (load8(src, s + 1) == 120 || load8(src, s + 1) == 88) {
        let v: u64 = 0;
        let k: u32 = 2;
        while k < n {
            v = v * 16 + hex_val(load8(src, s + k));
            k = k + 1;
        }
        return put_dec(out, o, v);
    }
    return put_tok(out, o, src, t, i);
}

fn pack(i: u32, o: u32) -> u64 {
    return (i as u64) * 4294967296 + (o as u64);
}

/// 字符串字面量 -> `"原文重编码"`。与 tools/lomfmt.py 的 `_render` 同一口径:
/// 词法 token 给的是**原文**(含引号), 先按 _ESCAPES 解码, 再按 (反斜杠 -> 引号 ->
/// 换行) 的顺序重转义 —— 这样未知转义 (`\q` -> `q`) 与制表符的归一行为都与参考一致。
fn put_str(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u32 {
    o = puts(out, o, "\"");
    let s: u32 = tok_start(t, i) + 1;
    let e: u32 = tok_start(t, i) + tok_len(t, i) - 1;   // 不含右引号
    let j: u32 = s;
    while j < e {
        let c: u32 = load8(src, j);
        if c == 92 && j + 1 < e {
            let x: u32 = load8(src, j + 1);
            c = x;
            if x == 110 {
                c = 10;
            } else {
                if x == 116 {
                    c = 9;
                }
            }
            j = j + 2;
        } else {
            j = j + 1;
        }
        if c == 92 {
            o = puts(out, o, "\\\\");
        } else {
            if c == 34 {
                o = puts(out, o, "\\\"");
            } else {
                if c == 10 {
                    o = puts(out, o, "\\n");
                } else {
                    store8(out, o, c as u8);
                    o = o + 1;
                }
            }
        }
    }
    return puts(out, o, "\"");
}

/// 在 [start, o) 的内容前插一个空格 (整体右移一格)。else 分支的 dump 形态判定要用:
/// Python 先决定"是不是恰好一条 if", 再决定要不要在内容前写空格 —— 我们先写内容,
/// 判定后按需右移 (输出是顺序缓冲, 这样不必做前瞻扫描)。
fn insert_space(out: ptr, start: u32, o: u32) -> u32 {
    let k: u32 = o;
    while k > start {
        store8(out, k, load8(out, k - 1) as u8);
        k = k - 1;
    }
    store8(out, start, 32 as u8);
    return o + 1;
}

fn unpk_i(r: u64) -> u32 {
    return (r / 4294967296) as u32;
}

fn unpk_o(r: u64) -> u32 {
    return (r % 4294967296) as u32;
}

// ---------------------------------------------------------------- 运算符

/// 运算符编码: 0=不是; 其它见 op_name。多字符算符在词法上是两个 token。
fn op_code(src: ptr, t: ptr, i: u32) -> u32 {
    if tok_is(src, t, i, "|") {
        if tok_is(src, t, i + 1, "|") {
            return 1;
        }
        return 17;
    }
    if tok_is(src, t, i, "&") {
        if tok_is(src, t, i + 1, "&") {
            return 2;
        }
        return 16;
    }
    if tok_is(src, t, i, "=") {
        if tok_is(src, t, i + 1, "=") {
            return 3;
        }
        return 0;
    }
    if tok_is(src, t, i, "!") {
        if tok_is(src, t, i + 1, "=") {
            return 4;
        }
        return 0;
    }
    if tok_is(src, t, i, "<") {
        if tok_is(src, t, i + 1, "=") {
            return 6;
        }
        if tok_is(src, t, i + 1, "<") {
            return 9;
        }
        return 5;
    }
    if tok_is(src, t, i, ">") {
        if tok_is(src, t, i + 1, "=") {
            return 8;
        }
        if tok_is(src, t, i + 1, ">") {
            return 10;
        }
        return 7;
    }
    if tok_is(src, t, i, "+") {
        return 11;
    }
    if tok_is(src, t, i, "-") {
        return 12;
    }
    if tok_is(src, t, i, "*") {
        return 13;
    }
    if tok_is(src, t, i, "/") {
        return 14;
    }
    if tok_is(src, t, i, "%") {
        return 15;
    }
    if tok_is(src, t, i, "^") {
        return 18;
    }
    return 0;
}

fn op_prec(c: u32) -> u32 {
    if c == 1 {
        return 1;
    }
    if c == 2 {
        return 2;
    }
    if c == 3 || c == 4 {
        return 3;
    }
    if c >= 5 && c <= 8 {
        return 4;
    }
    if c == 17 {
        return 5;
    }
    if c == 18 {
        return 6;
    }
    if c == 16 {
        return 7;
    }
    if c == 9 || c == 10 {
        return 8;
    }
    if c == 11 || c == 12 {
        return 9;
    }
    if c >= 13 && c <= 15 {
        return 10;
    }
    return 0;
}

fn op_toks(c: u32) -> u32 {
    if c <= 2 || (c >= 3 && c <= 4) || c == 6 || c == 8 || c == 9 || c == 10 {
        return 2;
    }
    return 1;
}

fn op_name(c: u32) -> str {
    if c == 1 {
        return "||";
    }
    if c == 2 {
        return "&&";
    }
    if c == 3 {
        return "==";
    }
    if c == 4 {
        return "!=";
    }
    if c == 5 {
        return "<";
    }
    if c == 6 {
        return "<=";
    }
    if c == 7 {
        return ">";
    }
    if c == 8 {
        return ">=";
    }
    if c == 9 {
        return "<<";
    }
    if c == 10 {
        return ">>";
    }
    if c == 11 {
        return "+";
    }
    if c == 12 {
        return "-";
    }
    if c == 13 {
        return "*";
    }
    if c == 14 {
        return "/";
    }
    if c == 15 {
        return "%";
    }
    if c == 16 {
        return "&";
    }
    if c == 17 {
        return "|";
    }
    return "^";
}

// ---------------------------------------------------------------- 表达式

fn parse_expr(src: ptr, t: ptr, i: u32, out: ptr, o: u32, minp: u32) -> u64 {
    let r: u64 = parse_unary(src, t, i, out, o);
    i = unpk_i(r);
    o = unpk_o(r);
    let go: u32 = 1;
    while go == 1 {
        let c: u32 = op_code(src, t, i);
        if c == 0 || op_prec(c) < minp {
            go = 0;
        } else {
            let np: u32 = op_prec(c) + 1;
            o = puts(out, o, "(bin ");
            o = puts(out, o, op_name(c));
            i = i + op_toks(c);
            o = puts(out, o, " ");
            r = parse_expr(src, t, i, out, o, np);
            i = unpk_i(r);
            o = puts(out, unpk_o(r), ")");
        }
    }
    return pack(i, o);
}

fn parse_unary(src: ptr, t: ptr, i: u32, out: ptr, o: u32) -> u64 {
    if tok_is(src, t, i, "!") {
        o = puts(out, o, "(un ! ");
        let r: u64 = parse_unary(src, t, i + 1, out, o);
        return pack(unpk_i(r), puts(out, unpk_o(r), ")"));
    }
    if tok_is(src, t, i, "-") {
        o = puts(out, o, "(un - ");
        let r2: u64 = parse_unary(src, t, i + 1, out, o);
        return pack(unpk_i(r2), puts(out, unpk_o(r2), ")"));
    }
    if tok_is(src, t, i, "&") {
        // `&mut x` / `&x` —— 参考实现把它当一元运算符 (op = "&mut" / "&")
        if tok_is(src, t, i + 1, "mut") {
            o = puts(out, o, "(un &mut ");
            let r3: u64 = parse_unary(src, t, i + 2, out, o);
            return pack(unpk_i(r3), puts(out, unpk_o(r3), ")"));
        }
        o = puts(out, o, "(un & ");
        let r4: u64 = parse_unary(src, t, i + 1, out, o);
        return pack(unpk_i(r4), puts(out, unpk_o(r4), ")"));
    }
    return parse_atom(src, t, i, out, o);
}

/// 原子 + 后缀 (调用/字段/下标/as)
fn parse_atom(src: ptr, t: ptr, i: u32, out: ptr, o: u32) -> u64 {
    let k: u32 = tok_kind(t, i);
    let go: u32 = 1;   // 后缀 (.f / [i] / ? / as T) 开关: 枚举构造/路径后参考实现不接后缀
    if k == 3 && tok_is(src, t, i, "(") {
        let rp: u64 = parse_expr(src, t, i + 1, out, o, 1);
        i = unpk_i(rp) + 1;
        o = unpk_o(rp);
    } else if k == 3 && tok_is(src, t, i, "[") {
        // 数组字面量 `[e, e, ...]`
        o = puts(out, o, "(arr");
        i = i + 1;
        while !tok_is(src, t, i, "]") && tok_kind(t, i) != 4 {
            o = puts(out, o, " ");
            let ra: u64 = parse_expr(src, t, i, out, o, 1);
            i = unpk_i(ra);
            o = unpk_o(ra);
            if tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
        i = i + 1;  // ']'
        o = puts(out, o, ")");
    } else if k == 1 {
        o = puts(out, o, "(int ");
        o = put_num(out, o, src, t, i);
        o = puts(out, o, ")");
        i = i + 1;
    } else if k == 2 {
        o = puts(out, o, "(str ");
        o = put_str(out, o, src, t, i);
        o = puts(out, o, ")");
        i = i + 1;
    } else if k == 0 && (tok_is(src, t, i, "true") || tok_is(src, t, i, "false")) {
        o = puts(out, o, "(bool ");
        o = put_tok(out, o, src, t, i);
        o = puts(out, o, ")");
        i = i + 1;
    } else if k == 0 && tok_is(src, t, i + 1, "{") && tok_kind(t, i + 2) == 0
            && tok_is(src, t, i + 3, ":") && !tok_is(src, t, i + 4, ":") {
        // 结构体字面量 `Name { f: e, ... }`。
        // 参考实现用 `no_struct` 计数器区分"条件里的 `{`"与"结构体字面量"; 这里用
        // "`{` 后面是 标识符 + `:`" 判 (对合法程序等价; 残留: 空字段列表 `Pair {}`,
        // 见 docs/150 M80 节的说明)。
        o = puts(out, o, "(struct ");
        o = put_tok(out, o, src, t, i);
        i = i + 2;                            // '{'
        while !tok_is(src, t, i, "}") && tok_kind(t, i) != 4 {
            o = puts(out, o, " (f ");
            o = put_tok(out, o, src, t, i);   // 字段名
            i = i + 2;                        // ':'
            o = puts(out, o, " ");
            let rfs: u64 = parse_expr(src, t, i, out, o, 1);
            i = unpk_i(rfs);
            o = puts(out, unpk_o(rfs), ")");
            if tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
        i = i + 1;  // '}'
        o = puts(out, o, ")");
    } else if k == 0 && tok_is(src, t, i + 1, "(") {
        o = puts(out, o, "(call ");
        o = put_tok(out, o, src, t, i);
        i = i + 2;
        while !tok_is(src, t, i, ")") {
            o = puts(out, o, " ");
            let ra: u64 = parse_expr(src, t, i, out, o, 1);
            i = unpk_i(ra);
            o = unpk_o(ra);
            if tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
        i = i + 1;
        o = puts(out, o, ")");
    } else if k == 0 && tok_is(src, t, i + 1, ":") && tok_is(src, t, i + 2, ":") {
        // `Enum::Variant` / `Enum::Variant(arg)` —— 参考实现在这两个分支上**不接后缀**
        if tok_is(src, t, i + 4, "(") {
            o = puts(out, o, "(enum ");
            o = put_tok(out, o, src, t, i);
            o = puts(out, o, " ");
            o = put_tok(out, o, src, t, i + 3);
            o = puts(out, o, " ");
            let rea: u64 = parse_expr(src, t, i + 5, out, o, 1);
            i = unpk_i(rea) + 1;              // ')'
            o = puts(out, unpk_o(rea), ")");
        } else {
            o = puts(out, o, "(enumpath ");
            o = put_tok(out, o, src, t, i);
            o = puts(out, o, " ");
            o = put_tok(out, o, src, t, i + 3);
            o = puts(out, o, ")");
            i = i + 4;
        }
        go = 0;
    } else if k == 0 {
        o = puts(out, o, "(id ");
        if tok_is(src, t, i, "self") {
            o = puts(out, o, "__self");       // 镜像 lomentc._rename_self (impl 方法体里的 self)
        } else {
            o = put_tok(out, o, src, t, i);
        }
        o = puts(out, o, ")");
        i = i + 1;
    }
    // 后缀: .field / [idx] / ? / as T  —— 以独立分组追加在基表达式之后
    while go == 1 {
        if tok_is(src, t, i, ".") && tok_kind(t, i + 1) == 0 && !tok_is(src, t, i + 1, ".") {
            // 字段访问 `x.f` / 方法调用 `x.m(args)`
            if tok_is(src, t, i + 2, "(") {
                // 方法调用 `x.m(args)` —— 后缀风格: 接收者已在前面输出
                o = puts(out, o, "(mcall ");
                o = put_tok(out, o, src, t, i + 1);
                i = i + 3;                    // 跳过 '.' 名 '('
                while !tok_is(src, t, i, ")") && tok_kind(t, i) != 4 {
                    o = puts(out, o, " ");
                    let rma: u64 = parse_expr(src, t, i, out, o, 1);
                    i = unpk_i(rma);
                    o = unpk_o(rma);
                    if tok_is(src, t, i, ",") {
                        i = i + 1;
                    }
                }
                i = i + 1;                    // ')'
                o = puts(out, o, ")");
            } else {
                o = puts(out, o, "(field ");
                i = i + 1;
                o = put_tok(out, o, src, t, i);
                i = i + 1;
                o = puts(out, o, ")");
            }
        } else if tok_is(src, t, i, "[") {
            o = puts(out, o, "(idx ");
            let ri: u64 = parse_expr(src, t, i + 1, out, o, 1);
            i = unpk_i(ri) + 1;
            o = puts(out, unpk_o(ri), ")");
        } else if tok_is(src, t, i, "?") {
            o = puts(out, o, "(try)");
            i = i + 1;
        } else if tok_is(src, t, i, "as") {
            o = puts(out, o, "(cast ");
            let rct: u64 = put_type(src, t, i + 1, out, o);
            i = unpk_i(rct);
            o = puts(out, unpk_o(rct), ")");
        } else {
            go = 0;
        }
    }
    return pack(i, o);
}

// ---------------------------------------------------------------- 语句

fn parse_stmts(src: ptr, t: ptr, i: u32, out: ptr, o: u32) -> u64 {
    while !tok_is(src, t, i, "}") && tok_kind(t, i) != 4 {
        o = puts(out, o, " ");
        let r: u64 = parse_stmt(src, t, i, out, o);
        i = unpk_i(r);
        o = unpk_o(r);
    }
    return pack(i, o);
}

fn parse_stmt(src: ptr, t: ptr, i: u32, out: ptr, o: u32) -> u64 {
    // `lspe pass "reason" { … }`：**纯审计标注**。块里的语句照常检查、照常发射，
    // 所以解析时直接把内层语句接进外层（语言没有块作用域）。理由的 E038 在
    // checker 的 token 扫描里判 —— 这里负责把块拆平。
    if tok_is(src, t, i, "lspe") && tok_is(src, t, i + 1, "pass")
            && tok_kind(t, i + 2) == 2 && tok_is(src, t, i + 3, "{") {
        let rp: u64 = parse_stmts(src, t, i + 4, out, o);
        return pack(unpk_i(rp) + 1, unpk_o(rp));
    }
    if tok_is(src, t, i, "let") {
        o = puts(out, o, "(let ");
        i = i + 1;
        o = put_tok(out, o, src, t, i);   // 名
        i = i + 2;                        // ':' 类型
        o = puts(out, o, " ");
        let rlt: u64 = put_type(src, t, i, out, o);
        i = unpk_i(rlt);
        o = unpk_o(rlt);
        if tok_is(src, t, i, "=") {
            i = i + 1;
            o = puts(out, o, " ");
            let r: u64 = parse_expr(src, t, i, out, o, 1);
            i = unpk_i(r);
            o = unpk_o(r);
        }
        return pack(i + 1, puts(out, o, ")"));
    }
    if tok_is(src, t, i, "return") {
        o = puts(out, o, "(ret ");
        let r2: u64 = parse_expr(src, t, i + 1, out, o, 1);
        return pack(unpk_i(r2) + 1, puts(out, unpk_o(r2), ")"));
    }
    if tok_is(src, t, i, "if") {
        if tok_is(src, t, i + 1, "let") {
            // `if let Enum::Variant(bind) = e { then } else { other }`
            // 参考实现把它反糖成两臂 Match: 命中臂 + 通配臂 (无 else 就是空通配臂)。
            o = puts(out, o, "(match ");
            let en: u32 = i + 2;              // 枚举名 (i='if' i+1='let')
            let vn: u32 = i + 5;              // 变体名 (跳过 ':' ':')
            i = i + 6;
            let has_bind: u32 = 0;
            let bn: u32 = 0;
            if tok_is(src, t, i, "(") {
                has_bind = 1;
                bn = i + 1;
                i = i + 3;                    // '(' 绑定名 ')'
            }
            i = i + 1;                        // '='
            let rs: u64 = parse_expr(src, t, i, out, o, 1);
            i = unpk_i(rs) + 1;               // '{'
            o = puts(out, unpk_o(rs), " (arm (enumpath ");
            o = put_tok(out, o, src, t, en);
            o = puts(out, o, " ");
            o = put_tok(out, o, src, t, vn);
            if has_bind == 1 {
                o = puts(out, o, " bind ");
                o = put_tok(out, o, src, t, bn);
            }
            o = puts(out, o, ") (");
            let rt: u64 = parse_stmts(src, t, i, out, o);
            i = unpk_i(rt) + 1;               // '}'
            o = puts(out, unpk_o(rt), "))");
            o = puts(out, o, " (arm _ (");
            if tok_is(src, t, i, "else") {
                i = i + 1;
                if tok_is(src, t, i, "{") {
                    i = i + 1;
                    let re: u64 = parse_stmts(src, t, i, out, o);
                    i = unpk_i(re) + 1;       // '}'
                    o = unpk_o(re);
                }
            }
            return pack(i, puts(out, o, ")))"));
        }
        o = puts(out, o, "(if ");
        let rc: u64 = parse_expr(src, t, i + 1, out, o, 1);
        i = unpk_i(rc);
        o = puts(out, unpk_o(rc), " (");
        i = i + 1;  // '{'
        let rt: u64 = parse_stmts(src, t, i, out, o);
        i = unpk_i(rt) + 1;
        o = puts(out, unpk_o(rt), ") (");
        // else 分支: Python 的口径是
        //   otherwise 恰好一条 If  ->  "(" + st + ")"          (无前导空格)
        //   其它                    ->  "(" + (" " + st)* + ")"
        // 空格在内容**之前**, 所以先把内容写下来, 判定后再整体右移一格插空格。
        let els_start: u32 = o;
        if tok_is(src, t, i, "else") {
            i = i + 1;
            if tok_is(src, t, i, "if") {
                let re: u64 = parse_stmt(src, t, i, out, o);   // 单条 if, 无空格
                i = unpk_i(re);
                o = unpk_o(re);
            } else {
                i = i + 1;  // '{'
                if !tok_is(src, t, i, "}") {
                    let first_if: u32 = 0;
                    if tok_is(src, t, i, "if") {
                        first_if = 1;
                    }
                    let r1: u64 = parse_stmt(src, t, i, out, o);   // 第一条先不带空格
                    i = unpk_i(r1);
                    o = unpk_o(r1);
                    if first_if == 0 || !tok_is(src, t, i, "}") {
                        o = insert_space(out, els_start, o);       // 变空格形态
                        while !tok_is(src, t, i, "}") && tok_kind(t, i) != 4 {
                            o = puts(out, o, " ");
                            let r2: u64 = parse_stmt(src, t, i, out, o);
                            i = unpk_i(r2);
                            o = unpk_o(r2);
                        }
                    }
                }
                i = i + 1;  // '}'
            }
        }
        return pack(i, puts(out, o, "))"));
    }
    if tok_is(src, t, i, "while") {
        o = puts(out, o, "(while ");
        let rc2: u64 = parse_expr(src, t, i + 1, out, o, 1);
        i = unpk_i(rc2) + 1;
        o = puts(out, unpk_o(rc2), " (");
        let rt2: u64 = parse_stmts(src, t, i, out, o);
        i = unpk_i(rt2) + 1;
        return pack(i, puts(out, unpk_o(rt2), "))"));
    }
    if tok_is(src, t, i, "match") {
        o = puts(out, o, "(match ");
        let rms: u64 = parse_expr(src, t, i + 1, out, o, 1);
        i = unpk_i(rms) + 1;                  // '{'
        o = unpk_o(rms);
        while !tok_is(src, t, i, "}") && tok_kind(t, i) != 4 {
            o = puts(out, o, " (arm ");
            if tok_is(src, t, i, "_") {
                o = puts(out, o, "_");
                i = i + 1;
            } else {
                // `Enum::Variant` 或 `Enum::Variant(bind)`
                o = puts(out, o, "(enumpath ");
                o = put_tok(out, o, src, t, i);
                o = puts(out, o, " ");
                o = put_tok(out, o, src, t, i + 3);   // 枚举名 ':' ':' 变体名
                i = i + 4;
                if tok_is(src, t, i, "(") {
                    o = puts(out, o, " bind ");
                    o = put_tok(out, o, src, t, i + 1);
                    i = i + 3;                // '(' 绑定名 ')'
                }
                o = puts(out, o, ")");
            }
            i = i + 2;                        // '=>' (词法上是 '=' '>')
            i = i + 1;                        // '{'
            o = puts(out, o, " (");
            let rmb: u64 = parse_stmts(src, t, i, out, o);
            i = unpk_i(rmb) + 1;              // '}'
            o = puts(out, unpk_o(rmb), "))");
        }
        return pack(i + 1, puts(out, o, ")"));
    }
    if tok_is(src, t, i, "for") {
        o = puts(out, o, "(for ");
        i = i + 1;
        o = put_tok(out, o, src, t, i);       // 循环变量
        i = i + 2;                            // 'in'
        o = puts(out, o, " ");
        let rf1: u64 = parse_expr(src, t, i, out, o, 1);
        i = unpk_i(rf1) + 2;                  // '..' (词法上是两个 '.')
        o = puts(out, unpk_o(rf1), " ");
        let rf2: u64 = parse_expr(src, t, i, out, o, 1);
        i = unpk_i(rf2) + 1;                  // '{'
        o = puts(out, unpk_o(rf2), " (");
        let rf3: u64 = parse_stmts(src, t, i, out, o);
        i = unpk_i(rf3) + 1;                  // '}'
        return pack(i, puts(out, unpk_o(rf3), "))"));
    }
    if tok_is(src, t, i, "guard") {
        // `guard CAP(expr);` —— 能力域守卫 (参考实现里 cap 是名字、expr 是索引表达式)
        o = puts(out, o, "(guard ");
        i = i + 1;
        o = put_tok(out, o, src, t, i);
        i = i + 2;                            // '('
        o = puts(out, o, " ");
        let rg: u64 = parse_expr(src, t, i, out, o, 1);
        i = unpk_i(rg) + 2;                   // ')' + ';'
        return pack(i, puts(out, unpk_o(rg), ")"));
    }
    // 表达式语句 / 赋值
    let r3: u64 = parse_expr(src, t, i, out, o, 1);
    i = unpk_i(r3);
    o = unpk_o(r3);
    if tok_is(src, t, i, "=") {
        i = i + 1;
        o = puts(out, o, " (set ");
        let r4: u64 = parse_expr(src, t, i, out, o, 1);
        i = unpk_i(r4);
        o = puts(out, unpk_o(r4), ")");
    }
    return pack(i + 1, o);
}

// ---------------------------------------------------------------- 顶层

/// 类型名 -> 规范化文本, 与 `lomentc.type_name` 同口径:
/// `mut [X]` / `[X; N]` / `[X]` / `Name<A, B>`。原先只吃单个 token, 于是
/// `mut [u32]`、`[u32; 4]` 被拆成"多个形参"、`Pair<u32>` 被截断 (实测 native_mut/native_slice)。
fn put_type(src: ptr, t: ptr, i: u32, out: ptr, o: u32) -> u64 {
    if tok_is(src, t, i, "mut") && tok_is(src, t, i + 1, "[") {
        o = puts(out, o, "mut [");
        let r: u64 = put_type(src, t, i + 2, out, o);
        i = unpk_i(r);
        o = puts(out, unpk_o(r), "]");
        return pack(i + 1, o);
    }
    if tok_is(src, t, i, "[") {
        o = puts(out, o, "[");
        let r2: u64 = put_type(src, t, i + 1, out, o);
        i = unpk_i(r2);
        o = unpk_o(r2);
        if tok_is(src, t, i, ";") {
            o = puts(out, o, "; ");
            o = put_num(out, o, src, t, i + 1);   // 数组长度 (同样是整数字面量, 同口径)
            i = i + 3;                            // ';' + 长度 + ']'
        } else {
            i = i + 1;                            // ']'
        }
        o = puts(out, o, "]");
        return pack(i, o);
    }
    o = put_tok(out, o, src, t, i);               // 基类型 / struct 名
    i = i + 1;
    if tok_is(src, t, i, "<") {
        o = puts(out, o, "<");
        i = i + 1;
        let first: u32 = 1;
        while !tok_is(src, t, i, ">") && tok_kind(t, i) != 4 {
            if first == 0 {
                o = puts(out, o, ", ");
            }
            first = 0;
            let r3: u64 = put_type(src, t, i, out, o);
            i = unpk_i(r3);
            o = unpk_o(r3);
            if tok_is(src, t, i, ",") {
                i = i + 1;
            }
        }
        o = puts(out, o, ">");
        i = i + 1;
    }
    return pack(i, o);
}

fn parse_fn(src: ptr, t: ptr, i: u32, out: ptr, o: u32) -> u64 {
    o = puts(out, o, "(fn ");
    i = i + 1;
    o = put_tok(out, o, src, t, i);
    i = i + 1;
    if tok_is(src, t, i, "<") {
        // 泛型形参不进 dump (与 helper 的 _fn_mod 一致: 它只写名字 + 形参/返回), 但要跳过整段
        let gd: u32 = 1;
        i = i + 1;
        while gd > 0 && tok_kind(t, i) != 4 {
            if tok_is(src, t, i, "<") {
                gd = gd + 1;
            }
            if tok_is(src, t, i, ">") {
                gd = gd - 1;
            }
            i = i + 1;
        }
    }
    i = i + 1;  // '('
    while !tok_is(src, t, i, ")") {
        o = puts(out, o, " (p ");
        o = put_tok(out, o, src, t, i);
        i = i + 2;  // ':'
        o = puts(out, o, " ");
        let rt: u64 = put_type(src, t, i, out, o);   // 多 token 类型 (mut [T] / [T; N] / Name<A>)
        i = unpk_i(rt);
        o = puts(out, unpk_o(rt), ")");
        if tok_is(src, t, i, ",") {
            i = i + 1;
        }
    }
    i = i + 1;  // ')'
    if tok_is(src, t, i, "-") {
        i = i + 2;  // '->'
        o = puts(out, o, " -> ");
        let rr: u64 = put_type(src, t, i, out, o);
        i = unpk_i(rr);
        o = unpk_o(rr);
    }
    if tok_is(src, t, i, "{") {
        i = i + 1;
        o = puts(out, o, " (");
        let rb: u64 = parse_stmts(src, t, i, out, o);
        i = unpk_i(rb) + 1;
        o = puts(out, unpk_o(rb), ")");
    }
    return pack(i, puts(out, o, ")"));
}

/// impl 里的方法: 参考实现把名字折叠成 `<类型>_<方法>`、第一个形参改成
/// `__self: <类型>`、方法体里的 `self` 重写成 `__self` (lomentc.parse_impl)。
fn parse_impl_fn(src: ptr, t: ptr, i: u32, out: ptr, o: u32, ty: u32) -> u64 {
    o = puts(out, o, "(fn ");
    o = put_tok(out, o, src, t, ty);              // 类型名
    o = puts(out, o, "_");
    i = i + 1;                                   // 'fn'
    o = put_tok(out, o, src, t, i);              // 方法名
    i = i + 2;                                   // '('
    o = puts(out, o, " (p __self ");
    o = put_tok(out, o, src, t, ty);              // 接收者类型
    o = puts(out, o, ")");
    i = i + 1;                                   // 'self'
    while !tok_is(src, t, i, ")") && tok_kind(t, i) != 4 {
        i = i + 1;                               // ','
        o = puts(out, o, " (p ");
        o = put_tok(out, o, src, t, i);
        i = i + 2;                               // ':'
        o = puts(out, o, " ");
        let rp: u64 = put_type(src, t, i, out, o);
        i = unpk_i(rp);
        o = puts(out, unpk_o(rp), ")");
    }
    i = i + 1;                                   // ')'
    if tok_is(src, t, i, "-") {
        i = i + 2;                               // '->'
        o = puts(out, o, " -> ");
        let rr: u64 = put_type(src, t, i, out, o);
        i = unpk_i(rr);
        o = unpk_o(rr);
    }
    if tok_is(src, t, i, "{") {
        i = i + 1;
        o = puts(out, o, " (");
        let rb: u64 = parse_stmts(src, t, i, out, o);
        i = unpk_i(rb) + 1;                      // '}'
        o = puts(out, unpk_o(rb), ")");
    }
    return pack(i, puts(out, o, ")"));
}

pub fn parse(src: ptr, t: ptr, out: ptr) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    o = puts(out, o, "(module ");
    i = i + 1;
    o = put_tok(out, o, src, t, i);
    i = i + 1;
    while tok_kind(t, i) != 4 {
        if tok_is(src, t, i, "fn") {
            o = puts(out, o, " ");
            let r: u64 = parse_fn(src, t, i, out, o);
            i = unpk_i(r);
            o = unpk_o(r);
        } else if tok_is(src, t, i, "impl") {
            // `impl Trait for Type { ... }` / `impl Type { ... }`
            let tyi: u32 = i + 1;
            if tok_kind(t, tyi) == 0 && tok_is(src, t, tyi + 1, "for") {
                tyi = tyi + 2;                   // 跳过 'Trait' 'for'
            }
            i = tyi + 2;                         // 跳过 类型名 '{'
            while !tok_is(src, t, i, "}") && tok_kind(t, i) != 4 {
                if tok_is(src, t, i, "fn") {
                    o = puts(out, o, " ");
                    let rm: u64 = parse_impl_fn(src, t, i, out, o, tyi);
                    i = unpk_i(rm);
                    o = unpk_o(rm);
                } else {
                    i = i + 1;
                }
            }
            i = i + 1;                           // '}'
        } else if tok_is(src, t, i, "trait") {
            // trait 声明不进 dump (参考实现只把 impl 的方法放进 funcs)
            while tok_kind(t, i) != 4 && !tok_is(src, t, i, "{") {
                i = i + 1;
            }
            i = i + 1;
            let d: u32 = 1;
            while tok_kind(t, i) != 4 && d > 0 {
                if tok_is(src, t, i, "{") {
                    d = d + 1;
                }
                if tok_is(src, t, i, "}") {
                    d = d - 1;
                }
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    o = puts(out, o, ")");
    store8(out, o, 0 as u8);
    return o;
}
