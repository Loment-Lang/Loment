// dev/patch.lomt — 应用统一 diff（unified diff）
//
// 为什么开发者工具需要它: `udiff` 只会**生成** diff；而"打补丁"是另一半 ——
// 代码生成器、迁移脚本、测试夹具都要把一段补丁应用到文本上。自己写一遍最容易
// 错的是行号：hunk 头里的 `-a,b` 是**旧文件**的起始行与行数，`+c,d` 是新文件的；
// 少拷一行上下文就会把后面整体错位，而且不会报错。
//
// 支持的输入: `diff --git` / `---` / `+++` 前缀行会被跳过；`@@ -a[,b] +c[,d] @@`
// 头；` `（上下文）、`-`（删除）、`+`（新增）三种行。上下文行会**逐字节核对**，
// 不匹配返回 PA_ERR（宁可不打，也不打错位置）。
//
// 不做的: `\ No newline at end of file` 的精确还原（遇到就忽略）、二进制补丁、
// 多文件补丁的选择（一次只应用一个文件的 hunk；多个文件的 hunk 会按出现顺序全部应用）。
//
// 命名: 公开 pa_*, 内部 pa_*。自检 test_patch_*。

module patch

use mem

pub const PA_ERR: u32 = 4294967295;

fn pa_line_end(p: ptr, i0: u32, n: u32) -> u32 {
    let i: u32 = i0;
    while i < n && load8(p, i) != 10 {
        i = i + 1;
    }
    if i < n {
        i = i + 1;
    }
    return i;
}

fn pa_uint(p: ptr, i0: u32, n: u32) -> u64 {
    let i: u32 = i0;
    let v: u32 = 0;
    let any: u32 = 0;
    let going: u32 = 1;
    while going == 1 && i < n {
        let c: u32 = load8(p, i);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            any = 1;
            i = i + 1;
        } else {
            going = 0;
        }
    }
    if any == 0 {
        return (4294967295 as u64) << 32;
    }
    return ((i as u64) << 32) | (v as u64);
}

/// `@@ -a[,b] +c[,d] @@` -> a；不合法返回 PA_ERR。
fn pa_hunk_start(p: ptr, i: u32, n: u32) -> u32 {
    if i + 1 >= n || load8(p, i) != 64 || load8(p, i + 1) != 64 {
        return PA_ERR;
    }
    let j: u32 = i + 2;
    let k0: u32 = j;
    let mut_k: u32 = k0;
    while mut_k < n && (load8(p, mut_k) == 32 || load8(p, mut_k) == 9) {
        mut_k = mut_k + 1;
    }
    if mut_k >= n || load8(p, mut_k) != 45 {
        return PA_ERR;
    }
    let r: u64 = pa_uint(p, mut_k + 1, n);
    if (r >> 32) == 4294967295 {
        return PA_ERR;
    }
    return (r & 4294967295) as u32;
}

fn pa_content_len(p: ptr, s: u32, e: u32) -> u32 {
    let m: u32 = e;
    if m > s && load8(p, m - 1) == 10 {
        m = m - 1;
    }
    if m > s && load8(p, m - 1) == 13 {
        m = m - 1;
    }
    return m - s;
}

fn pa_line_eq(a: ptr, as_: u32, ae: u32, b: ptr, bs: u32, be: u32) -> bool {
    let al: u32 = pa_content_len(a, as_, ae);
    let bl: u32 = pa_content_len(b, bs, be);
    if al != bl {
        return false;
    }
    let i: u32 = 0;
    while i < al {
        if load8(a, as_ + i) != load8(b, bs + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn pa_copy(out: ptr, cap: u32, oi: u32, src: ptr, s: u32, e: u32) -> u32 {
    let room: u32 = 0;
    if oi < cap {
        room = cap - oi;
    }
    if e - s > room {
        return PA_ERR;
    }
    mem_copy(out, oi, src, s, e - s);
    return oi + (e - s);
}

/// 应用补丁。成功返回输出长度；格式错/上下文不符/输出不够返回 PA_ERR。
pub fn pa_apply(src: ptr, sn: u32, patch: ptr, pn: u32, out: ptr, cap: u32) -> u32 {
    let si: u32 = 0;
    let pi: u32 = 0;
    let oi: u32 = 0;
    let sline: u32 = 1;
    let going: u32 = 1;
    while going == 1 && pi < pn {
        let le: u32 = pa_line_end(patch, pi, pn);
        if pi + 1 < pn && load8(patch, pi) == 64 && load8(patch, pi + 1) == 64 {
            let a: u32 = pa_hunk_start(patch, pi, pn);
            if a == PA_ERR {
                return PA_ERR;
            }
            while sline < a {
                if si >= sn {
                    return PA_ERR;
                }
                let se: u32 = pa_line_end(src, si, sn);
                oi = pa_copy(out, cap, oi, src, si, se);
                if oi == PA_ERR {
                    return PA_ERR;
                }
                si = se;
                sline = sline + 1;
            }
            pi = le;
            let hgoing: u32 = 1;
            while hgoing == 1 && pi < pn {
                if load8(patch, pi) == 64 {
                    hgoing = 0;
                } else {
                    let e: u32 = pa_line_end(patch, pi, pn);
                    let tag: u32 = load8(patch, pi);
                    if tag == 32 { // ' ' 上下文
                        if si >= sn {
                            return PA_ERR;
                        }
                        let se: u32 = pa_line_end(src, si, sn);
                        if !pa_line_eq(src, si, se, patch, pi + 1, e) {
                            return PA_ERR;
                        }
                        oi = pa_copy(out, cap, oi, src, si, se);
                        if oi == PA_ERR {
                            return PA_ERR;
                        }
                        si = se;
                        sline = sline + 1;
                    } else if tag == 45 { // '-'
                        if si >= sn {
                            return PA_ERR;
                        }
                        si = pa_line_end(src, si, sn);
                        sline = sline + 1;
                    } else if tag == 43 { // '+'
                        oi = pa_copy(out, cap, oi, patch, pi + 1, e);
                        if oi == PA_ERR {
                            return PA_ERR;
                        }
                    } else if tag == 92 { // '\' No newline marker: 忽略
                        // 什么都不做
                    } else {
                        return PA_ERR;
                    }
                    pi = e;
                }
            }
        } else {
            pi = le;
        }
    }
    while si < sn {
        let se: u32 = pa_line_end(src, si, sn);
        oi = pa_copy(out, cap, oi, src, si, se);
        if oi == PA_ERR {
            return PA_ERR;
        }
        si = se;
    }
    return oi;
}

// ---------------------------------------------------------------- 自检

fn test_patch_simple() -> bool {
    let src: str = "a\nb\nc\n";
    let dif: str = "@@ -1,3 +1,4 @@\n a\n b\n+c2\n c\n";
    let out: ptr = alloc(64);
    let n: u32 = pa_apply(str_ptr(src), str_len(src), str_ptr(dif), str_len(dif), out, 64);
    let want: str = "a\nb\nc2\nc\n";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(out, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_patch_delete() -> bool {
    let src: str = "a\nb\nc\n";
    let dif: str = "@@ -1,3 +1,2 @@\n a\n-b\n c\n";
    let out: ptr = alloc(64);
    let n: u32 = pa_apply(str_ptr(src), str_len(src), str_ptr(dif), str_len(dif), out, 64);
    let want: str = "a\nc\n";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(out, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_patch_rejects_context() -> bool {
    let src: str = "a\nX\nc\n";
    let dif: str = "@@ -1,3 +1,3 @@\n a\n b\n c\n";
    let out: ptr = alloc(64);
    return pa_apply(str_ptr(src), str_len(src), str_ptr(dif), str_len(dif), out, 64) == PA_ERR;
}
