// dev/gitignore.lomt — `.gitignore` 模式匹配（含 `!` 取反）
//
// 为什么开发者工具需要它: 扫描源码树时，"哪些路径算忽略"决定了工具看见什么。
// gitignore 的规则与 glob 不同：**最后一条匹配的模式赢**、`!` 可以重新包含、
// 不带 `/` 的模式只匹配**文件名**、带 `/` 的匹配整条路径、`**` 跨目录。
//
// 支持: `*` `?` `[...]` `**` `\` 转义、`!` 取反、前导 `/` 锚定、尾部 `/` 仅目录。
// 不做的: `.git/info/exclude` 的叠加、嵌套 `.gitignore` 的目录作用域、大小写折叠。
//
// 输入: `patterns` 是 `char**`（每条一个模式，NUL 结尾）；`path` 用 `/` 分隔，
// 前导 `/` 会被去掉；`is_dir != 0` 表示路径是目录。
//
// 命名: 公开 gi_*, 内部 gi_*。自检 test_gitignore_*。

module gitignore
choose runtime

use mem

fn gi_cstr_len(p: ptr) -> u32 {
    let i: u32 = 0;
    while load8(p, i) != 0 {
        i = i + 1;
    }
    return i;
}

fn gi_at(arr: ptr, i: u32) -> ptr {
    return mem_load64(arr, i * 8) as ptr;
}

fn gi_slash(c: u32) -> bool {
    return c == 47;
}

/// 字符类：`[` 在 `pi`，返回 `[下一个下标:32][匹配:32]`；不闭合返回 0。
fn gi_class(p: ptr, pi: u32, pn: u32, c: u32) -> u64 {
    let i: u32 = pi + 1;
    let neg: u32 = 0;
    if i < pn && (load8(p, i) == 33 || load8(p, i) == 94) { // ! or ^
        neg = 1;
        i = i + 1;
    }
    let hit: u32 = 0;
    let first: u32 = 1;
    let going: u32 = 1;
    while going == 1 && i < pn {
        let a: u32 = load8(p, i);
        if a == 93 && first == 0 { // ']'
            going = 0;
        } else {
            first = 0;
            if a == 92 && i + 1 < pn {
                if load8(p, i + 1) == c {
                    hit = 1;
                }
                i = i + 2;
            } else if i + 2 < pn && load8(p, i + 1) == 45 && load8(p, i + 2) != 93 {
                let hi: u32 = load8(p, i + 2);
                if c >= a && c <= hi {
                    hit = 1;
                }
                i = i + 3;
            } else {
                if a == c {
                    hit = 1;
                }
                i = i + 1;
            }
        }
    }
    if i >= pn {
        return 0 as u64;
    }
    let m: u32 = hit;
    if neg == 1 {
        if hit == 0 { m = 1; } else { m = 0; }
    }
    return (((i + 1) as u64) << 32) | (m as u64);
}

fn gi_glob(p: ptr, pi0: u32, pn: u32, s: ptr, si0: u32, sn: u32) -> bool {
    let pi: u32 = pi0;
    let si: u32 = si0;
    if pi >= pn {
        return si >= sn;
    }
    let c: u32 = load8(p, pi);
    if c == 42 { // '*'
        if pi + 1 < pn && load8(p, pi + 1) == 42 { // '**'
            let j: u32 = pi + 2;
            if j < pn && gi_slash(load8(p, j)) {
                // '**/' 匹配零或多段
                if gi_glob(p, j + 1, pn, s, si, sn) {
                    return true;
                }
                let k: u32 = si;
                while k < sn {
                    if gi_slash(load8(s, k)) {
                        if gi_glob(p, j + 1, pn, s, k + 1, sn) {
                            return true;
                        }
                    }
                    k = k + 1;
                }
                return false;
            }
            // '**' 匹配任意（含 /）
            let k2: u32 = si;
            while k2 <= sn {
                if gi_glob(p, j, pn, s, k2, sn) {
                    return true;
                }
                k2 = k2 + 1;
            }
            return false;
        }
        // '*' 不跨 '/'
        let k3: u32 = si;
        let going: u32 = 1;
        while going == 1 {
            if gi_glob(p, pi + 1, pn, s, k3, sn) {
                return true;
            }
            if k3 >= sn || gi_slash(load8(s, k3)) {
                going = 0;
            } else {
                k3 = k3 + 1;
            }
        }
        return false;
    }
    if c == 63 { // '?'
        if si < sn && !gi_slash(load8(s, si)) {
            return gi_glob(p, pi + 1, pn, s, si + 1, sn);
        }
        return false;
    }
    if c == 91 { // '['
        if si >= sn {
            return false;
        }
        let r: u64 = gi_class(p, pi, pn, load8(s, si));
        if r == 0 {
            return false;
        }
        if ((r & 4294967295) as u32) == 0 {
            return false;
        }
        return gi_glob(p, (r >> 32) as u32, pn, s, si + 1, sn);
    }
    if c == 92 && pi + 1 < pn { // '\'
        if si < sn && load8(s, si) == load8(p, pi + 1) {
            return gi_glob(p, pi + 2, pn, s, si + 1, sn);
        }
        return false;
    }
    if si < sn && load8(s, si) == c {
        return gi_glob(p, pi + 1, pn, s, si + 1, sn);
    }
    return false;
}

fn gi_has_slash(p: ptr, st: u32, ln: u32) -> bool {
    let i: u32 = st;
    while i < st + ln {
        if gi_slash(load8(p, i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// 一条模式是否匹配。`neg_out` 收到取反位；返回 1/0。
fn gi_one(pat: ptr, pln: u32, path: ptr, pn0: u32, is_dir: u32, neg_out: ptr) -> u32 {
    let st: u32 = 0;
    let neg: u32 = 0;
    if pln > 0 && load8(pat, 0) == 33 { // '!'
        neg = 1;
        st = 1;
    } else if pln > 1 && load8(pat, 0) == 92 && load8(pat, 1) == 33 {
        st = 1; // \! -> 字面 '!'
    }
    mem_store32(neg_out, 0, neg);
    if st >= pln {
        return 0;
    }
    let en: u32 = pln;
    let dir_only: u32 = 0;
    if load8(pat, en - 1) == 47 { // 尾部 '/'
        dir_only = 1;
        en = en - 1;
    }
    if dir_only == 1 && is_dir == 0 {
        return 0;
    }
    if st >= en {
        return 0;
    }
    let anchored: u32 = 0;
    if load8(pat, st) == 47 { // 前导 '/'
        anchored = 1;
        st = st + 1;
    }
    if st >= en {
        return 0;
    }
    if pn0 > 0 && load8(path, 0) == 47 {
        return gi_one_path(pat, st, en, path, 1, pn0, anchored); // 去前导 '/'
    }
    return gi_one_path(pat, st, en, path, 0, pn0, anchored);
}

fn gi_one_path(pat: ptr, st: u32, en: u32, path: ptr, ps0: u32, pn: u32, anchored: u32) -> u32 {
    if anchored == 1 || gi_has_slash(pat, st, en - st) {
        if gi_glob(pat, st, en, path, ps0, pn) {
            return 1;
        }
        return 0;
    }
    // 无 '/'：只匹配 basename
    let base: u32 = ps0;
    let i: u32 = ps0;
    while i < pn {
        if load8(path, i) == 47 {
            base = i + 1;
        }
        i = i + 1;
    }
    if gi_glob(pat, st, en, path, base, pn) {
        return 1;
    }
    return 0;
}

/// 最后一条匹配的模式赢；`!` 把它改回"不忽略"。返回 1 = 忽略。
pub fn gi_match(patterns: ptr, n: u32, path: str, is_dir: u32) -> u32 {
    let neg: ptr = alloc(4);
    let res: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let p: ptr = gi_at(patterns, i);
        let pln: u32 = gi_cstr_len(p);
        if gi_one(p, pln, str_ptr(path), str_len(path), is_dir, neg) == 1 {
            if mem_load32(neg, 0) == 1 {
                res = 0;
            } else {
                res = 1;
            }
        }
        i = i + 1;
    }
    return res;
}

// ---------------------------------------------------------------- 自检

fn test_gitignore_basic() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let arr: ptr = alloc(16);
    let s1: str = "*.o";
    let s2: str = "!keep.o";
    mem_copy(a, 0, str_ptr(s1), 0, 3); store8(a, 3, 0 as u8);
    mem_copy(b, 0, str_ptr(s2), 0, 7); store8(b, 7, 0 as u8);
    mem_store64(arr, 0, a as u64);
    mem_store64(arr, 8, b as u64);
    return gi_match(arr, 2, "src/x.o", 0) == 1
        && gi_match(arr, 2, "keep.o", 0) == 0;
}

fn test_gitignore_dirs_and_anchor() -> bool {
    let a: ptr = alloc(16);
    let arr: ptr = alloc(8);
    let s: str = "/build/";
    mem_copy(a, 0, str_ptr(s), 0, 7); store8(a, 7, 0 as u8);
    mem_store64(arr, 0, a as u64);
    return gi_match(arr, 1, "build", 1) == 1
        && gi_match(arr, 1, "src/build", 1) == 0
        && gi_match(arr, 1, "build", 0) == 0;
}

fn test_gitignore_globstar() -> bool {
    let a: ptr = alloc(16);
    let arr: ptr = alloc(8);
    let s: str = "**/gen/*.c";
    mem_copy(a, 0, str_ptr(s), 0, 10); store8(a, 10, 0 as u8);
    mem_store64(arr, 0, a as u64);
    return gi_match(arr, 1, "a/b/gen/x.c", 0) == 1
        && gi_match(arr, 1, "gen/x.c", 0) == 1
        && gi_match(arr, 1, "a/b/other/x.c", 0) == 0;
}
