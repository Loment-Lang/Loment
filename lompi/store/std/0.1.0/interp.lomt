// std/interp.lomt — 定点插值与缓动 (t 是千分比 0..1024)
//
// 为什么要它: 这门语言**没有浮点** (docs/158 §4.4: 发射面 0 处 fadd/fcmp), 而"从 a 平滑
// 过渡到 b"是渲染、动画、噪声、曲线拟合到处都要的动作。所以插值必须有一层**定点**约定,
// 而且这层约定要被钉死在一个地方 —— 否则每个调用方都会自己发明一套 t 的量纲, 然后
// 在交界处差一个 1024 倍。
//
// **约定 (本模块的全部语义都建在这三条上)**:
//   1. t 是**千分比**: 0 表示 a, 1024 表示 b。t > 1024 一律夹到 1024 (不报错, 因为
//      "超出的时间点"是动画里的常态, 让它停在终点比让它 panic 有用)。
//   2. 结果与输入同量纲 —— 输入是"放大 1024 倍的定点数", 输出也是。
//   3. 除法一律 **四舍五入 (half away from zero)**, 不是截断。写成 `ip_rdiv`, 全局只有
//      这一个除法的定义 —— 截断与四舍五入在端点上的差别是静默的 (差 1 个单位),
//      但它会让"t=1024 恰好等于 b"这条最基本的性质时对时错。
//
// 诚实清单 (不做什么, 为什么):
//   - **ip_cubic 是 Catmull-Rom, 它会过冲 (overshoot)**。给一段单调递增的 (a,b,c,d),
//     结果**不保证**单调: 控制点拉得太开时曲线会在段内先冲高再回落。这是 Catmull-Rom
//     这个样条本身的性质, 不是实现缺陷 —— 要单调保形请用 ip_lerp / ip_smoothstep,
//     或者整段走"单调三次" (Fritsch-Carlson), 那是另一个算法, 不在这一层。
//   - ip_smoothstep / ip_smootherstep 是**归一化**的: 输入输出都在 0..1024, 不给你
//     a..b 的映射 —— 那是 `ip_lerp(a, b, ip_smoothstep(t))` 的事。分开放是因为
//     "缓动形状"与"目标区间"是两个独立决定。
//   - **溢出界 (写明)**: ip_cubic 内部把式子通分成 2*1024^3 的分母, 中间量的量级是
//     分量绝对值的 ~2*1024^3 倍。所以要求 |a|,|b|,|c|,|d| 在 2^40 以内 (那还有 3 个
//     数量级余量)。超了会静默回绕 —— 调用方自己判界。
//   - 缓动只有**二次与三次**两个族。四次以上对"看起来自然"没有边际收益, 而指数/弹性
//     这类要浮点的 (或者三角函数) 不在整数域里做。
//
// 命名: 公开 ip_*, 内部 ip_* (私有名也占全局拼写, 不带前缀会按 E13 撞车)。
// 自检 test_interp_*。

module interp

/// 千分比的上界 (t = 1024 表示"终点")。
const IP_S: i64 = 1024;
/// 1024^2。
const IP_S2: i64 = 1048576;
/// 1024^3。
const IP_S3: i64 = 1073741824;
/// 1024^4 —— smootherstep 的分母。
const IP_S4: i64 = 1099511627776;
/// 2 * 1024^3 —— Catmull-Rom 的分母。
const IP_S3X2: i64 = 2147483648;

// ---------------------------------------------------------------- 基础

/// 把 t 夹进 [0, 1024]。
fn ip_clamp_t(t: u32) -> u32 {
    if t > 1024 {
        return 1024;
    }
    return t;
}

/// `num / den` 四舍五入 (half away from zero)。den 必须 > 0。
///
/// 为什么单独成函数: 本模块每一处除法都走它。截断版 (`num / den`) 和四舍五入版在
/// **对称点**上差 1, 而对称点正是插值最常被查的地方 (t=512 该是中点)。
/// 里层的 `r * 2` 不会溢出: r < den, 而 den 最大是 IP_S3X2 ≈ 2^31。
fn ip_rdiv(num: i64, den: i64) -> i64 {
    let neg: u32 = 0;
    let n: i64 = num;
    if n < 0 as i64 {
        n = 0 as i64 - n;
        neg = 1;
    }
    let q: i64 = n / den;
    let r: i64 = n % den;
    if r * 2 >= den {
        q = q + 1;
    }
    if neg == 1 {
        return 0 as i64 - q;
    }
    return q;
}

// ---------------------------------------------------------------- 线性与平滑

/// 线性插值: t=0 给 a, t=1024 给 b。t > 1024 夹到 1024。
///
/// 为什么写成 `a + (b-a)*t/1024` 而不是 `(a*(1024-t) + b*t)/1024`: 后者要两次宽乘法,
/// 而且 a 与 b 同号大数时 (1024-t)*a 白白多出一大截 —— 前者只算一次差值。
pub fn ip_lerp(a: i64, b: i64, t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    return a + ip_rdiv((b - a) * u, IP_S);
}

/// 平滑步 (smoothstep): 3t²-2t³ 的定点版, 输出 0..1024。
///
/// 端点一阶导为 0 —— 这正是它比线性插值"不硌手"的原因 (速度从 0 起、到 0 收)。
/// 中间那一段比线性更陡 (最大斜率 1.5), 所以它是"缓入缓出"而不是"变慢"。
pub fn ip_smoothstep(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    // 1024 * (3w² - 2w³), w = u/1024 → u²(3072 - 2u) / 1024²
    let inner: i64 = IP_S * 3 - u * 2;
    return ip_rdiv(u * u * inner, IP_S2);
}

/// 更平滑步 (smootherstep, Perlin): 6t⁵-15t⁴+10t³ 的定点版, 输出 0..1024。
///
/// 比 smoothstep 多一条"二阶导在端点也为 0", 所以加速的**变化**也是连续的 ——
/// 用在噪声插值上时, 二阶不连续会让法线/梯度出现可见的格子边。
pub fn ip_smootherstep(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    // 1024 * (6w⁵ - 15w⁴ + 10w³), w = u/1024 → (6u⁵ - 15u⁴*1024 + 10u³*1024²) / 1024⁴
    let n: i64 = u * u * u * u * u * 6 - u * u * u * u * IP_S * 15 + u * u * u * IP_S2 * 10;
    return ip_rdiv(n, IP_S4);
}

// ---------------------------------------------------------------- 三次样条

/// Catmull-Rom 三次插值: 曲线过 b (t=0) 与 c (t=1024), a 与 d 只提供切线。
///
/// 通分后: 分母 2*1024³, 分子 = 2b*1024³ + (c-a)t*1024² + (2a-5b+4c-d)t²*1024
///                              + (3b-a-3c+d)t³。
/// **过冲是它的性质不是 bug** (见头部诚实清单) —— 自检里同时验"共线时精确还原线性"
/// 和"端点严格落在 b/c 上", 但不验单调 (那会是一条假绿)。
pub fn ip_cubic(a: i64, b: i64, c: i64, d: i64, t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    let n: i64 = b * IP_S3 * 2
        + (c - a) * u * IP_S2
        + (a * 2 - b * 5 + c * 4 - d) * u * u * IP_S
        + (b * 3 - a - c * 3 + d) * u * u * u;
    return ip_rdiv(n, IP_S3X2);
}

// ---------------------------------------------------------------- 缓动
//
// 六个函数都是 0 -> 0, 1024 -> 1024, 且单调不减。in 是"起步慢", out 是"收尾慢",
// in_out 是两头慢。二次族更"软", 三次族更"急"。

/// 二次缓入: t²。
pub fn ip_ease_in_quad(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    return ip_rdiv(u * u, IP_S);
}

/// 二次缓出。
pub fn ip_ease_out_quad(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    return IP_S - ip_rdiv((IP_S - u) * (IP_S - u), IP_S);
}

/// 二次缓入缓出。两半各自缩放到 0..512 —— 接缝在 t=512 且恰好给 512。
pub fn ip_ease_in_out_quad(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    if u < 512 {
        return ip_rdiv(u * u * 2, IP_S);
    }
    return IP_S - ip_rdiv((IP_S - u) * (IP_S - u) * 2, IP_S);
}

/// 三次缓入: t³。
pub fn ip_ease_in_cubic(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    return ip_rdiv(u * u * u, IP_S2);
}

/// 三次缓出。
pub fn ip_ease_out_cubic(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    return IP_S - ip_rdiv((IP_S - u) * (IP_S - u) * (IP_S - u), IP_S2);
}

/// 三次缓入缓出。
pub fn ip_ease_in_out_cubic(t: u32) -> i64 {
    let u: i64 = ip_clamp_t(t) as i64;
    if u < 512 {
        return ip_rdiv(u * u * u * 4, IP_S2);
    }
    return IP_S - ip_rdiv((IP_S - u) * (IP_S - u) * (IP_S - u) * 4, IP_S2);
}

// ---------------------------------------------------------------- 自检

fn test_interp_lerp_endpoints() -> bool {
    // t=0 必须**恰好**是 a, t=1024 必须**恰好**是 b —— 这是所有插值的第一性质,
    // 四舍五入写错时它时对时错。
    return ip_lerp(7, 2000, 0) == 7 && ip_lerp(7, 2000, 1024) == 2000
        && ip_lerp(0 as i64 - 7, 0 as i64 - 2000, 0) == 0 as i64 - 7
        && ip_lerp(0 as i64 - 7, 0 as i64 - 2000, 1024) == 0 as i64 - 2000;
}

fn test_interp_lerp_midpoint_rounds() -> bool {
    // t=512 是几何中点。0..1024 -> 512; 0..1 -> 0.5, **四舍五入**给 1 (截断会给 0)。
    return ip_lerp(0, 1024, 512) == 512 && ip_lerp(0, 1, 512) == 1
        && ip_lerp(0, 3, 512) == 2 && ip_lerp(10, 20, 512) == 15;
}

fn test_interp_lerp_clamps_t() -> bool {
    // t 超出 1024 必须停在 b 而不是外推 —— 外推会让"动画播完了"变成"飘出去"。
    return ip_lerp(0, 100, 2000) == 100 && ip_lerp(0, 100, 4294967295) == 100;
}

fn test_interp_lerp_monotone() -> bool {
    // a < b 时, t 走一圈结果必须不减 (含跨过 0 的负数区间)。
    // 上一轮的值用一个显式的 `cur` 带着走 —— 这门语言里 `let` 是可赋值的局部量。
    let ok: u32 = 1;
    let t: u32 = 0;
    let cur: i64 = ip_lerp(0 as i64 - 1000, 1000, 0);
    while t < 1024 {
        let now: i64 = ip_lerp(0 as i64 - 1000, 1000, t + 1);
        if now < cur {
            ok = 0;
        }
        cur = now;
        t = t + 1;
    }
    return ok == 1;
}

fn test_interp_smoothstep_endpoints_and_mid() -> bool {
    return ip_smoothstep(0) == 0 && ip_smoothstep(1024) == 1024
        && ip_smoothstep(512) == 512 && ip_smoothstep(2000) == 1024;
}

fn test_interp_smoothstep_monotone() -> bool {
    let t: u32 = 0;
    let ok: u32 = 1;
    while t < 1024 {
        if ip_smoothstep(t) > ip_smoothstep(t + 1) {
            ok = 0;
        }
        t = t + 1;
    }
    return ok == 1;
}

fn test_interp_smoothstep_symmetric() -> bool {
    // 3t²-2t³ 关于 t=0.5 中心对称 → s(t)+s(1024-t) 该是 1024。
    // **容差 1**: 两半各自独立四舍五入, 真实值恰好落在 x.5 时两边一起进位,
    // 于是和是 1025 而不是 1024。这是"逐点定点的固有代价", 不是算法错 ——
    // 所以这里验的是 |差| ≤ 1, 而不是硬等 (硬等会是一条逢 x.5 就红的假绿反例)。
    let t: u32 = 0;
    let ok: u32 = 1;
    while t <= 1024 {
        let d: i64 = ip_smoothstep(t) + ip_smoothstep(1024 - t) - 1024;
        if d > 1 || d < 0 as i64 - 1 {
            ok = 0;
        }
        t = t + 1;
    }
    return ok == 1;
}

fn test_interp_smoothstep_slope_zero_at_ends() -> bool {
    // 端点斜率 ≈ 0: 3t²-2t³ 在 0 处的一阶导是 0, 所以 1/1024 步长上的差分是
    // O(3 * (1/1024)² * 1024) = 3/1024 个单位 —— 四舍五入之后就是 0。
    // **容差取 1** (实际是 0): 留 1 是因为差分理论上可以到 0.5 而进位成 1, 不是猜的。
    // 同时要求中段差分**严格更大**, 否则"两端平"可能只是因为整条曲线都平 ——
    // 只验端点不验对比, 等于没验。
    let left: i64 = ip_smoothstep(1) - ip_smoothstep(0);
    let right: i64 = ip_smoothstep(1024) - ip_smoothstep(1023);
    let mid: i64 = ip_smoothstep(513) - ip_smoothstep(512);
    let lb: i64 = left;
    let rb: i64 = right;
    if lb < 0 as i64 {
        lb = 0 as i64 - lb;
    }
    if rb < 0 as i64 {
        rb = 0 as i64 - rb;
    }
    return lb <= 1 && rb <= 1 && mid >= 1 && left >= 0 as i64 && right >= 0 as i64;
}

fn test_interp_smootherstep() -> bool {
    // 与 smoothstep 同样的端点/中点/单调, 外加它独有的**精确**对称
    // (有理数意义上的和恰好是 1024, 因为它的系数让两个半边的舍入一起消失)。
    let t: u32 = 0;
    let ok: u32 = 1;
    while t <= 1024 {
        if ip_smootherstep(t) + ip_smootherstep(1024 - t) != 1024 {
            ok = 0;
        }
        if t < 1024 && ip_smootherstep(t) > ip_smootherstep(t + 1) {
            ok = 0;
        }
        t = t + 1;
    }
    return ok == 1 && ip_smootherstep(0) == 0 && ip_smootherstep(1024) == 1024
        && ip_smootherstep(512) == 512;
}

fn test_interp_cubic_endpoints() -> bool {
    // 曲线必须**穿过** b 与 c —— 这是 Catmull-Rom 的定义, 也是它和 B 样条的分界。
    return ip_cubic(5, 10, 20, 40, 0) == 10 && ip_cubic(5, 10, 20, 40, 1024) == 20
        && ip_cubic(0, 0 as i64 - 8, 8, 0, 0) == 0 as i64 - 8;
}

fn test_interp_cubic_linear_is_exact() -> bool {
    // 四个控制点共线等距时, Catmull-Rom **精确**还原那条直线 (b + (c-b)*t/1024)。
    // 这条比"看着像"有力: 只要分子/分母配对错一个系数, 它就红。
    let a: i64 = 0;
    let b: i64 = 1024;
    let c: i64 = 2048;
    let d: i64 = 3072;
    let t: u32 = 0;
    let ok: u32 = 1;
    while t <= 1024 {
        if ip_cubic(a, b, c, d, t) != ip_lerp(b, c, t) {
            ok = 0;
        }
        t = t + 1;
    }
    return ok == 1;
}

fn test_interp_cubic_midpoint() -> bool {
    // Catmull-Rom 在 t=0.5 的闭式: (-a + 9b + 9c - d)/16。
    // (0, 0, 1024, 1024) → (9*1024 - 1024)/16 = 512; 等距共线那一组 → 1536。
    let got: i64 = ip_cubic(0, 0, 1024, 1024, 512);
    return got == 512 && ip_cubic(0, 1024, 2048, 3072, 512) == 1536
        && ip_cubic(0, 0, 1024, 1024, 0) == 0 && ip_cubic(0, 0, 1024, 1024, 1024) == 1024;
}

fn test_interp_easing_endpoints() -> bool {
    return ip_ease_in_quad(0) == 0 && ip_ease_in_quad(1024) == 1024
        && ip_ease_out_quad(0) == 0 && ip_ease_out_quad(1024) == 1024
        && ip_ease_in_out_quad(0) == 0 && ip_ease_in_out_quad(1024) == 1024
        && ip_ease_in_cubic(0) == 0 && ip_ease_in_cubic(1024) == 1024
        && ip_ease_out_cubic(0) == 0 && ip_ease_out_cubic(1024) == 1024
        && ip_ease_in_out_cubic(0) == 0 && ip_ease_in_out_cubic(1024) == 1024;
}

fn test_interp_easing_monotone() -> bool {
    // 六条曲线全走一遍 —— 单调是缓动的定义性质, 破一条就说明公式写错了。
    let t: u32 = 0;
    let ok: u32 = 1;
    let p1: i64 = ip_ease_in_quad(0);
    let p2: i64 = ip_ease_out_quad(0);
    let p3: i64 = ip_ease_in_out_quad(0);
    let p4: i64 = ip_ease_in_cubic(0);
    let p5: i64 = ip_ease_out_cubic(0);
    let p6: i64 = ip_ease_in_out_cubic(0);
    let q1: i64 = p1;
    let q2: i64 = p2;
    let q3: i64 = p3;
    let q4: i64 = p4;
    let q5: i64 = p5;
    let q6: i64 = p6;
    while t < 1024 {
        let n1: i64 = ip_ease_in_quad(t + 1);
        let n2: i64 = ip_ease_out_quad(t + 1);
        let n3: i64 = ip_ease_in_out_quad(t + 1);
        let n4: i64 = ip_ease_in_cubic(t + 1);
        let n5: i64 = ip_ease_out_cubic(t + 1);
        let n6: i64 = ip_ease_in_out_cubic(t + 1);
        if n1 < q1 || n2 < q2 || n3 < q3 || n4 < q4 || n5 < q5 || n6 < q6 {
            ok = 0;
        }
        q1 = n1;
        q2 = n2;
        q3 = n3;
        q4 = n4;
        q5 = n5;
        q6 = n6;
        t = t + 1;
    }
    return ok == 1;
}

fn test_interp_easing_midpoints_and_shape() -> bool {
    // 中点 + "in 在中点落后于线性, out 在中点领先" —— 后者是缓动的本质,
    // 只验端点的话把 in 和 out 写反了也看不出来。
    let lin: i64 = ip_lerp(0, 1024, 512);
    return ip_ease_in_quad(512) == 256 && ip_ease_out_quad(512) == 768
        && ip_ease_in_out_quad(512) == 512 && ip_ease_in_cubic(512) == 128
        && ip_ease_out_cubic(512) == 896 && ip_ease_in_out_cubic(512) == 512
        && ip_ease_in_quad(512) < lin && ip_ease_out_quad(512) > lin
        && ip_ease_in_cubic(512) < ip_ease_in_quad(512)
        && ip_ease_out_cubic(512) > ip_ease_out_quad(512);
}

fn test_interp_easing_in_out_is_symmetric() -> bool {
    // in_out 的两半必须拼得起来: f(t) + f(1024-t) == 1024。
    let t: u32 = 0;
    let ok: u32 = 1;
    while t <= 1024 {
        if ip_ease_in_out_quad(t) + ip_ease_in_out_quad(1024 - t) != 1024 {
            ok = 0;
        }
        if ip_ease_in_out_cubic(t) + ip_ease_in_out_cubic(1024 - t) != 1024 {
            ok = 0;
        }
        t = t + 1;
    }
    return ok == 1;
}
