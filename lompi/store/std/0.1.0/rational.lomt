// std/rational.lomt — 精确分数 (有理数) 算术
//
// 为什么需要它: 这门语言只有整数, 而有一类问题**不能**用整数近似解决 —— 比例、概率、
// 精确的比率换算。一旦用了 `f64` 软浮点, "1/3 + 1/6 是不是恰好 1/2"这种问题就变成
// "是不是在误差内" —— 而答案本来可以是**确定的**。
//
// **内存布局 (调用方给的 16 字节, 没有 struct 语言, 只能这么约定)**:
//   off 0 : i64 num   分子 (可为负、可为 0)
//   off 8 : i64 den   分母 (**恒为正**; 0 表示非法)
// 两条不变量, 所有函数出入都守: **den > 0**, 且 (约分后) gcd(|num|, den) == 1。
// 守不住 den>0 的比较与十进制输出会全线错符号; 守不住约分则下一轮乘法立刻溢出。
//
// **为什么乘法要先约分**: `(a/b)*(c/d)` 直接算 `a*c` 与 `b*d`, 中间量比结果大一截 ——
// `(2/3)*(3/2)` 的 `2*3` 与 `3*2` 都是 6, 而结果是 1。数一大 (分母都在 10^9 量级)
// 就先溢出再"得到"一个错误答案。所以乘法/除法都做**交叉约分**: 先拿 a.num 对 b.den、
// b.num 对 a.den 各求一次 gcd 并除掉, 再乘。这对**热点路径**只有一个 gcd 的代价,
// 换掉的是"大数必炸"。
//
// 诚实清单 (不做什么, 为什么):
//   - **没有 i128, 所以中间量用溢出检测兜底**: 交叉约分之后仍然乘爆的情况 (两边都是
//     巨数) 会返回 RA_ERR, **不静默回绕**。这是"宁可报错不给错数"的一贯取舍。
//   - **ra_to_dec 有输入界**: 分母必须 < 2^60 (即 < 1152921504606846976), 否则长除法的
//     `rem*10` 会顶出 u64 -> 报 RA_ERR。要格式化更大的分母请先自己缩比。
//   - **不加、不乘、不约分以外的东西**: 没有幂、没有开方、没有连分数 —— 那些要么需要
//     浮点, 要么是另一层 (连分数逼近) 的算法。留给需要的人去写。
//   - **分母为 0 一律 RA_ERR** (没有 "NaN 分数" 这种东西; 报错比造一个哨兵值诚实)。
//   - gcd 复用 `intmath.im_gcd` (先读它确认过签名), 不重写。
//
// 命名: 公开 ra_*, 内部 ra_*。自检 test_rational_*。

module rational

use "mem.lomt"
use "intmath.lomt"

pub const RA_OK: u32 = 0;
/// 运算失败 (溢出 / 分母 0 / 输入超界)。
pub const RA_ERR: u32 = 4294967295;
/// "没有" (本模块暂未产生, 按库惯例与 RA_ERR 分开保留)。
pub const RA_NO: u32 = 4294967294;

/// 三态比较结果。
pub const RA_CMP_EQ: u32 = 0;
pub const RA_CMP_LT: u32 = 1;
pub const RA_CMP_GT: u32 = 2;

const RA_U64MAX: u64 = 18446744073709551615;
const RA_I64MAX: u64 = 9223372036854775807;
const RA_I64MIN_MAG: u64 = 9223372036854775808;
/// 分母上界: 10 * den 必须留在 u64 里 (长除法要用 `rem*10`)。
const RA_DEN_MAX: u64 = 1152921504606846976;

/// 二元运算要的临时区字节数 (三个 i64 槽)。
pub fn ra_scratch_bytes() -> u32 {
    return 32;
}

// ---------------------------------------------------------------- 基本读写

pub fn ra_num(r: ptr) -> i64 {
    return mem_load64(r, 0) as i64;
}

pub fn ra_den(r: ptr) -> i64 {
    return mem_load64(r, 8) as i64;
}

fn ra_sign(x: i64) -> u32 {
    if x > 0 {
        return 1;
    }
    if x < 0 {
        return 2;
    }
    return 0;
}

/// i64 的绝对值, 以 u64 返回 (i64::MIN 得到 2^63, u64 装得下)。
fn ra_abs_u(x: i64) -> u64 {
    let v: u64 = x as u64;
    if x < 0 {
        return (v ^ RA_U64MAX) + 1;
    }
    return v;
}

/// `p + o` 得到新 ptr (不用内建 ptr_add —— 它在 Rust 路径上没包 unsafe)。
fn ra_at(p: ptr, o: u32) -> ptr {
    return ((p as u64) + (o as u64)) as ptr;
}

// ---------------------------------------------------------------- 溢出检测算术

/// 有符号乘法, 结果写进 `out` (8 字节)。溢出 -> RA_ERR (不写)。
pub fn ra_mul_i64(a: i64, b: i64, out: ptr) -> u32 {
    if a == 0 || b == 0 {
        mem_store64(out, 0, 0);
        return RA_OK;
    }
    let na: u64 = ra_abs_u(a);
    let nb: u64 = ra_abs_u(b);
    let mut_neg: u32 = 0;
    if a < 0 {
        mut_neg = 1;
    }
    if b < 0 {
        if mut_neg == 1 {
            mut_neg = 0;
        } else {
            mut_neg = 1;
        }
    }
    if na > RA_U64MAX / nb {
        return RA_ERR;
    }
    let p: u64 = na * nb;
    if mut_neg == 0 {
        if p > RA_I64MAX {
            return RA_ERR;
        }
        mem_store64(out, 0, p);
    } else {
        if p > RA_I64MIN_MAG {
            return RA_ERR;
        }
        mem_store64(out, 0, (RA_U64MAX - p) + 1);
    }
    return RA_OK;
}

/// 有符号加法, 溢出 -> RA_ERR。用**符号位技巧**判溢出 (0 不会被误判)。
pub fn ra_add_i64(a: i64, b: i64, out: ptr) -> u32 {
    let s: i64 = a + b; // 运行期回绕, 下面靠符号位判
    let t: i64 = (a ^ s) & (b ^ s);
    if t < 0 {
        return RA_ERR;
    }
    mem_store64(out, 0, s as u64);
    return RA_OK;
}

/// 有符号减法, 溢出 -> RA_ERR。
///
/// **朴素判据在这里会错**: "a 与 b 符号不同、结果又与 a 不同就算溢出" 会把
/// `0 - 14` 判成溢出 (0 的符号是"零", 不是正)。符号位技巧没有这个问题。
pub fn ra_sub_i64(a: i64, b: i64, out: ptr) -> u32 {
    let s: i64 = a - b;
    let t: i64 = (a ^ b) & (a ^ s);
    if t < 0 {
        return RA_ERR;
    }
    mem_store64(out, 0, s as u64);
    return RA_OK;
}

/// u64 × u64 的**高 64 位** (比较两个分数时要精确的 128 位积)。
fn ra_mulhi(u: u64, v: u64) -> u64 {
    let a0: u64 = u & 4294967295;
    let a1: u64 = u >> 32;
    let b0: u64 = v & 4294967295;
    let b1: u64 = v >> 32;
    let t0: u64 = a0 * b0;
    let k0: u64 = t0 >> 32;
    let t1: u64 = a1 * b0 + k0;
    let w1: u64 = t1 & 4294967295;
    let w2: u64 = t1 >> 32;
    let t2: u64 = a0 * b1 + w1;
    let k2: u64 = t2 >> 32;
    return a1 * b1 + w2 + k2;
}

/// 比较 `an/ad` 与 `bn/bd` (四个都按非负 u64 看, 分母 > 0), 走**精确的 128 位交叉乘**。
fn ra_cmp_mag(an: u64, ad: u64, bn: u64, bd: u64) -> u32 {
    let ph: u64 = ra_mulhi(an, bd);
    let qh: u64 = ra_mulhi(bn, ad);
    if ph > qh {
        return RA_CMP_GT;
    }
    if ph < qh {
        return RA_CMP_LT;
    }
    let pl: u64 = an * bd;
    let ql: u64 = bn * ad;
    if pl > ql {
        return RA_CMP_GT;
    }
    if pl < ql {
        return RA_CMP_LT;
    }
    return RA_CMP_EQ;
}

// ---------------------------------------------------------------- 规整

/// 把分数**就地规整**: 分母翻正 + 约分到最简。分母 0 -> RA_ERR。
pub fn ra_reduce(r: ptr) -> u32 {
    let n0: i64 = ra_num(r);
    let d0: i64 = ra_den(r);
    if d0 == 0 {
        return RA_ERR;
    }
    let n: i64 = n0;
    let d: i64 = d0;
    // **先把符号规整成 den > 0, 再求 gcd** —— gcd 复用 im_gcd, 而它把结果当 i64 返回;
    // 只要 d > 0 且 d < 2^63, gcd 就落在 [1, d], 一定是正数, 不用管 i64::MIN 那个角落。
    if d < 0 {
        let nn: i64 = 0 as i64 - n;
        let dd: i64 = 0 as i64 - d;
        if dd < 0 {
            return RA_ERR; // 分母是 i64::MIN, 翻正不可表示
        }
        if n < 0 && nn < 0 {
            return RA_ERR; // 分子是 i64::MIN, 翻正不可表示
        }
        n = nn;
        d = dd;
    }
    let g: i64 = im_gcd(n, d);
    if g > 1 {
        n = n / g;
        d = d / g;
    }
    mem_store64(r, 0, n as u64);
    mem_store64(r, 8, d as u64);
    return RA_OK;
}

/// 置成 `num/den` (自动约分与符号规整)。den == 0 -> RA_ERR。
pub fn ra_set(r: ptr, num: i64, den: i64) -> u32 {
    if den == 0 {
        return RA_ERR;
    }
    mem_store64(r, 0, num as u64);
    mem_store64(r, 8, den as u64);
    return ra_reduce(r);
}

// ---------------------------------------------------------------- 四则

/// `out = a + b`。`sc` 至少 `ra_scratch_bytes()`。`out` 不得与 `a`/`b` 别名。
pub fn ra_add(a: ptr, b: ptr, sc: ptr, out: ptr) -> u32 {
    let t1: ptr = sc;
    let t2: ptr = ra_at(sc, 8);
    let t3: ptr = ra_at(sc, 16);
    if ra_mul_i64(ra_num(a), ra_den(b), t1) != RA_OK {
        return RA_ERR;
    }
    if ra_mul_i64(ra_num(b), ra_den(a), t2) != RA_OK {
        return RA_ERR;
    }
    if ra_add_i64(mem_load64(t1, 0) as i64, mem_load64(t2, 0) as i64, t3) != RA_OK {
        return RA_ERR;
    }
    if ra_mul_i64(ra_den(a), ra_den(b), t1) != RA_OK {
        return RA_ERR;
    }
    mem_store64(out, 0, mem_load64(t3, 0));
    mem_store64(out, 8, mem_load64(t1, 0));
    return ra_reduce(out);
}

/// `out = a - b`。
pub fn ra_sub(a: ptr, b: ptr, sc: ptr, out: ptr) -> u32 {
    let t1: ptr = sc;
    let t2: ptr = ra_at(sc, 8);
    let t3: ptr = ra_at(sc, 16);
    if ra_mul_i64(ra_num(a), ra_den(b), t1) != RA_OK {
        return RA_ERR;
    }
    if ra_mul_i64(ra_num(b), ra_den(a), t2) != RA_OK {
        return RA_ERR;
    }
    if ra_sub_i64(mem_load64(t1, 0) as i64, mem_load64(t2, 0) as i64, t3) != RA_OK {
        return RA_ERR;
    }
    if ra_mul_i64(ra_den(a), ra_den(b), t1) != RA_OK {
        return RA_ERR;
    }
    mem_store64(out, 0, mem_load64(t3, 0));
    mem_store64(out, 8, mem_load64(t1, 0));
    return ra_reduce(out);
}

/// `out = a * b`。**先交叉约分再乘** (见文件头)。
pub fn ra_mul(a: ptr, b: ptr, sc: ptr, out: ptr) -> u32 {
    let g1: i64 = im_gcd(ra_num(a), ra_den(b));
    let g2: i64 = im_gcd(ra_num(b), ra_den(a));
    if g1 == 0 || g2 == 0 {
        return RA_ERR;
    }
    let t1: ptr = sc;
    let t2: ptr = ra_at(sc, 8);
    if ra_mul_i64(ra_num(a) / g1, ra_num(b) / g2, t1) != RA_OK {
        return RA_ERR;
    }
    if ra_mul_i64(ra_den(a) / g2, ra_den(b) / g1, t2) != RA_OK {
        return RA_ERR;
    }
    mem_store64(out, 0, mem_load64(t1, 0));
    mem_store64(out, 8, mem_load64(t2, 0));
    return ra_reduce(out);
}

/// `out = a / b`。b 的分子为 0 -> RA_ERR (除以 0)。
pub fn ra_div(a: ptr, b: ptr, sc: ptr, out: ptr) -> u32 {
    if ra_num(b) == 0 {
        return RA_ERR;
    }
    let g1: i64 = im_gcd(ra_num(a), ra_num(b));
    let g2: i64 = im_gcd(ra_den(b), ra_den(a));
    if g1 == 0 || g2 == 0 {
        return RA_ERR;
    }
    let t1: ptr = sc;
    let t2: ptr = ra_at(sc, 8);
    if ra_mul_i64(ra_num(a) / g1, ra_den(b) / g2, t1) != RA_OK {
        return RA_ERR;
    }
    if ra_mul_i64(ra_den(a) / g2, ra_num(b) / g1, t2) != RA_OK {
        return RA_ERR;
    }
    mem_store64(out, 0, mem_load64(t1, 0));
    mem_store64(out, 8, mem_load64(t2, 0));
    return ra_reduce(out); // 顺手把可能为负的分母翻正
}

/// 三态比较: RA_CMP_LT / EQ / GT。
pub fn ra_cmp(a: ptr, b: ptr) -> u32 {
    let an: i64 = ra_num(a);
    let bn: i64 = ra_num(b);
    if an == 0 && bn == 0 {
        return RA_CMP_EQ;
    }
    // 零单独处理 —— 否则 "0 的符号" 会把比较带偏。
    if an == 0 {
        if bn > 0 {
            return RA_CMP_LT;
        }
        return RA_CMP_GT;
    }
    if bn == 0 {
        if an > 0 {
            return RA_CMP_GT;
        }
        return RA_CMP_LT;
    }
    let sa: u32 = ra_sign(an);
    let sb: u32 = ra_sign(bn);
    if sa != sb {
        // ra_sign: 1 = 正, 2 = 负。正数一方更大。
        if sa == 1 {
            return RA_CMP_GT;
        }
        return RA_CMP_LT;
    }
    let m: u32 = ra_cmp_mag(ra_abs_u(an), ra_den(a) as u64, ra_abs_u(bn), ra_den(b) as u64);
    if m == RA_CMP_EQ {
        return RA_CMP_EQ;
    }
    if sa == 1 {
        return m; // 都正: 量大者更大
    }
    // 都负: 量大者更小
    if m == RA_CMP_LT {
        return RA_CMP_GT;
    }
    return RA_CMP_LT;
}

// ---------------------------------------------------------------- 十进制输出

/// 把分数写成十进制, 从 `out` 的偏移 `oo` 起, 小数点后 `places` 位,
/// **四舍五入 (half away from zero)**。返回写出的字节数; 出错给 RA_ERR。
///
/// `places` 必须在 [1, 18]; 分母必须 < 2^60 (见文件头)。负数写成 `-0.500` 这种
/// (整数部分是 0 时**也保留负号** —— 这是标准的十进制写法, 不是 bug)。
pub fn ra_to_dec(r: ptr, places: u32, out: ptr, oo: u32) -> u32 {
    let d: i64 = ra_den(r);
    if d <= 0 {
        return RA_ERR;
    }
    if places == 0 || places > 18 {
        return RA_ERR;
    }
    let du0: u64 = d as u64;
    if du0 > RA_DEN_MAX {
        return RA_ERR; // rem*10 会顶出 u64
    }
    let n: i64 = ra_num(r);
    let neg: u32 = 0;
    if n < 0 {
        neg = 1;
    }
    let nu: u64 = ra_abs_u(n);
    let du: u64 = du0;
    let ip: u64 = nu / du;
    let rem0: u64 = nu % du;

    let w: u32 = oo;
    if neg == 1 {
        store8(out, w, 45 as u8);
        w = w + 1;
    }
    let ipos: u32 = w;
    if ip == 0 {
        store8(out, w, 48 as u8);
        w = w + 1;
    } else {
        let x: u64 = ip;
        while x > 0 {
            store8(out, w, (48 + (x % 10)) as u8);
            w = w + 1;
            x = x / 10;
        }
        // 低位先写, 就地把 [ipos, w) 反过来。
        let a: u32 = ipos;
        let b: u32 = w;
        while a + 1 < b {
            b = b - 1;
            let t: u8 = load8(out, a) as u8;
            store8(out, a, load8(out, b) as u8);
            store8(out, b, t);
            a = a + 1;
        }
    }
    store8(out, w, 46 as u8); // '.'
    w = w + 1;
    let fpos: u32 = w;
    let rem: u64 = rem0;
    let i: u32 = 0;
    while i < places {
        rem = rem * 10;
        let dig: u64 = rem / du;
        store8(out, w, (48 + dig) as u8);
        w = w + 1;
        rem = rem % du;
        i = i + 1;
    }
    // 四舍五入: 余数 >= 0.5 -> 末尾 +1, 逐位进位 (可能一路进到整数部分)。
    if rem * 2 >= du {
        let c: u32 = w;
        let carry: u32 = 1;
        while c > fpos && carry == 1 {
            c = c - 1;
            let dv: u32 = load8(out, c) - 48;
            if dv + 1 >= 10 {
                store8(out, c, 48 as u8);
            } else {
                store8(out, c, (dv + 49) as u8);
                carry = 0;
            }
        }
        if carry == 1 {
            // 小数位全是 9, 进位进到整数部分。跳过那个 '.' 从整数末位往前加。
            let dot: u32 = fpos - 1;
            let c2: u32 = dot;
            while c2 > ipos && carry == 1 {
                c2 = c2 - 1;
                let dv: u32 = load8(out, c2) - 48;
                if dv + 1 >= 10 {
                    store8(out, c2, 48 as u8);
                } else {
                    store8(out, c2, (dv + 49) as u8);
                    carry = 0;
                }
            }
            if carry == 1 {
                // 整数部分整体是 9 (或 0 被进成了需要加位) -> 右移一格, 最前写 '1'。
                let j: u32 = w;
                while j > ipos {
                    store8(out, j, load8(out, j - 1) as u8);
                    j = j - 1;
                }
                store8(out, ipos, 49 as u8);
                w = w + 1;
            }
        }
    }
    return w - oo;
}

// ---------------------------------------------------------------- 自检

/// 造一个分数并断言它最优。
fn ra_mk(r: ptr, num: i64, den: i64) -> bool {
    return ra_set(r, num, den) == RA_OK;
}

fn eq2(r: ptr, num: i64, den: i64) -> bool {
    return ra_num(r) == num && ra_den(r) == den;
}

fn test_rational_set_reduces() -> bool {
    let r: ptr = alloc(16);
    return ra_mk(r, 4, 8) && eq2(r, 1, 2) && ra_mk(r, 6, 3) && eq2(r, 2, 1)
        && ra_mk(r, 0, 5) && eq2(r, 0, 1);
}

fn test_rational_negative_normalizes() -> bool {
    // 分母恒正: 1/-2 要规整成 -1/2。
    let r: ptr = alloc(16);
    return ra_mk(r, 1, -2) && eq2(r, -1, 2) && ra_mk(r, -6, -4) && eq2(r, 3, 2);
}

fn test_rational_zero_denominator_is_err() -> bool {
    let r: ptr = alloc(16);
    return ra_set(r, 1, 0) == RA_ERR;
}

fn test_rational_add_halves() -> bool {
    // 1/2 + 1/3 = 5/6 —— 教科书那一条。
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 1, 2);
    ra_mk(b, 1, 3);
    let r: u32 = ra_add(a, b, sc, o);
    return r == RA_OK && eq2(o, 5, 6);
}

fn test_rational_add_negative() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 1, 2);
    ra_mk(b, -3, 4);
    let r: u32 = ra_add(a, b, sc, o);
    return r == RA_OK && eq2(o, -1, 4);
}

fn test_rational_sub() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 3, 4);
    ra_mk(b, 1, 4);
    let r: u32 = ra_sub(a, b, sc, o);
    return r == RA_OK && eq2(o, 1, 2);
}

fn test_rational_mul_cross_reduces() -> bool {
    // (2/3)*(3/2): 直接乘会得到 6/6 (中间量 6), 交叉约分后是 1/6 * 6/1... 结果 1/1。
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 2, 3);
    ra_mk(b, 3, 2);
    let r: u32 = ra_mul(a, b, sc, o);
    return r == RA_OK && eq2(o, 1, 1);
}

fn test_rational_mul_fraction() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 2, 3);
    ra_mk(b, 9, 4);
    let r: u32 = ra_mul(a, b, sc, o);
    return r == RA_OK && eq2(o, 3, 2);
}

fn test_rational_div() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 1, 2);
    ra_mk(b, 1, 4);
    let r: u32 = ra_div(a, b, sc, o);
    let ok1: bool = r == RA_OK && eq2(o, 2, 1);
    // 除以负数 -> 分母翻正
    ra_mk(b, -2, 3);
    let r2: u32 = ra_div(a, b, sc, o);
    return ok1 && r2 == RA_OK && eq2(o, -3, 4);
}

fn test_rational_div_by_zero_is_err() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 1, 2);
    ra_mk(b, 0, 5);
    return ra_div(a, b, sc, o) == RA_ERR;
}

fn test_rational_cmp_three_state() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    ra_mk(a, 1, 2);
    ra_mk(b, 1, 3);
    let lt: bool = ra_cmp(b, a) == RA_CMP_LT;
    let gt: bool = ra_cmp(a, b) == RA_CMP_GT;
    ra_mk(b, 2, 4); // 等于 a
    let eq: bool = ra_cmp(a, b) == RA_CMP_EQ;
    return lt && gt && eq;
}

fn test_rational_cmp_zero_and_sign() -> bool {
    let z: ptr = alloc(16);
    let p: ptr = alloc(16);
    let n: ptr = alloc(16);
    ra_mk(z, 0, 7);
    ra_mk(p, 1, 100);
    ra_mk(n, -1, 100);
    // 0 与负数: 0 更大 (这一条第一版会写错 —— 用符号位直接比会把 0 当正数)。
    return ra_cmp(z, p) == RA_CMP_LT && ra_cmp(z, n) == RA_CMP_GT
        && ra_cmp(n, p) == RA_CMP_LT && ra_cmp(z, z) == RA_CMP_EQ;
}

fn test_rational_cmp_exact_large() -> bool {
    // 两个接近的大分数 —— 交叉乘会超过 64 位, 走 128 位精确比较 (只差 1)。
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    // a = 3000000000/4000000000 = 3/4; b = 2999999999/4000000000
    ra_mk(a, 3000000000, 4000000000);
    ra_mk(b, 2999999999, 4000000000);
    let ok1: bool = ra_cmp(a, b) == RA_CMP_GT;
    // 分母拉到 10^18 量级: a*b 的交叉乘是 10^36, 非 128 位不可。
    ra_mk(a, 1000000000000000000, 3000000000000000000); // 1/3
    ra_mk(b, 999999999999999999, 3000000000000000000);  // 略小
    let ok2: bool = ra_cmp(a, b) == RA_CMP_GT;
    return ok1 && ok2 && eq2(a, 1, 3);
}

fn test_rational_to_dec_thirds() -> bool {
    // 1/3 -> "0.333333"; 2/3 -> "0.666667" (四舍五入要对)。
    let r: ptr = alloc(16);
    let out: ptr = alloc(64);
    ra_mk(r, 1, 3);
    let n1: u32 = ra_to_dec(r, 6, out, 0);
    let w1: str = "0.333333";
    let ok1: bool = n1 == 8 && mem_eq(out, 0, str_ptr(w1), 0, 8);
    ra_mk(r, 2, 3);
    let n2: u32 = ra_to_dec(r, 6, out, 0);
    let w2: str = "0.666667";
    return ok1 && n2 == 8 && mem_eq(out, 0, str_ptr(w2), 0, 8);
}

fn test_rational_to_dec_rounds_half_away() -> bool {
    // 5/8 = 0.625 -> 两位 "0.63" (half away from zero, 不是 banker's)。
    let r: ptr = alloc(16);
    let out: ptr = alloc(64);
    ra_mk(r, 5, 8);
    let n1: u32 = ra_to_dec(r, 2, out, 0);
    let w1: str = "0.63";
    let ok1: bool = n1 == 4 && mem_eq(out, 0, str_ptr(w1), 0, 4);
    // 3/8 = 0.375 -> "0.38"
    ra_mk(r, 3, 8);
    let n2: u32 = ra_to_dec(r, 2, out, 0);
    let w2: str = "0.38";
    return ok1 && n2 == 4 && mem_eq(out, 0, str_ptr(w2), 0, 4);
}

fn test_rational_to_dec_integer_part() -> bool {
    // **每条要比完再写下一条** —— 共用同一个 out, 把 mem_eq 留到最后一起判会让
    // 前面几条拿被覆盖后的内容去比 (第一版就是这么写的, 三条里两条假红)。
    let r: ptr = alloc(16);
    let out: ptr = alloc(64);
    ra_mk(r, 7, 2); // 3.5
    let n: u32 = ra_to_dec(r, 1, out, 0);
    let w: str = "3.5";
    let ok1: bool = n == 3 && mem_eq(out, 0, str_ptr(w), 0, 3);
    // 带进位跨过整数部分的: 249/250 = 0.996 -> 两位 "1.00"
    let r2: ptr = alloc(16);
    ra_mk(r2, 249, 250);
    let n2: u32 = ra_to_dec(r2, 2, out, 0);
    let w2: str = "1.00";
    let ok2: bool = n2 == 4 && mem_eq(out, 0, str_ptr(w2), 0, 4);
    // 199/100 = 1.99 -> 一位 "2.0" (整数进位)
    let r3: ptr = alloc(16);
    ra_mk(r3, 199, 100);
    let n3: u32 = ra_to_dec(r3, 1, out, 0);
    let w3: str = "2.0";
    let ok3: bool = n3 == 3 && mem_eq(out, 0, str_ptr(w3), 0, 3);
    return ok1 && ok2 && ok3;
}

fn test_rational_to_dec_negative() -> bool {
    let r: ptr = alloc(16);
    let out: ptr = alloc(64);
    ra_mk(r, -1, 2);
    let n: u32 = ra_to_dec(r, 3, out, 0);
    let w: str = "-0.500";
    return n == 6 && mem_eq(out, 0, str_ptr(w), 0, 6);
}

fn test_rational_to_dec_rejects_bad_places() -> bool {
    let r: ptr = alloc(16);
    let out: ptr = alloc(64);
    ra_mk(r, 1, 3);
    return ra_to_dec(r, 0, out, 0) == RA_ERR && ra_to_dec(r, 19, out, 0) == RA_ERR;
}

fn test_rational_to_dec_respects_offset() -> bool {
    let r: ptr = alloc(16);
    let out: ptr = alloc(64);
    store8(out, 0, 88 as u8); // 偏移前放个 'X' 当哨兵
    ra_mk(r, 1, 4);
    let n: u32 = ra_to_dec(r, 2, out, 1);
    let w: str = "X0.25";
    return n == 4 && mem_eq(out, 0, str_ptr(w), 0, 5);
}

fn test_rational_mul_overflow_is_err() -> bool {
    // 两个巨数相乘 -> 溢出必须报 ERR, 不能回绕出一个假结果。
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 9223372036854775807, 1);
    ra_mk(b, 9223372036854775807, 1);
    return ra_mul(a, b, sc, o) == RA_ERR;
}

fn test_rational_add_overflow_is_err() -> bool {
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 9223372036854775807, 3);
    ra_mk(b, 9223372036854775807, 5);
    // num = MAX*5 + MAX*3 = 8*MAX -> 溢出
    return ra_add(a, b, sc, o) == RA_ERR;
}

fn test_rational_mul_i64_bounds() -> bool {
    // 溢出检测的边界: MAX*1 成功, MAX*2 失败, MIN/1... 用两个 8 字节槽测。
    let o: ptr = alloc(16);
    let ok1: bool = ra_mul_i64(9223372036854775807, 1, o) == RA_OK
        && (mem_load64(o, 0) as i64) == 9223372036854775807;
    let bad: bool = ra_mul_i64(9223372036854775807, 2, o) == RA_ERR;
    let ok2: bool = ra_mul_i64(-4611686018427387904, 2, o) == RA_OK
        && (mem_load64(o, 0) as i64) == -9223372036854775808;
    let bad2: bool = ra_mul_i64(4611686018427387904, 2, o) == RA_ERR;
    return ok1 && bad && ok2 && bad2;
}

fn test_rational_sub_to_zero() -> bool {
    // 1/2 - 1/2 = 0/1；0/1 - 1/2 = -1/2 —— **减法的被减数为 0** 这一路会走到
    // "朴素符号判溢出"的坑 (见 ra_sub_i64 的注释), 所以单独钉一条。
    let a: ptr = alloc(16);
    let b: ptr = alloc(16);
    let o: ptr = alloc(16);
    let sc: ptr = alloc(32);
    ra_mk(a, 1, 2);
    ra_mk(b, 1, 2);
    let ok1: bool = ra_sub(a, b, sc, o) == RA_OK && eq2(o, 0, 1);
    ra_mk(a, 0, 1);
    ra_mk(b, 1, 2);
    let ok2: bool = ra_sub(a, b, sc, o) == RA_OK && eq2(o, -1, 2);
    // 边界: MAX/1 - 0 = MAX 必须成功。
    let ok3: bool = ra_sub_i64(9223372036854775807, 0, o) == RA_OK
        && (mem_load64(o, 0) as i64) == 9223372036854775807;
    // 边界: i64::MIN - 1 必须报溢出 (MIN 由常量转出来, 不写字面量负数)。
    let ok4: bool = ra_sub_i64(RA_I64MIN_MAG as i64, 1, o) == RA_ERR;
    return ok1 && ok2 && ok3 && ok4;
}

fn test_rational_scratch_bytes() -> bool {
    return ra_scratch_bytes() == 32;
}
