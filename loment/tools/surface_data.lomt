    if i == 0 { return "c"; }
    if i == 1 { return "csharp"; }
    if i == 2 { return "cpp"; }
    if i == 3 { return "cpp"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "csharp"; }
    if i == 6 { return "csharp"; }
    if i == 7 { return "cpp"; }
    if i == 8 { return "go"; }
    if i == 9 { return "go"; }
    if i == 10 { return "java"; }
    if i == 11 { return "loment"; }
    if i == 12 { return "natural"; }
    if i == 13 { return "natural"; }
    if i == 14 { return "natural"; }
    if i == 15 { return "python"; }
    if i == 16 { return "python"; }
    if i == 17 { return "rust"; }
    if i == 18 { return "rust"; }
    if i == 19 { return "tur2026.1"; }
    if i == 20 { return "tur2026.1"; }
    if i == 21 { return "tur2026.2"; }
    if i == 22 { return "tur2026.1"; }
    if i == 23 { return "tur2026.2"; }
    if i == 24 { return "tur2026.3"; }
    if i == 25 { return "tur2026.3"; }
