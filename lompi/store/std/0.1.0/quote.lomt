// std/quote.lomt — 转义与反转义
//
// 为什么要它: `loment/lib/json.lomt` 里有 `json_emit_str` 和一段 `\uXXXX` 手工解码 ——
// 那是 JSON 专用的。而"把任意字节变成能放进一行的可打印文本"是通用需求 (日志、诊断、
// 字节串回显), 且它的规则与 JSON 不同 (JSON 不许 \xHH, 也不许裸的非 ASCII)。
//
// 规则 (刻意选成"能看且能还原"):
//   可打印 ASCII (32..126) 原样;  \ 与 " 加反斜杠;  \n \r \t 用短转义;
//   其余 (<32 或 >126) 一律 \xHH —— 包括 127 以上的字节, 这样输出永远是纯 ASCII,
//   放日志里不会把终端搞乱, 也不会因为编码问题丢字节。
//
// 反转义只认自己产的这套 (\ \\ " n r t xHH), 遇到别的反斜杠序列就停下如实报告 ——
// 宁可让调用方看见"没吃下去", 也不要猜。
//
// 命名: 公开一律 quote_*, 内部一律 qe_*。自检 test_quote_*。

module quote

use "hex.lomt"

/// 单个字节转义后占几个字符。
pub fn quote_one_len(b: u32) -> u32 {
    if b == 92 || b == 34 || b == 10 || b == 13 || b == 9 {
        return 2;
    }
    if b < 32 || b > 126 {
        return 4;
    }
    return 1;
}

/// 转义 n 字节后需要多少字符 (算长度先分配缓冲用)。
pub fn quote_escaped_len(src: ptr, so: u32, n: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    while i < n {
        c = c + quote_one_len(load8(src, so + i));
        i = i + 1;
    }
    return c;
}

/// 转义, 返回新偏移。
pub fn quote_escape(buf: ptr, o: u32, src: ptr, so: u32, n: u32) -> u32 {
    let k: u32 = o;
    let i: u32 = 0;
    while i < n {
        k = qe_one(buf, k, load8(src, so + i));
        i = i + 1;
    }
    return k;
}

/// 反转义: (写出的字节数 << 32) | 消耗的输入字符数。
/// 遇到不认识的转义或截断的 \x 就停下, 已写出的部分保留。
pub fn quote_unescape(dst: ptr, doff: u32, src: ptr, so: u32, n: u32) -> u64 {
    let w: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let b: u32 = load8(src, so + i);
        if b != 92 {
            store8(dst, doff + w, b as u8);
            w = w + 1;
            i = i + 1;
        } else {
            if i + 2 > n {
                return (w as u64) * 4294967296 + (i as u64);
            }
            let c: u32 = load8(src, so + i + 1);
            if c == 120 {
                if i + 4 > n {
                    return (w as u64) * 4294967296 + (i as u64);
                }
                let hi: u32 = hex_val(load8(src, so + i + 2));
                let lo: u32 = hex_val(load8(src, so + i + 3));
                if hi == HEX_NONE || lo == HEX_NONE {
                    return (w as u64) * 4294967296 + (i as u64);
                }
                store8(dst, doff + w, ((hi * 16 + lo) & 255) as u8);
                w = w + 1;
                i = i + 4;
            } else {
                let d: u32 = qe_decode(c);
                if d == 4294967295 {
                    return (w as u64) * 4294967296 + (i as u64);
                }
                store8(dst, doff + w, d as u8);
                w = w + 1;
                i = i + 2;
            }
        }
    }
    return (w as u64) * 4294967296 + (i as u64);
}

/// 解包: 写出多少字节。
pub fn quote_written(t: u64) -> u32 {
    return (t >> 32) as u32;
}

/// 解包: 消耗多少输入字符。
pub fn quote_used(t: u64) -> u32 {
    return (t % 4294967296) as u32;
}

/// 短转义 -> 字节; 不认识返回 4294967295。
fn qe_decode(c: u32) -> u32 {
    if c == 110 {
        return 10;
    }
    if c == 114 {
        return 13;
    }
    if c == 116 {
        return 9;
    }
    if c == 92 {
        return 92;
    }
    if c == 34 {
        return 34;
    }
    return 4294967295;
}

/// 把单个字节转义写进 buf。
fn qe_one(buf: ptr, k: u32, b: u32) -> u32 {
    if b == 92 {
        store8(buf, k, 92 as u8);
        store8(buf, k + 1, 92 as u8);
        return k + 2;
    }
    if b == 34 {
        store8(buf, k, 92 as u8);
        store8(buf, k + 1, 34 as u8);
        return k + 2;
    }
    if b == 10 {
        store8(buf, k, 92 as u8);
        store8(buf, k + 1, 110 as u8);
        return k + 2;
    }
    if b == 13 {
        store8(buf, k, 92 as u8);
        store8(buf, k + 1, 114 as u8);
        return k + 2;
    }
    if b == 9 {
        store8(buf, k, 92 as u8);
        store8(buf, k + 1, 116 as u8);
        return k + 2;
    }
    if b < 32 || b > 126 {
        store8(buf, k, 92 as u8);
        store8(buf, k + 1, 120 as u8);
        store8(buf, k + 2, hex_digit(b >> 4) as u8);
        store8(buf, k + 3, hex_digit(b & 15) as u8);
        return k + 4;
    }
    store8(buf, k, b as u8);
    return k + 1;
}

// ---------------------------------------------------------------- 自检

fn test_quote_one_len() -> bool {
    return quote_one_len(97) == 1 && quote_one_len(92) == 2 && quote_one_len(10) == 2
        && quote_one_len(7) == 4 && quote_one_len(200) == 4;
}

fn test_quote_escape_plain() -> bool {
    let s: ptr = alloc(16);
    let b: ptr = alloc(32);
    store8(s, 0, 97 as u8);
    store8(s, 1, 98 as u8);
    let o: u32 = quote_escape(b, 0, s, 0, 2);
    return o == 2 && load8(b, 0) == 97 && load8(b, 1) == 98;
}

fn test_quote_escape_short_forms() -> bool {
    let s: ptr = alloc(16);
    let b: ptr = alloc(32);
    store8(s, 0, 10 as u8);
    let o1: u32 = quote_escape(b, 0, s, 0, 1);
    store8(s, 0, 9 as u8);
    let o2: u32 = quote_escape(b, o1, s, 0, 1);
    return o1 == 2 && load8(b, 0) == 92 && load8(b, 1) == 110
        && o2 == 4 && load8(b, 2) == 92 && load8(b, 3) == 116;
}

fn test_quote_escape_hex_form() -> bool {
    let s: ptr = alloc(16);
    let b: ptr = alloc(32);
    store8(s, 0, 7 as u8);
    let o: u32 = quote_escape(b, 0, s, 0, 1);
    return o == 4 && load8(b, 0) == 92 && load8(b, 1) == 120
        && load8(b, 2) == 48 && load8(b, 3) == 55;
}

fn test_quote_escape_non_ascii() -> bool {
    // 200 -> \xc8 —— 保证输出永远是纯 ASCII。
    let s: ptr = alloc(16);
    let b: ptr = alloc(32);
    store8(s, 0, 200 as u8);
    let o: u32 = quote_escape(b, 0, s, 0, 1);
    return o == 4 && load8(b, 0) == 92 && load8(b, 1) == 120
        && load8(b, 2) == 99 && load8(b, 3) == 56;
}

fn test_quote_escaped_len_matches_escape() -> bool {
    let s: ptr = alloc(32);
    let b: ptr = alloc(64);
    store8(s, 0, 97 as u8);
    store8(s, 1, 10 as u8);
    store8(s, 2, 200 as u8);
    store8(s, 3, 92 as u8);
    let n: u32 = quote_escaped_len(s, 0, 4);
    let o: u32 = quote_escape(b, 0, s, 0, 4);
    return n == o && n == 1 + 2 + 4 + 2;
}

fn test_quote_roundtrip() -> bool {
    let s: ptr = alloc(32);
    let m: ptr = alloc(64);
    let d: ptr = alloc(32);
    store8(s, 0, 97 as u8);
    store8(s, 1, 10 as u8);
    store8(s, 2, 92 as u8);
    store8(s, 3, 200 as u8);
    store8(s, 4, 34 as u8);
    let mlen: u32 = quote_escape(m, 0, s, 0, 5);
    let t: u64 = quote_unescape(d, 0, m, 0, mlen);
    return quote_written(t) == 5 && quote_used(t) == mlen
        && load8(d, 0) == 97 && load8(d, 1) == 10 && load8(d, 2) == 92
        && load8(d, 3) == 200 && load8(d, 4) == 34;
}

fn test_quote_unescape_unknown_escape_stops() -> bool {
    let m: ptr = alloc(16);
    let d: ptr = alloc(16);
    store8(m, 0, 97 as u8);
    store8(m, 1, 92 as u8);
    store8(m, 2, 113 as u8);     // \q 不认识
    store8(m, 3, 98 as u8);
    let t: u64 = quote_unescape(d, 0, m, 0, 4);
    return quote_written(t) == 1 && quote_used(t) == 1 && load8(d, 0) == 97;
}

fn test_quote_unescape_truncated_hex_stops() -> bool {
    let m: ptr = alloc(16);
    let d: ptr = alloc(16);
    store8(m, 0, 97 as u8);
    store8(m, 1, 92 as u8);
    store8(m, 2, 120 as u8);
    store8(m, 3, 52 as u8);      // \x4 —— 缺一位
    let t: u64 = quote_unescape(d, 0, m, 0, 4);
    return quote_written(t) == 1 && quote_used(t) == 1;
}
