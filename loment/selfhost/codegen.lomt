module codegen
choose runtime

// M82: Loment 版 IR 生成 —— 生成的 .ll 与 tools/lomentc.py 的 --emit-llvm 逐字节一致。
//
// 覆盖: 标量类型 (u8..u64/i8..i64/bool); 表达式 = 字面量 | 参数 | 括号 | 一元(- !)
//       | 二元(+ - * / % & | ^ << >> 比较) | 短路 &&/|| (phi) | 调用 | `as`;
//       语句 = let/赋值/if/while/for/return/表达式语句。
// 不含: 聚合类型(切片/字符串/数组/struct/枚举)、match、能力域、其余内建与 syscall。
//       除法/取模已含 —— 除零走 trap 跳转块, 并触发 freestanding 运行时文本块。
//
// 关键设计(两阶段): expr_* 先把指令写进输出, 再把"值文本"落到值栈的第 lvl 层;
// 调用方随后把该值内联到自己的行里 —— 这样嵌套表达式也能保持与 Python 版相同的指令顺序。
//
// 状态块: 0=输出游标 4=temp 计数 12=参数个数 512=需运行时文本块
//         值栈: 第 k 层 长度@8192+72k, 文本@8196+72k (容量 68), k=0..40
//         scratch 656.. (16B)
//         实参类型 720+(层)*4 (16 层) 十进制数字缓冲 672..704 函数计数 640  struct 表 1024..6144
//         函数表 CG_FN+i*12 (CG_MAXFN 个) fk 表 CG_FK+i*8 当前函数参数表 CG_CUR..
//         枚举表 CG_ENUM+i*80 (CG_MAXENUM 个) 局部表 CG_LOCAL.. (4 KiB) 每函数形参类型 CG_PARAM+i*160
//         564/568 = 当前函数体的 token 跨度 (L0 分析用), 572 = 本单元是不是 `gc_auto_alpha`
//         576 = 本单元是不是 `gc_auto` (收集器), 580 = 本帧的根表格数 (`gc_auto` 用, 每函数写)
//         584 = L1 扫描的临时: 某个名字**最后一次出现**的 token 下标
//
// **容量**: 每函数 100 字节 (12+8+80)。这几张表**按单元的规模**定, 所以整块不再放进
// 语言自带的 64 KiB bump 堆 —— 由驱动器从 `brk` 拿 `cg_arena_bytes()` 再传进来
// (checker 的 arena 早就是这么做的), 否则一放大就 OOM。
//
// 曾经是 192, 又抬到 307 (fk 表只有 192 格时, 单元长到 246 个函数就写穿到参数替换表/
// 枚举表上 —— 症状是"少数函数被改名成 `<接收者>_<方法>`", 而逐字节判据只会报"两个编译器
// 不一致")。2026-09-16 再抬到 CG_MAXFN: `use std` 那种 128 个模块的门面单元有 **4048 个
// 顶层函数**, 旧容量下直接段错误。容量由 `test_m85_codegen_table_capacity` 静态钉住,
// 运行时**超了返回 0** (驱动器据此报错退出), 不写穿。
// 常量初值只能用**整数字面量** (语言如此), 所以下面都是算好的数 —— 改容量要重算:
//   CG_FK = CG_FN + CG_MAXFN*12            CG_CUR = CG_FK + CG_MAXFN*8
//   CG_LOCAL = CG_ENUM + CG_MAXENUM*80     CG_PARAM = CG_LOCAL + 4096
//   CG_BYTES = CG_SAFE + (1 + CG_MAXFN)*4
const CG_FN: u32 = 12288;          // 函数表 (12 B/条: name_tok, ret_tok, ...)
const CG_MAXFN: u32 = 4600;
const CG_FK: u32 = 67488;          // fkind 表 (8 B/条)
const CG_CUR: u32 = 104288;        // 当前函数参数替换表 (256 B)
const CG_ENUM: u32 = 105472;       // 枚举表 (80 B/条)
const CG_MAXENUM: u32 = 320;
const CG_LOCAL: u32 = 131072;      // 局部表 (4 KiB, 每函数清零)
const CG_PARAM: u32 = 135168;      // 每函数形参类型 (160 B/条 = 20 槽 x 8)
// `docs/210` §7 那次放宽的**安全名表**：`[0]` 条数，`[1..]` = "首参不外逃"的用户函数
// **名字 token 下标**。由 `compute_safe` 在 `emit_module` 里算（`compute_safe` 也 `pub`，
// 于是 `potato.lomt` 用同一支扫描、只是写进它自己的表 —— **同一份源，两边算出的集合相同**）。
const CG_SAFE: u32 = 871168;       // 安全名表 (1 + CG_MAXFN 个 u32) = CG_PARAM + CG_MAXFN*160
//: **常量表**（`#719`）：`find_const` 原来每次**扫全单元 token**。`std` 门面（~50 万
//: token、几万次标识符求值）因此是 O(n²)，自举编它要十几分钟（参考 15 秒）。一趟扫完
//: 存 `(name_tok, type_tok)`，查找就只是 540 条以内的小表。
//: **`match` 各臂的标签表**（最多 12 臂）。曾经直接写在 `560 + arms*4` —— 于是
//: 第 1 臂就压到 `564/568`（当前函数体的 token 跨度）、第 3 臂压到 `572`
//: （`gc_auto_alpha` 档位）、第 4 臂压到 `576`（`gc_auto`）…… 一个 4 臂的 `match`
//: 会把 572 写成标签号（通常是 1），于是**非 alpha 档**的单元被当成 alpha：
//: 那个四字节 `alloc` 被提到栈上（`slot.buf`）、与参考实现分叉（#719，`stdlib` 的
//: `sd_key_cmp` 抓到）。这一格是 ABI 级的静默串写，别改回贴着标量的地址。
const CG_ARM: u32 = 7680;          // 7680..8192: 能力域表之后、值栈之前的那 512 字节
const CG_CONST: u32 = 889572;      // 常量表 (8 B/条) 紧跟安全名表
const CG_MAXCONST: u32 = 1024;
const CG_BYTES: u32 = 897764;      // 整块大小 = CG_CONST + CG_MAXCONST*8
use bytes
use lexer

/// 状态块内的 16B 共享 scratch (只在下一次调用前存活, 不跨调用保留)。
fn scratch_buf(s: ptr) -> ptr {
    return ptr_add(s, 656);
}

fn st_o(s: ptr) -> u32 {
    return load32(s, 0);
}

fn blen(s: ptr, lvl: u32) -> u32 {
    return 8192 + 72 * lvl;
}

fn btxt(s: ptr, lvl: u32) -> u32 {
    return 8196 + 72 * lvl;
}

// ---------------------------------------------------------------- 输出

fn emit_str(s: ptr, out: ptr, text: str) -> u32 {
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < str_len(text) {
        store8(out, o, str_byte(text, i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_mem(s: ptr, out: ptr, buf: ptr, off: u32, len: u32) -> u32 {
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < len {
        store8(out, o, load8(buf, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_dec(s: ptr, out: ptr, v: u32) -> u32 {
    let tmp: ptr = scratch_buf(s);
    let n: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        n = 1;
    }
    while x > 0 {
        store8(tmp, n, (48 + x % 10) as u8);
        x = x / 10;
        n = n + 1;
    }
    let o: u32 = st_o(s);
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(tmp, n - 1 - i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store32(s, 0, o);
    return o;
}

fn emit_tok(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    return emit_mem(s, out, src, load32(toks, i * 20 + 4), load32(toks, i * 20 + 8));
}

/// token 原文是否等于 text。
///
/// **字符串字面量不算** (kind 2 直接返回 false): 词法器给字符串 token 的 `val` 是**里面的
/// 内容**(`"impl"` 的原文就是 `impl`), 所以 `tok_is(i, "impl")` 会匹配到源码里的字符串
/// `"impl"` —— 而"用 Loment 写编译器"这件事必然在源码里写出 `"fn"`/`"impl"`/`"trait"`
/// 这类字符串 (关键字表、内建名表), 于是关键字判断全部误触发。M85 后半天实测: 自举
/// codegen 因此把 checker.lomt 里 `chk_tok_is(src,t,i,"impl")` 的字符串当成 impl 块,
/// 之后的函数全被改名成 `<接收者>_<方法>`, 与参考实现逐字节不一致。
/// 参考实现没有这个坑是因为它的 parser 用 `at(kind, val)` 一起判 kind。
pub fn tok_is(src: ptr, toks: ptr, i: u32, text: str) -> bool {
    // **虚拟类型哨兵不是 token 下标**（`CG_WANT_U32` / `CG_TY_BOOL` / `CG_CAST_PTR`
    // 都在 2^31 以上）。少了这道门，`is_signed(哨兵)` 会按 `i*20` 算出个野地址去读 ——
    // 自举镜像的内存里"碰巧"读得到，clang 编出来的独立 codegen 直接 0xC0000005
    // （`loment_p8_test` 的 `driver.lomt` 那格抓到）。
    if i >= 2147483648 {
        return false;
    }
    if load32(toks, i * 20) == 2 {   // string: 只比原文会与关键字/类型名撞车
        return false;
    }
    if load32(toks, i * 20 + 8) != str_len(text) {
        return false;
    }
    let k: u32 = 0;
    while k < str_len(text) {
        if load8(src, load32(toks, i * 20 + 4) + k) != str_byte(text, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn tok_kind(toks: ptr, i: u32) -> u32 {
    if i >= 2147483648 {
        return 4;                    // 哨兵按 EOF 算：扫描循环当场停，不会读野地址
    }
    return load32(toks, i * 20);
}

/// 只占号不写输出 (除法要先占 r 再占 z, 与 lomentc 的 `r = self.t(); z = self.t()` 同序)。
fn alloc_temp(s: ptr) -> u32 {
    let v: u32 = load32(s, 4) + 1;   // lomentc 从 %t1 起编号
    store32(s, 4, v);
    return v;
}

fn emit_temp_ref(s: ptr, out: ptr, n: u32) -> u32 {
    emit_str(s, out, "%t");
    return emit_dec(s, out, n);
}

fn new_temp(s: ptr, out: ptr) -> u32 {
    let v: u32 = alloc_temp(s);
    emit_temp_ref(s, out, v);
    return v;
}

// ---------------------------------------------------------------- 值栈

fn copy_mem(buf: ptr, off: u32, src: ptr, soff: u32, len: u32) {
    let i: u32 = 0;
    while i < len {
        store8(buf, off + i, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

/// 把第 src 层的值复制到第 dst 层。
fn move_val(s: ptr, dst: u32, src: u32) {
    let len: u32 = load32(s, blen(s, src));
    let i: u32 = 0;
    while i < len {
        store8(s, btxt(s, dst) + i, load8(s, btxt(s, src) + i) as u8);
        i = i + 1;
    }
    store32(s, blen(s, dst), len);
}

/// 把"%tN"写进第 lvl 层。
fn set_temp_val(s: ptr, lvl: u32, n: u32) {
    store8(s, btxt(s, lvl), 37 as u8);
    store8(s, btxt(s, lvl) + 1, 116 as u8);
    let tmp: ptr = scratch_buf(s);
    let d: u32 = 0;
    let x: u32 = n;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(s, btxt(s, lvl) + 2 + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), 2 + d);
}

fn emit_val(s: ptr, out: ptr, lvl: u32) -> u32 {
    return emit_mem(s, out, s, btxt(s, lvl), load32(s, blen(s, lvl)));
}

// ---------------------------------------------------------------- 类型

//: 类型记号里的哨兵: `0` = 未知 (调用方落到**期望类型**)、`4294967295` = unit (`void`)。
//: **`4294967294` = `bool`** —— 源里不一定有 `bool` 那个词可以指 (`(a < 0)` 就没有),
//: 而参考实现 `expr_type(Bin)` 对比较/逻辑**直接返回 `"bool"`** (`tools/lomentc.py`)。
//: 少这个记号, 自举侧只能拿操作数的类型顶上去 —— `(a<0) != (b<0)` 于是发成 `icmp ne i64`,
//: 而那两个操作数其实是 `i1` (`#316`)。
const CG_TY_BOOL: u32 = 4294967294;

//: **`4294967293` = "u32, 但源里没有那个词可以指"** —— 两侧都没有类型的二元运算
//: (常量 vs 字面量) 里, 参考实现把它落成 `u32` (无符号 32 位): `DIR_ERR(u32) ==
//: 4294967295` 的两个操作数都印 `4294967295`, 而 `-1 < 0` 那种带负字面量的才落 i32。
//: 自举侧原先只能落 0 (缺省 i32/有符号), 于是同一个比较印 `-1` (#679 shape 2)。
const CG_WANT_U32: u32 = 4294967293;

//: **`4294967292` = "源是内建返回的 ptr"** —— 只给 `cast_src_type` / `apply_cast`
//: 用。`expr_type` 对 `ptr_add(...)` 这类内建调用没有词可以指 (源里不一定出现 `ptr`
//: 这个词), 于是 `(ptr_add(cur, 1)) as u64` 原来按 u32 发 `zext` —— 操作数是 ptr,
//: 非法 IR, 且与参考实现的 `ptrtoint` 分叉 (#679)。
const CG_CAST_PTR: u32 = 4294967292;

fn emit_ty(s: ptr, out: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == CG_WANT_U32 {
        return emit_str(s, out, "i32");
    }
    let stt: u32 = subst_tok(s, src, toks, tt);   // 泛型实例: 类型参数 -> 具体类型
    if stt != tt {
        return emit_ty(s, out, src, toks, stt);
    }
    if tt == 4294967295 {   // UNIT: 无 `-> T` 的函数
        return emit_str(s, out, "void");
    }
    if tt == CG_TY_BOOL {
        return emit_str(s, out, "i1");
    }
    if tt == 0 {
        return emit_str(s, out, "i32");
    }
    if tok_is(src, toks, tt, "(") {   // unit 类型 `()`
        return emit_str(s, out, "void");
    }
    if tok_is(src, toks, tt, "bool") || tok_is(src, toks, tt, "true")
        || tok_is(src, toks, tt, "false") {
        return emit_str(s, out, "i1");
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return emit_str(s, out, "i8");
    }
    if tok_is(src, toks, tt, "ptr") {
        return emit_str(s, out, "ptr");
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return emit_str(s, out, "i16");
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return emit_str(s, out, "i32");
    }
    if tok_is(src, toks, tt, "str") {   // M1: 字节指针 + 长度
        return emit_str(s, out, "{ ptr, i64 }");
    }
    if is_slice_tok(src, toks, tt) == 1 {   // M3: 切片 = 元素指针 + 个数
        return emit_str(s, out, "{ ptr, i64 }");
    }
    if is_array_tok(src, toks, tt) == 1 {   // M24: 定长数组
        emit_str(s, out, "[");
        emit_dec(s, out, array_len_of(src, toks, tt));
        emit_str(s, out, " x ");
        emit_ty(s, out, src, toks, elem_tok(src, toks, tt));
        return emit_str(s, out, "]");
    }
    if tok_kind(toks, tt) == 0 {   // struct 名 / 枚举名
        let si: u32 = find_struct(s, src, toks, tt);
        if si != 4294967295 {
            return emit_struct_ty(s, out, src, toks, si);
        }
        let ei: u32 = find_enum(s, src, toks, tt);
        if ei != 4294967295 {
            return emit_enum_ty(s, out, ei);
        }
    }
    return emit_str(s, out, "i64");
}

fn is_signed(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == CG_WANT_U32 {
        return 0;
    }
    if tok_is(src, toks, tt, "i8") || tok_is(src, toks, tt, "i16")
        || tok_is(src, toks, tt, "i32") || tok_is(src, toks, tt, "i64") {
        return 1;
    }
    return 0;
}

/// 整型的位宽 (非整型 / 未定型 = 0)。`u32` 与 `i32` 同宽 —— LLVM 里也是同一个类型。
fn ty_bits(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == CG_WANT_U32 {
        return 32;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") { return 8; }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") { return 16; }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") { return 32; }
    if tok_is(src, toks, tt, "u64") || tok_is(src, toks, tt, "i64") { return 64; }
    return 0;
}

/// 移位 (c 9 = `<<`, 10 = `>>`)。**移位量不是参与运算的值** —— 它不参与公共类型,
/// 结果类型只看左操作数 (C/C++/Rust 都收任意整型的移位量)。
fn op_shift(c: u32) -> u32 {
    if c == 9 || c == 10 { return 1; }
    return 0;
}

/// 两个整型的**公共类型** (`lomentc._common_type`): 一个装得下两个值、且**不改变
/// 任何一个值**的类型。返回值**一定是两个入参之一** (或 0 = 没有) —— 所以不需要
/// 凭空造一个类型 token。计数与推理见 `tools/lomentc.py` 的 `_common_type`。
fn bin_common(src: ptr, toks: ptr, a: u32, b: u32) -> u32 {
    let wa: u32 = ty_bits(src, toks, a);
    let wb: u32 = ty_bits(src, toks, b);
    // 一侧没有类型（字面量）时**保留另一侧** —— 参考实现的 `_common_type(lt, None)`
    // 就是 `lt`。原来这里 `||` 直接返回 0，于是 `35 - j * 5`（j: u32）里那一折把
    // u32 折没了，最终落到外面那个 i64 期望类型上（#719 base32 的分叉）。
    if wa == 0 { return b; }
    if wb == 0 { return a; }
    let sa: u32 = is_signed(src, toks, a);
    let sb: u32 = is_signed(src, toks, b);
    if sa == sb {
        if wa >= wb { return a; }
        return b;
    }
    // 一有符号一无符号: 只有**无符号那个更窄**才有解 (宽的有符号装得下它全部取值)。
    if sa == 1 {
        if wb < wa { return a; }
        return 0;
    }
    if wa < wb { return b; }
    return 0;
}

/// 把第 lvl 层的值从 `frm` 抬到公共类型 `to` (只往宽走, 所以只有 `zext`/`sext`)。
/// 已经同宽就什么都不发 —— 与 `lomentc.Emitter.upcast` 逐字节同形 (含临时量编号顺序)。
fn emit_upcast(s: ptr, out: ptr, src: ptr, toks: ptr, lvl: u32, frm: u32, to: u32) {
    let wf: u32 = ty_bits(src, toks, frm);
    // `to == 0` = 类型未知, 参考实现落到 `u32` (32 位无符号) 再发指令 —— 这里必须
    // 按同一口径抬, 否则 `DIR_O_DIRECTORY(u64) == 65536` 少了参考那边的
    // `zext i64 65536 to i32`, 两个实现的 IR 不再逐字节相同 (#679)。
    let wt: u32 = 32;
    if to != 0 {
        wt = ty_bits(src, toks, to);
    }
    if wf != 0 && wt != 0 && wf != wt {
        emit_str(s, out, "  ");
        let n: u32 = new_temp(s, out);
        emit_str(s, out, " = ");
        if is_signed(src, toks, frm) == 1 {
            emit_str(s, out, "sext ");
        } else {
            emit_str(s, out, "zext ");
        }
        emit_ty(s, out, src, toks, frm);
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to ");
        emit_ty(s, out, src, toks, to);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, n);
    }
}

/// 类型 token 名 (供注释行用): tt==0 时缺省 "u32"。
/// 泛型实例在参考实现里是被 `_rewrite_types` 改名成 `Pair_u32` 的字面串, 这里等价地
/// 按 `基名_实参1_实参2` 折叠 (docs/156 §3: 结构体名与枚举名同样参与改名)。
fn emitted_name(s: ptr, out: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    // **虚拟类型哨兵**（内置返回/期望类型的编码）没有 token 原文可印 —— 与
    // `emit_ty` 同一口径先翻译掉，别让它们走到下面按 `tt*20` 读 token 的路。
    if tt == CG_WANT_U32 {
        return emit_str(s, out, "u32");
    }
    if tt == CG_TY_BOOL {
        return emit_str(s, out, "bool");
    }
    if tt == CG_CAST_PTR {
        return emit_str(s, out, "ptr");
    }
    let stn: u32 = subst_tok(s, src, toks, tt);   // 泛型实例: 注释里也要用具体类型
    if stn != tt {
        return emitted_name(s, out, src, toks, stn);
    }
    if tt == 4294967295 {
        return emit_str(s, out, "()");
    }
    if tt == 0 {
        return emit_str(s, out, "u32");
    }
    if tok_is(src, toks, tt, "(") {   // 注释里 unit 写作 `()`
        return emit_str(s, out, "()");
    }
    if is_slice_tok(src, toks, tt) == 1 {   // 切片的注释形式与源码一致 (`[T]` / `mut [T]`)
        if tok_is(src, toks, tt, "mut") {
            emit_str(s, out, "mut [");
        } else {
            emit_str(s, out, "[");
        }
        emitted_name(s, out, src, toks, elem_tok(src, toks, tt));
        return emit_str(s, out, "]");
    }
    if is_array_tok(src, toks, tt) == 1 {   // M24: 定长数组 -> `[T; N]`
        emit_str(s, out, "[");
        emitted_name(s, out, src, toks, elem_tok(src, toks, tt));
        emit_str(s, out, "; ");
        emit_dec(s, out, array_len_of(src, toks, tt));
        return emit_str(s, out, "]");
    }
    if tok_kind(toks, tt) == 0 && tok_is(src, toks, tt + 1, "<") {
        let si: u32 = find_struct(s, src, toks, tt);
        let ei: u32 = find_enum(s, src, toks, tt);
        if si != 4294967295 || ei != 4294967295 {
            emit_tok(s, out, src, toks, tt);
            emit_str(s, out, "_");
            let a: u32 = tt + 2;
            let r: u32 = emitted_name(s, out, src, toks, a);
            let af: u32 = skip_type(src, toks, a);
            if tok_is(src, toks, af, ",") {
                emit_str(s, out, "_");
                r = emitted_name(s, out, src, toks, af + 1);
            }
            return r;
        }
    }
    return emit_tok(s, out, src, toks, tt);
}

/// `as T` **左操作数**的类型 (apply_cast 的 from 侧专用)。j 必须是那个操作数的 `(`。
/// 不能用 `expr_type`: 对 `(v / 256) as u8` 它问的是**整个转型表达式**的类型 (u8),
/// 而这里要的是括号里那个表达式的类型。括号里可能是二元表达式, 参考实现的
/// `expr_type(Bin) = lt or rt`, 对左结合链展开就是"第一个操作数, 或某个**顶层**
/// 二元运算符右侧的操作数"。括号内的实参 (例如 `load8(tmp, ..)` 里的 `tmp`) 不算 ——
/// 它们属于子表达式, 按 token 逐个看会错误地拿到 `tmp` 的 ptr 类型。
///
/// **紧跟这个 `)` 的 `as` 属于外面那次转型**(apply_cast 正在处理的那次), 这里不吃 ——
/// 与「括号里那个表达式」自己的 `as` 由 `sub_expr_type` 处理。入口这一层必须分开:
/// 两个位置在 token 上长得**一模一样**, 只能靠"谁在调用"区分。
fn operand_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    return operand_bin_type(s, src, toks, j, skip_parens(src, toks, j));
}

/// 转型左侧的类型: 普通表达式走 `operand_type`; 指向**内建 ptr 返回**的那四个名字
/// (`alloc` / `str_ptr` / `ptr_add` / `ptr_sub`) 时给 `CG_CAST_PTR`。跳过外层括号,
/// 因为 `(ptr_add(x, 1)) as u64` 的第一个 token 是 `(`。
fn cast_src_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    let k: u32 = j;
    while tok_is(src, toks, k, "(") {
        k = k + 1;
    }
    if tok_is(src, toks, k, "alloc") || tok_is(src, toks, k, "str_ptr")
            || tok_is(src, toks, k, "ptr_add") || tok_is(src, toks, k, "ptr_sub") {
        return CG_CAST_PTR;
    }
    return operand_type(s, src, toks, j);
}

/// 子表达式在 j 处的类型 —— 括号透明, 且**认它自己的 `as`**。
/// 少了后半条, `(48 + (x % 10) as u32) as u8` 里那个右操作数会一路钻进括号取到
/// `x` 的类型 (u64), 于是发成 `trunc i64 %t to i8` 而 `%t` 是 `add i32` —— 自相矛盾的
/// IR (docs/189 第 39 条, 自举定点上唯一的分歧点)。
fn sub_expr_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    if tok_is(src, toks, j, "(") {
        let rp: u32 = skip_parens(src, toks, j);
        if tok_is(src, toks, rp + 1, "as") {
            return as_chain_end(src, toks, rp + 2);
        }
        return operand_bin_type(s, src, toks, j, rp);
    }
    return expr_type(s, src, toks, j);
}

/// [j+1, rp) 这一段的类型 —— **两条规则叠着用**，顺序不能换。
///
/// 1. **先看算子**（`#316`）：这一段的**最深那个**算子（`op_prec` 最小者，与 `expr_bin`
///    同一条取法）若是比较/逻辑（`&&` `||` `==` `!=` `<` `<=` `>` `>=`，即 `op_code`
///    的 1..8），那这一段就是 `bool`，**不看操作数是谁**。少了这一步，`(a < 0)` 会被顶成
///    `a` 的类型（i64），而它的值是 `i1`（`#316`）。
/// 2. **否则取操作数的公共类型**（`#133` / `#289`）：从第一个操作数起，按顶层二元运算符
///    逐个把右侧操作数的类型折进来（`bin_common`）。这正是参考实现的
///    `expr_type(Bin) = _common_type(lt, rt)` —— 而 `_common_type` 是格上的并
///    （交换/结合/等幂），所以按什么顺序折都得到同一个类型。
///    **只挑一个操作数**（原先挑左边）就是替用户改数：`x:i32 + y:i64` 在 32 位里算，
///    同一个子表达式一处等于 2³¹、一处为负。
///
/// 扫的时候**多记号算子整条跳掉**（`k = k + op_toks(c)`）：`>>` 是两个 `>` 记号，单看一个
/// `>` 会被 `op_code` 读成比较（7）—— 不跳的话 `(w[i] >> (i % 32)) & 1` 会被误判成 bool。
fn operand_bin_type(s: ptr, src: ptr, toks: ptr, j: u32, rp: u32) -> u32 {
    return operand_bin_type_from(s, src, toks, j + 1, rp);
}

/// 同上，但**第一个操作数从 `j0` 起**（不带括号的那些表达式用这一支）。
fn operand_bin_type_from(s: ptr, src: ptr, toks: ptr, j0: u32, rp: u32) -> u32 {
    let acc: u32 = expr_type_atom(s, src, toks, j0);
    let best: u32 = 0;
    let k: u32 = j0;
    let depth: u32 = 0;
    while k < rp {
        if tok_is(src, toks, k, "(") || tok_is(src, toks, k, "[") {
            depth = depth + 1;
            k = k + 1;
        } else if tok_is(src, toks, k, ")") || tok_is(src, toks, k, "]") {
            depth = depth - 1;
            k = k + 1;
        } else {
            let c: u32 = op_code(src, toks, k);
            if c == 0 {
                k = k + 1;
            } else {
                if depth == 0 {
                    if best == 0 || op_prec(c) < op_prec(best) {
                        best = c;
                    }
                    // **只看右操作数的 atom 类型**，不再整段递归：`1 + 1 + …`（250 项）
                    // 上那条递归会展开成指数级（每个算子都把剩下的链再型一遍），
                    // 自举编一份 250 项的字面量加法会跑过任何超时（`#226` 的
                    // `flat-250-terms` 实测 >120 秒）。公共类型是格上的并
                    // （交换/结合/等幂，见 `bin_common` 的注释），从左往右折与
                    // `common(lt, rt)` 的递归展开结果相同。
                    let t2: u32 = expr_type_atom(s, src, toks, k + op_toks(c));
                    if acc == 0 {
                        acc = t2;
                    } else if op_shift(c) == 0 && t2 != 0 {
                        let ct: u32 = bin_common(src, toks, acc, t2);
                        if ct != 0 {
                            acc = ct;
                        }
                    }
                }
                k = k + op_toks(c);
            }
        }
    }
    if best >= 1 && best <= 8 {
        return CG_TY_BOOL;
    }
    return acc;
}

// ---------------------------------------------------------------- 运算符

/// 运算符编码 (0 = 不是运算符)。
fn op_code(src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "|") {
        if tok_is(src, toks, i + 1, "|") {
            return 1;
        }
        return 17;
    }
    if tok_is(src, toks, i, "&") {
        if tok_is(src, toks, i + 1, "&") {
            return 2;
        }
        return 16;
    }
    if tok_is(src, toks, i, "=") {
        if tok_is(src, toks, i + 1, "=") {
            return 3;
        }
        return 0;
    }
    if tok_is(src, toks, i, "!") {
        if tok_is(src, toks, i + 1, "=") {
            return 4;
        }
        return 0;
    }
    if tok_is(src, toks, i, "<") {
        if tok_is(src, toks, i + 1, "=") {
            return 6;
        }
        if tok_is(src, toks, i + 1, "<") {
            return 9;
        }
        return 5;
    }
    if tok_is(src, toks, i, ">") {
        if tok_is(src, toks, i + 1, "=") {
            return 8;
        }
        if tok_is(src, toks, i + 1, ">") {
            return 10;
        }
        return 7;
    }
    if tok_is(src, toks, i, "+") {
        return 11;
    }
    if tok_is(src, toks, i, "-") {
        return 12;
    }
    if tok_is(src, toks, i, "*") {
        return 13;
    }
    if tok_is(src, toks, i, "/") {
        return 14;
    }
    if tok_is(src, toks, i, "%") {
        return 15;
    }
    if tok_is(src, toks, i, "^") {
        return 18;
    }
    return 0;
}

fn op_prec(c: u32) -> u32 {
    if c == 1 {
        return 1;
    }
    if c == 2 {
        return 2;
    }
    if c == 3 || c == 4 {
        return 3;
    }
    if c >= 5 && c <= 8 {
        return 4;
    }
    if c == 17 {
        return 5;
    }
    if c == 18 {
        return 6;
    }
    if c == 16 {
        return 7;
    }
    if c == 9 || c == 10 {
        return 8;
    }
    if c == 11 || c == 12 {
        return 9;
    }
    if c >= 13 && c <= 15 {
        return 10;
    }
    return 0;
}

fn op_toks(c: u32) -> u32 {
    if c <= 2 || (c >= 3 && c <= 4) || c == 6 || c == 8 || c == 9 || c == 10 {
        return 2;
    }
    return 1;
}

/// `k` 起是不是一个**负字面量** (`-` 紧跟整数字面量)?
/// 与参考侧 `_const_int` 同一条规则：两侧都没有声明类型时，负字面量参与比较/取模/移位
/// 要按**有符号**定宽（`#237` 第二处根；`if -1 < 0` 以前落 `icmp ult`，C/Go/Python/Rust
/// 都说真）。**故意只认这一种形状**，两边因此可证明一致。
fn neg_lit_at(src: ptr, toks: ptr, k: u32) -> u32 {
    if tok_is(src, toks, k, "-") && tok_kind(toks, k + 1) == 1 {
        return 1;
    }
    return 0;
}

/// 写指令助记符 (比较类带有无符号)。`sgn` = 1 时强制按有符号（无类型 + 负字面量）。
fn emit_mnemonic(s: ptr, out: ptr, src: ptr, toks: ptr, c: u32, tt: u32, sgn: u32) -> u32 {
    let sg: u32 = is_signed(src, toks, tt);
    if sgn == 1 {
        sg = 1;
    }
    if c == 3 {
        return emit_str(s, out, "icmp eq");
    }
    if c == 4 {
        return emit_str(s, out, "icmp ne");
    }
    if c == 5 {
        if sg == 1 {
            return emit_str(s, out, "icmp slt");
        }
        return emit_str(s, out, "icmp ult");
    }
    if c == 6 {
        if sg == 1 {
            return emit_str(s, out, "icmp sle");
        }
        return emit_str(s, out, "icmp ule");
    }
    if c == 7 {
        if sg == 1 {
            return emit_str(s, out, "icmp sgt");
        }
        return emit_str(s, out, "icmp ugt");
    }
    if c == 8 {
        if sg == 1 {
            return emit_str(s, out, "icmp sge");
        }
        return emit_str(s, out, "icmp uge");
    }
    if c == 9 {
        return emit_str(s, out, "shl");
    }
    if c == 10 {
        if sg == 1 {
            return emit_str(s, out, "ashr");
        }
        return emit_str(s, out, "lshr");
    }
    if c == 11 {
        return emit_str(s, out, "add");
    }
    if c == 12 {
        return emit_str(s, out, "sub");
    }
    if c == 13 {
        return emit_str(s, out, "mul");
    }
    if c == 16 {
        return emit_str(s, out, "and");
    }
    if c == 17 {
        return emit_str(s, out, "or");
    }
    return emit_str(s, out, "xor");
}

/// 除法/取模助记符 (c: 14=`/`, 15=`%`)。
fn emit_div_mnemonic(s: ptr, out: ptr, src: ptr, toks: ptr, c: u32, tt: u32, sgn: u32) -> u32 {
    let sg: u32 = is_signed(src, toks, tt);
    if sgn == 1 {
        sg = 1;
    }
    if c == 14 {
        if sg == 1 {
            return emit_str(s, out, "sdiv");
        }
        return emit_str(s, out, "udiv");
    }
    if sg == 1 {
        return emit_str(s, out, "srem");
    }
    return emit_str(s, out, "urem");
}

// ---------------------------------------------------------------- 符号表

fn find_fn(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 640) {
        let base: u32 = CG_FN + i * 12;
        let nt: u32 = load32(s, base);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

fn fn_ret(s: ptr, fi: u32) -> u32 {
    return load32(s, CG_FN + fi * 12 + 4);
}

/// 参数类型 (name_tok -> type_tok; 0 = 未找到)。
fn param_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 12) {
        let nt: u32 = load32(s, CG_CUR + i * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return subst_tok(s, src, toks, load32(s, CG_CUR + i * 8 + 4));
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `as T as U …` 的**最后一环的类型 token**（`t` 是某一环的目标）。
///
/// 参考实现的 `Cast` 是嵌套节点，所以链可以任意长；自举侧按 token 走，每个 atom
/// 只吃**第一环**。剩下的环由 `expr_bin` 补（见那里的 `while tok_is(... "as")`）。
/// 类型推断这边跟着走完，否则 `0 as u64 as ptr` 会被判成 `u64`（#719）。
fn as_chain_end(src: ptr, toks: ptr, t: u32) -> u32 {
    let r: u32 = t;
    while tok_is(src, toks, r + 1, "as") {
        r = r + 2;
    }
    return r;
}

/// 表达式类型推断 —— **二元表达式先看算子**（镜像 `lomentc.expr_type(Bin)`）。
///
/// 少了这一层，`5 * j` 这种右操作数的类型被算成 0（未知），于是 `acc >> (35 - 5 * j)`
/// 里那个减法落成 `sub i64`（外层移位的期望类型），而参考实现给出 `sub i32` + 一次
/// `zext` —— 两边分叉，且 `sub i64 %i32值` 是非法 IR（#719，`base32` 抓到）。
fn expr_type(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    let t: u32 = expr_type_atom(s, src, toks, j);
    if t != 0 {
        return t;                        // 第一个操作数自己带了类型：旧行为，够用
    }
    let c0: u32 = op_code(src, toks, j + 1);
    // 比较/逻辑不是"字面量开头的算术链"的一部分：`4 == j` / `4 && …` 里那个 `4`
    // 自己没有类型（参考实现的 `expr_type(IntLit)` 就是 None）。少了这道门，
    // `let ok: bool = k == 4 + 9 + 4 && …` 里最后的 `4` 会一路扫到 `&&`，
    // 被判成 `bool`，进而发 `add i1 4, 9`。
    if c0 != 0 && op_prec(c0) >= 5 {
        let end: u32 = operand_end(s, src, toks, j);
        return operand_bin_type_from(s, src, toks, j, end);
    }
    return 0;
}

/// 表达式到哪个 token 为止（不含）：深度 0 的 `;` `,` `)` `]` `}` 或 EOF。
fn operand_end(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    let k: u32 = j;
    let d: u32 = 0;
    let fp: u32 = 0;                 // 这一段里第一个深度 0 算子的优先级
    while tok_kind(toks, k) != 4 {
        if tok_is(src, toks, k, "(") || tok_is(src, toks, k, "[") {
            d = d + 1;
            k = k + 1;
        } else if tok_is(src, toks, k, ")") || tok_is(src, toks, k, "]")
                || tok_is(src, toks, k, "}") || tok_is(src, toks, k, "{") {
            // `{` 是**块的开头**，不是表达式的一部分：`while … && q < C - 1 {` 的
            // 条件在 `{` 处结束。当成开括号会一路扫进循环体，把体里的 `==` 折进
            // 条件里 —— 于是那个字面量开头的 `C - 1` 被判成 `bool`，发 `sub i1`
            // （自举自编译 driver.lomt 的 `cfg_source_ext` 抓到的 1 字节分叉）。
            if d == 0 {
                return k;
            }
            d = d - 1;
            k = k + 1;
        } else if d == 0 && (tok_is(src, toks, k, ";") || tok_is(src, toks, k, ",")) {
            return k;
        } else {
            let c: u32 = op_code(src, toks, k);
            if d == 0 && c != 0 {
                // **优先级更低就算下一段了**：`4 + 9 + 4 && …` 里 `&&` 不是
                // `4 + 9 + 4` 的一部分 —— 少了这条，字面量开头的操作数会被判成
                // `bool`（`&&` 是 1..8 档），`add i1 4, 9` 就从这儿来。
                if fp != 0 && op_prec(c) < fp {
                    return k;
                }
                if fp == 0 {
                    fp = op_prec(c);
                }
                k = k + op_toks(c);
            } else {
                k = k + 1;
            }
        }
    }
    return k;
}


/// 内建调用的**返回类型**（镜像 `lomentc.BUILTINS` 的第三格）。
///
/// 少了它，`load8(b, 0) == 18 && ...` 里 `==` 的两个操作数都没有类型，公共类型落到
/// **期望类型**上 —— 在 `return` 位置那是 `bool`，于是自举发 `icmp eq i1 %t, 18`
/// （参考发 `i32`）：两边分叉且 IR 非法（#719，`libl`/`stdio`/`stdlib` 抓到）。
///
/// 只回**有虚拟 token 的那两种**：u32 用 `CG_WANT_U32`、bool 用 `CG_TY_BOOL`。
/// `ptr` / `i64` 返回的内建（`alloc`/`str_ptr`/`ptr_add`/`ptr_sub`/`syscall*`/
/// `thread_spawn`）没有哨兵，回 0 —— 与改动前同一条"未知"的路，下游按需要兜。
/// `u8` 的那两个（`get_bits`/`set_bits`）同理。
fn builtin_ret(src: ptr, toks: ptr, j: u32) -> u32 {
    if tok_is(src, toks, j, "str_eq") {
        return CG_TY_BOOL;
    }
    if tok_is(src, toks, j, "str_len") || tok_is(src, toks, j, "str_byte")
            || tok_is(src, toks, j, "panic") || tok_is(src, toks, j, "free")
            || tok_is(src, toks, j, "load8") || tok_is(src, toks, j, "store8")
            || tok_is(src, toks, j, "atomic_add") || tok_is(src, toks, j, "inb")
            || tok_is(src, toks, j, "outb") || tok_is(src, toks, j, "slice_len") {
        return CG_WANT_U32;
    }
    return 0;
}

/// atom 的类型（标量子集）; 0 = 未知。
fn expr_type_atom(s: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    if tok_kind(toks, j) == 1 {
        if tok_is(src, toks, j + 1, "as") {   // 字面量的 `as T`
            return as_chain_end(src, toks, j + 2);
        }
        return 0;
    }
    if tok_kind(toks, j) == 0 {
        if tok_is(src, toks, j, "true") || tok_is(src, toks, j, "false") {
            return j;
        }
        if tok_is(src, toks, j + 1, "as") {   // `x as T`
            return as_chain_end(src, toks, j + 2);
        }
        if tok_is(src, toks, j + 1, ".") {   // M23: 字段类型
            let vt: u32 = var_type(s, src, toks, j);
            let si: u32 = find_struct(s, src, toks, vt);
            if si != 4294967295 {
                let fi: u32 = field_index(s, src, toks, si, j + 2);
                if fi != 4294967295 {
                    let vsub: u32 = push_ty_subst(s, src, toks, vt);   // 变量自己的实例化
                    let fr: u32 = field_type(s, src, toks, si, fi);
                    pop_subst(s, vsub);
                    return fr;
                }
            }
            return 0;
        }
        if tok_is(src, toks, j + 1, "(") {   // 调用 (可能带 `as T` 后缀)
            let cp: u32 = skip_parens(src, toks, j + 1);
            if tok_is(src, toks, cp + 1, "as") {
                return as_chain_end(src, toks, cp + 2);
            }
            let br: u32 = builtin_ret(src, toks, j);
            if br != 0 {
                return br;
            }
            let fi: u32 = find_fn(s, src, toks, j);
            if fi != 4294967295 {
                return fn_ret(s, fi);
            }
            return 0;
        }
        if tok_is(src, toks, j + 1, "[") {   // M3/M24: 下标 -> **元素类型**，不是数组/切片类型
            let at: u32 = var_type(s, src, toks, j);
            if is_array_tok(src, toks, at) == 1 || is_slice_tok(src, toks, at) == 1 {
                return elem_tok(src, toks, at);
            }
        }
        return var_type(s, src, toks, j);   // 参数或局部 (镜像 expr_type 的 scope)
    }
    if tok_is(src, toks, j, "(") {
        let rp2: u32 = skip_parens(src, toks, j);
        if tok_is(src, toks, rp2 + 1, "as") {
            return as_chain_end(src, toks, rp2 + 2);
        }
        // 括号**透明**, 但里面那一段要按 `expr_type(Bin)` 判 (算子优先, 见
        // `operand_bin_type`): 直接递归到 `j+1` 会把 `(a < 0)` 判成 `a` 的类型,
        // 而它的值是 `bool` (`#316`)。
        return operand_bin_type(s, src, toks, j, rp2);
    }
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        return expr_type(s, src, toks, j + 1);
    }
    return 0;
}

// ---------------------------------------------------------------- 单态化 (M6/M7, docs/156)

/// 类型参数替换表: 计数@16, 表项@24+i*8 (param_tok | value_tok)。
/// 值栈搬到 8192 之后, 状态块的 16..475 是空的, 这里就放在最前面。
fn sub_clear(s: ptr) {
    store32(s, 16, 0);
}

fn sub_push(s: ptr, ptok: u32, vtok: u32) {
    let n: u32 = load32(s, 16);
    store32(s, 24 + n * 8, ptok);
    store32(s, 24 + n * 8 + 4, vtok);
    store32(s, 16, n + 1);
}

/// 若 tt 正好是当前实例的类型参数, 换成具体类型 token (不在表里则原样返回)。
fn subst_tok(s: ptr, src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return 0;
    }
    let n: u32 = load32(s, 16);
    let i: u32 = 0;
    while i < n {
        if tok_eq(src, toks, load32(s, 24 + i * 8), tt) == 1 {
            return load32(s, 24 + i * 8 + 4);
        }
        i = i + 1;
    }
    return tt;
}

/// 声明处的类型参数 (name_tok 后面紧跟 `<`): 返回 tparam 下标 which 的 token, 无则 0。
/// `fn max<T>` / `struct Pair<T>` / `enum Opt<T>` 都是同一个形状。
fn decl_tparam(src: ptr, toks: ptr, name_tok: u32, which: u32) -> u32 {
    if !tok_is(src, toks, name_tok + 1, "<") {
        return 0;
    }
    if which == 0 {
        return name_tok + 2;
    }
    if which == 1 {
        return name_tok + 4;   // `<T, U>`: `<` T `,` U `>`
    }
    return 0;
}

/// 变量/参数的类型实参 (从其类型 token 后面的 `<...>` 直接读, 无需额外表):
/// `let p: Pair<u32>` -> 类型 token 是 `Pair`, 实参在 `Pair+2`。
fn var_targ(s: ptr, src: ptr, toks: ptr, name_tok: u32, which: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, name_tok);
    if ty == 0 || !tok_is(src, toks, ty + 1, "<") {
        return 0;
    }
    if which == 0 {
        return ty + 2;
    }
    if which == 1 {
        return ty + 4;
    }
    return 0;
}

/// 从"带类型实参的类型标注"推入替换表 (`Pair<u32>` -> Pair 的 tparam <-> u32),
/// 返回推入条数 (调用方据此 pop)。这样实例体内与字段表里的 `T` 都能解析。
fn push_ty_subst(s: ptr, src: ptr, toks: ptr, ty_tok: u32) -> u32 {
    if ty_tok == 0 || !tok_is(src, toks, ty_tok + 1, "<") {
        return 0;
    }
    // 同一个 `Pair` token 在声明处与使用处含义不同: 形参要从**声明**取, 实参从使用处取
    let p1: u32 = 0;
    let p2: u32 = 0;
    let si: u32 = find_struct(s, src, toks, ty_tok);
    if si != 4294967295 {
        p1 = load32(s, struct_base(si) + 72);
        p2 = load32(s, struct_base(si) + 76);
    } else {
        let ei: u32 = find_enum(s, src, toks, ty_tok);
        if ei != 4294967295 {
            p1 = load32(s, enum_base(ei) + 72);
            p2 = load32(s, enum_base(ei) + 76);
        }
    }
    let n: u32 = 0;
    if p1 != 0 {
        sub_push(s, p1, ty_tok + 2);
        n = 1;
    }
    if p2 != 0 && tok_is(src, toks, ty_tok + 3, ",") {
        sub_push(s, p2, ty_tok + 4);
        n = n + 1;
    }
    return n;
}

fn pop_subst(s: ptr, n: u32) {
    store32(s, 16, load32(s, 16) - n);
}

/// 函数表下标 fi 是否来自泛型声明 (声明名后面紧跟 `<`)。
fn is_generic_fn(s: ptr, src: ptr, toks: ptr, fi: u32) -> u32 {
    if fi == 4294967295 {
        return 0;
    }
    if tok_is(src, toks, load32(s, CG_FN + fi * 12) + 1, "<") {
        return 1;
    }
    return 0;
}

/// 实例表: 计数@64, 表项@72+i*12 (fn_tok | t1 | t2) —— 按"首次被用到"的顺序追加。
fn inst_count(s: ptr) -> u32 {
    return load32(s, 64);
}

fn inst_find(s: ptr, src: ptr, toks: ptr, fn_tok: u32, ta: u32, tb: u32) -> u32 {
    let n: u32 = load32(s, 64);
    let i: u32 = 0;
    while i < n {
        let b: u32 = 72 + i * 12;
        if tok_eq(src, toks, load32(s, b), fn_tok) == 1
                && tok_eq(src, toks, load32(s, b + 4), ta) == 1
                && tok_eq(src, toks, load32(s, b + 8), tb) == 1 {
            return i;
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 登记实例 (已存在则返回既有下标)。
fn inst_add(s: ptr, src: ptr, toks: ptr, fn_tok: u32, ta: u32, tb: u32) -> u32 {
    let got: u32 = inst_find(s, src, toks, fn_tok, ta, tb);
    if got != 4294967295 {
        return got;
    }
    let n: u32 = load32(s, 64);
    store32(s, 72 + n * 12, fn_tok);
    store32(s, 72 + n * 12 + 4, ta);
    store32(s, 72 + n * 12 + 8, tb);
    store32(s, 64, n + 1);
    return n;
}

/// 发射实例的函数名 (不含 `@`): 基名 + "_" + 各类型实参文本。
fn emit_inst_name(s: ptr, out: ptr, src: ptr, toks: ptr, ent: u32) -> u32 {
    let b: u32 = 72 + ent * 12;
    emit_tok(s, out, src, toks, load32(s, b) + 1);   // fn_tok 的下一个 token = 函数名
    emit_str(s, out, "_");
    emit_tok(s, out, src, toks, load32(s, b + 4));
    if load32(s, b + 8) != 0 {
        emit_str(s, out, "_");
        emit_tok(s, out, src, toks, load32(s, b + 8));
    }
    return st_o(s);
}

// ---------------------------------------------------------------- trait/impl 表 (M8)

/// 每个函数槽的附加信息 (与函数表同序): kind | recv_tok
/// kind: 0 = 普通函数, 1 = trait 声明里的方法 (不发射), 2 = impl 方法 (名字 = <recv>_<方法>)
fn fk_base(i: u32) -> u32 {
    return CG_FK + i * 8;
}

/// 按 (接收者类型, 方法名) 找 impl 方法的函数表下标; 未找到返回 4294967295。
fn find_method(s: ptr, src: ptr, toks: ptr, recv_tok: u32, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 640) {
        if load32(s, fk_base(i)) == 2 && tok_eq(src, toks, load32(s, fk_base(i) + 4), recv_tok) == 1 {
            let nt: u32 = load32(s, CG_FN + i * 12);
            if tok_eq(src, toks, nt, name_tok) == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 发射 impl 方法的 LLVM 名 (不含 `@`): <接收者类型名>_<方法名>。
fn emit_method_name(s: ptr, out: ptr, src: ptr, toks: ptr, fi: u32) -> u32 {
    emit_tok(s, out, src, toks, load32(s, fk_base(fi) + 4));
    emit_str(s, out, "_");
    return emit_tok(s, out, src, toks, load32(s, CG_FN + fi * 12));
}

/// 发射变量名 (self -> __self; 其余原样)。所有"名字"位置的输出都要过这里。
fn emit_name_tok(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "self") {
        return emit_str(s, out, "__self");
    }
    return emit_tok(s, out, src, toks, i);
}

/// `?` 的反糖 (lomentc._desugar_try) 会在 IR 里凭空造出 `__t{line}`/`__v{line}`/
/// `__e{line}` 三个局部, 它们没有对应的源码 token。局部表的名字槽因此是两种编码共用
/// 的 u32: 位 31 置位 = 合成名 (值 = 0x80000000 + k*0x1000000 + line, k: 0=t 1=v 2=e),
/// 否则就是普通 token 下标 (真实下标远小于 2^31, 不会撞)。
fn syn_name(k: u32, line: u32) -> u32 {
    return 2147483648 + k * 16777216 + line;
}

fn emit_syn(s: ptr, out: ptr, k: u32, line: u32) -> u32 {
    emit_str(s, out, "__");
    if k == 0 {
        emit_str(s, out, "t");
    } else if k == 1 {
        emit_str(s, out, "v");
    } else {
        emit_str(s, out, "e");
    }
    return emit_dec(s, out, line);
}

/// 发射局部名: 合成名走 emit_syn, 真实 token 走 emit_name_tok。
fn emit_local_name(s: ptr, out: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    if nm >= 2147483648 {
        return emit_syn(s, out, (nm - 2147483648) / 16777216, nm % 16777216);
    }
    return emit_name_tok(s, out, src, toks, nm);
}

// ---------------------------------------------------------------- L0 静态提升 (docs/210 §2)

/// 白名单里的系统调用号？（`docs/246` §5.3）**512 位位图，16 个 u32** —— 号抄自内核头文件
/// （`/usr/include/x86_64-linux-gnu/asm/unistd_64.h`），与 `lomentc._SYSCALL_BORROWS` 同表。
/// 故意不入的那几族写在那边注释里（clone / sendmsg 带 MSG_ZEROCOPY / io_uring / perf / bpf / ioctl）。
fn syscall_short(nr: u32) -> u32 {
    if nr >= 512 {
        return 0;
    }
    let w: [u32; 16] = [12452087, 2295989256, 266322176, 1, 0, 0, 33555456, 528,
                        16842710, 1342177280, 4096, 0, 0, 0, 0, 0];
    return (w[nr / 32] >> (nr % 32)) & 1;
}

/// **系统调用的实参是"借"**（`docs/246` §5.3）：`v` 处的名字是 `v as <类型>`、整个实参就是
/// 这次 cast，外层调用是 `syscall4/6/7` 之一、第一个实参是**白名单里的字面量号**。
/// 只认这三个名字（不认"以 syscall 开头"）：这里没有前缀比较，而两边必须同判。
fn syscall_borrow_ok(src: ptr, toks: ptr, v: u32) -> bool {
    if !(tok_kind(toks, v + 1) != 2 && tok_is(src, toks, v + 1, "as")
            && tok_kind(toks, v + 2) == 0
            && tok_kind(toks, v + 3) != 2
            && (tok_is(src, toks, v + 3, ",") || tok_is(src, toks, v + 3, ")"))) {
        return false;                       // 形状不是"整个实参就是这次 cast"
    }
    let depth: u32 = 0;
    let j: u32 = v - 1;
    let stop: u32 = 0;
    while j > 0 && stop == 0 {              // 往前找**未闭合**的那个 `(`
        if tok_kind(toks, j) != 2 {
            if tok_is(src, toks, j, ")") {
                depth = depth + 1;
            } else if tok_is(src, toks, j, "(") {
                if depth == 0 {
                    stop = 1;
                } else {
                    depth = depth - 1;
                }
            }
        }
        if stop == 0 {
            j = j - 1;
        }
    }
    if stop == 0 || j < 1 {
        return false;
    }
    if !(tok_kind(toks, j - 1) == 0 && tok_kind(toks, j + 1) == 1) {
        return false;                       // 被调名 / 号：必须分别是标识符与数字字面量
    }
    if !(tok_is(src, toks, j - 1, "syscall4") || tok_is(src, toks, j - 1, "syscall6")
            || tok_is(src, toks, j - 1, "syscall7")) {
        return false;
    }
    return syscall_short(tok_int(src, toks, j + 1)) == 1;
}

/// 出现点判据（`docs/246` §5.3）：`v` 处的名字**这次出现算不算"没外逃"** ——
/// ① 是某个 `l0_safe_callee` 的**整个第一个实参**（老规则）；或 ② 是"借"（见上）。
fn gc_occ_ok(src: ptr, toks: ptr, v: u32, tbl: ptr) -> bool {
    if v >= 2 && tok_is(src, toks, v - 1, "(") && l0_safe_callee(src, toks, v - 2, tbl)
            && (tok_is(src, toks, v + 1, ",") || tok_is(src, toks, v + 1, ")")) {
        return true;
    }
    return syscall_borrow_ok(src, toks, v);
}

/// 被调 `i` 安不安全 —— **首参不会因为这次调用而外逃**。两类：
///
///   * 三个内建 `load8` / `store8` / `atomic_add`（`.lomentc._L0_SAFE_BUILTINS` 那张表，
///     逐条理由在那边）；
///   * **首参不外逃的用户函数**（`tbl` 里那些，见 `compute_safe`）—— **`docs/210` §7 那次
///     放宽**。`load16/32/64`、`store16/32/64` 原来被排除（"p 进了别人的栈帧"），现在
///     只要那个函数**只把首参透给安全的被调**（`load32 -> load16 -> load8`），它就够格 ——
///     于是 `bytes.lomt` 的库函数对 L0/L1/L2 都成了安全被调。**这是 L0 那一处最窄的放宽。**
///
/// 限定名（`x.p`）不是内建、也不是我们的用户函数。
pub fn l0_safe_callee(src: ptr, toks: ptr, i: u32, tbl: ptr) -> bool {
    if i == 0 || tok_kind(toks, i) != 0 {
        return false;
    }
    if tok_is(src, toks, i - 1, ".") || tok_is(src, toks, i - 1, ":") {
        return false;   // 限定名不是内建、也不是我们的用户函数
    }
    if tok_is(src, toks, i, "load8") || tok_is(src, toks, i, "store8")
            || tok_is(src, toks, i, "atomic_add") {
        return true;
    }
    // **跨函数 deref-only 放宽**（`docs/210` §7）：`tbl` 里那些"首参不外逃"的用户函数，
    // 调用它们与调内建**一样安全**（首参不会流到别处）。
    return safe_by_tok(src, toks, i, tbl) == 1;
}

/// token `i` 的名字在安全名表 `tbl` 里吗（按**文本**比，不看下标 —— 调用点与声明处是
/// 两个 token）。表形如 `[count, name_tok_1, name_tok_2, …]`。
pub fn safe_by_tok(src: ptr, toks: ptr, i: u32, tbl: ptr) -> u32 {
    let n: u32 = load32(tbl, 0);
    let j: u32 = 1;
    while j <= n {
        if tok_eq(src, toks, load32(tbl, j * 4), i) == 1 {
            return 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 试把 `nm`（一个 `fn` 的名字 token）标进安全名表 —— 够格就标、回 1（**变了**），否则回 0。
///
/// 规则与参考实现的 `_deref_summary` + `_gc_alpha_pass` 的不动点**同一条**（定义在 token 流上）：
/// 首参是 `ptr`，且它在函数体内**每一处**出现都必须是"**整个第一个实参**" —— 紧跟 `(`、
/// 那个 `(` 紧跟一个标识符被调名（不是限定名）、且首参后面紧跟 `,` 或 `)` —— 而那个被调
/// **本身安全**（内建或已在表里）。任何别的用法即逃逸，不标。
fn safe_mark_fn(src: ptr, toks: ptr, nm: u32, tbl: ptr) -> u32 {
    if safe_by_tok(src, toks, nm, tbl) == 1 {
        return 0;                                   // 已经在表里
    }
    // 找形参表的 `(`（跳过函数名与 `<...>`）
    let lp: u32 = nm + 1;
    let g1: u32 = 0;
    while tok_kind(toks, lp) != 4 && !tok_is(src, toks, lp, "(") && g1 < 64 {
        lp = lp + 1;
        g1 = g1 + 1;
    }
    if !tok_is(src, toks, lp, "(") {
        return 0;
    }
    let p: u32 = lp + 1;
    if tok_kind(toks, p) != 0 || tok_is(src, toks, p, "self") {
        return 0;                                   // 首参不是普通标识符（空表 / self）
    }
    if !(tok_is(src, toks, p + 1, ":") && tok_is(src, toks, p + 2, "ptr")) {
        return 0;                                   // 首参不是 ptr
    }
    // 函数体的 `{`
    let b: u32 = p + 3;
    let g2: u32 = 0;
    while tok_kind(toks, b) != 4 && !tok_is(src, toks, b, "{") && g2 < 8192 {
        b = b + 1;
        g2 = g2 + 1;
    }
    if !tok_is(src, toks, b, "{") {
        return 0;
    }
    let at: u32 = b + 1;
    let end: u32 = skip_block(src, toks, b) - 1;
    let k: u32 = at;
    while k < end {
        if tok_kind(toks, k) == 0 && tok_eq(src, toks, k, p) {
            if tok_is(src, toks, k - 1, "let") || tok_is(src, toks, k + 1, "=") {
                return 0;                           // 遮蔽 / 重新赋值
            }
            if !(k >= 2 && tok_is(src, toks, k - 1, "(") && tok_kind(toks, k - 2) == 0
                    && !tok_is(src, toks, k - 3, ".") && !tok_is(src, toks, k - 3, ":")
                    && (tok_is(src, toks, k + 1, ",") || tok_is(src, toks, k + 1, ")"))
                    || syscall_borrow_ok(src, toks, k)) {
                return 0;                           // 其余任何用法：逃逸
            }
            if l0_safe_callee(src, toks, k - 2, tbl) == false
                    && !syscall_borrow_ok(src, toks, k) {
                return 0;                           // 被调本身还不安全（"借"那一支不必）
            }
        }
        k = k + 1;
    }
    let c: u32 = load32(tbl, 0);
    store32(tbl, (c + 1) * 4, nm);
    store32(tbl, 0, c + 1);
    return 1;
}

/// 算安全名表（`tbl`，写进调用方给的缓冲）—— 全局不动点：`safe = 三个内建`；反复把
/// "首参不外逃、且只流进安全被调"的用户函数加进去，直到不动。于是 `load32 -> load16 ->
/// load8` 一层层解开。**与 `potato.lomt` 共用**（那边 `use codegen` 调这一支）——
/// 同一份扫描 ⇒ 两边集合相同。回表里的条数。
pub fn compute_safe(src: ptr, toks: ptr, tbl: ptr) -> u32 {
    store32(tbl, 0, 0);
    let ch: u32 = 1;
    let rounds: u32 = 0;
    while ch == 1 && rounds < 256 {
        ch = 0;
        rounds = rounds + 1;
        let i: u32 = 0;
        while tok_kind(toks, i) != 4 {
            if tok_is(src, toks, i, "fn") && !(i > 0 && tok_is(src, toks, i - 1, "extern"))
                    && tok_kind(toks, i + 1) == 0 {
                if safe_mark_fn(src, toks, i + 1, tbl) == 1 {
                    ch = 1;
                }
            }
            i = i + 1;
        }
    }
    return load32(tbl, 0);
}

/// L0 提升的字节数（0 = 不提升）。`nm` 是那个局部**名字的 token 下标**。
///
/// **与 `lomentc._l0_promotable` 同一套规则** —— 规则定义在 **token 流**上，不是 AST 上；
/// 理由在那边 docstring 里（AST 走法有两个自举侧补不平的洞：不在表达式位置上的名字，
/// 和根本不递归下去的节点）。token 流是两边**唯一都完整持有的**表示，所以规则写在这儿。
///
/// 规则（候选形状只有 `let NAME: ptr = alloc(<整数字面量>);`，共 10 个 token）：
///
/// 1. `NAME` 不是形参（否则会撞上遮蔽）；
/// 2. 本函数体内 `NAME` 这个**标识符 token** 只出现在两种位置 ——
///    (a) **恰好一处**紧跟 `let` 之后（就是 `nm` 自己那条声明）；
///    (b) 其余每一处都紧跟 `(`，而那个 `(` 紧跟一个 `l0_safe_callee` 的名字，
///        且 `NAME` 后面紧跟 `,` 或 `)`（即**恰好是整个第一个实参**）；
/// 3. 尺寸（按 u32 回绕）> 0。
///
/// (b) 等价于"只被读/写透过、从不外逃"；提升后的缓冲是**入口块的一条 alloca**，
/// 活满整个函数调用，所以**不需要**"引用不出块"那条约束。
pub fn l0_size_at(src: ptr, toks: ptr, nm: u32, at: u32, end: u32,
                   npar: u32, par: ptr, tbl: ptr) -> u32 {
    let q: u32 = 0;
    while q < npar {                                // 形参同名 -> 不提升
        if tok_eq(src, toks, load32(par, q * 8), nm) {
            return 0;
        }
        q = q + 1;
    }
    if nm < at || nm < 2 || nm + 8 >= end {         // 候选形状 (就在 nm 自己身上)
        return 0;                                   // nm<2 是防御: 形状要往回看两格
    }
    if !(tok_is(src, toks, nm - 1, "let") && !tok_is(src, toks, nm - 2, "if")
            && tok_is(src, toks, nm + 1, ":") && tok_is(src, toks, nm + 2, "ptr")
            && tok_is(src, toks, nm + 3, "=") && tok_is(src, toks, nm + 4, "alloc")
            && tok_is(src, toks, nm + 5, "(") && tok_kind(toks, nm + 6) == 1
            && tok_is(src, toks, nm + 7, ")") && tok_is(src, toks, nm + 8, ";")) {
        return 0;
    }
    let k: u32 = at;
    while k < end {
        if k != nm && tok_kind(toks, k) == 0 && tok_eq(src, toks, k, nm) {
            if tok_is(src, toks, k - 1, "let") {
                return 0;                           // 第二处声明 (遮蔽)
            }
            if tok_is(src, toks, k + 1, "=") {
                return 0;                           // 重新赋值
            }
            if !(gc_occ_ok(src, toks, k, tbl)) {
                return 0;                           // 其余任何用法: 外逃
            }
        }
        k = k + 1;
    }
    return tok_int(src, toks, nm + 6);
}

/// `l0_size_at` 的 `s` 包装 —— 从状态块取"当前函数的跨度 / 形参表"。发射路径走这一支；
/// 数 `gc_ladder`（`docs/210` §5）那一支自己给显式参数，见 `potato.lomt`。
fn l0_size(s: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    return l0_size_at(src, toks, nm, load32(s, 564), load32(s, 568),
                      load32(s, 12), ptr_add(s, CG_CUR), ptr_add(s, CG_SAFE));
}

/// 入口块的 L0 缓冲 alloca（紧跟 `.addr` 之后发，与 `lomentc.locals_prologue` 同序）。
/// 类型是 **`[K x i64]`** 而不是 `[N x i8]`：单条数组类型两个链接器都吃，而且**天然 8 字节
/// 对齐** —— 与 `__loment_alloc` 返回的地址同对齐，于是 `store64` 那条默认对齐假设成立。
fn emit_l0_buf(s: ptr, out: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    if load32(s, 572) == 0 || nm >= 2147483648 {    // 非 alpha 档 / 合成名 -> 不碰
        return 0;
    }
    let n: u32 = l0_size(s, src, toks, nm);
    if n == 0 {
        return 0;
    }
    emit_str(s, out, "  %");
    emit_local_name(s, out, src, toks, nm);
    emit_str(s, out, ".buf = alloca [");
    emit_dec(s, out, (n + 7) / 8);
    return emit_str(s, out, " x i64]\n");
}

/// 这条 `let` 是不是 L0 提升的那一条 —— 是就发
/// `store ptr %NAME.buf, ptr %NAME.addr` 并回 1（调用方据此跳过整条语句）。
/// 形状由 `l0_size` 认死（10 个 token），所以返回 1 时语句正好到 `j + 9` 的 `;` 为止。
fn l0_store(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32) -> u32 {
    if load32(s, 572) == 0 {
        return 0;
    }
    let nm: u32 = j + 1;
    if l0_size(s, src, toks, nm) == 0 {
        return 0;
    }
    emit_str(s, out, "  store ptr %");
    emit_local_name(s, out, src, toks, nm);
    emit_str(s, out, ".buf, ptr %");
    emit_local_name(s, out, src, toks, nm);
    emit_str(s, out, ".addr\n");
    return 1;
}

// ---------------------------------------------------------------- L2 块纪元 (docs/210 §2)

/// 循环体能不能在末尾**批量归还**（把分配器前沿退回去）—— 与 `lomentc._l2_ok` 同一套规则。
///
/// "回收时间而不是对象"今天能落地的那一半：体结束时整段一次性不存在 —— 不扫描、不逐个
/// 释放、不用链表。**规则也定义在 token 流上**（理由见 `l0_size`）：`at`/`end` 是循环体的
/// token 跨度（半开），函数体的跨度取状态块里的 564/568。
///
/// 1. 体内**至少有一个** `alloc`；2. 体内**不许有 `str_concat`**（它落在堆上，而 `str` 的
/// 逃逸这里看不见）；3. 体内**每一个** `alloc` 都要长成 `let NAME: ptr = alloc(...)`
/// （尺寸随便 —— 常量是 L0 的事），认不出来就整格取消；4. 那些 `NAME` 在**循环体之后**的
/// 函数体内一处都不许出现；5. 体内只许出现在声明处或**恰好作为** `l0_safe_callee` 的整个
/// 第一个实参。
///
/// **L0 已经提到栈上的名字豁免 4、5**（它不碰 arena）。**代价是"整体取消"**：体内一个分配
/// 出体，整格就不能归还 —— 用表达力换零成本（`docs/210` §4.4），不是缺陷。
pub fn l2_ok_at(src: ptr, toks: ptr, at: u32, end: u32, fat: u32, fend: u32,
                npar: u32, par: ptr, tbl: ptr) -> u32 {
    let nalloc: u32 = 0;
    let k: u32 = at;
    while k < end {
        if tok_is(src, toks, k, "str_concat") {
            return 0;
        }
        if tok_is(src, toks, k, "free") {
            // 体内不许 free: 前沿在体内只增不减, 末尾一条无条件写回才对。
            // **证明**（管的范围比体内那一层调用大 —— 被调函数里也能 free）:
            //   ① 能把前沿往下的只有 __loment_free, 它只在"释放的块正好顶到前沿"时才往下;
            //   ② 顶到前沿的块, 要么是体内分配的(那要把它交给别人, 第 4 条已经挡住),
            //      要么是体外分配的 —— 而它不可能跨过 sv(跨过就与体内那些块重叠了)。
            // 于是末尾 off 必然 >= sv。而取 min 要 select, 自举镜像链接器没有 select。
            return 0;
        }
        if tok_is(src, toks, k, "alloc") {
            nalloc = nalloc + 1;
        }
        k = k + 1;
    }
    if nalloc == 0 {
        return 0;
    }
    let ncand: u32 = 0;
    let nlive: u32 = 0;
    let d: u32 = at;
    while d < end {
        let nm: u32 = d + 1;
        if tok_is(src, toks, d, "let") && !tok_is(src, toks, d - 1, "if") && nm + 5 < end
                && tok_kind(toks, nm) == 0 && tok_is(src, toks, nm + 1, ":")
                && tok_is(src, toks, nm + 2, "ptr") && tok_is(src, toks, nm + 3, "=")
                && tok_is(src, toks, nm + 4, "alloc") && tok_is(src, toks, nm + 5, "(") {
            ncand = ncand + 1;
            if l0_size_at(src, toks, nm, fat, fend, npar, par, tbl) == 0 {   // 提到栈上的豁免（它不欠这次归还）
                nlive = nlive + 1;
                let ndecl: u32 = 0;
                let p: u32 = at;
                while p < end {
                    if tok_kind(toks, p) == 0 && tok_eq(src, toks, p, nm) {
                        if p == nm {
                            ndecl = ndecl + 1;
                        } else if tok_is(src, toks, p - 1, "let") {
                            return 0;             // 体内第二处声明（遮蔽）
                        } else if tok_is(src, toks, p + 1, "=") {
                            return 0;             // 重新赋值
                        } else if !(gc_occ_ok(src, toks, p, tbl)) {
                            return 0;
                        }
                    }
                    p = p + 1;
                }
                if ndecl != 1 {
                    return 0;
                }
                // **只查体之后** —— 体之前不可能用到体里声明的那个名字（作用域）
                // **而且扫到同一层下一次同名 `let` 就停**（#364 的第三条边界）：语言没有
                // 块作用域（docs/228 的根），一个名字被新的 `let` 重新声明之后，后面那些
                // 出现就属于新的那个变量，不再证明这一块出体了。停在那一处之前是 sound 的
                // —— 之前每一次出现都还指这一块。
                // **另一个块里的同名 `let` 不算"换主人"**（#714）：它可能藏在一条没跑的
                // 分支里（体后面一个不成立的 `if { let NAME = … }`），那之后名字没有换主人，
                // 后面的出体使用仍指这一块。静态上认不出那条路跑没跑 ⇒ 整格取消（保守）。
                // 深度用 `{`/`}` 数：`q` 从体自己的 `}` 起步，同层 = 0，嵌进块 = 1，外层 < 0。
                let ld: i32 = 1;
                let q: u32 = end;
                while q < fend {
                    if tok_kind(toks, q) == 0 && tok_eq(src, toks, q, nm) {
                        if q > 0 && tok_is(src, toks, q - 1, "let") {
                            if ld != 0 {
                                return 0;             // 另一个块里的重声明: 那条路可能没跑
                            }
                            q = fend;                 // 同一层的重声明: 换了主人
                        } else {
                            return 0;                 // 出体了
                        }
                    } else if tok_is(src, toks, q, "{") {
                        ld = ld + 1;
                    } else if tok_is(src, toks, q, "}") {
                        ld = ld - 1;
                    }
                    q = q + 1;
                }
            }
        }
        d = d + 1;
    }
    if nlive == 0 {
        return 0;                                 // 分配都提到栈上了 -> 没什么可归还的
    }
    if nalloc == ncand {
        return 1;                                 // 有认不出来的分配 -> 整格取消
    }
    return 0;
}

/// `l2_ok_at` 的 `s` 包装（当前函数的跨度 / 形参表从状态块取）。
fn l2_ok(s: ptr, src: ptr, toks: ptr, at: u32, end: u32) -> u32 {
    let fat: u32 = load32(s, 564);
    let fend: u32 = load32(s, 568);
    return l2_ok_at(src, toks, at, end, fat, fend, load32(s, 12), ptr_add(s, CG_CUR),
                    ptr_add(s, CG_SAFE));
}

/// 纪元关：把前沿写回入口那一刻的值（`sv` = 入口记下的 temp 号；0 = 这一格没开纪元）。
///
/// **一条 `store` 就够** —— 规则（`l2_ok`）要求体内没有 `free`，于是前沿在体内**只增不减**，
/// 末尾那个值必然 >= `sv`。若体内能 `free`，这里就得取 `min`，而 `min` 要 `select`，
/// **自举镜像链接器不支持 `select`**（`lomelf.py` 的 `lower` 里没有它）—— 包内链接器就是它。
/// 体已经终止（`return`/`break`）时不发：那条路少归还一次，**不错**。
fn epoch_close(s: ptr, out: ptr, sv: u32) -> u32 {
    if sv == 0 || load32(s, 476) != 0 {
        return 0;
    }
    emit_str(s, out, "  store i32 %t");
    emit_dec(s, out, sv);
    return emit_str(s, out, ", ptr @__loment_off\n");
}

// ---------------------------------------------------------------- L1 定活 (docs/210 §2.5)

/// `return` 那条语句的**结束**（它的 `;` 下标）。从 `i`（"return" 自己那个 token）往后扫，
/// 只认**括号深度 0** 上的 `;` —— `return f(x);` 里的括号要配平。
fn ret_end(src: ptr, toks: ptr, i: u32, end: u32) -> u32 {
    let j: u32 = i + 1;
    let depth: u32 = 0;
    while j < end {
        if tok_is(src, toks, j, "(") {
            depth = depth + 1;
        }
        if tok_is(src, toks, j, ")") {
            depth = depth - 1;
        }
        if depth == 0 && tok_is(src, toks, j, ";") {
            return j;
        }
        j = j + 1;
    }
    return end;
}

/// `[a, b)` 里有没有**结束在 `last` 之后**的 `return`。L1 的落点判据要它两次：落点一
/// 要求"手上这条是最早的"（在它之前的一条都不许算数），落点二要求"一条都没有"。
fn ret_after(src: ptr, toks: ptr, a: u32, b: u32, last: u32, end: u32) -> u32 {
    let i: u32 = a;
    while i < b {
        if tok_is(src, toks, i, "return") && ret_end(src, toks, i, end) > last {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// `NAME` 是不是"**只被解引用透过、从不外逃**"（与 `lomentc._ptr_only_uses` 同一条判据），
/// 并把**最后一次出现**的下标落进槽 584。回 1/0。
///
/// 与 L0 **共用理由但不是同一格**：L0 还要求尺寸是字面量（它要开栈缓冲），这一层不要
/// （它只管还）。所以这边不调 `l0_size`，用自己这条 —— 而调用方靠"`l0_size` 非 0"
/// 把 L0 已经提走的排除掉（提走的根本不碰 arena）。
pub fn l1_ptr_only_at(src: ptr, toks: ptr, nm: u32, at: u32, end: u32,
                      npar: u32, par: ptr, out: ptr, tbl: ptr) -> u32 {
    let q: u32 = 0;
    while q < npar {                                 // 形参同名 -> 不是候选
        if tok_eq(src, toks, load32(par, q * 8), nm) {
            return 0;
        }
        q = q + 1;
    }
    let ndecl: u32 = 0;
    let lst: u32 = 0;
    let k: u32 = at;
    while k < end {
        if tok_kind(toks, k) == 0 && tok_eq(src, toks, k, nm) {
            lst = k;
            if k == nm {
                ndecl = ndecl + 1;
            } else if tok_is(src, toks, k - 1, "let") {
                return 0;                            // 第二处声明（遮蔽）
            } else if tok_is(src, toks, k + 1, "=") {
                return 0;                            // 重新赋值
            } else if !(gc_occ_ok(src, toks, k, tbl)) {
                return 0;                            // 其余任何用法：外逃
            }
        }
        k = k + 1;
    }
    if ndecl != 1 || lst == nm {
        return 0;                                    // 声明不止一处 / 一次都没用过
    }
    store32(out, 0, lst);
    return 1;
}

/// `l1_ptr_only_at` 的 `s` 包装：跨度 / 形参表从状态块取，"最后一次用处"落进槽 584
/// （`emit_l1` 要读它）。数 `gc_ladder` 那一支自己给 `out`（见 `potato.lomt`）。
fn l1_ptr_only(s: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    return l1_ptr_only_at(src, toks, nm, load32(s, 564), load32(s, 568),
                          load32(s, 12), ptr_add(s, CG_CUR), ptr_add(s, 584),
                          ptr_add(s, CG_SAFE));
}

/// 别名集里有没有这个 token？`cnt` 之外的槽是空的（0），所以它们不参与比较。
fn slot_grp_has(src: ptr, toks: ptr, g0: u32, g1: u32, g2: u32, g3: u32, cnt: u32, x: u32) -> u32 {
    if cnt >= 1 && tok_eq(src, toks, x, g0) {
        return 1;
    }
    if cnt >= 2 && tok_eq(src, toks, x, g1) {
        return 1;
    }
    if cnt >= 3 && tok_eq(src, toks, x, g2) {
        return 1;
    }
    if cnt >= 4 && tok_eq(src, toks, x, g3) {
        return 1;
    }
    return 0;
}

/// 别名集第 `i` 个槽（`i < cnt`，调用方保证）。
fn slot_grp_at(g0: u32, g1: u32, g2: u32, g3: u32, i: u32) -> u32 {
    if i == 0 {
        return g0;
    }
    if i == 1 {
        return g1;
    }
    if i == 2 {
        return g2;
    }
    return g3;
}

/// **块内精确**（`docs/210` §2.9）：站点 `let NAME: ptr = alloc(...);` 的**槽掩码** ——
/// 位 k 置位 = 载荷第 k 个 8 字节字**可能**是指针。回 `4294967295` = **不精确**（退回保守）。
///
/// 与参考实现 `lomentc._slot_plan` **同判**，四条：
///   1. `l1_ptr_only_at` 过得去的站点**不要掩码** —— 那块要么被 L0 提上栈、要么被 L1 定活
///      还掉，两条路都到不了收集器。于是这一格**只对 L3 可能成立**（`docs/210` §2.9）；
///   2. **别名集**（`let Q: ptr = R;` 且 `R` 已在集里）最多 **4** 个名字，超了退回保守。
///      集里每个名字在函数体内**每一处**都只能是：那条声明、一条别名声明、
///      `store8(N, <字面量>, V)` 或 `load8(N, ...)` 的**第一个实参**；别的用法退回保守；
///   3. `store8` 写的那个**字**（`off >> 3`）置位，**除非**值是整数字面量（`-1` 也算）。
///      名字、表达式、转型**一律**算"可能是指针" —— **宁严勿宽**：多算一个槽只少一格精度，
///      漏算一个槽就是**把活着的指针当垃圾**；
///   4. 字下标 ≥ 32 退回保守（掩码只有一个 u32）。
///
/// **为什么安全**：第 2 条保证这块内存只有一个入口，而且写进来的每一处编译器都看得见 ——
/// 于是没被置位的字**确实**收不到指针。这是 L0/L1 那条"不外逃"证明的第三次使用。
pub fn slot_mask_at(src: ptr, toks: ptr, nm: u32, at: u32, end: u32,
                    npar: u32, par: ptr, tbl: ptr) -> u32 {
    let q: u32 = 0;
    while q < npar {                                 // 形参同名 -> 不是候选
        if tok_eq(src, toks, load32(par, q * 8), nm) {
            return 4294967295;
        }
        q = q + 1;
    }
    if nm < at || nm < 2 || nm + 5 >= end {
        return 4294967295;
    }
    if !(tok_is(src, toks, nm - 1, "let") && !tok_is(src, toks, nm - 2, "if")
            && tok_is(src, toks, nm + 1, ":") && tok_is(src, toks, nm + 2, "ptr")
            && tok_is(src, toks, nm + 3, "=") && tok_is(src, toks, nm + 4, "alloc")
            && tok_is(src, toks, nm + 5, "(")) {
        return 4294967295;
    }
    // 1) L0 / L1 接走的不要掩码（与 `l1_ptr_only_at` 同判，只是不落"最后一次用处"）
    let ndecl: u32 = 0;
    let lst: u32 = 0;
    let esc: u32 = 0;
    let e: u32 = at;
    while e < end {
        if esc == 0 && tok_kind(toks, e) == 0 && tok_eq(src, toks, e, nm) {
            lst = e;
            if e == nm {
                ndecl = ndecl + 1;
            } else {
                if tok_is(src, toks, e - 1, "let") {
                    esc = 1;                         // 第二处声明（遮蔽）
                } else {
                    if tok_is(src, toks, e + 1, "=") {
                        esc = 1;                     // 重新赋值
                    } else {
                        if !(gc_occ_ok(src, toks, e, tbl)) {
                            esc = 1;                 // 其余任何用法：外逃
                        }
                    }
                }
            }
        }
        e = e + 1;
    }
    if esc == 0 && ndecl == 1 && lst != nm {
        return 4294967295;
    }
    // 2) 别名闭包（最多 4 个名字）
    let g0: u32 = nm;
    let g1: u32 = 0;
    let g2: u32 = 0;
    let g3: u32 = 0;
    let cnt: u32 = 1;
    let grew: u32 = 1;
    while grew == 1 {
        grew = 0;
        let a: u32 = at;
        while a + 6 < end {
            if grew == 0 && tok_is(src, toks, a, "let") && tok_kind(toks, a + 1) == 0
                    && tok_is(src, toks, a + 2, ":") && tok_is(src, toks, a + 3, "ptr")
                    && tok_is(src, toks, a + 4, "=") && tok_kind(toks, a + 5) == 0
                    && tok_is(src, toks, a + 6, ";") {
                let inr: u32 = slot_grp_has(src, toks, g0, g1, g2, g3, cnt, a + 5);
                let inq: u32 = slot_grp_has(src, toks, g0, g1, g2, g3, cnt, a + 1);
                if inr == 1 && inq == 0 {
                    if cnt >= 4 {
                        return 4294967295;
                    }
                    if cnt == 1 {
                        g1 = a + 1;
                    }
                    if cnt == 2 {
                        g2 = a + 1;
                    }
                    if cnt == 3 {
                        g3 = a + 1;
                    }
                    cnt = cnt + 1;
                    grew = 1;
                }
            }
            a = a + 1;
        }
    }
    // 3) 集里每个名字的每一处用法都得是"看得见的写/读"
    let mask: u32 = 0;
    let i: u32 = 0;
    while i < cnt {
        let gn: u32 = slot_grp_at(g0, g1, g2, g3, i);
        let k: u32 = at;
        while k < end {
            if tok_kind(toks, k) == 0 && tok_eq(src, toks, k, gn) {
                if k == gn {
                    k = k + 1;                       // 那条声明自己
                } else {
                    // 别名声明 `let Q : ptr = <集里的名字> ;`
                    if tok_is(src, toks, k + 1, ";") && tok_is(src, toks, k - 1, "=")
                            && tok_is(src, toks, k - 2, "ptr") && tok_is(src, toks, k - 3, ":")
                            && tok_kind(toks, k - 4) == 0 && tok_is(src, toks, k - 5, "let") {
                        k = k + 1;
                    } else {
                        // `store8(<集里的名字>, <字面量>, V)`
                        if tok_is(src, toks, k - 2, "store8") && tok_is(src, toks, k - 1, "(")
                                && tok_is(src, toks, k + 1, ",") && tok_kind(toks, k + 2) == 1
                                && tok_is(src, toks, k + 3, ",") {
                            let cl: u32 = skip_parens(src, toks, k - 1);
                            if cl <= k {
                                return 4294967295;
                            }
                            let vfree: u32 = 0;
                            if cl == k + 5 && tok_kind(toks, k + 4) == 1 {
                                vfree = 1;               // 整数字面量
                            }
                            if cl == k + 6 && tok_is(src, toks, k + 4, "-")
                                    && tok_kind(toks, k + 5) == 1 {
                                vfree = 1;               // 负字面量
                            }
                            if vfree == 0 {
                                let wo: u32 = tok_int(src, toks, k + 2) >> 3;
                                if wo >= 32 {
                                    return 4294967295;
                                }
                                let one: u32 = 1;
                                mask = mask | (one << wo);
                            }
                            k = cl + 1;
                        } else {
                            // `load8(<集里的名字>, ...)` —— 只读，不写字
                            if tok_is(src, toks, k - 2, "load8") && tok_is(src, toks, k - 1, "(")
                                    && tok_is(src, toks, k + 1, ",") {
                                let cl2: u32 = skip_parens(src, toks, k - 1);
                                if cl2 <= k {
                                    return 4294967295;
                                }
                                k = cl2 + 1;
                            } else {
                                return 4294967295;       // 别的任何用法
                            }
                        }
                    }
                }
            } else {
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return mask;
}

/// **L1 定活**（`docs/210` §2.5）：把"最后一次用处已经过去"的块还掉。
///
/// `hook` = 1 -> 手上这条 `return`（跨度 `rt_at`..`rt_end`）**之前**；= 0 -> **函数末尾**。
/// 落点规则与 `lomentc._l1_place` 是同一套（两处，按序取第一个成立的）。
///
/// 资格三条，每条都有它挡的东西：
///   * 形状 `let NAME: ptr = alloc(...)`（尺寸**不限** —— 常量是 L0 的事）；
///   * **声明在函数体顶层**（大括号深度 0）：否则那一支可能根本没走，槽里是**未初始化**
///     的值，在末尾 `free` 它就是在 free 一个垃圾指针；
///   * `l1_ptr_only`：只被解引用透过 ⇒ 块只有这一个入口 ⇒ 还掉它别处也摸不到。
///
/// **L0 提走的不接**（它不碰 arena）。**落点一的判据**：`last < rt_end` 且"在它之前
/// 结束在 `last` 之后的 `return` 一条都没有" —— 合起来就是"这条是最早的那条"。
fn emit_l1(s: ptr, out: ptr, src: ptr, toks: ptr, hook: u32, rt_at: u32, rt_end: u32) -> u32 {
    if load32(s, 572) == 0 {
        return 0;
    }
    let at: u32 = load32(s, 564);
    let end: u32 = load32(s, 568);
    let n: u32 = 0;
    let d: u32 = at;
    while d < end {
        let nm: u32 = d + 1;
        if tok_is(src, toks, d, "let") && !tok_is(src, toks, d - 1, "if")
                && tok_kind(toks, nm) == 0 && tok_is(src, toks, nm + 1, ":")
                && tok_is(src, toks, nm + 2, "ptr") && tok_is(src, toks, nm + 3, "=")
                && tok_is(src, toks, nm + 4, "alloc") && tok_is(src, toks, nm + 5, "(") {
            let j: u32 = nm + 5;                     // 找 alloc 的右括号（尺寸不限 -> 要配平）
            let depth: u32 = 0;
            let done: u32 = 0;
            while j < end && done == 0 {
                if tok_is(src, toks, j, "(") {
                    depth = depth + 1;
                }
                if tok_is(src, toks, j, ")") {
                    depth = depth - 1;
                    if depth == 0 {
                        done = 1;
                    }
                }
                j = j + 1;
            }
            let dep: u32 = 0;                        // 声明在顶层？（大括号深度 0）
            let z: u32 = at;
            while z < nm {
                if tok_is(src, toks, z, "{") {
                    dep = dep + 1;
                }
                if tok_is(src, toks, z, "}") {
                    dep = dep - 1;
                }
                z = z + 1;
            }
            if done == 1 && dep == 0 && tok_is(src, toks, j, ";")
                    && l0_size(s, src, toks, nm) == 0 {
                if l1_ptr_only(s, src, toks, nm) == 1 {
                    let last: u32 = load32(s, 584);
                    let take: u32 = 0;
                    if hook == 1 {
                        if last < rt_end && ret_after(src, toks, at, rt_at, last, end) == 0 {
                            take = 1;
                        }
                    } else {
                        if ret_after(src, toks, at, end, last, end) == 0 {
                            take = 1;
                        }
                    }
                    if take == 1 {
                        emit_str(s, out, "  ");
                        let t: u32 = new_temp(s, out);
                        emit_str(s, out, " = load ptr, ptr %");
                        emit_local_name(s, out, src, toks, nm);
                        emit_str(s, out, ".addr\n  call void @__loment_free(ptr ");
                        emit_temp_ref(s, out, t);
                        emit_str(s, out, ")\n");
                        n = n + 1;
                    }
                }
            }
        }
        d = d + 1;
    }
    return n;
}

/// 纪元开：记下前沿，回它的 temp 号（0 = 这一格没开纪元，什么都不发）。
///
/// **档位门在这儿**（与 `emit_l0_buf` 同一个口径）：`l2_ok` 只判规则，判不出档 ——
/// 参考侧靠"`s.l2` 只在 alpha 那一趟填"把门关上，自举侧就得自己看 572。
/// 少了这一句，`gc_manual` 下孪生也会开纪元（**实测**：`test_m89` 的 manual 变体抓到的）。
fn epoch_open(s: ptr, out: ptr, src: ptr, toks: ptr, at: u32, end: u32) -> u32 {
    if load32(s, 572) == 0 || l2_ok(s, src, toks, at, end) == 0 {
        return 0;
    }
    emit_str(s, out, "  ");
    let sv: u32 = new_temp(s, out);
    emit_str(s, out, " = load i32, ptr @__loment_off\n");
    return sv;
}

// ---------------------------------------------------------------- 枚举表 (M25/M26)

/// 枚举表项基址: name_tok | nvariants | has_payload | pad | 8 × (variant_tok, payload_tok)
fn enum_base(i: u32) -> u32 {
    return CG_ENUM + i * 80;
}

fn find_enum(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 540) {
        let nt: u32 = load32(s, enum_base(i));
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 变体下标 (声明序), 未找到返回 4294967295。
fn enum_variant_index(s: ptr, src: ptr, toks: ptr, ei: u32, vt: u32) -> u32 {
    let n: u32 = load32(s, enum_base(ei) + 4);
    let k: u32 = 0;
    while k < n {
        let nt: u32 = load32(s, enum_base(ei) + 16 + k * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, vt * 20 + 8) {
            let q: u32 = 0;
            let ok: u32 = 1;
            while q < load32(toks, vt * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + q)
                        != load8(src, load32(toks, vt * 20 + 4) + q) {
                    ok = 0;
                }
                q = q + 1;
            }
            if ok == 1 {
                return k;
            }
        }
        k = k + 1;
    }
    return 4294967295;
}

/// 变体载荷类型 token (0 = 无载荷)。
fn enum_payload_type(s: ptr, src: ptr, toks: ptr, ei: u32, k: u32) -> u32 {
    return subst_tok(s, src, toks, load32(s, enum_base(ei) + 16 + k * 8 + 4));
}

/// 枚举的 LLVM 类型: 有载荷 -> `{ i32, i64 }`, 无载荷 -> `i32` (镜像 _ll_type)。
fn emit_enum_ty(s: ptr, out: ptr, ei: u32) -> u32 {
    if load32(s, enum_base(ei) + 8) == 0 {
        return emit_str(s, out, "i32");
    }
    return emit_str(s, out, "{ i32, i64 }");
}

// ---------------------------------------------------------------- struct 表

fn struct_base(i: u32) -> u32 {
    return 1024 + i * 80;
}

/// 按名字找 struct: 返回下标, 未找到返回 4294967295。
fn find_struct(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 520) {
        let nt: u32 = load32(s, struct_base(i));
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// 字段下标 (按声明序), 未找到返回 4294967295。
fn field_index(s: ptr, src: ptr, toks: ptr, si: u32, fname: u32) -> u32 {
    let n: u32 = load32(s, struct_base(si) + 4);
    let k: u32 = 0;
    while k < n {
        let nt: u32 = load32(s, struct_base(si) + 8 + k * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, fname * 20 + 8) {
            let q: u32 = 0;
            let ok: u32 = 1;
            while q < load32(toks, fname * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + q)
                        != load8(src, load32(toks, fname * 20 + 4) + q) {
                    ok = 0;
                }
                q = q + 1;
            }
            if ok == 1 {
                return k;
            }
        }
        k = k + 1;
    }
    return 4294967295;
}

fn field_type(s: ptr, src: ptr, toks: ptr, si: u32, k: u32) -> u32 {
    return subst_tok(s, src, toks, load32(s, struct_base(si) + 8 + k * 8 + 4));
}

/// struct 的 LLVM 类型串 (镜像 `_ll_type`: `{ i32, i32 }`)。
fn emit_struct_ty(s: ptr, out: ptr, src: ptr, toks: ptr, si: u32) -> u32 {
    emit_str(s, out, "{ ");
    let n: u32 = load32(s, struct_base(si) + 4);
    let k: u32 = 0;
    while k < n {
        if k > 0 {
            emit_str(s, out, ", ");
        }
        emit_ty(s, out, src, toks, field_type(s, src, toks, si, k));
        k = k + 1;
    }
    return emit_str(s, out, " }");
}

// ---------------------------------------------------------------- 字符串字面量

fn s_gc(s: ptr, inc: u32) -> u32 {
    if inc == 1 {
        store32(s, 524, load32(s, 524) + 1);
    }
    return load32(s, 524);
}

fn emit_hex2(s: ptr, out: ptr, d: u32) -> u32 {
    let o: u32 = st_o(s);
    let c: u32 = 48 + d;
    if d >= 10 {
        c = 55 + d;   // 'A' + (d - 10)
    }
    store8(out, o, c as u8);
    store32(s, 0, o + 1);
    return o + 1;
}

fn emit_hex_byte(s: ptr, out: ptr, b: u32) -> u32 {
    emit_str(s, out, "\\");
    emit_hex2(s, out, b / 16);
    return emit_hex2(s, out, b % 16);
}

/// 字符串字面量的解码后字节数 (span 含引号; 转义表同 lomc._ESCAPES)。
fn str_lit_len(src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let k: u32 = 1;
    let c: u32 = 0;
    while k + 1 < n {
        if load8(src, st + k) == 92 {
            k = k + 2;
        } else {
            k = k + 1;
        }
        c = c + 1;
    }
    return c;
}

/// 按 `\XX` 大写十六进制写出解码后的字节 (与 lomentc 的转义一致)。
fn emit_str_lit_bytes(s: ptr, out: ptr, src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let k: u32 = 1;
    while k + 1 < n {
        let b: u32 = load8(src, st + k);
        if b == 92 {
            let e: u32 = load8(src, st + k + 1);
            // 转义表与 `lomc._ESCAPES` 同一份（`#33` / `#36`）：`\n` `\t` `\r` `\0`；其余
            // （`\\` `\"` 以及未知）取那个字符本身。**未知那一档由 checker 报 E019** ——
            // 自举词法器没有失败通道，所以拒绝落在检查期。
            let d: u32 = e;
            if e == 110 {
                d = 10;
            } else if e == 116 {
                d = 9;
            } else if e == 114 {
                d = 13;
            } else if e == 48 {
                d = 0;
            }
            emit_hex_byte(s, out, d);
            k = k + 2;
        } else {
            emit_hex_byte(s, out, b);
            k = k + 1;
        }
    }
    return k;
}

/// 模块级字符串常量 (位于横幅/运行时/堆全局之后、函数之前)。
/// 顺序 = 逐函数、逐出现 —— 与表达式求值顺序一致 (都是同一 token 流的线性扫描)。
fn emit_str_globals(s: ptr, out: ptr, src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            // 外部函数 (docs/173) **没有函数体** —— 不挡住的话, 找 `{` 的那一圈会一路扫到
            // **下一个函数**的体入口, 于是把别人的字符串常量挂到外部函数名下
            // (实测: `extern fn c_puts(p: ptr) -> i32;` + main 里的 "hello" 生成
            //  `@.str.c_puts.0`, 而参考实现是 `@.str.main.0`)。
            if i > 0 && tok_is(src, toks, i - 1, "extern") {
                i = i + 1;
            } else {
            store32(s, 524, 0);
            let j: u32 = i;
            while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
                j = j + 1;
            }
            j = j + 1;
            let d: u32 = 1;
            while tok_kind(toks, j) != 4 && d > 0 {
                if tok_is(src, toks, j, "{") {
                    d = d + 1;
                }
                if tok_is(src, toks, j, "}") {
                    d = d - 1;
                }
                if d > 0 && tok_kind(toks, j) == 2 {
                    emit_str(s, out, "@.str.");
                    emit_tok(s, out, src, toks, i + 1);
                    emit_str(s, out, ".");
                    emit_dec(s, out, s_gc(s, 0));
                    emit_str(s, out, " = private unnamed_addr constant [");
                    emit_dec(s, out, str_lit_len(src, toks, j));
                    emit_str(s, out, " x i8] c\"");
                    emit_str_lit_bytes(s, out, src, toks, j);
                    emit_str(s, out, "\"\n");
                    s_gc(s, 1);
                }
                j = j + 1;
            }
            i = j;
            }
        } else {
            i = i + 1;
        }
    }
    return st_o(s);
}

/// 函数体内是否存在字符串字面量 (决定要不要写全局段)。
/// 注意只看**函数体内** —— `use "..."` 也是 kind=2, 但它不是字面量。
fn strings_needed(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            // 外部函数没有函数体 —— 同上, 不挡就会把下一个函数的体算成它的 (docs/173)
            if i > 0 && tok_is(src, toks, i - 1, "extern") {
                i = i + 1;
            } else {
            let j: u32 = i;
            while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
                j = j + 1;
            }
            j = j + 1;
            let d: u32 = 1;
            while tok_kind(toks, j) != 4 && d > 0 {
                if tok_is(src, toks, j, "{") {
                    d = d + 1;
                }
                if tok_is(src, toks, j, "}") {
                    d = d - 1;
                }
                if d > 0 && tok_kind(toks, j) == 2 {
                    return 1;
                }
                j = j + 1;
            }
            i = j;
            }
        } else {
            i = i + 1;
        }
    }
    return 0;
}

// ---------------------------------------------------------------- 切片/数组类型

/// 类型 token 是否为切片 `[T]` / `mut [T]`。
fn is_slice_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "[") && !tok_is(src, toks, tt + 2, ";") {   // [T] 不是 [T; N]
        return 1;
    }
    if tok_is(src, toks, tt, "mut") && tok_is(src, toks, tt + 1, "[") {
        return 1;
    }
    return 0;
}

/// 类型 token 是否为定长数组 `[T; N]`。
fn is_array_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "[") && tok_is(src, toks, tt + 2, ";") {
        return 1;
    }
    return 0;
}

/// 切片/数组的元素类型 token。
fn elem_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tok_is(src, toks, tt, "mut") {
        return tt + 2;
    }
    return tt + 1;
}

/// 定长数组长度 (字面量); 非数组返回 0。
fn array_len_of(src: ptr, toks: ptr, tt: u32) -> u32 {
    if is_array_tok(src, toks, tt) == 1 {
        return tok_int(src, toks, tt + 3);
    }
    return 0;
}

/// 跳过一个类型 (`T` / `[T]` / `[T; N]` / `mut [T]` / `()`), 返回其后的位置。
fn skip_type(src: ptr, toks: ptr, i: u32) -> u32 {
    if tok_is(src, toks, i, "mut") {
        return skip_type(src, toks, i + 1);
    }
    if tok_is(src, toks, i, "[") || tok_is(src, toks, i, "(") {
        let j: u32 = i + 1;
        let d: u32 = 1;
        while tok_kind(toks, j) != 4 && d > 0 {
            if tok_is(src, toks, j, "[") || tok_is(src, toks, j, "(") {
                d = d + 1;
            }
            if tok_is(src, toks, j, "]") || tok_is(src, toks, j, ")") {
                d = d - 1;
            }
            j = j + 1;
        }
        return j;
    }
    let nx: u32 = i + 1;
    if tok_is(src, toks, nx, "<") {   // 泛型实参列表: Pair<u32> / Result<u32, u32>
        let d: u32 = 0;
        let j: u32 = nx;
        while tok_kind(toks, j) != 4 {
            if tok_is(src, toks, j, "<") {
                d = d + 1;
            }
            if tok_is(src, toks, j, ">") {
                d = d - 1;
                if d == 0 {
                    return j + 1;
                }
            }
            j = j + 1;
        }
        return j;
    }
    return nx;
}

// ---------------------------------------------------------------- 能力域 (P4)

/// 域表项基址: name_tok | space_tok | lo | hi | revocable (24B/项, 64 项)
fn cap_base(i: u32) -> u32 {
    return 6144 + i * 24;
}

/// FNV-1a 32 位 (对 space 名 token 的字节) —— 与 lomentc._fnv1a32 同算法。
fn fnv1a_tok(src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let h: u32 = 2166136261;
    let k: u32 = 0;
    while k < n {
        h = h ^ load8(src, st + k);
        h = h * 16777619;
        k = k + 1;
    }
    return h;
}

/// 按名字找能力域: 返回下标, 未找到返回 4294967295。
fn find_cap(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 536) {
        let nt: u32 = load32(s, cap_base(i));
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return i;
            }
        }
        i = i + 1;
    }
    return 4294967295;
}

/// `@__loment_caps` 域描述表 (镜像 lomentc 的 P4/M35 行格式)。
fn emit_caps_table(s: ptr, out: ptr, src: ptr, toks: ptr) -> u32 {
    let n: u32 = load32(s, 536);
    emit_str(s, out, "@__loment_caps = internal constant [");
    emit_dec(s, out, n);
    emit_str(s, out, " x { i64, i64, i64, i64 }] [");
    let i: u32 = 0;
    while i < n {
        if i > 0 {
            emit_str(s, out, ", ");
        }
        emit_str(s, out, "{ i64, i64, i64, i64 } { i64 ");
        emit_dec(s, out, fnv1a_tok(src, toks, load32(s, cap_base(i) + 4)));
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, load32(s, cap_base(i) + 8));
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, load32(s, cap_base(i) + 12));
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, load32(s, cap_base(i) + 16));
        emit_str(s, out, " }");
        i = i + 1;
    }
    emit_str(s, out, "]");
    return emit_str(s, out, "
");
}

// ---------------------------------------------------------------- 表达式

fn bit_width(tt: u32, src: ptr, toks: ptr) -> u32 {
    if tt == CG_WANT_U32 {
        return 32;
    }
    if tt == CG_TY_BOOL {
        return 1;
    }
    if tok_is(src, toks, tt, "bool") || tok_is(src, toks, tt, "true")
        || tok_is(src, toks, tt, "false") {
        return 1;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return 8;
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return 16;
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return 32;
    }
    return 64;
}

/// `as` 的目标是不是**整数**类型（u8..i64）—— 镜像 `lomentc` 的 `e.type in INT_TYPES`
/// (#694)。`bool`/`ptr` 不算：它们的转型各有单独的分支。
fn is_int_ty(src: ptr, toks: ptr, tt: u32) -> bool {
    return tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "u16")
        || tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "u64")
        || tok_is(src, toks, tt, "i8") || tok_is(src, toks, tt, "i16")
        || tok_is(src, toks, tt, "i32") || tok_is(src, toks, tt, "i64");
}

/// `as T` 后缀: 按位宽与符号性选 trunc/sext/zext (与 lomentc 同规则)。
fn apply_cast(s: ptr, out: ptr, src: ptr, toks: ptr, from_t: u32, to_t: u32, lvl: u32) -> u32 {
    if from_t == CG_CAST_PTR {          // 内建返回的 ptr: 只可能是 ptr -> 整数
        if tok_is(src, toks, to_t, "u64") || tok_is(src, toks, to_t, "i64") {
            emit_str(s, out, "  ");
            let np0: u32 = new_temp(s, out);
            emit_str(s, out, " = ptrtoint ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, " to i64
");
            set_temp_val(s, lvl, np0);
            return 1;
        }
        return 0;
    }
    // from_t == 0 时按 u32 处理 (镜像 lomentc 的 `st or "u32"`: 打印与位宽都用 i32)
    let sw: u32 = 32;
    if from_t != 0 {
        sw = bit_width(from_t, src, toks);
    }
    let dw: u32 = bit_width(to_t, src, toks);
    if sw == dw && from_t == to_t {
        return 0;   // 同类型: 不加指令
    }
    if sw == dw && !tok_is(src, toks, from_t, "ptr") && !tok_is(src, toks, to_t, "ptr") {
        // 同宽异名 (u64 <-> i64): LLVM 里本来就是同一个类型, 再写 sext/zext 是非法 IR
        // (自举驱动里的 `i64 as u64` 第一次踩到 —— clang 直接报 invalid cast opcode)
        return 0;
    }
    if tok_is(src, toks, from_t, "ptr") {   // M67: 指针转整数
        if tok_is(src, toks, to_t, "u64") || tok_is(src, toks, to_t, "i64") {
            emit_str(s, out, "  ");
            let np: u32 = new_temp(s, out);
            emit_str(s, out, " = ptrtoint ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, " to i64\n");
            set_temp_val(s, lvl, np);
            return 1;
        }
    }
    if tok_is(src, toks, to_t, "ptr") {   // M83: 整数 -> 指针 (brk/mmap 取内存)
        emit_str(s, out, "  ");
        let npi: u32 = new_temp(s, out);
        emit_str(s, out, " = inttoptr ");
        emit_ty(s, out, src, toks, from_t);
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to ptr\n");
        set_temp_val(s, lvl, npi);
        return 1;
    }
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if dw < sw {
        emit_str(s, out, "trunc ");
    } else if is_signed(src, toks, from_t) == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty(s, out, src, toks, from_t);
    emit_str(s, out, " ");
    emit_val(s, out, lvl);
    emit_str(s, out, " to ");
    emit_ty(s, out, src, toks, to_t);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, n);
    return 1;
}

// ---------------------------------------------------------------- 类型名 (内建结果用)

/// 类型 id: 1=u8 2=u16 3=u32 4=u64 5=ptr 6=bool (镜像 _ll_type 的标量+ptr 子集)。
fn ty_width_id(id: u32) -> u32 {
    if id == 1 {
        return 8;
    }
    if id == 2 {
        return 16;
    }
    if id == 3 {
        return 32;
    }
    if id == 4 {
        return 64;
    }
    if id == 6 {
        return 1;
    }
    return 64;   // ptr 与未知
}

fn emit_ty_name(s: ptr, out: ptr, id: u32) -> u32 {
    if id == 1 {
        return emit_str(s, out, "i8");
    }
    if id == 2 {
        return emit_str(s, out, "i16");
    }
    if id == 3 {
        return emit_str(s, out, "i32");
    }
    if id == 4 {
        return emit_str(s, out, "i64");
    }
    if id == 5 {
        return emit_str(s, out, "ptr");
    }
    return emit_str(s, out, "i1");
}

/// 类型 token -> 类型 id (0 = 缺省 u32, 与 lomentc 的 `st or "u32"` 同义)。
fn ty_name_id(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 0 {
        return 3;
    }
    if tok_is(src, toks, tt, "u8") || tok_is(src, toks, tt, "i8") {
        return 1;
    }
    if tok_is(src, toks, tt, "u16") || tok_is(src, toks, tt, "i16") {
        return 2;
    }
    if tok_is(src, toks, tt, "u32") || tok_is(src, toks, tt, "i32") {
        return 3;
    }
    if tok_is(src, toks, tt, "u64") || tok_is(src, toks, tt, "i64") {
        return 4;
    }
    if tok_is(src, toks, tt, "ptr") {
        return 5;
    }
    if tok_is(src, toks, tt, "bool") {
        return 6;
    }
    return 3;
}

/// 内建结果上的 `as` 后缀: from 侧是内建固定的类型 (fid/fsg), to 侧是类型 token。
fn apply_cast_b(s: ptr, out: ptr, src: ptr, toks: ptr, fid: u32, fsg: u32, to_tok: u32, lvl: u32) -> u32 {
    let tid: u32 = ty_name_id(src, toks, to_tok);
    if tid == fid {
        return 0;
    }
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if fid == 5 && tid == 4 {              // M67: 指针转整数
        emit_str(s, out, "ptrtoint ptr ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to i64\n");
        set_temp_val(s, lvl, n);
        return 1;
    }
    if tid == 5 && fid >= 1 && fid <= 4 {   // M83: 整数 -> 指针 (brk/mmap 取内存)
        emit_str(s, out, "inttoptr ");
        emit_ty_name(s, out, fid);
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        emit_str(s, out, " to ptr\n");
        set_temp_val(s, lvl, n);
        return 1;
    }
    if ty_width_id(tid) < ty_width_id(fid) {
        emit_str(s, out, "trunc ");
    } else if fsg == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty_name(s, out, fid);
    emit_str(s, out, " ");
    emit_val(s, out, lvl);
    emit_str(s, out, " to ");
    emit_ty_name(s, out, tid);
    emit_str(s, out, "\n");
    set_temp_val(s, lvl, n);
    return 1;
}

/// 求值一个实参 (落到第 lvl 层), 返回其后 token 下标 (跳过尾随逗号)。
fn arg1(s: ptr, out: ptr, src: ptr, toks: ptr, k: u32, lvl: u32) -> u32 {
    let e: u32 = expr_bin(s, out, src, toks, k, 1, lvl, 0);
    let r: u32 = e;
    if tok_is(src, toks, r, ",") {
        r = r + 1;
    }
    return r;
}

/// 目标整数类型的位宽 (token 下标 `want`); 0 = 不环绕。
/// 0 (无 want) 按 i32 —— 与参考实现的 `want or "i32"` 同序。
/// **只覆盖 <= 32 位**: 64 位的越界字面量 (>2^64) 是既有缺口, 不在本修范围。
fn lit_bits(src: ptr, toks: ptr, want: u32) -> u32 {
    if want == 0 || want == CG_WANT_U32 {
        return 32;
    }
    if tok_is(src, toks, want, "u8") || tok_is(src, toks, want, "i8") {
        return 8;
    }
    if tok_is(src, toks, want, "u16") || tok_is(src, toks, want, "i16") {
        return 16;
    }
    if tok_is(src, toks, want, "u32") || tok_is(src, toks, want, "i32") {
        return 32;
    }
    if tok_is(src, toks, want, "bool") {
        return 1;
    }
    return 0;
}

/// 整数字面量的十进制文本写进第 lvl 层, 返回位数。
/// 十进制原样 (去前导 0); 十六进制走**长乘 16 加**转十进制 —— 支持 > u32 的字面量
/// (`0x100000000` 这类; lomentc 用 Python 大整数, 这里用十进制数字缓冲 672..704)。
///
/// `want` 是**期望类型** (token 下标, 0 = 无): 给定时按它环绕 —— Loment 的整数语义是
/// 环绕, 所以 `let v: u8 = 300;` 的字面量要印成 `44`, 而不是 `300` (`store i8 300`
/// 不是合法 LLVM; 参考实现同一处也按 `_wrap_int` 环绕)。
///
/// **只做 <= 32 位** (`lit_bits` 对 u64/i64 返回 0 = 原样): 64 位那条要用 u64 解析
/// 与 20 位十进制回写, 会把种子推过 `#441` 记的那道容量墙。>2^64 的字面量因此仍是
/// 既有缺口 —— 与本条要修的形状 (`let v: u8 = 300;`) 无关。
fn set_int_lit(s: ptr, lvl: u32, src: ptr, toks: ptr, i: u32, want: u32) -> u32 {
    // 模块级常量可以是**负字面量** (`const X: i64 = -11;`): `find_const` 交回来的是
    // `-` 那个 token, 值在它后面。参考实现在解析期就把符号折进值里; 原来这里只把
    // `-` 的文本抄出去, 于是 IR 里是 `icmp eq i64 %t1, -` —— 不是数字错, 是**非法 IR**
    // (#678)。先取绝对值再按类型环绕, 才是 `const X: i8 = -200;` 也对的写法。
    let wneg: u32 = 0;
    if tok_is(src, toks, i, "-") {
        wneg = 1;
        i = i + 1;
    }
    // **名字带 `wr` 前缀**: 这门语言没有块作用域 (docs/228), 下面十六进制那段的
    // `let v` 与本段同处一个函数作用域 —— 撞名会静默改写类型, 自举自己编自己时报 E1。
    let wrb: u32 = lit_bits(src, toks, want);
    if wrb > 0 {
        // 低 32 位: `tok_int` 本身就是 u32 自然环绕, 再按目标位宽掩码。
        let wrs: u32 = tok_int(src, toks, i);
        if wneg == 1 {
            wrs = 0 - wrs;             // 二补数; 下面的掩码与符号位检查照旧
        }
        let wrm: u32 = 4294967295;
        if wrb < 32 {
            wrm = ((1 as u32) << wrb) - 1;
        }
        let wrv: u32 = wrs & wrm;
        let wrneg: u32 = 0;
        // 有符号: 无 want 时参考落 `i32` (有符号); 有 want 时看类型 token 首字节
        // 是不是 'i' (105)。bool 首字节 'b', 不走这支。
        let wrsgn: u32 = 0;
        if want == 0 {
            wrsgn = 1;
        } else if want == CG_WANT_U32 {
            wrsgn = 0;                 // 虚拟 u32: 无符号, 不按符号位折成负数
        } else if load8(src, load32(toks, want * 20 + 4)) == 105 {
            wrsgn = 1;
        }
        if wrsgn == 1 {
            let wrh: u32 = (1 as u32) << (wrb - 1);
            if wrv >= wrh {
                wrv = (wrm - wrv) + 1;
                wrneg = 1;
            }
        }
        let wrd: u32 = set_dec_val(s, lvl, wrv);
        if wrneg == 1 {          // 给 '-' 让一位 (原地右移)
            let wrq: u32 = wrd;
            while wrq > 0 {
                store8(s, btxt(s, lvl) + wrq, load8(s, btxt(s, lvl) + wrq - 1) as u8);
                wrq = wrq - 1;
            }
            store8(s, btxt(s, lvl), 45 as u8);
            store32(s, blen(s, lvl), wrd + 1);
        }
        return wrd + wrneg;
    }
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    // **64 位目标**（`#719`）：`lit_bits` 对 u64/i64 回 0（上面的 32 位环绕走不到），
    // 而原样抄文本在**有符号**类型上是错的 —— `let m: i64 = 9223372036854775808;`
    // 参考实现按 `_wrap_int` 折成 `-9223372036854775808`，自举抄的是 2^63。
    // 十六进制那条路已经用长除法转十进制（> u32 也支持），这里只管十进制。
    if !(n >= 2 && load8(src, st) == 48 && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88)) {
        let wr64: u32 = 0;
        if want != 0 && want != CG_WANT_U32 {
            if tok_is(src, toks, want, "u64") || tok_is(src, toks, want, "i64") {
                wr64 = 1;
            }
        }
        if wr64 == 1 {
            let w64: u64 = tok_u64(src, toks, i);
            let wrv64: u64 = w64;
            if wneg == 1 {
                wrv64 = 0 as u64 - w64;      // 二补数; 与参考的掩码+补码同义
            }
            let wrneg64: u32 = 0;
            let wrsgn64: u32 = 0;
            if load8(src, load32(toks, want * 20 + 4)) == 105 {
                wrsgn64 = 1;                 // 类型 token 的首字节 'i'
            }
            if wrsgn64 == 1 && wrv64 >= (9223372036854775808 as u64) {
                wrv64 = 0 as u64 - wrv64;
                wrneg64 = 1;
            }
            let wrd64: u32 = set_dec_val64(s, lvl, wrv64);
            if wrneg64 == 1 {
                let wrq64: u32 = wrd64;
                while wrq64 > 0 {
                    store8(s, btxt(s, lvl) + wrq64, load8(s, btxt(s, lvl) + wrq64 - 1) as u8);
                    wrq64 = wrq64 - 1;
                }
                store8(s, btxt(s, lvl), 45 as u8);
                store32(s, blen(s, lvl), wrd64 + 1);
            }
            return wrd64 + wrneg64;
        }
        let k: u32 = 0;
        while k + 1 < n && load8(src, st + k) == 48 {
            k = k + 1;
        }
        let c0: u32 = 0;
        while k + c0 < n {
            store8(s, btxt(s, lvl) + c0, load8(src, st + k + c0) as u8);
            c0 = c0 + 1;
        }
        if wneg == 1 {               // 负字面量: 右移一位让 '-' 的位置
            let cq: u32 = c0;
            while cq > 0 {
                store8(s, btxt(s, lvl) + cq, load8(s, btxt(s, lvl) + cq - 1) as u8);
                cq = cq - 1;
            }
            store8(s, btxt(s, lvl), 45 as u8);
            store32(s, blen(s, lvl), c0 + 1);
            return c0 + 1;
        }
        store32(s, blen(s, lvl), c0);
        return c0;
    }
    store8(s, 672, 0 as u8);
    let nd: u32 = 1;
    let k2: u32 = 2;
    while k2 < n {
        let c: u32 = load8(src, st + k2);
        let dv: u32 = 0;
        if c >= 48 && c <= 57 {
            dv = c - 48;
        } else if c >= 97 && c <= 102 {
            dv = c - 87;
        } else if c >= 65 && c <= 70 {
            dv = c - 55;
        }
        let carry: u32 = dv;
        let j: u32 = 0;
        while j < nd {
            let v: u32 = load8(s, 672 + j) * 16 + carry;
            store8(s, 672 + j, (v % 10) as u8);
            carry = v / 10;
            j = j + 1;
        }
        while carry > 0 {
            store8(s, 672 + nd, (carry % 10) as u8);
            carry = carry / 10;
            nd = nd + 1;
        }
        k2 = k2 + 1;
    }
    let q: u32 = 0;
    while q < nd {
        store8(s, btxt(s, lvl) + q, (48 + load8(s, 672 + nd - 1 - q)) as u8);
        q = q + 1;
    }
    if wneg == 1 {                   // 负字面量（十六进制那支）: 同上
        let hq: u32 = nd;
        while hq > 0 {
            store8(s, btxt(s, lvl) + hq, load8(s, btxt(s, lvl) + hq - 1) as u8);
            hq = hq - 1;
        }
        store8(s, btxt(s, lvl), 45 as u8);
        store32(s, blen(s, lvl), nd + 1);
        return nd + 1;
    }
    store32(s, blen(s, lvl), nd);
    return nd;
}

/// 整数字面量的值 (十进制或 0x 十六进制) —— lomentc 内联的是**十进制**文本。
fn tok_int(src: ptr, toks: ptr, i: u32) -> u32 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    if n >= 2 && load8(src, st) == 48 && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        let v: u32 = 0;
        let k: u32 = 2;
        while k < n {
            let c: u32 = load8(src, st + k);
            let d: u32 = 0;
            if c >= 48 && c <= 57 {
                d = c - 48;
            } else if c >= 97 && c <= 102 {
                d = c - 87;
            } else if c >= 65 && c <= 70 {
                d = c - 55;
            }
            v = v * 16 + d;
            k = k + 1;
        }
        return v;
    }
    let r: u32 = 0;
    let j: u32 = 0;
    while j < n {
        r = r * 10 + (load8(src, st + j) - 48);
        j = j + 1;
    }
    return r;
}

/// 十进制 token -> u64（自然环绕，与参考实现的 `v &= 2^64-1` 同义）。
fn tok_u64(src: ptr, toks: ptr, i: u32) -> u64 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let r: u64 = 0;
    let k: u32 = 0;
    while k < n {
        r = r * (10 as u64) + ((load8(src, st + k) - 48) as u64);
        k = k + 1;
    }
    return r;
}

/// `set_dec_val` 的 64 位版（最多 20 位）。
fn set_dec_val64(s: ptr, lvl: u32, v: u64) -> u32 {
    let tmp: ptr = scratch_buf(s);
    let d: u32 = 0;
    let x: u64 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + (x % 10) as u32) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(s, btxt(s, lvl) + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), d);
    return d;
}

/// 把十进制值写进第 lvl 层 (字面量与常量内联共用), 返回位数。
fn set_dec_val(s: ptr, lvl: u32, v: u32) -> u32 {
    let tmp: ptr = scratch_buf(s);
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(s, btxt(s, lvl) + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    store32(s, blen(s, lvl), d);
    return d;
}

/// 模块级常量查找: 命中返回**值 token** 下标, 否则 0。
/// 形态: [`pub`] `const` NAME `:` TYPE `=` VALUE `;` —— 名字恒在 `const` 之后一个。
fn find_const(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let i: u32 = 0;
    while i < load32(s, 644) {
        let nt: u32 = load32(s, CG_CONST + i * 8);
        if load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return load32(s, CG_CONST + i * 8 + 4) + 2;
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 原子 + 后缀: 字面量 / 参数 / 括号 / 调用 / `as T`。
/// 分配: 走运行期的 `__loment_alloc`（bump + 地址序空闲链表 + 拆分 + 前沿回退）。
/// **不再是内联的纯 bump** —— `free` 兑现之后（`docs/175` §3.4），分配与回收必须是
/// 同一份状态的读写者。大小从第 szlvl 层取 (u32), 结果 (ptr) 写到第 lvl 层;
/// 返回分配到的指针的 temp 号。alloc 与 str_concat 共用 (**文本与 `lomentc.alloc_ir` 同序**)。
///
/// **触发也发在这里**（`#367`）: 它原先在 `alloc` 的**调用点**上, 而 `str_concat`
/// 走的是这个函数、不经过那一处 —— 于是拼接分配的字节**不计入**那个计数器, 只拼字符串的
/// 程序**一次收集都不跑**（alpha 也救不了: 它的阈值与空间触发都住在
/// `__loment_maybe_collect` 里, 而那个函数一次都不会被调用）。挪到这儿之后**每一次**
/// 分配都计数; 同一段文本、同一顺序、同一个实参, 所以只含 `alloc` 的程序产物字节不变。
fn emit_alloc_seq(s: ptr, out: ptr, szlvl: u32, lvl: u32) -> u32 {
    if gc_any(s) == 1 {
        // 收在**分配之前** -> 不需要"分配失败再重试"那条路, `__loment_alloc` 一字节不动。
        emit_str(s, out, "  call void @__loment_maybe_collect(i32 ");
        emit_val(s, out, szlvl);
        emit_str(s, out, ")\n");
    }
    emit_str(s, out, "  ");
    let p: u32 = new_temp(s, out);
    emit_str(s, out, " = call ptr @__loment_alloc(i32 ");
    emit_val(s, out, szlvl);
    emit_str(s, out, ")\n");
    set_temp_val(s, lvl, p);
    return p;
}

fn expr_atom(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32, want: u32) -> u32 {
    if tok_kind(toks, j) == 2 {   // 字符串字面量 -> { ptr, i64 }
        let idx: u32 = s_gc(s, 0);
        s_gc(s, 1);
        emit_str(s, out, "  ");
        let sp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds [");
        emit_dec(s, out, str_lit_len(src, toks, j));
        emit_str(s, out, " x i8], ptr @.str.");
        emit_tok(s, out, src, toks, load32(s, 528));
        emit_str(s, out, ".");
        emit_dec(s, out, idx);
        emit_str(s, out, ", i64 0, i64 0\n  ");
        let sv1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
        emit_dec(s, out, sp);
        emit_str(s, out, ", 0\n  ");
        let sv2: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } %t");
        emit_dec(s, out, sv1);
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, str_lit_len(src, toks, j));
        emit_str(s, out, ", 1\n");
        set_temp_val(s, lvl, sv2);
        return j + 1;
    }
    if tok_kind(toks, j) == 1 {
        // **`字面量 as 整数类型`：直接按目标宽度发这个字面量** (#694)。先按 i32 定宽再
        // zext 会把 `253402300800 as i64` 截成 4294197632 (参考实现同一处一起改)。
        // 非整数目标 (ptr / bool) 照旧走下面那条"无期望类型求值 + apply_cast"的路 ——
        // 参考 Cast 分支对非整数目标仍传 `want=None`, 两边保持逐字节同形。
        let e0: u32 = j + 1;
        if tok_is(src, toks, e0, "as") && is_int_ty(src, toks, e0 + 1) {
            set_int_lit(s, lvl, src, toks, j, e0 + 1);
            return e0 + 2;
        }
        let wl: u32 = want;
        if tok_is(src, toks, e0, "as") {
            wl = 0;
        }
        set_int_lit(s, lvl, src, toks, j, wl);   // 十进制/十六进制都按十进制内联 (支持 > u32)
        if tok_is(src, toks, e0, "as") {
            apply_cast(s, out, src, toks, 0, e0 + 1, lvl);
            return e0 + 2;
        }
        return e0;
    }
    if tok_is(src, toks, j, "(") {
        // 括号**紧跟 `as T`** 时它是转型的操作数 —— 参考实现 Cast 分支对内部一律传
        // `want=None` (`expr(e.expr, None)`), 于是括号里的二元式**不吃外层期望类型**。
        // 少了这一步, `((48 + b) / 2) as u8` 会把外层的 u8 灌进 `48 + b` 与那次除法,
        // 发成 `add i8` / `icmp eq i8 ... , 0`, 与参考不一致 (ir_cast.lomt 抓到过)。
        let pwant: u32 = want;
        if tok_is(src, toks, skip_parens(src, toks, j) + 1, "as") {
            pwant = 0;
        }
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, lvl, pwant);
        let e1: u32 = e + 1;
        if tok_is(src, toks, e1, "as") {
            // from 侧的类型要用**括号里那个表达式**的类型 (`cast_src_type`), 不是
            // 整个转型表达式的类型 —— 后者在 `(v / 256) as u8` 上会直接给出 u8,
            // 于是 `as u8` 被当成同宽转型整个丢掉 (自举驱动第一次踩到)
            apply_cast(s, out, src, toks, cast_src_type(s, src, toks, j), e1 + 1, lvl);
            return e1 + 2;
        }
        return e1;
    }
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "(") {
        // 内建降级: load8 / store8 (与 lomentc 的 _Ir.builtin 同形)
        if tok_is(src, toks, j, "load8") {
            let ap: u32 = expr_bin(s, out, src, toks, j + 2, 1, lvl, 0);
            let ao: u32 = expr_bin(s, out, src, toks, ap + 1, 1, lvl + 1, 0);
            emit_str(s, out, "  ");
            let g: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n  ");
            let b8: u32 = new_temp(s, out);
            emit_str(s, out, " = load i8, ptr %t");
            emit_dec(s, out, g);
            emit_str(s, out, "\n  ");
            let z: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 %t");
            emit_dec(s, out, b8);
            emit_str(s, out, " to i32\n");
            set_temp_val(s, lvl, z);
            if tok_is(src, toks, ao + 1, "as") {   // load8(...) as T
                apply_cast(s, out, src, toks, 0, ao + 2, lvl);
                return ao + 3;
            }
            return ao + 1;
        }
        if tok_is(src, toks, j, "store8") {
            let ap2: u32 = expr_bin(s, out, src, toks, j + 2, 1, lvl, 0);
            let ao2: u32 = expr_bin(s, out, src, toks, ap2 + 1, 1, lvl + 1, 0);
            let av: u32 = expr_bin(s, out, src, toks, ao2 + 1, 1, lvl + 2, 0);
            emit_str(s, out, "  ");
            let g2: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            if load32(s, 516) == 1 && load32(s, 572) == 1 {
                // **写屏障**（`docs/210` §2.7）：与参考侧**同位置**（格与 store 之间）、
                // **同门槛** —— alpha 档**且这份单元真的要那块 arena**（`516` 是 `heap_needed`
                // 预扫描的结果）。位置在那条 gep 之后，因为它要的是**被写的地址**。
                // 少了 `516` 那一半，一份把 `alloc` 全 L0 提走的单元会挂一堆引用不到堆的屏障
                // （实测：`FujoJTOP/loment#239` 一修好这条立刻露出来）。
                emit_str(s, out, "\n  call void @__loment_wb(ptr %t");
                emit_dec(s, out, g2);
                emit_str(s, out, ")");
            }
            emit_str(s, out, "\n  store i8 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, g2);
            emit_str(s, out, "\n");
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return av + 1;
        }
        if tok_is(src, toks, j, "alloc") {   // M15: bump 分配器
            let k1: u32 = arg1(s, out, src, toks, j + 2, lvl);
            emit_alloc_seq(s, out, lvl, lvl);
            if tok_is(src, toks, k1 + 1, "as") {
                apply_cast_b(s, out, src, toks, 5, 0, k1 + 2, lvl);
                return k1 + 3;
            }
            return k1 + 1;
        }
        if tok_is(src, toks, j, "free") {
            let k2: u32 = arg1(s, out, src, toks, j + 2, lvl);
            // **真回收**（`docs/175` §3.4）：这里是那条"允诺却不兑现"的解药 ——
            // 以前只把实参求出来就丢掉，`free` 编得过、跑起来什么都不发生。
            emit_str(s, out, "  call void @__loment_free(ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ")\n");
            store8(s, btxt(s, lvl), 48 as u8);   // 结果值 = 字面量 0
            store32(s, blen(s, lvl), 1);
            return k2 + 1;
        }
        if tok_is(src, toks, j, "atomic_add") {   // M21
            let k3: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k4: u32 = arg1(s, out, src, toks, k3, lvl + 1);
            if load32(s, 516) == 1 && load32(s, 572) == 1 {
                // 写屏障：`atomic_add` 也是一次**写堆**（同参考侧的落点与门槛：alpha **且**要堆）。
                emit_str(s, out, "  call void @__loment_wb(ptr ");
                emit_val(s, out, lvl);
                emit_str(s, out, ")\n");
            }
            emit_str(s, out, "  ");
            let at: u32 = new_temp(s, out);
            emit_str(s, out, " = atomicrmw add ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " seq_cst\n");
            set_temp_val(s, lvl, at);
            if tok_is(src, toks, k4 + 1, "as") {
                apply_cast_b(s, out, src, toks, 3, 0, k4 + 2, lvl);
                return k4 + 3;
            }
            return k4 + 1;
        }
        if tok_is(src, toks, j, "ptr_add") || tok_is(src, toks, j, "ptr_sub") {   // M73
            let sub: u32 = tok_is(src, toks, j, "ptr_sub") as u32;
            let k5: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k6: u32 = arg1(s, out, src, toks, k5, lvl + 1);
            emit_str(s, out, "  ");
            let n64: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i64\n");
            let use: u32 = n64;
            if sub == 1 {
                emit_str(s, out, "  ");
                let nn: u32 = new_temp(s, out);
                emit_str(s, out, " = sub i64 0, %t");
                emit_dec(s, out, n64);
                emit_str(s, out, "\n");
                use = nn;
            }
            emit_str(s, out, "  ");
            let pe: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds i8, ptr ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, use);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, pe);
            if tok_is(src, toks, k6 + 1, "as") {
                apply_cast_b(s, out, src, toks, 5, 0, k6 + 2, lvl);
                return k6 + 3;
            }
            return k6 + 1;
        }
        if tok_is(src, toks, j, "get_bits") || tok_is(src, toks, j, "set_bits") {   // M22
            let setb: u32 = tok_is(src, toks, j, "set_bits") as u32;
            let k7: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k8: u32 = arg1(s, out, src, toks, k7, lvl + 1);
            let k9: u32 = arg1(s, out, src, toks, k8, lvl + 2);
            emit_str(s, out, "  ");
            let one: u32 = new_temp(s, out);
            emit_str(s, out, " = zext i8 1 to i16\n  ");
            let w16: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i32 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, " to i16\n  ");
            let shl: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i16 %t");
            emit_dec(s, out, one);
            emit_str(s, out, ", %t");
            emit_dec(s, out, w16);
            emit_str(s, out, "\n  ");
            let sb2: u32 = new_temp(s, out);
            emit_str(s, out, " = sub i16 %t");
            emit_dec(s, out, shl);
            emit_str(s, out, ", 1\n  ");
            let mask: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i16 %t");
            emit_dec(s, out, sb2);
            emit_str(s, out, " to i8\n");
            // set_bits 的第 4 个实参在掩码之后求值 (与 lomentc 同序)
            let k10: u32 = k9;
            if setb == 1 {
                k10 = arg1(s, out, src, toks, k9, lvl + 3);
            }
            emit_str(s, out, "  ");
            let nsh: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i32 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i8\n");
            if setb == 0 {
                emit_str(s, out, "  ");
                let shr: u32 = new_temp(s, out);
                emit_str(s, out, " = lshr i8 ");
                emit_val(s, out, lvl);
                emit_str(s, out, ", %t");
                emit_dec(s, out, nsh);
                emit_str(s, out, "\n  ");
                let gr: u32 = new_temp(s, out);
                emit_str(s, out, " = and i8 %t");
                emit_dec(s, out, shr);
                emit_str(s, out, ", %t");
                emit_dec(s, out, mask);
                emit_str(s, out, "\n");
                set_temp_val(s, lvl, gr);
                if tok_is(src, toks, k10 + 1, "as") {
                    apply_cast_b(s, out, src, toks, 1, 0, k10 + 2, lvl);
                    return k10 + 3;
                }
                return k10 + 1;
            }
            emit_str(s, out, "  ");
            let shm: u32 = new_temp(s, out);
            emit_str(s, out, " = shl i8 %t");
            emit_dec(s, out, mask);
            emit_str(s, out, ", %t");
            emit_dec(s, out, nsh);
