// std/bigdec.lomt — 十进制定点大数 (系数 + 标度)
//
// 为什么除了 bigint 还要它: bigint 是**整数**。而钱、税率、单价这类东西的语义是
// **十进制小数**, 一旦折成二进制再算回来就会出现 0.1 + 0.2 != 0.3。这一层把数表示成
//
//     值 = 系数 x 10^(-scale)        系数是 bigint, scale 是十进制位数
//
// 于是 0.1 + 0.2 **精确**等于 0.3 (对齐后 1 + 2 = 3, scale 都是 1), 不经过任何二进制。
//
// 布局: buf[0..4] = scale, buf[4..8] = 符号, buf[8..] = 系数 (bigint 的那套: 长度在
// 前 4 字节, 之后是 u32 肢体)。所以装 cap 个肢体要 12 + 4*cap 字节 —— 用 bigdec_bytes。
//
// 已知缺口: 一般的大数除法没做 (它需要 bigint 的逐位长除, 那是另一件事)。这里只给
// **除以小整数** (bigdec_div_small), 覆盖"按份数分摊"这种常见形状。等 T7 的 JSON
// 需要十进制 -> 浮点时, 大数除法会一次补上, 那时 bigdec 与 f64fmt 一起受益。
//
// 命名: 公开 bigdec_*, 内部 bd_*。自检 test_bigdec_*。

module bigdec
choose runtime

use "bigint.lomt"
use "mem.lomt"

/// 头: scale + 符号 (两个 u32)。
pub const BDEC_HDR: u32 = 8;

/// 装 cap 个肢体需要多少字节。
pub fn bigdec_bytes(cap: u32) -> u32 {
    return BDEC_HDR + 4 + 4 * cap;
}

fn bd_coef(b: ptr) -> ptr {
    return ((b as u64) + (BDEC_HDR as u64)) as ptr;
}

pub fn bigdec_scale(b: ptr) -> u32 {
    return mem_load32(b, 0);
}

pub fn bigdec_sign(b: ptr) -> u32 {
    return mem_load32(b, 4);
}

fn bd_set(b: ptr, scale: u32, sign: u32) {
    mem_store32(b, 0, scale);
    mem_store32(b, 4, sign);
}

fn bd_set_scale(b: ptr, scale: u32) {
    mem_store32(b, 0, scale);
}

/// 置零 (scale 也归零)。
pub fn bigdec_zero(b: ptr, cap: u32) {
    bd_set(b, 0, 0);
    bigint_zero(bd_coef(b), cap);
}

pub fn bigdec_is_zero(b: ptr) -> bool {
    return bigint_is_zero(bd_coef(b));
}

/// 从 u64 装, 值 = v / 10^scale。
pub fn bigdec_from_u64(b: ptr, cap: u32, v: u64, scale: u32) {
    bd_set(b, scale, 0);
    bigint_from_u64(bd_coef(b), cap, v);
}

/// 从 i64 装, 值 = v / 10^scale。
pub fn bigdec_from_i64(b: ptr, cap: u32, v: i64, scale: u32) {
    let mag: u64 = v as u64;
    let sign: u32 = 0;
    if (mag >> 63) == 1 {
        sign = 1;
        mag = (mag ^ 18446744073709551615) + 1;
    }
    bd_set(b, scale, sign);
    bigint_from_u64(bd_coef(b), cap, mag);
}

/// 整数装入 (scale = 0)。
pub fn bigdec_from_int64(b: ptr, cap: u32, v: i64) {
    bigdec_from_i64(b, cap, v, 0);
}

/// 拷贝。
pub fn bigdec_copy(r: ptr, cap: u32, a: ptr) {
    bd_set(r, bigdec_scale(a), bigdec_sign(a));
    bigint_copy(bd_coef(r), cap, bd_coef(a));
}

/// 绝对值比较: 1 = |a|>|c|, 0 = 相等, 2 = |a|<|c|。scale 不同会先对齐。
pub fn bigdec_cmp_abs(a: ptr, c: ptr, sc: ptr, sccap: u32) -> u32 {
    let sa: u32 = bigdec_scale(a);
    let sc2: u32 = bigdec_scale(c);
    if sa == sc2 {
        return bigint_cmp(bd_coef(a), bd_coef(c));
    }
    if sa > sc2 {
        bigint_mul_pow10(sc, sccap, bd_coef(c), sa - sc2);
        return bigint_cmp(bd_coef(a), sc);
    }
    bigint_mul_pow10(sc, sccap, bd_coef(a), sc2 - sa);
    return bigint_cmp(sc, bd_coef(c));
}

/// 带符号比较: 1 = a>c, 0 = 相等, 2 = a<c。sc 是调用方给的临时 bigint。
pub fn bigdec_cmp(a: ptr, c: ptr, sc: ptr, sccap: u32) -> u32 {
    let za: bool = bigdec_is_zero(a);
    let zc: bool = bigdec_is_zero(c);
    if za && zc {
        return 0;
    }
    let sa: u32 = bigdec_sign(a);
    let scn: u32 = bigdec_sign(c);
    if sa != scn {
        if sa == 1 {
            return 2;
        }
        return 1;
    }
    let m: u32 = bigdec_cmp_abs(a, c, sc, sccap);
    // 负数: 幅值大的反而小
    if sa == 1 {
        if m == 1 {
            return 2;
        }
        if m == 2 {
            return 1;
        }
        return 0;
    }
    return m;
}

/// r = a + c。结果的 scale = max(两者的 scale) —— 十进制加法不需要舍入。
pub fn bigdec_add(r: ptr, cap: u32, a: ptr, c: ptr, t1: ptr, t2: ptr, tcap: u32) {
    let sa: u32 = bigdec_scale(a);
    let sc2: u32 = bigdec_scale(c);
    let s: u32 = sa;
    if sc2 > s {
        s = sc2;
    }
    // 把两边都放大到 s
    bigint_copy(t1, tcap, bd_coef(a));
    if s > sa {
        bigint_mul_pow10(t1, tcap, t1, s - sa);
    }
    bigint_copy(t2, tcap, bd_coef(c));
    if s > sc2 {
        bigint_mul_pow10(t2, tcap, t2, s - sc2);
    }
    if bigdec_sign(a) == bigdec_sign(c) {
        bigint_add(bd_coef(r), cap, t1, t2);
        bd_set(r, s, bigdec_sign(a));
    } else {
        // 异号: 大减小
        let m: u32 = bigint_cmp(t1, t2);
        if m == 0 {
            bigdec_zero(r, cap);
        } else if m == 1 {
            bigint_sub(bd_coef(r), cap, t1, t2);
            bd_set(r, s, bigdec_sign(a));
        } else {
            bigint_sub(bd_coef(r), cap, t2, t1);
            bd_set(r, s, bigdec_sign(c));
        }
    }
}

/// r = a - c。
///
/// 不绕"翻转符号再相加"—— 语言里没法改调用方的数, 也没有负号运算 (bigint 是无符号的),
/// 所以减号就在这里显式分四种情形写出来。
pub fn bigdec_sub(r: ptr, cap: u32, a: ptr, c: ptr, t1: ptr, t2: ptr, tcap: u32) {
    let sa: u32 = bigdec_scale(a);
    let sc2: u32 = bigdec_scale(c);
    let s: u32 = sa;
    if sc2 > s {
        s = sc2;
    }
    bigint_copy(t1, tcap, bd_coef(a));
    if s > sa {
        bigint_mul_pow10(t1, tcap, t1, s - sa);
    }
    bigint_copy(t2, tcap, bd_coef(c));
    if s > sc2 {
        bigint_mul_pow10(t2, tcap, t2, s - sc2);
    }
    let sg: u32 = bigdec_sign(a);
    let sh: u32 = bigdec_sign(c);
    if sg != sh {
        // a - (-|c|) = a + |c|
        bigint_add(bd_coef(r), cap, t1, t2);
        bd_set(r, s, sg);
    } else {
        let m: u32 = bigint_cmp(t1, t2);
        if m == 0 {
            bigdec_zero(r, cap);
        } else if m == 1 {
            // |a| > |c|: 符号跟 a 的 (a 是正就是正, a 是负就还是负, 但幅值变小)
            bigint_sub(bd_coef(r), cap, t1, t2);
            bd_set(r, s, sg);
        } else {
            // |a| < |c|: 符号与 a 相反
            bigint_sub(bd_coef(r), cap, t2, t1);
            bd_set(r, s, sg ^ 1);
        }
    }
}

/// r = a * c。scale 相加, 符号取异或。
pub fn bigdec_mul(r: ptr, cap: u32, a: ptr, c: ptr, t: ptr, tcap: u32) {
    bigint_mul(t, tcap, bd_coef(a), bd_coef(c));
    bigint_copy(bd_coef(r), cap, t);
    bd_set(r, bigdec_scale(a) + bigdec_scale(c), bigdec_sign(a) ^ bigdec_sign(c));
}

/// r = a / d (d 是小的正整数), 保留 a 的 scale。余数向零丢 (即**截断**)。
/// 需要更少的小数位时接着用 bigdec_round_to —— 截断与舍入分开, 免得一个函数有两种意思。
///
/// **`d == 0` 不碰信号**: 结果写成 0 并返回 `BIG_DIV0`（`4294967295`，与
/// `bigint_divmod_small` 同一个哨兵）。原来它把 0 直接转给 `bigint_divmod_small` —— 那条
/// 路径是语言的运行时中止（`ud2`），进程收到 `SIGILL`，一个字都打不出来（issue #722）。
pub fn bigdec_div_small(r: ptr, cap: u32, a: ptr, d: u32, t: ptr, tcap: u32) -> u32 {
    if d == 0 {
        bigdec_zero(r, cap);
        return BIG_DIV0;
    }
    let rem: u32 = bigint_divmod_small(t, tcap, bd_coef(a), d);
    if rem == BIG_DIV0 {          // 不该发生（d 已非零），照同一条路收口
        bigdec_zero(r, cap);
        return BIG_DIV0;
    }
    bigint_copy(bd_coef(r), cap, t);
    bd_set(r, bigdec_scale(a), bigdec_sign(a));
    return 0;
}

/// 换标度: 只允许**放大** (scale 变大时补零, 精确); 缩小时会丢位, 用 round_to。
pub fn bigdec_scale_up(r: ptr, cap: u32, a: ptr, s: u32) {
    let sa: u32 = bigdec_scale(a);
    bigint_copy(bd_coef(r), cap, bd_coef(a));
    if s > sa {
        bigint_mul_pow10(bd_coef(r), cap, bd_coef(r), s - sa);
    }
    bd_set(r, s, bigdec_sign(a));
}

/// 舍到 s 位小数, 就近到偶数 (与浮点那边的默认一致)。
///
/// 判据用余数一次比出来: 商 q = 系数 / 10^drop, 余 r = 系数 % 10^drop;
/// 半个最小单位是 10^drop/2, 于是 r > 半 -> 进位, r < 半 -> 舍去,
/// **恰好等于半 -> 看 q 的奇偶** (到偶数)。drop 上限 18, 否则 10^drop 装不进 u64。
pub fn bigdec_round_to(r: ptr, cap: u32, a: ptr, s: u32, t: ptr, tcap: u32) {
    let sa: u32 = bigdec_scale(a);
    if s >= sa {
        bigdec_scale_up(r, cap, a, s);
    } else {
        let drop: u32 = sa - s;
        if drop > 18 {
            // 要丢掉的位数超过 u64 能表达的 10 的幂: 值远小于半个最小单位 -> 归零。
            bigdec_zero(r, cap);
            bd_set(r, s, bigdec_sign(a));
        } else {
            let rem: u64 = bd_divmod_pow10(t, tcap, bd_coef(a), drop);
            let half: u64 = pow10_u64(drop - 1) * 5;
            let odd: bool = bigint_limb_at(t, 0) % 2 == 1;
            let up: bool = rem > half || (rem == half && odd);
            bigint_copy(bd_coef(r), cap, t);
            bd_set(r, s, bigdec_sign(a));
            if up {
                bigint_add_small(bd_coef(r), cap, bd_coef(r), 1);
            }
        }
    }
}

/// 10^k, k <= 9。
fn pow10_u32(k: u32) -> u32 {
    let v: u32 = 1;
    let i: u32 = 0;
    while i < k && i < 9 {
        v = v * 10;
        i = i + 1;
    }
    return v;
}

/// 10^k, k <= 18。
fn pow10_u64(k: u32) -> u64 {
    let v: u64 = 1;
    let i: u32 = 0;
    while i < k {
        v = v * 10;
        i = i + 1;
    }
    return v;
}

/// 除以 10^k (k <= 18), 商写进 q, **返回余数**。
/// 分两档做: 先除 10^(k%9)、再除若干个 10^9, 余数按权重拼回来
/// (bigint 只有除以 u32 的除法, 所以大幂必须这样拆)。
fn bd_divmod_pow10(q: ptr, tcap: u32, a: ptr, k: u32) -> u64 {
    let g: u32 = k / 9;
    let rest: u32 = k % 9;
    bigint_copy(q, tcap, a);
    let rem: u64 = 0;
    let mult: u64 = 1;
    if rest > 0 {
        rem = bigint_divmod_small(q, tcap, q, pow10_u32(rest)) as u64;
        mult = pow10_u64(rest);
    }
    let i: u32 = 0;
    while i < g {
        let r1: u32 = bigint_divmod_small(q, tcap, q, 1000000000);
        rem = rem + (r1 as u64) * mult;
        mult = mult * 1000000000;
        i = i + 1;
    }
    return rem;
}

/// 去掉系数末尾的零 (scale 尽量小), 值不变: 0.50 -> 0.5。
///
/// 单独一个函数是有意的: `bigdec_to_dec` 按 scale **原样**打印 (0.50 就打 "0.50"),
/// 因为标度常常是有意义的信息 (钱就是两位)。要不带尾零就显式调这个。
pub fn bigdec_trim(r: ptr, cap: u32, a: ptr, t: ptr, tcap: u32) {
    bigint_copy(bd_coef(r), cap, bd_coef(a));
    let s: u32 = bigdec_scale(a);
    let sign: u32 = bigdec_sign(a);
    let ns: u32 = s;
    let go: u32 = 1;
    while ns > 0 && go == 1 {
        let rem: u32 = bigint_divmod_small(t, tcap, bd_coef(r), 10);
        if rem == 0 {
            bigint_copy(bd_coef(r), cap, t);
            ns = ns - 1;
        } else {
            go = 0;
        }
    }
    bd_set(r, ns, sign);
}

/// 输出十进制文本 (含小数点与符号), 返回长度。
pub fn bigdec_to_dec(out: ptr, o: u32, a: ptr, tmp: ptr, tcap: u32) -> u32 {
    let p: u32 = o;
    let sign: u32 = bigdec_sign(a);
    let scale: u32 = bigdec_scale(a);
    if sign == 1 && bigdec_is_zero(a) == false {
        store8(out, p, 45 as u8);
        p = p + 1;
    }
    // 系数先按整数打出来, 再插小数点
    let nd: u32 = bigint_to_dec(out, p, bd_coef(a), tmp, tcap);
    if scale == 0 {
        return nd + (p - o);
    }
    if nd > scale {
        // 小数点插在第 nd - scale 位之后: 整体右移 scale 位再补 '.'
        let cut: u32 = nd - scale;
        let i: u32 = 0;
        let j: u32 = nd;
        while i < scale {
            store8(out, p + j, load8(out, p + j - 1) as u8);
            j = j - 1;
            i = i + 1;
        }
        store8(out, p + cut, 46 as u8);
        return nd + 1 + (p - o);
    }
    // 需要补前导零: 0.00ddd
    let zeros: u32 = scale - nd;
    // 先把数字整体右移 (scale - nd + 2) 位, 腾出 "0." 与 zeros 个零
    let shift: u32 = zeros + 2;
    let i: u32 = 0;
    let j: u32 = nd;
    while i < nd {
        store8(out, p + j + shift - 1, load8(out, p + j - 1) as u8);
        j = j - 1;
        i = i + 1;
    }
    store8(out, p, 48 as u8);
    store8(out, p + 1, 46 as u8);
    let k: u32 = 0;
    while k < zeros {
        store8(out, p + 2 + k, 48 as u8);
        k = k + 1;
    }
    return shift + nd + (p - o);
}

/// 从十进制文本装 (只认可选负号 + 数字 + 至多一个小数点)。
pub fn bigdec_from_dec(b: ptr, cap: u32, s: ptr, o: u32, n: u32) -> bool {
    bigdec_zero(b, cap);
    let sign: u32 = 0;
    let i: u32 = 0;
    if n > 0 && load8(s, o) == 45 {
        sign = 1;
        i = 1;
    }
    let scale: u32 = 0;
    let seen_dot: u32 = 0;
    let bad: u32 = 0;
    while i < n && bad == 0 {
        let ch: u32 = load8(s, o + i);
        if ch >= 48 && ch <= 57 {
            bigint_mul_small(bd_coef(b), cap, bd_coef(b), 10);
            bigint_add_small(bd_coef(b), cap, bd_coef(b), ch - 48);
            if seen_dot == 1 {
                scale = scale + 1;
            }
        } else if ch == 46 && seen_dot == 0 {
            seen_dot = 1;
        } else {
            bad = 1;
        }
        i = i + 1;
    }
    bd_set(b, scale, sign);
    return bad == 0;
}

// ---------------------------------------------------------------- 自检

/// 比字符串: 字面量是 str 不是 ptr, 直接喂给 mem_eq 会被 E1 挡下。
fn bd_eq(out: ptr, n: u32, s: str) -> bool {
    return mem_eq(out, 0, str_ptr(s), 0, n);
}

fn test_bigdec_from_and_to_text() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    let s: str = "123.45";
    let ok: bool = bigdec_from_dec(a, 16, str_ptr(s), 0, 6);
    let n: u32 = bigdec_to_dec(out, 0, a, tmp, 16);
    return ok && bigdec_scale(a) == 2 && bigdec_sign(a) == 0
        && n == 6 && mem_eq(out, 0, str_ptr(s), 0, 6);
}

fn test_bigdec_negative_text() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    let s: str = "-0.75";
    let ok: bool = bigdec_from_dec(a, 16, str_ptr(s), 0, 5);
    let n: u32 = bigdec_to_dec(out, 0, a, tmp, 16);
    return ok && bigdec_sign(a) == 1 && n == 5 && mem_eq(out, 0, str_ptr(s), 0, 5);
}

fn test_bigdec_leading_zero_padding() -> bool {
    // 0.00123 的系数是 123 而 scale 是 5 —— 输出必须补出 "0.00"。
    let a: ptr = alloc(bigdec_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    let s: str = "0.00123";
    let ok: bool = bigdec_from_dec(a, 16, str_ptr(s), 0, 7);
    let n: u32 = bigdec_to_dec(out, 0, a, tmp, 16);
    return ok && n == 7 && mem_eq(out, 0, str_ptr(s), 0, 7);
}

fn test_bigdec_integer_scale_zero() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_i64(a, 16, 42 as i64, 0);
    let n: u32 = bigdec_to_dec(out, 0, a, tmp, 16);
    return n == 2 && bd_eq(out, 2, "42");
}

fn test_bigdec_the_point_of_decimal_01_plus_02() -> bool {
    // 这就是整层存在的理由: 0.1 + 0.2 **精确**等于 0.3。
    // (浮点那边是 0.30000000000000004 —— 见 f64fmt 的自检。)
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t1: ptr = alloc(bigint_dec_tmp_bytes(16));
    let t2: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 1, 1);
    bigdec_from_u64(c, 16, 2, 1);
    bigdec_add(r, 16, a, c, t1, t2, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    return n == 3 && bd_eq(out, 3, "0.3");
}

fn test_bigdec_add_with_different_scales() -> bool {
    // 1.5 + 0.25 = 1.75 (对齐: 150 + 25 = 175, scale 2)
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t1: ptr = alloc(bigint_dec_tmp_bytes(16));
    let t2: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 15, 1);
    bigdec_from_u64(c, 16, 25, 2);
    bigdec_add(r, 16, a, c, t1, t2, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    return bigdec_scale(r) == 2 && n == 4 && bd_eq(out, 4, "1.75");
}

fn test_bigdec_add_opposite_signs() -> bool {
    // 0.75 + (-0.25): 系数 50 标度 2。按 scale 原样打印是 "0.50" —— 标度是有意义的
    // 信息 (钱就是两位), 所以 to_dec 不偷偷去尾零; 要去尾零就显式调 trim。
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t1: ptr = alloc(bigint_dec_tmp_bytes(16));
    let t2: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 75, 2);
    bigdec_from_i64(c, 16, -25 as i64, 2);
    bigdec_add(r, 16, a, c, t1, t2, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    let ok1: bool = n == 4 && bd_eq(out, 4, "0.50");
    bigdec_trim(r, 16, r, tmp, 16);
    let n2: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    let ok2: bool = n2 == 3 && bigdec_scale(r) == 1 && bd_eq(out, 3, "0.5");
    bigdec_from_u64(a, 16, 5, 1);
    bigdec_from_i64(c, 16, -5 as i64, 1);
    bigdec_add(r, 16, a, c, t1, t2, 16);
    return ok1 && ok2 && bigdec_is_zero(r) && bigdec_sign(r) == 0;
}

fn test_bigdec_sub() -> bool {
    // 1.00 - 0.01 = 0.99; 0.01 - 1.00 = -0.99
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t1: ptr = alloc(bigint_dec_tmp_bytes(16));
    let t2: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 100, 2);
    bigdec_from_u64(c, 16, 1, 2);
    bigdec_sub(r, 16, a, c, t1, t2, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    let ok1: bool = n == 4 && bd_eq(out, 4, "0.99");
    bigdec_sub(r, 16, c, a, t1, t2, 16);
    let n2: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    return ok1 && bigdec_sign(r) == 1 && n2 == 5 && bd_eq(out, 5, "-0.99");
}

fn test_bigdec_mul_exact() -> bool {
    // 1.5 x 2.5 = 3.75 (系数 15*25=375, scale 1+1=2) —— 十进制乘法不丢位。
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 15, 1);
    bigdec_from_u64(c, 16, 25, 1);
    bigdec_mul(r, 16, a, c, t, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    return bigdec_scale(r) == 2 && n == 4 && bd_eq(out, 4, "3.75");
}

fn test_bigdec_mul_signs() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t: ptr = alloc(bigint_dec_tmp_bytes(16));
    bigdec_from_i64(a, 16, -2 as i64, 0);
    bigdec_from_i64(c, 16, -3 as i64, 0);
    bigdec_mul(r, 16, a, c, t, 16);
    let s1: u32 = bigdec_sign(r);
    bigdec_from_i64(c, 16, 3 as i64, 0);
    bigdec_mul(r, 16, a, c, t, 16);
    return s1 == 0 && bigdec_sign(r) == 1 && bigint_to_u64(bd_coef(r)) == 6 as u64;
}

fn test_bigdec_div_small() -> bool {
    // 10.00 / 4 = 2.50 (截断); 1.00 / 3 = 0.33 (截断, 不是 0.333...)
    let a: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 1000, 2);
    bigdec_div_small(r, 16, a, 4, t, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    let ok1: bool = n == 4 && bd_eq(out, 4, "2.50");
    bigdec_from_u64(a, 16, 100, 2);
    bigdec_div_small(r, 16, a, 3, t, 16);
    let n2: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    // d == 0: **返回哨兵、结果成 0**，不是 SIGILL（#722）
    bigdec_from_u64(a, 16, 100, 2);
    let r0: u32 = bigdec_div_small(r, 16, a, 0, t, 16);
    let ok0: bool = r0 == 4294967295 && bigdec_is_zero(r);
    return ok1 && n2 == 4 && bd_eq(out, 4, "0.33") && ok0;
}

fn test_bigdec_round_to_even() -> bool {
    // 2.5 -> 2, 3.5 -> 4 (就近到偶数); 2.6 -> 3
    let a: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 25, 1);
    bigdec_round_to(r, 16, a, 0, t, 16);
    let n1: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    let ok1: bool = n1 == 1 && bd_eq(out, 1, "2");
    bigdec_from_u64(a, 16, 35, 1);
    bigdec_round_to(r, 16, a, 0, t, 16);
    let n2: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    let ok2: bool = n2 == 1 && bd_eq(out, 1, "4");
    bigdec_from_u64(a, 16, 26, 1);
    bigdec_round_to(r, 16, a, 0, t, 16);
    let n3: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    return ok1 && ok2 && n3 == 1 && bd_eq(out, 1, "3");
}

fn test_bigdec_round_widening_is_exact() -> bool {
    // 目标 scale 更大时只补零, 不该舍入。
    let a: ptr = alloc(bigdec_bytes(16));
    let r: ptr = alloc(bigdec_bytes(16));
    let t: ptr = alloc(bigint_dec_tmp_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 5, 0);
    bigdec_round_to(r, 16, a, 3, t, 16);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 16);
    return bigdec_scale(r) == 3 && n == 5 && bd_eq(out, 5, "5.000");
}

fn test_bigdec_cmp() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let sc: ptr = alloc(bigint_dec_tmp_bytes(16));
    bigdec_from_u64(a, 16, 150, 2);  // 1.50
    bigdec_from_u64(c, 16, 15, 1);   // 1.5  —— 与 1.50 相等
    let eq: bool = bigdec_cmp(a, c, sc, 16) == 0;
    bigdec_from_u64(c, 16, 151, 2);
    let lt: bool = bigdec_cmp(a, c, sc, 16) == 2;
    bigdec_from_i64(c, 16, -1 as i64, 0);
    let gt: bool = bigdec_cmp(a, c, sc, 16) == 1;
    return eq && lt && gt;
}

fn test_bigdec_cmp_negatives() -> bool {
    // -2 与 -3: 幅值大的反而小
    let a: ptr = alloc(bigdec_bytes(16));
    let c: ptr = alloc(bigdec_bytes(16));
    let sc: ptr = alloc(bigint_dec_tmp_bytes(16));
    bigdec_from_i64(a, 16, -2 as i64, 0);
    bigdec_from_i64(c, 16, -3 as i64, 0);
    return bigdec_cmp(a, c, sc, 16) == 1 && bigdec_cmp(c, a, sc, 16) == 2;
}

fn test_bigdec_big_values() -> bool {
    // 20 位的两个数相加 —— 超出 u64 也能精确。
    let a: ptr = alloc(bigdec_bytes(32));
    let c: ptr = alloc(bigdec_bytes(32));
    let r: ptr = alloc(bigdec_bytes(32));
    let t1: ptr = alloc(bigint_dec_tmp_bytes(32));
    let t2: ptr = alloc(bigint_dec_tmp_bytes(32));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(32));
    let out: ptr = alloc(96);
    let s1: str = "9999999999999999.99";
    let s2: str = "0.01";
    let want: str = "10000000000000000.00";
    bigdec_from_dec(a, 32, str_ptr(s1), 0, 19);
    bigdec_from_dec(c, 32, str_ptr(s2), 0, 4);
    bigdec_add(r, 32, a, c, t1, t2, 32);
    let n: u32 = bigdec_to_dec(out, 0, r, tmp, 32);
    return n == 20 && mem_eq(out, 0, str_ptr(want), 0, 20);
}

fn test_bigdec_from_dec_rejects_garbage() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let s: str = "12x4";
    return bigdec_from_dec(a, 16, str_ptr(s), 0, 4) == false;
}

fn test_bigdec_zero_text() -> bool {
    let a: ptr = alloc(bigdec_bytes(16));
    let tmp: ptr = alloc(bigint_dec_tmp_bytes(16));
    let out: ptr = alloc(64);
    bigdec_from_u64(a, 16, 0, 2);
    let n: u32 = bigdec_to_dec(out, 0, a, tmp, 16);
    return n == 4 && bd_eq(out, 4, "0.00");
}
