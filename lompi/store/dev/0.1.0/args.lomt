// std/args.lomt — 命令行参数查询（argv 是 `char**`，NUL 结尾）
//
// 为什么不是"解析器": 命令行解析的**策略**（短选项合并、子命令、默认值、帮助文本）
// 每个程序都不同；但"查一个开关在不在""取一个选项的值"是同一个动作。这一层只给
// 查询，不给策略 —— 与 `getopt` 只给遍历、不给业务是同一个分界。
//
// 支持的形式:
//   `--name`           开关
//   `--name=value`     内联值
//   `--name value`     分离值（`ag_value` 取下一个参数）
// 不处理短选项 `-n` 的合并（`-abc`）—— 那是策略，不是查询。
//
// 命名: 公开 ag_*, 内部 ag_*。自检 test_args_*。

module args
choose runtime

use mem

fn ag_at(argv: ptr, i: u32) -> ptr {
    return mem_load64(argv, i * 8) as ptr;
}

fn ag_cstr_len(p: ptr) -> u32 {
    let i: u32 = 0;
    while load8(p, i) != 0 {
        i = i + 1;
    }
    return i;
}

/// `argv[i]` 是否等于 `name`，或形如 `name=...`。返回 1/0；`value_off_out` 收到
/// `=` 之后的位置（没有 `=` 写 0）。
fn ag_match(p: ptr, name: str, value_off_out: ptr) -> u32 {
    mem_store32(value_off_out, 0, 0);
    let n: u32 = str_len(name);
    let i: u32 = 0;
    while i < n {
        if load8(p, i) != str_byte(name, i) {
            return 0;
        }
        i = i + 1;
    }
    let c: u32 = load8(p, n);
    if c == 0 {
        return 1;
    }
    if c == 61 { // '='
        mem_store32(value_off_out, 0, n + 1);
        return 1;
    }
    return 0;
}

/// 第一次出现的位置（下标）；没有返回 -1。
pub fn ag_find(argv: ptr, argc: u32, name: str) -> i64 {
    let off: ptr = alloc(4);
    let i: u32 = 0;
    while i < argc {
        if ag_match(ag_at(argv, i), name, off) == 1 {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 as i64 - 1;
}

pub fn ag_has(argv: ptr, argc: u32, name: str) -> bool {
    return ag_find(argv, argc, name) >= (0 as i64);
}

pub fn ag_count(argv: ptr, argc: u32, name: str) -> u32 {
    let off: ptr = alloc(4);
    let c: u32 = 0;
    let i: u32 = 0;
    while i < argc {
        if ag_match(ag_at(argv, i), name, off) == 1 {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

fn ag_copy(out: ptr, cap: u32, src: ptr) -> u32 {
    if cap == 0 {
        return 0;
    }
    let n: u32 = ag_cstr_len(src);
    let m: u32 = n;
    if m > cap - 1 {
        m = cap - 1;
    }
    mem_copy(out, 0, src, 0, m);
    store8(out, m, 0 as u8);
    return m;
}

/// 取选项的值：先看内联 `--name=value`，否则取下一个参数。找不到返回 0（没写 out）。
pub fn ag_value(argv: ptr, argc: u32, name: str, out: ptr, cap: u32) -> u32 {
    let off: ptr = alloc(4);
    let i: u32 = 0;
    while i < argc {
        let p: ptr = ag_at(argv, i);
        if ag_match(p, name, off) == 1 {
            let o: u32 = mem_load32(off, 0);
            if o != 0 {
                return ag_copy(out, cap, ptr_add(p, o));
            }
            if i + 1 < argc {
                return ag_copy(out, cap, ag_at(argv, i + 1));
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

/// 第 idx 个**非选项**参数（不以 `-` 开头）；没有返回 0。
pub fn ag_positional(argv: ptr, argc: u32, idx: u32) -> u64 {
    let seen: u32 = 0;
    let i: u32 = 0;
    while i < argc {
        let p: ptr = ag_at(argv, i);
        if load8(p, 0) != 45 { // '-'
            if seen == idx {
                return p as u64;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return 0 as u64;
}

// ---------------------------------------------------------------- 自检

fn test_args_find() -> bool {
    let argv: ptr = alloc(32);
    let a: ptr = alloc(8);
    let b: ptr = alloc(8);
    let c: ptr = alloc(8);
    store8(a, 0, 45 as u8); store8(a, 1, 45 as u8); store8(a, 2, 120 as u8); store8(a, 3, 0 as u8);
    store8(b, 0, 45 as u8); store8(b, 1, 45 as u8); store8(b, 2, 121 as u8); store8(b, 3, 61 as u8);
    store8(b, 4, 53 as u8); store8(b, 5, 0 as u8);
    store8(c, 0, 102 as u8); store8(c, 1, 0 as u8);
    mem_store64(argv, 0, a as u64);
    mem_store64(argv, 8, b as u64);
    mem_store64(argv, 16, c as u64);
    let out: ptr = alloc(8);
    if ag_find(argv, 3, "--x") != 0 {
        return false;
    }
    if ag_find(argv, 3, "--y") != 1 {
        return false;
    }
    if ag_value(argv, 3, "--y", out, 8) != 1 || load8(out, 0) != 53 {
        return false;
    }
    let pos: u64 = ag_positional(argv, 3, 0);
    return pos == (c as u64);
}

fn test_args_absent() -> bool {
    let argv: ptr = alloc(8);
    let a: ptr = alloc(4);
    store8(a, 0, 45 as u8); store8(a, 1, 0 as u8);
    mem_store64(argv, 0, a as u64);
    return !ag_has(argv, 1, "--nope") && ag_find(argv, 1, "--nope") == (0 as i64 - 1);
}
