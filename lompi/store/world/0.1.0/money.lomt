// std/money.lomt — 定点货币运算（i64 分）
//
// 为什么不用 double: 0.1 + 0.2 != 0.3；钱不能有这种"看起来对"的误差。货币的最小单位
// （分/便士/日元）是整数，所以全部用 **i64 分**，只在输入/输出时转成文本。
//
// 两个真正容易错的点，这里各给一个函数:
//   * **分摊**（`mo_split`）：100 分给 3 个人，前 1 个人多 1 分，总和必须仍是 100；
//   * **百分比**（`mo_mul_bp`）：用基点（1 bp = 0.01%），四舍五入**远离零**。
//
// 不做的: 多币种/汇率、复利计息日规则、税费规则 —— 那些是业务规则，不是算术。
//
// 命名: 公开 mo_*, 内部 mo_*。自检 test_money_*。

module money
choose runtime

use mem
use numfmt

pub fn mo_add(a: i64, b: i64) -> i64 {
    return a + b;
}

pub fn mo_sub(a: i64, b: i64) -> i64 {
    return a - b;
}

/// 按基点（1/10000）缩放，四舍五入远离零。
pub fn mo_mul_bp(cents: i64, bp: i64) -> i64 {
    let p: i64 = cents * bp;
    let q: i64 = p / (10000 as i64);
    let r: i64 = p % (10000 as i64);
    if r * (2 as i64) >= (10000 as i64) {
        return q + 1;
    }
    if r * (2 as i64) <= (0 as i64 - 10000) {
        return q - 1;
    }
    return q;
}

/// 把 `total` 分成 n 份，余数从第一份开始各 +1（负总数则各 -1）。写 n 个 i64 到 out。
pub fn mo_split(total: i64, n: u32, out: ptr) {
    if n == 0 {
        return;
    }
    let base: i64 = total / (n as i64);
    let rem: i64 = total % (n as i64);
    let i: u32 = 0;
    while i < n {
        let v: i64 = base;
        if rem > 0 && (i as i64) < rem {
            v = v + 1;
        }
        if rem < 0 && (i as i64) < (0 as i64 - rem) {
            v = v - 1;
        }
        mem_store64(out, i * 8, v as u64);
        i = i + 1;
    }
}

/// 复利：每期按 `rate_bp` 基点计息（每期四舍五入）。
pub fn mo_compound(principal: i64, rate_bp: i64, periods: u32) -> i64 {
    let p: i64 = principal;
    let i: u32 = 0;
    while i < periods {
        p = p + mo_mul_bp(p, rate_bp);
        i = i + 1;
    }
    return p;
}

/// 分 -> "-123.45"（总是两位小数）。返回写出的字节数；cap < 32 返回 0。
pub fn mo_format(cents: i64, out: ptr, cap: u32) -> u32 {
    if cap < 32 {
        return 0;
    }
    let pos: u32 = 0;
    let neg: bool = cents < (0 as i64);
    let mag_i: u64 = 0;
    if neg {
        mag_i = ((cents as u64) ^ 18446744073709551615) + 1;
    } else {
        mag_i = cents as u64;
    }
    if neg {
        store8(out, pos, 45 as u8);
        pos = pos + 1;
    }
    let whole: u64 = mag_i / (100 as u64);
    let frac: u64 = mag_i % (100 as u64);
    let n: u32 = numfmt_dec_into(ptr_add(out, pos), whole);
    pos = pos + n;
    store8(out, pos, 46 as u8);
    store8(out, pos + 1, (48 + frac / 10) as u8);
    store8(out, pos + 2, (48 + frac % 10) as u8);
    pos = pos + 3;
    store8(out, pos, 0 as u8);
    return pos;
}

fn mo_fail(ok_out: ptr) -> i64 {
    mem_store32(ok_out, 0, 0);
    return 0 as i64;
}

/// 解析 "-123.45" -> -12345。`ok_out`（4 字节）写 1/0。
/// 小数位**最多两位**；更多位、空串、尾部杂字符都算失败（不猜四舍五入）。
pub fn mo_parse_ok(s: str, ok_out: ptr) -> i64 {
    mem_store32(ok_out, 0, 0);
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let neg: u32 = 0;
    if i < n {
        let c0: u32 = str_byte(s, i);
        if c0 == 45 {
            neg = 1;
            i = i + 1;
        } else if c0 == 43 {
            i = i + 1;
        }
    }
    let whole: i64 = 0;
    let nd: u32 = 0;
    let scanning: u32 = 1;
    while scanning == 1 && i < n {
        let c: u32 = str_byte(s, i);
        if c >= 48 && c <= 57 {
            if whole < 92233720368547758 as i64 {
                whole = whole * (10 as i64) + ((c - 48) as i64);
            }
            nd = nd + 1;
            i = i + 1;
        } else {
            scanning = 0;
        }
    }
    let frac: i64 = 0;
    let fd: u32 = 0;
    if i < n && str_byte(s, i) == 46 {
        i = i + 1;
        let scanning2: u32 = 1;
        while scanning2 == 1 && i < n {
            let c2: u32 = str_byte(s, i);
            if c2 >= 48 && c2 <= 57 {
                if fd >= 2 {
                    return mo_fail(ok_out); // 多于两位小数：不替调用方猜
                }
                frac = frac * (10 as i64) + ((c2 - 48) as i64);
                fd = fd + 1;
                i = i + 1;
            } else {
                scanning2 = 0;
            }
        }
    }
    // 尾随空白
    while i < n {
        let ct: u32 = str_byte(s, i);
        if ct == 32 || ct == 9 {
            i = i + 1;
        } else {
            return mo_fail(ok_out);
        }
    }
    if nd == 0 && fd == 0 {
        return mo_fail(ok_out);
    }
    // 名字不能与上面 `let c2: u32` 重名：本语言的核心**没有块作用域**（#1309），
    // 后声明的同名变量会复用先前的类型槽 —— 这里会让 alloca 变成 i32。
    let cents: i64 = whole;
    if fd == 0 {
        cents = whole * (100 as i64);
    } else if fd == 1 {
        cents = whole * (100 as i64) + frac * (10 as i64);
    } else {
        cents = whole * (100 as i64) + frac;
    }
    mem_store32(ok_out, 0, 1);
    if neg == 1 {
        return 0 as i64 - cents;
    }
    return cents;
}

// ---------------------------------------------------------------- 自检

fn test_money_parse_format() -> bool {
    let ok: ptr = alloc(4);
    let out: ptr = alloc(32);
    let c: i64 = mo_parse_ok("123.45", ok);
    if mem_load32(ok, 0) != 1 || c != 12345 {
        return false;
    }
    let n: u32 = mo_format(c, out, 32);
    let want: str = "123.45";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(out, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_money_split() -> bool {
    let out: ptr = alloc(24);
    mo_split(100, 3, out);
    return mem_load64(out, 0) == 34 && mem_load64(out, 8) == 33
        && mem_load64(out, 16) == 33;
}

fn test_money_bp() -> bool {
    // 100 分 * 12.5% (1250 bp) = 12.5 -> 13（远离零）
    return mo_mul_bp(100, 1250) == 13 && mo_mul_bp(0 as i64 - 100, 1250) == 0 as i64 - 13;
}

fn test_money_compound() -> bool {
    // 10000 分（100 元）按 10%（1000 bp）两年 -> 12100（每期四舍五入）
    return mo_compound(10000, 1000, 2) == 12100;
}
