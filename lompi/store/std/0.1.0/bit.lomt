// std/bit.lomt — 位操作
//
// 为什么要它: `popcount` / `fib` / `gcd` 在示例里各被写了三四遍, 自举侧还有自己的
// 位表操作。内建只给了 `get_bits` / `set_bits` (u8 位域) 和 `atomic_add`, 32 位这一级
// 的都得自己来。
//
// 命名: 公开一律 bit_*, 内部一律 bi_*。自检 test_bit_* (私有名也占全局拼写, E13)。
//
// 移位边界: LLVM 里 `x << 32` 是未定义行为, 所以凡是移位量可能达到位宽的地方
// 都显式取模或提前返回 —— 这类越界是静默的, 不能靠"调用方不会传 32"。

module bit

/// 32 位的 1 个数。
pub fn bit_popcount32(v: u32) -> u32 {
    let n: u32 = 0;
    let x: u32 = v;
    while x != 0 {
        n = n + (x & 1);
        x = x >> 1;
    }
    return n;
}

/// 64 位的 1 个数。
pub fn bit_popcount64(v: u64) -> u32 {
    let n: u32 = 0;
    let x: u64 = v;
    while x != 0 {
        n = n + ((x & 1) as u32);
        x = x >> 1;
    }
    return n;
}

/// 前导零个数。v == 0 返回 32 (与 Rust 一致)。
pub fn bit_clz32(v: u32) -> u32 {
    if v == 0 {
        return 32;
    }
    let n: u32 = 0;
    let x: u32 = v;
    let go: u32 = 1;
    while go == 1 {
        if (x & 2147483648) != 0 {
            go = 0;
        } else {
            x = x << 1;
            n = n + 1;
        }
    }
    return n;
}

/// 尾部零个数。v == 0 返回 32。
pub fn bit_ctz32(v: u32) -> u32 {
    if v == 0 {
        return 32;
    }
    let n: u32 = 0;
    let x: u32 = v;
    let go: u32 = 1;
    while go == 1 {
        if (x & 1) != 0 {
            go = 0;
        } else {
            x = x >> 1;
            n = n + 1;
        }
    }
    return n;
}

pub fn bit_test(v: u32, i: u32) -> bool {
    if i >= 32 {
        return false;
    }
    return (v & (1 << i)) != 0;
}

pub fn bit_set(v: u32, i: u32) -> u32 {
    if i >= 32 {
        return v;
    }
    return v | (1 << i);
}

pub fn bit_clr(v: u32, i: u32) -> u32 {
    if i >= 32 {
        return v;
    }
    return v & (4294967295 - (1 << i));
}

pub fn bit_toggle(v: u32, i: u32) -> u32 {
    if i >= 32 {
        return v;
    }
    return v ^ (1 << i);
}

/// 循环左移。n 按 32 取模 —— 传 32 得到原值, 而不是未定义。
pub fn bit_rotl32(v: u32, n: u32) -> u32 {
    let k: u32 = n % 32;
    if k == 0 {
        return v;
    }
    return (v << k) | (v >> (32 - k));
}

/// 循环右移。
pub fn bit_rotr32(v: u32, n: u32) -> u32 {
    let k: u32 = n % 32;
    if k == 0 {
        return v;
    }
    return (v >> k) | (v << (32 - k));
}

/// 向下取整的 log2。v == 0 返回 0 (定义成 0, 不返回哨兵 —— 调用方多处只当"位宽"用)。
pub fn bit_ilog2(v: u32) -> u32 {
    if v == 0 {
        return 0;
    }
    let n: u32 = 0;
    let x: u32 = v;
    while x > 1 {
        x = x >> 1;
        n = n + 1;
    }
    return n;
}

/// 最小的 >= v 的 2 的幂。v > 2^31 时结果装不下 u32, 返回 0 (溢出哨兵)。
pub fn bit_next_pow2(v: u32) -> u32 {
    if v <= 1 {
        return 1;
    }
    let x: u32 = v - 1;
    let n: u32 = bit_ilog2(x) + 1;
    if n >= 32 {
        return 0;
    }
    return 1 << n;
}

// ---------------------------------------------------------------- 自检

fn test_bit_popcount32() -> bool {
    return bit_popcount32(0) == 0
        && bit_popcount32(1) == 1
        && bit_popcount32(255) == 8
        && bit_popcount32(4294967295) == 32;
}

fn test_bit_popcount64() -> bool {
    return bit_popcount64(0 as u64) == 0
        && bit_popcount64(18446744073709551615) == 64
        && bit_popcount64(4294967295) == 32;
}

fn test_bit_clz32() -> bool {
    return bit_clz32(0) == 32 && bit_clz32(1) == 31 && bit_clz32(2147483648) == 0;
}

fn test_bit_ctz32() -> bool {
    return bit_ctz32(0) == 32 && bit_ctz32(1) == 0 && bit_ctz32(8) == 3;
}

fn test_bit_test() -> bool {
    return bit_test(4, 2) && !bit_test(4, 1) && !bit_test(1, 32);
}

fn test_bit_set_clr_toggle() -> bool {
    let a: u32 = bit_set(0, 3);
    let b: u32 = bit_clr(a, 3);
    let c: u32 = bit_toggle(0, 5);
    return a == 8 && b == 0 && c == 32;
}

fn test_bit_rotl32() -> bool {
    return bit_rotl32(1, 1) == 2
        && bit_rotl32(2147483648, 1) == 1
        && bit_rotl32(7, 32) == 7
        && bit_rotl32(7, 0) == 7;
}

fn test_bit_rotr32() -> bool {
    return bit_rotr32(2, 1) == 1 && bit_rotr32(1, 1) == 2147483648 && bit_rotr32(7, 32) == 7;
}

fn test_bit_ilog2() -> bool {
    return bit_ilog2(0) == 0 && bit_ilog2(1) == 0 && bit_ilog2(2) == 1
        && bit_ilog2(7) == 2 && bit_ilog2(8) == 3 && bit_ilog2(2147483648) == 31;
}

fn test_bit_next_pow2() -> bool {
    return bit_next_pow2(0) == 1 && bit_next_pow2(1) == 1 && bit_next_pow2(2) == 2
        && bit_next_pow2(3) == 4 && bit_next_pow2(4096) == 4096 && bit_next_pow2(4097) == 8192;
}

fn test_bit_next_pow2_overflow() -> bool {
    // 2^31 是能表示的最大 2 的幂; 再往上装不下 —— 必须是哨兵而不是回绕。
    return bit_next_pow2(2147483648) == 2147483648 && bit_next_pow2(2147483649) == 0;
}
