// baremetal/pci.lomt — PCI 配置空间字段与 BAR 解码
//
// 为什么标准库要有它: PCI 的 BAR 不是"一个地址" —— 最低位是 I/O 标志，第 2:1 位是
// 类型（00 32 位内存、10 64 位内存），64 位 BAR 要**把下一个 BAR 当高 32 位**拼起来。
// 直接把 4 字节当地址用，在 64 位 BAR 上会得到半个地址，而且不报错。
//
// 口径: 传统 256 字节配置空间（PCIe 的 4 KiB 扩展不在这一层）。小端。
//
// 不做的: 枚举总线、读写配置空间（那要 I/O 端口 0xCF8/0xCFC 或 ECAM）、
// 能力链表、MSI/MSI-X —— 这一层只解码调用方读回来的字节。
//
// 命名: 公开 pci_*, 内部 pci_*。自检 test_pci_*。

module pci
choose runtime

use mem
use endian

fn pci_u8(cfg: ptr, o: u32) -> u32 {
    return load8(cfg, o);
}

fn pci_u16(cfg: ptr, o: u32) -> u32 {
    return endian_load16le(cfg, o);
}

fn pci_u32(cfg: ptr, o: u32) -> u32 {
    return endian_load32le(cfg, o);
}

pub fn pci_vendor(cfg: ptr) -> u32 {
    return pci_u16(cfg, 0);
}

pub fn pci_device(cfg: ptr) -> u32 {
    return pci_u16(cfg, 2);
}

pub fn pci_header_type(cfg: ptr) -> u32 {
    return pci_u8(cfg, 14);
}

/// (class << 16) | (subclass << 8) | prog_if。
pub fn pci_class(cfg: ptr) -> u32 {
    return (pci_u8(cfg, 11) << 16) | (pci_u8(cfg, 10) << 8) | pci_u8(cfg, 9);
}

pub fn pci_bdf(bus: u32, dev: u32, func: u32) -> u32 {
    return (bus << 8) | (dev << 3) | func;
}

/// BAR 的原始 32 位（i 0..5）。
pub fn pci_bar_raw(cfg: ptr, i: u32) -> u32 {
    if i >= 6 {
        return 0;
    }
    return pci_u32(cfg, 16 + i * 4);
}

pub fn pci_bar_is_io(cfg: ptr, i: u32) -> bool {
    return (pci_bar_raw(cfg, i) & 1) != 0;
}

/// 解码 BAR 的地址。I/O 空间返回端口号；内存空间返回物理地址（64 位 BAR 会拼上
/// 下一个 BAR 的高 32 位）。
pub fn pci_bar_addr(cfg: ptr, i: u32) -> u64 {
    let v: u32 = pci_bar_raw(cfg, i);
    if v == 0 {
        return 0 as u64;
    }
    if (v & 1) != 0 {
        return (v & 4294967292) as u64; // ~3
    }
    if ((v >> 1) & 3) == 2 && i < 5 {
        let hi: u32 = pci_bar_raw(cfg, i + 1);
        return ((v & 4294967280) as u64) | ((hi as u64) << 32);
    }
    return (v & 4294967280) as u64; // ~15
}

/// BAR 占几个 32 位槽（64 位内存 BAR 占 2 个）。
pub fn pci_bar_slots(cfg: ptr, i: u32) -> u32 {
    let v: u32 = pci_bar_raw(cfg, i);
    if (v & 1) == 0 && ((v >> 1) & 3) == 2 {
        return 2;
    }
    return 1;
}

// ---------------------------------------------------------------- 自检

fn test_pci_ids() -> bool {
    let c: ptr = alloc(256);
    mem_fill(c, 0, 256, 0);
    endian_store16le(c, 0, 32902); // 0x8086 Intel
    endian_store16le(c, 2, 4660);  // 0x1234
    store8(c, 9, 1 as u8);         // prog_if
    store8(c, 10, 3 as u8);        // subclass
    store8(c, 11, 2 as u8);        // class
    return pci_vendor(c) == 32902 && pci_device(c) == 4660
        && pci_class(c) == 131841 && pci_bdf(1, 2, 3) == 275;
}

fn test_pci_bar() -> bool {
    let c: ptr = alloc(256);
    mem_fill(c, 0, 256, 0);
    // BAR0: 32 位内存 0xFEBF0000
    endian_store32le(c, 16, 4273868800);
    // BAR1: I/O 0xC001
    endian_store32le(c, 20, 49153);
    // BAR2/BAR3: 64 位内存 0x0000000100000000
    endian_store32le(c, 24, 4);       // 低 32 位 + type=10
    endian_store32le(c, 28, 1);       // 高 32 位
    return pci_bar_addr(c, 0) == 4273868800 as u64
        && pci_bar_is_io(c, 1) && pci_bar_addr(c, 1) == 49152
        && pci_bar_addr(c, 2) == 4294967296
        && pci_bar_slots(c, 2) == 2;
}
