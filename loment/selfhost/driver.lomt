// loment/selfhost/driver.lomt — M83/M85: 独立的自举编译器 (docs/145/150)
//
//   ./fujoc-s loment/examples/demo.lomt > demo.ll
//
// 它自己做**全部装载** —— 这是它不再是"被夹具喂单元的函数"的关键:
//
// 1. 入口路径从 `/proc/self/cmdline` 取。`_start` 的 argc/argv 在栈上, 不写内联汇编
//    拿不到; `/proc` 给了同样的信息, 代价是一次 openat+read。
// 2. `use "..."` 递归解析, 依赖按**先序**拼进单元 (与 `lomentc.resolve_deps` 同规则),
//    同一路径只装一次 (循环导入自然被去重表挡住)。
// 3. 单元里缺 `Option`/`Result` 时注入预置枚举 (与 `lomentc.load` 同规则) ——
//    注入点必须在**单元末尾**, 因为参考实现是把预置枚举 append 到模块枚举之后的。
//
// 内存来自内核 (`brk`), 不用语言自带的 64 KiB bump 堆: 一个 190 KiB 的单元要 ~4 MiB
// token 表加 ~1.5 MiB 输出。把那个静态堆调大是**错的方向** —— 每个 `alloc` 用户
// (内核模块尤其) 的 `.bss` 都要跟着涨。这也是 M83 顺手补上 `整数 as ptr` 的原因
// (M67 只做了反方向的 `ptr as u64`)。
//
// 每层源文件在单元缓冲**顶部**占一个固定槽 (SLOT), 因为输出是顺序写的而依赖必须先写:
// 父文件读进自己的槽 → 递归处理它的 `use` → 再把槽里的字节补到自己后面。
// 写成"先写自己再回头看依赖"会让依赖落在后面, 与参考实现的顺序不符。

module driver
choose runtime

// 尺寸都用 u32 字面量: 常量在表达式里**没有类型** (参考实现的 expr_type(Ident) 只看
// 局部/参数), 所以 `(SLOT + 64) * 20` 会被算成 i32。要么显式 `as u64`, 要么把乘积
// 预先算成常量 —— 后者更省事也更好读。
// **这一格是被撞出来的**（2026-10-11）：`codegen.lomt` 涨到 262858 字节，而槽是 262144
// —— 只差 714，症状是**自举段错误**（`loment_seed_test` 的退出码 139），不是一句报错。
// 槽的用途就是「装得下最大的那份源」，所以源长了就抬它（同 `TB_LBL_MAX` 那两次）。
const SLOT: u32 = 524288;        // 每层源文件槽 (够装最大的 codegen.lomt)
const MAXDEPTH: u32 = 8;         // 依赖深度上限
const UNIT_CAP: u32 = 8388608;   // 单元缓冲 (含顶部 MAXDEPTH*SLOT 的槽区)
const IR_CAP: u32 = 16777216;    // IR 输出缓冲 (上界 8*单元 + 8192, 留足余量)
const SEEN_CAP: u32 = 65536;     // 已装载路径去重表
// 小暂存的布局 (改了偏移必须所有用点一起改 —— 它们写在同一块内存上):
//   [0, 4000)      NUL 路径 (open_ro 要 C 串)
//   [4096, 6496)   use 清单 (MAX_USE 条, 每条 8 字节: 起点 + 长度)
//   [6496, 11520)  候选路径暂存 (resolve_use_name / fix_rel / try_pkg_module)
//   [11520, 11584) wdec 的数字缓冲
//   [11584, 12608) 项目根: 入口文件所在目录 (NUL)  ← 名字形式的 deps/ 层相对它
//   [12608, 13632) 工具目录: argv[0] 所在目录 (NUL) ← 自带 store 相对它
//   [13632, 14656) 版本名: store 里列出的那个子目录 (NUL)
//   [14656, 15680) 包名: 遍历包的子目录时那一个 (NUL)
//   [15680, 17728) 库根前缀: deps 目录 / store 根 (NUL) ← try_pkg_module 的 base
//   [17728, 18752) 目录项缓冲 (getdents64)
//   [18752, 20224) 子路径暂存 (<dir>/<entry>, 判是不是目录用)
//   [20224, 20480) 源后缀: loment.conf 里配的那个 (NUL), 空 = 用默认 .lomt
//   [20480, 21504) --diag-out 路径 (NUL), 空 = 不吐结构化诊断 (docs/182 §5)
//   [21504, 23904) addin 清单 (MAX_ADDIN 条, 每条 8 字节: 起点 + 长度)
//   [23904, 24160) 命令名 (`--print-command` 抄出来的那一个, 不补 NUL)
//   [24160, 24164) 这一次的 `--diag-out` fd **加一** (0 = 没给) ← 见 `diagfd`
const SCR_CAP: u32 = 24164;
//: 单个文件的 `use` 条数上限 (路径形式 + 名字形式合起来算), **与参考实现同值**。
//: 超限**报错退出**, 绝不静默丢 —— 原先进程按 8 条布局, 第 9 条起直接不要, 而参考实现
//: 无上限: 同一份源码两个实现给出不同的单元 (2026-09-16 发现)。抬到 300 是让 std 那种
//: 多模块门面装得下。
const MAX_USE: u32 = 300;
//: `addin` 的条数上限, **与参考实现 (`lomentc.MAX_ADDIN`) 同值**。与 `MAX_USE` 同一条
//: 纪律: **超限报错, 绝不静默丢** —— 丢一条 `addin` = 一整份开关设定凭空消失。
const MAX_ADDIN: u32 = 300;
const USE_OFF: u32 = 4096;       // use 清单起点
const NAMTMP_OFF: u32 = 6496;    // 候选路径暂存起点
const PROJ_OFF: u32 = 11584;     // 项目根
const TOOLDIR_OFF: u32 = 12608;  // 工具目录
const VER_OFF: u32 = 13632;      // 版本名
const PKG_OFF: u32 = 14656;      // 包名 (遍历包目录时那一个)
const BASE_OFF: u32 = 15680;     // 库根前缀 (deps 目录 / store 根)
const DENT_OFF: u32 = 17728;     // 目录项缓冲
const SUBP_OFF: u32 = 18752;     // 子路径暂存
const EXT_OFF: u32 = 20224;      // 源后缀 (loment.conf)
const DIAG_OFF: u32 = 20480;     // --diag-out 路径
const DIAGFD_OFF: u32 = 24160;   // 这一次的 --diag-out fd **加一** (0 = 没给)
const ADDIN_OFF: u32 = 21504;    // addin 清单起点
const CMD_OFF: u32 = 23904;      // 命令名 (`--print-command`)
const DIAG_CAP: u32 = 1024;      // 路径上限
const EXT_CAP: u32 = 256;        // 源后缀上限
const DIR_CAP: u32 = 1024;       // 项目根 / 工具目录 / 版本名 各自的上限
const DENT_CAP: u32 = 1024;      // 目录项缓冲上限 (PE 垫片一次只回一条记录)
const SUBP_CAP: u32 = 1472;      // 子路径上限
const TOKS_CAP: u32 = 5244160;   // (SLOT + 64) * 20 = 单文件词法缓冲

use lexer
use codegen
use checker
use comefor
// `--emit-potato`(`docs/189` S1): 形式对象是**另一条出口**, 与 IR 平行 —— 它**不经过**
// codegen (参考实现的 `emit_potato` 也不经过 IR 后端), 所以聚合类型那种"后端编不了"的
// 单元照样发得出对象。
use potato

/// 退出; 返回值只为类型完整 (syscall 之后不会回来)。
fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

/// 向内核抬 program break 拿 n 字节; 返回块首 (0 = 失败)。
fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

/// 从 fd 读到 EOF 或读满; 返回实际字节数。
fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let n: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if n <= 0 {
            return off;
        }
        off = off + (n as u64);
    }
    return off;
}

/// write 可以短写, 循环写干净。
fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

/// 面向用户的失败消息: `loment: <msg>` 换行。**前缀与换行在这儿写死**, 50 个用点各写
/// 一遍迟早写错 —— 其中一处写错了 `write_all(2, str_ptr("fujoc-s: 打不开 "), 20)`:
/// 那句话是 19 字节, 手数的 20 把字符串常量的 NUL 一起写了出去, 用户拿到的是
/// `打不开 \0路径` (issue #8)。
///
/// 前缀是 **`loment`**(用户敲的那个命令), 不是 `fujoc-s`(自举驱动的旧内部名)。
fn fail(msg: str) -> u32 {
    wstr(2, "loment: ");
    wstr(2, msg);
    wstr(2, "\n");
    return die(1);
}

/// 同 `fail`, 消息后面还要接一段**不是字符串字面量**的字节 (路径 / 名字)。
///
/// 长度必须由调用方给, 所以这里没有"顺手用 str_len"的余地 —— 但 `tail` 是
/// **已经量好的切片**, 不是字符串常量, 写出去的就是它自己, 不带任何尾巴。
fn failp(msg: str, tail: ptr, n: u32) -> u32 {
    wstr(2, "loment: ");
    wstr(2, msg);
    write_all(2, tail, n as u64);
    wstr(2, "\n");
    return die(1);
}

/// 词法流里有没有**外部代码块**的痕迹（`docs/185` S1 的临时守卫，镜像落地时删掉）。
///
/// 认两样：一个 kind = 5 的 **raw token**（块正文），或者一个顶层的 `command` / `foruse`
/// （语言名声明）。两样任一出现就说明这份源要 S1 的能力，而自举侧**还没实现**它。
///
/// **为什么必须在这里拒绝**：放它过去的话，`command`/`foruse` 与 raw 会被当成普通标识符
/// 扫过去，报出来的是"E2 未定义符号 `py`"之类**指不到点子上**的错 —— 真正的理由是
/// "这门语言还没学会收外部块"。**错要指在错的地方**。
fn has_extblock(src: ptr, t: ptr, nt: u32) -> u32 {
    let i: u32 = 0;
    let d: u32 = 0;
    while i < nt {
        let k: u32 = load32(t, i * 20);
        if k == 5 {
            return 1;                       // raw token = 块正文，一定是它
        }
        if k == 3 {
            let c: u32 = load8(src, load32(t, i * 20 + 4)) as u32;
            if c == 123 || c == 40 || c == 91 { d = d + 1; }
            if (c == 125 || c == 41 || c == 93) && d > 0 { d = d - 1; }
        }
        if d == 0 && k == 0
                && (tok_is(src, t, i, "command") || tok_is(src, t, i, "foruse")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// `comefor` 展开失败了 —— 报出来并退出。
///
/// **码是数、话在这儿** —— 展开器只管报哪一类，说法归 driver（与 `switch_rules` 报
/// E022 同一个分工）。
///
/// `re == 7`（宏体没跑成）**单独一支**：那一支要带上**解释器的种类名**
/// （`divzero` / `oom` / …），而 `fail` 只收一个现成的 `str`，拼不出来 —— 所以直接往
/// stderr 写三段。种类名走 `cf_err_name`（`comefor` 转出来的 `interp` 那份表），
/// **不另抄一份**：那张表正是"两边连错误的种类都要一致"的凭据。
fn comefor_fail(re: u32, code: u32) -> u32 {
    if re == 7 {
        let _a: u64 = wstr(2, "loment: the comefor macro body did not run: ");
        let _b: u64 = wstr(2, cf_err_name(code));
        let _c: u64 = wstr(2, "\n");
        return die(1);
    }
    if re == 2 { return fail("comefor must be written at the top level"); }
    if re == 3 { return fail("comefor's body is not closed (missing a `}`)"); }
    if re == 4 { return fail("too many comefor dialects (limit is 64)"); }
    if re == 5 { return fail("byuse must be written at the top level (same level as comefor)"); }
    if re == 6 { return fail("byuse names a dialect that nothing is using"); }
    if re == 9 { return fail("comefor's macro body is too large (limit is 300 tokens)"); }
    if re == 10 {
        return fail("comefor's body does not take `use` yet -- write the helper fn inside the body");
    }
    return fail("comefor consumed more tokens than were left");
}

/// 写一个 str 到 fd (长度交给 str_len —— 手数字节数会连字符串常量的 NUL 一起写出去)。
fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

/// 一个字节的低 8 位按**小写十六进制两位**写出去 (`\u00XX` 要用)。
fn whex2(fd: u64, v: u32) -> u64 {
    let hi: u32 = (v / 16) % 16;
    let lo: u32 = v % 16;
    let bh: u8 = 48 as u8;
    if hi > 9 {
        bh = (87 + hi) as u8;           // 10 -> 'a'
    } else {
        bh = (48 + hi) as u8;
    }
    let bl: u8 = 48 as u8;
    if lo > 9 {
        bl = (87 + lo) as u8;
    } else {
        bl = (48 + lo) as u8;
    }
    let t: ptr = alloc(2);
    store8(t, 0, bh);
    store8(t, 1, bl);
    return write_all(fd, t, 2);
}

/// 把 `p[0..n]` 按**JSON 字符串**写出 (含两侧引号)。这是 `--diag-out` 那一路的核心:
/// 片段是**源码原文的字节**, 里面完全可能有 `"`、反斜杠或控制字节 —— 不转义写出来的
/// 就不是合法 JSON, 而下游 `lomenterr` 会整行解析失败 (docs/182 §5)。
///
/// 控制字节一律走 `\u00XX` 而**不是**替换成空格: 替换是**悄悄改内容**, 而这条链上
/// 唯一的底气就是"报出来的东西和源码里的一致"。
fn wjson_str(fd: u64, p: ptr, n: u32) -> u64 {
    let _q: u64 = wstr(fd, "\"");
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(p, i) as u32;
        if c == 34 {
            let _a: u64 = wstr(fd, "\\\"");
        } else if c == 92 {
            let _b: u64 = wstr(fd, "\\\\");
        } else if c < 32 {
            let _c: u64 = wstr(fd, "\\u00");
            let _d: u64 = whex2(fd, c);
        } else {
            let _e: u64 = write_all(fd, ptr_add(p, i), 1);
        }
        i = i + 1;
    }
    return wstr(fd, "\"");
}

/// 一条诊断 = 一行 JSON。字段集与参考实现一致 (`file/line/col/code/message`) ——
/// **不含 `title`/`hint`**: 那两样由报错器查 `surface_data` 补, 编译器只报"是什么、在哪"
/// (docs/182 §5.3)。两侧的 `message` 文本本来就不同 (参考是整句中文, 这里只有源码片段),
/// 那是 `docs/158` §4 记着的既有分叉, 判据比的是**码**。
fn wdiag(fd: u64, scr: ptr, file: ptr, fnam: u32,
         line: u32, code: u32, frag: ptr, fl: u32) -> u64 {
    let _a: u64 = wstr(fd, "{\"file\":");
    let _b: u64 = wjson_str(fd, file, fnam);
    let _c: u64 = wstr(fd, ",\"line\":");
    let _d: u64 = wdec(fd, scr, line);
    // 列: 驱动器手里只有 token 索引, 没有列 —— 与参考实现 check() 那条路一样给 0
    let _e: u64 = wstr(fd, ",\"col\":0,\"code\":\"E");
    // 码写成**三位**(`E022` 而不是 `E22`) —— 与参考实现一致。参考的码来自
    // `loment_diag.RULES`(唯一真源), 那里就是三位; CLI 显示成 `E22` 是**呈现层**的事。
    // 这条是判据**第一次跑就抓出来的**: 原先这里直接 wdec, 报
    // "自举 ['E22'] vs 参考 ['E022']" —— 同一件事两个实现给出不同的字符串。
    if code < 10 {
        let _p1: u64 = wstr(fd, "00");
    } else if code < 100 {
        let _p2: u64 = wstr(fd, "0");
    }
    let _f: u64 = wdec(fd, scr, code);
    let _g: u64 = wstr(fd, "\",\"message\":");
    let _h: u64 = wjson_str(fd, frag, fl);
    return wstr(fd, "}\n");
}

/// 这一次的 `--diag-out` fd（`scr` 里存的是 fd **加一**，0 = 没给，见 `DIAGFD_OFF`）。
///
/// **为什么要经内存传、不当参数**：用它的地方散在 `load_file` 的递归里，而 `dfd` 是
/// `main` 的局部量 —— 与 `snc` 那条同一个理由（Loment 没有 out 参数、没有可变全局，
/// 按值传会让递归的兄弟各拿一份）。装载器本来就一路带着 `scr`。
fn diagfd(scr: ptr) -> i64 {
    let v: u32 = load32(scr, DIAGFD_OFF);
    if v == 0 {
        return 0 as i64 - 1;
    }
    let w: i64 = v as i64;
    return w - 1;
}

/// 一条**没有源码位置**的失败：结构化那一份写进 `--diag-out`（`line` 0 = 没有位置，
/// 报错器据此不印 `:行号`）。
///
/// 给人看的那一行仍由 `fail` / `failp` 打 —— **两个都要**：包里走启动器时由报错器
/// 渲染，而直接跑 `loment-driver` 的人手上没有报错器，把话只留在 JSONL 里等于没报
/// （参考实现也是两边都写，见 `lomentc.main`）。
fn wdiag_at(fd: i64, scr: ptr, file: ptr, fnam: u32, line: u32, code: u32,
            msgp: ptr, msgn: u32) {
    if fd >= 0 {
        let _r: u64 = wdiag(fd as u64, scr, file, fnam, line, code, msgp, msgn);
    }
}

/// 同上，位置那一格给 0（= 没有位置）。**指不出位置就别编一个** —— `lomenterr` 的
/// `num_raw` 就是这个口径（`line`/`col` 为 0 = 没位置），而渲染器见 0 就不印 `:行号`。
fn wdiag_file(fd: i64, scr: ptr, file: ptr, fnam: u32, code: u32, msgp: ptr, msgn: u32) {
    wdiag_at(fd, scr, file, fnam, 0, code, msgp, msgn);
}

/// 会把运行期拖进产物的构造 → **人话**（issue #321）。照抄参考实现 `tools/lomentc.py`
/// 的 `_RUNTIME_SITES` —— 报文的正文要的是"除法 `/`"这一句，不是那一格 token 原文，而两边
/// 要逐字节一致。不是那八个之一就回空串（**判据**：那说明这一格的 token 不在名单里，
/// 报文才退回 token 原文；`E031` 这一档的正常输入永远命得中）。
fn rt_phrase(slot: ptr, toks: ptr, tk: u32) -> str {
    if tok_is(slot, toks, tk, "/") { return "除法 `/`"; }
    if tok_is(slot, toks, tk, "%") { return "取模 `%`"; }
    if tok_is(slot, toks, tk, "alloc") { return "`alloc`"; }
    if tok_is(slot, toks, tk, "free") { return "`free`"; }
    if tok_is(slot, toks, tk, "str_concat") { return "`str_concat`"; }
    if tok_is(slot, toks, tk, "str_eq") { return "`str_eq`"; }
    if tok_is(slot, toks, tk, "panic") { return "`panic`"; }
    if tok_is(slot, toks, tk, "guard") { return "`guard`（能力域守卫）"; }
    return "";
}

/// `E031`（默认档下用了会拖运行期的构造）的**结构化**诊断 —— 正文是**一句话**，不是
/// token（issue #321）。与参考实现 `check()` 里那条 f-string 逐字节同形：
/// `{line}: 声明了 …—— {name}（…）。`
/// +（`nsites > 1` 时）`这一类构造本单元另有 {nsites-1} 处。` + `要运行期就在根单元写 …`。
/// 分段直接写 fd（**不另开缓冲**：`scr` 那块排得很密，没有 200 字节的连续空位）。
fn wdiag_rt(fd: u64, scr: ptr, file: ptr, fnam: u32, line: u32, ph: str, nsites: u32) -> u64 {
    let _a: u64 = wstr(fd, "{\"file\":");
    let _b: u64 = wjson_str(fd, file, fnam);
    let _c: u64 = wstr(fd, ",\"line\":");
    let _d: u64 = wdec(fd, scr, line);
    let _e: u64 = wstr(fd, ",\"col\":0,\"code\":\"E031\",\"message\":\"");
    let _f: u64 = wdec(fd, scr, line);
    let _g: u64 = wstr(fd, ": 声明了 `no_runtime`，但它会让产物带上运行期 —— ");
    let _h: u64 = write_all(fd, str_ptr(ph), str_len(ph) as u64);
    let _i: u64 = wstr(fd, "（`no_runtime` 是**保证**：产物里不许出现那段运行期）。");
    if nsites > 1 {
        let _j: u64 = wstr(fd, "这一类构造本单元另有 ");
        let _k: u64 = wdec(fd, scr, nsites - 1);
        let _l: u64 = wstr(fd, " 处。");
    }
    return wstr(fd, "要运行期就在根单元写 `choose runtime`；不要就把这个构造换掉\"}\n");
}

/// u32 十进制写到 fd (诊断里要报错误码与行号; 驱动器里没有 printf)。
/// 数字缓冲借 scr 的 [8000, 8064) (布局见 SCR_CAP 上面的表)。
fn wdec(fd: u64, scr: ptr, v: u32) -> u64 {
    let t: ptr = ptr_add(scr, 8000);
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(t, 0, 48 as u8);
        d = 1;
    }
    while x > 0 {
        store8(t, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(t, 32 + q, load8(t, d - 1 - q) as u8);
        q = q + 1;
    }
    return write_all(fd, ptr_add(t, 32), d as u64);
}

/// 只读打开: 先把路径复制成 NUL 结尾 (内核要 C 串), 再 openat(AT_FDCWD, p, O_RDONLY)。
fn open_ro(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    return syscall4(257, (0 as u64) - 100, scr as u64, 0);
}

/// 写打开 (建/清空): `openat(AT_FDCWD, p, O_WRONLY|O_CREAT|O_TRUNC, 0644)`。
///
/// **必须带 mode, 所以只能走 `syscall6`** —— Linux 的 openat 是 4 参系统调用,
/// `open_ro` 用 `syscall4` 只递得到 rdx (flags); 带 O_CREAT 时 r10 里的 mode 递不过去,
/// 文件会被建成权限 0。
fn open_wo(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    // O_WRONLY(1) | O_CREAT(64) | O_TRUNC(512) = 577; mode 0644 = 420
    return syscall6(257, (0 as u64) - 100, scr as u64, 577, 420, 0);
}

/// 入口路径的种类, 只看 `st_mode`。
///
/// 返回: 1 = 目录, 2 = 普通文件, 0 = 不存在 / 打不开 / 其它类型。
/// `S_IFMT` = 61440, `S_IFDIR` = 16384, `S_IFREG` = 32768, 与 `lomcli.lomt` 同一对常数。
///
/// **不能问 `st_size`**: PE 垫片的 `newfstatat` 只填 `st_mode`, `st_size` 恒为 0
/// (lomcli 头注)。空不空要等 `load_file` 把字节数读出来再判。
///
/// stat 缓冲借 scr 的 use 清单区 (`USE_OFF`): 这一步在 `load_file` 之前, 那块还没被
/// 清单占用, `load_file` 自己会重写它。路径暂存仍是 scr 的前 4000 字节 (与 `open_ro` 同槽)。
/// flags 必须显式 0 —— `syscall4` 递不到 r10, 残留的 flags 会让 `newfstatat` 不跟随
/// 符号链接或直接失败, 所以走 `syscall6` (与 `open_wo` 同一个理由)。
fn entry_kind(p: ptr, n: u32, scr: ptr) -> u32 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    let stb: ptr = ptr_add(scr, USE_OFF);
    let r: i64 = syscall6(262, (0 as u64) - 100, scr as u64, stb as u64, 0, 0);
    if r < 0 {
        return 0;
    }
    let mode: u32 = load32(stb, 24) & 61440;
    if mode == 16384 {
        return 1;
    }
    if mode == 32768 {
        return 2;
    }
    return 0;
}

/// `p[0..n]` 与字面量 `s` 相等吗 (含长度)。
fn streq(p: ptr, n: u32, s: str) -> u32 {
    if n != str_len(s) {
        return 0;
    }
    let i: u32 = 0;
    let sp: ptr = str_ptr(s);
    while i < n {
        if (load8(p, i) as u32) != (load8(sp, i) as u32) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 从 /proc/self/cmdline 取第 `idx` 个参数: 返回 (start << 32) | len, 0 = 没有。
/// idx=0 是工具自己的路径 (用来推"工具目录"), idx=1 是入口文件。
fn argv_at(buf: ptr, cap: u64, scr: ptr, idx: u32) -> u64 {
    // 长度交给 str_len: 手数字符会连字符串常量的 NUL 一起复制进去 (openat 要的是 C 串)
    let fd: i64 = open_ro(str_ptr("/proc/self/cmdline"),
                          str_len("/proc/self/cmdline"), scr);
    if fd < 0 {
        return 0;
    }
    let n: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if n <= 0 {
        return 0;
    }
    let i: u64 = 0;
    let k: u32 = 0;
    while k < idx {
        while i < n as u64 && load8(buf, i as u32) != 0 {
            i = i + 1;
        }
        if i >= n as u64 {
            return 0;
        }
        i = i + 1;
        k = k + 1;
    }
    let s: u64 = i;
    while i < n as u64 && load8(buf, i as u32) != 0 {
        i = i + 1;
    }
    if i == s {
        return 0;
    }
    return (s << 32) | (i - s);
}

fn copy_bytes(dst: ptr, doff: u64, src: ptr, soff: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, (doff + i as u64) as u32, load8(src, soff + i) as u8);
        i = i + 1;
    }
}

/// 去重表: 每项 = len(u32) + 路径字节, 顺次排布。
/// 表长放在**一格内存**里 (snc), 因为它必须在兄弟递归之间共享: Loment 没有
/// out 参数也没有可变全局, 按值传会在"两个模块都 import 同一个依赖"时漏判
/// (checker 先装 bytes 再装 lexer, lexer 又 import bytes —— 按值传会把 bytes 装两遍)。
fn seen_has(seen: ptr, snc: ptr, p: ptr, n: u32) -> u32 {
    let sn: u32 = load32(snc, 0);
    let o: u32 = 0;
    while o < sn {
        let l: u32 = load32(seen, o);
        if l == n {
            let ok: u32 = 1;
            let i: u32 = 0;
            while i < n {
                if load8(seen, o + 4 + i) != load8(p, i) {
                    ok = 0;
                }
                i = i + 1;
            }
            if ok == 1 {
                return 1;
            }
        }
        o = o + 4 + l;
    }
    return 0;
}

fn seen_add(seen: ptr, snc: ptr, p: ptr, n: u32) {
    let sn: u32 = load32(snc, 0);
    store32(seen, sn, n);
    copy_bytes(seen, sn as u64 + 4, p, 0, n);
    store32(snc, 0, sn + 4 + n);
}

/// 文本模式读入: 去掉 CRLF 里的 CR。
/// 参考实现用 `read_text` (通用换行) 载入源码, 而驱动器读的是**原始字节** ——
/// 源码里有跨行的字符串字面量 (生成器里到处都是), CR 会原样进到字面量字节里,
/// 于是 IR 里的常量写成 `c"\0D\0A"` 而不是 `c"\0A"` (docs/150 记过一次同类事故)。
fn strip_cr(buf: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    while i < n {
        let c: u32 = load8(buf, i);
        if c == 13 && i + 1 < n && load8(buf, i + 1) == 10 {
            i = i + 1;   // 丢掉 CR, 保留 LF
        } else {
            store8(buf, o, c as u8);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

/// `choose write grammar <别名>` 那一行 —— **解析之前抹掉**（`docs/188` §1、§7.2）。
///
/// 与参考实现的 `potato_from.strip_grammar_decl` **同一件事**：声明说的是"**怎么读**"，
/// 不是那份源的一部分。不抹的话 `choose write grammar python` 会被读成"**取开关 `write`**"
/// —— `choose` 在本语言里已经是开关关键字 —— 报出来是一句指不到点子的话。
///
/// **在 `lex` 之前、在字节上抹**（不是 token 上）：于是 lexer / parser 一行都不动，
/// 语言面也就不必为它动任何规矩（**种子不必因为这一句而重生成**）。
///
/// **只收一种形状**：`module` 之前、只写一次、读法是**原生拼法**（`loment` / `rust`）。
/// 别的形状一律拒，理由与 `has_extblock` 是同一条纪律 —— **错要指在错的地方**：
///
/// * **别的写法**：自举侧还没有那些翻译器的 Loment 孪生（`docs/189` §4.1）。
///   放它过去报的是"未定义的开关 `write`"，而真正的理由是"这门写法还没接上"。
///   **`rust` 不在这一档** —— 它是基础语法的一种拼法，抹掉就走原生解析器，
///   与 `loment` 同一条路（`potato_from.NATIVE_GRAMMARS`）。
/// * **写在 `module` 之后 / 写两次**：参考实现这两种都**拒**（`docs/188` §1）——
///   这里也拒，于是**接受面一致**（话术不同而已）。
fn blank_skip(buf: ptr, p: u32, e: u32) -> u32 {
    let i: u32 = p;
    while i < e && (load8(buf, i) == 32 || load8(buf, i) == 9) {
        i = i + 1;
    }
    return i;
}

/// 从 `p` 起跳空白、吃一个词；词正好是 `w` 就返回**词尾**，否则 0。
/// 词的边界 = 空白 / `;` / 行尾 —— **与参考实现 `_GRAMMAR_TAIL` 的那个字符类同一个**
/// （对拍过：`grammar#python` 两边都说"没有声明"，`grammar;` 两边都说"头成立、别名没写"）。
fn word_skip(buf: ptr, p: u32, e: u32, w: str) -> u32 {
    let a: u32 = blank_skip(buf, p, e);
    let b: u32 = a;
    while b < e && load8(buf, b) != 32 && load8(buf, b) != 9 && load8(buf, b) != 59 {
        b = b + 1;
    }
    if b == a {
        return 0;
    }
    if streq(ptr_add(buf, a), b - a, w) == 0 {
        return 0;
    }
    return b;
}

/// `choose write grammar <别名>` 那一行 → **别名起点**（头不成立返回 0）。
/// 别名 = 跳空白之后的那一串（到空白 / `;` / 行尾为止）。
fn decl_alias(buf: ptr, s: u32, e: u32) -> u32 {
    let p: u32 = word_skip(buf, s, e, "choose");
    if p == 0 {
        return 0;
    }
    p = word_skip(buf, p, e, "write");
    if p == 0 {
        return 0;
    }
    p = word_skip(buf, p, e, "grammar");
    if p == 0 {
        return 0;
    }
    return blank_skip(buf, p, e);
}

fn strip_grammar_decl(buf: ptr, n: u32, scr: ptr, file: ptr, fnam: u32) -> u32 {
    let saw_module: u32 = 0;
    let seen: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let e: u32 = i;
        while e < n && load8(buf, e) != 10 {
            e = e + 1;
        }
        if word_skip(buf, i, e, "module") != 0 {
            saw_module = 1;
        }
        let al: u32 = decl_alias(buf, i, e);
        if al != 0 {
            let ae: u32 = al;
            while ae < e && load8(buf, ae) != 32 && load8(buf, ae) != 9
                    && load8(buf, ae) != 59 {
                ae = ae + 1;
            }
            // **原生拼法有两个**（`potato_from.NATIVE_GRAMMARS`）：`loment` 与 `rust`。
            // `rust` 在这里**不需要别的东西配** —— 它就是基础语法的一种拼法（用户
            // 2026-09-22 的裁定），所以自举侧收它的**理由与收 `loment` 是同一条**：
            // 抹掉那一行之后交给原生的 lexer/parser，**没有翻译器参与**。
            // （别的拼法仍要等翻译器的 Loment 孪生，docs/189 §4.1。）
            let nat: u32 = streq(ptr_add(buf, al), ae - al, "loment")
                          + streq(ptr_add(buf, al), ae - al, "rust");
            if saw_module == 0 && seen == 0 && nat != 0 {
                // **抹成等长空白**（保留换行 ⇒ 行号不漂，报错仍指得到那一行）
                let z: u32 = i;
                while z < e {
                    if load8(buf, z) != 10 {
                        store8(buf, z, 32 as u8);
                    }
                    z = z + 1;
                }
                seen = 1;
            } else {
                let dm: str = "this source's `choose write grammar` is one the self-hosted compiler does not take -- it takes `choose write grammar loment` (or `rust`) only, written before `module` and once. Other spellings wait on the translator having a Loment twin. Run `loment skill --print` for the grammar rules, or compile this file with a toolchain that has the translator.";
                wdiag_file(diagfd(scr), scr, file, fnam, 23, str_ptr(dm), str_len(dm));
                return fail(dm);
            }
        }
        i = e + 1;
    }
    return n;
}

/// `use <名字>` 的搜索根 (与参考实现的 `lomentc.NAME_ROOTS` **必须逐条一致**)。
fn name_root_at(r: u32) -> str {
    if r == 0 {
        return "loment/lib";
    }
    if r == 1 {
        return "loment/examples";
    }
    if r == 2 {
        return "loment/selfhost";
    }
    return "loment/tools";
}

/// NUL 串长度。
fn cstr_len(p: ptr) -> u32 {
    let i: u32 = 0;
    while load8(p, i) != 0 && i < 4096 {
        i = i + 1;
    }
    return i;
}

/// dst[off...] += src[0..n]; 返回新偏移 (用来拼候选路径)。
fn cat(dst: ptr, off: u32, src: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(dst, off + i, load8(src, i) as u8);
        i = i + 1;
    }
    return off + n;
}

/// 同上, 源是字符串字面量。
fn catl(dst: ptr, off: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, off + i, str_byte(s, i) as u8);
        i = i + 1;
    }
    return off + n;
}

/// 路径的目录部分 (最后一个分隔符之前) 写进 dst (NUL), 返回长度。
/// 没有分隔符就是空串 —— 等价于参考实现里 `Path("hi.lomt").parent` 给的 "."。
///
/// **两种分隔符都认 (47 '/' 与 92 '\')**: PE 垫片的 `/proc/self/cmdline` 原样带着调用方
/// 写的分隔符, 而 Windows 上那通常是反斜杠 —— 只认 '/' 会把 argv[0] 的目录算成空串,
/// "自带 store" 那一层于是永远指向 <当前目录>/../share/... (踩过)。
fn dir_of(path: ptr, n: u32, dst: ptr, cap: u32) -> u32 {
    let last: u32 = 4294967295;
    let i: u32 = 0;
    while i < n {
        if load8(path, i) == 47 || load8(path, i) == 92 {
            last = i;
        }
        i = i + 1;
    }
    let d: u32 = 0;
    if last != 4294967295 {
        while d < last && d < cap - 1 {
            store8(dst, d, load8(path, d) as u8);
            d = d + 1;
        }
    }
    store8(dst, d, 0 as u8);
    return d;
}

/// 列出 `<dirp>` 的**子目录**。返回值: 1 = 恰好一个 (名字 NUL 结尾写进 dst); 0 = 打不开
/// 或没有子目录; ≥2 = 有多个 (dst 里留的是第一个, 调用方只拿它报数)。
///
/// "是不是目录"**用 openat(O_DIRECTORY) 试**, 不看 d_type —— PE 垫片的 d_type 从没被
/// 验证过 (lpi_test 里那几条 dir 自检只喂内存里的合成记录, lompi 的 scan_dir 也从不看它),
/// 而"打开目录"这条路是验过的 (lompi index 在 PE 上能用)。踩过: 按 d_type==4 判, 在 PE 上
/// 一个目录都数不出来, `use std` 于是永远找不到自带的库。
/// **PE 垫片每次只返回一条记录** (Linux 一次一批), 所以循环按"读一批走一批"写。
fn subdirs_of(dirp: ptr, dl: u32, dst: ptr, scr: ptr) -> u32 {
    let dent: ptr = ptr_add(scr, DENT_OFF);
    // **目录路径比槽大 ⇒ 说出来**（`#345` 的 (a)）。原来这条循环只是**停**：截断过的路径
    // 会去 `openat` 一个不存在的目录，用户看到的是"这个 `use` 找不到"（`docs/188` 的
    // "宁拒勿猜"：宁可报错，也不要让一个截断过的输入伪装成一个查无此物）。
    if dl >= DIR_CAP - 1 {
        return fail("a directory path is longer than 1024 bytes (the project root / tool dir / version-name limit) -- move the project closer to the filesystem root");
    }
    let i: u32 = 0;
    while i < dl && i < DIR_CAP - 1 {
        store8(scr, i, load8(dirp, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, scr as u64, 65536);
    if fd < 0 {
        return 0;
    }
    let n: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        let rn: i64 = syscall4(217, fd as u64, dent as u64, DENT_CAP as u64);
        if rn <= 0 {
            go = 0;
        } else {
            let m: u32 = rn as u32;
            let e: u32 = 0;
            while e < m {
                let rl: u32 = load16(dent, e + 16);
                if rl == 0 {
                    e = m;
                } else {
                    let nm: u32 = e + 19;
                    if load8(dent, nm) != 46 && is_dir_at(dirp, dl, dent, nm, scr) == 1 {
                        if n == 0 {
                            let j: u32 = 0;
                            while j < 200 && load8(dent, nm + j) != 0 {
                                store8(dst, j, load8(dent, nm + j) as u8);
                                j = j + 1;
                            }
                            store8(dst, j, 0 as u8);
                        }
                        n = n + 1;
                    }
                    e = e + rl;
                }
            }
        }
    }
    syscall4(3, fd as u64, 0, 0);
    return n;
}

/// `<dirp>` 的**第 idx 个**子目录, 名字 NUL 结尾写进 dst, 返回长度; 0 = 没有第 idx 个。
///
/// 与 `subdirs_of` 同一条"是不是目录"判据 (openat(O_DIRECTORY) 试, 不看 d_type, 见那边
/// 的注解), 差别只在"要第几个" —— 包内模块那一层要**遍历**包目录, 而 `subdirs_of` 只交出
/// 第一个名字。每次调用重开一次目录: 包与版本各只有个位数, 简单比快重要 (Loment 没有迭代器)。
/// 找到就**立刻关 fd 返回**, 不为了数总数扫到底 —— 调用方是靠"第 idx 个是 0 长度"停的。
fn subdir_at(dirp: ptr, dl: u32, idx: u32, dst: ptr, cap: u32, scr: ptr) -> u32 {
    let i: u32 = 0;
    while i < dl && i < DIR_CAP - 1 {
        store8(scr, i, load8(dirp, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, scr as u64, 65536);
    if fd < 0 {
        return 0;
    }
    let dent: ptr = ptr_add(scr, DENT_OFF);
    let n: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        let rn: i64 = syscall4(217, fd as u64, dent as u64, DENT_CAP as u64);
        if rn <= 0 {
            go = 0;
        } else {
            let m: u32 = rn as u32;
            let e: u32 = 0;
            while e < m {
                let rl: u32 = load16(dent, e + 16);
                if rl == 0 {
                    e = m;
                } else {
                    let nm: u32 = e + 19;
                    if load8(dent, nm) != 46 && is_dir_at(dirp, dl, dent, nm, scr) == 1 {
                        if n == idx {
                            let j: u32 = 0;
                            while j < 200 && j < cap - 1 && load8(dent, nm + j) != 0 {
                                store8(dst, j, load8(dent, nm + j) as u8);
                                j = j + 1;
                            }
                            store8(dst, j, 0 as u8);
                            syscall4(3, fd as u64, 0, 0);
                            return j;
                        }
                        n = n + 1;
                    }
                    e = e + rl;
                }
            }
        }
    }
    syscall4(3, fd as u64, 0, 0);
    return 0;
}

/// `<dir>/<名字>` 是个目录吗 —— 拼进子路径暂存, 再 openat(O_DIRECTORY) 试一下。
/// 名字从目录项缓冲里现取 (`dent + nm`, NUL 结尾), 所以不用先拷出来。
fn is_dir_at(dirp: ptr, dl: u32, dent: ptr, nm: u32, scr: ptr) -> u32 {
    let w: ptr = ptr_add(scr, SUBP_OFF);
    let d: u32 = cat(w, 0, dirp, dl);
    let d2: u32 = catl(w, d, "/");
    let j: u32 = 0;
    let e: u32 = d2;
    while j < 200 && e < SUBP_CAP - 1 && load8(dent, nm + j) != 0 {
        store8(w, e, load8(dent, nm + j) as u8);
        e = e + 1;
        j = j + 1;
    }
    // 循环是三个条件里哪一个停的？**`e` 撞上沿**就是路径被截断 —— 那时下面这次 `openat`
    // 找的是一个不存在的路径，而调用方只知道"这个名字不是目录"（`#345` 的 (a)）。
    if e >= SUBP_CAP - 1 && load8(dent, nm + j) != 0 {
        return fail("a subpath is longer than 1472 bytes (one slot per source level) -- shorten the path");
    }
    store8(w, e, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, w as u64, 65536);
    if fd < 0 {
        return 0;
    }
    syscall4(3, fd as u64, 0, 0);
    return 1;
}

/// `<名字>` 是否在 `<根>/deps/<名字>/<名字>.lomt` —— 项目本地的依赖 (lompi 落点)。
/// 命中写进 tmp 并返回长度; 0 = 没这个目录。
fn try_deps(root: ptr, rn: u32, src: ptr, off: u32, len: u32, tmp: ptr, scr: ptr) -> u32 {
    let d: u32 = 0;
    if rn > 0 {
        d = cat(tmp, d, root, rn);
        d = catl(tmp, d, "/");
    }
    d = catl(tmp, d, "deps/");
    d = cat(tmp, d, ptr_add(src, off), len);
    d = catl(tmp, d, "/");
    d = cat(tmp, d, ptr_add(src, off), len);
    return open_two(d, tmp, scr);
}

/// 库根前缀 (store 根 / 项目 deps 目录), 写进 dst 返回长度:
///   `dev == 1` -> `lompi/store`                    **开发 checkout**: store 就在仓里
///   `dev == 0` -> `<工具目录>/../share/lompi/store`  装出来的前缀 (发布包的形状)
///
/// 与参考实现的 `lomentc.store_roots` 是同一对候选, **同一顺序**。仓里的 store 不摆
/// `share/` 那一层 —— 那一层是打包时拷出来的; 没有前一条, 在本仓写 `use vec` 一律
/// "找不到或有歧义"。
fn store_base(td: ptr, tn: u32, dev: u32, dst: ptr) -> u32 {
    if dev == 1 {
        return catl(dst, 0, "lompi/store");
    }
    let d: u32 = 0;
    if tn > 0 {
        d = cat(dst, d, td, tn);
    }
    return catl(dst, d, "/../share/lompi/store");
}

/// `<名字>` 是否在**工具链自带的库**里: `<store 根>/<名字>/<版本>/<名字>.lomt`。
/// 版本那一层**只允许一个** (与参考实现同规则: 编译器不做版本选择); 多个就报错退出。
/// 命中写进 tmp 并返回长度; 0 = 没这个包。
fn try_store(td: ptr, tn: u32, dev: u32, src: ptr, off: u32, len: u32, tmp: ptr, scr: ptr) -> u32 {
    let d: u32 = store_base(td, tn, dev, tmp);
    d = catl(tmp, d, "/");
    d = cat(tmp, d, ptr_add(src, off), len);
    store8(tmp, d, 0 as u8);
    let verd: ptr = ptr_add(scr, VER_OFF);
    let nv: u32 = subdirs_of(tmp, d, verd, scr);
    if nv == 0 {
        return 0;
    }
    if nv > 1 {
        let _m1: u64 = wstr(2, "loment: the bundled store has more than one version of ");
        write_all(2, ptr_add(src, off), len as u64);
        let _m2: u64 = wstr(2, " -- this compiler does not pick a version; pin one under deps/\n");
        die(1);
    }
    d = cat(tmp, d, str_ptr("/"), 1);
    d = cat(tmp, d, verd, cstr_len(verd));
    d = cat(tmp, d, str_ptr("/"), 1);
    d = cat(tmp, d, ptr_add(src, off), len);
    return open_two(d, tmp, scr);
}

/// `<名字>.lomt` 是不是**某个包里的模块** —— 遍历库根下每一个包各试一次。
///
/// 为什么要有这一层 (2026-09-20): 包是一个目录, 里面除了与包同名的那个入口还有别的模块
/// (`std/vec.lomt`、`host/fs.lomt`)。只认入口的话, 整包只能被"全拖进同一个单元"那一种
/// 方式消费 —— 而单元的发射符号是**平的**, 模块一多就撞名 (`std` 实测 11 处 E13), 代价
/// 也按模块数超线性涨 (实测 n=64 已 187 秒)。按模块取是唯一实用的路。
///
///   `versioned == 1`: `<base>/<包>/<版本>/<名字>`   (store 的形状)
///   `versioned == 0`: `<base>/<包>/<名字>`          (项目 deps 的形状)
///
/// 多版本包**跳过** —— 那是包入口那一层报的事, 这里再报一次等于同一件事说两遍。
/// 命中写进 dst 返回长度; 0 = 一个包都没有; **多个包都有 -> 返回 0** (由调用方报
/// "找不到或有歧义")。与参考实现同规矩: "先搜到哪个"不能变成隐藏语义。
fn try_pkg_module(base: ptr, bl: u32, versioned: u32, src: ptr, off: u32, len: u32,
                  tmp: ptr, dst: ptr, scr: ptr) -> u32 {
    let pkgn: ptr = ptr_add(scr, PKG_OFF);
    let hits: u32 = 0;
    let hit: u32 = 0;
    let i: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        let nl: u32 = subdir_at(base, bl, i, pkgn, 200, scr);
        if nl == 0 {
            go = 0;
        } else {
            let d: u32 = 0;
            d = cat(tmp, d, base, bl);
            d = catl(tmp, d, "/");
            d = cat(tmp, d, pkgn, nl);
            let ok: u32 = 0;
            if versioned == 1 {
                let verd: ptr = ptr_add(scr, VER_OFF);
                let nv: u32 = subdirs_of(tmp, d, verd, scr);
                if nv == 1 {
                    d = catl(tmp, d, "/");
                    d = cat(tmp, d, verd, cstr_len(verd));
                    ok = 1;
                }
            } else {
                ok = 1;
            }
            if ok == 1 {
                d = catl(tmp, d, "/");
                d = cat(tmp, d, ptr_add(src, off), len);
                let rl: u32 = open_two(d, tmp, scr);
                if rl > 0 {
                    if hits == 0 {
                        hit = cat(dst, 0, tmp, rl);
                    }
                    hits = hits + 1;
                }
            }
            i = i + 1;
        }
    }
    if hits > 1 {
        // 与参考实现同规矩: "先搜到哪个"不能变成隐藏语义。这里**硬失败**而不是
        // 返回 0 往下落 —— 往下落的话可能被内置四根里同名的一份接住, 那就成了
        // 静默用错模块 (比报错难查得多)。
        let _m1: u64 = wstr(2, "loment: the name import is ambiguous: ");
        write_all(2, ptr_add(src, off), len as u64);
        let _m2: u64 = wstr(2, " -- more than one package holds this module, and the compiler does not guess which (rename it, or drop the extra copy)\n");
        die(1);
    }
    if hits == 0 {
        return 0;
    }
    return hit;
}

/// `pre` 是不是 `p` 的前缀。
fn bprefix(p: ptr, n: u32, pre: ptr, pl: u32) -> u32 {
    if pl > n {
        return 0;
    }
    let i: u32 = 0;
    while i < pl {
        if load8(p, i) != load8(pre, i) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 这个文件**是不是住在商店的包里** —— 见 `lomentc._in_store_root` 与 `resolve_use_name`
/// 的 §归属。两条候选前缀就是 `store_base` 拼出来的那两个, 所以与解析出来的路径同前缀。
fn in_store_path(cpath: ptr, cn: u32, td: ptr, tn: u32, scr: ptr) -> u32 {
    let base: ptr = ptr_add(scr, BASE_OFF);
    let bl: u32 = store_base(td, tn, 0, base);
    if bprefix(cpath, cn, base, bl) == 1 {
        return 1;
    }
    let bl2: u32 = store_base(td, tn, 1, base);
    return bprefix(cpath, cn, base, bl2);
}

/// 商店那两层, 一个商店根: 先包入口, 再包内模块。命中写进 dst 返回长度。
fn try_store_layers(td: ptr, tn: u32, dev: u32, src: ptr, off: u32, len: u32,
                    tmp: ptr, dst: ptr, scr: ptr) -> u32 {
    let r: u32 = try_store(td, tn, dev, src, off, len, tmp, scr);
    if r > 0 {
        return cat(dst, 0, tmp, r);
    }
    let base: ptr = ptr_add(scr, BASE_OFF);
    let bl: u32 = store_base(td, tn, dev, base);
    return try_pkg_module(base, bl, 1, src, off, len, tmp, dst, scr);
}

/// `use <名字>` -> 真实路径, 写进 dst, 返回长度 (0 = 找不到或有歧义)。
/// **按层搜, 先命中先用** (与 `lomentc.resolve_name` 同规则):
///   1.  `<项目根>/deps/<名字>/<名字>.lomt`   项目本地 (包入口)
///   1b. `<项目根>/deps/<包>/<名字>.lomt`     **项目本地的包内模块**
///   2.  内置四根 `<根>/<名字>.lomt` —— **这一层命中必须唯一**
///   3.  `<store>/<名字>/<版本>/<名字>.lomt`  随包自带 (包入口)
///   3b. `<store>/<包>/<版本>/<名字>.lomt`    **随包自带的包内模块**
///
/// **商店那两层排在四根之后 (2026-09-20)**: 四根是**编译器自己的源码**
/// (`loment/selfhost/interp.lomt` 就在其中), 而商店里的包是**随包发行的库** —— 包的内部
/// 模块是包的私有名字空间, 让它盖住编译器自己的模块是灾难 (加这一层时真撞上了:
/// `store/std/0.1.0/interp.lomt` 把 `loment/selfhost/interp.lomt` 顶掉, 驱动直接编不过)。
/// 项目本地的 `deps/` 不在此列 —— 那是使用者**显式装的**, 理应先于工具链自带的任何东西。
///
/// §归属 (2026-09-20): **第 2 层与第 3 层谁在前面, 看导入方自己住在哪边。** 这不是设计
/// 出来的, 是加包内模块那一层时撞出来的 —— 两个方向都撞得上真东西:
///   * 商店放前面 -> `loment/selfhost/comefor.lomt` 的 `use interp` 拿到 std 那份,
///     而那份没有 `CT_HEAP_BYTES`, 驱动直接编不过;
///   * 四根放前面 -> `store/host/0.1.0/stat.lomt` 的 `use mem` 拿到 `loment/lib/mem.lomt`,
///     而那份没有 `mem_load64`, host 包编不过。
/// 所以规矩是"**在谁的库里, 先用谁的名字**"(`ins` = 导入方住在商店里)。用户项目走的是
/// "先四根"那条 —— 与加这一层之前**完全一致**, 这一层没有改动任何既有的解析结果。
///
/// `store` 有两个候选, 按序先命中先用 (见 `store_base`): 装出来的前缀 `share/lompi/store`,
/// 再开发 checkout 的 `lompi/store`。
/// 只解析 `.lomt` —— 名字形式是 L1 模块用的, L0 布局走路径形式。
fn resolve_use_name(src: ptr, off: u32, len: u32, dst: ptr, scr: ptr, ins: u32) -> u32 {
    // 候选写进 tmp, **不能写 dst**: 为了判歧义要试完 4 个根, 而后面那些试写会把
    // 已经命中的那个覆盖掉 (踩过: examples 命中 29 字节, 又被 tools 的 26 字节盖住,
    // 于是 load_file 拿到 "loment/tools/mathutil.lomt" + 上一轮残尾 "omt")。
    let tmp: ptr = ptr_add(scr, NAMTMP_OFF);
    let proj: ptr = ptr_add(scr, PROJ_OFF);
    let pn: u32 = cstr_len(proj);
    let td: ptr = ptr_add(scr, TOOLDIR_OFF);
    let tn: u32 = cstr_len(td);
    // 库根前缀 (deps 目录 / store 根) 写进一段**不与 tmp 重叠**的暂存: try_pkg_module
    // 一边读 base 一边往 tmp 里拼候选路径, 两者不能是同一块。
    let base: ptr = ptr_add(scr, BASE_OFF);
    // 项目本地两层: 路径命中即返回, 不需要判唯一 (参考实现也是"先命中先用")。
    let r1: u32 = try_deps(proj, pn, src, off, len, tmp, scr);
    if r1 > 0 {
        return cat(dst, 0, tmp, r1);
    }
    let bl1: u32 = 0;
    if pn > 0 {
        bl1 = cat(base, 0, proj, pn);
    }
    bl1 = catl(base, bl1, "/deps");
    let r1b: u32 = try_pkg_module(base, bl1, 0, src, off, len, tmp, dst, scr);
    if r1b > 0 {
        return r1b;
    }
    // 导入方住在商店里: 商店两层提到四根前面 (§归属)。
    if ins == 1 {
        let s0: u32 = try_store_layers(td, tn, 0, src, off, len, tmp, dst, scr);
        if s0 > 0 {
            return s0;
        }
        let s1: u32 = try_store_layers(td, tn, 1, src, off, len, tmp, dst, scr);
        if s1 > 0 {
            return s1;
        }
    }
    // 内置四根: 这一层要**数命中数**才敢返回 (唯一才算命中)。
    let hits: u32 = 0;
    let hit_len: u32 = 0;
    let r: u32 = 0;
    while r < 4 {
        let rp: str = name_root_at(r);
        let d: u32 = 0;
        let j: u32 = 0;
        while j < str_len(rp) {
            store8(tmp, d, str_byte(rp, j) as u8);
            d = d + 1;
            j = j + 1;
        }
        store8(tmp, d, 47 as u8);   // '/'
        d = d + 1;
        j = 0;
        while j < len {
            store8(tmp, d, load8(src, off + j) as u8);
            d = d + 1;
            j = j + 1;
        }
        let rl: u32 = open_two(d, tmp, scr);
        if rl > 0 {
            if hits == 0 {
                let q: u32 = 0;
                while q < rl {
                    store8(dst, q, load8(tmp, q) as u8);
                    q = q + 1;
                }
                hit_len = rl;
            }
            hits = hits + 1;
        }
        r = r + 1;
    }
    if hits > 1 {
        return 0;      // 四根里重名: 交给调用方报"找不到或有歧义", **不许**落到商店去
    }
    if hits == 1 {
        return hit_len;
    }
    // 默认 (导入方不在商店里): 商店两层垫在四根后面。
    if ins != 1 {
        let s0: u32 = try_store_layers(td, tn, 0, src, off, len, tmp, dst, scr);
        if s0 > 0 {
            return s0;
        }
        let s1: u32 = try_store_layers(td, tn, 1, src, off, len, tmp, dst, scr);
        if s1 > 0 {
            return s1;
        }
    }
    return 0;
}

/// 这个 `use` 的路径是不是 `.lomt`。
/// `lomentc` 的 parser 只把 `.lomt` 记进 `mod.imports`, `use "...lom"` 进 `mod.uses`
/// (L0 声明由 lomc 处理, 不参与 L1 单元装载) —— 驱动必须同规则, 否则会把 fujr.lom
/// 也拼进单元 (demo.lomt 上多出整整一个模块)。
/// 路径形式的一条 `use` 定路径: **先按原样 (相对 CWD), 再挂 `<本文件所在目录>/`** ——
/// 与参考实现同序 (先 root, 后被导入文件所在目录)。命中后者就写进 tmp 并返回长度;
/// 返回 0 = 按原样就行 (开得了), 或两处都开不了 (交给 load_file 报错)。
///
/// 没有这一步, `deps/std/std.lomt` 里的 `use "mem.lomt"` 会去找 `<CWD>/mem.lomt` ——
/// 一个不存在的路径 (2026-09-16 用户报的"use std 指向不存在的路径")。
fn fix_rel(slot: ptr, sp: u32, sl: u32, path: ptr, n: u32, scr: ptr) -> u32 {
    let fd0: i64 = open_ro(ptr_add(slot, sp), sl, scr);
    if fd0 >= 0 {
        syscall4(3, fd0 as u64, 0, 0);
        return 0;
    }
    let last: u32 = 4294967295;
    let i: u32 = 0;
    while i < n {
        if load8(path, i) == 47 || load8(path, i) == 92 {
            last = i;
        }
        i = i + 1;
    }
    if last == 4294967295 {
        return 0;              // 本文件就在当前目录 —— 兜底等于原样, 试过就不试了
    }
    let tmp: ptr = ptr_add(scr, NAMTMP_OFF);
    let d: u32 = cat(tmp, 0, path, last);
    d = catl(tmp, d, "/");
    d = cat(tmp, d, ptr_add(slot, sp), sl);
    store8(tmp, d, 0 as u8);
    let fd1: i64 = open_ro(tmp, d, scr);
    if fd1 < 0 {
        return 0;
    }
    syscall4(3, fd1 as u64, 0, 0);
    return d;
}

/// 在 `<tmp 里已拼好的 head><后缀>` 上试**两种**后缀: 先配置的那个 (scr+EXT_OFF),
/// 再默认 `.lomt`。命中就把完整路径留在 tmp (NUL 结尾) 并返回长度; 0 = 都没有。
///
/// 为什么要试两种: 项目可以把自己的源后缀配成 `.foo`, 而**工具链自带的模块仍然是 `.lomt`**
/// —— 名字形式既要找得到这个项目的库, 也要找得到自带的那些 (docs/143 的搜索层)。
fn open_two(head: u32, tmp: ptr, scr: ptr) -> u32 {
    let en: u32 = cstr_len(ptr_add(scr, EXT_OFF));
    if en > 0 {
        let d: u32 = cat(tmp, head, ptr_add(scr, EXT_OFF), en);
        store8(tmp, d, 0 as u8);
        let fd: i64 = open_ro(tmp, d, scr);
        if fd >= 0 {
            syscall4(3, fd as u64, 0, 0);
            return d;
        }
    }
    let d2: u32 = catl(tmp, head, ".lomt");
    store8(tmp, d2, 0 as u8);
    let fd2: i64 = open_ro(tmp, d2, scr);
    if fd2 < 0 {
        return 0;
    }
    syscall4(3, fd2 as u64, 0, 0);
    return d2;
}

/// 从 `<dirp>/loment.conf` 读源后缀, 写进 dst (**不带引号**), 返回长度; 0 = 没配/读不出。
///
/// 配置就是**一份 Loment 源码** (与 `lompi.conf` / `pkg.lomp` 同一种形状), 只认一个标签:
///
///     pub fn source_ext() -> str { return ".foo"; }
///
/// 取 `source_ext` 之后**第一个字符串字面量** —— 用词法器扫, 所以注释里出现的同名字符串
/// 不会误命中。`dirp` 长度 0 表示"当前目录"(项目自己放的那份优先)。读不出来就当没配。
///
/// 值必须以 `.` 开头, 否则也算没配: 写错一个字母就把名字形式指到一堆奇怪的文件上, 不如
/// 退回默认那个 —— 配置文件会被人改坏, "编得过但改错了后缀"比"编不过"难查得多。
fn cfg_source_ext(dirp: ptr, dl: u32, dst: ptr, scr: ptr, buf: ptr, toks: ptr) -> u32 {
    let d: u32 = 0;
    if dl > 0 {
        d = cat(scr, d, dirp, dl);
        d = catl(scr, d, "/");
    }
    d = catl(scr, d, "loment.conf");
    store8(scr, d, 0 as u8);
    let fd: i64 = syscall4(257, (0 as u64) - 100, scr as u64, 0);
    if fd < 0 {
        return 0;
    }
    let raw: u64 = read_all(fd as u64, buf, 65536);
    syscall4(3, fd as u64, 0, 0);
    if raw == 0 {
        return 0;
    }
    let n: u32 = lex(buf, raw as u32, toks);
    let found: u32 = 4294967295;
    let i: u32 = 0;
    while i < n && found == 4294967295 {
        if load32(toks, i * 20) == 0 && tok_is(buf, toks, i, "source_ext") == 1 {
            found = i;
        }
        i = i + 1;
    }
    if found == 4294967295 {
        return 0;
    }
    let s: u32 = 4294967295;
    let j: u32 = found + 1;
    while j < n && s == 4294967295 {
        if load32(toks, j * 20) == 2 {      // 2 = 字符串
            s = j;
        }
        j = j + 1;
    }
    if s == 4294967295 {
        return 0;
    }
    let st: u32 = load32(toks, s * 20 + 4);
    let sl: u32 = load32(toks, s * 20 + 8);   // 含两端的引号
    if sl < 3 {
        return 0;                             // 至少 `"."`
    }
    let q: u32 = 0;
    let bad: u32 = 0;
    while q < sl - 2 && q < EXT_CAP - 1 {
        let ch: u8 = load8(buf, st + 1 + q) as u8;
        if ch == 92 {
            bad = 1;                          // 带转义的也拒 (见下)
        }
        store8(dst, q, ch);
        q = q + 1;
    }
    // 同 `SUBP_CAP` 那条：`q` 撞上沿而字符串里还有字节 ⇒ 后缀被截断（`#345` 的 (a)）。
    // 静默截断的后果比"配错了"更难查：截出来的后缀**可能正好又叫中另一个词法档**。
    if q >= EXT_CAP - 1 && q < sl - 2 {
        return fail("the source extension in loment.conf is longer than 256 bytes");
    }
    store8(dst, q, 0 as u8);
    // 不以 `.` 开头、或带转义的, 一律当没配。转义那条是对着参考实现钉的: 这里拷的是**原始
    // 字节**(`\t` 两个字节), 参考实现的词法器给的却是**解码后**的值 —— 只在这一处会分叉,
    // 而文件名后缀里本来就不该有转义, 两边一起拒掉最省事。
    if q == 0 || load8(dst, 0) != 46 || bad == 1 {
        return 0;
    }
    return q;
}

fn is_lomt(src: ptr, sp: u32, sl: u32) -> u32 {
    // **L0 只有 `.lom` 一种后缀**, 别的任何后缀都算 L1 源 —— 后缀不是语言的一部分, 只是
    // 习惯 (用户 2026-09-16: "Loment 也可以作为其他文件名后缀的诞生地")。别把这条改回
    // "等于 .lomt 才算 L1": 那样 `use "x.foo"` 会被当成 L0 去找 .lom 而报"不存在"。
    if sl >= 4 {
        let e: u32 = sp + sl - 1;   // 结尾的引号
        if load8(src, e - 4) == 46 && load8(src, e - 3) == 108
                && load8(src, e - 2) == 111 && load8(src, e - 1) == 109 {
            return 0;               // ".lom"
        }
    }
    return 1;
}

/// 装载一个文件 (连同它的 `use`), 追加到 out 的第 off 字节起; 返回新的长度。
/// `addin <名字>` -> 真实路径。**先看项目根, 再走 `use` 那三层。**
///
/// 为什么必须多这一层: `resolve_use_name` 的三层是 `deps/<名字>/`、工具链 store、
/// 内置四根 —— **没有一层是"入口文件旁边"**。可 `chooseset.lomt` 恰恰就住在项目根
/// （`docs/182` §1.4）, 只走它会把 `addin chooseset` 判成**找不到**。
fn resolve_addin_name(src: ptr, off: u32, len: u32, dst: ptr, scr: ptr) -> u32 {
    let tmp: ptr = ptr_add(scr, NAMTMP_OFF);
    let d0: u32 = cat(tmp, 0, ptr_add(scr, PROJ_OFF), cstr_len(ptr_add(scr, PROJ_OFF)));
    let d1: u32 = catl(tmp, d0, "/");
    let d2: u32 = cat(tmp, d1, ptr_add(src, off), len);
    let r: u32 = open_two(d2, tmp, scr);
    if r > 0 {
        return cat(dst, 0, tmp, r);
    }
    return resolve_use_name(src, off, len, dst, scr, 0);
}

/// `addin` 拉进来的单元**只许写 choose 相关代码**（`docs/182` §1.4）。违规就**硬报错**。
///
/// 白名单（深度 0 的顶层）: `module <名字>` / `addin <名字>` / `set choose <名字> { … }` /
/// `choose <名字>` / `choose close <名字>`。注释词法器已经吃掉了, 不用管。
///
/// **为什么要有这条**: `addin` 拉的是**一份开关设定**, 不是库。它里面一旦能写
/// `fn`/`struct`/`use`, 就等于"用 `addin` 从另一个方向绕开库的纪律" —— `use` 那条路
/// 禁 `choose`, 这条路就得禁**其余的一切**。两个方向都堵上, "装代码"与"装开关"才真的
/// 是两件事。
fn check_chooseset(src: ptr, toks: ptr, nt: u32, path: ptr, n: u32, scr: ptr) {
    let d: u32 = 0;
    let i: u32 = 0;
    // eof 由循环条件挡掉 —— Loment 里 `return;`(不带值) 不成立。
    while i < nt && load32(toks, i * 20) != 4 {
        let k: u32 = load32(toks, i * 20);
        if k == 3 {
            let c: u32 = load8(src, load32(toks, i * 20 + 4)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
                i = i + 1;
            } else if c == 125 || c == 41 || c == 93 {
                if d > 0 { d = d - 1; }
                i = i + 1;
            } else if d > 0 {
                i = i + 1;
            } else {
                die_chooseset(path, n, scr);
            }
        } else if d > 0 {
            i = i + 1;
        } else if k == 0 && tok_is(src, toks, i, "module") {
            i = i + 2;
        } else if k == 0 && tok_is(src, toks, i, "addin") {
            i = i + 2;
        } else if k == 0 && tok_is(src, toks, i, "set") {
            i = i + 3;
        } else if k == 0 && tok_is(src, toks, i, "choose")
                && load32(toks, (i + 1) * 20) == 0 && tok_is(src, toks, i + 1, "close") {
            i = i + 3;
        } else if k == 0 && tok_is(src, toks, i, "choose") {
            // **核心模式不许**（`docs/175` §3.0 / `docs/143` §3.2）：addin 单元拉的是一份
            // **开关设定**，而核心模式声明的是**整个程序**的取值 —— 只有根单元能定。
            // 参考实现一直报这一条（"`addin` 单元不许声明核心模式"），而这里原先
            // **一律放行** —— 也就是说两边行为本来就不一样。加 `gc` 维之前它只影响
            // `std`/`no_std`（没人往 addin 单元里写），加完之后这一维**正是**会被写进去的
            // 东西，所以这一轮补上，不让分叉被放大。
            if sw_is_core(src, toks, i + 1) {
                // **报文里不逐个列核心模式的取值**：原先列的是
                // `(std / no_std / gc_manual / gc_auto —— …)`，加 `runtime` 那一维时
                // 它必然漏（而且不会有人注意到）。理由本身与维数无关，就只说理由。
                let dm: str = "a unit pulled in by `addin` must not declare a core mode (it declares the whole program's setting, and only the root unit may): ";
                wdiag_file(diagfd(scr), scr, path, n, 22, str_ptr(dm), str_len(dm));
                failp(dm, path, n);
                die(1);
            }
            i = i + 2;
        } else {
            die_chooseset(path, n, scr);
        }
    }
}

/// 把一个 token 的字节**抹成等长空白**（`load_file` 抹依赖写下的核心 `choose` 行用）。
///
/// 与 `choose write grammar` 那一行同一个手法：**长度不变**，所以行号、后面对得上的
/// 偏移全都不动。刻意不删字节 —— 删了就要重排整块，而整块的位置是这套驱动的内存布局。
/// **不调 `tok_start`/`tok_len`**：那两个住在 `parser.lomt`，而驱动不 `use parser`
/// （它读 token 一律走裸 `load32(toks, i * 20 + …)`，与下面那些一样）。token 记录是
/// 20 字节：kind +0 / start +4 / len +8 / line +12 / col +16。
fn blank_tok(src: ptr, toks: ptr, i: u32) {
    let st: u32 = load32(toks, i * 20 + 4);
    let l: u32 = load32(toks, i * 20 + 8);
    let k: u32 = 0;
    while k < l {
        store8(src, st + k, 32);
        k = k + 1;
    }
}

/// 「chooseset 白名单」那一条的报错出口。
fn die_chooseset(path: ptr, n: u32, scr: ptr) -> u32 {
    let dm: str = "a unit pulled in by `addin` may hold `choose` code only (to pull in code, use `use`): ";
    wdiag_file(diagfd(scr), scr, path, n, 22, str_ptr(dm), str_len(dm));
    return failp(dm, path, n);
}

/// 父文件先读进自己的槽, 递归处理依赖, 最后才把自己补上去 —— 顺序=依赖在前。
///
/// 形参不能叫 `entry`: LLVM 的块标签与局部值共用名字空间, 每个函数的第一块都叫
/// `entry`, 于是 `%entry` 参数会让 clang 报 "unable to create block named 'entry'"。
/// `--print-command FILE`（`docs/223`）：把这个单元注册的命令名打到 stdout；没声明就打
/// 一个**空行**（调用方按"空 = 不是命令"处理）。
///
/// **单独一趟词法**：不装载依赖、不做 comefor 展开、不单态化 —— 前端只要一个名字，
/// 走整条编译链是白花时间。与参考实现的 `lomentc --print-command` 同一个口径：
/// 声明形状不对（写了标签却取不出字面量）**退出 1**，不能让构建前端照着写一个畸形产物名。
fn print_command(path: ptr, n: u32, scr: ptr) -> u32 {
    let fd: i64 = open_ro(path, n, scr);
    if fd < 0 {
        return failp("--print-command cannot open the source file: ", path, n);
    }
    let sbuf: ptr = sys_alloc(262144 as u64) as ptr;
    let tbuf: ptr = sys_alloc(262144 as u64) as ptr;
    let raw: u64 = read_all(fd as u64, sbuf, 262144 as u64);
    syscall4(3, fd as u64, 0, 0);
    if raw == 0 {
        write_all(1, str_ptr("\n"), 1);
        return 0;
    }
    let _nt: u32 = lex_cap(sbuf, raw as u32, tbuf, 65536 as u32);
    let pk: u64 = lex_cmd_label(sbuf, tbuf, ptr_add(scr, CMD_OFF));
    let lt: u32 = (pk / 4294967296) as u32;
    let nl: u32 = (pk % 4294967296) as u32;
    if lt == 0 {
        write_all(1, str_ptr("\n"), 1);
        return 0;
    }
    if nl == 0 {
        return fail("the command declaration has the wrong shape -- put the name inside `register <name> { ... }`, or return a string literal from the declaration");
    }
    write_all(1, ptr_add(scr, CMD_OFF), nl as u64);
    write_all(1, str_ptr("\n"), 1);
    return 0;
}

fn load_file(path: ptr, n: u32, out: ptr, off: u64, seen: ptr, snc: ptr,
             depth: u32, scr: ptr, toks: ptr, from_addin: u32) -> u64 {
    // 这一路诊断的 fd 在 `scr` 里（`main` 开的，见 `diagfd`）。装载器整条递归都带着 `scr`,
    // 所以不必再多传一个参数。
    let dfd: i64 = diagfd(scr);
    if depth >= MAXDEPTH {
        // **报错, 不静默丢**（`docs/182` §1.10）。原来这里是 `return off` —— 依赖被悄悄
        // 丢掉、编译继续, 而参考实现 `resolve_deps` **根本没有上限**: 同一份源码, 链深
        // 过 8 层时两个实现给出**不同的单元**。这与 `MAX_USE` 那条是同一个形状 ——
        // 那次修的是**条数**, **深度**没跟着修。实测仓库里最深是 7
        // (`lompi/lpi_test.lomt`), 离静默截断只差一个 `use`。
        // 参考实现这一条是 E023（`依赖嵌套超过 8 层`），码与它对齐。
        let dm: str = "dependency nesting exceeds the limit -- remove one intermediate facade (the limit matches the reference implementation)";
        wdiag_at(dfd, scr, path, n, 1, 23, str_ptr(dm), str_len(dm));
        wstr(2, "loment: dependency nesting exceeds ");
        wdec(2, scr, MAXDEPTH);
        wstr(2, " levels -- remove one intermediate facade (the limit matches the reference implementation)\n");
        die(1);
    }
    if seen_has(seen, snc, path, n) == 1 {
        return off;
    }
    seen_add(seen, snc, path, n);
    let slot: ptr = ptr_add(out, UNIT_CAP - (depth + 1) * SLOT);
    let fd: i64 = open_ro(path, n, scr);
    if fd < 0 {
        // 就地报路径: 再晚一点 slot 的读就会把这块内存盖掉。
        // **必须硬失败** —— 原来这里是"报一行然后接着编", 于是缺依赖的编译会退出 0,
        // 只留一行 stderr。那正是这套工具链反复要消灭的东西(见 lomelf 头注与 docs/167:
        // "把静默错编改成报错退出"), 而且参考实现遇到这种输入是抛错退非零的 —— 两边
        // 必须一致。用户能不能看出是导入出的事, 就靠这一下。
        //
        // **路径必须在这里报**: 这句话原先手写了长度 20, 而 "打不开" 那一段只有 19 字节 ——
        // 多出来的那一字节是字符串常量的 NUL, 用户看到的是 `打不开 \0路径` (issue #8)。
        // `failp` 把字面量交给 `wstr`、把路径按量好的长度写, 两边都不带尾巴。
        let dm: str = "cannot open this file";
        wdiag_file(dfd, scr, path, n, 31, str_ptr(dm), str_len(dm));
        failp("cannot open ", path, n);
        die(1);
    }
    let raw_n: u64 = read_all(fd as u64, slot, SLOT as u64);
    syscall4(3, fd as u64, 0, 0);
    // **读满了槽 ≠ 文件就这么大**（`#345` 的 (a)：每一个固定容量越界时都要**有话**）。
    // 槽原先静默截断：一份大于 512 KiB 的源会**少一截**，用户看到的是一串与被截断位置
    // 无关的解析错 —— 那是本仓最不肯让的形状（`docs/188` 的"宁拒勿猜"）。
    // 判据只需一次比较：读满 `SLOT` 就说明**至少**这么大，下面那句把这个事实说出来。
    if raw_n >= SLOT as u64 {
        return fail("this source file is 512 KiB or larger -- the per-file slot cannot hold it, and cutting it short yields parse errors unrelated to where it was cut: split the facade") as u64;
    }
    let nb: u32 = strip_cr(slot, raw_n as u32);
    // 声明说的是"**怎么读**"，不是那份源的一部分 —— **在 `lex` 之前抹掉**（`docs/188` §1）。
    // 与参考实现的 `potato_from.strip_grammar_decl` 同一件事；放在这儿（而不是 token 层）
    // 是为了让 lexer / parser **一行都不动** —— 也就不必为它重生成种子。
    strip_grammar_decl(slot, nb, scr, path, n);
    // 先把本文件的 `use` 全收下来 (递归会复用 toks, 不能一边扫一边递归)
    let ntf: u32 = lex(slot, nb, toks);
    // `addin` 拉进来的单元**只许写 choose 相关代码**（`docs/182` §1.4）。
    if from_addin == 1 {
        check_chooseset(slot, toks, ntf, path, n, scr);
    }
    let uses: ptr = ptr_add(scr, USE_OFF);
    let addins: ptr = ptr_add(scr, ADDIN_OFF);
    let nu: u32 = 0;
    let na: u32 = 0;
    // **归属** (与参考实现 `lomentc.resolve_name` 的 §归属 同一条): 本文件住在商店的包里
    // 时, 名字形式先在商店里找、再找内置四根; 其余文件反过来。两个方向都撞得上真东西
    // (`store/std/mem.lomt` vs `loment/lib/mem.lomt`, `store/std/interp.lomt` vs
    // `loment/selfhost/interp.lomt`) —— 见 `resolve_use_name` 的注解。
    let ctd: ptr = ptr_add(scr, TOOLDIR_OFF);
    let ins: u32 = in_store_path(path, n, ctd, cstr_len(ctd), scr);
    let i: u32 = 0;
    // 两种写法都收进来, 统一成"确切的 (起点, 长度)"再递归:
    //   字符串形式 `use b` -> 剥掉引号
    //   名字形式   `use name`       -> 解析成真实路径, 写在 slot 的 nb 之后
    // (每层各有一个槽, 所以递归不会踩到父层写下的这些路径)
    let rbase: u32 = nb;
    // **库不许声明命令**（`docs/223` §3.3）：命令是**可执行产物**的身份，而库是给别人
    // `use` 的代码。与"库不许 `choose`"同一条纪律、同一个落点 —— 只有装载器分得清
    // "这一层是根还是被 use 进来的"（单元拼完之后检查器看到的是一整块 token）。
    // 一次算完再进循环：`lex_cmd_find` 扫的是整条 token 流，放在循环里就是 O(n²)。
    if depth > 0 && from_addin == 0
            && (lex_cmd_find(slot, toks) / 4294967296) > 0 {
        let dm: str = "a library must not declare a command (a command is an executable's identity; a library is code other units `use`): ";
        wdiag_file(dfd, scr, path, n, 24, str_ptr(dm), str_len(dm));
        failp(dm, path, n);
        die(1);
    }
    while load32(toks, i * 20) != 4 {
        // `choose` 声明的是**整个程序**的模式 (docs/143 §3.2), 所以只有**根单元**能写。
        // 这条只能在这里判: 装载器是唯一分得清"这一层是根还是被 use 进来的"的地方 ——
        // 单元拼完之后检查器看到的是一整块 token, 模块边界已经没了 (docs/158 §5 记过)。
        // 与 E018 同构: 那是装载器规则, 进不了 `loment_rule_parity._CASES` (它喂的是
        // 自包含单文件), 所以棘轮由驱动闸门承担, `BUDGET` 不动。
        // `addin` 拉进来的单元**正是**为了写 `choose` 才存在的, 所以这条对它不适用 ——
        // 反过来它有自己的白名单 (`check_chooseset`)。
        if depth > 0 && from_addin == 0 && tok_is(slot, toks, i, "choose") {
            // **依赖可以声明它的需求**（`docs/227`，用户 2026-10-09 裁决）。从前这里一律
            // 硬拒 —— 那让一个要除法的库**两面堵死**：当根编要 `choose runtime`，当依赖
            // 又不许写（`loment/lib/proc.lomt` 实测就卡在这儿）。
            //
            // 但**不能留着**：单元文本是**整段**拷进合并流的（`copy_bytes(out, off, slot,
            // 0, nb)`），留着它检查器会当成"这一维写了两次" —— 而那是要报的（E022）。
            // ⇒ 抹成等长空白，与 `choose write grammar` 那一行同一个手法（行号不动）。
            //
            // **与参考实现的一处已知不对称**（`docs/227` §5）：参考实现在 `check()` 里还判
            // "依赖要求 X、根的取值必须是 X"，这里**不判**。想在这里判过一次，**行不通**：
            // `toks` 是**共享**暂存、每个单元进来就 `lex(slot, nb, toks)` 重写一遍
            // （`load_file` 头顶那条注释写着"递归会复用 toks"），所以等这一层跑到时，
            // 根那一层的 token 早没了。要判得给根留一份 token 或把它的文本长度一路传下来 ——
            // 那是另一轮的事。
            //
            // **保证本身不受影响**：依赖的**代码**照样进合并流，于是"依赖里有除法而根写着
            // `no_runtime`"这一条**自举侧判得住**（合并流上的 E031），而且判得比参考实现
            // **更宽**（它连深度 > 1 的依赖也看得见）。两边只在"依赖声明了一个它**用不上**的
            // 核心模式"这一格上不同 —— 那一格不影响产物。
            blank_tok(slot, toks, i);
            blank_tok(slot, toks, i + 1);
            if tok_is(slot, toks, i + 2, ";") {
                blank_tok(slot, toks, i + 2);
            }
        }
        // **库不许 `addin`** —— 装载器只走"根 + 根 `addin` 到的单元"那张图, 所以库里的
        // `addin` **不会生效**。写了没生效正是本仓反复要消灭的那种东西, 所以报出来。
        if depth > 0 && from_addin == 0 && tok_is(slot, toks, i, "addin")
                && load32(toks, (i + 1) * 20) == 0 {
            let dm: str = "a library must not use `addin` (only the root unit pulls in switch settings): ";
            wdiag_file(dfd, scr, path, n, 22, str_ptr(dm), str_len(dm));
            failp(dm, path, n);
            die(1);
        }
        // `addin <名字>`: 与 `use` 同一条装载路径 —— 差别只有两处: **多一层同目录解析**、
        // 拉进来的单元**允许写 `choose`**（它正是"开关设定"）。**根单元专属**。
        if depth == 0 && tok_is(slot, toks, i, "addin")
                && load32(toks, (i + 1) * 20) == 0 {
            if na >= MAX_ADDIN {
                let dm: str = "more `addin` lines in one file than the limit allows -- split them into several choosesets; they are never dropped silently";
                wdiag_at(dfd, scr, path, n, load32(toks, i * 20 + 12), 22, str_ptr(dm), str_len(dm));
                wstr(2, "loment: more than ");
                wdec(2, scr, MAX_ADDIN);
                wstr(2, " `addin` lines in one file -- split them into several choosesets; they are never dropped silently\n");
                die(1);
            }
            let ap: u32 = load32(toks, (i + 1) * 20 + 4);
            let al: u32 = load32(toks, (i + 1) * 20 + 8);
            // 解析出来的路径写在 `use` 那批名字之后 (19200 = MAX_USE(300) * 64) ——
            // 固定偏移, 不与 `use` 抢格子。
            let rl: u32 = resolve_addin_name(slot, ap, al,
                                             ptr_add(slot, rbase + 19200 + na * 64), scr);
            if rl == 0 {
                let dm: str = "`addin` not found: ";
                wdiag_file(dfd, scr, path, n, 18, str_ptr(dm), str_len(dm));
                failp(dm, ptr_add(slot, ap), al);
                die(1);
            } else {
                store32(addins, na * 8, rbase + 19200 + na * 64);
                store32(addins, na * 8 + 4, rl);
                na = na + 1;
            }
        }
        if tok_is(slot, toks, i, "use") {
            let k: u32 = load32(toks, (i + 1) * 20);
            let up: u32 = load32(toks, (i + 1) * 20 + 4);
            let ul: u32 = load32(toks, (i + 1) * 20 + 8);
            // 条数上限: 只在**要计数的那两种写法**上卡, 而且**报错, 不静默丢** ——
            // 丢掉的话单元少几块, 而参考实现照收, 两个实现就对同一份源码给出不同产物。
            if (k == 2 && is_lomt(slot, up, ul) == 1) || k == 0 {
                if nu >= MAX_USE {
                    let dm: str = "more `use` lines in one file than the limit allows (the path form and the name form count together) -- split the facade, do not put a whole library in one file";
                    wdiag_at(dfd, scr, path, n, load32(toks, i * 20 + 12), 20, str_ptr(dm), str_len(dm));
                    wstr(2, "loment: more than ");
                    wdec(2, scr, MAX_USE);
                    wstr(2, " `use` lines in one file (the path form and the name form count together) -- split the facade, do not put a whole library in one file\n");
                    die(1);
                }
            }
            if k == 2 && is_lomt(slot, up, ul) == 1 {
                store32(uses, nu * 8, up + 1);
                store32(uses, nu * 8 + 4, ul - 2);
                nu = nu + 1;
            } else if k == 0 {
                // ---- **渠道闸（`libl`）：已放开**（`docs/232` §1.1 / §1.3，2026-10-15）
                //
                // 这里原先有一段闸：发行版里 `use libl` 打印一条点名 `libl` 的错误再 `die(1)`
                // （用户 2026-10-12：「LibL 仍然在仓库中，和 LVM 一样发行再锁」）。`#358` 把它
                // 放开了 —— 放开的条件是**先把承诺写下来**，那就是 `docs/232` §1.3。
                //
                // **留这段注释是为了让"闸去哪了"有据可查**：判据那一侧按棘轮规矩**反转**
                // （`loment_channel_test`：发行版从"拒 `use libl`"改成"收 `use libl`"），
                // 不是把那条判据删掉。`choose vm` 那条闸在 `checker.lomt` 里**原样留着**。
                let rl: u32 = resolve_use_name(slot, up, ul, ptr_add(slot, rbase + nu * 64),
                                               scr, ins);
                if rl == 0 {
                    // 同"打不开": 报出来之后**硬失败**, 不带着缺依赖的单元继续编
                    let dm: str = "the name import does not resolve, or is ambiguous: ";
                    wdiag_at(dfd, scr, path, n, load32(toks, (i + 1) * 20 + 12), 18,
                             str_ptr(dm), str_len(dm));
                    failp(dm, ptr_add(slot, up), ul);
                    die(1);
                } else {
                    store32(uses, nu * 8, rbase + nu * 64);
                    store32(uses, nu * 8 + 4, rl);
                    nu = nu + 1;
                }
            }
        }
        i = i + 1;
    }
    let u: u32 = 0;
    while u < nu {
        let sp: u32 = load32(uses, u * 8);
        let sl: u32 = load32(uses, u * 8 + 4);
        // 路径形式先定路径 (CWD -> 本文件所在目录); 名字形式解析出来的已经能用,
        // fix_rel 第一试就命中, 返回 0, 于是照原样往下传。
        let fr: u32 = fix_rel(slot, sp, sl, path, n, scr);
        if fr > 0 {
            off = load_file(ptr_add(scr, NAMTMP_OFF), fr, out, off, seen, snc,
                            depth + 1, scr, toks, 0);
        } else {
            off = load_file(ptr_add(slot, sp), sl, out, off, seen, snc,
                            depth + 1, scr, toks, 0);
        }
        u = u + 1;
    }
    // `addin` 目标紧随 `use` 依赖之后、**在本文件之前** —— 与参考实现 `resolve_deps`
    // 的展开顺序一致（`deps` 里 use 的在先、addin 的在后, 最后才是根）。
    // 顺序是身份的一部分: 单元拼出来的字节要两边一样。
    let a: u32 = 0;
    while a < na {
        let asp: u32 = load32(addins, a * 8);
        let asl: u32 = load32(addins, a * 8 + 4);
        off = load_file(ptr_add(slot, asp), asl, out, off, seen, snc,
                        depth + 1, scr, toks, 1);
        a = a + 1;
    }
    copy_bytes(out, off, slot, 0, nb);
    return off + nb as u64;
}

/// 单元里有没有这个枚举声明 (预置注入的判据, 镜像 lomentc.load)。
fn has_enum(src: ptr, toks: ptr, name: str) -> u32 {
    let i: u32 = 0;
    while load32(toks, i * 20) != 4 {
        if tok_is(src, toks, i, "enum") && tok_is(src, toks, i + 1, name) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 把预置枚举追加到单元末尾 (位置与 lomentc.load 的 append 一致: 模块枚举之后)。
fn append_prelude(dst: ptr, off: u64) -> u64 {
    let s: str = "\nmodule __prelude\npub enum Option<T> { Some(T), None }\npub enum Result<T, E> { Ok(T), Err(E) }\n";
    copy_bytes(dst, off, str_ptr(s), 0, str_len(s));
    return off + str_len(s) as u64;
}

fn _start() -> u32 {
    let unitv: u64 = sys_alloc(UNIT_CAP as u64);
    let irv: u64 = sys_alloc(IR_CAP as u64);
    let seenv: u64 = sys_alloc(SEEN_CAP as u64);
    let scrv: u64 = sys_alloc(SCR_CAP as u64);
    let argv_buf: u64 = sys_alloc(65536);   // 入口路径单独一块 (不能压在槽区里)
    let sncv: u64 = sys_alloc(16);          // 去重表长度 (一格内存, 递归共享)
    if unitv == 0 || irv == 0 || seenv == 0 || scrv == 0 || argv_buf == 0 || sncv == 0 {
        return fail("out of memory (brk failed)");
    }
    let unit: ptr = unitv as ptr;
    let ir: ptr = irv as ptr;
    let seen: ptr = seenv as ptr;
    let scr: ptr = scrv as ptr;
    let snc: ptr = sncv as ptr;
    store32(snc, 0, 0);
    // `--diag-out PATH` (docs/182 §5): 结构化诊断的输出路径。**必须在取 argv[0]/argv[1]
    // 之前取** —— `argv_at` 每次都重写同一块缓冲 (`argv_buf`), 而后面的 `ap` 是指进那块
    // 缓冲的指针; 顺序反了 `ap` 的内容会被这两次调用抹掉。
    // 不给这个参数就是**老行为**: 只打人看的文本到 stderr, 不吐 JSONL。
    //
    // `--emit-potato` (docs/189 S1) 与它同一个槽位。两者的区别是"要不要再多一个参数":
    // `--diag-out` 后面跟路径, 这个不跟 —— 对象直接写 stdout (与 IR 同一条出口次序:
    // **一个单元一份产物**)。
    store8(scr, DIAG_OFF, 0 as u8);
    let pmode: u32 = 0;
    let a2: u64 = argv_at(argv_buf as ptr, 65536, scr, 2);
    if a2 != 0 {
        let p2: ptr = ptr_add(argv_buf as ptr, (a2 >> 32) as u32);
        let n2: u32 = (a2 % 4294967296) as u32;
        if streq(p2, n2, "--diag-out") == 1 {
            let a3: u64 = argv_at(argv_buf as ptr, 65536, scr, 3);
            if a3 != 0 {
                let p3: ptr = ptr_add(argv_buf as ptr, (a3 >> 32) as u32);
                let n3: u32 = (a3 % 4294967296) as u32;
                copy_bytes(ptr_add(scr, DIAG_OFF), 0, p3, 0, n3);
                store8(scr, DIAG_OFF + n3, 0 as u8);
            }
        } else if streq(p2, n2, "--emit-potato") == 1 {
            pmode = 1;
        } else if streq(p2, n2, "--print-command") == 1 {
            // `--print-command` (docs/223): 这个单元注册了哪条命令 —— 构建前端拿它去命名
            // 产物（`loment-<名字>`）。**不装载**，只词法扫一遍（见 print_command）。
            pmode = 2;
        }
    }
    // 工具目录: argv[0] 所在目录 (自带 store 相对它)。**先取它** —— 下一次 argv_at 会把
    // 同一块 argv_buf 重写一遍, 而后面 ap 指进 argv_buf, 顺序反了内容会被抹掉。
    let a0: u64 = argv_at(argv_buf as ptr, 65536, scr, 0);
    if a0 == 0 {
        store8(scr, TOOLDIR_OFF, 0 as u8);
    } else {
        let _t: u32 = dir_of(ptr_add(argv_buf as ptr, (a0 >> 32) as u32),
                             (a0 % 4294967296) as u32,
                             ptr_add(scr, TOOLDIR_OFF), DIR_CAP);
    }
    let av: u64 = argv_at(argv_buf as ptr, 65536, scr, 1);
    if av == 0 {
        return fail("usage: loment <entry.lomt> [--diag-out PATH | --emit-potato]");
    }
    let ap: ptr = ptr_add(argv_buf as ptr, (av >> 32) as u32);
    let an: u32 = (av % 4294967296) as u32;
    if pmode == 2 {
        return print_command(ap, an, scr);
    }
    // 结构化诊断的输出 fd。**现在就开** (建/清空), 不是等出错了再开:
    //   * 上一次跑剩的旧文件不会被这一次误读 (空文件 = "这一次没有诊断");
    //   * 路径写错**立刻**炸出来, 而不是"编译通过所以没写文件"看不出来。
    // 与参考实现的 `--diag-out` 同一口径 (两边都在给定路径时就建, 无诊断时它是空的)。
    let dfd: i64 = 0 as i64 - 1;
    let dn: u32 = cstr_len(ptr_add(scr, DIAG_OFF));
    if dn > 0 {
        let o: i64 = open_wo(ptr_add(scr, DIAG_OFF), dn, scr);
        if o < 0 {
            return fail("--diag-out cannot be opened (path or permission)");
        }
        dfd = o;
    }
    // 装载器那一层（`load_file` 的递归、`strip_grammar_decl`、`check_chooseset`）也要写
    // 这一路诊断 —— fd 放进 `scr` 的 `DIAGFD_OFF` 那一格（与 `snc` 同一种传法）。
    // **0 = 没给**，所以存 fd 加一；`diagfd` 负责还原。
    store32(scr, DIAGFD_OFF, (dfd + 1) as u32);
    // 项目根: 入口文件所在目录 (名字形式的 deps/ 层相对它)
    let _p: u32 = dir_of(ap, an, ptr_add(scr, PROJ_OFF), DIR_CAP);
    // 词法缓冲按"单个文件"的大小开 (单元只 lex 一次, 见下)
    let tokv: u64 = sys_alloc(TOKS_CAP as u64);
    if tokv == 0 {
        let dm: str = "out of memory: cannot allocate the lexer buffer (brk failed)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let toks: ptr = tokv as ptr;
    // 源后缀 (名字形式 `use <名字>` 用它拼候选): **项目自己放的那份优先** (项目根 =
    // 入口文件所在目录), 再是工具链旁边那份; 都没配就用默认 `.lomt`。这时 unit/toks
    // 还空着, 借它们当读配置的暂存 —— load_file 紧接着就会盖掉它们。
    store8(scr, EXT_OFF, 0 as u8);
    let _e0: u32 = cfg_source_ext(ptr_add(scr, PROJ_OFF),
                                  cstr_len(ptr_add(scr, PROJ_OFF)),
                                  ptr_add(scr, EXT_OFF), scr, unit, toks);
    if _e0 == 0 {
        let _e1: u32 = cfg_source_ext(ptr_add(scr, TOOLDIR_OFF),
                                      cstr_len(ptr_add(scr, TOOLDIR_OFF)),
                                      ptr_add(scr, EXT_OFF), scr, unit, toks);
    }
    // 空文件与目录以前都落在下面那句「路径对吗?」上 (issue #52): 读到 0 字节就被说成
    // 路径错了。目录在 open 时就能认出来; 普通文件读到 0 字节才是空文件。
    // 真正打不开的路径仍由 `load_file` 报「打不开」, 不进这里。
    let ek: u32 = entry_kind(ap, an, scr);
    if ek == 1 {
        let dm: str = "the entry is a directory, not a source file";
        wdiag_file(dfd, scr, ap, an, 31, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let len: u64 = load_file(ap, an, unit, 0, seen, snc, 0, scr, toks, 0);
    if len == 0 {
        if ek == 2 {
            let dm: str = "the entry file is empty (there is no source in it)";
            wdiag_file(dfd, scr, ap, an, 31, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        let dm2: str = "cannot load the entry file (is the path right?)";
        wdiag_file(dfd, scr, ap, an, 31, str_ptr(dm2), str_len(dm2));
        return fail(dm2);
    }
    // 单元的词法缓冲: 按**实测密度**估 —— 仓库 184 个文件合计 4.81 字节/token, 最密的
    // 3.02; 取 **10 字节/源码字节**, 一倍余量。原先按 20 字节/源码字节开 (那是"1 字节
    // 1 个 token"的理论上界), 编 std 那种 1.86 MB 的单元要 37 MB, 而 PE 垫片的堆一共
    // 只有 64 MB (`WS_HEAP`) —— 于是"单元太大"。**估小了由 lex_cap 报出来**, 不静默少
    // token (少 token = 后面的语句凭空消失, 而判据只会报"两个编译器不一致")。
    let tcap: u64 = (len + 512) * 10;
    let tok2v: u64 = sys_alloc(tcap);
    if tok2v == 0 {
        let dm: str = "the unit is too large: cannot allocate the lexer buffer";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let toks2: ptr = tok2v as ptr;
    let ntk: u32 = (tcap / 20) as u32;
    // 预置枚举注入: 先粗判一次 (同一个缓冲; +512 的余量够放下小段 prelude)
    let nt0: u32 = lex_cap(unit, len as u32, toks2, ntk);
    if nt0 > ntk {
        let dm: str = "the unit is too large: more tokens than the buffer holds (denser than 10 bytes/token)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    // **文件必须以 `module` 开头，而且名字要写在同一行**（`#24`）。
    // 自举这一侧原先**没有这一条**：少了那一行的单元会一路走到 codegen —— 而 codegen
    // 假设"第一个记号就是 `module`、第二个就是它的名字"，于是**编译器自己段错误**
    // （用户拿到的是 shell 的 "Segmentation fault"：没有诊断、没有行号、没有退出码）。
    // 参考实现那句是 "期望 module（文件必须以 module 开头），得到 'fn'"。
    //
    // 位置在**词法之后、别的任何一趟之前**：后面每一趟（`has_enum` / `append_prelude`
    // / `apply_switches` / `check_arena` / `emit_module`）都默认这一格在。
    // 名字那一格也要判 —— `module` 单独一行时后面每一趟都会把**下一个记号**当名字用
    // （`module` + 换行 + `fn` 会被当成"模块名是 `fn`"）。
    // **只有"有内容"的源才要求 `module`** —— 只有注释（或空）的文件与空文件同类：
    // "没有可编译的源"，`test_m85_entry_load_distinguishes_empty_file_from_directory`
    // 钉着它必须被**接受**。判据是"lexer 认得出不止一个记号"。
    if nt0 > 1 {
        if tok_is(unit, toks2, 0, "module") == false {
            let dm: str = "the file must start with `module` (the first token has to be `module`) -- without it this source cannot be located";
            wdiag_at(dfd, scr, ap, an, load32(toks2, 12), 19, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        if load32(toks2, 20) != 0 {
            let dm: str = "`module` must be followed by a module name (an identifier)";
            wdiag_at(dfd, scr, ap, an, load32(toks2, 12), 19, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        if load32(toks2, 32) != load32(toks2, 12) {
            let dm: str = "the module name must be on the same line as `module` (a name after a newline does not count)";
            wdiag_at(dfd, scr, ap, an, load32(toks2, 12), 19, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
    }
    if has_enum(unit, toks2, "Option") == 0 || has_enum(unit, toks2, "Result") == 0 {
        len = append_prelude(unit, len);
    }
    // 正式词法 + 发射
    let ntl: u32 = lex_cap(unit, len as u32, toks2, ntk);
    if ntl > ntk {
        let dm: str = "the unit is too large: more tokens than the buffer holds (denser than 10 bytes/token)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    // 开关 (`docs/182` §1): **在 token 流上落定** —— 关着的那段体连 token 都不留,
    // 所以"解析跳过"是字面为真的, 而 `choose` 从此有了一个真消费方（在此之前它什么都不驱动）。
    // 尺寸写字面量: 常量在表达式里没有类型 (见文件头那条), `MAX_CHOOSE * SW_SIZE + 8`
    // 会被算成 i32。500 * 16 + 8 = 8008。
    let swv: u64 = sys_alloc(8008);
    if swv == 0 {
        let dm: str = "out of memory: cannot allocate the switch table (brk failed)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let sw: ptr = swv as ptr;
    let nt: u32 = apply_switches(unit, toks2, ntl, sw);
    // `comefor`/`byuse` 的 token 层展开（`docs/184` §9 S4.1）。**在开关之后**，
    // 理由与参考侧 `lomentc.load` 那条一样：关着的 `set choose` 体里写的 `comefor`
    // 该连 token 都不剩（先展开的话它会先被认成一次**使用**）。
    //
    // 产物写进**第二块 token 缓冲** —— 展开会**变长**（宏体吐的比吃的多），
    // 而 `apply_switches` 那种原地压缩只对"只删不插"成立。
    let cf_used: u32 = 0;
    if has_comefor(unit, toks2, nt) == 1 {
        cf_used = 1;
        let cfv: u64 = sys_alloc(CF_BYTES as u64);       // 方言表 + 体缓冲 + 语境
        if cfv == 0 {
            let dm: str = "out of memory: cannot allocate the comefor workspace (brk failed)";
            wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        // 解释器的工作堆**单独要一块**（墙 ①b）：与 codegen 的 49152B 同在一块 64 KiB
        // 上必然相撞，撞了是 `@__loment_abort`（SIGILL，看起来像编译器崩了）。
        let hpv: u64 = sys_alloc(cf_heap_bytes() as u64);
        if hpv == 0 {
            let dm: str = "out of memory: cannot allocate the comefor heap (brk failed)";
            wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        // 展开后的产物表。与源一样大 —— 宏体可以吐得比吃的多，但不会多到要再翻一倍。
        let cfov: u64 = sys_alloc(TOKS_CAP as u64);
        if cfov == 0 {
            let dm: str = "out of memory: cannot allocate the comefor output buffer (brk failed)";
            wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        let rsv: u64 = sys_alloc(64);
        if rsv == 0 {
            let dm: str = "out of memory: cannot allocate the comefor result buffer (brk failed)";
            wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        let rs: ptr = rsv as ptr;
        let re: u32 = expand_comefor(unit, toks2, nt, cfov as ptr, ntk, cfv as ptr,
                                              hpv as ptr, len as u32, rs);
        if re != 0 {
            // `re` 说哪一类错；`re == 7` 时 `rs[0]` 是**解释器**的错误码（宏体没跑成）。
            return comefor_fail(re, load32(rs, 0));
        }
        // 下游一律用展开后的那一份 —— 与 `apply_switches` 换掉 `nt` 是同一个做法。
        nt = load32(rs, 0);
        toks2 = cfov as ptr;
    }


    // 外部代码块（`docs/185` S1）在自举侧**还没落地** —— 参考实现收，这边还不认。
    // 明确拒绝，别让它掉进"未定义符号"那种指不到点子的错里。镜像落地时删掉这一段。
    if has_extblock(unit, toks2, nt) == 1 {
        let dm: str = "external code blocks (`let c { }` / `c { }`) are not implemented in the self-hosted compiler yet -- run `loment skill --print` for what this toolchain takes";
        wdiag_file(dfd, scr, ap, an, 23, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    // 先检查再发射: 有诊断就报到 stderr 并以 1 退出, 否则才发 IR。
    // 诊断格式与 p8 的 C 夹具同源: `<码>@<token>:<行> <片段>` 一行一条。
    let errsv: u64 = sys_alloc(8192);
    if errsv == 0 {
        let dm: str = "out of memory: cannot allocate the diagnostic buffer (brk failed)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let errs: ptr = errsv as ptr;
    // 检查器的工作缓冲也从 brk 拿 (一块 >= chk_arena_bytes(), 内部分段见 checker.lomt 的
    // `chk_arena_*`)。**不**用语言自带的 64 KiB bump 堆: `emit_module` 一次就要
    // 49152B, 两者相加会越过 65536, 而 OOM 的边界检查在无 libc 环境下是
    // `@__loment_abort` —— 一条非法指令 (SIGILL), 看起来像"编译器崩了"。
    let arenav: u64 = sys_alloc(chk_arena_bytes() as u64);
    if arenav == 0 {
        let dm: str = "out of memory: cannot allocate the checker arena (brk failed)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let arena: ptr = arenav as ptr;
    // 检查器的符号表按**单元规模**定 (syms 段 / 每条 20 字节)。先数一遍声明关键字 ——
    // 这是个**保守上界** (trait 里只声明不发射的方法也算进去), 超了就报错, 不写穿。
    let nsym: u32 = 0;
    let sk: u32 = 0;
    while load32(toks2, sk * 20) != 4 {
        if tok_is(unit, toks2, sk, "fn") || tok_is(unit, toks2, sk, "const")
                || tok_is(unit, toks2, sk, "struct") || tok_is(unit, toks2, sk, "enum") {
            nsym = nsym + 1;
        }
        sk = sk + 1;
    }
    if nsym > (chk_arena_scr() - chk_arena_syms()) / 20 {
        let dm: str = "more declarations than the checker's symbol table holds -- split the facade";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let tytp: ptr = ptr_add(arena, chk_arena_tyt());
    let ne: u32 = check_arena(unit, toks2, errs, arena,
                              ptr_add(arena, chk_arena_scr()),
                              ptr_add(arena, chk_arena_ctab()),
                              ptr_add(arena, chk_arena_nc()),
                              ptr_add(arena, chk_arena_exs()),
                              ptr_add(arena, chk_arena_env()),
                              tytp);
    // 开关的规则接在检查器之后 —— 开关表在**驱动器**手上（做装载与裁减的是它）,
    // 与 "`choose` 第三条（库不许）落在装载器" 同一个理由（docs/176 §7.3）。
    let nsw: u32 = switch_rules(unit, toks2, sw, errs, ne * 8);
    let ne2: u32 = ne + nsw;
    if ne2 != 0 {
        wstr(2, "loment: static checks failed\n");
        let e: u32 = 0;
        while e < ne2 && e < 64 {
            let code: u32 = load32(errs, e * 8);
            let tk: u32 = load32(errs, e * 8 + 4);
            wstr(2, "  E");
            wdec(2, scr, code);
            wstr(2, " @");
            wdec(2, scr, tk);
            wstr(2, " line ");
            wdec(2, scr, load32(toks2, tk * 20 + 12));
            wstr(2, ": ");
            let st: u32 = load32(toks2, tk * 20 + 4);
            let ln: u32 = load32(toks2, tk * 20 + 8);
            // `E031`（这一档是 `no_runtime`，而这个构造要运行期）：正文写成**那句话**，
            // 不是那一格 token（issue #321）。码是**专属**的（不再与 `choose` 共用 E022），
            // `str_len(ph) > 0` 只是"那格 token 在名单里"的兜底，照旧走 token 原文。
            let ph: str = rt_phrase(unit, toks2, tk);
            let isrt: u32 = 0;
            if code == 31 && str_len(ph) > 0 {
                isrt = 1;
            }
            let take: u32 = 24;
            if ln < 24 {
                take = ln;
            }
            if isrt == 1 {
                write_all(2, str_ptr(ph), str_len(ph) as u64);
            } else {
                write_all(2, ptr_add(unit, st), take as u64);
            }
            wstr(2, "\n");
            // 同一条诊断, 结构化那一份 (docs/182 §5)。**同一份数据两个受众**:
            // 上面那份给人看 (stderr), 这份给报错器看 (一行 JSON)。
            if dfd >= 0 {
                if isrt == 1 {
                    let _k2: u64 = wdiag_rt(dfd as u64, scr, ap, an,
                                            load32(toks2, tk * 20 + 12), ph,
                                            load32(tytp, RT_N_SITES));
                } else {
                    let _j: u64 = wdiag(dfd as u64, scr, ap, an,
                                        load32(toks2, tk * 20 + 12), code,
                                        ptr_add(unit, st), take);
                }
            }
            e = e + 1;
        }
        return die(1);
    }
    // `--emit-potato` (`docs/189` S1): 发**形式对象**(Potato v5)而不是 IR。
    //
    // **在 codegen 之前** —— 参考实现的 `emit_potato` 也不经过 IR 后端, 所以"聚合类型
    // 按值传"那种后端编不了的单元照样发得出对象(那正是 M45 把形式对象做成**出口**的理由:
    // 它是**独立于后端**的那一份视图)。放在 codegen 之后就没有这个性质了。
    //
    // 方言那一格由**这里**拒: token 流上 `comefor`/`byuse` 已经被展开吃掉了, 走到这里
    // 再也看不出"这次展开过没有" —— 而这一层手上正好有那个答案。
    if pmode == 1 {
        if cf_used == 1 {
            let dm: str = "`--emit-potato`: this unit uses comefor/byuse, and the `dialects` section has not reached the self-hosted side yet -- run `loment skill --print`";
            wdiag_file(dfd, scr, ap, an, 23, str_ptr(dm), str_len(dm));
            return fail(dm);
        }
        let pn: u32 = potato_emit(unit, toks2, nt, sw, ir);
        if pn == 0 {
            return die(1);
        }
        write_all(1, ir, pn as u64);
        return die(0);
    }
    // codegen 的状态块也从 brk 拿: 那几张表按**单元规模**定 (函数表 4600 格), 整块
    // 500 KB 上下, 放不进语言自带的 64 KiB bump 堆 (checker 的 arena 早就是这条路)。
    let cgv: u64 = sys_alloc(cg_arena_bytes() as u64);
    if cgv == 0 {
        let dm: str = "out of memory: cannot allocate the codegen state block (brk failed)";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(dm), str_len(dm));
        return fail(dm);
    }
    let cg: ptr = cgv as ptr;
    let m: u32 = emit_module(unit, toks2, ir, cg);
    if m == 0 {
        // **两张表共用这一格，所以两张都点名**（`#345` 的 (a)）：发射器对 `CG_MAXFN` 与
        // `CG_MAXENUM` 都只 `return 0`，从驱动这一端看不出是哪一张撞的 —— 那就别猜，
        // 把两个名字一起写出来（原先只写函数数，于是枚举爆掉时用户会去删函数）。
        let msg: str = "more functions (or more enum variants) than the codegen tables hold -- split the facade";
        wdiag_file(dfd, scr, ap, an, 33, str_ptr(msg), str_len(msg));
        return fail(msg);
    }
    write_all(1, ir, m as u64);
    return die(0);
}
