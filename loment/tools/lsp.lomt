// loment/tools/lsp.lomt — Loment 版语言服务 (无 Python, docs/148 §2b)
//
// 为什么: 开发者不该为了写 Loment 而装 Python。VS Code 扩展原先 spawn `tools/loment_lsp.py`,
// 现在可以 spawn 本程序 (Windows 上经 WSL 跑, 见 docs/157 §3.5)。
//
// 协议: LSP over stdio (JSON-RPC 2.0, `Content-Length: N\r\n\r\n` 分帧), 实现
//   initialize / initialized / didOpen / didChange / completion / definition /
//   shutdown / exit。诊断用**自举 checker**(与参考实现规则等价 63/63), 消息文本用
//   `loment_diag.RULES` 的**标题** (码按修法分, 码即 E0NN, 与 checker 的数字码同号)。
//
// 边界 (诚实说明): 本版**不提供 formatting** (不声明 documentFormattingProvider, 编辑器
// 因此不会调它; 格式化仍可用 `loment/tools/lomfmt.lomt`)。诊断文案是分类标题, 不是参考
// 实现的完整消息措辞。判据见 tools/loment_lsp_test.py。

module lsp
choose runtime

use json
use lexer
use checker
use switches

// ---------------------------------------------------------------- 尺寸与布局

const IN_CAP: u32 = 4194304;        // 单条入站消息
const DOC_CAP: u32 = 262144;        // 一个文档的文本
const N_DOC: u32 = 4;
const URI_CAP: u32 = 512;
const BODY_OFF: u32 = 8192;         // 出站 body 在出站缓冲内的起点 (前 8KB 给数字缓冲)
const ARENA_CAP: u32 = 65536;       // JSON DOM
const TOK_EXTRA: u32 = 65536;

// mem 块布局 (字节偏移)
const M_STATE: u32 = 0;             // 0=body 长 4=文档数 8=错误数 12=符号数
const S_OLEN: u32 = 0;
const S_NDOC: u32 = 4;
const S_NERR: u32 = 8;
const S_NSYM: u32 = 12;
const DOCS_URI: u32 = 4096;         // N_DOC * URI_CAP
const DOCS_TXT: u32 = 8192;         // N_DOC * DOC_CAP
const SYM_OFF: u32 = 1056768;       // = DOCS_TXT + N_DOC * DOC_CAP（文档正文区之后）
// 一条符号记录: 名字 ≤60B + NUL @0..61 | kind @64 | line @68 | **col @72**（`#27`）。
const SYM_STRIDE: u32 = 80;
const SYM_MAX: u32 = 256;
const OUT_OFF: u32 = 1240000;       // 出站缓冲 (BODY_OFF 起才是 body)
const SCR_OFF: u32 = 1536000;       // 行/临时缓冲
// 开关表 (`docs/182` §1): `switches.apply_switches` 要 `SW_BYTES` 字节的暂存。
// **放在 mem 块末尾并显式撑大 `MEM_CAP`** —— 塞进 `SCR_OFF` 那段会和行缓冲/路径缓冲
// 抢地方, 越界是**静默改坏**而不是报错 (本仓在这一类上栽过)。
const SW_OFF: u32 = 1650000;        // = 旧 MEM_CAP, 表从这儿起
const MEM_CAP: u32 = 1658008;       // SW_OFF + switches.SW_BYTES (8008)

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}



fn rd1(p: ptr, n: u32) -> i64 {
    return syscall4(0, 0, p as u64, n as u64);
}

fn wr_all(fd: u64, p: ptr, n: u32) {
    let off: u32 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + (off as u64), (n - off) as u64);
        if w <= 0 {
            off = n;
        } else {
            off = off + (w as u32);
        }
    }
}

// ---------------------------------------------------------------- 帧

/// 读一条消息 body (0 = 输入结束)。头部逐字节读到空行, 解析 Content-Length, 再读满 body。
fn read_msg(buf: ptr, cap: u32, hdr: ptr) -> u32 {
    let hn: u32 = 0;
    let blank: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        let r: i64 = rd1(ptr_add(hdr, hn), 1);
        if r <= 0 {
            return 0;
        }
        hn = hn + 1;
        if hn >= 4096 {
            return 0;
        }
        if load8(hdr, hn - 1) == 10 {
            if hn >= 2 && load8(hdr, hn - 2) == 10 {
                blank = 1;
                go = 0;
            } else {
                if hn >= 4 && load8(hdr, hn - 4) == 13 && load8(hdr, hn - 3) == 10
                        && load8(hdr, hn - 2) == 13 {
                    blank = 1;
                    go = 0;
                }
            }
        }
    }
    if blank == 0 {
        return 0;
    }
    let clen: u32 = 0;
    let i: u32 = 0;
    let found: u32 = 0;
    while i + 15 < hn {
        if found == 0 && key_at(hdr, i) {
            found = 1;
            let k: u32 = i + 15;
            let started: u32 = 0;
            while k < hn && started == 0 {
                let c: u32 = load8(hdr, k);
                if c >= 48 && c <= 57 {
                    clen = clen * 10 + (c - 48);
                    k = k + 1;
                } else {
                    if clen > 0 {
                        started = 1;
                    } else {
                        k = k + 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    if clen == 0 || clen > cap {
        return 0;
    }
    let got: u32 = 0;
    while got < clen {
        let r2: i64 = rd1(ptr_add(buf, got), clen - got);
        if r2 <= 0 {
            return 0;
        }
        got = got + (r2 as u32);
    }
    return clen;
}

/// hdr[i..] 是否是 "Content-Length:"
fn key_at(hdr: ptr, i: u32) -> bool {
    let key: str = "Content-Length:";
    let k: u32 = 0;
    while k < str_len(key) {
        if load8(hdr, i + k) != str_byte(key, k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// ---------------------------------------------------------------- 出站

fn out_body(mem: ptr) -> ptr {
    return ptr_add(mem, OUT_OFF);
}

fn out_len(mem: ptr) -> u32 {
    return load32(mem, S_OLEN);
}

fn out_done(mem: ptr, o: u32) {
    store32(mem, S_OLEN, o);
}

/// 发一条 body (缓冲里从 BODY_OFF 开始, 长 o - BODY_OFF)。
fn send_pending(mem: ptr) {
    let hdr: ptr = ptr_add(mem, SCR_OFF);
    let n: u32 = load32(mem, S_OLEN) - BODY_OFF;
    let o: u32 = 0;
    o = json_emit_lit(hdr, o, "Content-Length: ");
    o = json_emit_u32(hdr, o, n);
    // 帧头分隔符必须是**真的 CRLF**: Loment 的字符串转义只有 n/t/"/\ (没有 \r),
    // 所以 `"\r\n\r\n"` 会写成字面 'r'+LF ✗ —— 这里直接写字节。
    store8(hdr, o, 13 as u8);
    store8(hdr, o + 1, 10 as u8);
    store8(hdr, o + 2, 13 as u8);
    store8(hdr, o + 3, 10 as u8);
    o = o + 4;
    wr_all(1, hdr, o);
    wr_all(1, ptr_add(out_body(mem), BODY_OFF), n);
}

/// 响应前缀: `{"jsonrpc": "2.0", "id": <raw>, "result": ` 返回写到的偏移。
fn resp_prefix(mem: ptr, src: ptr, arena: ptr, id: u32) -> u32 {
    let b: ptr = out_body(mem);
    let o: u32 = BODY_OFF;
    o = json_emit_lit(b, o, "{\"jsonrpc\": \"2.0\", \"id\": ");
    o = emit_id(b, o, src, arena, id);
    o = json_emit_lit(b, o, ", \"result\": ");
    out_done(mem, o);
    return o;
}

fn emit_id(b: ptr, o: u32, src: ptr, arena: ptr, id: u32) -> u32 {
    if id == 4294967295 {
        return json_emit_lit(b, o, "null");
    }
    let k: u32 = json_nkind(arena, id);
    if k == 4 {
        return copy_span(b, o, src, json_raw_off(arena, id), json_raw_len(arena, id));
    }
    if k == 3 {
        return copy_span(b, o, src, json_raw_off(arena, id) - 1, json_raw_len(arena, id) + 2);
    }
    if k == 5 {
        return json_emit_lit(b, o, "true");
    }
    if k == 6 {
        return json_emit_lit(b, o, "false");
    }
    return json_emit_lit(b, o, "null");
}

fn copy_span(b: ptr, o: u32, src: ptr, s: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(b, o + i, load8(src, s + i) as u8);
        i = i + 1;
    }
    return o + n;
}

// ---------------------------------------------------------------- 文档表

fn same_bytes(a: ptr, b: ptr, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn doc_urilen(mem: ptr, i: u32) -> u32 {
    return load32(mem, DOCS_URI + i * URI_CAP + URI_CAP - 4);
}

fn doc_uri(mem: ptr, i: u32) -> ptr {
    return ptr_add(mem, DOCS_URI + i * URI_CAP);
}

fn doc_text(mem: ptr, i: u32) -> ptr {
    return ptr_add(mem, DOCS_TXT + i * DOC_CAP);
}

fn doc_txtlen(mem: ptr, i: u32) -> u32 {
    return load32(mem, DOCS_URI + i * URI_CAP + URI_CAP - 8);
}

fn doc_find(mem: ptr, uri: ptr, un: u32) -> u32 {
    let n: u32 = load32(mem, S_NDOC);
    let i: u32 = 0;
    let hit: u32 = 4294967295;
    while i < n {
        if doc_urilen(mem, i) == un && same_bytes(doc_uri(mem, i), uri, un) {
            hit = i;
        }
        i = i + 1;
    }
    return hit;
}

fn doc_put(mem: ptr, uri: ptr, un: u32, text: ptr, tn: u32) -> u32 {
    let idx: u32 = doc_find(mem, uri, un);
    if idx == 4294967295 {
        idx = load32(mem, S_NDOC);
        if idx >= N_DOC {
            idx = N_DOC - 1;
        } else {
            store32(mem, S_NDOC, idx + 1);
        }
    }
    let ucap: u32 = URI_CAP - 16;
    let un2: u32 = un;
    if un2 > ucap {
        un2 = ucap;
    }
    let up: ptr = doc_uri(mem, idx);
    let i: u32 = 0;
    while i < un2 {
        store8(up, i, load8(uri, i) as u8);
        i = i + 1;
    }
    store32(mem, DOCS_URI + idx * URI_CAP + URI_CAP - 4, un2);
    let tcap: u32 = DOC_CAP - 16;
    let tn2: u32 = tn;
    if tn2 > tcap {
        tn2 = tcap;
    }
    let tp: ptr = doc_text(mem, idx);
    let q: u32 = 0;
    while q < tn2 {
        store8(tp, q, load8(text, q) as u8);
        q = q + 1;
    }
    store8(tp, tn2, 0 as u8);
    store32(mem, DOCS_URI + idx * URI_CAP + URI_CAP - 8, tn2);
    return idx;
}

// ---------------------------------------------------------------- 诊断

/// 错误码 -> 标题 (与 tools/loment_diag.RULES 同口径; 码按**修法**分)。
fn diag_title(code: u32) -> str {
    if code == 1 { return "类型不匹配"; }
    if code == 2 { return "符号未声明"; }
    if code == 3 { return "实参数量不符"; }
    if code == 4 { return "能力域非法"; }
    if code == 5 { return "与出界声明冲突"; }
    if code == 6 { return "移动后使用"; }
    if code == 7 { return "借用冲突"; }
    if code == 8 { return "match/变体用法非法"; }
    if code == 9 { return "类型名非法"; }
    if code == 10 { return "? 误用"; }
    if code == 11 { return "只读切片写入"; }
    if code == 12 { return "悬垂借用"; }
    if code == 13 { return "重名"; }
    if code == 14 { return "赋值目标非法"; }
    if code == 15 { return "字段/下标/取址非法"; }
    if code == 16 { return "数组字面量非法"; }
    if code == 17 { return "as 转换非法"; }
    return "未分类";
}

/// 跑自举 checker (toks 已由调用方 lex 好), 错误写进 errs (每条 8B), 返回条数。
fn run_check(text: ptr, toks: ptr, errs: ptr, chk: ptr) -> u32 {
    return check_arena(text, toks, errs, chk,
                       ptr_add(chk, chk_arena_scr()),
                       ptr_add(chk, chk_arena_ctab()),
                       ptr_add(chk, chk_arena_nc()),
                       ptr_add(chk, chk_arena_exs()),
                       ptr_add(chk, chk_arena_env()),
                       ptr_add(chk, chk_arena_tyt()));
}

/// **开关落定**（`docs/182` §1）: 把 `set choose` 的裁减做在 token 流上, 返回压缩后的条数。
///
/// 每个 `lex` 之后都**必须**接这一步 —— 语言服务是"读 L1 源的东西"之一, 而它此前**漏了**:
/// 拿 `lex` 的原始 token 直接喂 `run_check`/`scan_syms`, 于是关着的开关体照样被检查
/// (满屏假错), 体里定义的 `fn` 也会被补全与跳转当成真的。
fn switchify(mem: ptr, text: ptr, toks: ptr, nt: u32) -> u32 {
    return apply_switches(text, toks, nt, ptr_add(mem, SW_OFF));
}

fn emit_e0(b: ptr, o: u32, code: u32) -> u32 {
    store8(b, o, (48 + (code / 100) % 10) as u8);
    store8(b, o + 1, (48 + (code / 10) % 10) as u8);
    store8(b, o + 2, (48 + code % 10) as u8);
    return o + 3;
}

/// publishDiagnostics 通知。
fn publish(mem: ptr, toks: ptr, uri: ptr, un: u32, errs: ptr, ne: u32) -> u32 {
    let b: ptr = out_body(mem);
    let o: u32 = BODY_OFF;
    o = json_emit_lit(b, o, "{\"jsonrpc\": \"2.0\", \"method\": \"textDocument/publishDiagnostics\", \"params\": {\"uri\": ");
    o = json_emit_str(b, o, uri, un);
    o = json_emit_lit(b, o, ", \"diagnostics\": [");
    let i: u32 = 0;
    while i < ne && i < 64 {
        let code: u32 = load32(errs, i * 8);
        let tk: u32 = load32(errs, i * 8 + 4);
        let line: u32 = load32(toks, tk * 20 + 12);
        // `#27`：范围要**指在那个符号上**。原先两端的列是常量 0 与 200 —— 一条 14 字符的行
        // 和一条 300 字符的行回来的是同一对常量，编辑器于是把**整行**画成波浪线，指不到
        // 出问题的那一格。token 里本来就有 `col` 与 `len`（`lexer.lomt` 顶部那张表），
        // `--check` 那一侧早就在用它们打 `行:列`：这里只是把同一份数据接上。
        let col: u32 = load32(toks, tk * 20 + 16);
        let tlen: u32 = load32(toks, tk * 20 + 8);
        let sp: u32 = 0;
        if col > 0 {
            sp = col - 1;                     // LSP 的列是 0 起，词法器的 `col` 是 1 起
        }
        let ep: u32 = sp + 1;
        if tlen > 0 {
            ep = sp + tlen;
        }                                     // len 为 0（EOF 那种）时给一格，免得零宽
        if i > 0 {
            o = json_emit_lit(b, o, ", ");
        }
        o = json_emit_lit(b, o, "{\"range\": {\"start\": {\"line\": ");
        o = json_emit_u32(b, o, line - 1);
        o = json_emit_lit(b, o, ", \"character\": ");
        o = json_emit_u32(b, o, sp);
        o = json_emit_lit(b, o, "}, \"end\": {\"line\": ");
        o = json_emit_u32(b, o, line - 1);
        o = json_emit_lit(b, o, ", \"character\": ");
        o = json_emit_u32(b, o, ep);
        o = json_emit_lit(b, o, "}}, \"severity\": 1, \"source\": \"loment\", \"code\": \"E");
        o = emit_e0(b, o, code);
        o = json_emit_lit(b, o, "\", \"message\": ");
        // 消息文本 = "E0NN <标题>": 先拼进暂存, 再**整体**做一次 JSON 转义
        // (直接拼两段会被套上两层引号 -> 非法 JSON)
        let mb: ptr = ptr_add(mem, SCR_OFF + 6144);
        store8(mb, 0, 69 as u8);                       // 'E'
        store8(mb, 1, (48 + (code / 100) % 10) as u8);
        store8(mb, 2, (48 + (code / 10) % 10) as u8);
        store8(mb, 3, (48 + code % 10) as u8);
        store8(mb, 4, 32 as u8);
        let ttl: str = diag_title(code);
        let mo: u32 = 5;
        let q: u32 = 0;
        while q < str_len(ttl) {
            store8(mb, mo, str_byte(ttl, q) as u8);
            mo = mo + 1;
            q = q + 1;
        }
        o = json_emit_str(b, o, mb, mo);
        o = json_emit_lit(b, o, "}");
        i = i + 1;
    }
    o = json_emit_lit(b, o, "]}}");
    out_done(mem, o);
    send_pending(mem);
    return o;
}

/// `#262`：文件头写着 `choose write grammar <别名>` 而别名**不是** `loment` / `rust` 时，
/// 返回别名 token 的下标；否则 0。
///
/// **为什么这一层要拦**：那样一份源**编得过**（前门会把它翻成 Loment），可用 Loment 的规则
/// 去查它，报出来的是**一屏假错** —— 用户会去改一份本来就对的源。
/// 返回**别名在源里的跨度**（`(起点 << 32) | 长度`），0 = 没声明或者声明的是原生语法。
/// 回**跨度**而不是 token 下标：这一趟要跑在 `switchify` **之前**（`apply_switches` 会把
/// `choose write grammar …` 那一行当开关声明吃掉），之后下标就全移位了。
fn lsc_foreign(src: ptr, t: ptr, nt: u32) -> u64 {
    let i: u32 = 0;
    while i + 3 < nt {
        if byte_is(src, load32(t, i * 20 + 4), load32(t, i * 20 + 8), "choose")
                && byte_is(src, load32(t, (i + 1) * 20 + 4), load32(t, (i + 1) * 20 + 8), "write")
                && byte_is(src, load32(t, (i + 2) * 20 + 4),
                           load32(t, (i + 2) * 20 + 8), "grammar")
                && load32(t, (i + 3) * 20) == 0 {
            let as_st: u32 = load32(t, (i + 3) * 20 + 4);
            let as_ln: u32 = load32(t, (i + 3) * 20 + 8);
            if byte_is(src, as_st, as_ln, "loment") || byte_is(src, as_st, as_ln, "rust") {
                return 0;
            }
            return ((as_st as u64) * 4294967296) + (as_ln as u64);
        }
        i = i + 1;
    }
    return 0;
}

/// **一条 Info，不是一屏 Error**：这份源不是 Loment 写的，这一层没有它的规则。说清楚
/// "为什么这里安静"比编一堆错有用 —— 静默会让人以为服务挂了。
fn publish_foreign(mem: ptr, text: ptr, uri: ptr, un: u32, as_st: u32, as_ln: u32) -> u32 {
    let b: ptr = out_body(mem);
    let o: u32 = BODY_OFF;
    o = json_emit_lit(b, o, "{\"jsonrpc\": \"2.0\", \"method\": \"textDocument/publishDiagnostics\", \"params\": {\"uri\": ");
    o = json_emit_str(b, o, uri, un);
    o = json_emit_lit(b, o, ", \"diagnostics\": [{\"range\": {\"start\": {\"line\": 0, \"character\": 0}, \"end\": {\"line\": 0, \"character\": 1}}, \"severity\": 3, \"source\": \"loment\", \"message\": ");
    let mb: ptr = ptr_add(mem, SCR_OFF + 6144);
    let mo: u32 = 0;
    let pre: str = "这份源写的是 ";
    let q: u32 = 0;
    while q < str_len(pre) {
        store8(mb, mo, str_byte(pre, q) as u8);
        mo = mo + 1;
        q = q + 1;
    }
    let st: u32 = as_st;
    let ln: u32 = as_ln;
    q = 0;
    while q < ln && mo < 200 {
        store8(mb, mo, load8(text, st + q) as u8);
        mo = mo + 1;
        q = q + 1;
    }
    let suf: str = " 语法 —— 语言服务只查 Loment，所以这里不报诊断；要真诊断就 `loment build`。";
    q = 0;
    while q < str_len(suf) && mo < 400 {
        store8(mb, mo, str_byte(suf, q) as u8);
        mo = mo + 1;
        q = q + 1;
    }
    o = json_emit_str(b, o, mb, mo);
    o = json_emit_lit(b, o, "}]}}");
    out_done(mem, o);
    send_pending(mem);
    return o;
}

// ---------------------------------------------------------------- 符号表

fn sym_add(mem: ptr, name: ptr, n: u32, kind: u32, line: u32, col: u32) -> u32 {
    let c: u32 = load32(mem, S_NSYM);
    if c >= SYM_MAX {
        return 0;
    }
    let e: ptr = ptr_add(mem, SYM_OFF + c * SYM_STRIDE);
    let nn: u32 = n;
    if nn > 60 {
        nn = 60;
    }
    let k: u32 = 0;
    while k < nn {
        store8(e, k, load8(name, k) as u8);
        k = k + 1;
    }
    store8(e, nn, 0 as u8);
    store32(e, 64, kind);
    store32(e, 68, line);
    // `#27`：**名字那一格**的列。跳转原先回 `{line, character: 0}` —— 编辑器只能把光标
    // 扔到行首，而声明往往缩进着。名字的长度用 `sym_len`（名字以 0 收尾），不必另存。
    store32(e, 72, col);
    store32(mem, S_NSYM, c + 1);
    return 1;
}

fn sym_name(mem: ptr, i: u32) -> ptr {
    return ptr_add(mem, SYM_OFF + i * SYM_STRIDE);
}

fn sym_len(mem: ptr, i: u32) -> u32 {
    let e: ptr = sym_name(mem, i);
    let k: u32 = 0;
    while k < 60 && load8(e, k) != 0 {
        k = k + 1;
    }
    return k;
}

fn byte_is(text: ptr, s: u32, n: u32, w: str) -> bool {
    if n != str_len(w) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(text, s + i) != str_byte(w, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn tok_is(text: ptr, toks: ptr, i: u32, one: u32) -> bool {
    if load32(toks, i * 20) != 3 {
        return false;
    }
    if load32(toks, i * 20 + 8) != 1 {
        return false;
    }
    return load8(text, load32(toks, i * 20 + 4)) == one;
}

fn decl_kind(text: ptr, s: u32, n: u32) -> u32 {
    if byte_is(text, s, n, "fn") { return 3; }
    if byte_is(text, s, n, "struct") { return 22; }
    if byte_is(text, s, n, "enum") { return 13; }
    if byte_is(text, s, n, "trait") { return 8; }
    if byte_is(text, s, n, "const") { return 21; }
    return 6;
}

fn is_decl_kw(text: ptr, s: u32, n: u32) -> bool {
    return byte_is(text, s, n, "fn") || byte_is(text, s, n, "struct")
        || byte_is(text, s, n, "enum") || byte_is(text, s, n, "trait")
        || byte_is(text, s, n, "const") || byte_is(text, s, n, "capability");
}

/// 顶层声明 + impl 方法 (折叠名) 扫描。
fn scan_syms(mem: ptr, text: ptr, toks: ptr, nt: u32) -> u32 {
    store32(mem, S_NSYM, 0);
    let i: u32 = 0;
    let depth: u32 = 0;
    let impl_ty: u32 = 0;
    let impl_depth: u32 = 0;
    while i < nt && load32(toks, i * 20) != 4 {
        let k: u32 = load32(toks, i * 20);
        let s: u32 = load32(toks, i * 20 + 4);
        let n: u32 = load32(toks, i * 20 + 8);
        let ln: u32 = load32(toks, i * 20 + 12);
        if tok_is(text, toks, i, 123) {
            depth = depth + 1;
            if impl_ty != 0 && impl_depth == 0 {
                impl_depth = depth;
            }
            i = i + 1;
        } else {
            if tok_is(text, toks, i, 125) {
                if depth > 0 {
                    depth = depth - 1;
                }
                if impl_ty != 0 && depth < impl_depth {
                    impl_ty = 0;
                    impl_depth = 0;
                }
                i = i + 1;
            } else {
                if depth == 0 && k == 0 && byte_is(text, s, n, "impl") {
                    if i + 2 < nt && load32(toks, (i + 2) * 20) == 0
                            && byte_is(text, load32(toks, (i + 2) * 20 + 4),
                                       load32(toks, (i + 2) * 20 + 8), "for") {
                        impl_ty = i + 3;
                    } else {
                        impl_ty = i + 1;
                    }
                    i = i + 1;
                } else {
                    if depth == 0 && k == 0 && byte_is(text, s, n, "trait") {
                        let h: u32 = skip_to_brace(text, toks, i + 1, nt);
                        i = skip_braces(text, toks, h, nt);
                    } else {
                        if impl_ty != 0 && depth == impl_depth && k == 0
                                && byte_is(text, s, n, "fn") {
                            add_method(mem, text, toks, i, impl_ty);
                            i = i + 1;
                        } else {
                            if depth == 0 && k == 0 && is_decl_kw(text, s, n) {
                                if i + 1 < nt {
                                    sym_add(mem, ptr_add(text, load32(toks, (i + 1) * 20 + 4)),
                                            load32(toks, (i + 1) * 20 + 8),
                                            decl_kind(text, s, n), ln,
                                            load32(toks, (i + 1) * 20 + 16));
                                }
                                i = i + 1;
                            } else {
                                i = i + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return load32(mem, S_NSYM);
}

fn add_method(mem: ptr, text: ptr, toks: ptr, i: u32, ty: u32) -> u32 {
    let buf: ptr = ptr_add(mem, SCR_OFF + 4096);
    let o: u32 = 0;
    let ts: u32 = load32(toks, ty * 20 + 4);
    let tl: u32 = load32(toks, ty * 20 + 8);
    let q: u32 = 0;
    while q < tl && q < 32 {
        store8(buf, o, load8(text, ts + q) as u8);
        o = o + 1;
        q = q + 1;
    }
    store8(buf, o, 95 as u8);
    o = o + 1;
    let ms: u32 = load32(toks, (i + 1) * 20 + 4);
    let ml: u32 = load32(toks, (i + 1) * 20 + 8);
    q = 0;
    while q < ml && o < 60 {
        store8(buf, o, load8(text, ms + q) as u8);
        o = o + 1;
        q = q + 1;
    }
    return sym_add(mem, buf, o, 3, load32(toks, (i + 1) * 20 + 12),
                   load32(toks, (i + 1) * 20 + 16));
}

fn skip_to_brace(text: ptr, toks: ptr, i: u32, nt: u32) -> u32 {
    let k: u32 = i;
    let go: u32 = 1;
    while k < nt && go == 1 {
        if load32(toks, k * 20) == 4 {
            go = 0;
        } else {
            if tok_is(text, toks, k, 123) {
                go = 0;
            } else {
                k = k + 1;
            }
        }
    }
    return k;
}

/// 从 '{' 跳到匹配 '}' 之后。
fn skip_braces(text: ptr, toks: ptr, i: u32, nt: u32) -> u32 {
    let d: u32 = 0;
    let k: u32 = i;
    let go: u32 = 1;
    while k < nt && go == 1 {
        if load32(toks, k * 20) == 4 {
            go = 0;
        } else {
            if tok_is(text, toks, k, 123) {
                d = d + 1;
            } else {
                if tok_is(text, toks, k, 125) {
                    d = d - 1;
                    if d == 0 {
                        go = 0;
                    }
                }
            }
            k = k + 1;
        }
    }
    return k;
}

// ---------------------------------------------------------------- 方法名比较

fn method_eq(src: ptr, arena: ptr, m: u32, name: str) -> bool {
    let n: u32 = json_raw_len(arena, m);
    if n != str_len(name) {
        return false;
    }
    let i: u32 = json_raw_off(arena, m);
    let q: u32 = 0;
    while q < n {
        if load8(src, i + q) != str_byte(name, q) {
            return false;
        }
        q = q + 1;
    }
    return true;
}

fn is_wordc(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn line_start(text: ptr, line: u32) -> u32 {
    let i: u32 = 0;
    let n: u32 = 0;
    let res: u32 = 0;
    let go: u32 = 1;
    while go == 1 {
        if n == line || load8(text, i) == 0 {
            res = i;
            go = 0;
        } else {
            if load8(text, i) == 10 {
                n = n + 1;
            }
            i = i + 1;
        }
    }
    return res;
}

/// 光标处的词 -> 写进 mem+SCR_OFF+5120, 返回长度。
fn word_at(mem: ptr, text: ptr, line: u32, ch: u32) -> u32 {
    let buf: ptr = ptr_add(mem, SCR_OFF + 5120);
    let lstart: u32 = line_start(text, line);
    let c: u32 = lstart + ch;
    let s: u32 = c;
    while s > lstart && is_wordc(load8(text, s - 1)) {
        s = s - 1;
    }
    let e: u32 = c;
    let go: u32 = 1;
    while go == 1 {
        if e < DOC_CAP && load8(text, e) != 0 && is_wordc(load8(text, e)) {
            e = e + 1;
        } else {
            go = 0;
        }
    }
    let n: u32 = e - s;
    let q: u32 = 0;
    while q < n && q < 60 {
        store8(buf, q, load8(text, s + q) as u8);
        q = q + 1;
    }
    store8(buf, q, 0 as u8);
    return q;
}

// ---------------------------------------------------------------- 处理


/// 取第 n 个命令行字段 (0 = 程序名)。返回 (start << 32) | len, 0 = 没有。
fn argv_n(buf: ptr, cap: u64, scr: ptr, n: u32) -> u64 {
    let fd: i64 = open_ro(str_ptr("/proc/self/cmdline"), 18, scr);
    if fd < 0 {
        return 0;
    }
    let rn: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if rn <= 0 {
        return 0;
    }
    let m: u32 = rn as u32;
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    let hit: u64 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == n {
                hit = (s as u64) * 4294967296 + ((i - s) as u64);
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    if f == n {
        hit = (s as u64) * 4294967296 + ((m - s) as u64);
    }
    return hit;
}

fn open_ro(p: ptr, n: u32, scr: ptr) -> i64 {
    let i: u32 = 0;
    while i < n && i < 4000 {
        store8(scr, i, load8(p, i) as u8);
        i = i + 1;
    }
    store8(scr, i, 0 as u8);
    return syscall4(257, (0 as u64) - 100, scr as u64, 0);
}

fn arg_is(buf: ptr, av: u64, lit: str) -> bool {
    let s: u32 = (av >> 32) as u32;
    let n: u32 = (av % 4294967296) as u32;
    if n != str_len(lit) {
        return false;
    }
    return byte_is(buf, s, n, lit);
}

fn dec_into(b: ptr, o: u32, v: u32) -> u32 {
    let tmp: ptr = ptr_add(b, 4096);
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(b, o, 48 as u8);
        return o + 1;
    }
    while x > 0 {
        store8(tmp, d, (48 + x % 10) as u8);
        x = x / 10;
        d = d + 1;
    }
    let q: u32 = 0;
    while q < d {
        store8(b, o + q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    return o + d;
}

/// 就地去掉 CRLF 的 CR, 返回新长度。
fn strip_in_place(buf: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let o: u32 = 0;
    while i < n {
        let c: u32 = load8(buf, i);
        if c == 13 && i + 1 < n && load8(buf, i + 1) == 10 {
            i = i + 1;
        } else {
            store8(buf, o, c as u8);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

/// `lsp --check FILE`: 诊断按 `路径:行:列: E0NN 标题` 打到 stdout (编辑器任务可解析)。
/// 退出码: 0 = 无诊断 / 1 = 有诊断 / 2 = 用法或读取错误。
fn check_main(mem: ptr, argv: ptr, av: u64, src: ptr, toks: ptr, errs: ptr,
              chk: ptr) -> u32 {
    let s: u32 = (av >> 32) as u32;
    let n: u32 = (av % 4294967296) as u32;
    if n == 0 || n > 4000 {
        return 2;
    }
    let tb: ptr = ptr_add(mem, SCR_OFF);
    let fd: i64 = open_ro(ptr_add(argv, s), n, tb);
    if fd < 0 {
        return 2;
    }
    let raw: i64 = syscall4(0, fd as u64, src as u64, (DOC_CAP - 16) as u64);
    syscall4(3, fd as u64, 0, 0);
    if raw <= 0 {
        return 2;
    }
    let tn: u32 = strip_in_place(src, raw as u32);
    let nt: u32 = lex(src, tn, toks);
    let nt: u32 = switchify(mem, src, toks, nt);
    let ne: u32 = run_check(src, toks, errs, chk);
    let ob: ptr = ptr_add(mem, OUT_OFF);
    let i: u32 = 0;
    let last_code: u32 = 0;
    let last_tk: u32 = 4294967295;
    while i < ne && i < 64 {
        let code: u32 = load32(errs, i * 8);
        let tk: u32 = load32(errs, i * 8 + 4);
        // checker 对同一处可能报多条同类码 (如"未声明函数"+"类型未知"都是 E002):
        // 命令行输出里相邻的 (码, token) 去重 —— 编辑器看一个就够了
        if code == last_code && tk == last_tk {
            i = i + 1;
        } else {
        last_code = code;
        last_tk = tk;
        let line: u32 = load32(toks, tk * 20 + 12);
        let col: u32 = load32(toks, tk * 20 + 16);
        let o: u32 = copy_span(ob, 0, argv, s, n);
        store8(ob, o, 58 as u8);
        o = o + 1;
        o = dec_into(ob, o, line);
        store8(ob, o, 58 as u8);
        o = o + 1;
        o = dec_into(ob, o, col);
        o = json_emit_lit(ob, o, ": E");
        o = emit_e0(ob, o, code);
        store8(ob, o, 32 as u8);
        o = o + 1;
        let ttl: str = diag_title(code);
        let q: u32 = 0;
        while q < str_len(ttl) {
            store8(ob, o, str_byte(ttl, q) as u8);
            o = o + 1;
            q = q + 1;
        }
        store8(ob, o, 10 as u8);
        o = o + 1;
        wr_all(1, ob, o);
        i = i + 1;
        }
    }
    if ne == 0 {
        return 0;
    }
    return 1;
}

fn _start() -> u32 {
    let memv: u64 = sys_alloc(MEM_CAP as u64);
    let inv: u64 = sys_alloc(IN_CAP as u64);
    let tokv: u64 = sys_alloc((DOC_CAP as u64) * 20 + TOK_EXTRA as u64);
    let arenav: u64 = sys_alloc(ARENA_CAP as u64);
    let chkv: u64 = sys_alloc(chk_arena_bytes() as u64 + 4096);
    let errv: u64 = sys_alloc(4096);
    let srcv: u64 = sys_alloc(DOC_CAP as u64);       // --check 的源缓冲
    if memv == 0 || inv == 0 || tokv == 0 || arenav == 0 || chkv == 0 || errv == 0
            || srcv == 0 {
        return die(1);
    }
    let mem: ptr = memv as ptr;
    let inb: ptr = inv as ptr;
    let toks: ptr = tokv as ptr;
    let arena: ptr = arenav as ptr;
    let chk: ptr = chkv as ptr;
    let errs: ptr = errv as ptr;
    let srcb: ptr = srcv as ptr;
    store32(mem, S_NDOC, 0);
    store32(mem, S_NSYM, 0);
    store32(mem, S_NERR, 0);
    let hdr: ptr = ptr_add(mem, SCR_OFF);
    // 命令行模式: `lsp --check FILE` -> 跑检查、按 `路径:行:列: E0NN 标题` 打诊断、退出。
    // (编辑器任务/CI 用; 与 LSP 循环共用同一套 checker 与文案表)
    let a1: u64 = argv_n(inb, IN_CAP as u64, hdr, 1);
    if arg_is(inb, a1, "--check") {
        let a2: u64 = argv_n(inb, IN_CAP as u64, hdr, 2);
        // argv 在 inb 里, 源文件必须读进**另一块**缓冲 (否则路径被文件内容覆盖)
        return die(check_main(mem, inb, a2, srcb, toks, errs, chk) as u64);
    }
    let go: u32 = 1;
    while go == 1 {
        let n: u32 = read_msg(inb, IN_CAP, hdr);
        if n == 0 {
            go = 0;
        } else {
            let root: u32 = json_parse(inb, n, arena);
            if root == 4294967295 {
                go = 0;
            } else {
                let m: u32 = json_get(inb, arena, root, "method");
                if m != 4294967295 {
                    let id: u32 = json_get(inb, arena, root, "id");
                    handle(mem, inb, arena, root, m, id, toks, chk, errs);
                    if method_eq(inb, arena, m, "exit") {
                        go = 0;
                    }
                }
            }
        }
    }
    return die(0);
}

fn handle(mem: ptr, src: ptr, arena: ptr, root: u32, m: u32, id: u32,
          toks: ptr, chk: ptr, errs: ptr) -> u32 {
    let b: ptr = out_body(mem);
    if method_eq(src, arena, m, "initialize") {
        let o: u32 = resp_prefix(mem, src, arena, id);
        // `completionProvider: {}` = 支持补全、但**没有触发字符**（`#28`：原先登着 `.` 与 `:`，
        // 而补全不看位置 —— 每敲一个点就弹一屏关键字。两处实现一起改：`tools/loment_lsp.py`）
        let o2: u32 = json_emit_lit(b, o, "{\"capabilities\": {\"textDocumentSync\": 1, \"definitionProvider\": true, \"completionProvider\": {}}, \"serverInfo\": {\"name\": \"loment-lsp\", \"version\": \"0.3\"}}");
        // 注意: 上面这段以 `"0.3"}}` 收尾 = 关掉 serverInfo 与 result; **外层对象还要一个 `}`**
        let o2b: u32 = json_emit_lit(b, o2, "}");
        out_done(mem, o2b);
        send_pending(mem);
        return 0;
    }
    if method_eq(src, arena, m, "shutdown") {
        let o3: u32 = resp_prefix(mem, src, arena, id);
        let o4: u32 = json_emit_lit(b, o3, "null}");
        out_done(mem, o4);
        send_pending(mem);
        return 0;
    }
    if method_eq(src, arena, m, "initialized") || method_eq(src, arena, m, "exit") {
        return 0;
    }
    if method_eq(src, arena, m, "textDocument/didOpen")
            || method_eq(src, arena, m, "textDocument/didChange")
            || method_eq(src, arena, m, "textDocument/didSave") {
        return on_change(mem, src, arena, root, toks, chk, errs);
    }
    if method_eq(src, arena, m, "textDocument/completion") {
        return on_completion(mem, src, arena, root, id, toks);
    }
    if method_eq(src, arena, m, "textDocument/definition") {
        return on_definition(mem, src, arena, root, id, toks);
    }
    if id != 4294967295 {
        let o5: u32 = resp_prefix(mem, src, arena, id);
        let o6: u32 = json_emit_lit(b, o5, "null}");
        out_done(mem, o6);
        send_pending(mem);
    }
    return 0;
}

/// 取 params.textDocument.uri -> mem+SCR_OFF+2048, 返回长度。
fn take_uri(mem: ptr, src: ptr, arena: ptr, root: u32) -> u32 {
    let params: u32 = json_get(src, arena, root, "params");
    if params == 4294967295 {
        return 0;
    }
    let td: u32 = json_get(src, arena, params, "textDocument");
    if td == 4294967295 {
        return 0;
    }
    let u: u32 = json_get(src, arena, td, "uri");
    if u == 4294967295 {
        return 0;
    }
    return json_str_into(src, arena, u, ptr_add(mem, SCR_OFF + 2048), URI_CAP - 16);
}

fn on_change(mem: ptr, src: ptr, arena: ptr, root: u32, toks: ptr, chk: ptr,
             errs: ptr) -> u32 {
    let params: u32 = json_get(src, arena, root, "params");
    if params == 4294967295 {
        return 0;
    }
    let td: u32 = json_get(src, arena, params, "textDocument");
    if td == 4294967295 {
        return 0;
    }
    let un: u32 = take_uri(mem, src, arena, root);
    let ubuf: ptr = ptr_add(mem, SCR_OFF + 2048);
    let tbuf: ptr = ptr_add(mem, SCR_OFF + 3072);
    let cap: u32 = 200000;
    let tn: u32 = 0;
    let tx1: u32 = json_get(src, arena, td, "text");
    if tx1 != 4294967295 {
        tn = json_str_into(src, arena, tx1, tbuf, cap);
    } else {
        let arr: u32 = json_get(src, arena, params, "contentChanges");
        if arr != 4294967295 {
            let e: u32 = json_first_child(arena, arr);
            let last: u32 = e;
            while e != 0 {
                last = e;
                e = json_sibling(arena, e);
            }
            // contentChanges 是数组, 每个元素是**对象** {range?, text} —— 取它的 text 字段
            if last != 0 {
                let tx2: u32 = json_get(src, arena, last, "text");
                if tx2 != 4294967295 {
                    tn = json_str_into(src, arena, tx2, tbuf, cap);
                }
            }
        }
    }
    let idx: u32 = doc_put(mem, ubuf, un, tbuf, tn);
    let text: ptr = doc_text(mem, idx);
    let tn2: u32 = doc_txtlen(mem, idx);
    let nt: u32 = lex(text, tn2, toks);
    // `#262`：声明了**非原生**语法就先别查 —— 用 Loment 的规则读别的语言，报出来全是假错。
    // **必须在 `switchify` 之前**：`apply_switches` 会把 `choose write grammar …` 那一行
    // 当开关声明吃掉，之后 token 流里就找不到它了（下标也会整体移位）。
    let fg: u64 = lsc_foreign(text, toks, nt);
    let nt: u32 = switchify(mem, text, toks, nt);
    if fg != 0 {
        store32(mem, S_NERR, 0);
        scan_syms(mem, text, toks, nt);
        return publish_foreign(mem, text, ubuf, un,
                               (fg / 4294967296) as u32, (fg % 4294967296) as u32);
    }
    let ne: u32 = run_check(text, toks, errs, chk);
    store32(mem, S_NERR, ne);
    scan_syms(mem, text, toks, nt);
    return publish(mem, toks, ubuf, un, errs, ne);
}

fn on_completion(mem: ptr, src: ptr, arena: ptr, root: u32, id: u32, toks: ptr) -> u32 {
    let un: u32 = take_uri(mem, src, arena, root);
    let ubuf: ptr = ptr_add(mem, SCR_OFF + 2048);
    let idx: u32 = doc_find(mem, ubuf, un);
    let b: ptr = out_body(mem);
    let o: u32 = resp_prefix(mem, src, arena, id);
    // `#28`：`p.` 之后要给 `Point` 的**字段**，不是一屏关键字。算不出类型就原样走通用补全 ——
    // 覆盖了 `b` 里已经写下的那一段（`o` 之后重写即可）。
    if idx != 4294967295 {
        let params: u32 = json_get(src, arena, root, "params");
        let pos: u32 = json_get(src, arena, params, "position");
        let ln: u32 = json_as_u32(src, arena, json_get(src, arena, pos, "line"));
        let ch: u32 = json_as_u32(src, arena, json_get(src, arena, pos, "character"));
        let text: ptr = doc_text(mem, idx);
        let tn: u32 = doc_txtlen(mem, idx);
        let rc: u64 = lsc_member_recv(text, ln, ch);
        if rc != 0 {
            let nt: u32 = lex(text, tn, toks);
            let nt: u32 = switchify(mem, text, toks, nt);
            let tp: u64 = lsc_local_type(text, toks, nt, (rc / 4294967296) as u32,
                                         (rc % 4294967296) as u32, ln + 1);
            if tp != 0 {
                let o2: u32 = json_emit_lit(b, o, "{\"isIncomplete\": false, \"items\": [");
                let o3: u32 = lsc_emit_fields(mem, text, toks, nt, (tp / 4294967296) as u32,
                                              (tp % 4294967296) as u32, o2);
                if o3 != 4294967295 {
                    let o4: u32 = json_emit_lit(b, o3, "]}}");
                    out_done(mem, o4);
                    send_pending(mem);
                    return 0;
                }
            }
        }
    }
    let o2: u32 = json_emit_lit(b, o, "{\"isIncomplete\": false, \"items\": [");
    let o3: u32 = emit_words(mem, o2);
    let o4: u32 = emit_syms(mem, o3, idx, toks);
    let o5: u32 = json_emit_lit(b, o4, "]}}");
    out_done(mem, o5);
    send_pending(mem);
    return 0;
}

fn kw_at(i: u32) -> str {
    if i == 0 { return "fn"; }
    if i == 1 { return "let"; }
    if i == 2 { return "if"; }
    if i == 3 { return "else"; }
    if i == 4 { return "while"; }
    if i == 5 { return "for"; }
    if i == 6 { return "in"; }
    if i == 7 { return "match"; }
    if i == 8 { return "struct"; }
    if i == 9 { return "enum"; }
    if i == 10 { return "trait"; }
    if i == 11 { return "impl"; }
    if i == 12 { return "const"; }
    if i == 13 { return "return"; }
    if i == 14 { return "mut"; }
    if i == 15 { return "pub"; }
    if i == 16 { return "use"; }
    if i == 17 { return "module"; }
    if i == 18 { return "capability"; }
    if i == 19 { return "guard"; }
    if i == 20 { return "excluded"; }
    if i == 21 { return "interrupt"; }
    if i == 22 { return "as"; }
    if i == 23 { return "register"; }
    return "as";
}

fn ty_at(i: u32) -> str {
    if i == 0 { return "u8"; }
    if i == 1 { return "u16"; }
    if i == 2 { return "u32"; }
    if i == 3 { return "u64"; }
    if i == 4 { return "i8"; }
    if i == 5 { return "i16"; }
    if i == 6 { return "i32"; }
    if i == 7 { return "i64"; }
    if i == 8 { return "bool"; }
    if i == 9 { return "str"; }
    if i == 10 { return "ptr"; }
    if i == 11 { return "()"; }
    if i == 12 { return "Option"; }
    return "Result";
}

/// 关键字 (kind 14) + 类型词 (kind 6)。
fn emit_words(mem: ptr, o: u32) -> u32 {
    let b: ptr = out_body(mem);
    let o2: u32 = o;
    let i: u32 = 0;
    while i < 24 {
        if i > 0 {
            o2 = json_emit_lit(b, o2, ", ");
        }
        o2 = json_emit_lit(b, o2, "{\"label\": ");
        o2 = json_emit_str(b, o2, str_ptr(kw_at(i)), str_len(kw_at(i)));
        o2 = json_emit_lit(b, o2, ", \"kind\": 14}");
        i = i + 1;
    }
    i = 0;
    while i < 14 {
        o2 = json_emit_lit(b, o2, ", {\"label\": ");
        o2 = json_emit_str(b, o2, str_ptr(ty_at(i)), str_len(ty_at(i)));
        o2 = json_emit_lit(b, o2, ", \"kind\": 6}");
        i = i + 1;
    }
    return o2;
}

fn emit_syms(mem: ptr, o: u32, idx: u32, toks: ptr) -> u32 {
    let b: ptr = out_body(mem);
    if idx == 4294967295 {
        return o;
    }
    let text: ptr = doc_text(mem, idx);
    let tn: u32 = doc_txtlen(mem, idx);
    let nt: u32 = lex(text, tn, toks);
    let nt: u32 = switchify(mem, text, toks, nt);
    let ns: u32 = scan_syms(mem, text, toks, nt);
    let o2: u32 = o;
    let i: u32 = 0;
    while i < ns {
        let np: ptr = sym_name(mem, i);
        o2 = json_emit_lit(b, o2, ", {\"label\": ");
        o2 = json_emit_str(b, o2, np, sym_len(mem, i));
        o2 = json_emit_lit(b, o2, ", \"kind\": ");
        o2 = json_emit_u32(b, o2, load32(np, 64));
        o2 = json_emit_lit(b, o2, "}");
        i = i + 1;
    }
    return o2;
}

// ---------------------------------------------------------------- 成员补全（`#28`）

/// 光标前是不是 `recv.` —— 是就返回 `recv` 的跨度 `(起点<<32)|长度`，否则 0。
///
/// 认 `p.` 与 `p.x` 的前半截；`p[i].` / `a.b.` 不追（回 0 就走通用补全）。
/// **宁可少给，不给错的** —— 补错一项比少补一项更打扰人。
fn lsc_member_recv(text: ptr, line: u32, ch: u32) -> u64 {
    let lstart: u32 = line_start(text, line);
    let c: u32 = lstart + ch;
    let e: u32 = c;
    while e > lstart && is_wordc(load8(text, e - 1)) {
        e = e - 1;
    }
    if e == 0 || load8(text, e - 1) != 46 {
        return 0;
    }
    let s: u32 = e - 1;
    let st: u32 = s;
    while st > lstart && is_wordc(load8(text, st - 1)) {
        st = st - 1;
    }
    if st == s {
        return 0;
    }
    return ((st as u64) * 4294967296) + ((s - st) as u64);
}

/// `recv` 在**光标之前**被声明成什么类型（`let x: T` 或形参 `x: T`）—— 返回类型名的跨度。
///
/// 取**最后**一处：光标在后面的函数里时，那一处通常就在同一个函数体里。这一层**不做**
/// 作用域分析（真正的块作用域是 `#364` 的事）—— 名字在两处都出现时会取靠后那处。
fn lsc_local_type(text: ptr, toks: ptr, nt: u32, rs: u32, rl: u32, line: u32) -> u64 {
    let best: u64 = 0;
    let i: u32 = 2;
    while i + 2 < nt {
        if load32(toks, i * 20) == 0
                && load32(toks, i * 20 + 8) == rl
                && same_bytes(ptr_add(text, load32(toks, i * 20 + 4)), ptr_add(text, rs), rl)
                && byte_is(text, load32(toks, (i + 1) * 20 + 4),
                           load32(toks, (i + 1) * 20 + 8), ":")
                && load32(toks, (i + 2) * 20) == 0
                && load32(toks, i * 20 + 12) < line {
            // 前面必须是 `let` / `(` / `,` —— 否则 `struct S { x: u32 }` 那种字段声明
            // 也会被当成"变量 x 的类型"，然后在别处补出它自己的字段（指错地方）。
            if byte_is(text, load32(toks, (i - 1) * 20 + 4),
                       load32(toks, (i - 1) * 20 + 8), "let")
                    || byte_is(text, load32(toks, (i - 1) * 20 + 4),
                               load32(toks, (i - 1) * 20 + 8), "(")
                    || byte_is(text, load32(toks, (i - 1) * 20 + 4),
                               load32(toks, (i - 1) * 20 + 8), ",") {
                best = ((load32(toks, (i + 2) * 20 + 4) as u64) * 4294967296)
                       + (load32(toks, (i + 2) * 20 + 8) as u64);
            }
        }
        i = i + 1;
    }
    return best;
}

/// `struct <名字>` 的字段做成补全项，追加到 `o`；**这个名字不是 struct** 就返回
/// 4294967295（调用方据此回退到通用补全）。
fn lsc_emit_fields(mem: ptr, text: ptr, toks: ptr, nt: u32, ns: u32, nl: u32,
                   o: u32) -> u32 {
    let b: ptr = out_body(mem);
    let i: u32 = 0;
    let body: u32 = 4294967295;
    while i + 2 < nt {
        if byte_is(text, load32(toks, i * 20 + 4), load32(toks, i * 20 + 8), "struct")
                && load32(toks, (i + 1) * 20) == 0
                && load32(toks, (i + 1) * 20 + 8) == nl
                && same_bytes(ptr_add(text, load32(toks, (i + 1) * 20 + 4)),
                              ptr_add(text, ns), nl) {
            body = i + 2;
            i = nt;
        } else {
            i = i + 1;
        }
    }
    if body == 4294967295 {
        return 4294967295;
    }
    // `{` 之后是 `字段 : 类型 ,` 的重复
    let j: u32 = body + 1;
    let first: u32 = 1;
    let o2: u32 = o;
    while j + 2 < nt && !byte_is(text, load32(toks, j * 20 + 4),
                                 load32(toks, j * 20 + 8), "}") {
        if load32(toks, j * 20) == 0
                && byte_is(text, load32(toks, (j + 1) * 20 + 4),
                           load32(toks, (j + 1) * 20 + 8), ":") {
            if first == 0 {
                o2 = json_emit_lit(b, o2, ", ");
            }
            first = 0;
            o2 = json_emit_lit(b, o2, "{\"label\": ");
            o2 = json_emit_str(b, o2, ptr_add(text, load32(toks, j * 20 + 4)),
                               load32(toks, j * 20 + 8));
            o2 = json_emit_lit(b, o2, ", \"kind\": 5}");
            j = j + 3;
        } else {
            j = j + 1;
        }
    }
    return o2;
}

fn on_definition(mem: ptr, src: ptr, arena: ptr, root: u32, id: u32, toks: ptr) -> u32 {
    let un: u32 = take_uri(mem, src, arena, root);
    let ubuf: ptr = ptr_add(mem, SCR_OFF + 2048);
    let idx: u32 = doc_find(mem, ubuf, un);
    let b: ptr = out_body(mem);
    let o: u32 = resp_prefix(mem, src, arena, id);
    if idx == 4294967295 {
        let o0: u32 = json_emit_lit(b, o, "null}");
        out_done(mem, o0);
        send_pending(mem);
        return 0;
    }
    let params: u32 = json_get(src, arena, root, "params");
    let pos: u32 = json_get(src, arena, params, "position");
    let line: u32 = json_as_u32(src, arena, json_get(src, arena, pos, "line"));
    let ch: u32 = json_as_u32(src, arena, json_get(src, arena, pos, "character"));
    let text: ptr = doc_text(mem, idx);
    let wl: u32 = word_at(mem, text, line, ch);
    let wbuf: ptr = ptr_add(mem, SCR_OFF + 5120);
    let tn: u32 = doc_txtlen(mem, idx);
    let nt: u32 = lex(text, tn, toks);
    let nt: u32 = switchify(mem, text, toks, nt);
    let ns: u32 = scan_syms(mem, text, toks, nt);
    let hit: u32 = 4294967295;
    let i: u32 = 0;
    while i < ns {
        if sym_len(mem, i) == wl && same_bytes(sym_name(mem, i), wbuf, wl) {
            hit = i;
        }
        i = i + 1;
    }
    if hit == 4294967295 {
        let o1: u32 = json_emit_lit(b, o, "null}");
        out_done(mem, o1);
        send_pending(mem);
        return 0;
    }
    let hl: u32 = load32(sym_name(mem, hit), 68) - 1;
    // `#27`：范围 = **声明里那个名字**本身，不是那一整行。列与长度都从符号记录里拿 ——
    // 名字以 0 收尾，所以长度走 `sym_len`，不必另存一份。
    let hc: u32 = load32(sym_name(mem, hit), 72);
    let hs: u32 = 0;
    if hc > 0 {
        hs = hc - 1;
    }
    let he: u32 = hs + sym_len(mem, hit);
    let o2: u32 = json_emit_lit(b, o, "{\"uri\": ");
    let o3: u32 = json_emit_str(b, o2, ubuf, un);
    let o4: u32 = json_emit_lit(b, o3, ", \"range\": {\"start\": {\"line\": ");
    let o5: u32 = json_emit_u32(b, o4, hl);
    let o6: u32 = json_emit_lit(b, o5, ", \"character\": ");
    let o6b: u32 = json_emit_u32(b, o6, hs);
    let o7: u32 = json_emit_lit(b, o6b, "}, \"end\": {\"line\": ");
    let o8: u32 = json_emit_u32(b, o7, hl);
    let o9: u32 = json_emit_lit(b, o8, ", \"character\": ");
    let o10: u32 = json_emit_u32(b, o9, he);
    let o11: u32 = json_emit_lit(b, o10, "}}}}");
    out_done(mem, o11);
    send_pending(mem);
    return 0;
}
