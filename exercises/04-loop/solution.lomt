module ex

choose runtime

use num

fn print_dec(v: u32) {
    let b: ptr = alloc(16);
    let n: u32 = num_to_dec(b, v);
    syscall4(1, 1, b as u64, n as u64);
}

fn print_nl() {
    syscall4(1, 1, str_ptr("
") as u64, str_len("
") as u64);
}

fn sum_to(n: u32) -> u32 {
    let acc: u32 = 0;
    let i: u32 = 1;
    while i <= n {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn _start() {
    print_dec(sum_to(6));
    print_nl();
    syscall4(60, 0, 0, 0);
}
