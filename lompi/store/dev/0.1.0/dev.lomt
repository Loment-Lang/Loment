// dev/dev.lomt — 包入口（门面）。
//
// 领域库各自成包，`std` 只留可移植核心。按模块取用 `use <module>`（包内模块按名字
// 可达，docs/199 §2）；这个门面只给"我确实全都要"的场合，会把整包拉进同一个单元。
module dev
choose runtime

use "semver.lomt"
use "semrange.lomt"
use "spdx.lomt"
use "args.lomt"
use "patch.lomt"
use "jsonptr.lomt"
use "shellwords.lomt"
use "dotenv.lomt"
use "template.lomt"
use "commit.lomt"
use "changelog.lomt"
use "duration.lomt"
use "gitignore.lomt"
use "target.lomt"
