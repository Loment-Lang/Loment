    if k == 346 { return "Official commands win; a same-named file on PATH never runs."; }
    if k == 347 { return "启动器官方优先，PATH 上的同名文件顶不掉它 —— 注册上去也永远跑不到。"; }
    if k == 348 { return "The launcher maps `loment <name>` to a file `loment-<name>`, so the name is constrained."; }
    if k == 349 { return "启动器按文件名找命令（`loment <名>` → `loment-<名>`），所以名字有字符与长度限制。"; }
    if k == 350 { return "There is exactly one process entry; declaring a command makes the toolchain generate it."; }
    if k == 351 { return "进程入口只能有一个：声明了命令就由工具链生成入口。"; }
    if k == 352 { return "The generated entry calls `command_main`; without it the failure only shows at link time."; }
    if k == 353 { return "工具链生成的入口要调 `command_main`，没有它只能等到链接才报错。"; }
    if k == 354 { return "The function is never called; that is a silent no-op."; }
    if k == 355 { return "这个函数不会被调用 —— 静默失效的那种。"; }
    if k == 356 { return "The entry must be `fn command_main(argv: ptr, argc: u32) -> u32`."; }
    if k == 357 { return "入口固定是 `fn command_main(argv: ptr, argc: u32) -> u32`。"; }
    if k == 358 { return "A function with a return type must `return` on every path; the missing path hits an illegal instruction."; }
    if k == 359 { return "有返回类型的函数，每条路径都必须 `return`；少了的那条会走到非法指令。"; }
    if k == 360 { return "The array length is a compile-time constant and this index is known to exceed it."; }
    if k == 361 { return "数组长度是编译期常量，而这个下标已知越界。"; }
    if k == 362 { return "The block went back to the allocator; using `p` again is a use-after-free."; }
    if k == 363 { return "这块内存已经还回分配器，再用 `p` 就是 use-after-free。"; }
    if k == 364 { return "The field's type is neither a builtin type nor a struct/enum declared here."; }
    if k == 365 { return "字段声明里写的类型名不在语言的类型表里，也不是本单元声明的结构体/枚举。"; }
    if k == 366 { return "The payload type is neither builtin nor declared in this unit."; }
    if k == 367 { return "变体载荷写的类型名既不是内置类型，也不是本单元声明的类型。"; }
    if k == 368 { return "The return type name is not in the type table."; }
    if k == 369 { return "返回类型名不在类型表里。"; }
    if k == 370 { return "The parameter's type name is not in the type table."; }
    if k == 371 { return "形参写的类型名不在类型表里。"; }
    if k == 372 { return "The `T` in `let x: T = ...` is not in the type table."; }
    if k == 373 { return "`let x: T = …` 里的 `T` 不在类型表里。"; }
    if k == 374 { return "`no_runtime` is a guarantee that the runtime is absent; this level needs it."; }
    if k == 375 { return "`no_runtime` 是保证：产物里不许出现那段运行期；这一级需要它。"; }
    if k == 376 { return "Division, `alloc` and friends drag the runtime in; a library must declare that need."; }
    if k == 377 { return "除法、`alloc` 这类构造会把运行期拖进产物；库该把这个需要写成声明。"; }
    if k == 378 { return "`no_gc` means the artifact has no collector; both cannot hold."; }
    if k == 379 { return "`no_gc` 的定义就是「产物里没有收集器」，两者不能同时成立。"; }
    if k == 380 { return "This access has no capability domain, no `guard`, no type support and no assumption."; }
    if k == 381 { return "这次访问既没有能力域、没有 `guard`、没有类型支撑，也没有人标的假设。"; }
    if k == 382 { return "A kind found by the survey is not in the ledger's registry; this is the auditor's own inconsistency."; }
    if k == 383 { return "普查枚举出的种类不在台账的登记表里 —— 这是审计器自己的不一致。"; }
    if k == 384 { return "`lifetime_auto` promises zero annotations; writing `&a T` means you want the manual tier."; }
    if k == 385 { return "`lifetime_auto` 的承诺就是零标注；写了 `&a T` 反而说明你要手动档。"; }
    if k == 386 { return "The `a` in `&a T` must be one of the signature's reference parameters."; }
    if k == 387 { return "`&a T` 里的 `a` 必须是签名里的一个引用形参名。"; }
    if k == 388 { return "A region binds only to `&T` / `&mut T` / slice parameters; this one is by value."; }
    if k == 389 { return "标记只能绑到 `&T` / `&mut T` / 切片形参；这个名字的形参是值类型。"; }
    if k == 390 { return "The borrow's region must be inside the release point; it is still alive here."; }
    if k == 391 { return "借用的区域必须包在释放点之内；这里借用还活着就 `free` 了。"; }
    if k == 392 { return "Region inference needs an input: a function returning a borrow needs a reference parameter."; }
    if k == 393 { return "区域推断要有一个输入：函数返回借用时，签名里必须有一个引用形参。"; }
    if k == 394 { return "A `borrow` domain is read-only by definition; writing breaks its premise."; }
    if k == 395 { return "`borrow` 域的语义就是把这段当只读看；写它就违背了这次借用的前提。"; }
    if k == 396 { return "The domain has not ended and the borrow is alive; free after the domain."; }
    if k == 397 { return "域还没结束，借用还活着；`free` 要等域走完。"; }
    if k == 398 { return "An exclusive domain already holds the only mutable access; another borrow aliases it."; }
    if k == 399 { return "独占域已经拿走了唯一一份可变访问；再借一个就是别名。"; }
    if k == 400 { return "A shared domain already holds a shared borrow; a `&mut` would alias it."; }
    if k == 401 { return "共享域里已经有只读借用了，再来一个 `&mut` 就是别名。"; }
    if k == 402 { return "A cursor-domain borrow lives one round; storing it outlives that."; }
    if k == 403 { return "游标域的借用只活一轮，存进局部变量就活得比它久了。"; }
    if k == 404 { return "The value is already lent to the domain; using it here overlaps that borrow."; }
    if k == 405 { return "这个值已经借给域了，块内直接用它就与那次借用重叠。"; }
    if k == 406 { return "When an epoch domain ends all its borrows die together; carrying one out means using a dead reference."; }
    if k == 407 { return "epoch 域结束时整批借用一起失效，带出去就等于用一个已经失效的引用。"; }
    if k == 408 { return "A session hands over once; a second hand-over has no meaning."; }
    if k == 409 { return "一次会话只交一次手；第二次移交没有语义。"; }
    if k == 410 { return "Ownership went to the session's other end; it cannot be used locally."; }
    if k == 411 { return "这个值的所有权已经交给了会话的另一端，本地不能再用。"; }
    if k == 412 { return "Handing the value out (returning it, storing it in shared state) must happen inside a seal domain."; }
    if k == 413 { return "把值交给外部（返回、写进共享结构）必须在封印域之内。"; }
    if k == 414 { return "`split` divides a range into two halves that must not overlap; these do."; }
    if k == 415 { return "`split` 把一段分成两半，两半必须互斥；这里两个区间有交集。"; }
    if k == 416 { return "The unit declares `no_runtime` (no runtime in the artifact) but uses division, `alloc` and friends, which only work with the runtime."; }
    if k == 417 { return "这份程序声明了 `no_runtime`（产物里不许有运行期），却用了除法、`alloc` 这类要靠运行期才成立的构造。"; }
    if k == 418 { return "The argument to `str_num` is not an integer; there is no string, boolean or pointer form."; }
    if k == 419 { return "`str_num` 的实参不是整型 —— 它没有字符串、布尔或指针的重载。"; }
    if k == 420 { return "Function values, closures and indirect calls change the static call-graph premise (`docs/208`); the default `no_fp` products still contain only direct edges."; }
    if k == 421 { return "函数值、闭包与间接调用会改变**静态调用图**这条前提（`docs/208`）：默认档（`no_fp`）的产物仍然只含直接调用边。"; }
    if k == 422 { return "`extern fn` uses the platform ABI; the language's function type is the internal calling convention. They are not interchangeable (`docs/341`)."; }
    if k == 423 { return "`extern fn` 走**平台 ABI**；本语言的函数类型是内部调用约定，两者不能互相顶替（`docs/341`）。"; }
    if k == 424 { return "A closure record stores each capture in one 8-byte word; v1 accepts only word-sized captures (integers, `bool`, `ptr`)."; }
    if k == 425 { return "闭包记录按 8 字节一格存捕获；v1 只收整型 / `bool` / `ptr` 这类能放进一格的类型。"; }
    if k == 426 { return "A closure learns its parameter types either from annotations (`(x: T) => …`) or from the expected type (the `let` annotation, an argument position, a return). With neither, the type is undetermined."; }
    if k == 427 { return "闭包只有两种途径得到形参类型：写在参数上（`(x: T) => …`），或从**期望类型**（`let` 的标注、实参位置、返回位置）推。两处都没有就定不出来。"; }
    if k == 428 { return "A by-reference capture stores an address; that address points into the callee's frame and dies when the function returns -- a dangling borrow."; }
    if k == 429 { return "按借捕获存的是**地址**；那个地址指向调用者的栈帧，函数一返回就失效。这正是一个悬垂借用（`docs/299` / `docs/341`）。"; }
    if k == 430 { return "The `T` in `(x: T) => ...` is not in the type table, same rule as a `let` annotation."; }
    if k == 431 { return "`(x: T) => …` 里的 `T` 不在类型表里 —— 与 `let` 的标注是同一条规则。"; }
    if k == 1800 { return "A process in the toolchain died **before it could write a structured diagnostic** - killed by a signal, or exited abnormally, with no record in `--diag-out`."; }
    if k == 1801 { return "工具链里的一个进程在**能写出结构化诊断之前**就死了 —— 被信号打死，或者以异常状态退出，而 `--diag-out` 一份记录都没写。"; }
    if k == 1998 { return "The compiler reported an error that is not in the classification table -- even the toolchain did not recognise which code this message belongs to."; }
    if k == 1999 { return "编译器报了一条错，而分类表里没有它 —— 连工具链自己都没认出这条消息属于哪个码。"; }
    return "";
}

pub fn code_why(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "Loment has **no implicit numeric conversion** and no type inference: every position must match explicitly. A `u32` value never becomes an `i64` on its own, and the integer `1` is not the `bool` `true`."; }
    if k == 3 { return "Loment **没有隐式数值转换**，也没有类型推断：每个位置上的类型必须显式对得上。所以 `u32` 的值不会自动变成 `i64`，整数 `1` 也不是 `bool` 的 `true`。"; }
    if k == 4 { return "This is the one beginners hit most, and in Loment it is almost always the same thing: **there is no type inference** - `let x = 1;` is a syntax error and you must write `let x: u32 = 1;`. Next comes defining after use inside one module, and then a cross-module name that needs `pub` on the declaration and `use` at the call site."; }
    if k == 5 { return "这是**新手撞得最多**的一条，而它在 Loment 里几乎总是同一件事：**没有类型推断** —— `let x = 1;` 是语法错，必须 `let x: u32 = 1;`。其次是**先定义后使用**（同一模块内），以及跨模块要 `pub` 导出 + `use` 导入。"; }
    if k == 6 { return "A function takes at most **10** parameters. A method's `self` does **not** count as an argument. Loment has no default arguments, no variadics and no overloading - a different name is a different function."; }
    if k == 7 { return "形参最多 **10 个**；方法调用的 `self` **不计入**实参；Loment 没有默认参数、没有可变参数、也没有重载 —— 名字不同就是不同函数。"; }
    if k == 8 { return "A capability domain is the one thing Loment adds: `capability c : space[lo..hi]` declares an **index domain** and `guard c(i);` checks that `i` falls inside it (a literal out of range is a **compile-time** error, anything else is a run-time trap). So the domain has to be declared first, `lo <= hi` has to hold, and one name may be declared only once per space."; }
    if k == 9 { return "能力域是 Loment 唯一“新加的东西”：`capability c : space[lo..hi]` 声明一个**索引域**，`guard c(i);` 检查 `i` 落在域内（字面量越界是**编译期错**，其余是运行期 trap）。所以域必须**先声明**、`lo <= hi`、同一空间同一个名字只声明一次。"; }
    if k == 10 { return "`excluded \"space: ...\"` is an **out-of-bounds declaration**: it removes a space from what this program may touch, and it is a promise written for a security audit. Using that space again therefore contradicts your own promise - and that is **deliberate**, not the compiler being fussy."; }
    if k == 11 { return "`excluded “space: ...”` 是**出界声明**：它把一个空间从“本程序可以碰的”里拿掉，是给安全审计看的一份承诺。于是再用那个空间就与自己的承诺冲突 —— 这是**故意的**，不是编译器挑剔。"; }
    if k == 12 { return "Loment's aggregate types (`struct` / `enum`) are **move** by default: passing one by value to a function, or assigning one to another variable, hands over ownership. Types whose fields are **all integers** are `Copy` automatically and never report this."; }
    if k == 13 { return "Loment 的聚合类型（`struct` / `enum`）默认是**移动**语义：按值传进函数、按值赋给另一个变量，都相当于把所有权交出去。**全字段是整型**的类型自动按 `Copy` 处理，不会报这条。"; }
    if k == 14 { return "`&mut` is an **exclusive** borrow (the same rule as Rust): while a mutable borrow is alive, no other borrow - not even a read-only one - may exist alongside it. This is not about performance; the answer to \"who may change it\" has to be unique."; }
    if k == 15 { return "`&mut` 是**独占**借用（与 Rust 同一套规则）：可变借用存在期间，别的借用（包括只读的）都不能同时存在。这不是性能问题，是“谁能改它”的答案必须唯一。"; }
    if k == 16 { return "`match` must be **exhaustive** (or carry a `_` arm); **an arm body is a block**, not an expression; a variant with a payload binds a variable and one without a payload takes no parentheses; and a **generic enum** pattern must use the **monomorphized** name (`Result_i64_u32::Ok(v)`), not `Result::Ok(v)`."; }
    if k == 17 { return "`match` 必须**穷尽**（或者有 `_` 兜底）；**臂体是块**、不是表达式；带载荷的变体模式要绑变量、无载荷的不能带括号；**泛型枚举**的模式要用**单态化之后**的名字（`Result_i64_u32::Ok(v)`），不是 `Result::Ok(v)`。"; }
    if k == 18 { return "`u8 u16 u32 u64 i8 i16 i32 i64 bool ptr str` are **base type names**; a user type taking one of them leaves no way to tell the two apart later. Empty aggregates for the same reason: a type with no field and no variant expresses nothing, and **rejecting it loudly beats letting it exist quietly** - it is almost always half-written."; }
    if k == 19 { return "`u8 u16 u32 u64 i8 i16 i32 i64 bool ptr str` 是**基类型名**，用户类型再叫这些名字，后面就没法区分了。空聚合同理：一个字段/变体都没有的类型表达不了任何东西，**当错误拒掉比让它悄悄存在好** —— 它多半是写了一半。"; }
    if k == 20 { return "`?` means **return now if it failed, unwrap the payload if it worked**, so it asks two things: the enclosing function returns `Result` (or `Option`), and `?` sits in the binding position `let x: T = expr?;`. It is not an \"ignore the error\" marker."; }
    if k == 21 { return "`?` 的语义是“**错了就直接返回，对了就取出载荷**” —— 所以它要求两件事：当前函数返回 `Result`（或 `Option`），而且 `?` 只能出现在 `let x: T = expr?;` 的绑定位置。它不是一个“忽略错误”的记号。"; }
    if k == 22 { return "`fn f(xs: [u32])` receives a **read-only** slice. A slice is a borrowed view, and whether you may write through it is decided by the parameter type: to write, the parameter must be `mut [u32]`, and the call site must pass `&mut arr` (nobody can borrow a read-only slice as writable)."; }
    if k == 23 { return "`fn f(xs: [u32])` 拿到的是**只读**切片 —— 切片是“借来的视野”，能不能写由形参类型决定。要写就得 `mut [u32]`，而调用处必须传 `&mut arr`（只读切片没人能借成可写的）。"; }
    if k == 24 { return "A local variable stops existing when the function returns, so a reference to it is necessarily dangling. A reference that can be returned safely can only come from a **parameter** (or from memory the caller handed in) - this is where the lifetime rules land in Loment."; }
    if k == 25 { return "局部变量在函数返回时就不存在了，返回给它的引用必然悬垂。所以能安全返回的引用，只能来自**形参**（或来自调用方传进来的内存）—— 这是生命周期规则在 Loment 里的落点。"; }
    if k == 26 { return "`use` is a **flat namespace**: the top-level names in one unit must be unique, so **two libraries may not both have a top-level item of the same name**. That is also why the public names in std carry a prefix (`json_parse` / `sha256_hex`) - the ones that do not will collide sooner or later."; }
    if k == 27 { return "`use` 是**平名字空间**：一个单元里的顶层名字必须唯一，所以**两个库也不能有同名顶层项**。这也是为什么 std 里的公开名字都带前缀（`json_parse` / `sha256_hex`）——不带的迟早会撞。"; }
    if k == 28 { return "Only a **variable, a field or an index** can be assigned to - they name a definite piece of memory. The result of an expression (`a + b`, a function's return value) has no address, so nothing can be stored in it."; }
    if k == 29 { return "只有**变量、字段、下标**可以被赋值 —— 它们指向一块确定的内存。表达式的结果（`a + b`、函数返回值）没有地址，所以放不了东西。"; }
    if k == 30 { return "A struct literal must list its fields **completely and without repeats** (there are no defaults); `.` only applies to structs, `[]` only to arrays and slices, and `&`/`&mut` only to arrays and slices. Two more shape rules: **a struct literal cannot be passed as an argument directly**, and **a struct literal cannot be written directly in a condition**."; }
    if k == 31 { return "结构体字面量的字段要**齐全且不重复**（没有默认值这回事）；`.` 只能用在结构体上，`[]` 只能用在数组/切片上，`&`/`&mut` 只能作用于数组或切片。另外两条形状上的规矩：**结构体字面量不能直接当实参**，**条件位置不能直接写结构体字面量**。"; }
    if k == 32 { return "`let xs: [u32; 3] = [1, 2, 3];` - **the length is part of the type**, so the count must be written out and match. There is no \"infer the length from the literal\", because that would need type inference and Loment has none."; }
    if k == 33 { return "`let xs: [u32; 3] = [1, 2, 3];` —— **长度是类型的一部分**，所以个数必须写死对得上，没有“按字面量长度自动推断”这回事（那需要类型推断，而 Loment 没有）。"; }
    if k == 34 { return "`as` performs a **bit-level** conversion only: integer<->integer, integer<->bool, pointer<->integer. Anything else (a string to a number, a struct to a struct) is not a conversion but a parse or a construction, and the steps have to be written out."; }
    if k == 35 { return "`as` 只做**位级**的转换：整数⇄整数、整数⇄布尔、指针⇄整数。别的（字符串→数字、结构体→结构体）不是“转换”而是“解析/构造”，必须写出过程来。"; }
    if k == 36 { return "The name form searches **layer by layer**: (1) the project's `deps/<name>/<name>.lomt`, (2) the toolchain's own store, (3) the four built-in roots (`loment/lib` -> `examples` -> `selfhost` -> `tools`). **The first two layers take the first hit**, and uniqueness is only enforced in layer 3. So a collision usually shows up as \"I thought that was the other one\"."; }
    if k == 37 { return "名字形式按**层**搜：① 项目本地 `deps/<名字>/<名字>.lomt` → ② 工具链自带 store → ③ 内置四根（`loment/lib` → `examples` → `selfhost` → `tools`）。**前两层先命中先用**，唯一性只管第 ③ 层。所以撞名的症状通常是“我以为是另一个”。"; }
    if k == 38 { return "Loment's **own syntax is close to Rust but drops** a few things: single-quoted character literals, value-less `return;`, expression-style `match` arms, and `mut` as a binding modifier. Writing from Rust habits lands on these easily - they are not \"not supported yet\", the language simply does not have them. (That is the native syntax only: the same logic can also be written the C / C++ / Java / C# / Go / Python way, which is a different layer - see `docs/188`.)"; }
    if k == 39 { return "Loment 的**原生语法与 Rust 很接近，但去掉了**几样东西：单引号字符字面量、无值 `return;`、表达式式的 `match` 臂、`mut` 作为绑定修饰词。照 Rust 的习惯写很容易踩到这几处 —— 它们不是“暂时不支持”，是这门语言没有。（说的只是**原生语法**：同一段逻辑也能用 C / C++ / Java / C# / Go / Python 的写法写，那是另一层，见 `docs/188`。）"; }
    if k == 40 { return "This is a **never-silently-drop** gate: the scratch area in the self-hosted mirror was only that big, and anything past it was dropped without a word - so the same source produced **different units** under the reference implementation and under the self-hosted one. Both are 300 now and going over is an error: better an error than \"a piece is missing but it looked like it compiled\"."; }
    if k == 41 { return "这是一道**防静默丢**的闸门：自举镜像里那个暂存区原来就那么大，超出的会被悄悄丢掉，于是同一份源码在参考实现与自举镜下**给出不同的单元**。现在两边都是 300，超限报错 ——宁可报错也不要“少了一块但看起来编过了”。"; }
    if k == 42 { return "Stage 1 takes only **scalars** (`i8..i64` / `u8..u64` / `bool`) and `ptr`. In Loment `str` is **a pointer plus a length**, **not** a C string, and the two are not interchangeable; passing structs or enums by value needs a different register classification. Both of those **change the shape of the code at the call site**, so this errors out rather than compiling something quietly wrong."; }
    if k == 43 { return "第 1 阶段只收**标量**（`i8..i64` / `u8..u64` / `bool`）与 `ptr`。`str` 在 Loment 里是“**指针 + 长度**”，**不是** C 字符串，两者不通用；结构体/枚举按值传要另一套寄存器分类规则 —— 都会**改变调用点的代码形状**，所以一律报错退出而不是静默错编。"; }
    if k == 44 { return "Two different things are managed here: (1) **the core mode** is a property of **the whole program**, and it has **five dimensions** - `mode` (`std` / `no_std`: which layer is available), `gc` (`gc_manual` / `gc_auto` / `gc_auto_alpha` / `no_gc`: who reclaims), `runtime` (`runtime` / `no_runtime`: whether the artifact carries one), `port` (`sealed` / `hosted`: whether it reaches outside itself), and `vm` (`vm` / `no_vm`: which execution model). **Each dimension may be declared once**, and only in the root unit (nothing outside `loment.conf` can change it); two dimensions contradicting each other (`gc_auto` with `no_runtime`) is reported here too. (2) **a switch** is \"code that is compiled in only when it is on\". There can be many switches, but **one name may be written once**, and a value may only be set after `set choose` declared it. A library may not `choose`: to express a need, a library declares a **capability requirement** and the project decides. (3) The `runtime` dimension is **not** managed here: a construct that would drag the runtime in (division, `alloc`, ...) is reported as **E030** (`docs/227`) - that code is about the construct, this one is about `choose` itself."; }
    if k == 45 { return "这是**两个不同的东西**被放在一起管：① **核心模式**是**整个程序**的属性，而且它有**五维** —— `mode`（`std` / `no_std`：能用哪一层）、`gc`（`gc_manual` / `gc_auto` / `gc_auto_alpha` / `no_gc`：回收由谁做）、`runtime`（`runtime` / `no_runtime`：产物里有没有运行期）、`port`（`sealed` / `hosted`：通不通着世界）、`vm`（`vm` / `no_vm`：要哪种执行模型）。**每一维各自只能声明一次**，而且只能在根单元（`loment.conf` 之外没有第二个地方能改它）；两维取值互相矛盾（`gc_auto` 与 `no_runtime`）也在这里报。② **开关**是“打开才编进去的代码”，可以有很多条，但**同名只许写一次**、**取值前必须先 `set choose` 定义**。库不许 `choose` —— 库要表达需要就声明**能力需求**，由项目决定开不开。③ `runtime` 那一维**不在这里**：用了会拖运行期的构造（`alloc`、`panic` …）报的是 **E030**（`docs/227`）—— 那一码说的是那个构造，这一码说的是 `choose` 自己。"; }
    if k == 46 { return "The reference implementation has two backends: the Rust transpile path goes further, and the native IR path (from M0 on) is filled in **block by block**. This message comes from the latter, so it is **not your mistake** - read it as \"the design has not arrived here yet\". That is also why it has a code of its own: what the user can do here (write it another way) is completely different from \"fix that line as suggested\"."; }
    if k == 47 { return "参考实现有两条后端：一条 Rust 转译路径走得远，原生 IR 路径（M0 起）是**逐块补**出来的。这条消息来自后者 —— 所以它**不是你的错**，把它当成“设计上还没到这里”看。这也是它单独一个码的理由：用户能做的事（换个写法绕开）与“照建议改那一行”完全不同。"; }
    if k == 48 { return "There is exactly one way `loment <name>` can find a command: a file called `loment-<name>` on `PATH` (`docs/169` section 3b, the way `git` does it). The design in `docs/223` lets the **source** give the name, so the toolchain can name the artifact after it at **build time**. There are two spellings: the block `register name { ... }` (the name is in the grammar), or the older function returning a literal - and the latter has to be **scanned**: the toolchain reads it with the lexer (the same read as `loment.conf`'s `source_ext`, `docs/158`), with **no parser and no constant folding**, so a literal must sit directly after `return`. The name also has to become a file name, and it must not collide with an official one - the launcher gives official commands priority (`loment version` always runs the official one), so a colliding command builds, installs, and then never runs."; }
    if k == 49 { return "`loment <名>` 能找到命令只有一条路：`PATH` 上有一个叫 `loment-<名>` 的可执行文件（`docs/169` §3b，与 `git` 同款）。`docs/223` 的那条设计让**名字由源码给出**，于是工具链能在**构建时**把产物命名成那个文件。两种写法：块里的 `register 名字 { … }`（名字在语法里），或者老那种返回字面量的函数 —— 后一种要能被**扫**出来：工具链用的是词法器扫标签（与 `loment.conf` 的 `source_ext` 同一种读法，`docs/158`），**没有解析器、没有常量折叠**，所以 `return` 后面必须直接是字面量。名字还要能变成文件名；而且不能撞官方 —— 启动器**官方优先**（`loment version` 永远走官方那份），撞名的命令编得过、装得上、敲了没反应。"; }
    if k == 50 { return "`_start` is the entry a normal program writes itself (a language convention; the linker finds it by name). `command_main` is the entry of a **command body**: once a command is declared, the **toolchain generates** the `_start` that calls it (reads `/proc/self/cmdline`, counts the fields, hands the return value to `exit` - `docs/223` section 3.2). Two entries means the linker can only pick one, and silently dropping the other is exactly the kind of thing this repo refuses, so it is rejected here."; }
    if k == 51 { return "`_start` 是普通程序自己写的入口（语言约定，链接器按名字找它）；`command_main` 是**命令体**的入口，声明了命令之后由**工具链生成** `_start` 去调它（读 `/proc/self/cmdline`、数出字段数、把返回值交给 `exit`，`docs/223` §3.2）。两个都在就是两个入口，链接器只能认一个 —— 那是静默丢掉另一个的地带，所以在这里拒。"; }
    if k == 52 { return "`command_main` is **not** an ordinary function somebody calls - it is the target of the `_start` the toolchain generates, and that generation is triggered only by the **command declaration**. The two halves have to come in pairs: without a declaration, `command_main` is a function nobody calls (it builds, and does nothing); with a declaration but no `command_main`, the generated entry has nothing to call - that would only blow up at **link** time, so it is rejected here; with the wrong signature the generated entry cannot pass its arguments. The signature is fixed: `fn command_main(argv: ptr, argc: u32) -> u32`, where `argv` is the whole `/proc/self/cmdline` block and `argv[0]` is the command's own path (`docs/223` section 3.2)."; }
    if k == 53 { return "`command_main` **不是**被谁直接调用的普通函数 —— 它是工具链生成的那个 `_start` 要去调用的目标，而「生成」这件事只由**命令声明**触发。两半必须成对：没有声明时它是一个**没人调用的函数**（编得过、静默无效）；只有声明而没有它，生成的入口就没有东西可调 —— 那要等到**链接**才炸，所以在检查这一步就拒；签名不对则生成的入口传不进去参数。入口的签名是固定的：`fn command_main(argv: ptr, argc: u32) -> u32`，`argv` 就是 `/proc/self/cmdline` 那一整块，`argv[0]` 是命令自己的路径（`docs/223` §3.2）。"; }
    if k == 54 { return "After codegen that path becomes an **illegal instruction** (`SIGILL`), and it only fires when the path is actually taken - so it is the kind of bug that ships and then blows up when a new input reaches an error branch nobody exercised. \"check passes\" is supposed to mean \"this program will not trap\"; this rule is what makes that true, because a static check is the only place that can say it before the fact."; }
    if k == 55 { return "这类函数发射之后，末尾会落成一条**非法指令**（SIGILL）—— 而它只在**真的走到那一支**时才发生，所以是那种「上线很久、错误分支被新输入踩到」才炸的问题。`check` 通过本该等于「这份程序不会 trap」，这一条就是把那句话兑现：静态检查是唯一能在事前说出口的地方（原先它只是一条写作纪律，见 SKILL.md §6.14）。"; }
    if k == 56 { return "Both numbers here are **known at compile time**, so this is not \"one possible runtime outcome\" - it is **a compile-time fact**, and `docs/205` section 1.1 C5 makes it a language rule: \"an out-of-range access is refused at compile time **when the index is a literal**\". **It does not look at `lms`** (since 2026-10-16, issue #18) - before that date it only fired under `choose lms_open`, and `lms` is a development-channel intermediate that does not ship, so a released user never got it. The same mistake on a capability domain has always been a compile error (`docs/146` section 3); two constructs giving two answers is exactly the inconsistency that issue names. Saying it here is worth it: when it is not refused, clang gets UB (`docs/253` section 4.4 - the IR literally grows a `getelementptr inbounds ... i32 10`) and the in-repo `lomelf` silently writes into the neighbouring bytes."; }
    if k == 57 { return "这里两边的数**都是编译期已知的** —— 所以它不是一个「运行期的一种可能」，而是**一个编译期事实**，`docs/205` §1.1 C5 把这条写成了语言规则：「越界访问在**字面量**时编译期拒」。**它不看 `lms`**（2026-10-16 起，issue #18）—— 在这个日子之前它只在 `choose lms_open` 时发，而 `lms` 是开发通道的中间态、不进发行版，于是发行版的用户拿不到这条。同一件事在`guard` 那一格早就是编译错误（`docs/146` §3），两个构造两个答案正是那个issue 点名的不一致。说死它值当：实测（`docs/253` §4.4）不拒的时候走 clang 是 UB（IR 里直接长出 `getelementptr inbounds … i32 10`），走仓内 `lomelf` 是静默踩相邻字节。"; }
    if k == 58 { return "After `free(p)` that block has gone back to the allocator, so using `p` again is a use-after-free. It **does not necessarily crash** - the block may keep its old bytes until some later `alloc` reuses it (`docs/253` section 5.1), so it is the kind of bug that ships quietly and then blows up when an allocation finally lands on it. The five checks `free` gained in `docs/210` section 2.8 cover **`free`'s own end** (is this really a block, was it already freed); they cannot cover \"used again afterwards\". Separate from E006: moving is an **ownership** matter, freeing is a **legality** one."; }
    if k == 59 { return "`free(p)` 之后那块内存已经还回分配器，再用 `p` 就是 use-after-free。它**不一定会崩** —— 块可能还留着旧字节，一直到最后被下一次 `alloc` 复用（`docs/253` §5.1），所以症状是那种「上线很久、某次分配把它盖掉」才炸的问题。`docs/210` §2.8 给 `free` 加的那五条检查管的是 **`free` 自己那一端**（是不是真块、有没有重复释放），管不了「之后再用」。与 E006 分开：移走是**所有权**的事，释放是**合法性**的事。"; }
    if k == 60 { return "Loment's type table is **fixed**: `u8`..`u64`, `i8`..`i64`, `bool`, `ptr`, `str`, `()`, plus the `struct` / `enum` you declare and arrays/slices of those - no generic containers, and **no floating point** (`loment types` prints the whole list). So this is not \"that name was not declared\"; it is \"**this language has no such type**\". That is also why it is separate from E002: E002 is fixed by declaring the name, this one by naming a type that exists."; }
    if k == 61 { return "Loment 的类型表是**固定的**：`u8`..`u64`、`i8`..`i64`、`bool`、`ptr`、`str`、`()`，加上你声明的 `struct` / `enum` 与它们的数组/切片 —— 没有泛型容器，**也没有浮点**（`loment types` 打出来就是全部）。所以这一条说的不是\"这个名字没声明\"，而是\"**这门语言没有这种类型**\"。它与 E002 分开的理由也在这里：E002 的修法是声明那个名字，这一条的修法是换一个真有的类型。"; }
    if k == 62 { return "Loading is the compiler's first pass, and this happens before it. \"The file cannot be read\" and \"the source in it is wrong\" are two different things: no edit to the source can fix the first, so it gets its own code and is **not** a syntax error (E019). An empty file lands here too - that is not \"written wrongly\", it is \"nothing to read\"."; }
    if k == 63 { return "装载是编译的第一趟，而这一条发生在它之前。「文件读不到」与「文件里的源码写错了」是两件不同的事：前者无论如何改源码都解决不了，所以它单独一个码、而且**不是**语法错（E019）。空文件也落在这里 —— 那不是「写错了」，是「没得读」。"; }
    if k == 64 { return "The artifact is the compiler's **last step**, so this has nothing to do with your source - the source can be perfect and the write still fail. The most common cause is a **missing parent directory**: `loment build a.lomt -o out/a` when `out/` does not exist yet. Next comes permissions, or the path being held by another process (on Windows, replacing an exe that is running does this)."; }
    if k == 65 { return "产物是编译的**最后一步**，所以这条与源码无关 —— 源码全对也可能写不出去。最常见的原因是**父目录不存在**：`loment build a.lomt -o out/a` 而 `out/` 还没建。其次是权限，或者那个路径上已经有别的进程占着（Windows 上改了正在运行的 exe 就是这样）。"; }
    if k == 66 { return "This toolchain is **self-hosted**: it has no optimiser and no dynamic containers, and those tables live inside the program image with a size fixed at compile time. When a unit does not fit, it reports **on the spot** rather than truncating silently - truncation would make code vanish, and that kind of bug only shows up at run time. So this is not \"your source is wrong\"; it is \"this unit is too big for this compiler\"."; }
    if k == 67 { return "这套工具链是**自举**的，没有优化器也没有动态容器：那几张表开在程序映像里，大小是编译期常量。单元大到装不下时，宁可**当场报错**也不静默截断 —— 截断的话后面的代码会凭空消失，而那种错要等到运行时才现形（`docs/158` §5 记着这条纪律）。所以这条不是「你的源码错了」，是「这一份的形状对这台编译器来说太大了」。"; }
    if k == 68 { return "LSPE's promise is not \"no bugs\"; it is \"no silent allow\". The default tier only records the site as `undecided` in the ledger. Only `--lspe-mode=strict` turns it into an error."; }
    if k == 69 { return "LSPE 的承诺不是“没有漏洞”，是“没有未被标注的放行”。默认档只把它记进台账的 `undecided`；只有 `--lspe-mode=strict` 才会把它变成一条错误。"; }
    if k == 70 { return "This is the auditor's own inconsistency, not a defect in the user's code. It is in the same family as E036 (an unrecorded question): the auditor must audit itself."; }
    if k == 71 { return "这是**审计器自己的**不一致，不是用户代码的错误。与 E036（反问未记账）同族：审计者必须先能审自己。"; }
    if k == 72 { return "The auditor must be able to audit itself: this is the auditor's own failure, not a defect in the user's code."; }
    if k == 73 { return "审计者必须先能审自己：这一条是**审计器自己的**失败，不是用户代码的错误。"; }
    if k == 74 { return "The policy layer is a future surface; there is no policy layer today, so this code is reserved."; }
    if k == 75 { return "策略层是未来面；今天没有策略层，这个码先占住。"; }
    if k == 76 { return "The bypass is receipted: the block itself goes into the ledger, and the reason is its signature. A reasonless bypass is the unlabelled floor LSPE exists to prevent."; }
    if k == 77 { return "旁路是**有收据的**：块本身进台账，理由就是签名。没有理由的旁路等于一块无标签地板 —— 那正是 LSPE 要防的形状。"; }
    if k == 78 { return "`no_gc` promises \"the artifact has no collector\", while every `lgc` statement controls when that collector runs. The two cannot both be true."; }
    if k == 79 { return "`no_gc` 的承诺是「产物不带收集器」，而 `lgc` 的每一条语句都在控制收集器何时跑。这两句话不能同时为真：要么开一个有收集器的档，要么不要写 `lgc`。"; }
    if k == 80 { return "Editions only add syntax, but some additions **must** reuse words that were legal identifiers in an older edition (`break` / `continue` / `defer` / `print_num` / `lgc`). The same source means different things under the two readings, and the default is now the **newest edition** - reading it as the new one silently changes an old file's meaning. The compiler stops and asks instead of choosing for you."; }
    if k == 81 { return "新版次只加语法，但有些新语法**必须**用旧版次里的合法标识符（`break` / `continue` / `defer` / `print_num` / `lgc`）。同一份源在两种读法下含义不同，而默认读法已经是**最新版次** —— 静默按新版读会改变旧文件的含义。所以编译器在这里停下来问一句，而不是替你选。"; }
    if k == 82 { return "A borrow is a **static** promise: `&T` is valid only while the source is alive. Loment infers the source from regions - a returned borrow may only come from a **parameter** (a local dies with the call), and an explicit `&a T` marker may only name a reference parameter in the signature. `free(p)` also ends p's region, so no borrow may still point at it."; }
    if k == 83 { return "借用是一条**静态**承诺：`&T` 只在来源还活着时有效。Loment 从区域推出来源 —— 返回值只能借自**形参**（局部变量出了函数就不存在），显式标记 `&a T` 只能指向签名里的一个引用形参。`free(p)` 也会结束 `p` 的区域，所以释放时不能再有指向它的借用。"; }
    if k == 84 { return "Loment has **no implicit numeric conversion** and no type inference: every position must match explicitly. A `u32` value never becomes an `i64` on its own, and the integer `1` is not the `bool` `true`."; }
