// std/ed25519.lomt — Ed25519 签名（RFC 8032，PureEdDSA）
//
// 为什么标准库要有它: TLS 证书、SSH 主机密钥、软件发行签名都越来越多地用 Ed25519 ——
// 公钥 32 字节、签名 64 字节、没有随机数生成器的坑（nonce 由消息与私钥确定性地导出）。
// 之前 store 里只有哈希与 KDF，没有任何**非对称**原语，"验签"这件事做不了。
//
// 实现路线: 与 `x25519.lomt` 同一套 16×16 位肢体（TweetNaCl 的 gf），扩展坐标下的
// 点加法；标量模 L 的归约用 TweetNaCl 的 modL（32 个 u8 的 L，i64 中间量）。
// 曲线常数（d、2d、基点 X/Y、sqrt(-1)）不是手抄的：它们由 d = -121665/121666 mod p、
// y = 4/5、sqrt(-1) 独立推出后逐肢体核对过（见提交说明）。
//
// 边界: PureEdDSA（RFC 8032 §5.1，无上下文串）；不做 Ed25519ph/ctx 变体、不做
// 批量验签、不做密钥派生（seed 就是私钥，公钥由它确定性导出）。
//
// 布局: 域元素 = 128 字节；点 = 4 个域元素 = 512 字节。所有内部函数按**基址 + 偏移**
// 操作（不使用 `ptr_add`，`loment.py test` 的 Rust 翻译不生成 unsafe 块）。
//
// 命名: 公开 ed_*, 内部 eq_*。自检 test_ed25519_*（RFC 8032 向量，无系统调用）。

module ed25519

use "mem.lomt"
use "sha512.lomt"

pub const ED_BYTES: u32 = 32;
pub const ED_SIG_BYTES: u32 = 64;

const ED_H: u32 = 992;
const ED_T32: u32 = 1088;
const ED_X: u32 = 1120;
const ED_P: u32 = 1632;
const ED_Q: u32 = 2144;
const ED_G1: u32 = 2656;
const ED_G2: u32 = 2784;
const ED_G3: u32 = 2912;
const ED_G4: u32 = 3040;
const ED_G5: u32 = 3168;
const ED_G6: u32 = 3296;
const ED_G7: u32 = 3424;
const ED_G8: u32 = 3552;
const ED_PROD: u32 = 3680;
const ED_NUM: u32 = 3936;
const ED_DEN: u32 = 4064;
const ED_DEN2: u32 = 4192;
const ED_DEN4: u32 = 4320;
const ED_DEN6: u32 = 4448;
const ED_CHK: u32 = 4576;
const ED_T: u32 = 4704;
const ED_CD: u32 = 4832;
const ED_CD2: u32 = 4960;
const ED_CX: u32 = 5088;
const ED_CY: u32 = 5216;
const ED_CI: u32 = 5344;
const ED_INVT: u32 = 5472;
const ED_POWT: u32 = 5600;
const ED_P2: u32 = 5760;
const ED_SCRATCH: u32 = 6272;

/// 内部工作区需要的字节数。
pub fn ed_scratch() -> u32 {
    return ED_SCRATCH;
}

// ---------------------------------------------------------------- 域运算

fn eq_get(x: ptr, o: u32, i: u32) -> i64 {
    return mem_load64(x, o + i * 8) as i64;
}

fn eq_put(x: ptr, o: u32, i: u32, v: i64) {
    mem_store64(x, o + i * 8, v as u64);
}

fn eq_zero(x: ptr, o: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        eq_put(x, o, i, 0 as i64);
        i = i + 1;
    }
    return 1;
}

fn eq_one(x: ptr, o: u32) -> u32 {
    eq_zero(x, o);
    eq_put(x, o, 0, 1 as i64);
    return 1;
}

fn eq_copy(x: ptr, dst: u32, src: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        eq_put(x, dst, i, eq_get(x, src, i));
        i = i + 1;
    }
    return 1;
}

fn eq_carry(x: ptr, o: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        let v: i64 = eq_get(x, o, i) + (65536 as i64);
        let c: i64 = v >> 16;
        let t: i64 = c - (1 as i64);
        if i < 15 {
            eq_put(x, o, i + 1, eq_get(x, o, i + 1) + t);
        } else {
            eq_put(x, o, 0, eq_get(x, o, 0) + t * (38 as i64));
        }
        eq_put(x, o, i, v - (c << 16));
        i = i + 1;
    }
    return 1;
}

fn eq_sel(x: ptr, p: u32, q: u32, b: u32) -> u32 {
    let m: i64 = 0 as i64 - (b as i64);
    let i: u32 = 0;
    while i < 16 {
        let t: i64 = m & (eq_get(x, p, i) ^ eq_get(x, q, i));
        eq_put(x, p, i, eq_get(x, p, i) ^ t);
        eq_put(x, q, i, eq_get(x, q, i) ^ t);
        i = i + 1;
    }
    return 1;
}

fn eq_add(x: ptr, o: u32, a: u32, b: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        eq_put(x, o, i, eq_get(x, a, i) + eq_get(x, b, i));
        i = i + 1;
    }
    return 1;
}

fn eq_sub(x: ptr, o: u32, a: u32, b: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        eq_put(x, o, i, eq_get(x, a, i) - eq_get(x, b, i));
        i = i + 1;
    }
    return 1;
}

fn eq_mul(x: ptr, o: u32, a: u32, b: u32) -> u32 {
    let i: u32 = 0;
    while i < 31 {
        mem_store64(x, ED_PROD + i * 8, 0 as u64);
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        let ai: i64 = eq_get(x, a, i);
        let j: u32 = 0;
        while j < 16 {
            let cur: i64 = mem_load64(x, ED_PROD + (i + j) * 8) as i64;
            mem_store64(x, ED_PROD + (i + j) * 8, (cur + ai * eq_get(x, b, j)) as u64);
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < 15 {
        let lo: i64 = mem_load64(x, ED_PROD + i * 8) as i64;
        let hi: i64 = mem_load64(x, ED_PROD + (i + 16) * 8) as i64;
        mem_store64(x, ED_PROD + i * 8, (lo + hi * (38 as i64)) as u64);
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        eq_put(x, o, i, mem_load64(x, ED_PROD + i * 8) as i64);
        i = i + 1;
    }
    eq_carry(x, o);
    eq_carry(x, o);
    return 1;
}

fn eq_sq(x: ptr, o: u32, a: u32) -> u32 {
    return eq_mul(x, o, a, a);
}

fn eq_inv(x: ptr, o: u32, a: u32) -> u32 {
    eq_copy(x, ED_INVT, a);
    let k: i64 = 253 as i64;
    while k >= 0 {
        eq_sq(x, ED_INVT, ED_INVT);
        if k != (2 as i64) && k != (4 as i64) {
            eq_mul(x, ED_INVT, ED_INVT, a);
        }
        k = k - 1;
    }
    return eq_copy(x, o, ED_INVT);
}

fn eq_pow2523(x: ptr, o: u32, a: u32) -> u32 {
    eq_copy(x, ED_POWT, a);
    let k: i64 = 250 as i64;
    while k >= 0 {
        eq_sq(x, ED_POWT, ED_POWT);
        if k != (1 as i64) {
            eq_mul(x, ED_POWT, ED_POWT, a);
        }
        k = k - 1;
    }
    return eq_copy(x, o, ED_POWT);
}

/// 压缩（模 p）写到 out + oo。
fn eq_pack(x: ptr, out: ptr, oo: u32, n: u32) -> u32 {
    eq_copy(x, ED_T, n);
    eq_carry(x, ED_T);
    eq_carry(x, ED_T);
    eq_carry(x, ED_T);
    let round: u32 = 0;
    while round < 2 {
        eq_put(x, ED_G8, 0, eq_get(x, ED_T, 0) - (65517 as i64));
        let i: u32 = 1;
        while i < 15 {
            let prev: i64 = (eq_get(x, ED_G8, i - 1) >> 16) & (1 as i64);
            eq_put(x, ED_G8, i, eq_get(x, ED_T, i) - (65535 as i64) - prev);
            eq_put(x, ED_G8, i - 1, eq_get(x, ED_G8, i - 1) & (65535 as i64));
            i = i + 1;
        }
        let prev15: i64 = (eq_get(x, ED_G8, 14) >> 16) & (1 as i64);
        eq_put(x, ED_G8, 15, eq_get(x, ED_T, 15) - (32767 as i64) - prev15);
        let b: u32 = ((eq_get(x, ED_G8, 15) >> 16) & (1 as i64)) as u32;
        eq_put(x, ED_G8, 14, eq_get(x, ED_G8, 14) & (65535 as i64));
        eq_sel(x, ED_T, ED_G8, 1 - b);
        round = round + 1;
    }
    let i2: u32 = 0;
    while i2 < 16 {
        let v: i64 = eq_get(x, ED_T, i2);
        store8(out, oo + 2 * i2, (v & (255 as i64)) as u8);
        store8(out, oo + 2 * i2 + 1, ((v >> 8) & (255 as i64)) as u8);
        i2 = i2 + 1;
    }
    return 1;
}

fn eq_unpack(x: ptr, o: u32, n: ptr) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        let lo: i64 = load8(n, 2 * i) as i64;
        let hi: i64 = load8(n, 2 * i + 1) as i64;
        eq_put(x, o, i, lo + (hi << 8));
        i = i + 1;
    }
    eq_put(x, o, 15, eq_get(x, o, 15) & (32767 as i64));
    return 1;
}

fn eq_neg(x: ptr, o: u32, a: u32) -> u32 {
    let i: u32 = 0;
    while i < 16 {
        eq_put(x, o, i, (0 as i64) - eq_get(x, a, i));
        i = i + 1;
    }
    return 1;
}

fn eq_parity(x: ptr, a: u32) -> u32 {
    eq_pack(x, x, ED_T32, a);
    return (load8(x, ED_T32) & 1) as u32;
}

fn eq_eq25519(x: ptr, a: u32, b: u32) -> bool {
    eq_pack(x, x, ED_T32, a);
    eq_pack(x, x, ED_H, b);
    let i: u32 = 0;
    while i < 32 {
        if load8(x, ED_T32 + i) != load8(x, ED_H + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------- 曲线常数

fn eq_consts(x: ptr) -> u32 {
    eq_put(x, ED_CD, 0, 30883 as i64);
    eq_put(x, ED_CD, 1, 4953 as i64);
    eq_put(x, ED_CD, 2, 19914 as i64);
    eq_put(x, ED_CD, 3, 30187 as i64);
    eq_put(x, ED_CD, 4, 55467 as i64);
    eq_put(x, ED_CD, 5, 16705 as i64);
    eq_put(x, ED_CD, 6, 2637 as i64);
    eq_put(x, ED_CD, 7, 112 as i64);
    eq_put(x, ED_CD, 8, 59544 as i64);
    eq_put(x, ED_CD, 9, 30585 as i64);
    eq_put(x, ED_CD, 10, 16505 as i64);
    eq_put(x, ED_CD, 11, 36039 as i64);
    eq_put(x, ED_CD, 12, 65139 as i64);
    eq_put(x, ED_CD, 13, 11119 as i64);
    eq_put(x, ED_CD, 14, 27886 as i64);
    eq_put(x, ED_CD, 15, 20995 as i64);

    eq_put(x, ED_CD2, 0, 61785 as i64);
    eq_put(x, ED_CD2, 1, 9906 as i64);
    eq_put(x, ED_CD2, 2, 39828 as i64);
    eq_put(x, ED_CD2, 3, 60374 as i64);
    eq_put(x, ED_CD2, 4, 45398 as i64);
    eq_put(x, ED_CD2, 5, 33411 as i64);
    eq_put(x, ED_CD2, 6, 5274 as i64);
    eq_put(x, ED_CD2, 7, 224 as i64);
    eq_put(x, ED_CD2, 8, 53552 as i64);
    eq_put(x, ED_CD2, 9, 61171 as i64);
    eq_put(x, ED_CD2, 10, 33010 as i64);
    eq_put(x, ED_CD2, 11, 6542 as i64);
    eq_put(x, ED_CD2, 12, 64743 as i64);
    eq_put(x, ED_CD2, 13, 22239 as i64);
    eq_put(x, ED_CD2, 14, 55772 as i64);
    eq_put(x, ED_CD2, 15, 9222 as i64);

    eq_put(x, ED_CX, 0, 54554 as i64);
    eq_put(x, ED_CX, 1, 36645 as i64);
    eq_put(x, ED_CX, 2, 11616 as i64);
    eq_put(x, ED_CX, 3, 51542 as i64);
    eq_put(x, ED_CX, 4, 42930 as i64);
    eq_put(x, ED_CX, 5, 38181 as i64);
    eq_put(x, ED_CX, 6, 51040 as i64);
    eq_put(x, ED_CX, 7, 26924 as i64);
    eq_put(x, ED_CX, 8, 56412 as i64);
    eq_put(x, ED_CX, 9, 64982 as i64);
    eq_put(x, ED_CX, 10, 57905 as i64);
    eq_put(x, ED_CX, 11, 49316 as i64);
    eq_put(x, ED_CX, 12, 21502 as i64);
    eq_put(x, ED_CX, 13, 52590 as i64);
    eq_put(x, ED_CX, 14, 14035 as i64);
    eq_put(x, ED_CX, 15, 8553 as i64);

    eq_put(x, ED_CY, 0, 26200 as i64);
    eq_put(x, ED_CY, 1, 26214 as i64);
    eq_put(x, ED_CY, 2, 26214 as i64);
    eq_put(x, ED_CY, 3, 26214 as i64);
    eq_put(x, ED_CY, 4, 26214 as i64);
    eq_put(x, ED_CY, 5, 26214 as i64);
    eq_put(x, ED_CY, 6, 26214 as i64);
    eq_put(x, ED_CY, 7, 26214 as i64);
    eq_put(x, ED_CY, 8, 26214 as i64);
    eq_put(x, ED_CY, 9, 26214 as i64);
    eq_put(x, ED_CY, 10, 26214 as i64);
    eq_put(x, ED_CY, 11, 26214 as i64);
    eq_put(x, ED_CY, 12, 26214 as i64);
    eq_put(x, ED_CY, 13, 26214 as i64);
    eq_put(x, ED_CY, 14, 26214 as i64);
    eq_put(x, ED_CY, 15, 26214 as i64);

    eq_put(x, ED_CI, 0, 41136 as i64);
    eq_put(x, ED_CI, 1, 18958 as i64);
    eq_put(x, ED_CI, 2, 6951 as i64);
    eq_put(x, ED_CI, 3, 50414 as i64);
