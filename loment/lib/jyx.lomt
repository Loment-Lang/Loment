module jyx
choose runtime

// jyx.lomt —— 一份没有任何人 `use` 的库。
//
// 名字是一个人，不是一件事：这个文件不参与任何编译路径，也没有任何模块指向它。
// 它在 `loment/lib/` 里，因为这里放的是"这门语言自己也会用到的东西"—— 而这个文件
// 放的是这门语言替一个人留着的三样：
//
//     2010-05-29   一个生日
//     hxy          一个名字
//     2026-09-28   这门语言出生的那天
//
// 两个名字**不以文本出现**：它们各是三个 ASCII 字节打包成的一个 24 位数。想读懂这个
// 文件，得先把下面那两个数摊开成字节 —— 那一步就是它藏起来的方式。日期同理：按
// `reboot(2)` 的 `0xDDMMYYYY` 打包，旁边写着十进制，因为字面量两侧编译要逐字节一致。
//
// 这里没有一个函数会改变任何编译结果。它们只是存在。

//: 'h' 'x' 'y' —— 三个字节摊在 24 位里。
const HER: u32 = 0x687879;
//: 'j' 'y' 'x'。
const HIM: u32 = 0x6A7978;
//: 0x29052010 = 29/05/2010。
const BIRTH: u32 = 688201744;
//: 0x28092026 = 28/09/2026。
const BORN: u32 = 671686694;

//: 一颗 5 列 × 5 行的心。每行 5 位，最高位是左边第一列。
const HEART0: u32 = 0x0E;        // 01110
const HEART1: u32 = 0x1F;        // 11111
const HEART2: u32 = 0x1F;        // 11111
const HEART3: u32 = 0x0E;        // 01110
const HEART4: u32 = 0x04;        // 00100

/// 打包进 `word` 的第 `i` 个字节（`i = 0` 是最高字节）。
pub fn jyx_initial(word: u32, i: u32) -> u8 {
    let shift: u32 = (2 - i) * 8;
    return ((word >> shift) & 255) as u8;
}

/// 这个 24 位数是不是"三个小写字母"。两个名字都过这一条。
pub fn jyx_looks_like_a_name(word: u32) -> bool {
    let ok: bool = true;
    let i: u32 = 0;
    while i < 3 {
        let c: u32 = jyx_initial(word, i) as u32;
        if c < 97 || c > 122 {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

/// 打包日期的一个字段：0 = 日，1 = 月，2 = 年。
pub fn jyx_date_part(v: u32, i: u32) -> u32 {
    if i == 0 {
        return v / 1000000;
    }
    if i == 1 {
        return (v / 10000) % 100;
    }
    return v % 10000;
}

/// 这个日期是一年里的第几天。**不看闰年** —— 这里要的是一个固定的、两侧逐字节一致的数，
/// 不是一份日历。
pub fn jyx_day_of_year(v: u32) -> u32 {
    let m: u32 = jyx_date_part(v, 1);
    let d: u32 = jyx_date_part(v, 0);
    let acc: u32 = 0;
    let i: u32 = 1;
    while i < m {
        if i == 2 {
            acc = acc + 28;
        } else {
            if i == 4 || i == 6 || i == 9 || i == 11 {
                acc = acc + 30;
            } else {
                acc = acc + 31;
            }
        }
        i = i + 1;
    }
    return acc + d;
}

/// 心的第 `r` 行（0..4）；越界给 0。
pub fn jyx_heart_row(r: u32) -> u32 {
    if r == 0 {
        return HEART0;
    }
    if r == 1 {
        return HEART1;
    }
    if r == 2 {
        return HEART2;
    }
    if r == 3 {
        return HEART3;
    }
    if r == 4 {
        return HEART4;
    }
    return 0;
}

/// 第 `r` 行第 `c` 列是不是实心（`c` 0..4，从左往右）。
pub fn jyx_heart_cell(r: u32, c: u32) -> bool {
    let row: u32 = jyx_heart_row(r);
    let shift: u32 = 4 - c;
    return ((row >> shift) & 1) == 1;
}

/// FNV-1a 的一位。这个文件自己用的混合函数，别处不要照抄。
pub fn jyx_roll(h: u32, b: u32) -> u32 {
    let x: u32 = h ^ (b & 255);
    return x * 16777619;
}

/// 四个数滚成一个 32 位数。谁也不会去比较它 —— 它只是"这个文件确实连着"的凭据。
pub fn jyx_mix() -> u32 {
    let h: u32 = 2166136261;
    h = jyx_roll(h, HER & 255);
    h = jyx_roll(h, (HER >> 8) & 255);
    h = jyx_roll(h, (HER >> 16) & 255);
    h = jyx_roll(h, HIM & 255);
    h = jyx_roll(h, (HIM >> 8) & 255);
    h = jyx_roll(h, (HIM >> 16) & 255);
    h = jyx_roll(h, BIRTH & 255);
    h = jyx_roll(h, (BIRTH >> 8) & 255);
    h = jyx_roll(h, (BIRTH >> 16) & 255);
    h = jyx_roll(h, (BIRTH >> 24) & 255);
    h = jyx_roll(h, BORN & 255);
    h = jyx_roll(h, (BORN >> 8) & 255);
    h = jyx_roll(h, (BORN >> 16) & 255);
    h = jyx_roll(h, (BORN >> 24) & 255);
    return h;
}
