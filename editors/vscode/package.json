{
  "name": "loment",
  "displayName": "Loment",
  "description": "Loment language support for VS Code: syntax highlighting (including the seven surface grammars), a language server (completion, go to definition, diagnostics, formatting), and build / run / check / debug commands.",
  "version": "0.2.1",
  "publisher": "hooyan2022",
  "license": "Loment-Open",
  "repository": {
    "type": "git",
    "url": "https://github.com/Loment-Lang/loment.git"
  },
  "icon": "loment-icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "//files": "Allowlist of the files packed into the VSIX (both vsce and npm read this field). `node_modules` must be here: the copy installed from the Marketplace never runs `npm install`, so `vscode-languageclient` is shipped inside the package. The INCLUDE_* lists in `tools/vscode_ext.py` express the same thing for local side-loading, and a criterion keeps the two from missing the same class of file.",
  "files": [
    "src",
    "syntaxes",
    "node_modules",
    "package.json",
    "language-configuration.json",
    "language-configuration-python.json",
    "README.md",
    "LICENSE",
    "loment-icon.png"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace (Restricted Mode) syntax highlighting and the language server stay available while the settings below are blocked, so a workspace's .vscode/settings.json cannot point them at arbitrary programs or scripts (#166).",
      "restrictedConfigurations": [
        "loment.serverCommand",
        "loment.serverArgs",
        "loment.toolCommand",
        "loment.toolArgs",
        "loment.dapCommand",
        "loment.dapArgs",
        "loment.serverPath",
        "loment.dapScript"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Build, run and debug all need a real file system (build outputs, ELF, ptrace)."
    }
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "loment",
    "fujoos",
    "fujolang"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:loment",
    "onLanguage:lom",
    "onLanguage:loment-c",
    "onLanguage:loment-cpp",
    "onLanguage:loment-java",
    "onLanguage:loment-csharp",
    "onLanguage:loment-go",
    "onLanguage:loment-python",
    "onLanguage:loment-natural",
    "workspaceContains:**/loment.conf"
  ],
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "loment",
        "aliases": [
          "Loment",
          "loment"
        ],
        "extensions": [
          ".lomt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lom",
        "aliases": [
          "L0 (.lom)",
          "lom"
        ],
        "extensions": [
          ".lom"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-c",
        "aliases": [
          "Loment (C surface grammar)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-cpp",
        "aliases": [
          "Loment (C++ surface grammar)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-java",
        "aliases": [
          "Loment (Java surface grammar)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-csharp",
        "aliases": [
          "Loment (C# surface grammar)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-go",
        "aliases": [
          "Loment (Go surface grammar)"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loment-python",
        "aliases": [
          "Loment (Python surface grammar)"
        ],
        "configuration": "./language-configuration-python.json"
      },
      {
        "id": "loment-natural",
        "aliases": [
          "Loment (natural surface grammar)"
        ]
      }
    ],
    "grammars": [
      {
        "language": "loment",
        "scopeName": "source.loment",
        "path": "./syntaxes/loment.tmLanguage.json"
      },
      {
        "language": "lom",
        "scopeName": "source.lom",
        "path": "./syntaxes/lom.tmLanguage.json"
      },
      {
        "language": "loment-c",
        "scopeName": "source.loment.c",
        "path": "./syntaxes/loment-c.tmLanguage.json"
      },
      {
        "language": "loment-cpp",
        "scopeName": "source.loment.cpp",
        "path": "./syntaxes/loment-cpp.tmLanguage.json"
      },
      {
        "language": "loment-java",
        "scopeName": "source.loment.java",
        "path": "./syntaxes/loment-java.tmLanguage.json"
      },
      {
        "language": "loment-csharp",
        "scopeName": "source.loment.csharp",
        "path": "./syntaxes/loment-csharp.tmLanguage.json"
      },
      {
        "language": "loment-go",
        "scopeName": "source.loment.go",
        "path": "./syntaxes/loment-go.tmLanguage.json"
      },
      {
        "language": "loment-python",
        "scopeName": "source.loment.python",
        "path": "./syntaxes/loment-python.tmLanguage.json"
      },
      {
        "language": "loment-natural",
        "scopeName": "source.loment.natural",
        "path": "./syntaxes/loment-natural.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Loment",
      "properties": {
        "loment.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to tools/loment_lsp.py (only used when serverCommand is not set). Empty means: search upward from the workspace."
        },
        "loment.serverCommand": {
          "type": "string",
          "default": "",
          "description": "Start the language server with a different command (**no Python needed**). Recommended on Windows: `wsl`, with a Loment language server installed by scripts/install-lsp.ps1. Empty means: python + serverPath."
        },
        "loment.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments for serverCommand. Example: [\"-e\", \"/home/<you>/.local/share/loment/lsp\"] (scripts/install-lsp.ps1 prints that line)."
        },
        "loment.enableLsp": {
          "type": "boolean",
          "default": true,
          "description": "Enable the language server (completion / definition / diagnostics / formatting). Turned off, only syntax highlighting and the commands remain."
        },
        "loment.extraExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra suffixes to treat as L1 source (example: [\".foo\"]). When a project declares its own suffix with `source_ext()` in `loment.conf` you do **not** need this: the extension reads that conf itself, including when you opened a subdirectory and the conf sits one level up. This setting is for the case where there is no conf."
        },
        "loment.buildDir": {
          "type": "string",
          "default": "loment/build",
          "description": "Output directory for build artifacts (.ll / .potato.json), relative to the workspace root."
        },
        "loment.toolCommand": {
          "type": "string",
          "default": "",
          "description": "Which Loment executable *Build / Run* uses (**no Python needed**). With the package installed: `loment`; running through WSL on Windows: `wsl`. Empty means: on Windows use scripts/lomc.ps1 from the workspace when present, otherwise the command **reports an explicit error** (it never silently does nothing)."
        },
        "loment.toolArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments for toolCommand. Example: [\"-e\", \"/home/<you>/.local/share/loment/bin/loment\"] (with toolCommand=\"wsl\")."
        },
        "loment.dapScript": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the debug adapter tools/loment_dap.py. Empty means: search upward from the workspace."
        },
        "loment.dapCommand": {
          "type": "string",
          "default": "",
          "description": "Start the debug adapter with a different command (default: `wsl -e python3 <dapScript>` on Windows, `python3 <dapScript>` elsewhere). Empty means: use the default."
        },
        "loment.dapArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments for dapCommand (include the script path yourself when it is not in there)."
        }
      }
    },
    "breakpoints": [
      {
        "language": "loment"
      },
      {
        "language": "loment-c"
      },
      {
        "language": "loment-cpp"
      },
      {
        "language": "loment-java"
      },
      {
        "language": "loment-csharp"
      },
      {
        "language": "loment-go"
      },
      {
        "language": "loment-python"
      },
      {
        "language": "loment-natural"
      }
    ],
    "debuggers": [
      {
        "type": "loment",
        "label": "Loment Debug",
        "languages": [
          "loment",
          "loment-c",
          "loment-cpp",
          "loment-java",
          "loment-csharp",
          "loment-go",
          "loment-python",
          "loment-natural"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .lomt source file to debug (compiled inside the debug session, with DWARF)"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments passed to the program being debugged"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop at the entry point (the first instruction of `_start`)"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "loment",
            "request": "launch",
            "name": "Debug current Loment file",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Loment: debug a .lomt file",
            "description": "Uses ptrace inside WSL (needs LLVM's clang / llvm-objdump on the Windows side)",
            "body": {
              "type": "loment",
              "request": "launch",
              "name": "Debug Loment",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "loment",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "`build` (compile) or `run` (compile and run)"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "loment.build",
        "title": "Loment: Build current file"
      },
      {
        "command": "loment.run",
        "title": "Loment: Build and run"
      },
      {
        "command": "loment.restartServer",
        "title": "Loment: Restart language server"
      },
      {
        "command": "loment.showIr",
        "title": "Loment: Emit LLVM IR (current file)"
      },
      {
        "command": "loment.checkFile",
        "title": "Loment: Check (current file)"
      },
      {
        "command": "loment.runTests",
        "title": "Loment: Run test_* functions"
      },
      {
        "command": "loment.runInFujoOS",
        "title": "Loment: Run on the FujoOS kernel (QEMU)"
      },
      {
        "command": "loment.formatDocument",
        "title": "Loment: Format document (lomfmt)"
      }
    ],
    "problemMatchers": [
      {
        "name": "loment",
        "owner": "loment",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (E\\d{3}) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5,
          "severity": "error"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loment.showIr",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.checkFile",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.runTests",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.build",
          "when": "editorLangId =~ /^loment/"
        },
        {
          "command": "loment.run",
          "when": "editorLangId =~ /^loment/"
        }
      ],
      "editor/context": [
        {
          "command": "loment.build",
          "when": "editorLangId =~ /^loment/",
          "group": "loment@1"
        },
        {
          "command": "loment.run",
          "when": "editorLangId =~ /^loment/",
          "group": "loment@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "loment.run",
          "when": "editorLangId =~ /^loment/",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "package": "python ../../tools/vscode_ext.py --emit ../../loment/build/loment-vscode.vsix"
  }
}
