module ex

choose runtime

use num

fn print_dec(v: u32) {
    let b: ptr = alloc(16);
    let n: u32 = num_to_dec(b, v);
    syscall4(1, 1, b as u64, n as u64);
}

fn print_nl() {
    syscall4(1, 1, str_ptr("
") as u64, str_len("
") as u64);
}

enum Op {
    Add,
    Mul(u32),
}

fn apply(op: Op, n: u32) -> u32 {
    match op {
        Op::Add => { return n + 1; }
    }
}

fn _start() {
    print_dec(apply(Op::Mul(6), 7));
    print_nl();
    syscall4(60, 0, 0, 0);
}
