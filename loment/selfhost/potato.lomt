// loment/selfhost/potato.lomt — 自举侧的 **Potato v5 形式对象**发射 (docs/189 S1)
//
// 对照面是 `tools/lomentc.py::emit_potato`(3610 行起): 同一份源, 参考实现发的对象与这里
// 发的必须**逐字节相同**(`tools/loment_potato_emit_test.py`)。判据不是"长得差不多" ——
// 形式对象是**跨线契约的那一侧**(docs/147 承诺过旧版可回放), 差一个字节就是两个对象。
//
// ## 它读什么
//
// **读 token 流与开关表**, 不读源码、不重新解析。这有三条理由:
//
//   * 走到这里时单元**已经检查过了**(`check_arena` 返回 0 条诊断), 所以"顶层 `fn` 就是
//     一个函数声明"这件事是检查器担保的, 不需要再判一次;
//   * 参考实现的 `emit_potato` 也是**在 AST 上取格**, 不是重新扫源; 两边要对齐的
//     "什么叫一个声明"就只有**深度 0**这一条;
//   * 检查器的符号表(`chk_arena_syms`)里**没有**这一格要的锚点 —— 它按需重扫
//     (aux 只记 `(`/`{` 的下标), 而 `generics` 要的类型形参在名字与 `{` 之间。既然
//     两边都要回 token 流, 就**只回 token 流**, 免得维护两套声明视图。
//
// ## 边界: 子集之外**点名拒绝**, 绝不静默发错
//
// 现在覆盖的是"依赖 + 根 + 预置块"、trait/impl、**泛型的单态化**(M6 函数 + M7 类型，
// **M6 跑到不动点**、**M7 支持嵌套实参**)、`layouts`(读 `lom/*.lom` 并解析它的 `record`)、
// 以及全部标量视图那一大片；**还拒**的是**一件事**：
//
//   1. **外部代码块 / 方言**(`bodies` / `dialects`)—— 由**驱动器**拒: 外部代码块在检查
//      **之前**就被它拒了; 而方言那一格只有它知道"这次 `comefor` 展开过没有"(走到这里
//      token 流上那两类词已经没了)。
//
// （曾经还有第二档「泛型类型实例化的实参不是裸类型名」—— **2026-09-23 收掉了**，
//   见下面"已闭合"的第四条。）
//
// **已闭合的四条**（列在这里，免得有人照旧清单去查）：
//
//   * **`layout` / L0**(`layouts`)—— 2026-09-22 做掉（`pt_l0_*` + `pt_layouts`），
//     `use "lom/fujr.lom"` 的 `demo.lomt` 已进覆盖。
//   * **泛型实参是字段访问**(`max(p.a, p.b)`)—— 2026-09-23 做掉（`pt_field_arg_ty`）：
//     按**字段**类型推；泛型 struct 的字段类型**就是那个类型形参**时，换成**声明处写的
//     实参** —— 那一段 token 本来就在单元里，**指回去即可**（不造新串，省掉一整套暂存）。
//     `p[0]` / `f(x)` 仍然不定、点名拒。
//   * **链式泛型**(泛型函数体里再调泛型函数)—— 2026-09-23 做掉。原先只走单元本体一趟，
//     会把实参类型当成 `T` 造出 `pick_T` 那种**发得出去但是错的**实例名，所以点名拒。
//     现在与参考实现（`prepare` 的 M6）**同构**：走单元里的**非泛型**声明，再逐轮走
//     **新建实例的体**（形参类型按实参换掉），跑到不动点 —— `pick_u32` 就是这么推出来的。
//     顺序也要对上：参考实现"每轮过一遍池子、只走没走过的"＝这里"每轮走上一轮新建的"，
//     而实例的创建顺序是逐字节判据的一部分。见 `pt_mono_all` / `pt_mono_inst`。
//     ⚠ 顺带补上的一格：`K as T` 的 K **原先只认标识符**（kind 0），于是 `1 as u32`
//     这种字面量实参落到"实参形态超出这一节"上 —— `native_chain.lomt` 的 `main` 正是
//     那么写的，只是它以前排在 `REFUSED` 里，碰不到。
//   * **嵌套泛型实参**(`Outer<Inner<u32>>`)—— 2026-09-23 做掉。**规则先定，代码后写**：
//     `docs/147` §2「命名层」定下"**分隔的长度 = 嵌套深度**"（`Outer_Inner__u32`），
//     这样它与**两实参**的 `Outer<Inner, u32>`（`Outer_Inner_u32`）不撞名。三个实现点：
//     `pt_tname` 按深度给分隔（旧写法是"`<` 与 `,` 一律换一个 `_`"，嵌套会拼出
//     `Outer_Inner_u32>`）、`pt_key_args_simple` 放行 `<`/`>`、`pt_inst_tk` 写 `instances[].args`
//     时**查表改名**（`Inner<u32>` → `Inner_u32` —— 形式对象要求实参是合法类型串）。
//     ⚠ 定规则**之前**，**参考实现自己也发不出来**：它拼的 `Outer_Inner<u32>` 不是标识符，
//     被它**自己的**校验器拒掉（三种形状崩法一样）。所以那一格当时**不是**"自举侧差一轮"，
//     是**格式没定义**。夹具 `loment/examples/nested_gen/main.lomt` 现在在**覆盖**里。
//
// 关于泛型那两个**不在**上面的清单里(M6/M7 已经落地): `generics`(声明那一格) +
// `instances`(实例那一格) + 签名/字段/载荷里的**改名**(`Pair<u32>` → `Pair_u32`)。
// 改名走"渲完查表"(见"M7 的查表那半"), 实例的创建顺序按 `sorted(refs)` 排过
// (`pt_sort_pool`) —— 那一条不排就会在"同类两个实例"时分叉。
//
// 拒绝是**打到 stderr 的一句话 + 返回 0**, 由驱动器翻成退出码 1 —— 与"超限报错,
// 绝不静默丢"是同一处纪律(那个词用在 `MAX_USE` / `MAX_CHOOSE` 上)。
//
// ## 单元的形状: **依赖在前, 根在后**
//
// 这是实测的(同一份源喂两个实现, IR 里被依赖者的函数排在根前面 —— 与
// `lomentc.resolve_deps` 的"被依赖者在前"同序), 而 `driver.lomt` 里两处注释有一处是错的:
//
//     依赖1 依赖2 … 根 预置块?
//
// 所以"根在哪" = **最后一个 `module` 标记**(它是 `__prelude` 时取前一个), 而 `unit` 取的是
// **根**那个名字。Potato 的那些格**只描述根单元**(参考实现的 `mod` 是根), 依赖只以
// `imports` 的名字出现 —— 每一格的范围都由 `pt_root_range` 划的那两个数说了算。
//
// 例外: `switches` 是**整个程序**的表(参考实现走 `load_unit` 时带开关预扫), 所以它不收范围。
//
// ## 与参考实现对齐时**最容易漏的三处**
//
//   * `unit` 是源里的 **`module` 名**, 不是文件名: `switch.lomt` 的 unit 是 `switchex`。
//   * `functions` **不含 `extern fn`** —— 参考实现把它收在 `mod.externs` 里, 与本体函数
//     分开; 而检查器两种都登记成 `K_FN`, 所以"名字前面两位是不是 `extern`"是这一格
//     唯一的判据。
//   * 枚举/结构体体里的分隔符 **`,` 与 `;` 都算**, 而 `<...>` / `[...]` / `(...)` 里的
//     逗号**不算** —— 否则 `Result<T, E>` 会被数成两个变体。
module potato
choose runtime

use bytes
use switches
// v10 的 `gc_ladder`（`docs/210` §3/§5）要**四层梯的谓词**（L0/L1/L2 的资格），而那三条
// 与 `codegen.lomt` 的发射路径是同一条 —— 所以**共用**它们（`l0_size_at` / `l1_ptr_only_at`
// / `l2_ok_at` / `l0_safe_callee`，那边已 `pub`）。不复制一份的理由：复制必然漂，而这三条
// 已经由 IR 逐字节比对钉住与参考实现一致（`loment_p8_test` 的 m88/m89/m91）。
use codegen

/// 无符号里当"哨兵"用。token 下标从 0 起, 这个值不可能撞上 (与 `switches.SW_NONE` 同形)。
const PT_NONE: u32 = 4294967295;

// ---------------------------------------------------------------- 输出原语
//
// 游标**显式回传**(不是状态块): 这个文件里每一处写都很短, 显式回传比"mem 里存一格"
// 少一层间接, 调用点也能一眼看出顺序。返回值就是"新游标"。

fn pt_ind(out: ptr, o: u32, n: u32) -> u32 {
    let k: u32 = 0;
    while k < n * 2 {
        store8(out, o, 32 as u8);
        o = o + 1;
        k = k + 1;
    }
    return o;
}

fn pt_str(out: ptr, o: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(out, o, str_byte(s, i) as u8);
        o = o + 1;
        i = i + 1;
    }
    return o;
}

fn pt_mem(out: ptr, o: u32, src: ptr, off: u32, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(src, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    return o;
}

/// 十进制。**不用暂存**: 先倒着写进输出缓冲再**原地反转**。
/// 这个文件只拿得到两个缓冲(输出 / 单元), 而那些 `const` 偏移是**全局**的
/// (别的模块也用那块 mem), 不能借 —— 借了就与 `wdec` / codegen 的 `scratch_buf` 抢。
///
/// 参数是 **u64** 而不是 u32: `const` 的值可以是 u64(参考实现那边的库里就有
/// `14695981039346656037` 这种), 按 u32 累加会**发出一个回绕过的数**而一声不响。
fn pt_dec(out: ptr, o: u32, v: u64) -> u32 {
    let st: u32 = o;
    let x: u64 = v;
    if x == 0 {
        store8(out, o, 48 as u8);
        return o + 1;
    }
    while x > 0 {
        store8(out, o, (48 + (x % 10) as u32) as u8);
        o = o + 1;
        x = x / 10;
    }
    let n: u32 = o - st;
    let i: u32 = 0;
    while i < n / 2 {
        let a: u32 = load8(out, st + i) as u32;
        let b: u32 = load8(out, st + n - 1 - i) as u32;
        store8(out, st + i, b as u8);
        store8(out, st + n - 1 - i, a as u8);
        i = i + 1;
    }
    return o;
}

fn pt_hex1(out: ptr, o: u32, v: u32) -> u32 {
    if v < 10 {
        store8(out, o, (48 + v) as u8);
    } else {
        store8(out, o, (97 + v - 10) as u8);
    }
    return o + 1;
}

/// `\u00XX` —— `json.dumps` 对 < 0x20 的其余控制字符就是**十六进制小写**两位。
fn pt_uesc(out: ptr, o: u32, c: u32) -> u32 {
    o = pt_str(out, o, "\\u00");
    o = pt_hex1(out, o, c / 16);
    return pt_hex1(out, o, c % 16);
}

/// `src[off..off+n]` 按 **JSON 字符串**写出(含两侧引号)。
///
/// 转义面与 `json.dumps(ensure_ascii=False)` 一致: `"` `\` `\b` `\f` `\n` `\r` `\t` 与
/// 其余 `< 0x20` 走 `\u00XX`; **>= 0x80 的字节原样过** (ensure_ascii=False 就是不做这件事)。
/// 标识符/类型名走这条路是恒等变换(词法器只收 ASCII 字母数字下划线), 但**不能省**:
/// `excluded` 的字符串是**任意字节**。
fn pt_q(out: ptr, o: u32, src: ptr, off: u32, n: u32) -> u32 {
    store8(out, o, 34 as u8);
    o = o + 1;
    let i: u32 = 0;
    while i < n {
        let c: u32 = load8(src, off + i) as u32;
        if c == 34 {
            o = pt_str(out, o, "\\\"");
        } else if c == 92 {
            o = pt_str(out, o, "\\\\");
        } else if c == 8 {
            o = pt_str(out, o, "\\b");
        } else if c == 12 {
            o = pt_str(out, o, "\\f");
        } else if c == 10 {
            o = pt_str(out, o, "\\n");
        } else if c == 13 {
            o = pt_str(out, o, "\\r");
        } else if c == 9 {
            o = pt_str(out, o, "\\t");
        } else if c < 32 {
            o = pt_uesc(out, o, c);
        } else {
            store8(out, o, c as u8);
            o = o + 1;
        }
        i = i + 1;
    }
    store8(out, o, 34 as u8);
    return o + 1;
}

/// 字面量(本文件自己写的那几个: `v5` / `loment` / `std` / `type` …)。
fn pt_qs(out: ptr, o: u32, s: str) -> u32 {
    store8(out, o, 34 as u8);
    o = o + 1;
    o = pt_str(out, o, s);
    store8(out, o, 34 as u8);
    return o + 1;
}

fn pt_bool(out: ptr, o: u32, v: u32) -> u32 {
    if v == 0 {
        return pt_str(out, o, "false");
    }
    return pt_str(out, o, "true");
}

// ---- JSON 骨架: 四个动作凑出 `json.dumps(indent=2)` 的形状。
//
// 缩进是 **2*层**, 层号自己数。四个动作分别是: 键 / 数组开头 / 数组元素行首 / 数组收尾。
// 空数组写 `[]`(与 Python 一致), 所以 `pt_aopen` 与 `pt_acls` 都**要条数**。

fn pt_key(out: ptr, o: u32, lv: u32, k: str) -> u32 {
    o = pt_ind(out, o, lv);
    o = pt_qs(out, o, k);
    return pt_str(out, o, ": ");
}

fn pt_aopen(out: ptr, o: u32, n: u32) -> u32 {
    if n == 0 {
        return pt_str(out, o, "[]");
    }
    return pt_str(out, o, "[\n");
}

/// 数组第 `ix` 个元素的**行首**(非首元素先补 `,\n`)。
fn pt_aelm(out: ptr, o: u32, lv: u32, ix: u32) -> u32 {
    if ix > 0 {
        o = pt_str(out, o, ",\n");
    }
    return pt_ind(out, o, lv);
}

/// 数组收尾 —— 闭括号与**键**同层(`lv` 是键那一层的层号)。空数组不写。
fn pt_acls(out: ptr, o: u32, lv: u32, n: u32) -> u32 {
    if n == 0 {
        return o;
    }
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, lv);
    return pt_str(out, o, "]");
}

// ---------------------------------------------------------------- token 工具
//
// 单元里到处都是 `"fn"` / `"impl"` / `"module"` 这类**字符串**(关键字表、本文件自己的
// 字面量), 只比原文会把它们当成声明。参考实现没有这个坑, 因为它的 parser 用
// (kind, val) 一起判 —— 自举这边把那条纪律收进 `pt_tis`: **字符串 token 一律不匹配**。

fn pt_kind(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20);
}

fn pt_off(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 4);
}

/// token 的字节长度。**字符串 token 含两侧引号** —— 这是自举词法器的口径, 与参考侧
/// `Tok.val`(**不含**引号)不同。要字符串的内容就自己 `+1 / -2`。
fn pt_tlen(t: ptr, i: u32) -> u32 {
    return load32(t, i * 20 + 8);
}

fn pt_tis(src: ptr, t: ptr, i: u32, s: str) -> bool {
    if load32(t, i * 20) == 2 {
        return false;
    }
    let n: u32 = str_len(s);
    if load32(t, i * 20 + 8) != n {
        return false;
    }
    let off: u32 = load32(t, i * 20 + 4);
    let k: u32 = 0;
    while k < n {
        if (load8(src, off + k) as u32) != (str_byte(s, k) as u32) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// `src[off..off+n]` 里有字节 `c` 吗(只用于那条"字符串里有转义就拒绝"的判据)。
fn pt_has_byte(src: ptr, off: u32, n: u32, c: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if (load8(src, off + i) as u32) == c {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 拒绝出口

/// 说一句话到 stderr 并返回 0。**返回 0 就是"没发出东西"**, 由调用方翻成退出码 1。
///
/// 前缀在这儿写死, 与驱动主路的 `fail` 同一个 `loment` —— 用户敲的是那个命令,
/// `fujoc-s` 是自举驱动的旧内部名, 对装包的人不指向任何东西 (issue #8)。
fn pt_wfail(msg: str) -> u32 {
    let pre: str = "loment: ";
    let _a: i64 = syscall4(1, 2, str_ptr(pre) as u64, str_len(pre) as u64);
    let _w: i64 = syscall4(1, 2, str_ptr(msg) as u64, str_len(msg) as u64);
    let nl: str = "\n";
    let _n: i64 = syscall4(1, 2, str_ptr(nl) as u64, str_len(nl) as u64);
    return 0;
}

// ---------------------------------------------------------------- 单元的形状

/// 根单元在 token 流里的**范围** —— 返回 `(起点 << 32) | 结束`(结束不含)。
///
/// 驱动器手上的单元是"依赖 + 根 + 预置枚举"拼在一起的一个 token 流, 而 Potato 的那些格
/// **只描述根单元**(参考实现的 `mod` 是根)。**依赖在前**, 这是实测的(一个 `use` 的单元,
/// IR 里被依赖者的函数排在根前面, 与 `lomentc.resolve_deps` 的"被依赖者在前"同序):
///
///     依赖1 依赖2 … 根 预置块?
///
/// 所以"根在哪" = **最后一个 `module` 标记**(每份源都有自己的 `module`, 这是唯一的分界物);
/// 而它正好是注入的预置块(`append_prelude` 那段, 名字就是 `__prelude`)时, 根是**前一个**。
fn pt_root_range(unit: ptr, t: ptr, nt: u32) -> u64 {
    let last: u32 = 0;
    let prev: u32 = 0;
    let seen: u32 = 0;
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "module") {
            prev = last;
            last = i;
            seen = seen + 1;
        }
        i = i + 1;
    }
    if seen == 0 {
        return PT_NONE as u64;
    }
    if seen >= 2 && pt_tis(unit, t, last + 1, "__prelude") {
        return (prev as u64) * 4294967296 + (last as u64);
    }
    return (last as u64) * 4294967296 + (nt as u64);
}

/// 依赖的条数 = 根之前的那几个 `module` 标记。
fn pt_cnt_imports(unit: ptr, t: ptr, lo: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = 0;
    while i < lo && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "module") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `imports`: 依赖单元的名字, **按依赖序**(参考实现是 `[d.name for d in deps]`)。
fn pt_imports(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let i: u32 = 0;
    while i < lo && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "module") {
            o = pt_aelm(out, o, 2, ix);
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 子集之外的构造 —— 返回**给用户看的一句话**(空串 = 在子集里)。
///
/// **分两段扫**，因为两类东西的作用域不一样：
///
/// * **自己那一半**（`[lo, hi)` = 根单元）—— trait/impl、泛型类型的用法、`excluded` 的转义：
///   它们只影响**根**那几格（参考实现的 `mod` 是根，依赖的声明根本不进对象）。
/// * **整个单元**（除预置块）—— 泛型**声明**：根的函数签名里出现一个**依赖声明的**泛型类型
///   （`fn f() -> Pair<u32>` 而 `Pair` 在依赖里）时，`prepare` 照样会把 `f.ret` 改写成
///   `Pair_u32`。所以这条不能只看根那一半。
///
/// 预置块（`__prelude`）自己带 `<T>`，两段都要跳过它 —— 否则每个单元都被拒。
fn pt_refuse(unit: ptr, t: ptr, lo: u32, hi: u32, pre: u32, nt: u32) -> u32 {
    if !pt_tis(unit, t, 0, "module") {
        let _w0: u32 = pt_wfail("--emit-potato: the unit does not start with `module` (the reference implementation's front door has the same rule)");
        return 1;
    }
    // ---- 整个单元(除预置块): 泛型声明 + L0 布局
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if !(pre != PT_NONE && i >= pre) {
            // 泛型**类型**的声明这一条**已经放行**（M7 落进 `pt_collect` + `pt_tmap_build`）：
            // 声明本身不再拒，实例化做不出来时由那两步**指名拒**（实参不是裸类型名那一档）。
            // L0 布局 (`use "xxx.lom"`) **放行**了：`layouts` 由 M-L0 那一节自己做
            // （自己读文件 + 按字节解析 `record`）—— 读不下或解析不了在那里点名拒。
        }
        i = i + 1;
    }
    // ---- 根那一半: trait/impl、泛型类型用法、excluded 的转义
    let d: u32 = 0;
    i = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 {
            // 泛型**类型**的用法 (`Result<u32, u32>`) 也**放行**了：改名（`Result_u32_u32`）
            // 由 `pt_tymq` 那一层查表做掉, 实例那一格由 `pt_inst_tk` 补。
            // `excluded` 的字符串里有反斜杠: 自举词法器**不替我们解转义**(参考实现解),
            // 照抄出去就是两个实现的字节不一样 —— 与其发错, 不如点名。
            if pt_tis(unit, t, i, "excluded") && pt_kind(t, i + 1) == 2 {
                if pt_has_byte(unit, pt_off(t, i + 1) + 1, pt_tlen(t, i + 1) - 2, 92) == 1 {
                    let _w5: u32 = pt_wfail("--emit-potato: an `excluded` string carries a `\\` escape -- the self-hosted lexer does not decode escapes, so this slot is not done yet");
                    return 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `src[off..off+4]` 是 `s` 吗(不用 token 表 —— 给"字符串 token 的后缀"用)。
fn pt_mem_is(src: ptr, off: u32, s: str) -> u32 {
    let i: u32 = 0;
    while i < str_len(s) {
        if (load8(src, off + i) as u32) != (str_byte(s, i) as u32) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// ---------------------------------------------------------------- 数字与配对

/// 整数 token → 十进制。参考实现的对象里 `0x10` 也是 `16`(`int_lit` 先解成 int)。
///
/// 前面可以有 `-`(`int_lit` 允许): 那不是 u32 表示得出来的数, 所以**分开写**负号与数值
/// —— 直接按 u32 累加会发出 4294967295 这种数, 而参考实现发的是 `-1`。
fn pt_num(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    let neg: u32 = 0;
    if pt_tis(src, t, j, "-") {
        neg = 1;
        j = j + 1;
    }
    let st: u32 = pt_off(t, j);
    let ln: u32 = pt_tlen(t, j);
    let hex: u32 = 0;
    let k: u32 = 0;
    if ln > 2 && load8(src, st) == 48
            && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        hex = 1;
        k = 2;
    }
    let v: u64 = 0;
    while k < ln {
        let c: u32 = load8(src, st + k) as u32;
        let dg: u32 = 0;
        if c >= 48 && c <= 57 {
            dg = c - 48;
        } else if c >= 97 && c <= 102 {
            dg = c - 97 + 10;
        } else if c >= 65 && c <= 70 {
            dg = c - 65 + 10;
        }
        if hex == 1 {
            v = v * 16 + (dg as u64);
        } else {
            v = v * 10 + (dg as u64);
        }
        k = k + 1;
    }
    if neg == 1 {
        store8(out, o, 45 as u8);
        o = o + 1;
    }
    return pt_dec(out, o, v);
}

/// 这个数字 token 的**量级**超过 u64 吗(1 = 超了)。
///
/// 参考实现的 `int_lit` 是**任意精度**(Python 的 int), 而这里只到 u64 —— 超了就得
/// 点名, 不能发一个回绕过的数(`std/num.lomt` 里 `4294967296` 那种 u32 装不下的值
/// **是真实存在的**, 实测就是这么撞出来的)。
///
/// **只比原文不解值**: 去掉 `-` 与 `0x` 前缀、跳过前导零之后 ① 位数多的一定更大;
/// ② 位数相同的按字节与上限逐位比(同位数时字典序 == 数值序, 十六进制统一小写)。
fn pt_num_ovf(src: ptr, t: ptr, i: u32) -> u32 {
    let j: u32 = i;
    if pt_tis(src, t, j, "-") {
        j = j + 1;   // 负号不看: 判的是**量级**
    }
    let st: u32 = pt_off(t, j);
    let ln: u32 = pt_tlen(t, j);
    let hex: u32 = 0;
    let b: u32 = 0;
    if ln > 2 && load8(src, st) == 48
            && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        hex = 1;
        b = 2;
    }
    while b + 1 < ln && load8(src, st + b) == 48 {
        b = b + 1;
    }
    let nd: u32 = ln - b;
    let lim: u32 = 20;
    let cap: str = "18446744073709551615";
    if hex == 1 {
        lim = 16;
        cap = "ffffffffffffffff";
    }
    if nd > lim {
        return 1;
    }
    if nd < lim {
        return 0;
    }
    let k: u32 = 0;
    while k < lim {
        let c: u32 = load8(src, st + b + k) as u32;
        if c >= 65 && c <= 70 {
            c = c + 32;
        }
        let q: u32 = str_byte(cap, k) as u32;
        if c > q {
            return 1;
        }
        if c < q {
            return 0;
        }
        k = k + 1;
    }
    return 0;
}

/// `i` 指向 `lo` 时, 返回配对的 `hi` 的下标(不配对时停在 eof 附近 —— 调用方靠
/// `pt_kind != 4` 兜住; 走到这里时单元已经检查过了, 括号是配平的)。
fn pt_match(src: ptr, t: ptr, i: u32, lo: str, hi: str) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while pt_kind(t, j) != 4 {
        if pt_tis(src, t, j, lo) {
            d = d + 1;
        }
        if pt_tis(src, t, j, hi) {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

// ---------------------------------------------------------------- 计数
//
// 每一格都要先知道条数才能写 `[]` 还是 `[\n`, 所以计数与发射各走一遍 token 流。
// 计数都很短(深度 0 扫一遍), 换来的是"发到一半才发现要回退"这种形状不会出现。

/// 深度 0 上某个关键字 token 的个数。`{` `}` `(` `)` `[` `]` 计深度。
///
/// 深度 0 就是"顶层": 走到这里时单元已经检查过, 而且 trait/impl/外部代码块都在
/// `pt_refuse` 里拒掉了, 所以顶层 `fn`/`struct`/`enum`/`const`/`capability`/`excluded`
/// 与各自的声明是**一一对应**的。函数体里的词不计数, 全靠这个深度。
fn pt_cnt_kw0(unit: ptr, t: ptr, lo: u32, hi: u32, kw: str) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, kw) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 这个深度 0 的 `fn` 是不是**本体函数**(不是外部函数声明)。
///
/// 参考实现的 `functions` 收的是 `mod.funcs`, 而 `extern fn` 另走 `mod.externs`
/// (`docs/173`) —— 裸机那几个门面里 `pub extern fn` 一片, 混进去就是两个对象。
/// 形状是固定的: 名字前面一位是 `fn`, 再前面一位就是修饰词。**`interrupt fn` 要算本体**
/// (它进的是 `mod.funcs`), 所以只认 `extern`。
fn pt_is_body_fn(unit: ptr, t: ptr, i: u32) -> u32 {
    if i < 2 {
        return 1;
    }
    if pt_tis(unit, t, i - 2, "extern") {
        return 0;
    }
    return 1;
}

/// `impl T for X` 里 `for` 的下标(没有就 `PT_NONE`)。`for` 之后才是接受者类型。
fn pt_find_for(unit: ptr, t: ptr, i: u32, hi: u32) -> u32 {
    let j: u32 = i;
    while j < hi && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "for") {
            return j;
        }
        j = j + 1;
    }
    return PT_NONE;
}

/// 本体函数个数(深度 0 的 `fn`, 减掉 `extern fn`) —— 见 `pt_cnt_fn` 上的说明。
fn pt_cnt_fn(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let its: u32 = PT_NONE;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
                if d == 0 {
                    its = PT_NONE;
                }
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            let ft: u32 = pt_find_for(unit, t, i + 1, hi);
            if ft != PT_NONE {
                its = ft + 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "register")
                && (pt_kind(t, i + 1) == 0 || pt_kind(t, i + 1) == 2)
                && pt_tis(unit, t, i + 2, "{") {
            // `register <名字> { <那个函数> }`（`docs/223` 形态 A）：那层壳是**透明的** ——
            // 块里的函数在语义上就是顶层条目（参考实现按 AST 收，根本没有这一层）。
            // 跳过 `register` 与名字，下一轮就落在 `{` 的**下一个** token 上，深度不动；
            // 块的 `}` 落在 d == 0 上，被上面那条 `&& d > 0` 挡住，不会把深度打成负数。
            // 块里**只允许一个函数**（形状那一关在 `lex_reg_one_fn`，两个实现同一份规则），
            // 所以跳过壳就够了，不必为别的条目再开一条路。
            i = i + 2;
        } else if pt_tis(unit, t, i, "fn") && (d == 0 || (d == 1 && its != PT_NONE)) {
            if d == 0 && pt_is_body_fn(unit, t, i + 1) == 0 {
                // `extern fn` 不进 `functions`(参考实现收在 `mod.externs`)
            } else if pt_tis(unit, t, i + 2, "<") {
                // 泛型**原件**不进 `functions` —— 它只进 `generics`, 实例由单态化追加
            } else {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// 枚举/结构体声明体 `{...}` 里"名字位置"的个数。
///
/// 状态机与检查器的 `chk_sfield_exists` 同形: **`, ` 与 `;` 都是分隔符**, 而
/// `<...>` / `[...]` / `(...)` 里的逗号不是 —— 否则 `Result<T, E>` 会被数成两个变体。
fn pt_cnt_names(unit: ptr, t: ptr, brc: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let n: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            n = n + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return n;
}

/// 带载荷的变体个数(参考实现只在这时候才写 `payloads` 这个键)。
fn pt_cnt_pay(unit: ptr, t: ptr, brc: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let n: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            if pt_tis(unit, t, j + 1, "(") {
                n = n + 1;
            }
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return n;
}

/// `guards`: 参考实现数的是 `_count_guards` —— **函数体里**的 `guard` 语句, 递归走
/// if/while/for/match 的体。token 流上就是"`guard` 后面跟一个名字再跟 `(`":
/// `let guard: u32` 那种(名字后面是 `:`)不算, 而 guard 语句的 `(` 是形状的一部分。
///
/// 不数整个单元而是数**根那一半**: 预置块里没有语句, 这不是必需 —— 是为了与"根单元
/// 才是被描述的那一个"这条口径一致。
fn pt_cnt_guards(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "guard")
                && pt_kind(t, i + 1) == 0 && pt_tis(unit, t, i + 2, "(") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 两个 token 的**文本**相不相同（都是 ident 才有意义; 字符串 token 直接说不相同）。
fn pt_tok_eq(src: ptr, t: ptr, a: u32, b: u32) -> bool {
    if load32(t, a * 20) == 2 || load32(t, b * 20) == 2 {
        return false;
    }
    let n: u32 = load32(t, a * 20 + 8);
    if n != load32(t, b * 20 + 8) {
        return false;
    }
    let oa: u32 = load32(t, a * 20 + 4);
    let ob: u32 = load32(t, b * 20 + 4);
    let k: u32 = 0;
    while k < n {
        if load8(src, oa + k) != load8(src, ob + k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// 数"名字是第 `nm` 个 token 的那个标识符被**调用**了几次"（`docs/205` R5 的口径）。
///
/// 两条与参考实现逐字对齐的规则:
///   * 下一个 token 是 `(` —— 空白与注释在词法流上本来就不在, 所以不必跳;
///   * **上一个 token 不是 `fn`** —— `fn NAME(` 是**声明**, 不是调用。少了这一条,
///     谁定义了一个叫 `ptr_add` 的函数就会凭空多出一次"越界"。
///     `i == lo` 时前面没有本单元的 token, 照数（参考实现走的是根模块, 同理）。
fn pt_cnt_boundary_named(unit: ptr, t: ptr, lo: u32, hi: u32, nm: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tok_eq(unit, t, i, nm) && pt_tis(unit, t, i + 1, "(")
                && !(i > lo && pt_tis(unit, t, i - 1, "fn")) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 数**固定名字**的调用点（`syscall4` / `ptr_add` …）—— 名字是字面量, 不进 token 表。
fn pt_cnt_boundary_call(unit: ptr, t: ptr, lo: u32, hi: u32, name: str) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, name) && pt_tis(unit, t, i + 1, "(")
                && !(i > lo && pt_tis(unit, t, i - 1, "fn")) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `extern fn NAME` 的**声明数**（每一条都算, 同名写两次就是两条 —— 与参考实现的
/// `len(mod.externs)` 同一个口径）。
fn pt_cnt_boundary_extdecls(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i + 2 < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "extern")
                && pt_tis(unit, t, i + 1, "fn") && pt_kind(t, i + 2) == 0 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `extern fn NAME` 的**调用点**数: 每声明一次, 就按那个名字数一遍它的调用点。
/// 于是"同名声明两次"会数两遍 —— 与参考实现的 `sum(count(nm) for nm in externs)` 一致。
fn pt_cnt_boundary_extcalls(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i + 2 < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "extern")
                && pt_tis(unit, t, i + 1, "fn") && pt_kind(t, i + 2) == 0 {
            n = n + pt_cnt_boundary_named(unit, t, lo, hi, i + 2);
        }
        i = i + 1;
    }
    return n;
}

// ---------------------------------------------------------------- 面的组成 (docs/224, v12)
//
// v12 的 `surfaces`：把**机调用站点**按"面"分一分。**与参考实现的 `_count_surfaces` 数
// 同一批站点** —— 口径是词法的：只看 `syscall4/6/7` 的第一个实参**写没写成字面量**，
// 是字面量就查表得面名（查不到落 `other`），不是字面量也落 `other`。
// 表（号 → 面）与参考实现 `lomentc.SURFACE_NUMBERS` 的一致由两处钉住：
// `loment_pe_test::test_surface_table_matches_the_runtime`（表本身）与
// `loment_potato_emit_test`（42 份单元的逐字节孪生 —— 数不对当场对不上）。

/// 号 → 面代号：0=other 1=file 2=mem 3=net 4=proc。**代号只为分桶**，名字在发射处。
fn pt_surf_code(num: u32) -> u32 {
    if num == 0 || num == 1 || num == 3 || num == 217 || num == 257 || num == 262 {
        return 1;                                   // file
    }
    if num == 12 {
        return 2;                                   // mem
    }
    if num == 7 || num == 23 || num == 41 || num == 42 || num == 43 || num == 44 || num == 45
            || num == 48 || num == 49 || num == 50 || num == 51 || num == 52
            || num == 54 || num == 55 || num == 288
            || num == 46 || num == 47 || num == 53 || num == 232 || num == 233 || num == 291 {
        return 3;                                   // net
    }
    if num == 60 {
        return 4;                                   // proc
    }
    return 0;                                       // other（含"号不是字面量"）
}

/// 数字 token 的十进制 / `0x` 十六进制值；不是数字 token（或写法不认识）返回 `4294967295`。
/// **与参考实现同口径**：那边读 `IntLit.value`（十进制与 `0x` 都认）；一个**负号**在两边
/// 都会落 `other` —— 这边因为 `-` 是个 punct token，根本不是数字 token。
fn pt_tok_num(unit: ptr, t: ptr, i: u32) -> u32 {
    if pt_kind(t, i) != 1 {
        return 4294967295;
    }
    let p: u32 = pt_off(t, i);
    let n: u32 = pt_tlen(t, i);
    if n == 0 {
        return 4294967295;
    }
    let k: u32 = 0;
    let v: u32 = 0;
    if n >= 2 && load8(unit, p) == 48 && (load8(unit, p + 1) == 120 || load8(unit, p + 1) == 88) {
        k = 2;
        while k < n {
            let c: u32 = load8(unit, p + k);
            let d: u32 = 4294967295;
            if c >= 48 && c <= 57 {
                d = c - 48;
            } else if c >= 97 && c <= 102 {
                d = c - 97 + 10;
            } else if c >= 65 && c <= 70 {
                d = c - 65 + 10;
            }
            if d == 4294967295 {
                return 4294967295;
            }
            v = v * 16 + d;
            k = k + 1;
        }
        return v;
    }
    while k < n {
        let c: u32 = load8(unit, p + k);
        if c < 48 || c > 57 {
            return 4294967295;                      // 不猜
        }
        v = v * 10 + (c - 48);
        k = k + 1;
    }
    return v;
}

/// 号 → 宽度档代号：0=`w0` 1=`w1` 2=`w2` 3=`w3`。**非联网号返回 `4294967295`** ——
/// 与 `pt_surf_code` 的 `other` 不同：梯子上**没有兜底档**，它只回答"联网的那部分按宽度
/// 怎么分"（`docs/237`）。返回一个哨兵而不是 0，是为了让"不是联网号"与"最窄那档"分开。
///
/// **定义在 `pt_surf_count` 之前**：那个循环要调它，而自举侧**没有前向引用**。
fn pt_rung_code(num: u32) -> u32 {
    if num == 53 {
        return 0;                                   // w0：同机的一对端点
    }
    if num == 41 || num == 42 || num == 44 || num == 45 || num == 46 || num == 47
            || num == 48 || num == 51 || num == 52 || num == 54 || num == 55 {
        return 1;                                   // w1：一条有界连接
    }
    if num == 7 || num == 23 || num == 232 || num == 233 || num == 291 {
        return 2;                                   // w2：多条并发
    }
    if num == 49 || num == 50 || num == 43 || num == 288 {
        return 3;                                   // w3：接受任意对端
    }
    return 4294967295;
}

/// 名字 `name` 的调用点里、"第一个实参是字面量且 `table` 那张表分到的桶 == `code`"的个数。
/// 判据与 `pt_cnt_boundary_call` 同一套：名字 token + 紧跟 `(` + 不是 `fn NAME(` 那个声明。
/// `table`：0 = 面（`docs/224`），1 = 宽度档（`docs/237`）—— **同一个循环服务两张表**，
/// 分成两遍就会漂（两边各按自己的口径认号）。
fn pt_surf_count(unit: ptr, t: ptr, lo: u32, hi: u32, name: str, table: u32, code: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, name) && pt_tis(unit, t, i + 1, "(")
                && !(i > lo && pt_tis(unit, t, i - 1, "fn")) {
            let num: u32 = pt_tok_num(unit, t, i + 2);
            let c: u32 = 0;
            if num != 4294967295 {
                if table == 0 {
                    c = pt_surf_code(num);
                } else {
                    c = pt_rung_code(num);
                }
            }
            if c == code {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// 某个面（`code`）在这份单元里的站点数 —— 三个机调用内建各数一遍。
fn pt_surf_total(unit: ptr, t: ptr, lo: u32, hi: u32, code: u32) -> u32 {
    return pt_surf_count(unit, t, lo, hi, "syscall4", 0, code)
         + pt_surf_count(unit, t, lo, hi, "syscall6", 0, code)
         + pt_surf_count(unit, t, lo, hi, "syscall7", 0, code);
}

// ---------------------------------------------------------------- 宽度组成 (docs/237, v14)
//
// v14 的 `net_ladder`：联网站点按"它要求多少宽度"分四档。**与参考实现的
// `lomentc.NET_WIDTH_RUNGS` 同表、同一批站点**（`surfaces.net` 那一批），表的一致由
// 逐字节孪生判据钉住（数不对当场对不上）。表本身（`pt_rung_code`）定义在上面 ——
// 共用的那个计数循环要调它。

/// 某一档（`code`）在这份单元里的站点数 —— 三个机调用内建各数一遍（表选 1）。
fn pt_rung_total(unit: ptr, t: ptr, lo: u32, hi: u32, code: u32) -> u32 {
    return pt_surf_count(unit, t, lo, hi, "syscall4", 1, code)
         + pt_surf_count(unit, t, lo, hi, "syscall6", 1, code)
         + pt_surf_count(unit, t, lo, hi, "syscall7", 1, code);
}

/// 写一个面（名 + 数）；`first` 为 0 时先补一个逗号。**只写非零的那些、按面名字母序**，
/// 与参考实现的 `sorted(counts)` 同口径（两边逐字节要比）。
fn pt_surf_one(out: ptr, o: u32, first: u32, name: str, n: u32) -> u32 {
    if first == 0 {
        o = pt_str(out, o, ",\n");
    }
    o = pt_key(out, o, 2, name);
    return pt_dec(out, o, n as u64);
}

// ---------------------------------------------------------------- GC 的四层梯 (docs/210 §3/§5)
//
// v10 的 `gc_ladder`：本单元每一处 `alloc` 从强到弱、先到先得分到一层。**与参考实现的
// `_count_gc_ladder` 数同一批站点** —— 参考侧从 `Func.l0` / `Func.l1` / 每个循环的 `l2`
// 那几张表上数，这里没有它们，所以按**同一套 token 规则重推**。谓词本身与 `codegen.lomt`
// **共用**（`l0_size_at` / `l1_ptr_only_at` / `l2_ok_at`），那份一致性已由 IR 逐字节比对
// 钉住，于是两边数的是同一套规则的同一个结果。**非 alpha 档**（`572 == 0`）三数恒为 0。

/// `alloc` 调用点总数（`docs/210` §5 第一行的分母）—— 词法口径与 `pt_cnt_boundary_call` 同。
fn pt_gl_total(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    return pt_cnt_boundary_call(unit, t, lo, hi, "alloc");
}

/// 形参**名字**的 token 下标写进 `out`（每格 8 字节，与 codegen 的 `CG_CUR` 同形），回个数。
/// 分组与 `pt_cnt_params` 同形：`,` 在 `<>` / `[]` 里不算分隔。
fn pt_gl_params(unit: ptr, t: ptr, lp: u32, out: ptr) -> u32 {
    let n: u32 = 0;
    let j: u32 = lp + 1;
    let d: u32 = 0;
    let atn: u32 = 1;
    while pt_kind(t, j) != 4 && !(pt_tis(unit, t, j, ")") && d == 0) {
        if atn == 1 && pt_kind(t, j) == 0 {
            store32(out, n * 8, j);
            n = n + 1;
            atn = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && pt_tis(unit, t, j, ",") {
            atn = 1;
        }
        j = j + 1;
    }
    return n;
}

/// `fn`（下标 `i`）之后那个 `(` —— 跳过函数名与 `<...>`。没有就回 `PT_NONE`。
fn pt_gl_lparen(unit: ptr, t: ptr, i: u32, hi: u32) -> u32 {
    let j: u32 = i + 1;
    let d: u32 = 0;
    while j < hi && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "(") && d == 0 {
            return j;
        }
        if pt_tis(unit, t, j, "<") {
            d = d + 1;
        }
        if pt_tis(unit, t, j, ">") && d > 0 {
            d = d - 1;
        }
        j = j + 1;
    }
    return PT_NONE;
}

/// `(`（下标 `lp`）配对的 `)`。没有就回 `PT_NONE`。
fn pt_gl_rparen(unit: ptr, t: ptr, lp: u32, hi: u32) -> u32 {
    let j: u32 = lp;
    let d: u32 = 0;
    while j < hi && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if pt_tis(unit, t, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return PT_NONE;
}

/// `nm` 处的声明在**函数体顶层**吗（`fat` 到 `nm` 之间大括号配平为 0）—— 与 `_l1_place`
/// 的 `depth0 == 0` 同一条。
fn pt_gl_istop(unit: ptr, t: ptr, fat: u32, nm: u32) -> u32 {
    let dep: u32 = 0;
    let z: u32 = fat;
    while z < nm {
        if pt_tis(unit, t, z, "{") {
            dep = dep + 1;
        }
        if pt_tis(unit, t, z, "}") {
            dep = dep - 1;
        }
        z = z + 1;
    }
    if dep == 0 {
        return 1;
    }
    return 0;
}

/// `nm` 落在 `out` 里那 `n` 个范围（`{at, end}`）之内吗 —— L2 的判据。
fn pt_gl_inrange(nm: u32, out: ptr, n: u32) -> u32 {
    let q: u32 = 0;
    while q < n {
        let a: u32 = load32(out, q * 8);
        let b: u32 = load32(out, q * 8 + 4);
        if nm >= a && nm < b {
            return 1;
        }
        q = q + 1;
    }
    return 0;
}

/// 扫出本函数体里**开着纪元的循环体**范围（`docs/210` §2.3 的 L2），成对写进 `out`（`at`,`end`），
/// 回对数。`while` / `for VAR in …` 之后**第一个** `{` 就是体 —— 解析器在循环头里
/// `no_struct`，所以那里不会冒出结构体字面量的 `{`（与 `lomentc` 的 `at = self.i + 1` 同一起点）。
/// **`impl T for X` 里的 `for` 不算**：靠 "`for` 名字 `in`" 这个形状分开。
fn pt_gl_l2ranges(unit: ptr, t: ptr, fat: u32, fend: u32, npar: u32, par: ptr, out: ptr,
                  safe: ptr) -> u32 {
    let n: u32 = 0;
    let i: u32 = fat;
    while i < fend && n < PT_GLRMX {
        let isloop: u32 = 0;
        if pt_tis(unit, t, i, "while") {
            isloop = 1;
        }
        if pt_tis(unit, t, i, "for") && pt_kind(t, i + 1) == 0
                && pt_tis(unit, t, i + 2, "in") {
            isloop = 1;
        }
        if isloop == 1 {
            let b: u32 = i + 1;
            while b < fend && !pt_tis(unit, t, b, "{") && pt_kind(t, b) != 4 {
                b = b + 1;
            }
            if b < fend {
                let at: u32 = b + 1;
                let end: u32 = skip_block(unit, t, b) - 1;
                if l2_ok_at(unit, t, at, end, fat, fend, npar, par, safe) == 1 {
                    store32(out, n * 8, at);
                    store32(out, n * 8 + 4, end);
                    n = n + 1;
                }
            }
        }
        i = i + 1;
    }
    return n;
}

/// 一个函数体里四层各领走几个：回打包 `l0 | (l1 << 16) | (l2 << 32)`（每格 16 位够用）。
///
/// 候选只有一种形状：`let NAME: ptr = alloc(...)`（尺寸不限）且**紧跟 `;`** —— 与
/// `_l1_place` 的 `word(j + 1, ";")` 同一条。归属**从强到弱**：
///   * **L0** —— `l0_size_at` 非 0（字面量尺寸 + 只被解引用透过）；
///   * **L2** —— 落在 `pt_gl_l2ranges` 扫出的某个纪元体内；
///   * **L1** —— 声明在**函数体顶层**、`l0_size_at` 为 0、`l1_ptr_only_at` 为 1；
///   * 其余落 L3（由调用方用 `total` 减出来）。
/// 12 个十六进制位的打包与"站点数不可能过 65535"这条一起成立 —— 单元规模那里早有上限。
fn pt_gl_fn(sc: ptr, unit: ptr, t: ptr, fat: u32, fend: u32, npar: u32, par: ptr) -> u64 {
    let nrng: u32 = pt_gl_l2ranges(unit, t, fat, fend, npar, par, ptr_add(sc, PT_GLRNG),
                                   ptr_add(sc, PT_GLSAFE));
    let nl0: u32 = 0;
    let nl1: u32 = 0;
    let nl2: u32 = 0;
    let d: u32 = fat;
    while d < fend {
        let nm: u32 = d + 1;
        if pt_tis(unit, t, d, "let") && !pt_tis(unit, t, d - 1, "if") && nm + 5 < fend
                && pt_kind(t, nm) == 0 && pt_tis(unit, t, nm + 1, ":")
                && pt_tis(unit, t, nm + 2, "ptr") && pt_tis(unit, t, nm + 3, "=")
                && pt_tis(unit, t, nm + 4, "alloc") && pt_tis(unit, t, nm + 5, "(") {
            let j: u32 = nm + 5;
            let dep: u32 = 0;
            let done: u32 = 0;
            while j < fend && done == 0 {
                if pt_tis(unit, t, j, "(") {
                    dep = dep + 1;
                }
                if pt_tis(unit, t, j, ")") {
                    dep = dep - 1;
                    if dep == 0 {
                        done = 1;
                    }
                }
                j = j + 1;
            }
            if done == 1 && pt_tis(unit, t, j, ";") {
                if l0_size_at(unit, t, nm, fat, fend, npar, par,
                              ptr_add(sc, PT_GLSAFE)) != 0 {
                    nl0 = nl0 + 1;
                } else if pt_gl_inrange(nm, ptr_add(sc, PT_GLRNG), nrng) == 1 {
                    nl2 = nl2 + 1;
                } else if pt_gl_istop(unit, t, fat, nm) == 1
                        && l1_ptr_only_at(unit, t, nm, fat, fend, npar, par,
                                          ptr_add(sc, PT_GLSCR),
                                          ptr_add(sc, PT_GLSAFE)) == 1 {
                    nl1 = nl1 + 1;
                }
            }
        }
        d = d + 1;
    }
    return (nl0 as u64) | ((nl1 as u64) << 16) | ((nl2 as u64) << 32);
}

/// 本单元是不是 `gc_auto_alpha` 档（`docs/175` §3.4）—— 四层梯**只在这一档算**，别的档
/// 三个数恒为 0（参考侧 `f.l0` / `f.l1` / `s.l2` 只在 alpha 那一趟填，见 `parse()` 末尾）。
/// 扫描口径与 `pt_gc` 同。
fn pt_gc_is_alpha(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && pt_tis(unit, t, i + 1, "gc_auto_alpha") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 本单元里四层各领走几个（打包同上）。扫**每一个 `fn` 体**（顶层 + `impl` 里的方法 +
/// 泛型原件）—— 与参考实现在 `raw_mod`（**单态化之前**）上迭代 `mod.funcs + impl 方法`
/// 是同一批函数体（单态化造出的实例副本两边都不数）。
/// **非 alpha 档直接回 0** —— 三张分层表那时是空的。
fn pt_gl_all(sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32) -> u64 {
    if pt_gc_is_alpha(unit, t, lo, hi) == 0 {
        return 0;
    }
    let nl0: u64 = 0;
    let nl1: u64 = 0;
    let nl2: u64 = 0;
    let fi: u32 = lo;
    while fi < hi && pt_kind(t, fi) != 4 {
        if pt_tis(unit, t, fi, "fn")
                && !(fi > lo && pt_tis(unit, t, fi - 1, "extern")) {
            let lp: u32 = pt_gl_lparen(unit, t, fi, hi);
            if lp != PT_NONE {
                let rp: u32 = pt_gl_rparen(unit, t, lp, hi);
                if rp != PT_NONE {
                    let b: u32 = rp + 1;
                    while b < hi && !pt_tis(unit, t, b, "{") && pt_kind(t, b) != 4 {
                        b = b + 1;
                    }
                    if b < hi {
                        let fat: u32 = b + 1;
                        let fend: u32 = skip_block(unit, t, b) - 1;
                        let npar: u32 = pt_gl_params(unit, t, lp, ptr_add(sc, PT_GLPAR));
                        let pk: u64 = pt_gl_fn(sc, unit, t, fat, fend, npar,
                                               ptr_add(sc, PT_GLPAR));
                        nl0 = nl0 + (pk & 65535);
                        nl1 = nl1 + ((pk >> 16) & 65535);
                        nl2 = nl2 + ((pk >> 32) & 65535);
                    }
                }
            }
        }
        fi = fi + 1;
    }
    return nl0 | (nl1 << 16) | (nl2 << 32);
}

/// 类型形参个数: `Name < A , B >` 里逗号个数 + 1。
fn pt_cnt_tps(unit: ptr, t: ptr, lt: u32, gt: u32) -> u32 {
    let n: u32 = 1;
    let j: u32 = lt + 1;
    while j < gt {
        if pt_tis(unit, t, j, ",") {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// `types` 的条数: 顶层 `struct`, **减掉带 `<T>` 的那种**。
///
/// 为什么减: 参考实现的对象取的是**单态化之后**的 `mod.structs` —— `prepare` 把声明了
/// 形参的那一类**换成**实例化出来的具体副本(名字形如 `Pair_u32`), 原件不再留在表里。
/// 所以"带 `<T>` 的声明"**不是** `types` 里的一格, 而是 `generics` 里的一格(见
/// `pt_gen_kw`)。预置枚举正是靠这条从 `enums` 里消失的 —— 它们的形参就是 `<T>`,
/// 而 `prepare` 一定会被它们触发(它那条"没有泛型就早退"的判据看的就是这个)。
fn pt_cnt_types(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "struct") && !pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `enums` 的条数 —— 与 `pt_cnt_types` 同一个理由(单态化之后的那张表)。
fn pt_cnt_enums(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "enum") && !pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 数字那一格的第二条拒绝: 量级超过 u64 的字面量。
///
/// 与 `pt_refuse` 分开是因为 `pt_num_ovf` 定义在它后面(本语言"先定义后使用")——
/// 两条都由 `potato_emit` 顺次调用。
fn pt_refuse_num(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 1 && pt_num_ovf(unit, t, i) == 1 {
            let _w: u32 = pt_wfail("--emit-potato: an integer constant is larger than u64 -- the reference implementation's `int_lit` is arbitrary precision and this slot stops at u64; naming it beats emitting a wrapped number");
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- 类型渲染

/// 渲一个类型, 返回 `(下一个 token 下标 << 32) | 新游标`。
///
/// 形状与 `lomentc.Parser.type_name` **逐字符**同形 —— 它不是"抄原文": 原文里的
/// `[u8;16]` / `Pair<u32,u32>` 到了对象里是 `[u8; 16]` / `Pair<u32, u32>`
/// (分号/逗号后**恰好**一个空格, 数组长度**规范化成十进制**)。抄原文在语料上就会红。
///
/// 两个返回值打成一个 u64: 语言的函数没有元组, 而这是本文件里唯一需要"同时回传
/// 游标与 token 位置"的地方(递归渲染必须知道吃到哪了)。参考实现里也有这个形状
/// (`declare` 返回 `(n << 32) | o`)。
fn pt_ty(out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u64 {
    let j: u32 = i;
    if pt_tis(src, t, j, "mut") && pt_tis(src, t, j + 1, "[") {
        o = pt_str(out, o, "mut [");
        let r0: u64 = pt_ty(out, o, src, t, j + 2);
        o = (r0 % 4294967296) as u32;
        j = (r0 / 4294967296) as u32;
        o = pt_str(out, o, "]");
        // 递归回来时 `j` 停在 `]` 上 —— **要吃掉它**, 否则调用方以为下一个形参就在这儿
        // (实测症状: `fill(xs: mut [u32], v: u32)` 的第二个形参名字变成 `]`、类型是空串)。
        j = j + 1;
        return (j as u64) * 4294967296 + (o as u64);
    }
    if pt_tis(src, t, j, "[") {
        o = pt_str(out, o, "[");
        let r1: u64 = pt_ty(out, o, src, t, j + 1);
        o = (r1 % 4294967296) as u32;
        j = (r1 / 4294967296) as u32;
        if pt_tis(src, t, j, ";") {
            o = pt_str(out, o, "; ");
            o = pt_num(out, o, src, t, j + 1);
            j = j + 2;
        }
        o = pt_str(out, o, "]");
        j = j + 1;   // 同上: 吃掉 `]`
        return (j as u64) * 4294967296 + (o as u64);
    }
    o = pt_mem(out, o, src, pt_off(t, j), pt_tlen(t, j));
    j = j + 1;
    if pt_tis(src, t, j, "<") {
        o = pt_str(out, o, "<");
        j = j + 1;
        while !pt_tis(src, t, j, ">") && pt_kind(t, j) != 4 {
            let r2: u64 = pt_ty(out, o, src, t, j);
            o = (r2 % 4294967296) as u32;
            j = (r2 / 4294967296) as u32;
            if pt_tis(src, t, j, ",") {
                o = pt_str(out, o, ", ");
                j = j + 1;
            }
        }
        j = j + 1;
        o = pt_str(out, o, ">");
    }
    return (j as u64) * 4294967296 + (o as u64);
}

// ---------------------------------------------------------------- M7 的查表那半
//
// 泛型**类型**的实例化在**发射**这一侧只欠一件事: 类型串要从 `Pair<u32>` 变成 `Pair_u32`。
// 所以最省事的接口是**渲完再查表** —— `pt_ty` / `pt_ty_sub` 写出一段类型之后, 把刚写出去
// 的那一段拿回来查一次映射表, 命中就**原地换成实例名**。于是 `pt_params` / `pt_payloads`
// 那些渲染点里, 只有"调哪个渲染器"变了, 渲染逻辑一行没动。
//
// 为什么这一节放在这么靠前: 本语言"先定义后使用", 而 `pt_payloads` / `pt_params` 在文件
// 中间。收类型串 + 建表那半在 M6/M7 那一节（它只被 `potato_emit` 调用, 可以在后面）。
//
// 这几张表**接在 `PT_TMPC` 之后**（总布局见下面那一块注释）。常量分两处放是被"先定义后
// 使用"逼的: 查表这半在前面, 所以这几条得在这儿。
const PT_TPOOL: u32 = 37032;       // 类型串池: 128 条 × 64 字节（[长度 4][键…][长度 4][名字…]）
const PT_TMAP: u32 = 45224;        // 映射表: 128 条 × 8 字节 {名字起点, 名字长度}
const PT_TBUF: u32 = 46248;        // 临时渲染缓冲: A(+0, 256) / B(+256, 256)
// M-L0（`layouts`）要自己读 `.lom` 文件、自己按字节扫 —— 四块:
//   [46768, 112304)  `.lom` 文本（64 KiB；超了就**点名拒**，不截断）
//   [112304, 113328) 目标路径（NUL 结尾，1 KiB）
//   [113328, 113648) 字段表: 16 条 × 20 字节 {名起点,名长,类型起点,类型长,偏移}
//   [113648, 113680) 一条 record 的元信息 {名起点,名长,size,endian,packed,字段数}
const PT_L0BUF: u32 = 46768;
const PT_L0PATH: u32 = 112304;
const PT_FTAB: u32 = 113328;
const PT_RMETA: u32 = 113648;
const PT_L0CAP: u32 = 65536;
const PT_FMAX: u32 = 16;
// `gc_ladder`（`docs/210` §5, v10）用的两张临时表。都在状态块尾巴上 —— 与 `boundary`
// 那种"数一遍就完"的不同，四层梯要**先扫出 L2 的循环体范围、再对每个候选站点查归属**。
const PT_GLPAR: u32 = 113680;       // 当前函数的形参名字表: 64 × 8 (与 `CG_CUR` 同形)
const PT_GLPMX: u32 = 64;
const PT_GLRNG: u32 = 114192;       // 本函数"开着纪元的循环体"范围: 32 × 8 {at, end}
const PT_GLRMX: u32 = 32;
const PT_GLSCR: u32 = 114448;       // `l1_ptr_only_at` 的 `out`（它要写"最后一次用处"）
// `docs/210` §7 那次放宽的**安全名表**（`[count, name_tok…]`，与 codegen 的 `CG_SAFE` 同形）。
// 由 codegen 的 **`compute_safe`** 填（potato `use codegen`，两边共用同一支扫描 ⇒ 同一集合）。
const PT_GLSAFE: u32 = 114456;
const PT_TN: u32 = 46760;          // 收进池子的类型串条数（= 映射表条数）
const PT_TCUR: u32 = 46764;        // 池子游标
const PT_TMAX: u32 = 128;
const PT_TSTRIDE: u32 = 64;
const PT_TBUF_SZ: u32 = 256;
const PT_SC_BYTES: u64 = 132864;    // 含上面的安全名表 ((1 + 4600) × 4)

/// 一个类型串在池子里的位置（`i` 是池子下标）。
fn pt_tkey(sc: ptr, i: u32) -> u32 {
    return PT_TPOOL + i * PT_TSTRIDE + 4;
}

fn pt_tkeylen(sc: ptr, i: u32) -> u32 {
    return load32(sc, PT_TPOOL + i * PT_TSTRIDE);
}

/// 查一次映射表: 把 `out[a, b)` 这一段**当成一个类型串**（不带引号）查表, 命中就就地换成
/// 实例名并返回新的段尾, 没命中原样返回。
///
/// 实例名一定**短于**键: `Base<a, b>` → `Base_a_b` 去掉 `<`/`>`、`, ` 变 `_`, 恒少 3 个
/// 字符; 单个实参少 1 个。所以原地改写不会盖到后面的内容。
fn pt_map_slice(sc: ptr, out: ptr, a: u32, b: u32) -> u32 {
    let len: u32 = b - a;
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 0;
    while i < n {
        // ⚠ 只认**配了名字**的那些条目：池子里收的是**所有**类型位置上的串（`u64` 这种也在），
        // 而只有泛型实例才在建表时拿到名字。少了 `nl > 0` 这一条, `u64` 会被"映射"成**空串**
        // —— 这正是这一格第一版发出去的东西（`bootprobe.lomt` 的 `"type": ""`）。
        if pt_tkeylen(sc, i) == len && load32(sc, PT_TMAP + i * 8 + 4) > 0 {
            let ko: u32 = pt_tkey(sc, i);
            if pt_pool_eq(sc, ko, len, out, a, len) == 1 {
                let e: u32 = PT_TMAP + i * 8;
                let no: u32 = load32(sc, e);
                let nl: u32 = load32(sc, e + 4);
                let k: u32 = 0;
                while k < nl {
                    store8(out, a + k, load8(sc, no + k) as u8);
                    k = k + 1;
                }
                return a + nl;
            }
        }
        i = i + 1;
    }
    return b;
}

/// `pt_ty` 的**查表版**（类型串不在这层加引号）。表是空的时候与 `pt_ty` 完全等价 ——
/// 收类型串那一步就是用它渲的（那时表还没建）。
fn pt_tym(sc: ptr, out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u64 {
    let a: u32 = o;
    let r: u64 = pt_ty(out, o, src, t, i);
    let e: u32 = (r % 4294967296) as u32;
    let ne: u32 = pt_map_slice(sc, out, a, e);
    return ((r / 4294967296) as u64) * 4294967296 + (ne as u64);
}

/// `pt_tyq` 的**查表版**。引号写在**映射之后**的位置 —— 直接包 `pt_tyq` 的话, 收尾那个引号
/// 会留在旧位置上, 中间空出一段垃圾。
fn pt_tymq(sc: ptr, out: ptr, o: u32, src: ptr, t: ptr, i: u32) -> u64 {
    o = pt_str(out, o, "\"");
    let a: u32 = o;
    let r: u64 = pt_ty(out, o, src, t, i);
    let e: u32 = (r % 4294967296) as u32;
    let ne: u32 = pt_map_slice(sc, out, a, e);
    let nq: u32 = pt_str(out, ne, "\"");
    return ((r / 4294967296) as u64) * 4294967296 + (nq as u64);
}

/// 类型形参名表 —— **字符串数组**(不是 `functions[].params` 那种对象数组)。
fn pt_names(out: ptr, o: u32, src: ptr, t: ptr, lt: u32, n: u32) -> u32 {
    let j: u32 = lt + 1;
    let i: u32 = 0;
    while i < n {
        o = pt_aelm(out, o, 4, i);
        o = pt_q(out, o, src, pt_off(t, j), pt_tlen(t, j));
        j = j + 1;
        if pt_tis(src, t, j, ",") {
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 开关
//
// 开关表(`switches.lomt`)每条 16 字节: 名起点 | 名长 | 标记 | token 下标。标记
// **2 = 定义**(`set choose`), 1 = 取值"开", 0 = 取值"关"; **每个出现各一条, 不去重**。
//
// 参考实现是 `[{"name": n, "on": self.state(n)} for n in sorted(self.defs)]`:
// **按名字排序**(确定性是判据 —— 同一份源必须给同一串字节), 只收**定义过**的开关。

/// 名字序: 0 = a 在 b 前, 1 = 相等, 2 = a 在 b 后。按字节比, 短的在前(与 Python 的
/// `sorted` 在 ASCII 上逐码点比同一结果)。
fn pt_sw_cmp(unit: ptr, sw: ptr, a: u32, b: u32) -> u32 {
    let la: u32 = load32(sw, a * SW_SIZE + 4);
    let lb: u32 = load32(sw, b * SW_SIZE + 4);
    let oa: u32 = load32(sw, a * SW_SIZE);
    let ob: u32 = load32(sw, b * SW_SIZE);
    let n: u32 = la;
    if lb < n {
        n = lb;
    }
    let k: u32 = 0;
    while k < n {
        let ca: u32 = load8(unit, oa + k) as u32;
        let cb: u32 = load8(unit, ob + k) as u32;
        if ca < cb {
            return 0;
        }
        if ca > cb {
            return 2;
        }
        k = k + 1;
    }
    if la < lb {
        return 0;
    }
    if la > lb {
        return 2;
    }
    return 1;
}

/// 第 `i` 条**定义**是不是同名里最靠前的那一条(去重)。
/// 重复定义本身是 E022 —— 走到这里不会发生, 但去重仍按参考实现的口径(第一条算),
/// 免得"同一个名字发两次"这种**表面绿、对象非法**的东西出去。
fn pt_def_first(unit: ptr, sw: ptr, i: u32) -> u32 {
    let j: u32 = 0;
    while j < i {
        if load32(sw, j * SW_SIZE + 8) == 2 && pt_sw_cmp(unit, sw, j, i) == 1 {
            return 0;
        }
        j = j + 1;
    }
    return 1;
}

/// 一个开关开没开: **第一个取值**说了算 (`state()` 只记首次, 之后只记重复);
/// **没写就是关**。
fn pt_sw_state(unit: ptr, sw: ptr, ns: u32, idx: u32) -> u32 {
    let i: u32 = 0;
    while i < ns {
        if load32(sw, i * SW_SIZE + 8) != 2 && pt_sw_cmp(unit, sw, i, idx) == 1 {
            return load32(sw, i * SW_SIZE + 8);
        }
        i = i + 1;
    }
    return 0;
}

fn pt_cnt_defs(unit: ptr, sw: ptr) -> u32 {
    let ns: u32 = load32(sw, MAX_CHOOSE * SW_SIZE);
    let n: u32 = 0;
    let i: u32 = 0;
    while i < ns {
        if load32(sw, i * SW_SIZE + 8) == 2 && pt_def_first(unit, sw, i) == 1 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 排序用**后继扫描**: 每一轮找"比上一轮那条大"的最小者。语言里没有数组, 拿不到
/// "排好序的索引表"; 这条是 O(n^2), 但 n 是**开关个数**(常是个位数)。
fn pt_switches(out: ptr, o: u32, unit: ptr, sw: ptr, n: u32) -> u32 {
    let ns: u32 = load32(sw, MAX_CHOOSE * SW_SIZE);
    let prev: u32 = 0;
    let have: u32 = 0;
    let ix: u32 = 0;
    let stop: u32 = 0;
    while stop == 0 {
        let best: u32 = PT_NONE;
        let i: u32 = 0;
        while i < ns {
            if load32(sw, i * SW_SIZE + 8) == 2 && pt_def_first(unit, sw, i) == 1 {
                let ok: u32 = 0;
                if have == 0 {
                    ok = 1;
                } else if pt_sw_cmp(unit, sw, i, prev) == 2 {
                    ok = 1;
                }
                if ok == 1 {
                    if best == PT_NONE || pt_sw_cmp(unit, sw, i, best) == 0 {
                        best = i;
                    }
                }
            }
            i = i + 1;
        }
        if best == PT_NONE {
            stop = 1;
        } else {
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, load32(sw, best * SW_SIZE),
                     load32(sw, best * SW_SIZE + 4));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "on");
            o = pt_bool(out, o, pt_sw_state(unit, sw, ns, best));
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
            prev = best;
            have = 1;
        }
    }
    return o;
}

// ---------------------------------------------------------------- 声明的体

/// 枚举的变体名(字符串数组)。
fn pt_variants(out: ptr, o: u32, unit: ptr, t: ptr, brc: u32, n: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            o = pt_aelm(out, o, 4, ix);
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
            ix = ix + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return o;
}

/// 带载荷的变体 —— 一个 **JSON 对象**(`{"Circle": "u32"}`), 顺序 = 变体顺序。
/// 一个都没有时**整个键都不写**(参考实现是 `**({"payloads": …} if e.payloads else {})`),
/// 所以调用方先看 `pt_cnt_pay`。
fn pt_payloads(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, brc: u32, lv: u32, n: u32) -> u32 {
    o = pt_str(out, o, "{\n");
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            if pt_tis(unit, t, j + 1, "(") {
                o = pt_aelm(out, o, lv + 1, ix);
                o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
                o = pt_str(out, o, ": ");
                let rp: u64 = pt_tymq(sc, out, o, unit, t, j + 2);
                o = (rp % 4294967296) as u32;
                ix = ix + 1;
            }
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, lv);
    return pt_str(out, o, "}");
}

/// 结构体的字段 —— 对象数组(`{"name": …, "type": …}`), 顺序 = 声明顺序。
/// `lv` 是**字段对象**那一层的层号。
fn pt_fields(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, brc: u32, lv: u32, n: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            o = pt_aelm(out, o, lv, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, lv + 1, "name");
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, lv + 1, "type");
            // 字段的形状是定长的: 名字 `:` 类型
            let rf: u64 = pt_tymq(sc, out, o, unit, t, j + 2);
            o = (rf % 4294967296) as u32;
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, lv);
            o = pt_str(out, o, "}");
            ix = ix + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return o;
}

/// 形参个数: `(` 到配对的 `)` 之间第 0 层的逗号数 + 1(空表是 0)。
/// **不**拿检查器符号表里的 `argc`: 那一格是给"实参个数比对"用的, 而这一格要的是
/// "声明里写了几个", 两件事在 `self` 那种形参上会分家。
fn pt_cnt_params(unit: ptr, t: ptr, lp: u32) -> u32 {
    if pt_tis(unit, t, lp + 1, ")") {
        return 0;
    }
    let n: u32 = 1;
    let j: u32 = lp + 1;
    let d: u32 = 0;
    while pt_kind(t, j) != 4 && !(pt_tis(unit, t, j, ")") && d == 0) {
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && pt_tis(unit, t, j, ",") {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// 形参表 —— 对象数组, 元素在**第 4 层**(`functions` 的元素在第 2 层, 键在第 3 层)。
///
/// 两个 `self` 的例外（参考实现的两条路，别混）：
///   * **impl 方法**的 `self`：`parse_impl` 把它改写成 `__self`，类型填**接受者类型**
///     （`Small`）—— 所以 `its` 不是 `PT_NONE` 时第一个裸 `self` 走这一支；
///   * **顶层函数**里的裸 `self`（`fn f(self)`）：`parse_fn` 给的是 `Param("self", "")`
///     —— 名字在, 类型是空串。那一支**不写字面量空串**（那会生成一个零长全局）。
fn pt_params(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lp: u32, n: u32, its: u32) -> u32 {
    let j: u32 = lp + 1;
    let i: u32 = 0;
    while i < n {
        o = pt_aelm(out, o, 4, i);
        o = pt_str(out, o, "{\n");
        let has_ty: u32 = 0;
        if pt_tis(unit, t, j + 1, ":") {
            has_ty = 1;
        } else if its != PT_NONE && i == 0 {
            has_ty = 2;
        }
        o = pt_key(out, o, 5, "name");
        if has_ty == 2 {
            o = pt_qs(out, o, "__self");
        } else if has_ty == 1 {
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
        } else {
            store8(out, o, 34 as u8);
            store8(out, o + 1, 34 as u8);
            o = o + 2;
        }
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 5, "type");
        if has_ty == 1 {
            let rq: u64 = pt_tymq(sc, out, o, unit, t, j + 2);
            o = (rq % 4294967296) as u32;
            j = (rq / 4294967296) as u32;
        } else if has_ty == 2 {
            let rq2: u64 = pt_tymq(sc, out, o, unit, t, its);
            o = (rq2 % 4294967296) as u32;
            j = j + 1;
        } else {
            store8(out, o, 34 as u8);
            store8(out, o + 1, 34 as u8);
            o = o + 2;
            j = j + 1;
        }
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 4);
        o = pt_str(out, o, "}");
        if pt_tis(unit, t, j, ",") {
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 返回类型: `)` 后面有 `->` 就有, 否则是 `()`。
/// (`lomentc.Parser.parse_fn`: 后面是 `{` 或 `;` 就是无返回。外部函数没有函数体 ——
/// 而外部函数**本来就不进 `functions`**, 所以这里只会撞到 `{`。)
fn pt_ret(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lp: u32) -> u32 {
    let rp: u32 = pt_match(unit, t, lp, "(", ")");
    let j: u32 = rp + 1;
    if pt_tis(unit, t, j, "-") && pt_tis(unit, t, j + 1, ">") {
        let rr: u64 = pt_tymq(sc, out, o, unit, t, j + 2);
        return (rr % 4294967296) as u32;
    }
    return pt_str(out, o, "\"()\"");
}

// ---------------------------------------------------------------- 各格

/// 核心模式 (`docs/143` §3.2)。
///
/// 开关在 token 流上**已经落定过**(`apply_switches`): `choose std` / `choose no_std`
/// 是**留着**的, 其余的开关声明已被那张表吃掉。所以这里只认这两个词 —— 与参考实现
/// "看名字是不是 std/no_std" 是同一条判据。没写就是 `std`(`mod.choose or "std"`)。
fn pt_mode(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "std") || pt_tis(unit, t, i + 1, "no_std")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "std");
}

/// **回收档**（`docs/175` §3.4, v8）。与 `pt_mode` 同形：核心模式那一趟之后，
/// token 流里只剩核心模式的取值（开关声明已被 `apply_switches` 吃掉），
/// 所以这里只认 `gc_manual` / `gc_auto` 两个词 —— 与参考实现的 `CORE_DIMS["gc"]`
/// 是同一张表。没写就是 `gc_manual`（默认档，**不改变任何现有程序的行为**）。
fn pt_gc(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "gc_manual") || pt_tis(unit, t, i + 1, "gc_auto")
                || pt_tis(unit, t, i + 1, "gc_auto_alpha")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "gc_manual");
}

/// **运行期在不在**（`docs/175` §3.6, v9）。与 `pt_gc` 同形、同一个理由：开关声明已被
/// `apply_switches` 吃掉，所以这里只认 `runtime` / `no_runtime` 两个词 ——
/// 与参考实现的 `CORE_DIMS["runtime"]` 是同一张表。没写就是 `no_runtime`
/// （默认档，**不改变任何现有程序的行为**）。
fn pt_runtime(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "runtime") || pt_tis(unit, t, i + 1, "no_runtime")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "no_runtime");
}

/// `port`（`docs/222` §4, v11）：`sealed` / `hosted`。与 `pt_runtime` **同形** ——
/// 只认那两个词，默认 `sealed`（与参考实现的 `CORE_DIMS["port"]` / `CORE_DEFAULTS["port"]`
/// 是同一张表；加一维两边一起动）。
fn pt_port(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "sealed") || pt_tis(unit, t, i + 1, "hosted")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "sealed");
}

/// `vm`（`docs/231`, v13）：`vm` / `no_vm`。与 `pt_runtime` / `pt_port` **同形** ——
/// 只认那两个词，默认 `no_vm`（与参考实现的 `CORE_DIMS["vm"]` / `CORE_DEFAULTS["vm"]`
/// 是同一张表；加一维两边一起动）。
///
/// ⚠ 发行版里这一档是**编译错误**（渠道闸，`docs/231` §2），所以发行版发的对象里
/// 它**恒为** `no_vm` —— 但这一层不判渠道：它只把源码里写的那个词如实抄进对象。
fn pt_vm(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "vm") || pt_tis(unit, t, i + 1, "no_vm")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "no_vm");
}

/// `lms`（`docs/253`, v15）：`lms_close` / `lms_open`。与 `pt_vm` **同形** ——
/// 只认那两个词，默认 `lms_close`（与参考实现的 `CORE_DIMS["lms"]` / `CORE_DEFAULTS["lms"]`
/// 是同一张表；加一维两边一起动）。
///
/// ⚠ **取值带维名前缀**（`lms_*`，照 `gc_manual`/`gc_auto` 的先例）：`open` / `close`
/// 单独太泛。⚠ **它不引入运行期组件**（`docs/253` §11.2），所以它**不与 `no_runtime`
/// 冲突** —— 这一层不判冲突（那是校验器的事），只把源码里写的那个词如实抄进对象。
fn pt_lms(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "choose")
                && (pt_tis(unit, t, i + 1, "lms_close") || pt_tis(unit, t, i + 1, "lms_open")) {
            return pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
        }
        i = i + 1;
    }
    return pt_qs(out, o, "lms_close");
}

/// `capabilities`。形状是**定长**的(检查器也是照这个形状读的):
/// `capability NAME : SPACE [ LO .. HI ] (revocable)?`
/// 即 NAME=i+1, `:`=i+2, SPACE=i+3, `[`=i+4, LO=i+5, `..`=i+6,i+7, HI=i+8, `]`=i+9,
/// `revocable`=i+10(可选)。lo/hi 是**解出来的数**(参考实现 `int_lit()`), 所以走 `pt_num`。
fn pt_caps(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "capability") {
            let rev: u32 = 0;
            if pt_tis(unit, t, i + 10, "revocable") {
                rev = 1;
            }
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "domain");
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 4, "space");
            o = pt_q(out, o, unit, pt_off(t, i + 3), pt_tlen(t, i + 3));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 4, "lo");
            o = pt_num(out, o, unit, t, i + 5);
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 4, "hi");
            o = pt_num(out, o, unit, t, i + 8);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 3);
            o = pt_str(out, o, "},\n");
            o = pt_key(out, o, 3, "revocable");
            o = pt_bool(out, o, rev);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `excluded`(元素是字符串的数组)。
///
/// 自举词法器的字符串 token **含两侧引号**, 而参考实现的 `mod.excluded` 是**里面的
/// 内容** —— 所以切 `+1 / -2`。里面有 `\` 的单元在 `pt_refuse` 就被挡住了。
fn pt_excluded(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "excluded") && pt_kind(t, i + 1) == 2 {
            o = pt_aelm(out, o, 2, ix);
            o = pt_q(out, o, unit, pt_off(t, i + 1) + 1, pt_tlen(t, i + 1) - 2);
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `consts`: 形状是 `const NAME : TYPE = VALUE ;`, 所以名字后面第 2 位起就是类型。
/// 值走 `pt_num`(参考实现的对象里它是**数**, 不是原文)。
fn pt_consts(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "const") {
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "type");
            let rc: u64 = pt_tymq(sc, out, o, unit, t, i + 3);
            o = (rc % 4294967296) as u32;
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "value");
            // 类型后面是 `=`, 值在它后面(`int_lit` 允许前面有 `-`)
            o = pt_num(out, o, unit, t, (rc / 4294967296) as u32 + 1);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `enums`。**顺序 = 声明的先后**(参考实现的 `mod.enums` 就是这个序: 根单元的枚举在前,
/// 预置的 Option/Result 由驱动器 append 在**末尾**)。
fn pt_enums(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32,
             ntu: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "enum") && !pt_tis(unit, t, i + 2, "<") {
            // 名字后面可能是 `<T, E>` 再是 `{`
            let mut_j: u32 = i + 2;
            while !pt_tis(unit, t, mut_j, "{") && pt_kind(t, mut_j) != 4 {
                mut_j = mut_j + 1;
            }
            let brc: u32 = mut_j;
            let nv: u32 = pt_cnt_names(unit, t, brc);
            let np: u32 = pt_cnt_pay(unit, t, brc);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "variants");
            o = pt_aopen(out, o, nv);
            o = pt_variants(out, o, unit, t, brc, nv);
            o = pt_acls(out, o, 3, nv);
            if np > 0 {
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "payloads");
                o = pt_payloads(out, o, sc, unit, t, brc, 3, np);
            }
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    // 单态化出来的枚举接在**声明之后**（与结构体同一个理由）
    return pt_inst_enums(out, o, sc, unit, t, ntu, ix);
}

/// `types`(结构体)。字段是**对象数组**, 元素在第 4 层。
fn pt_types(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32,
             ntu: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "struct") && !pt_tis(unit, t, i + 2, "<") {
            let mut_j: u32 = i + 2;
            while !pt_tis(unit, t, mut_j, "{") && pt_kind(t, mut_j) != 4 {
                mut_j = mut_j + 1;
            }
            let brc: u32 = mut_j;
            let nf: u32 = pt_cnt_names(unit, t, brc);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "fields");
            o = pt_aopen(out, o, nf);
            o = pt_fields(out, o, sc, unit, t, brc, 4, nf);
            o = pt_acls(out, o, 3, nf);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    // 单态化出来的结构体接在**声明之后**（参考实现把实例 append 到 `mod.structs` 尾巴上）
    return pt_inst_types(out, o, sc, unit, t, ntu, ix);
}

// ---------------------------------------------------------------- trait / impl
//
// 参考实现的 `traits`/`impls` 收的是**原始视图**（`raw_mod` —— 单态化之前那份）：
//
//   traits: [{"name": "Measurable", "methods": ["area"]}]
//   impls:  [{"trait": "Measurable", "for": "Rect", "methods": ["area"]}]
//
// 检查器把 impl 方法压成了 `K_METHOD`（trait 名与接受者名都不留），所以这两格只能回
// token 流重扫 —— 形状是定长的：`trait NAME { fn M ( … ) -> R ; … }`、
// `impl TRAIT for TYPE { fn M ( … ) { … } }`。

/// `trait` 的个数（深度 0）。
fn pt_cnt_traits(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "trait") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `impl` 的个数（深度 0，**不含 `impl` 块里的方法** —— 那算 `functions`）。
fn pt_cnt_impls(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 块内的 `fn` 个数（`trait` 的签名式方法与 `impl` 的方法都是这个形状）。
fn pt_cnt_block_fn(unit: ptr, t: ptr, brc: u32, end: u32) -> u32 {
    let n: u32 = 0;
    let j: u32 = brc + 1;
    while j < end && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "fn") {
            n = n + 1;
        }
        j = j + 1;
    }
    return n;
}

/// 块内的 `fn` 名字（字符串数组）。
fn pt_block_fn_names(out: ptr, o: u32, unit: ptr, t: ptr, brc: u32, end: u32, n: u32) -> u32 {
    let j: u32 = brc + 1;
    let ix: u32 = 0;
    while j < end && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "fn") {
            o = pt_aelm(out, o, 4, ix);
            o = pt_q(out, o, unit, pt_off(t, j + 1), pt_tlen(t, j + 1));
            ix = ix + 1;
        }
        j = j + 1;
    }
    return o;
}

/// 从 `i` 起找第一个文本等于 `ch` 的 token（`PT_NONE` = 没有）。
fn pt_find_ch(unit: ptr, t: ptr, i: u32, hi: u32, ch: str) -> u32 {
    let j: u32 = i;
    while j < hi && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, ch) {
            return j;
        }
        j = j + 1;
    }
    return PT_NONE;
}

fn pt_traits(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "trait") {
            let brc: u32 = pt_find_ch(unit, t, i + 1, hi, "{");
            let end: u32 = pt_match(unit, t, brc, "{", "}");
            let nm: u32 = pt_cnt_block_fn(unit, t, brc, end);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "methods");
            o = pt_aopen(out, o, nm);
            o = pt_block_fn_names(out, o, unit, t, brc, end, nm);
            o = pt_acls(out, o, 3, nm);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

fn pt_impls(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            // `impl TRAIT for TYPE { … }`：trait 在 `impl` 后一位, 类型在 `for` 后一位
            let ft: u32 = pt_find_for(unit, t, i + 1, hi);
            let brc: u32 = pt_find_ch(unit, t, i + 1, hi, "{");
            let end: u32 = pt_match(unit, t, brc, "{", "}");
            let nm: u32 = pt_cnt_block_fn(unit, t, brc, end);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "trait");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "for");
            let r: u64 = pt_tymq(sc, out, o, unit, t, ft + 1);
            o = (r % 4294967296) as u32;
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "methods");
            o = pt_aopen(out, o, nm);
            o = pt_block_fn_names(out, o, unit, t, brc, end, nm);
            o = pt_acls(out, o, 3, nm);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 函数名那一格: 顶层是名字本身; impl 方法要写成 `<接受者>_<方法名>`
/// （参考实现的 `parse` 在收 impl 时就 `f.name = f"{im.type}_{f.name}"`，对象里是改过名的）。
fn pt_fn_name(out: ptr, o: u32, unit: ptr, t: ptr, ntok: u32, its: u32) -> u32 {
    if its == PT_NONE {
        return pt_q(out, o, unit, pt_off(t, ntok), pt_tlen(t, ntok));
    }
    store8(out, o, 34 as u8);
    o = o + 1;
    let r: u64 = pt_ty(out, o, unit, t, its);
    o = (r % 4294967296) as u32;
    store8(out, o, 95 as u8);
    o = o + 1;
    o = pt_mem(out, o, unit, pt_off(t, ntok), pt_tlen(t, ntok));
    store8(out, o, 34 as u8);
    return o + 1;
}

/// `functions`。名字在 `fn` 后面一位, 形参表从它后面那个 `(` 起 —— 泛型函数是
/// `fn f<T>(…)`, 所以 `(` 的位置要**扫**出来(参考实现的 `chk_find_paren` 也是这么做的)。
/// 自写的泛型在 `pt_refuse` 被挡住, 所以这里撞到的 `<` 只可能来自……没有。留着这个扫描
/// 是因为"顺着 token 找下一个 `(`"比"假设它就在下一位"少一条隐藏前提。
fn pt_functions(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32, n: u32) -> u32 {
    let ix: u32 = 0;
    let d: u32 = 0;
    let its: u32 = PT_NONE;      // 当前 impl 的接受者类型起点(`impl T for X` 里 X 的位置)
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
                if d == 0 {
                    its = PT_NONE;
                }
            }
        } else if d == 0 && pt_tis(unit, t, i, "impl") {
            let ft: u32 = pt_find_for(unit, t, i + 1, hi);
            if ft != PT_NONE {
                its = ft + 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "register")
                && (pt_kind(t, i + 1) == 0 || pt_kind(t, i + 1) == 2)
                && pt_tis(unit, t, i + 2, "{") {
            // 与 `pt_cnt_fn` 那一处**同一条规则**：`register <名字> { <那个函数> }` 的壳
            // 是透明的，跳过它让块里的函数按顶层收（`docs/223` 形态 A）。
            // **两处必须一起改** —— 只改一处的话，条数与实际发出的条数对不上
            // （`pt_aopen` 会按错的条数写数组头）。
            i = i + 2;
        } else if pt_tis(unit, t, i, "fn")
                && (d == 0 || (d == 1 && its != PT_NONE)) {
            let skip: u32 = 0;
            if d == 0 {
                if pt_is_body_fn(unit, t, i + 1) == 0 {
                    skip = 1;    // `extern fn` 不进 `functions`
                }
            }
            if pt_tis(unit, t, i + 2, "<") {
                skip = 1;        // 泛型原件：实例由单态化追加（见 pt_fn_insts）
            }
            if skip == 0 {
                let mut_j: u32 = i + 2;
                while !pt_tis(unit, t, mut_j, "(") && pt_kind(t, mut_j) != 4 {
                    mut_j = mut_j + 1;
                }
                let lp: u32 = mut_j;
                let np: u32 = pt_cnt_params(unit, t, lp);
                o = pt_aelm(out, o, 2, ix);
                o = pt_str(out, o, "{\n");
                o = pt_key(out, o, 3, "name");
                // impl 方法的名字是**改过名的**: `<接受者>_<方法名>`
                o = pt_fn_name(out, o, unit, t, i + 1, its);
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "params");
                o = pt_aopen(out, o, np);
                o = pt_params(out, o, sc, unit, t, lp, np, its);
                o = pt_acls(out, o, 3, np);
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "ret");
                o = pt_ret(out, o, sc, unit, t, lp);
                o = pt_str(out, o, "\n");
                o = pt_ind(out, o, 2);
                o = pt_str(out, o, "}");
                ix = ix + 1;
            }
        }
        i = i + 1;
    }
    return o;
}


/// `generics` 的条数 —— 与 `pt_gen_kw` 同一个条件(带 `<` 的 `enum`)。
/// 计数与发射各走一遍是这一格的统一做法(见前面"计数"那一节)。
fn pt_cnt_gen(unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, "enum") && pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}


/// 带形参的声明个数 —— **只看一种关键字**(`kw` = `fn` / `struct` / `enum`)。
/// 参考实现的 `generics` 是三段拼起来的(`fn` 在前、再 struct、再 enum), 所以要分开数。
fn pt_cnt_gen_kw(unit: ptr, t: ptr, lo: u32, hi: u32, kw: str) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, kw) && pt_tis(unit, t, i + 2, "<") {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// 一种关键字那一类（`fn` / `struct` / `enum`）的 `generics` 条目, `ix0` 是起始下标。
/// 形状与参考实现一致: `{"kind": "fn"|"type", "name": …, "params": [类型形参名]}`。
fn pt_gen_kw(out: ptr, o: u32, unit: ptr, t: ptr, lo: u32, hi: u32,
             kw: str, kind: str, ix0: u32) -> u32 {
    let ix: u32 = ix0;
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && pt_tis(unit, t, i, kw) && pt_tis(unit, t, i + 2, "<") {
            let gt: u32 = pt_match(unit, t, i + 2, "<", ">");
            let np: u32 = pt_cnt_tps(unit, t, i + 2, gt);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "kind");
            o = pt_qs(out, o, kind);
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "name");
            o = pt_q(out, o, unit, pt_off(t, i + 1), pt_tlen(t, i + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "params");
            o = pt_aopen(out, o, np);
            o = pt_names(out, o, unit, t, i + 2, np);
            o = pt_acls(out, o, 3, np);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 泛型函数的单态化（M6）
//
// 对象这一半只做**泛型函数**：`generics`（声明那一格）与 `instances`（单态化出来的那一格），
// 以及**函数表被替换**（泛型原件从 `functions` 里消失、实例按创建顺序追加到末尾）。
//
// 参考实现的 M6 走 AST + 完整类型推断；这里走 token 流 + 一张**局部变量表**，实参只收两种
// 能定死类型的形态（标识符 → 查表；`x as T` → T）。**其余一律点名拒绝** —— 跳过会让对象
// 少一格实例，而"少一格"看起来完全正常（这正是这一格最怕的那种错）。
//
// 泛型**类型**（`struct S<T>` / `enum E<T>` 的实例化）还没做：那一类要先做 M7 的
// "收类型串 → 按串排序 → 批量实例化"，所以 `pt_refuse` 里那条边界留着。

/// brk 分配（`sys_alloc` 是驱动器的私有函数，这里自己来一份）。
fn pt_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

// 工作区（一次拿一整块，游标都放在区块尾巴上，不占形参）：
//   [0, 8192)       名字池：实例名（`Base_arg1_arg2`）
//   [8192, 10240)   实例表：64 条 × 32 字节
//   [10240, 12288)  实参表：64 条 × 32 字节（每条最多 4 对"类型起点/终点" token）
//   [12288, 36864)  局部变量表：1536 条 × 16 字节（名字 token / 类型起点 / 类型终点 / 块深度）
//   [36864]         实例条数   [36868] 名字池游标   [36872] 局部变量条数
//   [36876, 36940)  泛型函数的**名字 token**（16 条 × 4）—— 每次调用点都要查，所以先收好
//   [36940]         泛型函数条数
//   （[36944, 37032) 是 M6 的三个临时区; [37032, 46768) 是 M7 的四张表 —— 那两组常量见
//    文件靠前的"M7 的查表那半"一节, 与被"先定义后使用"逼出来的摆放有关。整块到 46768。）
const PT_POOL: u32 = 0;
const PT_TAB: u32 = 8192;
const PT_ATAB: u32 = 10240;
const PT_ENV: u32 = 12288;
const PT_N: u32 = 36864;
const PT_PC: u32 = 36868;
const PT_EN: u32 = 36872;
const PT_GFN: u32 = 36876;
const PT_NG: u32 = 36940;
const PT_MAX: u32 = 64;
const PT_EMAX: u32 = 1536;
const PT_AMAX: u32 = 4;
const PT_GMAX: u32 = 16;
const PT_TMPA: u32 = 36944;      // 一次调用点的实参类型区间（按**形参序**，4 对）
const PT_TMPB: u32 = 36976;      // 同一批按**类型形参序**整理后的那份（4 对）
const PT_TMPC: u32 = 37008;      // 每个类型形参"见过没"（4 格 u32）
// 上面这一块到此为止 —— **再往后是 M7 的四张表**（类型串池 / 映射表 / 临时缓冲 / 两个游标，
// 收在 46768）。那几条常量声明在文件靠前处（查表那半在那儿），因为本语言"先定义后使用"。

// 实例表一条（32 字节）
const PE_NAME: u32 = 0;      // 名字在池里的起点
const PE_NLEN: u32 = 4;      // 名字长度
const PE_BASE: u32 = 8;      // 实例名的起点？（占位）—— 见 PE_DECL
const PE_DECL: u32 = 8;      // 那个泛型声明的名字 token
const PE_LT: u32 = 12;       // 声明的 `<` token（类型形参从那一位之后开始）
const PE_NTP: u32 = 16;      // 类型形参个数
const PE_NARG: u32 = 20;     // 实参个数
const PE_IOFF: u32 = 24;     // 实参表里的下标（每条 32 字节）

// 局部变量表一条（16 字节）
const EV_NAME: u32 = 0;      // 名字 token
const EV_TS: u32 = 4;        // 类型起点 token
const EV_TE: u32 = 8;        // 类型终点 token（不含）
const EV_D: u32 = 12;        // 块深度（`}` 一收就丢这一层）

fn pt_sc_new() -> ptr {
    let v: u64 = pt_alloc(PT_SC_BYTES);
    let sc: ptr = v as ptr;
    store32(sc, PT_N, 0);
    store32(sc, PT_PC, 0);
    store32(sc, PT_EN, 0);
    store32(sc, PT_TN, 0);
    store32(sc, PT_TCUR, 0);
    return sc;
}

fn pt_same(src: ptr, t: ptr, a: u32, b: u32) -> u32 {
    if pt_kind(t, a) != 0 || pt_kind(t, b) != 0 {
        return 0;
    }
    let la: u32 = pt_tlen(t, a);
    if la != pt_tlen(t, b) {
        return 0;
    }
    let oa: u32 = pt_off(t, a);
    let ob: u32 = pt_off(t, b);
    let k: u32 = 0;
    while k < la {
        if (load8(src, oa + k) as u32) != (load8(src, ob + k) as u32) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// 在两个指针上按字节比 `n` 个字节（池内的名字之间比）。
fn pt_pool_eq(a: ptr, ao: u32, al: u32, b: ptr, bo: u32, bl: u32) -> u32 {
    if al != bl {
        return 0;
    }
    let k: u32 = 0;
    while k < al {
        if (load8(a, ao + k) as u32) != (load8(b, bo + k) as u32) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// 实例名：`<基名>_<实参1>_<实参2>`（参考实现是 `base + "_" + "_".join(args)`）。
/// 渲进名字池，返回 `(池内起点 << 32) | 长度`。
fn pt_inst_name(sc: ptr, unit: ptr, t: ptr, base_tok: u32, ags: ptr, narg: u32) -> u64 {
    let po: u32 = load32(sc, PT_PC);
    let st: u32 = po;
    let bo: u32 = pt_off(t, base_tok);
    let bl: u32 = pt_tlen(t, base_tok);
    let k: u32 = 0;
    while k < bl {
        store8(sc, po, load8(unit, bo + k) as u8);
        po = po + 1;
        k = k + 1;
    }
    let a: u32 = 0;
    while a < narg {
        store8(sc, po, 95 as u8);
        po = po + 1;
        let r: u64 = pt_ty(sc, po, unit, t, load32(ags, a * 8));
        po = (r % 4294967296) as u32;
        a = a + 1;
    }
    store32(sc, PT_PC, po);
    return (st as u64) * 4294967296 + ((po - st) as u64);
}

/// 名字池里有没有同名的实例（键就是名字：`max_of_u32` 唯一决定 `(max_of, [u32])`）。
fn pt_inst_find(sc: ptr, noff: u32, nlen: u32) -> u32 {
    let n: u32 = load32(sc, PT_N);
    let i: u32 = 0;
    while i < n {
        let e: u32 = PT_TAB + i * 32;
        if pt_pool_eq(sc, load32(sc, e + PE_NAME), load32(sc, e + PE_NLEN),
                      sc, noff, nlen) == 1 {
            return i;
        }
        i = i + 1;
    }
    return PT_NONE;
}

/// 类型渲染的**替换版**：类型形参那个 token 换成实参类型的 token 区间。
/// 形状与 `pt_ty` 完全一致（它是 `pt_ty` 加两处钩子），递归时用自己。
fn pt_ty_sub(out: ptr, o: u32, unit: ptr, t: ptr, i: u32,
             lt: u32, ntp: u32, ags: ptr) -> u64 {
    let j: u32 = i;
    // 钩子①: 名字位置上如果是类型形参 -> 换成实参的类型（形参在 lt+1, lt+3, …）
    if pt_kind(t, j) == 0 && !pt_tis(unit, t, j, "mut") {
        let k: u32 = 0;
        while k < ntp {
            if pt_same(unit, t, j, lt + 1 + k * 2) == 1 {
                let r0: u64 = pt_ty(out, o, unit, t, load32(ags, k * 8));
                o = (r0 % 4294967296) as u32;
                return ((j + 1) as u64) * 4294967296 + (o as u64);
            }
            k = k + 1;
        }
    }
    if pt_tis(unit, t, j, "mut") && pt_tis(unit, t, j + 1, "[") {
        o = pt_str(out, o, "mut [");
        let r1: u64 = pt_ty_sub(out, o, unit, t, j + 2, lt, ntp, ags);
        o = (r1 % 4294967296) as u32;
        j = (r1 / 4294967296) as u32;
        o = pt_str(out, o, "]");
        return ((j + 1) as u64) * 4294967296 + (o as u64);
    }
    if pt_tis(unit, t, j, "[") {
        o = pt_str(out, o, "[");
        let r2: u64 = pt_ty_sub(out, o, unit, t, j + 1, lt, ntp, ags);
        o = (r2 % 4294967296) as u32;
        j = (r2 / 4294967296) as u32;
        if pt_tis(unit, t, j, ";") {
            o = pt_str(out, o, "; ");
            o = pt_num(out, o, unit, t, j + 1);
            j = j + 2;
        }
        o = pt_str(out, o, "]");
        return ((j + 1) as u64) * 4294967296 + (o as u64);
    }
    o = pt_mem(out, o, unit, pt_off(t, j), pt_tlen(t, j));
    j = j + 1;
    if pt_tis(unit, t, j, "<") {
        o = pt_str(out, o, "<");
        j = j + 1;
        while !pt_tis(unit, t, j, ">") && pt_kind(t, j) != 4 {
            let r3: u64 = pt_ty_sub(out, o, unit, t, j, lt, ntp, ags);
            o = (r3 % 4294967296) as u32;
            j = (r3 / 4294967296) as u32;
            if pt_tis(unit, t, j, ",") {
                o = pt_str(out, o, ", ");
                j = j + 1;
            }
        }
        j = j + 1;
        o = pt_str(out, o, ">");
    }
    return (j as u64) * 4294967296 + (o as u64);
}

/// `pt_ty_sub` 的**查表版**：把类型形参换成实参**之后**，再整段查一次映射表 ——
/// 参考实现的 `_replace_type` 正是这个次序（`mp` 里同时有"形参→实参"与"类型串→实例名"
/// 两种键，一次递归全用上）。实例里的字段/形参因此能同时做掉这两件事。
fn pt_ty_subm(sc: ptr, out: ptr, o: u32, unit: ptr, t: ptr, i: u32,
              lt: u32, ntp: u32, ags: ptr) -> u64 {
    let a: u32 = o;
    let r: u64 = pt_ty_sub(out, o, unit, t, i, lt, ntp, ags);
    let e: u32 = (r % 4294967296) as u32;
    let ne: u32 = pt_map_slice(sc, out, a, e);
    return ((r / 4294967296) as u64) * 4294967296 + (ne as u64);
}

/// 局部变量表：压一条。满了**不写**（调用方在进函数前先查 `PT_EN < PT_EMAX` 再走，
/// 所以这里是"到不了"的那一支 —— 本语言没有裸 `return;`，所以写成 if/else）。
fn pt_env_put(sc: ptr, name_tok: u32, ts: u32, te: u32, d: u32) {
    let n: u32 = load32(sc, PT_EN);
    if n < PT_EMAX {
        let e: u32 = PT_ENV + n * 16;
        store32(sc, e + EV_NAME, name_tok);
        store32(sc, e + EV_TS, ts);
        store32(sc, e + EV_TE, te);
        store32(sc, e + EV_D, d);
        store32(sc, PT_EN, n + 1);
    }
}

/// 局部变量表：按名字令牌**从后往前**查（最近的 `let` 赢，与作用域语义一致）。
/// 返回 `(类型起点 << 32) | 类型终点`；没找到返回 `PT_NONE`（当 u64 用不了，用 0 表示）。
fn pt_env_get(sc: ptr, unit: ptr, t: ptr, name_tok: u32) -> u64 {
    let n: u32 = load32(sc, PT_EN);
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        let e: u32 = PT_ENV + i * 16;
        if pt_same(unit, t, load32(sc, e + EV_NAME), name_tok) == 1 {
            return (load32(sc, e + EV_TS) as u64) * 4294967296 + (load32(sc, e + EV_TE) as u64);
        }
    }
    return 0;
}

/// 弹掉深度 > `d` 的局部（一个块收了）。**没有裸 `return;`**，所以用"边弹边判"的写法。
fn pt_env_pop(sc: ptr, d: u32) {
    let n: u32 = load32(sc, PT_EN);
    let go: u32 = 1;
    while n > 0 && go == 1 {
        let e: u32 = PT_ENV + (n - 1) * 16;
        if load32(sc, e + EV_D) <= d {
            go = 0;
        } else {
            n = n - 1;
        }
    }
    store32(sc, PT_EN, n);
}

/// 找一个**类型声明**（`struct` / `enum`）的下标（指向 `struct`/`enum` 那个词），
/// 名字与 `name_tok` 相同的**第一个**；找不到 `PT_NONE`。只扫**深度 0**。
///
/// 与 `pt_find_gtype` 的区别：那个在**名字池**里比对（它服务于"建实例名"那条路，
/// 手上是池里的键），这个直接比单元里的 token —— 字段访问那条路手上只有 token，
/// 而且**不要求声明是泛型的**（`struct S { a: u32 }` 也要能找到）。
fn pt_tdecl_find(unit: ptr, t: ptr, lo: u32, hi: u32, name_tok: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && k == 0 && pt_kind(t, i + 1) == 0
                && (pt_tis(unit, t, i, "struct") || pt_tis(unit, t, i, "enum"))
                && pt_same(unit, t, i + 1, name_tok) == 1 {
            return i;
        }
        i = i + 1;
    }
    return PT_NONE;
}

/// 声明体（`{`…`}`）里名为 `fld_tok` 的字段的**类型 token 区间**；找不到返回 0。
///
/// 形状与 `pt_fields` 同：字段是**定长**的 `名字 : 类型`，`,` 与 `;` 都在第 0 层分隔。
/// `at_name` 那格的作用是**别把类型里同名的标识符当字段名**（`a: T` 里的 `T`）。
fn pt_field_ts(unit: ptr, t: ptr, brc: u32, hi: u32, fld_tok: u32) -> u64 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    while j < hi && pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            if pt_same(unit, t, j, fld_tok) == 1 {
                let ts: u32 = j + 2;
                let te: u32 = pt_ty_end(unit, t, ts, hi);
                if te > ts {
                    return (ts as u64) * 4294967296 + (te as u64);
                }
                return 0;
            }
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    return 0;
}

/// 声明 `struct Pair<T, U>` 里名为 `p_tok` 的类型形参的**序号**（从 0 起）；
/// 不是它的形参（或声明没有 `<…>`）返回 `PT_NONE`。
fn pt_tp_index(unit: ptr, t: ptr, decl: u32, hi: u32, p_tok: u32) -> u32 {
    let lt: u32 = pt_find_ch(unit, t, decl + 1, hi, "<");
    if lt == PT_NONE {
        return PT_NONE;
    }
    let gt: u32 = pt_match(unit, t, lt, "<", ">");
    let j: u32 = lt + 1;
    let d: u32 = 0;
    let k: u32 = 0;
    while j < gt && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 {
            if pt_kind(t, j) == 0 && pt_same(unit, t, j, p_tok) == 1 {
                return k;
            }
            if pt_tis(unit, t, j, ",") {
                k = k + 1;
            }
        }
        j = j + 1;
    }
    return PT_NONE;
}

/// 写在**声明处**的类型 `Name<A, B>` 里第 `k` 个类型实参的 token 区间；没有返回 0。
fn pt_arg_ts(unit: ptr, t: ptr, lt: u32, hi: u32, k: u32) -> u64 {
    let gt: u32 = pt_match(unit, t, lt, "<", ">");
    let j: u32 = lt + 1;
    let d: u32 = 0;
    let c: u32 = 0;
    while j < gt && pt_kind(t, j) != 4 {
        if d == 0 && c == k {
            let te: u32 = pt_ty_end(unit, t, j, gt);
            if te > j {
                return (j as u64) * 4294967296 + (te as u64);
            }
            return 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && pt_tis(unit, t, j, ",") {
            c = c + 1;
        }
        j = j + 1;
    }
    return 0;
}

/// `p.a` —— **字段访问当泛型实参**。参考实现按**字段的类型**推（`p.a` → `u32`），
/// 这一条与它同口径；推不出来返回 0，由 `pt_mono_call` 点名拒。
///
/// 泛型 struct 的字段类型若**就是**那个类型形参（`struct Pair<T> { a: T }`），要换成
/// **声明处写的实参**（`let p: Pair<u32>` 里那个 `u32`）。这里**不造新 token** ——
/// 直接把区间指回单元里那一段就够了：改名走的是"渲完查表"，而那段 token 本来就在单元里
/// （这是这一格省掉一整套临时串的关窍）。
fn pt_field_arg_ty(sc: ptr, unit: ptr, t: ptr, hi: u32, obj_tok: u32, fld_tok: u32) -> u64 {
    let ty: u64 = pt_env_get(sc, unit, t, obj_tok);
    if ty == 0 {
        return 0;
    }
    let ts: u32 = (ty / 4294967296) as u32;
    if pt_kind(t, ts) != 0 {
        return 0;
    }
    let decl: u32 = pt_tdecl_find(unit, t, 0, hi, ts);
    if decl == PT_NONE {
        return 0;
    }
    let brc: u32 = pt_find_ch(unit, t, decl + 1, hi, "{");
    if brc == PT_NONE {
        return 0;
    }
    let fty: u64 = pt_field_ts(unit, t, brc, hi, fld_tok);
    if fty == 0 {
        return 0;
    }
    let fs: u32 = (fty / 4294967296) as u32;
    let fe: u32 = (fty % 4294967296) as u32;
    if pt_kind(t, fs) == 0 && fe == fs + 1 && pt_tis(unit, t, ts + 1, "<") {
        let k: u32 = pt_tp_index(unit, t, decl, hi, fs);
        if k != PT_NONE {
            return pt_arg_ts(unit, t, ts + 1, hi, k);
        }
    }
    return fty;
}

/// 一个实参的**类型 token 区间**（`(起点 << 32) | 终点`），定不出来就是 0。
/// 收三种形态：标识符（查局部表）、`x as T`（取 `as` 后面那个类型）、
/// 以及 `p.a`（**字段访问**，取字段的类型 —— 见 `pt_field_arg_ty`）。
/// `p[0]` / `f(x)` 仍然不定（返回 0），由 `pt_mono_call` 点名拒。
fn pt_arg_ty(sc: ptr, unit: ptr, t: ptr, i: u32, hi: u32) -> u64 {
    let j: u32 = i;
    // `K as T`：K 只要求"个值" —— **字面量也算**（`outer(1 as u32, 2 as u32)` 那种形状）。
    // 参考实现按表达式的类型推，不管操作数是标识符还是字面量；这一格原先只认 kind 0，
    // 于是 `1 as u32` 落到"实参形态超出这一节"上 —— 直到 R4 这一轮才撞出来
    // （`native_chain.lomt` 的 `main` 就是那么写的，而它以前排在 `REFUSED` 里，碰不到）。
    if (pt_kind(t, j) == 0 || pt_kind(t, j) == 1) && pt_kind(t, j + 1) == 0
            && pt_tis(unit, t, j + 1, "as") {
        let ts: u32 = j + 2;
        let te: u32 = pt_ty_end(unit, t, ts, hi);
        return (ts as u64) * 4294967296 + (te as u64);
    }
    // ⚠ 标识符**后面不是分隔符**时不能拿它自己的声明类型顶替 —— 顶替出来的实例名会是
    // `max_Pair<u32>` 那种（参考实现按**字段**类型推成 `u32`，于是它叫 `max_u32`）。
    // 所以 `p.a` 走 `pt_field_arg_ty` 单独推；`p[0]` / `f(x)` 仍然定不出来、点名拒。
    if pt_kind(t, j) == 0 && pt_kind(t, j + 1) != 0 && pt_tis(unit, t, j + 1, ".") {
        if pt_kind(t, j + 2) == 0 {
            return pt_field_arg_ty(sc, unit, t, hi, j, j + 2);
        }
        return 0;
    }
    if pt_kind(t, j) == 0 && pt_kind(t, j + 1) != 0
            && !pt_tis(unit, t, j + 1, "[") && !pt_tis(unit, t, j + 1, "(") {
        return pt_env_get(sc, unit, t, j);
    }
    return 0;
}

/// 一个类型的结束 token（不含）—— 与 `pt_ty` 的吃法一致，只是不写输出。
fn pt_ty_end(unit: ptr, t: ptr, i: u32, hi: u32) -> u32 {
    let j: u32 = i;
    if pt_tis(unit, t, j, "mut") {
        j = j + 1;
    }
    if pt_tis(unit, t, j, "[") {
        let d: u32 = 0;
        while j < hi && pt_kind(t, j) != 4 {
            if pt_tis(unit, t, j, "[") {
                d = d + 1;
            }
            if pt_tis(unit, t, j, "]") {
                d = d - 1;
                if d == 0 {
                    return j + 1;
                }
            }
            j = j + 1;
        }
        return j;
    }
    j = j + 1;
    if pt_tis(unit, t, j, "<") {
        let d2: u32 = 0;
        while j < hi && pt_kind(t, j) != 4 {
            if pt_tis(unit, t, j, "<") {
                d2 = d2 + 1;
            }
            if pt_tis(unit, t, j, ">") {
                d2 = d2 - 1;
                if d2 == 0 {
                    return j + 1;
                }
            }
            j = j + 1;
        }
        return j;
    }
    return j;
}

/// 先把**泛型函数声明**的名字 token 收进工作区（`fn NAME <`）。每次调用点都要查，
/// 逐次扫全单元是 O(调用点 × token)，不能那么干；泛型声明本来就只有个位数。
/// 超上限（16）返回 1 = 拒绝。
fn pt_gfn_scan(sc: ptr, unit: ptr, t: ptr, nt: u32) -> u32 {
    let n: u32 = 0;
    let d: u32 = 0;
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if pt_tis(unit, t, i, "fn") && pt_kind(t, i + 1) == 0
                && pt_tis(unit, t, i + 2, "<") {
            // **impl 块里的泛型方法**不收：那类实例的第一个形参是 `self`（要改名成 `__self`
            // 并填接受者类型），这一节没做 —— 报出来比发错好。
            if d != 0 {
                return 1;
            }
            if n >= PT_GMAX {
                return 1;
            }
            store32(sc, PT_GFN + n * 4, i + 1);
            n = n + 1;
        }
        i = i + 1;
    }
    store32(sc, PT_NG, n);
    return 0;
}

/// 这个 token 是哪个泛型函数的**声明名**？返回声明处的名字 token（`PT_NONE` = 不是）。
fn pt_gfn_find(sc: ptr, unit: ptr, t: ptr, name_tok: u32) -> u32 {
    let n: u32 = load32(sc, PT_NG);
    let k: u32 = 0;
    while k < n {
        let d: u32 = load32(sc, PT_GFN + k * 4);
        if pt_same(unit, t, d, name_tok) == 1 {
            return d;
        }
        k = k + 1;
    }
    return PT_NONE;
}

/// 加一个实例（名字已经在池里了）。返回新条数；满了返回 `PT_MAX + 1` = 拒绝。
fn pt_inst_add(sc: ptr, noff: u32, nlen: u32, decl: u32, lt: u32,
               ntp: u32, narg: u32, ags: ptr) -> u32 {
    let n: u32 = load32(sc, PT_N);
    if n >= PT_MAX {
        return PT_MAX + 1;
    }
    let e: u32 = PT_TAB + n * 32;
    store32(sc, e + PE_NAME, noff);
    store32(sc, e + PE_NLEN, nlen);
    store32(sc, e + PE_DECL, decl);
    store32(sc, e + PE_LT, lt);
    store32(sc, e + PE_NTP, ntp);
    store32(sc, e + PE_NARG, narg);
    store32(sc, e + PE_IOFF, n * 32);
    let a: u32 = 0;
    while a < narg {
        store32(sc, PT_ATAB + n * 32 + a * 8, load32(ags, a * 8));
        store32(sc, PT_ATAB + n * 32 + a * 8 + 4, load32(ags, a * 8 + 4));
        a = a + 1;
    }
    store32(sc, PT_N, n + 1);
    return n + 1;
}

/// 一次调用点：实参类型定得出来就建实例（同名已存在就复用）。
/// 返回 0 = 成（或者"推不出形参、本来就该跳过"），1 = 拒绝（实参形态超出子集）。
fn pt_mono_call(sc: ptr, unit: ptr, t: ptr, nt: u32, decl: u32, lp: u32, narg: u32) -> u32 {
    let lt: u32 = decl + 1;                       // 声明名后面那个 `<`
    let gt: u32 = pt_match(unit, t, lt, "<", ">");
    let ntp: u32 = pt_cnt_tps(unit, t, lt, gt);
    if narg > PT_AMAX || ntp > PT_AMAX {
        return 1;                                 // 形参/实参过多：子集外
    }
    // 实参的类型 token 区间（定不出来 = 0）
    let ags: ptr = ptr_add(sc, PT_TMPA);
    let j: u32 = lp + 1;
    let a: u32 = 0;
    while a < narg {
        // 实参是"表达式"，这里只收两种形态（见 `pt_arg_ty` 的注释）
        let ty: u64 = pt_arg_ty(sc, unit, t, j, nt);
        if ty == 0 {
            return 1;                             // 定不出类型：点子集之外，点名拒
        }
        store32(ags, a * 8, (ty / 4294967296) as u32);
        store32(ags, a * 8 + 4, (ty % 4294967296) as u32);
        // 走到下一个顶层逗号（括号/方括号/尖括号里的不算）—— **没有 `break`**，
        // 所以用 `go` 标志；`j` 停在逗号上时再 +1（与参考实现的 `accept(",")` 同形）。
        let d: u32 = 0;
        let go: u32 = 1;
        while j < nt && pt_kind(t, j) != 4 && go == 1 {
            if pt_tis(unit, t, j, "(") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "<") {
                d = d + 1;
            }
            if pt_tis(unit, t, j, ")") || pt_tis(unit, t, j, "]") || pt_tis(unit, t, j, ">") {
                if d == 0 {
                    go = 0;
                } else {
                    d = d - 1;
                }
            }
            if go == 1 {
                if d == 0 && pt_tis(unit, t, j, ",") {
                    j = j + 1;
                    go = 0;
                } else {
                    j = j + 1;
                }
            }
        }
        a = a + 1;
    }
    let st: u64 = pt_targs(sc, unit, t, nt, decl, ntp, narg);
    let code: u32 = (st % 4294967296) as u32;
    if code == 2 {
        return 1;                          // 拒绝：形参类型里有切片/数组套着类型形参
    }
    if code == 1 {
        return 0;                          // 跳过：推不出全部形参（参考实现也不建实例）
    }
    let noff: u32 = load32(sc, PT_TMPC + 16);
    let nlen: u32 = load32(sc, PT_TMPC + 20);
    if pt_inst_find(sc, noff, nlen) != PT_NONE {
        return 0;
    }
    let dst: ptr = ptr_add(sc, PT_TMPB);
    let r: u32 = pt_inst_add(sc, noff, nlen, decl, lt, ntp, ntp, dst);
    if r > PT_MAX {
        return 1;
    }
    return 0;
}

/// 两段 token 的**原文**相等吗（长度 + 逐 token 逐字节）—— 比的是类型串本身。
fn pt_span_eq(src: ptr, t: ptr, a: u32, ae: u32, b: u32, be: u32) -> u32 {
    if ae - a != be - b {
        return 0;
    }
    let i: u32 = 0;
    while i < ae - a {
        if pt_tlen(t, a + i) != pt_tlen(t, b + i) {
            return 0;
        }
        let oa: u32 = pt_off(t, a + i);
        let ob: u32 = pt_off(t, b + i);
        let k: u32 = 0;
        while k < pt_tlen(t, a + i) {
            if (load8(src, oa + k) as u32) != (load8(src, ob + k) as u32) {
                return 0;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return 1;
}

/// 把"按形参序收好的实参类型"整理成**按类型形参序**（参考实现的 `_infer_targs`），
/// 顺便把名字建出来。返回 `(名字 << 32) | 结果`：结果 1 = 跳过（推不出全部形参，
/// 或者同一个形参被推成两个类型 —— 参考实现在这两种情况下**都不建实例**），
/// 2 = 拒绝（形参类型里有切片/数组套着类型形参 —— 那一支还没做）。
fn pt_targs(sc: ptr, unit: ptr, t: ptr, nt: u32, decl: u32, ntp: u32, narg: u32) -> u64 {
    let lt: u32 = decl + 1;
    let src: ptr = ptr_add(sc, PT_TMPA);
    let dst: ptr = ptr_add(sc, PT_TMPB);
    let seen: ptr = ptr_add(sc, PT_TMPC);
    let k: u32 = 0;
    while k < PT_AMAX {
        store32(seen, k * 4, 0);
        k = k + 1;
    }
    let dlp: u32 = pt_find_ch(unit, t, decl + 1, nt, "(");
    let j: u32 = dlp + 1;
    let a: u32 = 0;
    while a < narg && j < nt && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, ")") {
            a = narg;                       // 形参比实参少：不该发生（检查器担保）
        } else {
            let ts: u32 = j + 2;            // 形参名 `:` 类型
            let te: u32 = pt_ty_end(unit, t, ts, nt);
            if pt_kind(t, ts) == 0 && te == ts + 1 {
                // 单名类型：是类型形参就记下来，不是就**不管**（参考实现只映形参）
                let m: u32 = 0;
                while m < ntp {
                    if pt_same(unit, t, ts, lt + 1 + m * 2) == 1 {
                        if load32(seen, m * 4) == 1 {
                            // 同一个形参推成**两个不同**的类型 -> 参考实现返回 None -> 不建实例。
                            // ⚠ 推成**同一个**类型是合法的（`fn f<T>(a: T, b: T)` 正是这样），
                            // 所以这里比的是类型本身，不是"见没见过"。
                            let s1: u32 = load32(dst, m * 8);
                            let e1: u32 = load32(dst, m * 8 + 4);
                            let s2: u32 = load32(src, a * 8);
                            let e2: u32 = load32(src, a * 8 + 4);
                            if pt_span_eq(unit, t, s1, e1, s2, e2) == 0 {
                                return (0 as u64) * 4294967296 + 1;
                            }
                        } else {
                            store32(seen, m * 4, 1);
                            store32(dst, m * 8, load32(src, a * 8));
                            store32(dst, m * 8 + 4, load32(src, a * 8 + 4));
                        }
                    }
                    m = m + 1;
                }
            } else {
                // 切片/数组（或别的复合形）：里面出现类型形参就是没做的那一支
                let q: u32 = ts;
                while q < te {
                    let m2: u32 = 0;
                    while m2 < ntp {
                        if pt_same(unit, t, q, lt + 1 + m2 * 2) == 1 {
                            return (0 as u64) * 4294967296 + 2;
                        }
                        m2 = m2 + 1;
                    }
                    q = q + 1;
                }
            }
            j = te;
            if pt_tis(unit, t, j, ",") {
                j = j + 1;
            }
            a = a + 1;
        }
    }
    // 形参没全推出来 -> 不建实例（与参考实现的 `all(t in m …)` 同一条）
    let m3: u32 = 0;
    while m3 < ntp {
        if load32(seen, m3 * 4) == 0 {
            return (0 as u64) * 4294967296 + 1;
        }
        m3 = m3 + 1;
    }
    let nm2: u64 = pt_inst_name(sc, unit, t, decl, dst, ntp);
    store32(sc, PT_TMPC + 16, (nm2 / 4294967296) as u32);
    store32(sc, PT_TMPC + 20, (nm2 % 4294967296) as u32);
    return 0;
}

/// 走一个函数体：维护局部变量表，遇到泛型调用就建实例。返回 1 = 拒绝。
fn pt_mono_body(sc: ptr, unit: ptr, t: ptr, nt: u32, brc: u32, body_end: u32) -> u32 {
    let d: u32 = 1;                    // 函数体那一层
    let j: u32 = brc + 1;
    while j < body_end && pt_kind(t, j) != 4 {
        let k: u32 = pt_kind(t, j);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, j)) as u32;
            if c == 123 {
                d = d + 1;
            }
            if c == 125 {
                d = d - 1;
                pt_env_pop(sc, d);
            }
        } else if k == 0 {
            if pt_tis(unit, t, j, "let") && pt_kind(t, j + 1) == 0 && pt_tis(unit, t, j + 2, ":") {
                let ts: u32 = j + 3;
                let te: u32 = pt_ty_end(unit, t, ts, nt);
                pt_env_put(sc, j + 1, ts, te, d);
            } else if pt_kind(t, j + 1) == 3 && pt_tis(unit, t, j + 1, "(") {
                let decl: u32 = pt_gfn_find(sc, unit, t, j);
                if decl != PT_NONE {
                    // 实参个数：`(` 到配对的 `)` 之间顶层逗号 + 1
                    let rp: u32 = pt_match(unit, t, j + 1, "(", ")");
                    let narg: u32 = pt_cnt_params(unit, t, j + 1);
                    let rc: u32 = pt_mono_call(sc, unit, t, nt, decl, j + 1, narg);
                    if rc != 0 {
                        return 1;
                    }
                    j = rp;
                }
            }
        }
        j = j + 1;
    }
    return 0;
}

/// 走单元里的**非泛型函数体**，以及**实例的体**，跑到**不动点**。
///
/// 与参考实现（`tools/lomentc.py` 的 `prepare`，M6 那半）同构。它的形状是：
///
///     for _ in range(8):
///         pool = [所有函数] + [已建的实例]
///         for f in pool: if f 有类型形参 or 走过: continue; 走它的体
///         if 这轮没建出新实例: break
///
/// **两点都是关键**，缺一条链式泛型就走不出来：
///
///   * **泛型声明本身不走进**（对应 `f.tparams` 那条）—— 走它只会看到还没换掉的 `T`，
///     于是造出 `pick_T` 那种**发得出去但是错的**实例名；
///   * **实例的体要走进**，而且形参类型要按实参**换掉**（`a: T` → `u32`）——
///     `return pick(a, b);` 里的 `pick_u32` 就是这一步才推得出来的。
///
/// 顺序：第 0 轮走单元里的非泛型声明，之后每轮走**上一轮新建的**实例。这与参考实现
/// "每轮过一遍池子、只走没走过的"是同一件事，所以实例的**创建顺序**也对得上 ——
/// 而那个顺序是逐字节判据的一部分（`instances` 那一格的输出顺序）。
fn pt_mono_all(sc: ptr, unit: ptr, t: ptr, nt: u32) -> u32 {
    // 第 0 轮：单元里的**非泛型**函数体
    let i: u32 = 0;
    while i < nt && pt_kind(t, i) != 4 {
        if pt_kind(t, i) == 0 && pt_tis(unit, t, i, "fn") {
            let lp: u32 = pt_find_ch(unit, t, i + 1, nt, "(");
            let brc: u32 = pt_find_ch(unit, t, i + 1, nt, "{");
            let be: u32 = pt_match(unit, t, brc, "{", "}");
            let is_gen: u32 = 0;
            if pt_tis(unit, t, i + 2, "<") {
                is_gen = 1;
            }
            if is_gen == 0 {
                let mrc: u32 = pt_mono_one(sc, unit, t, nt, lp, brc, be, 0, 0);
                if mrc != 0 {
                    return mrc;
                }
            }
            i = be;
        }
        i = i + 1;
    }
    // 之后每轮走上一轮**新建的**实例，直到不动点
    let cur: u32 = 0;
    let round: u32 = 0;
    while round < 8 {
        let n: u32 = load32(sc, PT_N);
        if cur >= n {
            round = 8;                     // 不动点（这个文件没有 `break`）
        } else {
            let k: u32 = cur;
            while k < n {
                let irc: u32 = pt_mono_inst(sc, unit, t, nt, k);
                if irc != 0 {
                    return irc;
                }
                k = k + 1;
            }
            cur = n;
            round = round + 1;
        }
    }
    return 0;
}

/// 走**一个**函数体：形参先进局部表（`self` 那条路由 impl 那条路管，这里不碰），再走体。
/// `lt` 非 0 表示**这是实例**：形参类型是**裸类型形参**的要换成该实例的实参类型。
fn pt_mono_one(sc: ptr, unit: ptr, t: ptr, nt: u32, lp: u32, brc: u32, be: u32,
               lt: u32, ioff: u32) -> u32 {
    let _n0: u32 = load32(sc, PT_EN);
    let j: u32 = lp + 1;
    let d: u32 = 1;
    while j < brc && pt_kind(t, j) != 4 {
        if pt_kind(t, j) == 0 && pt_tis(unit, t, j + 1, ":") {
            let ts: u32 = j + 2;
            let te: u32 = pt_ty_end(unit, t, ts, nt);
            let r: u64 = pt_subst_ts(sc, unit, t, lt, ioff, ts, te);
            if r == 0 {
                return 2;                  // 换不出来：点名拒（宁拒勿猜）
            }
            pt_env_put(sc, j, (r / 4294967296) as u32, (r % 4294967296) as u32, d);
            j = te;
        }
        j = j + 1;
    }
    let mrc: u32 = pt_mono_body(sc, unit, t, nt, brc, be);
    if mrc != 0 {
        return 1;
    }
    store32(sc, PT_EN, 0);                 // 每个函数一张新表（与参考实现同口径）
    return 0;
}

/// 第 `k` 条实例的实参表里第 `a` 个实参的类型区间。`ioff` 就是 `PE_IOFF`（字节下标）。
fn pt_inst_arg(sc: ptr, ioff: u32, a: u32) -> u64 {
    let ts: u32 = load32(sc, PT_ATAB + ioff + a * 8);
    let te: u32 = load32(sc, PT_ATAB + ioff + a * 8 + 4);
    return (ts as u64) * 4294967296 + (te as u64);
}

/// 声明的 `<`（`lt`）之后第几个类型形参叫 `p_tok`；不是形参返回 `PT_NONE`。
/// 与 `pt_tp_index` 同一件事，只是手上直接有那个 `<`（实例表里存的就是它）。
fn pt_tp_index_at(unit: ptr, t: ptr, lt: u32, p_tok: u32) -> u32 {
    let gt: u32 = pt_match(unit, t, lt, "<", ">");
    let j: u32 = lt + 1;
    let k: u32 = 0;
    while j < gt && pt_kind(t, j) != 4 {
        if pt_kind(t, j) == 0 && pt_same(unit, t, j, p_tok) == 1 {
            return k;
        }
        if pt_tis(unit, t, j, ",") {
            k = k + 1;
        }
        j = j + 1;
    }
    return PT_NONE;
}

/// 形参类型的**替换**：`lt == 0` 表示不是实例（原样返回）；是实例时，类型若**恰好**是一个
/// 类型形参，就换成对应实参的区间。类型里**提到**了类型形参而不是裸的（如 `p: Pair<T>`）
/// → 返回 0，由调用方**点名拒** —— 那种要把整段换一遍，不是这一格做的（宁拒勿猜）。
fn pt_subst_ts(sc: ptr, unit: ptr, t: ptr, lt: u32, ioff: u32, ts: u32, te: u32) -> u64 {
    let raw: u64 = (ts as u64) * 4294967296 + (te as u64);
    if lt == 0 {
        return raw;
    }
    if te == ts + 1 && pt_kind(t, ts) == 0 {
        let k: u32 = pt_tp_index_at(unit, t, lt, ts);
        if k != PT_NONE {
            return pt_inst_arg(sc, ioff, k);
        }
        return raw;                        // 具体类型名（如 `u32`），原样
    }
    let j: u32 = ts;
    while j < te && pt_kind(t, j) != 4 {
        if pt_kind(t, j) == 0 && pt_tp_index_at(unit, t, lt, j) != PT_NONE {
            return 0;
        }
        j = j + 1;
    }
    return raw;
}

/// 走第 `k` 条实例的体。实例表里存着三样正好够用的东西：声明的**名字 token**（`PE_DECL`）、
/// 它的 `<`（`PE_LT`）、实参表下标（`PE_IOFF`）。
fn pt_mono_inst(sc: ptr, unit: ptr, t: ptr, nt: u32, k: u32) -> u32 {
    let e: u32 = PT_TAB + k * 32;
    let nm: u32 = load32(sc, e + PE_DECL);
    let lt: u32 = load32(sc, e + PE_LT);
    let ioff: u32 = load32(sc, e + PE_IOFF);
    let lp: u32 = pt_find_ch(unit, t, nm + 1, nt, "(");
    let brc: u32 = pt_find_ch(unit, t, nm + 1, nt, "{");
    if lp == PT_NONE || brc == PT_NONE {
        return 1;
    }
    let be: u32 = pt_match(unit, t, brc, "{", "}");
    return pt_mono_one(sc, unit, t, nt, lp, brc, be, lt, ioff);
}

/// 名字池里的一段按 **JSON 字符串**写出（实例名都是标识符+数字+下划线，无需转义）。
fn pt_pool_q(out: ptr, o: u32, sc: ptr, off: u32, n: u32) -> u32 {
    store8(out, o, 34 as u8);
    o = o + 1;
    let i: u32 = 0;
    while i < n {
        store8(out, o, load8(sc, off + i) as u8);
        o = o + 1;
        i = i + 1;
    }
    store8(out, o, 34 as u8);
    return o + 1;
}

/// 一个 fn 实例的形参表：与 `pt_params` 同形，但类型走**替换版**（类型形参 -> 实参类型）。
fn pt_params_sub(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lp: u32, n: u32, e: u32) -> u32 {
    let j: u32 = lp + 1;
    let i: u32 = 0;
    while i < n {
        o = pt_aelm(out, o, 4, i);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 5, "name");
        o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 5, "type");
        o = pt_str(out, o, "\"");
        let lt: u32 = load32(sc, PT_TAB + e * 32 + PE_LT);
        let ntp: u32 = load32(sc, PT_TAB + e * 32 + PE_NTP);
        let aio: ptr = ptr_add(sc, PT_ATAB + load32(sc, PT_TAB + e * 32 + PE_IOFF));
        let r: u64 = pt_ty_subm(sc, out, o, unit, t, j + 2, lt, ntp, aio);
        o = (r % 4294967296) as u32;
        j = (r / 4294967296) as u32;
        o = pt_str(out, o, "\"");
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 4);
        o = pt_str(out, o, "}");
        if pt_tis(unit, t, j, ",") {
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `functions` 里的那些实例条目（参考实现把它们**追加在非泛型函数之后**）。
fn pt_fn_insts(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, ix0: u32) -> u32 {
    let n: u32 = load32(sc, PT_N);
    let ix: u32 = ix0;
    let i: u32 = 0;
    while i < n {
        let e: u32 = PT_TAB + i * 32;
        let decl: u32 = load32(sc, e + PE_DECL);
        let lp: u32 = pt_find_ch(unit, t, decl + 1, decl + 400, "(");
        let rp: u32 = pt_match(unit, t, lp, "(", ")");
        let np: u32 = pt_cnt_params(unit, t, lp);
        o = pt_aelm(out, o, 2, ix);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 3, "name");
        o = pt_pool_q(out, o, sc, load32(sc, e + PE_NAME), load32(sc, e + PE_NLEN));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "params");
        o = pt_aopen(out, o, np);
        o = pt_params_sub(out, o, sc, unit, t, lp, np, i);
        o = pt_acls(out, o, 3, np);
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "ret");
        o = pt_str(out, o, "\"");
        let lt: u32 = load32(sc, e + PE_LT);
        let ntp: u32 = load32(sc, e + PE_NTP);
        let aio: ptr = ptr_add(sc, PT_ATAB + load32(sc, e + PE_IOFF));
        let j: u32 = rp + 1;
        if pt_tis(unit, t, j, "-") && pt_tis(unit, t, j + 1, ">") {
            let r: u64 = pt_ty_subm(sc, out, o, unit, t, j + 2, lt, ntp, aio);
            o = (r % 4294967296) as u32;
        } else {
            o = pt_str(out, o, "()");
        }
        o = pt_str(out, o, "\"");
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 2);
        o = pt_str(out, o, "}");
        ix = ix + 1;
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- M7: 泛型**类型**的实例化
//
// 参考实现 `prepare()` 的 M7 那一半 —— 收类型串 → **按串排序** → 批量实例化。三处要点：
//
//   * **收的只是"类型位置"上的串**：形参 / 返回 / 结构体字段 / 枚举载荷 / `let` 注解,
//     也就是 `_collect_types` 走的那五处。多收一个**非泛型**的串不影响产物（建表时跳过它）,
//     但多收一个**泛型实例**会让参考那边没有的实例冒出来 —— 所以照它的五处走, 不全文扫。
//   * **实例名 = 基名 + "_" + 实参用 "_" 连**（`Pair<u32>` → `Pair_u32`）: 就是把键里的
//     `<` 与 `, ` 换成 `_`、去掉收尾的 `>`。
//   * 参考实现有 **8 轮**（实参里再套泛型时一轮只削一层）。这一格**只做一轮**, 并且把
//     "实参不是裸类型名"**指名拒掉** —— 一轮做不干净会**发得出去但是错的**, 那正是这一格
//     最怕的形状。
//
// 顺序：收串（`pt_collect`）→ 建表（`pt_tmap_build`）→ 发射（查表那半在文件靠前处）。


/// 键里基名的长度（`<` 之前那一段）。
fn pt_key_base_len(sc: ptr, ko: u32, kl: u32) -> u32 {
    let i: u32 = 0;
    while i < kl {
        if load8(sc, ko + i) == 60 {
            return i;
        }
        i = i + 1;
    }
    return kl;
}

/// 键里第 `k` 个实参的区间（`(起点 << 32) | 长度`），起点是**键内相对偏移**。
/// 只认 `, ` 作分隔 —— 嵌套实参在 `pt_tmap_build` 就被拒了，走不到这里。
fn pt_key_arg(sc: ptr, ko: u32, kl: u32, k: u32) -> u64 {
    let s: u32 = pt_key_base_len(sc, ko, kl) + 1;
    let e: u32 = kl - 1;
    let cur: u32 = 0;
    let a: u32 = s;
    let i: u32 = s;
    while i < e {
        if load8(sc, ko + i) == 44 {
            if cur == k {
                return (a as u64) * 4294967296 + ((i - a) as u64);
            }
            cur = cur + 1;
            a = i + 2;
        }
        i = i + 1;
    }
    if cur == k {
        return (a as u64) * 4294967296 + ((e - a) as u64);
    }
    return 0;
}

/// 每个实参是不是**裸类型名**（字母/数字/下划线，外加分隔用的 `,` 与空格）。
/// 不是就返回 0 —— 调用方据此**指名拒绝**（嵌套泛型 = 参考实现那 8 轮才能削干净的东西）。
fn pt_key_args_simple(sc: ptr, ko: u32, kl: u32) -> u32 {
    let s: u32 = pt_key_base_len(sc, ko, kl) + 1;
    let e: u32 = kl - 1;
    let i: u32 = s;
    while i < e {
        let c: u32 = load8(sc, ko + i) as u32;
        let ok: u32 = 0;
        if c >= 48 && c <= 57 {
            ok = 1;
        }
        if c >= 65 && c <= 90 {
            ok = 1;
        }
        if c >= 97 && c <= 122 {
            ok = 1;
        }
        if c == 95 || c == 32 || c == 44 {
            ok = 1;
        }
        // **嵌套**（`Outer<Inner<u32>>`）2026-09-23 起收：`pt_tname` 按深度给分隔，
        // 而实参如果是泛型实例，写出去之前会**查表改名**（见 `pt_inst_tk` 那处）。
        // 别的形状（`[u8; 4]` / `[T]` / `*mut T` 那类）仍然由下面那几个字符挡住。
        if c == 60 || c == 62 {
            ok = 1;
        }
        if ok == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 找一个**声明过形参**的同名类型（`struct` / `enum`），返回 `(类号 << 32) | 声明 token`。
/// 类号: 1 = struct, 2 = enum。没找到返回 0。
fn pt_find_gtype(sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32, ko: u32, bt: u32) -> u64 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && k == 0 {
            let kind: u32 = 0;
            if pt_tis(unit, t, i, "struct") {
                kind = 1;
            }
            if pt_tis(unit, t, i, "enum") {
                kind = 2;
            }
            if kind != 0 && pt_kind(t, i + 1) == 0 && pt_tis(unit, t, i + 2, "<")
                    && pt_tlen(t, i + 1) == bt
                    && pt_pool_eq(unit, pt_off(t, i + 1), bt, sc, ko, bt) == 1 {
                return (kind as u64) * 4294967296 + (i as u64);
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 给池子里第 `i` 条键配实例名：`<` 与 `, ` 换成 `_`、去掉收尾的 `>`。名字写在该条记录的
/// 尾巴上（`[键长][键…][名长][名…]`）。返回名字长度。
fn pt_tname(sc: ptr, i: u32) -> u32 {
    let kl: u32 = pt_tkeylen(sc, i);
    let ko: u32 = pt_tkey(sc, i);
    // ⚠ 名字槽 = `4 + 键长`（条目是 `[键长 4][键…][名长 4][名…]`）。少了那个 `+ 4`，
    // 名字长度会正好落在**键的最后 4 个字节**上 —— 症状是键看着长度对、尾巴变成一小段
    // 二进制（`Result<u32, ` 后面跟 4 个字节），而那个数正好是**实例名的长度**。
    let no: u32 = PT_TPOOL + i * PT_TSTRIDE + 4 + kl;
    let p: u32 = 0;
    let j: u32 = 0;
    let d: u32 = 0;                   // 嵌套深度：`<` 进一层、`>` 出一层
    while j < kl {
        let c: u32 = load8(sc, ko + j) as u32;
        // 分隔是 **d 个下划线**（d = 进这一层之后的深度）—— 这就是 `docs/147` 那条命名规则：
        //   Box<u32>            -> Box_u32            （d=1）
        //   Outer<Inner<u32>>   -> Outer_Inner__u32   （里层 d=2）
        //   Outer<Inner, u32>   -> Outer_Inner_u32    （两个实参，**不与上面撞名**）
        // 旧写法是"`<` 与 `,` 一律换成一个 `_`"，对嵌套会拼出 `Outer_Inner_u32>` ——
        // 那个 `>` 让名字不是标识符（参考实现也栽在同一处，见 `docs/147` §实例命名）。
        if c == 60 {
            d = d + 1;
            let k: u32 = 0;
            while k < d {
                store8(sc, no + 4 + p, 95 as u8);
                p = p + 1;
                k = k + 1;
            }
        } else if c == 62 {
            if d > 0 {
                d = d - 1;
            }
        } else if c == 44 {
            let k: u32 = 0;
            while k < d {
                store8(sc, no + 4 + p, 95 as u8);
                p = p + 1;
                k = k + 1;
            }
        } else if c == 32 {
            // 空格丢掉（参考实现那边是 `", ".join`，分隔由自己拼，与空格无关）
        } else {
            store8(sc, no + 4 + p, c as u8);
            p = p + 1;
        }
        j = j + 1;
    }
    store32(sc, no, p);
    return p;
}

/// 建映射表。返回 1 = **有一处做不干净**（实参不是裸类型名 —— 指名拒绝那一档）。
fn pt_tmap_build(sc: ptr, unit: ptr, t: ptr, ntu: u32) -> u32 {
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 0;
    while i < n {
        let kl: u32 = pt_tkeylen(sc, i);
        let ko: u32 = pt_tkey(sc, i);
        if load8(sc, ko + kl - 1) == 62 {
            let bt: u32 = pt_key_base_len(sc, ko, kl);
            if bt < kl - 1 {
                let g: u64 = pt_find_gtype(sc, unit, t, 0, ntu, ko, bt);
                if g != 0 {
                    if pt_key_args_simple(sc, ko, kl) == 0 {
                        return 1;
                    }
                    // 名字**字节**从 `8 + 键长` 起（条目 `[键长 4][键…][名长 4][名…]`）
                    let e: u32 = PT_TMAP + i * 8;
                    store32(sc, e, PT_TPOOL + i * PT_TSTRIDE + 8 + kl);
                    store32(sc, e + 4, pt_tname(sc, i));
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `a` 的键在**字节序**上大于 `b` 的键吗 —— 参考实现是 `sorted(refs)`，字典序。
fn pt_key_gt(sc: ptr, a: u32, b: u32) -> u32 {
    let la: u32 = pt_tkeylen(sc, a);
    let lb: u32 = pt_tkeylen(sc, b);
    let ka: u32 = pt_tkey(sc, a);
    let kb: u32 = pt_tkey(sc, b);
    let m: u32 = la;
    if lb < la {
        m = lb;
    }
    let i: u32 = 0;
    while i < m {
        let ca: u32 = load8(sc, ka + i) as u32;
        let cb: u32 = load8(sc, kb + i) as u32;
        if ca > cb {
            return 1;
        }
        if ca < cb {
            return 0;
        }
        i = i + 1;
    }
    if la > lb {
        return 1;
    }
    return 0;
}

/// 池子里两条**整条**对调。排序发生在写名字**之前**，所以整条挪不会碰到名字的偏移。
fn pt_swap(sc: ptr, a: u32, b: u32) {
    let ea: u32 = PT_TPOOL + a * PT_TSTRIDE;
    let eb: u32 = PT_TPOOL + b * PT_TSTRIDE;
    let i: u32 = 0;
    while i < PT_TSTRIDE {
        let t: u32 = load8(sc, ea + i) as u32;
        store8(sc, ea + i, load8(sc, eb + i) as u8);
        store8(sc, eb + i, t as u8);
        i = i + 1;
    }
}

/// 池子按字节序**插入排序**（n ≤ 128，够了）。参考实现用 `sorted(refs)` 定实例的创建顺序，
/// 而 `types` / `enums` 里实例的先后**就是**创建顺序 —— 不排就会在"同类两个实例"时分叉。
fn pt_sort_pool(sc: ptr) {
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 1;
    while i < n {
        let j: u32 = i;
        while j > 0 && pt_key_gt(sc, j - 1, j) == 1 {
            pt_swap(sc, j - 1, j);
            j = j - 1;
        }
        i = i + 1;
    }
}

/// 把 `sc + PT_TBUF` 里渲染好的那一段收进池子（去重）。1 = 收下（含"已经有了"），0 = 池子满。
fn pt_tref_add(sc: ptr, off: u32, len: u32) -> u32 {
    if len == 0 || len + 8 >= PT_TSTRIDE {
        return 0;
    }
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 0;
    while i < n {
        if pt_tkeylen(sc, i) == len && pt_pool_eq(sc, pt_tkey(sc, i), len, sc, off, len) == 1 {
            return 1;
        }
        i = i + 1;
    }
    if n >= PT_TMAX {
        return 0;
    }
    let e: u32 = PT_TPOOL + n * PT_TSTRIDE;
    store32(sc, e, len);
    let k: u32 = 0;
    while k < len {
        store8(sc, e + 4 + k, load8(sc, off + k) as u8);
        k = k + 1;
    }
    store32(sc, PT_TN, n + 1);
    return 1;
}

/// 收一个类型：从 token `ts` 起渲染进临时缓冲并收进池子。返回下一个 token，0 = 收不下。
fn pt_collect_at(sc: ptr, unit: ptr, t: ptr, ts: u32) -> u32 {
    let r: u64 = pt_ty(ptr_add(sc, PT_TBUF), 0, unit, t, ts);
    let len: u32 = (r % 4294967296) as u32;
    if pt_tref_add(sc, PT_TBUF, len) == 0 {
        return 0;
    }
    return (r / 4294967296) as u32;
}

/// `名字 : 类型` 那一串（fn 形参 / 结构体字段）—— 从 `lp + 1` 扫到 `close`。
fn pt_collect_pairs(sc: ptr, unit: ptr, t: ptr, lp: u32, close: str) -> u32 {
    let j: u32 = lp + 1;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, close) {
        if pt_kind(t, j) == 0 && pt_tis(unit, t, j + 1, ":") {
            let nx: u32 = pt_collect_at(sc, unit, t, j + 2);
            if nx == 0 {
                return 0;
            }
            j = nx;
        } else {
            j = j + 1;
        }
    }
    return 1;
}

/// 枚举变体的载荷 `Name(T)`。
fn pt_collect_vars(sc: ptr, unit: ptr, t: ptr, brc: u32) -> u32 {
    let j: u32 = brc + 1;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if pt_kind(t, j) == 0 && pt_tis(unit, t, j + 1, "(") {
            let nx: u32 = pt_collect_at(sc, unit, t, j + 2);
            if nx == 0 {
                return 0;
            }
            j = nx;
        } else {
            j = j + 1;
        }
    }
    return 1;
}

/// 函数体里所有 `let` 的类型。`_collect_types` 会递归走 if/while/for/match 的每一层，
/// 这里**整个体一起扫**等价：`let` 这个词只出现在声明处。
fn pt_collect_body(sc: ptr, unit: ptr, t: ptr, brc: u32, be: u32) -> u32 {
    let j: u32 = brc + 1;
    while j < be && pt_kind(t, j) != 4 {
        if pt_kind(t, j) == 0 && pt_tis(unit, t, j, "let")
                && pt_kind(t, j + 1) == 0 && pt_tis(unit, t, j + 2, ":") {
            let nx: u32 = pt_collect_at(sc, unit, t, j + 3);
            if nx == 0 {
                return 0;
            }
            j = nx;
        } else {
            j = j + 1;
        }
    }
    return 1;
}

/// 一个 `fn`（`i` 是 `fn` 那一位）：形参 + 返回 + 体里的 `let`。没有体（`extern fn`）就到此为止。
fn pt_collect_fn(sc: ptr, unit: ptr, t: ptr, i: u32) -> u32 {
    let lp: u32 = pt_find_ch(unit, t, i + 1, i + 400, "(");
    if lp == PT_NONE {
        return 1;
    }
    let rp: u32 = pt_match(unit, t, lp, "(", ")");
    if pt_collect_pairs(sc, unit, t, lp, ")") == 0 {
        return 0;
    }
    if pt_tis(unit, t, rp + 1, "->") {
        if pt_collect_at(sc, unit, t, rp + 2) == 0 {
            return 0;
        }
    }
    // 体：先看 `{` 与 `;` 谁先 —— `extern fn f(...) -> u32;` 后面那一格 `{` 是**下一个**条目的
    let brc: u32 = pt_find_ch(unit, t, rp, i + 400, "{");
    let sem: u32 = pt_find_ch(unit, t, rp, i + 400, ";");
    if brc == PT_NONE || sem < brc {
        return 1;
    }
    return pt_collect_body(sc, unit, t, brc, pt_match(unit, t, brc, "{", "}"));
}

/// `impl` 块里的方法（声明在块里，深度 1）。
fn pt_collect_impl(sc: ptr, unit: ptr, t: ptr, i: u32) -> u32 {
    let brc: u32 = pt_find_ch(unit, t, i + 1, i + 400, "{");
    if brc == PT_NONE {
        return 1;
    }
    let be: u32 = pt_match(unit, t, brc, "{", "}");
    let j: u32 = brc + 1;
    while j < be && pt_kind(t, j) != 4 {
        if pt_tis(unit, t, j, "fn") && pt_kind(t, j + 1) == 0 {
            if pt_collect_fn(sc, unit, t, j) == 0 {
                return 0;
            }
        }
        j = j + 1;
    }
    return 1;
}

/// 把整个单元（依赖在前、根与预置块在后）里**每一个类型位置**的串收进池子。
fn pt_collect(sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let d: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        let k: u32 = pt_kind(t, i);
        if k == 3 {
            let c: u32 = load8(unit, pt_off(t, i)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && k == 0 {
            if pt_tis(unit, t, i, "fn") {
                if pt_collect_fn(sc, unit, t, i) == 0 {
                    return 0;
                }
            } else if pt_tis(unit, t, i, "struct") {
                let brc: u32 = pt_find_ch(unit, t, i + 1, i + 400, "{");
                if brc != PT_NONE && pt_collect_pairs(sc, unit, t, brc, "}") == 0 {
                    return 0;
                }
            } else if pt_tis(unit, t, i, "enum") {
                let brc: u32 = pt_find_ch(unit, t, i + 1, i + 400, "{");
                if brc != PT_NONE && pt_collect_vars(sc, unit, t, brc) == 0 {
                    return 0;
                }
            } else if pt_tis(unit, t, i, "impl") {
                if pt_collect_impl(sc, unit, t, i) == 0 {
                    return 0;
                }
            } else if pt_tis(unit, t, i, "extern") && pt_tis(unit, t, i + 1, "fn") {
                if pt_collect_fn(sc, unit, t, i + 1) == 0 {
                    return 0;
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

/// `pt_ty` 的**换形参版**：名字位置上如果是类型形参，就写池子里那个实参串
/// （不是 token 区间 —— 实参是从**键串**里取的）。
fn pt_ty_arg(sc: ptr, out: ptr, o: u32, unit: ptr, t: ptr, i: u32,
             lt: u32, ntp: u32, refi: u32) -> u64 {
    let j: u32 = i;
    let ko: u32 = pt_tkey(sc, refi);
    let kl: u32 = pt_tkeylen(sc, refi);
    if pt_kind(t, j) == 0 && !pt_tis(unit, t, j, "mut") {
        let k: u32 = 0;
        while k < ntp {
            if pt_same(unit, t, j, lt + 1 + k * 2) == 1 {
                let aa: u64 = pt_key_arg(sc, ko, kl, k);
                let ao: u32 = (aa / 4294967296) as u32;
                let al: u32 = (aa % 4294967296) as u32;
                let q: u32 = 0;
                while q < al {
                    store8(out, o + q, load8(sc, ko + ao + q) as u8);
                    q = q + 1;
                }
                return ((j + 1) as u64) * 4294967296 + ((o + al) as u64);
            }
            k = k + 1;
        }
    }
    if pt_tis(unit, t, j, "mut") && pt_tis(unit, t, j + 1, "[") {
        o = pt_str(out, o, "mut [");
        let r1: u64 = pt_ty_arg(sc, out, o, unit, t, j + 2, lt, ntp, refi);
        o = (r1 % 4294967296) as u32;
        j = (r1 / 4294967296) as u32;
        o = pt_str(out, o, "]");
        return ((j + 1) as u64) * 4294967296 + (o as u64);
    }
    if pt_tis(unit, t, j, "[") {
        o = pt_str(out, o, "[");
        let r2: u64 = pt_ty_arg(sc, out, o, unit, t, j + 1, lt, ntp, refi);
        o = (r2 % 4294967296) as u32;
        j = (r2 / 4294967296) as u32;
        if pt_tis(unit, t, j, ";") {
            o = pt_str(out, o, "; ");
            o = pt_num(out, o, unit, t, j + 1);
            j = j + 2;
        }
        o = pt_str(out, o, "]");
        return ((j + 1) as u64) * 4294967296 + (o as u64);
    }
    o = pt_mem(out, o, unit, pt_off(t, j), pt_tlen(t, j));
    j = j + 1;
    if pt_tis(unit, t, j, "<") {
        o = pt_str(out, o, "<");
        j = j + 1;
        while !pt_tis(unit, t, j, ">") && pt_kind(t, j) != 4 {
            let r3: u64 = pt_ty_arg(sc, out, o, unit, t, j, lt, ntp, refi);
            o = (r3 % 4294967296) as u32;
            j = (r3 / 4294967296) as u32;
            if pt_tis(unit, t, j, ",") {
                o = pt_str(out, o, ", ");
                j = j + 1;
            }
        }
        j = j + 1;
        o = pt_str(out, o, ">");
    }
    return (j as u64) * 4294967296 + (o as u64);
}

/// 实例化出来的结构体字段（`pt_fields` 的换形参版：形参换成实参、整段再查一次映射表）。
fn pt_fields_arg(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, brc: u32, n: u32,
                 lt: u32, ntp: u32, refi: u32) -> u32 {
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            o = pt_aelm(out, o, 4, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 5, "name");
            o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 5, "type");
            o = pt_str(out, o, "\"");
            let a: u32 = o;
            let r: u64 = pt_ty_arg(sc, out, o, unit, t, j + 2, lt, ntp, refi);
            let e: u32 = pt_map_slice(sc, out, a, (r % 4294967296) as u32);
            o = pt_str(out, e, "\"");
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 4);
            o = pt_str(out, o, "}");
            ix = ix + 1;
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    // 数组的收尾 `]` 由调用方的 `pt_acls` 写 —— `pt_fields` 自己**不写**收尾（对齐那一版）
    return o;
}

/// 实例化出来的枚举载荷（`pt_payloads` 的换形参版）。
fn pt_payloads_arg(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, brc: u32, n: u32,
                   lt: u32, ntp: u32, refi: u32) -> u32 {
    o = pt_str(out, o, "{
");
    let j: u32 = brc + 1;
    let at_name: u32 = 1;
    let d: u32 = 0;
    let ix: u32 = 0;
    while pt_kind(t, j) != 4 && !pt_tis(unit, t, j, "}") {
        if at_name == 1 && pt_kind(t, j) == 0 {
            if pt_tis(unit, t, j + 1, "(") {
                o = pt_aelm(out, o, 4, ix);
                o = pt_q(out, o, unit, pt_off(t, j), pt_tlen(t, j));
                o = pt_str(out, o, ": ");
                o = pt_str(out, o, "\"");
                let a: u32 = o;
                let r: u64 = pt_ty_arg(sc, out, o, unit, t, j + 2, lt, ntp, refi);
                let e: u32 = pt_map_slice(sc, out, a, (r % 4294967296) as u32);
                o = pt_str(out, e, "\"");
                ix = ix + 1;
            }
            at_name = 0;
        }
        if pt_tis(unit, t, j, "<") || pt_tis(unit, t, j, "[") || pt_tis(unit, t, j, "(") {
            d = d + 1;
        }
        if (pt_tis(unit, t, j, ">") || pt_tis(unit, t, j, "]")
                || pt_tis(unit, t, j, ")")) && d > 0 {
            d = d - 1;
        }
        if d == 0 && (pt_tis(unit, t, j, ",") || pt_tis(unit, t, j, ";")) {
            at_name = 1;
        }
        j = j + 1;
    }
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, 3);
    return pt_str(out, o, "}");
}

/// 某一类（1 = struct, 2 = enum）的实例条数 —— 计数必须在发射前知道。
fn pt_cnt_inst(sc: ptr, unit: ptr, t: ptr, ntu: u32, kind: u32) -> u32 {
    let n: u32 = load32(sc, PT_TN);
    let c: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let kl: u32 = pt_tkeylen(sc, i);
        let ko: u32 = pt_tkey(sc, i);
        if load8(sc, ko + kl - 1) == 62 {
            let bt: u32 = pt_key_base_len(sc, ko, kl);
            if bt < kl - 1 {
                let g: u64 = pt_find_gtype(sc, unit, t, 0, ntu, ko, bt);
                if g != 0 && (g / 4294967296) as u32 == kind {
                    c = c + 1;
                }
            }
        }
        i = i + 1;
    }
    return c;
}

/// 实例化出来的结构体（接在 `types` 里那些声明之后）。`ix0` 是接着的序号。
fn pt_inst_types(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, ntu: u32, ix0: u32) -> u32 {
    let ix: u32 = ix0;
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 0;
    while i < n {
        let kl: u32 = pt_tkeylen(sc, i);
        let ko: u32 = pt_tkey(sc, i);
        let g: u64 = 0;
        if load8(sc, ko + kl - 1) == 62 {
            let bt: u32 = pt_key_base_len(sc, ko, kl);
            if bt < kl - 1 {
                g = pt_find_gtype(sc, unit, t, 0, ntu, ko, bt);
            }
        }
        if g != 0 && (g / 4294967296) as u32 == 1 {
            let decl: u32 = (g % 4294967296) as u32;
            let lt: u32 = decl + 2;
            let gt: u32 = pt_match(unit, t, lt, "<", ">");
            let ntp: u32 = pt_cnt_tps(unit, t, lt, gt);
            let brc: u32 = pt_find_ch(unit, t, gt + 1, decl + 400, "{");
            let nf: u32 = pt_cnt_names(unit, t, brc);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_pool_q(out, o, sc, load32(sc, PT_TMAP + i * 8),
                          load32(sc, PT_TMAP + i * 8 + 4));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "fields");
            o = pt_aopen(out, o, nf);
            o = pt_fields_arg(out, o, sc, unit, t, brc, nf, lt, ntp, i);
            o = pt_acls(out, o, 3, nf);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 实例化出来的枚举（接在 `enums` 里那些声明之后）。
fn pt_inst_enums(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, ntu: u32, ix0: u32) -> u32 {
    let ix: u32 = ix0;
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 0;
    while i < n {
        let kl: u32 = pt_tkeylen(sc, i);
        let ko: u32 = pt_tkey(sc, i);
        let g: u64 = 0;
        if load8(sc, ko + kl - 1) == 62 {
            let bt: u32 = pt_key_base_len(sc, ko, kl);
            if bt < kl - 1 {
                g = pt_find_gtype(sc, unit, t, 0, ntu, ko, bt);
            }
        }
        if g != 0 && (g / 4294967296) as u32 == 2 {
            let decl: u32 = (g % 4294967296) as u32;
            let lt: u32 = decl + 2;
            let gt: u32 = pt_match(unit, t, lt, "<", ">");
            let ntp: u32 = pt_cnt_tps(unit, t, lt, gt);
            let brc: u32 = pt_find_ch(unit, t, gt + 1, decl + 400, "{");
            let nv: u32 = pt_cnt_names(unit, t, brc);
            let np: u32 = pt_cnt_pay(unit, t, brc);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "name");
            o = pt_pool_q(out, o, sc, load32(sc, PT_TMAP + i * 8),
                          load32(sc, PT_TMAP + i * 8 + 4));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "variants");
            o = pt_aopen(out, o, nv);
            o = pt_variants(out, o, unit, t, brc, nv);
            o = pt_acls(out, o, 3, nv);
            if np > 0 {
                o = pt_str(out, o, ",\n");
                o = pt_key(out, o, 3, "payloads");
                o = pt_payloads_arg(out, o, sc, unit, t, brc, np, lt, ntp, i);
            }
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// 键里的实参个数（顶层 `,` 个数 + 1）。
fn pt_cnt_gargs(sc: ptr, ko: u32, kl: u32) -> u32 {
    let s: u32 = pt_key_base_len(sc, ko, kl) + 1;
    let e: u32 = kl - 1;
    let n: u32 = 1;
    let i: u32 = s;
    while i < e {
        if load8(sc, ko + i) == 44 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// `instances` 里 `kind: "type"` 那一块。`kind` 是类号（1 = struct, 2 = enum）——
/// 参考实现是"先 a 后 b"两块：结构体的实例在前、枚举的在后（它按 `mod.structs` 与
/// `mod.enums` 两张表分别走一遍）。
fn pt_inst_tk(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, ntu: u32,
              kind: u32, ix0: u32) -> u32 {
    let ix: u32 = ix0;
    let n: u32 = load32(sc, PT_TN);
    let i: u32 = 0;
    while i < n {
        let kl: u32 = pt_tkeylen(sc, i);
        let ko: u32 = pt_tkey(sc, i);
        let g: u64 = 0;
        if load8(sc, ko + kl - 1) == 62 {
            let bt: u32 = pt_key_base_len(sc, ko, kl);
            if bt < kl - 1 {
                g = pt_find_gtype(sc, unit, t, 0, ntu, ko, bt);
            }
        }
        if g != 0 && (g / 4294967296) as u32 == kind {
            let decl: u32 = (g % 4294967296) as u32;
            let narg: u32 = pt_cnt_gargs(sc, ko, kl);
            o = pt_aelm(out, o, 2, ix);
            o = pt_str(out, o, "{\n");
            o = pt_key(out, o, 3, "kind");
            o = pt_qs(out, o, "type");
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "name");
            o = pt_pool_q(out, o, sc, load32(sc, PT_TMAP + i * 8),
                          load32(sc, PT_TMAP + i * 8 + 4));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "of");
            o = pt_q(out, o, unit, pt_off(t, decl + 1), pt_tlen(t, decl + 1));
            o = pt_str(out, o, ",\n");
            o = pt_key(out, o, 3, "args");
            o = pt_aopen(out, o, narg);
            let a: u32 = 0;
            while a < narg {
                let aa: u64 = pt_key_arg(sc, ko, kl, a);
                let ao: u32 = (aa / 4294967296) as u32;
                let al: u32 = (aa % 4294967296) as u32;
                o = pt_aelm(out, o, 4, a);
                o = pt_str(out, o, "\"");
                let ast: u32 = o;                 // 实参文本的起点（查表要用）
                let q: u32 = 0;
                while q < al {
                    store8(out, o, load8(sc, ko + ao + q) as u8);
                    o = o + 1;
                    q = q + 1;
                }
                // 实参本身若是**泛型实例**（`Inner<u32>`），要写成它的**实例名**
                // （`Inner_u32`）—— 形式对象要求 `instances[].args` 是合法类型串。
                // 非泛型的实参（`u32`）查不到名字，原样留着（`pt_map_slice` 只认配了名字的条目）。
                o = pt_map_slice(sc, out, ast, o);
                o = pt_str(out, o, "\"");
                a = a + 1;
            }
            o = pt_acls(out, o, 3, narg);
            o = pt_str(out, o, "\n");
            o = pt_ind(out, o, 2);
            o = pt_str(out, o, "}");
            ix = ix + 1;
        }
        i = i + 1;
    }
    return o;
}

/// `instances` 那一格里 `kind: "fn"` 那一块（类型实例那一块接在它后面）。
fn pt_instances(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, n: u32, ntu: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        let e: u32 = PT_TAB + i * 32;
        let decl: u32 = load32(sc, e + PE_DECL);
        let narg: u32 = load32(sc, e + PE_NARG);
        let aio: ptr = ptr_add(sc, PT_ATAB + load32(sc, e + PE_IOFF));
        o = pt_aelm(out, o, 2, i);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 3, "kind");
        o = pt_qs(out, o, "fn");
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "name");
        o = pt_pool_q(out, o, sc, load32(sc, e + PE_NAME), load32(sc, e + PE_NLEN));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "of");
        o = pt_q(out, o, unit, pt_off(t, decl), pt_tlen(t, decl));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 3, "args");
        o = pt_aopen(out, o, narg);
        let a: u32 = 0;
        while a < narg {
            o = pt_aelm(out, o, 4, a);
            o = pt_str(out, o, "\"");
            let r: u64 = pt_ty(out, o, unit, t, load32(aio, a * 8));
            o = (r % 4294967296) as u32;
            o = pt_str(out, o, "\"");
            a = a + 1;
        }
        o = pt_acls(out, o, 3, narg);
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 2);
        o = pt_str(out, o, "}");
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- M-L0: `layouts`（L0 布局）
//
// 参考实现的 `layouts` 来自 `mod.uses`：根单元每一条**路径形式**的 `use`，如果那个文件存在，
// 就用 `lomc.load` 读成 L0 模块，把它的 `record` 逐条列出来（字段**按偏移排**）。
//
// ⚠ 这里**没有 token 可扫**：驱动器明确不把 `.lom` 拼进单元（见文件头上那一条，理由是
// "否则会把 fujr.lom 也拼进单元，demo.lomt 上多出整整一个模块"）。所以这一节要
// **自己读文件**、**自己按字节解析** L0 的 `record` 那一支。
//
// 只借三个 syscall（openat / read / close），**不复用 `lomsyscalls`** —— 它和驱动器同名
// （两边都有 `open_ro` / `read_all`），拼进同一个单元会撞。
//
// L0 的 record 语法极小（`tools/lomc.py::parse_record` 是权威）：
//
//     record NAME layout(<packed?> size=N endian=little|big) { f : u32 @0 ... }
//
// 选项顺序任意、逗号与分号可省；字段类型是**单个标识符**；`@` 偏移必须有；`size=` 必须有。

/// `openat(AT_FDCWD, path, O_RDONLY)`。失败 -1。
fn pt_l0_open(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 0);
}

/// 把 `path` 读进 `buf`（最多 `cap` 字节）。**打不开返回 0**（参考实现在那条上 `continue`）；
/// **超过 `cap` 返回 `cap + 1`** —— 截断的 L0 会静静地少掉几条 record，所以宁可让调用方拒。
fn pt_l0_slurp(path: ptr, buf: ptr, cap: u32) -> u32 {
    let fd: i64 = pt_l0_open(path);
    if fd < 0 {
        return 0;
    }
    let n: u32 = 0;
    let go: u32 = 1;
    while go == 1 && n < cap {
        let r: i64 = syscall4(0, fd as u64, (buf as u64) + (n as u64), (cap - n) as u64);
        if r > 0 {
            n = n + (r as u32);
        } else {
            go = 0;
        }
    }
    let _c: i64 = syscall4(3, fd as u64, 0, 0);
    if n >= cap {
        return cap + 1;
    }
    return n;
}

/// 跳过空白、`//` 注释、`"…"` 字符串，返回下一个有意义的字节位置。
/// **字符串也要跳**：L0 里真出现过带引号的常量，而 `record` 这个词一旦落在里面就会被误数。
fn pt_l0_skip(buf: ptr, n: u32, i: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while go == 1 && j < n {
        let c: u32 = load8(buf, j) as u32;
        if c == 32 || c == 9 || c == 10 || c == 13 {
            j = j + 1;
        } else if c == 47 && j + 1 < n && (load8(buf, j + 1) as u32) == 47 {
            let k: u32 = j;
            while k < n && (load8(buf, k) as u32) != 10 {
                k = k + 1;
            }
            j = k;
        } else if c == 34 {
            let k: u32 = j + 1;
            while k < n && (load8(buf, k) as u32) != 34 {
                k = k + 1;
            }
            j = k + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

fn pt_l0_nx(r: u64) -> u32 {
    return (r / 4294967296) as u32;
}

fn pt_l0_off(r: u64) -> u32 {
    return ((r % 4294967296) / 256) as u32;
}

fn pt_l0_len(r: u64) -> u32 {
    return (r % 256) as u32;
}

/// 读一个词（`[A-Za-z0-9_]`），返回 `(下一个位置 << 32) | (起点 << 8) | 长度`。
fn pt_l0_word(buf: ptr, n: u32, i: u32) -> u64 {
    let j: u32 = pt_l0_skip(buf, n, i);
    let s: u32 = j;
    let go: u32 = 1;
    while go == 1 && j < n {
        let c: u32 = load8(buf, j) as u32;
        let ok: u32 = 0;
        if c >= 48 && c <= 57 {
            ok = 1;
        }
        if c >= 65 && c <= 90 {
            ok = 1;
        }
        if c >= 97 && c <= 122 {
            ok = 1;
        }
        if c == 95 {
            ok = 1;
        }
        if ok == 0 {
            go = 0;
        } else {
            j = j + 1;
        }
    }
    // ⚠ **不是词就前进一格**（返回长度 0）—— 否则遇到 `:` / `=` 这种标点, 整个扫描就卡死在
    // 那里。实测症状：`const MAGIC : u32 = …` 的第一个 `:` 让 `record` **一条都扫不到**，
    // 发出去是空 `layouts`（而这个“空”看起来完全正常）。
    if j == s {
        return ((j + 1) as u64) * 4294967296;
    }
    return (j as u64) * 4294967296 + ((s as u64) * 256 + ((j - s) as u64));
}

/// `buf[off..off+len]` 是不是字符串 `s`。
fn pt_l0_is(buf: ptr, off: u32, len: u32, s: str) -> u32 {
    if len != str_len(s) {
        return 0;
    }
    let k: u32 = 0;
    while k < len {
        if (load8(buf, off + k) as u32) != (str_byte(s, k) as u32) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// 读一个整数（`0x` 开头按十六进制 —— 参考实现的 `int_lit` 两种都收）。
/// 返回 `(下一个位置 << 32) | 值`。
fn pt_l0_int(buf: ptr, n: u32, i: u32) -> u64 {
    let r: u64 = pt_l0_word(buf, n, i);
    let s: u32 = pt_l0_off(r);
    let l: u32 = pt_l0_len(r);
    let hex: u32 = 0;
    let k: u32 = 0;
    if l > 2 && (load8(buf, s) as u32) == 48
            && ((load8(buf, s + 1) as u32) == 120 || (load8(buf, s + 1) as u32) == 88) {
        hex = 1;
        k = 2;
    }
    let v: u32 = 0;
    while k < l {
        let c: u32 = load8(buf, s + k) as u32;
        let d: u32 = 0;
        if c >= 48 && c <= 57 {
            d = c - 48;
        }
        if hex == 1 && c >= 97 && c <= 102 {
            d = c - 87;
        }
        if hex == 1 && c >= 65 && c <= 70 {
            d = c - 55;
        }
        if hex == 1 {
            v = v * 16 + d;
        } else {
            v = v * 10 + d;
        }
        k = k + 1;
    }
    return (pt_l0_nx(r) as u64) * 4294967296 + (v as u64);
}

/// 跳到 `}` 之后（解析出错时的兜底：一条坏 record 不要拖垮整份文件的解析）。
fn pt_l0_brace(buf: ptr, n: u32, i: u32) -> u32 {
    let j: u32 = i;
    while j < n && (load8(buf, j) as u32) != 125 {
        j = j + 1;
    }
    return j + 1;
}

/// 在 `buf[n]` 里数 `record` 的条数（**顶层词扫**，字符串/注释已跳过）。
fn pt_l0_cnt(buf: ptr, n: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let r: u64 = pt_l0_word(buf, n, i);
        let nx: u32 = pt_l0_nx(r);
        if nx <= i {
            i = n;
        } else {
            if pt_l0_is(buf, pt_l0_off(r), pt_l0_len(r), "record") == 1 {
                c = c + 1;
            }
            i = nx;
        }
    }
    return c;
}

/// 解析一条 record（`i` 指向 `record` 那个词），填进 `PT_RMETA` 与 `PT_FTAB`。
/// 返回 `(下一个位置 << 32) | 状态`：1 = 好，0 = 这一条解析失败（调用方**点名拒**）。
fn pt_l0_rec(sc: ptr, buf: ptr, n: u32, i: u32) -> u64 {
    let rm: u32 = PT_RMETA;
    let r1: u64 = pt_l0_word(buf, n, i);
    let r2: u64 = pt_l0_word(buf, n, pt_l0_nx(r1));
    store32(sc, rm + 0, pt_l0_off(r2));
    store32(sc, rm + 4, pt_l0_len(r2));
    let r3: u64 = pt_l0_word(buf, n, pt_l0_nx(r2));
    if pt_l0_is(buf, pt_l0_off(r3), pt_l0_len(r3), "layout") == 0 {
        return (pt_l0_brace(buf, n, pt_l0_nx(r3)) as u64) * 4294967296;
    }
    let packed: u32 = 0;
    let size: u32 = 0;
    let big: u32 = 0;
    let jj0: u32 = pt_l0_skip(buf, n, pt_l0_nx(r3)) + 1;
    let jj: u32 = jj0;
    let go: u32 = 1;
    while go == 1 {
        let z: u32 = pt_l0_skip(buf, n, jj);
        if z >= n {
            go = 0;
            jj = n;
        } else if (load8(buf, z) as u32) == 41 {
            go = 0;
            jj = z + 1;
        } else if (load8(buf, z) as u32) == 44 {
            jj = z + 1;
        } else {
            let rk: u64 = pt_l0_word(buf, n, z);
            let koff: u32 = pt_l0_off(rk);
            let klen: u32 = pt_l0_len(rk);
            if pt_l0_is(buf, koff, klen, "packed") == 1 {
                packed = 1;
                jj = pt_l0_nx(rk);
            } else if pt_l0_is(buf, koff, klen, "size") == 1 {
                let rv: u64 = pt_l0_int(buf, n, pt_l0_skip(buf, n, pt_l0_nx(rk)) + 1);
                size = (rv % 4294967296) as u32;
                jj = pt_l0_nx(rv);
            } else if pt_l0_is(buf, koff, klen, "endian") == 1 {
                let rv: u64 = pt_l0_word(buf, n, pt_l0_skip(buf, n, pt_l0_nx(rk)) + 1);
                if pt_l0_is(buf, pt_l0_off(rv), pt_l0_len(rv), "big") == 1 {
                    big = 1;
                }
                jj = pt_l0_nx(rv);
            } else {
                return (pt_l0_brace(buf, n, jj) as u64) * 4294967296;
            }
        }
    }
    store32(sc, rm + 8, size);
    store32(sc, rm + 12, big);
    store32(sc, rm + 16, packed);
    let nf: u32 = 0;
    let kk0: u32 = pt_l0_skip(buf, n, jj) + 1;
    let kk: u32 = kk0;
    let go2: u32 = 1;
    while go2 == 1 {
        let z: u32 = pt_l0_skip(buf, n, kk);
        if z >= n {
            go2 = 0;
            kk = n;
        } else if (load8(buf, z) as u32) == 125 {
            go2 = 0;
            kk = z + 1;
        } else if (load8(buf, z) as u32) == 44 || (load8(buf, z) as u32) == 59 {
            kk = z + 1;
        } else {
            let rn: u64 = pt_l0_word(buf, n, z);
            let rt: u64 = pt_l0_word(buf, n, pt_l0_skip(buf, n, pt_l0_nx(rn)) + 1);
            let ro: u64 = pt_l0_int(buf, n, pt_l0_skip(buf, n, pt_l0_nx(rt)) + 1);
            if nf < PT_FMAX {
                let fe: u32 = PT_FTAB + nf * 20;
                store32(sc, fe + 0, pt_l0_off(rn));
                store32(sc, fe + 4, pt_l0_len(rn));
                store32(sc, fe + 8, pt_l0_off(rt));
                store32(sc, fe + 12, pt_l0_len(rt));
                store32(sc, fe + 16, (ro % 4294967296) as u32);
            }
            nf = nf + 1;
            kk = pt_l0_nx(ro);
        }
    }
    store32(sc, rm + 20, nf);
    if nf == 0 {
        return (kk as u64) * 4294967296;
    }
    return (kk as u64) * 4294967296 + 1;
}

/// 发一条 record 的对象（字段**按偏移插入排序** —— 参考实现是 `sorted(fields, key=offset)`）。
fn pt_l0_emit_one(out: ptr, o: u32, sc: ptr, buf: ptr, ix: u32) -> u32 {
    let rm: u32 = PT_RMETA;
    let nf: u32 = load32(sc, rm + 20);
    let i: u32 = 1;
    while i < nf {
        let j: u32 = i;
        let go: u32 = 1;
        while go == 1 && j > 0 {
            let ea: u32 = PT_FTAB + (j - 1) * 20;
            let eb: u32 = PT_FTAB + j * 20;
            if load32(sc, ea + 16) > load32(sc, eb + 16) {
                let t: u32 = 0;
                while t < 20 {
                    let v: u32 = load8(sc, ea + t) as u32;
                    store8(sc, ea + t, load8(sc, eb + t) as u8);
                    store8(sc, eb + t, v as u8);
                    t = t + 1;
                }
                j = j - 1;
            } else {
                go = 0;
            }
        }
        i = i + 1;
    }
    o = pt_aelm(out, o, 2, ix);
    o = pt_str(out, o, "{\n");
    o = pt_key(out, o, 3, "name");
    o = pt_q(out, o, buf, load32(sc, rm + 0), load32(sc, rm + 4));
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 3, "size");
    o = pt_dec(out, o, load32(sc, rm + 8) as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 3, "endian");
    if load32(sc, rm + 12) == 1 {
        o = pt_qs(out, o, "big");
    } else {
        o = pt_qs(out, o, "little");
    }
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 3, "packed");
    o = pt_bool(out, o, load32(sc, rm + 16));
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 3, "fields");
    o = pt_aopen(out, o, nf);
    let f: u32 = 0;
    while f < nf {
        let fe: u32 = PT_FTAB + f * 20;
        o = pt_aelm(out, o, 4, f);
        o = pt_str(out, o, "{\n");
        o = pt_key(out, o, 5, "name");
        o = pt_q(out, o, buf, load32(sc, fe + 0), load32(sc, fe + 4));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 5, "type");
        o = pt_q(out, o, buf, load32(sc, fe + 8), load32(sc, fe + 12));
        o = pt_str(out, o, ",\n");
        o = pt_key(out, o, 5, "offset");
        o = pt_dec(out, o, load32(sc, fe + 16) as u64);
        o = pt_str(out, o, "\n");
        o = pt_ind(out, o, 4);
        o = pt_str(out, o, "}");
        f = f + 1;
    }
    o = pt_acls(out, o, 3, nf);
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, 2);
    return pt_str(out, o, "}");
}

/// 一条 `use` 的目标路径写进 `PT_L0PATH`（NUL 结尾）。返回路径长度；0 = 太短/不合法。
fn pt_l0_path(sc: ptr, unit: ptr, t: ptr, i: u32) -> u32 {
    let path: ptr = ptr_add(sc, PT_L0PATH);
    let pl: u32 = pt_tlen(t, i + 1);
    if pl <= 2 {
        return 0;
    }
    let po: u32 = pt_off(t, i + 1) + 1;
    let k: u32 = 0;
    while k < pl - 2 {
        store8(path, k, load8(unit, po + k) as u8);
        k = k + 1;
    }
    store8(path, pl - 2, 0 as u8);
    return pl - 2;
}

/// 根单元里**路径形式** `use` 的目标文件里的 `record` 条数（= `layouts` 的条数）。
/// 返回 `PT_NONE` = 有一份 `.lom` 超了缓冲 —— 调用方据此**点名拒**（不静默少几条）。
fn pt_lay_cnt(sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let buf: ptr = ptr_add(sc, PT_L0BUF);
    let n: u32 = 0;
    let bad: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_tis(unit, t, i, "use") && pt_kind(t, i + 1) == 2 {
            if pt_l0_path(sc, unit, t, i) > 0 {
                let got: u32 = pt_l0_slurp(ptr_add(sc, PT_L0PATH), buf, PT_L0CAP);
                if got > PT_L0CAP {
                    bad = 1;
                }
                if got > 0 && got <= PT_L0CAP {
                    n = n + pt_l0_cnt(buf, got);
                }
            }
        }
        i = i + 1;
    }
    if bad == 1 {
        return PT_NONE;
    }
    return n;
}

/// 发射之前先验"每条 record 都解析得动" —— 参考实现读不了会**抛**，这里要**点名拒**，
/// 不能发一份少了几条 `layouts` 的对象出去。
fn pt_lay_check(sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let buf: ptr = ptr_add(sc, PT_L0BUF);
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_tis(unit, t, i, "use") && pt_kind(t, i + 1) == 2 {
            if pt_l0_path(sc, unit, t, i) > 0 {
                let got: u32 = pt_l0_slurp(ptr_add(sc, PT_L0PATH), buf, PT_L0CAP);
                if got > PT_L0CAP {
                    return 1;
                }
                if got > 0 && got <= PT_L0CAP {
                    let j: u32 = 0;
                    while j < got {
                        let rw: u64 = pt_l0_word(buf, got, j);
                        let nx: u32 = pt_l0_nx(rw);
                        if nx <= j {
                            j = got;
                        } else {
                            if pt_l0_is(buf, pt_l0_off(rw), pt_l0_len(rw), "record") == 1 {
                                let rr: u64 = pt_l0_rec(sc, buf, got, j);
                                if (rr % 4294967296) != 1 {
                                    return 1;
                                }
                                j = pt_l0_nx(rr);
                            } else {
                                j = nx;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 发 `layouts`（与 `pt_lay_cnt` 同一套走法，第二遍是发射）。
fn pt_layouts(out: ptr, o: u32, sc: ptr, unit: ptr, t: ptr, lo: u32, hi: u32) -> u32 {
    let buf: ptr = ptr_add(sc, PT_L0BUF);
    let ix: u32 = 0;
    let i: u32 = lo;
    while i < hi && pt_kind(t, i) != 4 {
        if pt_tis(unit, t, i, "use") && pt_kind(t, i + 1) == 2 {
            if pt_l0_path(sc, unit, t, i) > 0 {
                let got: u32 = pt_l0_slurp(ptr_add(sc, PT_L0PATH), buf, PT_L0CAP);
                if got > 0 && got <= PT_L0CAP {
                    let j: u32 = 0;
                    while j < got {
                        let rw: u64 = pt_l0_word(buf, got, j);
                        let nx: u32 = pt_l0_nx(rw);
                        if nx <= j {
                            j = got;
                        } else {
                            if pt_l0_is(buf, pt_l0_off(rw), pt_l0_len(rw), "record") == 1 {
                                let rr: u64 = pt_l0_rec(sc, buf, got, j);
                                o = pt_l0_emit_one(out, o, sc, buf, ix);
                                ix = ix + 1;
                                j = pt_l0_nx(rr);
                            } else {
                                j = nx;
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return o;
}

// ---------------------------------------------------------------- 入口

/// 发一个单元的 Potato v5 对象, 返回写出的字节数。**0 = 拒绝** —— 话已经打到 stderr,
/// 调用方据此以 1 退出(与那些"超限报错, 绝不静默丢"的判据同一种形状)。
///
/// 键的顺序与参考实现**逐字对齐**(`emit_potato` 那个字面量 dict 的顺序): 对象是拿
/// 字节比的, 顺序也在比较面里。
pub fn potato_emit(unit: ptr, t: ptr, nt: u32, sw: ptr, out: ptr) -> u32 {
    let rr: u64 = pt_root_range(unit, t, nt);
    if rr == PT_NONE as u64 {
        return pt_wfail("--emit-potato: the unit declares no `module` at all (the reference implementation's front door has the same rule)");
    }
    let lo: u32 = (rr / 4294967296) as u32;
    let hi: u32 = (rr % 4294967296) as u32;
    // 预置块的起点: `pt_root_range` 只在"根后面紧跟 `__prelude`"时把 `hi` 指到它身上,
    // 所以 `hi < nt` **就是**"有预置块"。
    let pre: u32 = PT_NONE;
    if hi < nt {
        pre = hi;
    }
    // `generics` 只有一类来源: 预置的 Option/Result(它们带 `<T>`)。根自己的泛型声明在
    // `pt_refuse` 里被拒了, 所以这一格扫**预置块**那一小段就够了 —— 见 `pt_cnt_gen` 的注释。
    let glo: u32 = lo;
    let ghi: u32 = lo;
    if pre != PT_NONE {
        glo = pre;
        ghi = nt;
    }
    // 两条拒绝都是"自己把话打了 + 返回 1" —— 话在函数里就打出去了, 这里只把它翻成
    // "没发出东西"(返回 0)。**空串不当哨兵**: 那会生成一个零长的字符串全局
    // (`[0 x i8] c""`), 而它正是那个把 genesis 链接器绊倒的东西(见文件末那条注释)。
    if pt_refuse(unit, t, lo, hi, pre, nt) == 1 {
        return 0;
    }
    if pt_refuse_num(unit, t, lo, hi) == 1 {
        return 0;
    }
    // ---- 单态化（M6）：先收泛型函数的名字，再走一遍所有函数体建实例。
    // **在计数之前**做完 —— 实例要追加进 `functions`/`instances` 两格。
    // 指针**不能比相等/大小**：参考实现的 codegen 会发出 `icmp == ptr`（**非法 IR**，
    // clang 与 Python 链接器都拒）。所以失败判定在 u64 上做（brk 返回 0 = 失败）。
    let scv: u64 = pt_alloc(PT_SC_BYTES);
    if scv == 0 {
        return pt_wfail("--emit-potato: out of memory (brk failed: monomorphisation workspace)");
    }
    let sc: ptr = scv as ptr;
    // **跨函数 deref-only 安全表**（`docs/210` §7）—— codegen 的 `compute_safe`（potato
    // `use codegen`）。与 codegen 那边**同一支扫描**，于是 gc_ladder 四层与发射路径一致。
    let _sft: u32 = compute_safe(unit, t, ptr_add(sc, PT_GLSAFE));
    store32(sc, PT_N, 0);
    store32(sc, PT_PC, 0);
    store32(sc, PT_EN, 0);
    store32(sc, PT_NG, 0);
    // M7 的两个游标**也必须归零** —— brk 拿回来的那块不保证是干净的（这不是 `pt_sc_new`
    // 那条路：`potato_emit` 自己 alloc）。少这一条时症状很隐蔽：`pt_tref_add` 拿一个垃圾
    // 条数去查重、当场"命中"、于是一条类型串都没收进来，`enums` / `types` 静静地少掉实例
    // （`native_res` 发出来的是 `"ret": "Result<u32, u32>"`）。
    store32(sc, PT_TN, 0);
    store32(sc, PT_TCUR, 0);
    if pt_gfn_scan(sc, unit, t, nt) == 1 {
        return pt_wfail("--emit-potato: more generic function declarations than this section takes (generic methods inside an `impl` block, or more than 16)");
    }
    if load32(sc, PT_NG) > 0 {
        let mrc: u32 = pt_mono_all(sc, unit, t, nt);
        if mrc == 2 {
            return pt_wfail("--emit-potato: an instance's parameter types cannot be substituted (the parameter type *mentions* a type parameter instead of being the bare one -- e.g. `p: Pair<T>`; this slot substitutes bare type parameters only, `a: T`)");
        }
        if mrc == 1 {
            return pt_wfail("--emit-potato: the shape of a generic call site is outside this section (only identifiers, `x as T` and the field access `p.a`; `p[0]` / `f(x)` are not done yet)");
        }
    }
    // ---- 单态化（M7）：收类型串 → 建映射表（实例名）。**也在计数之前** —— 实例要追加进
    // `types` / `enums` / `instances` 三格，而"追加几条"由映射表决定。
    if pt_collect(sc, unit, t, 0, nt) == 0 {
        return pt_wfail("--emit-potato: the type string pool is full (128 entries of 64 bytes) -- raise PT_TMAX / PT_TSTRIDE");
    }
    pt_sort_pool(sc);
    if pt_tmap_build(sc, unit, t, nt) == 1 {
        return pt_wfail("--emit-potato: this shape of generic argument is not taken -- the section takes base type names and nested generics (`Outer<Inner<u32>>`); arrays, slices and pointers as arguments (`Box<[u8; 4]>` / `Box<[u32]>` / `Box<*mut u8>`) have no naming rule, and the backend blocks them first anyway (struct fields take scalars only)");
    }
    // ---- M-L0: `layouts`（要读文件 —— 解析不了、或超了 64 KiB 读缓冲, 都**点名拒**）
    if pt_lay_check(sc, unit, t, lo, hi) == 1 {
        return pt_wfail("--emit-potato: one of the L0 layouts (`.lom`) this unit uses cannot be parsed -- this section does the `record` arm only (`layout(packed, size=N, endian=...)` plus `field : type @offset`)");
    }
    let nly: u32 = pt_lay_cnt(sc, unit, t, lo, hi);
    if nly == PT_NONE {
        return pt_wfail("--emit-potato: one of the L0 layouts (`.lom`) is larger than the 64 KiB read buffer -- naming it beats truncating it and emitting fewer `layouts`");
    }
    let nti_st: u32 = pt_cnt_inst(sc, unit, t, nt, 1);
    let nti_en: u32 = pt_cnt_inst(sc, unit, t, nt, 2);
    let nfi: u32 = load32(sc, PT_N);
    let nins: u32 = nfi + nti_st + nti_en;
    let nfn: u32 = pt_cnt_fn(unit, t, lo, hi);
    let nst: u32 = pt_cnt_types(unit, t, lo, hi) + nti_st;
    let nen: u32 = pt_cnt_enums(unit, t, lo, hi) + nti_en;
    let nco: u32 = pt_cnt_kw0(unit, t, lo, hi, "const");
    let ncp: u32 = pt_cnt_kw0(unit, t, lo, hi, "capability");
    let nex: u32 = pt_cnt_kw0(unit, t, lo, hi, "excluded");
    let ndf: u32 = pt_cnt_defs(unit, sw);
    let ngu: u32 = pt_cnt_guards(unit, t, lo, hi);
    // `boundary`（`docs/205` R5）: 越过语言保证的那些调用点。**口径是词法的** ——
    // 数的就是"这个名字被调用了没有", 不判类型、不判危险。与参考实现的 `_count_boundary`
    // 是同一组数（`loment_cli_test` 另拿参考实现的**真词法器**对过 `loment stat` 那一份）。
    let nbd_sys: u32 = pt_cnt_boundary_call(unit, t, lo, hi, "syscall4")
                     + pt_cnt_boundary_call(unit, t, lo, hi, "syscall6")
                     + pt_cnt_boundary_call(unit, t, lo, hi, "syscall7");
    let nbd_ptr: u32 = pt_cnt_boundary_call(unit, t, lo, hi, "ptr_add")
                     + pt_cnt_boundary_call(unit, t, lo, hi, "ptr_sub")
                     + pt_cnt_boundary_call(unit, t, lo, hi, "str_ptr");
    let nbd_ed: u32 = pt_cnt_boundary_extdecls(unit, t, lo, hi);
    let nbd_ec: u32 = pt_cnt_boundary_extcalls(unit, t, lo, hi);
    // `generics` 是三段拼的（参考实现: `[fn 的] + [struct 的] + [enum 的]`），
    // 最后再加上**预置块**里的枚举（Option/Result）。
    let ngf: u32 = pt_cnt_gen_kw(unit, t, lo, hi, "fn");
    let ngs: u32 = pt_cnt_gen_kw(unit, t, lo, hi, "struct");
    let nge: u32 = pt_cnt_gen_kw(unit, t, lo, hi, "enum");
    let ngp: u32 = pt_cnt_gen(unit, t, glo, ghi);
    let ngi: u32 = ngf + ngs + nge + ngp;
    let ntr: u32 = pt_cnt_traits(unit, t, lo, hi);
    let npl: u32 = pt_cnt_impls(unit, t, lo, hi);
    let nim: u32 = pt_cnt_imports(unit, t, lo);
    let o: u32 = 0;
    o = pt_str(out, o, "{\n");
    // v10 = v9 + **GC 的组成**（`docs/210` §3/§5）：四层梯各领走几个 `alloc` 站点。
    let ngl_tot: u32 = pt_gl_total(unit, t, lo, hi);
    let ngl_pk: u64 = pt_gl_all(sc, unit, t, lo, hi);
    // 三个份额**先落成 u32** —— 混用 u32/u64 的减法会发出类型不匹配的 IR（实测被 clang 拒）。
    let ngl_a: u32 = (ngl_pk & 65535) as u32;
    let ngl_b: u32 = ((ngl_pk >> 16) & 65535) as u32;
    let ngl_c: u32 = ((ngl_pk >> 32) & 65535) as u32;
    // v12 = v11 + **面的组成**（`docs/224`）：机调用站点按面分一分。
    let nsf_file: u32 = pt_surf_total(unit, t, lo, hi, 1);
    let nsf_mem: u32 = pt_surf_total(unit, t, lo, hi, 2);
    let nsf_net: u32 = pt_surf_total(unit, t, lo, hi, 3);
    let nsf_proc: u32 = pt_surf_total(unit, t, lo, hi, 4);
    let nsf_other: u32 = pt_surf_total(unit, t, lo, hi, 0);
    let nsf_tot: u32 = nsf_file + nsf_mem + nsf_net + nsf_proc + nsf_other;
    // v14 = v13 + **联网站点的宽度组成**（`docs/237`）：四档各领走几个联网站点。
    // 与 `surfaces` 数的是**同一批站点**（`nsf_net`），只是分的粗细不同 —— 那条交叉
    // 不变量由两份校验器判。
    let nlw0: u32 = pt_rung_total(unit, t, lo, hi, 0);
    let nlw1: u32 = pt_rung_total(unit, t, lo, hi, 1);
    let nlw2: u32 = pt_rung_total(unit, t, lo, hi, 2);
    let nlw3: u32 = pt_rung_total(unit, t, lo, hi, 3);
    let nlw_tot: u32 = nlw0 + nlw1 + nlw2 + nlw3;
    // v15 = v14 + **内存安全**（`docs/253`，用户 2026-10-15 定第六维）：`lms_close` / `lms_open`。
    // 它在**最后** —— 与前面几维同形，且"这份产物开没开内存安全"是**不读源码可判**的。
    o = pt_key(out, o, 1, "potato");
    o = pt_qs(out, o, "v15");
    o = pt_str(out, o, ",\n");
    // `unit` 是**根**那份源的 `module` 名 —— 依赖在前, 所以它是根那个标记后面的名字
    // (不是第 1 个 token: 那是第一个依赖的名字)。
    o = pt_key(out, o, 1, "unit");
    o = pt_q(out, o, unit, pt_off(t, lo + 1), pt_tlen(t, lo + 1));
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "language");
    o = pt_qs(out, o, "loment");
    o = pt_str(out, o, ",\n");
    // **表层语法**（`docs/188` §2）。这里**恒为 `loment`**: 自举侧的前门只抹掉
    // `choose write grammar loment` 那一行, 别的写法它**点名拒绝**（`EXTRA_REFUSED` 里
    // 那份 `lumtui_math.lomt` 就是钉这个的）—— 所以它能收下的每一份单元, 写法都是
    // `loment`。**这不是猜的**: 哪天真让它收下别门写法, 参考实现会发那一门的名字,
    // 逐字节比对当场红。
    o = pt_key(out, o, 1, "grammar");
    o = pt_qs(out, o, "loment");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "mode");
    o = pt_mode(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    // **回收档**（`docs/175` §3.4）：与 `mode` 同级同形、**必填** —— 于是
    // "这个产物是在哪一档下编的"（以及它**有没有放弃确定性**）是**不读源码可判**的。
    o = pt_key(out, o, 1, "gc");
    o = pt_gc(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    // **运行期在不在**（`docs/175` §3.6, v9）。取值只说"有没有"，不说"里面装了什么"。
    o = pt_key(out, o, 1, "runtime");
    o = pt_runtime(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    // **对外端口在不在**（`docs/222` §4, v11）。与 `mode`/`gc`/`runtime` 同一条纪律 ——
    // **必填**，所以"这份产物通不通着世界"是**不读源码可判的**。
    o = pt_key(out, o, 1, "port");
    o = pt_port(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    // v13（`docs/231`）：执行模型。**必填**，所以它在最后 —— 与前面几维同形。
    // ⚠ **次序是判据**：参考实现那边 `"vm"` 紧跟在 `"port"` 之后，两串字节逐字节比。
    o = pt_key(out, o, 1, "vm");
    o = pt_vm(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    // v15（`docs/253`）：内存安全。**必填**，紧跟在 `vm` 之后 ——
    // ⚠ **次序是判据**：参考实现那边 `"lms"` 紧跟在 `"vm"` 之后，两串字节逐字节比。
    o = pt_key(out, o, 1, "lms");
    o = pt_lms(out, o, unit, t, lo, hi);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "switches");
    o = pt_aopen(out, o, ndf);
    o = pt_switches(out, o, unit, sw, ndf);
    o = pt_acls(out, o, 1, ndf);
    o = pt_str(out, o, ",\n");
    // 两格恒空, 且**每一条都在别处被挡过**(不是"没实现所以写空"):
    //   dialects —— 驱动器在 comefor 展开过之后就不让走这条路
    //   bodies   —— 外部代码块在检查**之前**就被驱动器拒了
    o = pt_key(out, o, 1, "dialects");
    o = pt_str(out, o, "[]");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "bodies");
    o = pt_str(out, o, "[]");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "imports");
    o = pt_aopen(out, o, nim);
    o = pt_imports(out, o, unit, t, lo, nim);
    o = pt_acls(out, o, 1, nim);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "capabilities");
    o = pt_aopen(out, o, ncp);
    o = pt_caps(out, o, unit, t, lo, hi, ncp);
    o = pt_acls(out, o, 1, ncp);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "functions");
    o = pt_aopen(out, o, nfn + nfi);
    o = pt_functions(out, o, sc, unit, t, lo, hi, nfn);
    o = pt_fn_insts(out, o, sc, unit, t, nfn);
    o = pt_acls(out, o, 1, nfn + nfi);
    o = pt_str(out, o, ",\n");
    // layouts: 来自 L0 装载 (`use "xxx.lom"`) —— **自己读那个文件**（驱动器不拼它，见 M-L0 那一节）
    o = pt_key(out, o, 1, "layouts");
    o = pt_aopen(out, o, nly);
    o = pt_layouts(out, o, sc, unit, t, lo, hi);
    o = pt_acls(out, o, 1, nly);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "consts");
    o = pt_aopen(out, o, nco);
    o = pt_consts(out, o, sc, unit, t, lo, hi, nco);
    o = pt_acls(out, o, 1, nco);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "enums");
    o = pt_aopen(out, o, nen);
    o = pt_enums(out, o, sc, unit, t, lo, hi, nen, nt);
    o = pt_acls(out, o, 1, nen);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "types");
    o = pt_aopen(out, o, nst);
    o = pt_types(out, o, sc, unit, t, lo, hi, nst, nt);
    o = pt_acls(out, o, 1, nst);
    o = pt_str(out, o, ",\n");
    // traits / impls: `pt_refuse` 挡住了带这两类声明的单元
    o = pt_key(out, o, 1, "traits");
    o = pt_aopen(out, o, ntr);
    o = pt_traits(out, o, unit, t, lo, hi, ntr);
    o = pt_acls(out, o, 1, ntr);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "impls");
    o = pt_aopen(out, o, npl);
    o = pt_impls(out, o, sc, unit, t, lo, hi, npl);
    o = pt_acls(out, o, 1, npl);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "generics");
    o = pt_aopen(out, o, ngi);
    o = pt_gen_kw(out, o, unit, t, lo, hi, "fn", "fn", 0);
    o = pt_gen_kw(out, o, unit, t, lo, hi, "struct", "type", ngf);
    o = pt_gen_kw(out, o, unit, t, lo, hi, "enum", "type", ngf + ngs);
    o = pt_gen_kw(out, o, unit, t, glo, ghi, "enum", "type", ngf + ngs + nge);
    o = pt_acls(out, o, 1, ngi);
    o = pt_str(out, o, ",\n");
    // instances: 单态化实例 —— 泛型函数的（`pt_fn_insts`）+ 泛型类型的（`pt_inst_tk`）
    o = pt_key(out, o, 1, "instances");
    o = pt_aopen(out, o, nins);
    o = pt_instances(out, o, sc, unit, t, nfi, nt);
    // 类型实例接在 fn 实例**之后**（参考实现是"先 a 后 b"两块：结构体的在前、枚举的在后）
    o = pt_inst_tk(out, o, sc, unit, t, nt, 1, nfi);
    o = pt_inst_tk(out, o, sc, unit, t, nt, 2, nfi + nti_st);
    o = pt_acls(out, o, 1, nins);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "guards");
    o = pt_dec(out, o, ngu as u64);
    o = pt_str(out, o, ",\n");
    // 与 `guards` 同级同形: 一个自描述的对象。**必填**（`docs/205` R5）——
    // 一个"缺席的计数"和一个"零"在读者眼里长得一样, 而那是两件事。
    o = pt_key(out, o, 1, "boundary");
    o = pt_str(out, o, "{\n");
    o = pt_key(out, o, 2, "extern_declared");
    o = pt_dec(out, o, nbd_ed as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "extern_calls");
    o = pt_dec(out, o, nbd_ec as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "syscalls");
    o = pt_dec(out, o, nbd_sys as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "ptr_transforms");
    o = pt_dec(out, o, nbd_ptr as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "total_sites");
    o = pt_dec(out, o, (nbd_ec + nbd_sys + nbd_ptr) as u64);
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, 1);
    o = pt_str(out, o, "}");
    o = pt_str(out, o, ",\n");
    // **GC 的组成**（`docs/210` §3/§5, v10）—— 与 `boundary` 同形：四个分量 + 一个总数，
    // 总数就是四者之和。**必填**：一个"缺席的组成"会被读成"这份程序没有 GC"。
    o = pt_key(out, o, 1, "gc_ladder");
    o = pt_str(out, o, "{\n");
    o = pt_key(out, o, 2, "l0");
    o = pt_dec(out, o, ngl_a as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "l1");
    o = pt_dec(out, o, ngl_b as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "l2");
    o = pt_dec(out, o, ngl_c as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "l3");
    o = pt_dec(out, o, (ngl_tot - (ngl_a + ngl_b + ngl_c)) as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "total_sites");
    o = pt_dec(out, o, ngl_tot as u64);
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, 1);
    o = pt_str(out, o, "}");
    o = pt_str(out, o, ",\n");
    // **面的组成**（`docs/224`, v12）—— 与 `boundary`/`gc_ladder` 同形；**键按面名的字母序、
    // 只写非零**（`file` < `mem` < `net` < `other` < `proc` < `total_sites`，
    // 与参考实现的 `sorted(counts)` 同序），所以最后那个逗号只在"写过至少一个"时补。
    o = pt_key(out, o, 1, "surfaces");
    o = pt_str(out, o, "{\n");
    let sf_first: u32 = 1;
    if nsf_file > 0 {
        o = pt_surf_one(out, o, sf_first, "file", nsf_file);
        sf_first = 0;
    }
    if nsf_mem > 0 {
        o = pt_surf_one(out, o, sf_first, "mem", nsf_mem);
        sf_first = 0;
    }
    if nsf_net > 0 {
        o = pt_surf_one(out, o, sf_first, "net", nsf_net);
        sf_first = 0;
    }
    if nsf_other > 0 {
        o = pt_surf_one(out, o, sf_first, "other", nsf_other);
        sf_first = 0;
    }
    if nsf_proc > 0 {
        o = pt_surf_one(out, o, sf_first, "proc", nsf_proc);
        sf_first = 0;
    }
    if sf_first == 0 {
        o = pt_str(out, o, ",\n");
    }
    o = pt_key(out, o, 2, "total_sites");
    o = pt_dec(out, o, nsf_tot as u64);
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, 1);
    o = pt_str(out, o, "}");
    o = pt_str(out, o, ",\n");
    // **联网站点的宽度组成**（`docs/237`, v14）—— 与 `gc_ladder` 同形：四档恒在（哪怕为 0），
    // 键的集合固定，读者与校验器都不用猜。
    o = pt_key(out, o, 1, "net_ladder");
    o = pt_str(out, o, "{\n");
    o = pt_key(out, o, 2, "w0");
    o = pt_dec(out, o, nlw0 as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "w1");
    o = pt_dec(out, o, nlw1 as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "w2");
    o = pt_dec(out, o, nlw2 as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "w3");
    o = pt_dec(out, o, nlw3 as u64);
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 2, "total_net");
    o = pt_dec(out, o, nlw_tot as u64);
    o = pt_str(out, o, "\n");
    o = pt_ind(out, o, 1);
    o = pt_str(out, o, "}");
    o = pt_str(out, o, ",\n");
    o = pt_key(out, o, 1, "excluded");
    o = pt_aopen(out, o, nex);
    o = pt_excluded(out, o, unit, t, lo, hi, nex);
    o = pt_acls(out, o, 1, nex);
    o = pt_str(out, o, "\n");
    o = pt_str(out, o, "}");
    return pt_str(out, o, "\n");
}
