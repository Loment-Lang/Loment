const FIX_STRIDE: u32 = 8;

/// 第 `i` 条修法（`i` 从 0 起）。`i` 超出该码的条数就是空串。
pub fn code_fix(c: u32, i: u32, lang: u32) -> str {
    let k: u32 = (c * FIX_STRIDE + i) * 2 + lang;
    if k == 16 { return "Change one side to match the signature: read the declared return type / parameter type and make the expression be that."; }
    if k == 18 { return "Different integer widths: write the cast out - `x as u64`, `n as i32` (integer<->integer, integer<->bool and pointer<->integer are all allowed)."; }
    if k == 20 { return "Booleans and integers are separate: write `x != 0` or `true` in a condition; do not expect `1` to work as `true`."; }
    if k == 22 { return "Array / struct elements must all be one type: cast each element with `as`, or add a conversion function."; }
    if k == 17 { return "照签名改一侧：看函数声明的返回类型/形参类型，把表达式改成那一侧。"; }
    if k == 19 { return "整型宽度不同就显式写 `as`：`x as u64`、`n as i32`（整数⇄整数、整数⇄布尔、指针⇄整数都可以）。"; }
    if k == 21 { return "布尔与整数分开：条件位置写 `x != 0` 或 `true`，不要指望 `1` 能当 `true`。"; }
    if k == 23 { return "数组/结构体的元素类型要统一，逐个 `as` 或加一个转换函数。"; }
    if k == 32 { return "Add the type annotation: `let x: u32 = 1;` (a `let` with no type is really E019, a syntax error, but it is easy to read as this one)."; }
    if k == 34 { return "Misspelt: fix the spelling. Cross-module: put `pub` on the declaration and `use <module>` or `use \"./x.lomt\"` at the call site."; }
    if k == 36 { return "Generic functions need their arguments to pin down `T`: `let a: u32 = 4;` then `pick(a, b)`. Passing integer literals straight in reports this code, and that message is misleading."; }
    if k == 38 { return "The name really does come from elsewhere: name its location with the path form `use \"./util.lomt\"`."; }
    if k == 33 { return "补类型标注：`let x: u32 = 1;`（`let` 不带类型是 **E19 语法错**，但很容易被当成这条）。"; }
    if k == 35 { return "拼错了就改拼写；跨模块调用给声明加 `pub`，调用方补 `use <模块名>` 或 `use “./x.lomt”`。"; }
    if k == 37 { return "泛型函数的实参要能把 `T` 定出来：先 `let a: u32 = 4;` 再 `pick(a, b)` —— 直接传整数字面量会报这条，消息有误导。"; }
    if k == 39 { return "确实是别处来的名字：用路径形式 `use “./util.lomt”` 指明位置。"; }
    if k == 48 { return "Count against the signature: delete the extras, supply the missing ones."; }
    if k == 50 { return "Do not count `self` in a method call (`obj.m(a)` is one argument, not two)."; }
    if k == 52 { return "Want an overload? Use a different name: `parse_int` / `parse_float`. Loment resolves by name, and one name with two different parameter lists is not allowed."; }
    if k == 49 { return "照着签名数一遍，多的删、缺的补。"; }
    if k == 51 { return "方法调用别把 `self` 算进去（`obj.m(a)` 是 1 个实参，不是 2 个）。"; }
    if k == 53 { return "想写重载就换个名字：`parse_int` / `parse_float` —— Loment 按名字解析，同名不同参不允许。"; }
    if k == 64 { return "Declare it at module top level: `capability c : disk[0..4]` (`c` is the name, `disk` is the space)."; }
    if k == 66 { return "Range reversed? Swap it: `lo <= hi` is required (`[0..4]` is five values: 0,1,2,3,4)."; }
    if k == 68 { return "Name already taken: rename it. One space may hold several domains, each with its own name."; }
    if k == 70 { return "The index is a literal and out of range: change the index or widen the domain. This check happens at compile time, not at run time."; }
    if k == 65 { return "在模块顶层补声明：`capability c : disk[0..4]`（`c` 是名字，`disk` 是空间名）。"; }
    if k == 67 { return "边界反了就调正：必须 `lo <= hi`（`[0..4]` 是 0,1,2,3,4 五个值）。"; }
    if k == 69 { return "重名就改名；同一空间可以有多个域，各用各的名字。"; }
    if k == 71 { return "索引是字面量且越界：改索引或把域放大 —— 这是编译期检查，不是运行期。"; }
    if k == 80 { return "Delete that `excluded` line, if the promise should not have been there in the first place."; }
    if k == 82 { return "Declare the capability domain over a space that is not excluded."; }
    if k == 84 { return "Keep the promise and change the place that uses it - a capability domain exists precisely to keep access inside a stated range."; }
    if k == 81 { return "删掉那条 `excluded`（如果那份承诺本来就不该有）。"; }
    if k == 83 { return "换一个没有被排除的空间来声明能力域。"; }
    if k == 85 { return "保留承诺、把用到它的那处改掉 —— 能力域本来就是用来把访问收在明确范围内的。"; }
    if k == 96 { return "Pass a reference instead: `f(&v)` or `f(&mut v)` - the most common fix."; }
    if k == 98 { return "You really need a second copy: copy the fields you need into a new variable **before** the move, then pass the original."; }
    if k == 100 { return "Make the type `Copy`: give it only integer fields (`u32`/`i64`/`bool`...), with no string, slice or pointer inside."; }
    if k == 102 { return "Arrange ownership: let the place that uses it last be the one that consumes it, and use references everywhere before that."; }
    if k == 97 { return "改成传引用：`f(&v)` 或 `f(&mut v)` —— 最常用的改法。"; }
    if k == 99 { return "确实要留一份：先在**移动之前**把需要的字段拷到新变量，再传。"; }
    if k == 101 { return "让类型变成可 `Copy` 的：字段全用整型（`u32`/`i64`/`bool`…），去掉里面的字符串/切片/指针。"; }
    if k == 103 { return "把所有权安排清楚：让它最后被用到的那一处消费，前面都用引用。"; }
    if k == 112 { return "Keep only one kind of borrow: turn `&a, &mut a` into `&a` for both (read-only), or into `&mut` for both."; }
    if k == 114 { return "Take the value out first: `let n: u32 = a.x;` then pass `&mut a, n`."; }
    if k == 116 { return "Split one statement into two: read first, store the result in a variable, then take the mutable borrow."; }
    if k == 118 { return "If you must read and write the same memory, write it as three steps: read out, compute, write back."; }
