// loment/tools/lvm.lomt — LVM 的**自举镜像**：那份 IR 的第四个读者（docs/243）
//
// 判据（tools/lvm_twin_test.py）：同一份 `.ll` 喂**两边** —— 参考实现
// （`tools/lvm.py --ir`）与本程序（走自举链编成 ELF 后跑）—— **stdout 字节 + 退出码
// 相同**。与 `lomelf`/`lomelf.lomt` 那一对是**两种活**：那一格比的是产出的 ELF
// **逐字节**，这一格比的是**跑出来的行为** —— 所以这里**不必逐行镜像**参考实现的写法，
// 结构按 Loment 能花的钱来（没有字典、没有动态分配，全用固定表）。
//
// CLI:  lvm IN.ll            （只吃 IR：Loment 侧没有前端，前端在 driver）
// 退出码 = 被解释程序自己的退出码；输入读不了 / 解析不了 = 2（与参考实现的 main 同）
//
// 与参考实现的关系（`docs/243` §2 那张表）：**整段跳过**的是 x86 编码、`Asm`、
// SSA→栈槽、重定位、ELF/PE 写出 —— 那些 Python 侧也一个都不用。留下的是**语言语义**：
// 按宽度截断、零/符号扩展、phi 取**前驱块**那一支的值。
//
// 已知边界（**点名拒**，不静默错算 —— 与 `lomelf.lomt` 同一条纪律）：
//   * `atomicrmw`：参考实现支持 `add`，这一份**没实现**（语料里 0 次）。宁可用不了，
//     不要算错 —— 真被喂到会报"这个指令 T0 没实现"。
//   * 间接调用（`call %x(...)`）：参考实现也拒（它的正则只认 `@name`）。
//   * 浮点 / `select` / `bitcast`：整条子集里没有（`lomelf.py` 头注那份子集清单）。
//   * `shl`/`lshr`/`ashr`/`and`/`or`/`xor` 实现了，但**语料里 0 次** —— 孪生判据覆盖不到，
//     记账在此。
//
// ---------------------------------------------------------------- 自举子集备忘
//
// ① `const` 的初值只吃**字面量**（`4 * 1024 * 1024` 解析不过）—— 所以下面每个数后面
//    都注明它是怎么算出来的；② **没有 `break`**，早退只能靠标志位或 `return`；
// ③ `x as u64 << 32` 会被读成泛型实参 `u64<…>`，必须写 `((x as u64) << 32)`；
// ⑤ 移位 / 比较 / 减法：**两边位宽必须一致**（`u64 << u32` 发出来的 IR，clang 直接拒：
//    `'%t' defined with type 'i32' but expected 'i64'`）。**参考实现也有这个毛病** ——
//    只是平时没人拿 clang 编过这种代码（`lomelf` 是宽松的，照收）。所以下面每个
//    `u64` 的移位量都显式 `as u64`。见 issue #316（这条与 `bool != bool` 那条都在里面）。
// ④ **没有模块级 `let`**（顶层只有 `module`/`use`/`choose`/`const`/`fn`）—— 所以
//    「可变状态」一律落在 arena 头部那 256 字节的格区里（照 `lomelf.lomt` 的做法）。

module lvm
choose runtime

use bytes

// ---------------------------------------------------------------- 表容量
//
// 固定表 + 超了**点名报错**（不是静默写坏邻表 —— 那个教训见 docs/200）。
// 下面的数**按语料实测取余量**（`lument_elf_test.CORPUS` 的最大值写在括号里）：
//   全局 37 · 函数 281 · 形参/函数 ≤10 · 块/函数 ≤139 · 指令全程序 ≤10659 · 调用深度 10
const MAX_GLOBALS: u32 = 256;        // (37)
const MAX_FUNCS: u32 = 512;          // (281)
const MAX_PARAMS: u32 = 2048;        // (每函数 ≤10)
const MAX_BLOCKS: u32 = 8192;        // (每函数 ≤139)
const MAX_INSTRS: u32 = 32768;       // (全程序 ≤10659)
const MAX_EDGES: u32 = 65536;        // 全程序的边（每条 br 1-2 条、switch N+1 条）
const MAX_VALS: u32 = 1024;          // 一帧里同时活着的 SSA 名 (每函数 ≤227)
const MAX_DEPTH: u32 = 32;           // 调用深度 (实测 10)

// VM 自己的地址空间（地址 = 这块里的**下标**，与参考实现的 `Mem` 同口径）
const MEM_SIZE: u32 = 4194304;
const GLOBAL_BASE: u32 = 65536;      // 全局从这儿往上放
//: 堆的上限 = 栈底 —— 帧占 [MEM_SIZE - MAX_DEPTH*FRAME_SIZE, MEM_SIZE)，堆不许越过去。
const STACK_LIMIT: u32 = 3145728;    // 4194304 - 32 * 32768

//: 每层调用一段自己的栈区（**按深度算基址**）。参考实现第一版每层都取同一段，
//: 于是被调者的 alloca 覆盖调用者的槽 —— 见 `lvm.py` `run` 里那段注释。
const FRAME_SIZE: u32 = 32768;

//: 每张记录的字节数
const GLOBAL_REC: u32 = 24;          // name_off,name_len,ty_off,ty_len,init_off,init_len
const FUNC_REC: u32 = 32;            // name_off,name_len,ret_off,ret_len,nparams,first_param,first_block,nblocks
const PARAM_REC: u32 = 16;           // ty_off,ty_len,name_off,name_len
// T1（`docs/247`）：块记录多一格 `count`（这一块被进过几次）。
const BLOCK_REC: u32 = 20;           // label_off,label_len,first_instr,ninstrs,count
// T1：指令记录多两格 —— 这条分支的边在边表里的**起点**与**条数**。
// 边表按解析期一次分好（每条 br/switch 的边数静态可知），于是运行时记一条边是
// `E_OFF + (first_edge + edge) * 4`，**O(1)**，不用查表。
const INSTR_REC: u32 = 32;           // dest_off,dest_len,text_off,text_len,kind,sub,first_edge,nedges
const EDGE_REC: u32 = 4;             // 一条边一个计数；边号 = 行号 - first_edge
const VAL_REC: u32 = 16;             // name_off,name_len,vlo,vhi   (u64 拆两半：没有 load64)

//: 帧内布局（相对帧基址）
//
// 一个 SSA 名 → 一个值。标量存 u64（拆两半）；聚合存**一段可读地址**（VM 地址）。
// 「是标量还是聚合」不存 —— 每个使用点上指令文本里写着类型，用不着问值本身。
const FR_NV: u32 = 0;                // 值个数
const FR_NEXT: u32 = 4;              // 槽/聚合 bump（帧内偏移）
const FR_VALS: u32 = 8;              // 值表起点
const FR_INIT: u32 = 16384;          // T2：槽的"写过没有"位图（1024 位 = 128 字节）
const FR_SLOTS: u32 = 16520;         // 8 + 1024 * 16 + 128 —— 槽/聚合区起点

//: 指令种类（解析期算好，存在记录里 —— 求值期别再逐字比）
const K_ALLOCA: u32 = 1;
const K_LOAD: u32 = 2;
const K_STORE: u32 = 3;
const K_GEP: u32 = 4;
const K_EXTRV: u32 = 5;
const K_INSV: u32 = 6;
const K_ICMP: u32 = 7;               // sub = 谓词码
const K_SDIV: u32 = 8;
const K_UDIV: u32 = 9;
const K_SREM: u32 = 10;
const K_UREM: u32 = 11;
const K_ADD: u32 = 12;
const K_SUB: u32 = 13;
const K_MUL: u32 = 14;
const K_AND: u32 = 15;
const K_OR: u32 = 16;
const K_XOR: u32 = 17;
const K_SHL: u32 = 18;
const K_LSHR: u32 = 19;
const K_ASHR: u32 = 20;
const K_TRUNC: u32 = 21;
const K_ZEXT: u32 = 22;
const K_SEXT: u32 = 23;
const K_PTRTOINT: u32 = 24;
const K_INTTOPTR: u32 = 25;
const K_CALL: u32 = 26;
const K_UNREACH: u32 = 27;
const K_PHI: u32 = 28;
const K_BR_UNCOND: u32 = 29;         // sub = 目标块号
const K_BR_COND: u32 = 30;           // sub = (真块号 << 16) | 假块号
const K_SWITCH: u32 = 31;
const K_RET: u32 = 32;
const K_ASMCALL: u32 = 33;

//: icmp 谓词码（顺序与 `lvm.py` 的 `_ICMP` 同；≥6 的这四个是**有符号**）
const P_EQ: u32 = 0;
const P_NE: u32 = 1;
const P_UGT: u32 = 2;
const P_UGE: u32 = 3;
const P_ULT: u32 = 4;
const P_ULE: u32 = 5;
const P_SGT: u32 = 6;
const P_SGE: u32 = 7;
const P_SLT: u32 = 8;
const P_SLE: u32 = 9;

//: 「没有」的哨兵（块号 / 函数号 / 帧）
const NONE: u32 = 4294967295;

//: 指令条数上限。**不是性能护栏，是"不许挂死"** —— 解释器进了死循环就得自己回来。
//: 语料里最重的一份（`lumtui_demo`）实测远在这之下；真撞上会**点名报**出当前函数与指令。
const STEP_CAP: u32 = 50000000;

//: **零页**：VM 地址 [0, GLOBAL_BASE) 永不分配（`vm_alloc` 从 `GLOBAL_BASE` 起），
//: 所以它恒为 0，可以直接当 `undef` / `null` 聚合值的字节来源 —— **读一次就被拷走**，
//: 不用为它分配任何东西。第一版给它每用一次分配一格，于是"循环体里有个 `undef` 聚合"
//: 变成了"每一轮吃一格帧"，`tour` 那一档在第 1023 轮把 32 KiB 的帧吃光。
const ZERO_ADDR: u32 = 0;
const ZERO_CAP: u32 = 65536;         // 零页大小 = GLOBAL_BASE

// ---------------------------------------------------------------- arena 布局
//
// 一块 arena 摆四样东西：输入文本 / VM 的内存 / 五张表 / argv。全部用**常量偏移**。
//
//   SRC  0         .. 4194304   输入 IR 文本（地址 = 输入里的偏移）
//   MEM  4194304   .. 8388608   VM 地址空间（地址 = 这一段的**下标**）
//   TAB  8388608   .. 9361408   五张表
//   ARGV 9361408   .. 9384192   /proc/self/cmdline 的落脚点
const SRCCAP: u32 = 4194304;
const MEM_OFF: u32 = 4194304;
//: 五张表的起址（后面每个数都注明算式）
const G_OFF: u32 = 8388608;                  // TAB
const F_OFF: u32 = 8394752;                  // + 256*24
const P_OFF: u32 = 8411136;                  // + 512*32
const B_OFF: u32 = 8443904;                  // + 2048*16
const I_OFF: u32 = 8607744;                  // + 8192*20
const E_OFF: u32 = 9656320;                  // + 32768*32
const ARGV_OFF: u32 = 9918464;               // + 65536*4
//: 格区**不能在 0** —— 输入文本就从 0 起，两者会打架。第一版把格区放在 arena 头 256 字节，
//: 于是 `read_file` 一读进来 ① 把输入的前 32 字节踩成格子的值、② 之后每次 `ctx_set`
//: 又踩一次；症状是解析器在垃圾上乱跑（报"全局表满了"）。格区挪到 ARGV 之后，
//: **arena 偏移 = 输入文本偏移**这条等式才成立（全篇的 span 都靠它）。
const CTX_OFF: u32 = 9934848;                // + 16384
const ARENA: u64 = 9935104;                  // + 256

// ---------------------------------------------------------------- 格区
//
// arena 头 256 字节里的格子（照 `lomelf.lomt`）。**没有模块级 `let`**，所以可变的
// 全局状态只能落在这儿。
const C_NSRC: u32 = 0;               // 输入字节数
const C_NG: u32 = 4;                 // 全局条数
const C_NF: u32 = 8;                 // 函数条数
const C_NP: u32 = 12;                // 形参条数
const C_NB: u32 = 16;                // 基本块条数
const C_NI: u32 = 20;                // 指令条数
const C_HEAP: u32 = 24;              // VM 堆游标
const C_DEPTH: u32 = 28;             // 当前调用深度
const C_STEPS: u32 = 96;             // 已经执行了多少条指令（见 STEP_CAP）
//: T1：剖面写到哪个 fd。**0 = 关**（0 号是 stdin，写剖面拿到的一定 ≥ 3）。
const C_PROF_FD: u32 = 104;
const C_NEDGE: u32 = 108;           // 边表已经用掉多少行

//: T0（`docs/243` §3.4）：VM **合成**的 `/proc/self/cmdline` 在哪儿。
//: 内容是**被解释程序自己的**命令行 —— 就是解释器被指到的那个输入路径，原样，后跟一个
//: NUL（内核给真进程的形状就是这样）。它本来就在 `ARGV` 区里躺着（那里装的是**解释器**
//: 自己的 cmdline，字段之间已经是 NUL 分隔），所以这里只记"起点在区里的偏移"与"连同末尾
//: NUL 的长度"—— 一个字节都不用搬。
const C_ARG0: u32 = 112;             // 输入路径在 ARGV 区里的偏移
const C_ARG0N: u32 = 116;            // 它连同末尾那个 NUL 的长度
const C_VFD_POS: u32 = 120;          // 合成文件的读游标
const C_VFD_OPEN: u32 = 124;         // 合成文件开着没有（0 = 没开）
//: 合成文件的 fd 号。**两边实现必须给同一个数**（`tools/lvm.py` 的 `VFD_BASE`）。
const VFD: u64 = 1000;

fn ctx_get(a: ptr, k: u32) -> u32 {
    return load32(a, CTX_OFF + k);
}

fn ctx_set(a: ptr, k: u32, v: u32) {
    store32(a, CTX_OFF + k, v);
}

// ---------------------------------------------------------------- 运行时
//
// 与 `lomelf.lomt` 逐字同源的那几个：`die`/`sys_alloc`/`read_all`/`write_all`/`wstr`/
// `fail`/`cstr`/`argv_n`。**它们是解释器自己的系统调用**，不是被解释程序的 —— 后者走
// `vm_syscall` 那张表（`docs/243` §3.4）。

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn fail(msg: str) -> u32 {
    wstr(2, "lvm: ");
    wstr(2, msg);
    wstr(2, "\n");
    return die(2);
}

/// 带**原文**的报错。参考实现也是这么报的（`读未定义的值 %t7`）—— 只说"有个东西没定义"
/// 就得回去自己数第几行，那不是一条能用的报错。
fn fail_tok(a: ptr, msg: str, off: u32, len: u32) -> u32 {
    wstr(2, "lvm: ");
    wstr(2, msg);
    wstr(2, " ");
    if off + len <= SRCCAP {
        write_all(2, ptr_add(a, off), len as u64);
    }
    wstr(2, "\n");
    return die(2);
}

//: 读整个文件进 dst，返回读到的字节数（0 = 打不开）。
//: 用 `open`(2) 而不是 `openat`(257)：前者参数少一格，`syscall4` 正好装得下。
fn read_file(path: ptr, dst: ptr, cap: u64) -> u64 {
    let fd: i64 = syscall4(2, path as u64, 0, 0);
    if fd < 0 {
        return 0;
    }
    let got: u64 = read_all(fd as u64, dst, cap);
    syscall4(3, fd as u64, 0, 0);
    return got;
}

fn cstr(dst: ptr, s: str) -> ptr {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return dst;
}

/// 第 n 个 argv (0 = 程序名) 的 (起点 << 32) | 长度。
fn argv_n(buf: ptr, cap: u64, n: u32) -> u64 {
    let fd: i64 = syscall4(257, (0 as u64) - 100,
                           cstr(ptr_add(buf, 8192), "/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return 0;
    }
    let rn: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if rn <= 0 {
        return 0;
    }
    let m: u32 = rn as u32;
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    let hit: u64 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == n {
                hit = ((s as u64) << 32) | ((i - s) as u64);
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    if f == n {
        hit = ((s as u64) << 32) | ((m - s) as u64);
    }
    return hit;
}

// ---------------------------------------------------------------- 文本
//
// 记号字符。`-` 要算进来：LLVM IR 的立即数允许负号（`and i32 %x, -8`）。少了它，
// `-8` 会被量成长度 0 —— 那个坑 `lomelf.lomt` 上已经踩过一次（见那里的注释）。
// `@` `%` 也要算进来：操作数跨度靠它量（`@.str._start.0`、`%t12`）。
fn is_word(c: u32) -> bool {
    if c >= 97 && c <= 122 {
        return true;
    }
    if c >= 65 && c <= 90 {
        return true;
    }
    if c >= 48 && c <= 57 {
        return true;
    }
    return c == 95 || c == 46 || c == 64 || c == 37 || c == 45;
}

fn is_sp(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn skip_sp(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        if is_sp(load8(t, j)) {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

fn word_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        if is_word(load8(t, j)) {
            j = j + 1;
        } else {
            go = 0;
        }
    }
    return j;
}

/// 从 i 起跳空白，认一个记号，返回 (起点 << 32) | 长度。
fn wspan(t: ptr, i: u32, n: u32) -> u64 {
    if ctx_get(t, C_EXEC) == 1 { ctx_set(t, C_MISS, ctx_get(t, C_MISS) + 1); }
    let s: u32 = skip_sp(t, i, n);
    let e: u32 = word_end(t, s, n);
    return ((s as u64) << 32) | ((e - s) as u64);
}

/// 去掉首尾空白，返回 (起点 << 32) | 长度。
fn trim_span(t: ptr, s: u32, e: u32) -> u64 {
    let i: u32 = s;
    let j: u32 = e;
    while i < j && is_sp(load8(t, i)) {
        i = i + 1;
    }
    while j > i && is_sp(load8(t, j - 1)) {
        j = j - 1;
    }
    return ((i as u64) << 32) | ((j - i) as u64);
}

/// 跳过指令文本的第一个词（算子），返回其后第一个非空白处。
/// **不写死算子长度** —— `getelementptr` 是 13 个字符不是 12，写错了不会报错，
/// 只会把算子尾巴当成类型读（`r`），然后在 GEP 上报"这一步没实现"。这类错一个都不要。
fn after_op(a: ptr, io: u32, e: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let w: u64 = wspan(a, io, e);
    return skip_sp(a, hi32(w) + lo32(w), e);
}

fn lo32(v: u64) -> u32 {
    return v as u32;
}

fn hi32(v: u64) -> u32 {
    return (v >> 32) as u32;
}

/// 两块文本（可不同基址）是否逐字节相同。
fn same(a: ptr, ao: u32, b: ptr, bo: u32, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, ao + i) != load8(b, bo + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// 输入文本里 [off, off+len) 是不是字面量 s。
fn eqw(a: ptr, off: u32, len: u32, s: str) -> bool {
    if len != str_len(s) {
        return false;
    }
    return same(a, off, str_ptr(s), 0, len);
}

/// [off, n) 是否以 s 开头（带边界）。
fn has_at(a: ptr, off: u32, n: u32, s: str) -> bool {
    let l: u32 = str_len(s);
    if off + l > n {
        return false;
    }
    return same(a, off, str_ptr(s), 0, l);
}

fn r2(a: ptr, base: u32, i: u32) -> u64 {
    return ((rd(a, base, i) as u64) << 32) | (rd(a, base, i + 1) as u64);
}

fn wr(m: ptr, base: u32, i: u32, v: u32) {
    store32(m, base + i * 4, v);
}

fn rd(a: ptr, base: u32, i: u32) -> u32 {
    return load32(a, base + i * 4);
}

/// 存一对 (偏移, 长度) 到记录里第 i 格起的两格。
fn w2(m: ptr, base: u32, i: u32, o: u32, l: u32) {
    wr(m, base, i, o);
    wr(m, base, i + 1, l);
}

fn index_of(a: ptr, s: u32, n: u32, ch: u32) -> u32 {
    let i: u32 = s;
    let go: u32 = 1;
    let hit: u32 = NONE;
    while i < n && go == 1 {
        if load8(a, i) == ch {
            hit = i;
            go = 0;
        } else {
            i = i + 1;
        }
    }
    return hit;
}

fn last_byte(a: ptr, s: u32, n: u32, ch: u32) -> u32 {
    let i: u32 = s;
    let hit: u32 = NONE;
    while i < n {
        if load8(a, i) == ch {
            hit = i;
        }
        i = i + 1;
    }
    return hit;
}

/// 括号配对：返回与 [i] 处那个开括号配对的**闭括号**位置（没有则 n）。
/// 只数**同一种**括号 —— 与 `lomelf.parse_type` 同一口径（它也只认外层那一种）。
fn match_close(a: ptr, i: u32, n: u32, open: u32, close: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(a, j);
        if c == open {
            d = d + 1;
        } else if c == close {
            d = d - 1;
            if d == 0 {
                go = 0;
            }
        }
        j = j + 1;
    }
    return j - 1;
}

/// 顶层（圆/方/花括号深度 0）逗号或 n 的位置。
fn seg_end(a: ptr, i: u32, n: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let d: u32 = 0;
    let j: u32 = i;
    let go: u32 = 1;
    while j < n && go == 1 {
        let c: u32 = load8(a, j);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        } else if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        } else if c == 44 && d == 0 {
            go = 0;
        }
        if go == 1 {
            j = j + 1;
        }
    }
    return j;
}

/// 从 `i`（一个顶层逗号或 n）跳到下一段的起点。
fn seg_next(a: ptr, i: u32, n: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let j: u32 = i;
    if j < n && load8(a, j) == 44 {
        j = j + 1;
    }
    return skip_sp(a, j, n);
}

fn has_byte(a: ptr, s: u32, e: u32, ch: u32) -> bool {
    let i: u32 = s;
    while i < e {
        if load8(a, i) == ch {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn line_end(t: ptr, i: u32, n: u32) -> u32 {
    let j: u32 = i;
    while j < n && load8(t, j) != 10 {
        j = j + 1;
    }
    if j > i && load8(t, j - 1) == 13 {
        return j - 1;                                    // CRLF：回车不算行内容
    }
    return j;
}

/// 括号没配平？（IR 的长指令可能跨行 —— 照 `lomelf.unbalanced` 并起来）
fn unbalanced(a: ptr, s: u32, e: u32) -> bool {
    let d: i32 = 0;
    let i: u32 = s;
    while i < e {
        let c: u32 = load8(a, i);
        if c == 123 || c == 91 || c == 40 {
            d = d + 1;
        } else if c == 125 || c == 93 || c == 41 {
            d = d - 1;
        }
        i = i + 1;
    }
    return d > 0;
}

fn hexv(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return c - 55;
}

/// `-?[0-9]+` -> u64（负数取**补码**，与参考实现 `(n & mask)` 同口径）。
fn dec_u64(a: ptr, s: u32, e: u32) -> u64 {
    let i: u32 = skip_sp(a, s, e);
    let neg: u32 = 0;
    if i < e && load8(a, i) == 45 {
        neg = 1;
        i = i + 1;
    }
    let v: u64 = 0;
    while i < e && is_digit(load8(a, i)) {
        v = v * 10 + ((load8(a, i) - 48) as u64);
        i = i + 1;
    }
    if neg == 1 {
        return (0 as u64) - v;
    }
    return v;
}

// ---------------------------------------------------------------- 类型
//
// 子集：i1/i8/i16/i32/i64/ptr、`{T, …}`、`[N x T]`。**逐条镜像** `lomelf.parse_type`
// 与 `size_of` / `field_offset` —— 那三条是"聚合怎么摆"的真源，差一个字节两条路就对不上。

/// 从 off 起读一个类型，返回 (起点 << 32) | 长度。
/// `{`/`[` 走**外层那一种**括号的配对（与参考实现同一处取舍）。
fn ty_span(a: ptr, off: u32, n: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let i: u32 = skip_sp(a, off, n);
    if i >= n {
        return 0;
    }
    let c: u32 = load8(a, i);
    if c == 123 || c == 91 {
        let close: u32 = 125;
        if c == 91 {
            close = 93;
        }
        let d: u32 = 0;
        let j: u32 = i;
        let go: u32 = 1;
        while j < n && go == 1 {
            let ch: u32 = load8(a, j);
            if ch == c {
                d = d + 1;
            } else if ch == close {
                d = d - 1;
                if d == 0 {
                    go = 0;
                }
            }
            j = j + 1;
        }
        return ((i as u64) << 32) | ((j - i) as u64);
    }
    let j: u32 = word_end(a, i, n);
    return ((i as u64) << 32) | ((j - i) as u64);
}

fn is_agg(a: ptr, off: u32, len: u32) -> bool {
    if len == 0 {
        return false;
    }
    let c: u32 = load8(a, off);
    return c == 123 || c == 91;
}

/// 结构体里顶层字段个数。
fn fld_count(a: ptr, off: u32, len: u32) -> u32 {
    let n: u32 = off + len;
    let i: u32 = off + 1;
    let d: u32 = 1;
    let k: u32 = 0;
    let any: u32 = 0;
    while i < n {
        let c: u32 = load8(a, i);
        if c == 123 || c == 91 {
            d = d + 1;
        } else if c == 125 || c == 93 {
            d = d - 1;
            if d == 0 {
                if any == 1 {
                    k = k + 1;
                }
                return k;
            }
        } else if c == 44 && d == 1 {
            k = k + 1;
            any = 0;
        } else if d == 1 && is_sp(c) == false {
            any = 1;
        }
        i = i + 1;
    }
    return k;
}

/// 结构体里第 k 个字段的类型 span。
fn fld_ty(a: ptr, off: u32, len: u32, k: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let n: u32 = off + len;
    let i: u32 = off + 1;
    let d: u32 = 1;
    let s: u32 = i;
    let idx: u32 = 0;
    let res: u64 = 0;
    let go: u32 = 1;
    while i < n && go == 1 {
        let c: u32 = load8(a, i);
        if c == 123 || c == 91 {
            d = d + 1;
        } else if c == 125 || c == 93 {
            d = d - 1;
            if d == 0 {
                if idx == k {
                    res = trim_span(a, s, i);
                }
                go = 0;
            }
        } else if c == 44 && d == 1 {
            if idx == k {
                res = trim_span(a, s, i);
                go = 0;
            }
            idx = idx + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return res;
}

/// 结构体里第 k 个字段的**偏移**（对齐到它自己的大小；无尾部填充）。
fn fld_off(a: ptr, off: u32, len: u32, k: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let o: u32 = 0;
    let i: u32 = 0;
    while i < k {
        let f: u64 = fld_ty(a, off, len, i);
        let sz: u32 = ty_size(a, hi32(f), lo32(f));
        o = ((o + sz - 1) / sz) * sz + sz;
        i = i + 1;
    }
    let fk: u64 = fld_ty(a, off, len, k);
    let szk: u32 = ty_size(a, hi32(fk), lo32(fk));
    return ((o + szk - 1) / szk) * szk;
}

fn arr_count(a: ptr, off: u32, len: u32) -> u32 {
    let i: u32 = off + 1;
    let n: u32 = 0;
    while i < off + len && load8(a, i) != 120 {
        if is_digit(load8(a, i)) {
            n = n * 10 + (load8(a, i) - 48);
        }
        i = i + 1;
    }
    return n;
}

fn arr_elem(a: ptr, off: u32, len: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let i: u32 = off + 1;
    while i < off + len && load8(a, i) != 120 {
        i = i + 1;
    }
    return trim_span(a, i + 1, off + len - 1);
}

/// 类型文本 -> 字节数。**i1 占 1 字节**（与 `lomelf.SCALAR_SIZE` 的 "i1": 1 一致，
/// 不是 1 位 —— `n / 8` 会给出 0，那是个真踩过的坑）。
fn ty_size(a: ptr, off: u32, len: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let c: u32 = load8(a, off);
    if c == 105 {
        let n: u32 = 0;
        let j: u32 = off + 1;
        while j < off + len && is_digit(load8(a, j)) {
            n = n * 10 + (load8(a, j) - 48);
            j = j + 1;
        }
        if n < 8 {
            return 1;
        }
        return n / 8;
    }
    if c == 112 {
        return 8;                          // ptr
    }
    if c == 123 {
        let tot: u32 = 0;
        let nf: u32 = fld_count(a, off, len);
        let k: u32 = 0;
        while k < nf {
            let f: u64 = fld_ty(a, off, len, k);
            let sz: u32 = ty_size(a, hi32(f), lo32(f));
            tot = ((tot + sz - 1) / sz) * sz + sz;
            k = k + 1;
        }
        return tot;
    }
    if c == 91 {
        let et: u64 = arr_elem(a, off, len);
        return arr_count(a, off, len) * ty_size(a, hi32(et), lo32(et));
    }
    return 8;
}

// ---------------------------------------------------------------- VM 内存
//
// 地址 = 一段字节里的下标。`m` 就是那段字节的基址（arena + MEM_OFF）。

fn mr(m: ptr, p: u32, n: u32) -> u64 {
    if p + n > MEM_SIZE {
        return fail("读越界") as u64;
    }
    let v: u64 = 0;
    let i: u32 = 0;
    let sh: u32 = 0;
    while i < n {
        v = v | (((load8(m, p + i) as u64) << (sh as u64)));
        i = i + 1;
        sh = sh + 8;
    }
    return v;
}

fn mw(m: ptr, p: u32, n: u32, v: u64) {
    if p + n > MEM_SIZE {
        let _f: u32 = fail("写越界");
    } else {
        let i: u32 = 0;
        while i < n {
            store8(m, p + i, ((v >> ((i * 8) as u64)) & 255) as u8);
            i = i + 1;
        }
    }
}

fn mc(m: ptr, d: u32, s: u32, n: u32) {
    if d + n > MEM_SIZE || s + n > MEM_SIZE {
        let _f: u32 = fail("拷贝越界");
    } else {
        let i: u32 = 0;
        while i < n {
            store8(m, d + i, load8(m, s + i) as u8);
            i = i + 1;
        }
    }
}

fn mz(m: ptr, d: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(m, d + i, 0 as u8);
        i = i + 1;
    }
}

/// VM 堆分配（bump）。**越界点名报**，不静默写坏栈 —— `docs/200` 那条教训。
fn vm_alloc(a: ptr, n: u32, align: u32) -> u32 {
    let h: u32 = ctx_get(a, C_HEAP);
    let p: u32 = (h + align - 1) / align * align;
    let nx: u32 = p + n;
    if nx >= STACK_LIMIT {
        fail("VM 堆撞上栈 —— 地址空间用完了");
    }
    ctx_set(a, C_HEAP, nx);
    return p;
}

fn mask_bits(v: u64, bits: u32) -> u64 {
    if bits >= 64 {
        return v;
    }
    return v & ((((1 as u64) << (bits as u64))) - 1);
}

/// 有符号读：同一位串按**有符号**解释，再符号扩展回 64 位（比较/加减靠它）。
/// 用"翻符号位再按无符号比"那招更省 —— 见 `sgn_cmp`。
fn sgnb(v: u64, bits: u32) -> u64 {
    if bits >= 64 {
        return v;
    }
    return v ^ (((1 as u64) << ((bits - 1) as u64)));
}

// ---------------------------------------------------------------- 帧

fn fr_alloc(a: ptr, m: ptr, fr: u32, n: u32, align: u32) -> u32 {
    let cur: u32 = rd(m, fr, 1);
    let p: u32 = (cur + align - 1) / align * align;
    let nx: u32 = p + n;
    if nx > FRAME_SIZE {
        wstr(2, "lvm: 帧用完了（槽 / 聚合）—— 帧内已用 ");
        write_num(a, 2, cur); wstr(2, " + "); write_num(a, 2, n);
        wstr(2, " 超过 "); write_num(a, 2, FRAME_SIZE); wstr(2, "
");
        return die(2);
    }
    wr(m, fr, 1, nx);
    return fr + p;
}

/// 一个聚合**暂存区**，按 SSA 名缓存（名字就是那把钥匙）。
///
/// 为什么不是"每次分配一格"：SSA 里一个名字**只被一条指令写**，所以同名的多次执行
/// （循环的每一轮）可以把同一格**反复覆写** —— 读者永远看到本轮写进去的那份。
/// 每次分配就会变成"每轮吃一格帧"，`tour` 实测第 1023 轮把 32 KiB 帧吃光。
fn fr_agg(a: ptr, m: ptr, fr: u32, no: u32, nl: u32, size: u32) -> u32 {
    let i: u32 = vfind(a, m, fr, no, nl);
    if i != NONE {
        if rd(m, fr + FR_VALS, i * 4 + 3) >= size {
            return rd(m, fr + FR_VALS, i * 4 + 2);
        }
    }
    let d: u32 = fr_alloc(a, m, fr, size, 8);
    let v: u64 = (d as u64) | (((size as u64)) << 32);
    if i == NONE {
        vput(a, m, fr, no, nl, v);
    } else {
        vset(a, m, fr, i, v);
    }
    return d;
}

fn vfind(a: ptr, m: ptr, fr: u32, no: u32, nl: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let n: u32 = rd(m, fr, 0);
    let i: u32 = 0;
    while i < n {
        let o: u32 = load32(m, fr + FR_VALS + i * VAL_REC);
        let l: u32 = load32(m, fr + FR_VALS + i * VAL_REC + 4);
        // ⚠ 名字偏移是**输入文本**里的（基址 `a`）—— 表在 VM 内存里，名字不在。
        if l == nl && same(a, no, a, o, nl) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

fn vput(a: ptr, m: ptr, fr: u32, no: u32, nl: u32, v: u64) {
    let n: u32 = rd(m, fr, 0);
    if n >= MAX_VALS {
        fail("一个帧里的值太多了");
    }
    store32(m, fr + FR_VALS + n * VAL_REC, no);
    store32(m, fr + FR_VALS + n * VAL_REC + 4, nl);
    store32(m, fr + FR_VALS + n * VAL_REC + 8, lo32(v));
    store32(m, fr + FR_VALS + n * VAL_REC + 12, hi32(v));
    wr(m, fr, 0, n + 1);
}

/// 把一个**已经存在**的值改成新值（`phi` 每轮改写自己那一格）。
fn vset(a: ptr, m: ptr, fr: u32, i: u32, v: u64) {
    store32(m, fr + FR_VALS + i * VAL_REC + 8, lo32(v));
    store32(m, fr + FR_VALS + i * VAL_REC + 12, hi32(v));
}

/// 帧里第 i 条记录的**值**（低位在 +8，高位在 +12）。
/// ⚠ **不能用 `r2`**: 那个是给 span 用的（偏移在前），拿它读值会把两个 32 位半边颠倒 ——
/// 第一版就这么写，症状是"从帧里读回来的值全是乱的"，而程序**照样跑到底、不报错**。
fn vget(m: ptr, fr: u32, i: u32) -> u64 {
    let lo: u64 = rd(m, fr + FR_VALS, i * 4 + 2) as u64;
    let hi: u64 = rd(m, fr + FR_VALS, i * 4 + 3) as u64;
    return lo | (hi << 32);
}

/// 参数表第 k 条的第 f 格起的 (偏移, 长度)。
fn pspan(a: ptr, k: u32, f: u32) -> u64 {
    return r2(a, P_OFF, k * 4 + f);
}

// ---------------------------------------------------------------- 表查询

fn gaddr(a: ptr, no: u32, nl: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let ng: u32 = ctx_get(a, C_NG);
    let i: u32 = 0;
    while i < ng {
        let o: u32 = rd(a, G_OFF, i * 6);
        let l: u32 = rd(a, G_OFF, i * 6 + 1);
        if l == nl && same(a, no, a, o, nl) {
            return rd(a, G_OFF, i * 6 + 4);
        }
        i = i + 1;
    }
    return fail_tok(a, "未知全局", no, nl);
}

fn fn_find(a: ptr, no: u32, nl: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let nf: u32 = ctx_get(a, C_NF);
    let i: u32 = 0;
    while i < nf {
        let o: u32 = rd(a, F_OFF, i * 8);
        let l: u32 = rd(a, F_OFF, i * 8 + 1);
        if l == nl && same(a, no, a, o, nl) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

fn fn_find_lit(a: ptr, s: str) -> u32 {
    let nf: u32 = ctx_get(a, C_NF);
    let i: u32 = 0;
    while i < nf {
        let o: u32 = rd(a, F_OFF, i * 8);
        let l: u32 = rd(a, F_OFF, i * 8 + 1);
        if eqw(a, o, l, s) {
            return i;
        }
        i = i + 1;
    }
    return NONE;
}

/// 某函数里标签文本 = [lo, lo+ll) 的那一块的**块号**（`switch` 用；热路径不用）。
fn blk_of(a: ptr, fi: u32, lo: u32, ll: u32) -> u32 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
    let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
    let i: u32 = 0;
    while i < nb {
        let o: u32 = rd(a, B_OFF, (fb + i) * 5);
        let l: u32 = rd(a, B_OFF, (fb + i) * 5 + 1);
        if l == ll && same(a, lo, a, o, ll) {
            return fb + i;
        }
        i = i + 1;
    }
    return NONE;
}

// ---------------------------------------------------------------- 解析
//
// **解析成表**，不边扫边解释：名字 / 类型 / 文本全是**输入文本里的 span**（子串不拷贝），
// 指令的种类在解析期算好。两趟：① 记录；② 把 `br` 的目标标签**解析成块号** ——
// 分支是热路径，不能每条都线性找块（`docs/243` §3.2）。

/// 指令的第一个词 -> (种类 << 32) | 副码。
fn kind_at(a: ptr, s: u32, e: u32) -> u64 {
    let w: u64 = wspan(a, s, e);
    let o: u32 = hi32(w);
    let l: u32 = lo32(w);
    if eqw(a, o, l, "alloca") {
        return (K_ALLOCA as u64) << 32;
    }
    if eqw(a, o, l, "load") {
        return (K_LOAD as u64) << 32;
    }
    if eqw(a, o, l, "store") {
        return (K_STORE as u64) << 32;
    }
    if eqw(a, o, l, "getelementptr") {
        return (K_GEP as u64) << 32;
    }
    if eqw(a, o, l, "extractvalue") {
        return (K_EXTRV as u64) << 32;
    }
    if eqw(a, o, l, "insertvalue") {
        return (K_INSV as u64) << 32;
    }
    if eqw(a, o, l, "icmp") {
        return ((K_ICMP as u64) << 32) | (icmp_pred(a, after_op(a, o, e), e) as u64);
    }
    if eqw(a, o, l, "sdiv") {
        return (K_SDIV as u64) << 32;
    }
    if eqw(a, o, l, "udiv") {
        return (K_UDIV as u64) << 32;
    }
    if eqw(a, o, l, "srem") {
        return (K_SREM as u64) << 32;
    }
    if eqw(a, o, l, "urem") {
        return (K_UREM as u64) << 32;
    }
    if eqw(a, o, l, "add") {
        return (K_ADD as u64) << 32;
    }
    if eqw(a, o, l, "sub") {
        return (K_SUB as u64) << 32;
    }
    if eqw(a, o, l, "mul") {
        return (K_MUL as u64) << 32;
    }
    if eqw(a, o, l, "and") {
        return (K_AND as u64) << 32;
    }
    if eqw(a, o, l, "or") {
        return (K_OR as u64) << 32;
    }
    if eqw(a, o, l, "xor") {
        return (K_XOR as u64) << 32;
    }
    if eqw(a, o, l, "shl") {
        return (K_SHL as u64) << 32;
    }
    if eqw(a, o, l, "lshr") {
        return (K_LSHR as u64) << 32;
    }
    if eqw(a, o, l, "ashr") {
        return (K_ASHR as u64) << 32;
    }
    if eqw(a, o, l, "trunc") {
        return (K_TRUNC as u64) << 32;
    }
    if eqw(a, o, l, "zext") {
        return (K_ZEXT as u64) << 32;
    }
    if eqw(a, o, l, "sext") {
        return (K_SEXT as u64) << 32;
    }
    if eqw(a, o, l, "ptrtoint") {
        return (K_PTRTOINT as u64) << 32;
    }
    if eqw(a, o, l, "inttoptr") {
        return (K_INTTOPTR as u64) << 32;
    }
    if eqw(a, o, l, "unreachable") {
        return (K_UNREACH as u64) << 32;
    }
    if eqw(a, o, l, "phi") {
        return (K_PHI as u64) << 32;
    }
    if eqw(a, o, l, "switch") {
        return (K_SWITCH as u64) << 32;
    }
    if eqw(a, o, l, "ret") {
        return (K_RET as u64) << 32;
    }
    if eqw(a, o, l, "br") {
        let p: u32 = after_op(a, o, e);
        if has_at(a, p, e, "label") {
            return (K_BR_UNCOND as u64) << 32;
        }
        return (K_BR_COND as u64) << 32;
    }
    if eqw(a, o, l, "call") {
        if is_asm_call(a, o, e) {
            return (K_ASMCALL as u64) << 32;
        }
        return (K_CALL as u64) << 32;
    }
    return 0;
}

fn icmp_pred(a: ptr, p: u32, e: u32) -> u32 {
    let s: u64 = wspan(a, p, e);
    let o: u32 = hi32(s);
    let l: u32 = lo32(s);
    if eqw(a, o, l, "eq") {
        return P_EQ;
    }
    if eqw(a, o, l, "ne") {
        return P_NE;
    }
    if eqw(a, o, l, "ugt") {
        return P_UGT;
    }
    if eqw(a, o, l, "uge") {
        return P_UGE;
    }
    if eqw(a, o, l, "ult") {
        return P_ULT;
    }
    if eqw(a, o, l, "ule") {
        return P_ULE;
    }
    if eqw(a, o, l, "sgt") {
        return P_SGT;
    }
    if eqw(a, o, l, "sge") {
        return P_SGE;
    }
    if eqw(a, o, l, "slt") {
        return P_SLT;
    }
    return P_SLE;
}

/// `call <retty> asm sideeffect …` ？跳过返回类型再看下一个词。
fn is_asm_call(a: ptr, s: u32, e: u32) -> bool {
    let p: u32 = after_op(a, s, e);
    if has_at(a, p, e, "void") {
        p = skip_sp(a, p + 4, e);
    } else {
        let ts: u64 = ty_span(a, p, e);
        p = skip_sp(a, hi32(ts) + lo32(ts), e);
    }
    return has_at(a, p, e, "asm");
}

/// 一条记录写进指令表，返回它的下标。
fn put_instr(a: ptr, do_: u32, dl: u32, to: u32, tl: u32, k: u32, sub: u32) -> u32 {
    let ni: u32 = ctx_get(a, C_NI);
    if ni >= MAX_INSTRS {
        fail("指令表满了");
    }
    wr(a, I_OFF, ni * 8, do_);
    wr(a, I_OFF, ni * 8 + 1, dl);
    wr(a, I_OFF, ni * 8 + 2, to);
    wr(a, I_OFF, ni * 8 + 3, tl);
    wr(a, I_OFF, ni * 8 + 4, k);
    wr(a, I_OFF, ni * 8 + 5, sub);
    wr(a, I_OFF, ni * 8 + 6, 0);                     // first_edge（解析收尾时回填）
    wr(a, I_OFF, ni * 8 + 7, 0);                     // nedges
    ctx_set(a, C_NI, ni + 1);
    return ni;
}

fn add_block(a: ptr, lo: u32, ll: u32) -> u32 {
    let nb: u32 = ctx_get(a, C_NB);
    if nb >= MAX_BLOCKS {
        fail("基本块表满了");
    }
    w2(a, B_OFF, nb * 5, lo, ll);
    wr(a, B_OFF, nb * 5 + 2, ctx_get(a, C_NI));   // first_instr（先记，收尾时才知个数）
    wr(a, B_OFF, nb * 5 + 3, 0);
    wr(a, B_OFF, nb * 5 + 4, 0);                     // T1：这一块被进过几次
    ctx_set(a, C_NB, nb + 1);
    return nb;
}

/// 数一段文本里 `label` 出现几次 —— `switch` 的边数靠它（`[...]` 里有几个 `label`
/// 就有几条 case 边，再加上外面那个 default）。
fn count_label(a: ptr, s: u32, e: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = s;
    while i + 5 <= e {
        if same(a, i, str_ptr("label"), 0, 5) {
            n = n + 1;
            i = i + 5;
        } else {
            i = i + 1;
        }
    }
    return n;
}

/// 给一条分支指令分 `n` 行边表，行号记在指令记录里。**O(1) 记账**就靠这个：
/// 运行时记一条边是 `E_OFF + (first_edge + edge) * 4`，不用查表（`docs/247` §4）。
fn edge_alloc(a: ptr, i: u32, n: u32) {
    let base: u32 = ctx_get(a, C_NEDGE);
    if base + n > MAX_EDGES {
        fail("边表满了 —— 抬 MAX_EDGES");
    }
    wr(a, I_OFF, i * 8 + 6, base);
    wr(a, I_OFF, i * 8 + 7, n);
    let k: u32 = 0;
    while k < n {
        wr(a, E_OFF, base + k, 0);
        k = k + 1;
    }
    ctx_set(a, C_NEDGE, base + n);
}

/// 把函数里所有 `br` 的目标标签解析成块号（第二趟）。分支在热路径上，这一步省不得。
/// T1 顺带**给每条分支分边表** —— 同一趟走完，不另开一轮。
fn resolve_brs(a: ptr, fi: u32, tso: u32, tsl: u32) {
    let nt: u32 = ctx_get(a, C_NI);
    let i: u32 = tso;
    while i < tsl {
        let k: u32 = rd(a, I_OFF, i * 8 + 4);
        if k == K_BR_UNCOND || k == K_BR_COND {
            let e: u32 = rd(a, I_OFF, i * 8 + 2) + rd(a, I_OFF, i * 8 + 3);
            let p: u32 = rd(a, I_OFF, i * 8 + 2);
            let sub: u32 = br_sub(a, fi, p, e, k);
            wr(a, I_OFF, i * 8 + 5, sub);
            if k == K_BR_UNCOND {
                edge_alloc(a, i, 1);
            } else {
                edge_alloc(a, i, 2);
            }
        } else if k == K_SWITCH {
            let to: u32 = rd(a, I_OFF, i * 8 + 2);
            let tl: u32 = rd(a, I_OFF, i * 8 + 3);
            edge_alloc(a, i, count_label(a, to, to + tl) + 1);
        }
        i = i + 1;
    }
}

fn br_sub(a: ptr, fi: u32, p: u32, e: u32, k: u32) -> u32 {
    if k == K_BR_UNCOND {
        let lab: u32 = lab_after(a, after_op(a, p, e), e);
        let lw: u64 = wspan(a, lab, e);
        return blk_of(a, fi, hi32(lw), lo32(lw));
    }
    let ts: u64 = ty_span(a, after_op(a, p, e), e);      // i1
    let q: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let qe: u32 = seg_end(a, q, e);
    let lp: u32 = lab_after(a, qe + 1, e);
    let lw: u64 = wspan(a, lp, e);
    let a1: u32 = blk_of(a, fi, hi32(lw), lo32(lw));
    let q2: u32 = seg_next(a, lp + lo32(lw), e);
    let qe2: u32 = seg_end(a, q2, e);
    let lp2: u32 = lab_after(a, q2, e);
    let lw2: u64 = wspan(a, lp2, e);
    let a2: u32 = blk_of(a, fi, hi32(lw2), lo32(lw2));
    return ((a1 & 65535) << 16) | (a2 & 65535);
}

/// `label %foo` 里 `%foo` 的起点（跳过 `label` 与 `%` 与空白）。
fn lab_after(a: ptr, p: u32, e: u32) -> u32 {
    let q: u32 = skip_sp(a, p, e);
    if has_at(a, q, e, "label") {
        q = skip_sp(a, q + 5, e);
    }
    if q < e && load8(a, q) == 37 {
        q = q + 1;
    }
    return q;
}

fn parse_global(a: ptr, s: u32, e: u32) {
    let ng: u32 = ctx_get(a, C_NG);
    if ng >= MAX_GLOBALS {
        fail("全局表满了");
    }
    let nt: u64 = wspan(a, s, e);                        // @name
    let p: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    if p < e && load8(a, p) == 61 {                      // '='
        p = p + 1;
    }
    p = skip_sp(a, p, e);
    // 属性关键字可以叠好几个：一次吃一个，直到吃不动
    let go: u32 = 1;
    while go == 1 {
        if has_at(a, p, e, "private") {
            p = skip_sp(a, p + 7, e);
        } else if has_at(a, p, e, "internal") {
            p = skip_sp(a, p + 8, e);
        } else if has_at(a, p, e, "external") {
            p = skip_sp(a, p + 8, e);
        } else if has_at(a, p, e, "unnamed_addr") {
            p = skip_sp(a, p + 12, e);
        } else if has_at(a, p, e, "dso_local") {
            p = skip_sp(a, p + 9, e);
        } else if has_at(a, p, e, "constant") {
            p = skip_sp(a, p + 8, e);
        } else if has_at(a, p, e, "global") {
            p = skip_sp(a, p + 6, e);
        } else if has_at(a, p, e, "common") {
            p = skip_sp(a, p + 6, e);
        } else {
            go = 0;
        }
    }
    let ts: u64 = ty_span(a, p, e);
    let is: u64 = trim_span(a, hi32(ts) + lo32(ts), e);
    w2(a, G_OFF, ng * 6, hi32(nt), lo32(nt));
    w2(a, G_OFF, ng * 6 + 2, hi32(ts), lo32(ts));
    w2(a, G_OFF, ng * 6 + 4, hi32(is), lo32(is));
    ctx_set(a, C_NG, ng + 1);
}

/// 解析一个函数。`i0` = 函数头之后那一行的起点；返回 `}` 之后那一行的起点。
fn parse_func(a: ptr, s: u32, e: u32, i0: u32, n: u32) -> u32 {
    let nf: u32 = ctx_get(a, C_NF);
    if nf >= MAX_FUNCS {
        fail("函数表满了");
    }
    let p: u32 = after_op(a, s, e);                      // 跳过 "define"
    if has_at(a, p, e, "internal") {
        p = skip_sp(a, p + 8, e);
    } else if has_at(a, p, e, "private") {
        p = skip_sp(a, p + 7, e);
    }
    let rt: u64 = ty_span(a, p, e);
    let np: u32 = skip_sp(a, hi32(rt) + lo32(rt), e);
    let nt: u64 = wspan(a, np, e);                       // @name（**含 @**）
    let op: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    let cp: u32 = 0;
    let pe: u32 = 0;
    if op < e && load8(a, op) == 40 {
        cp = op + 1;
        pe = match_close(a, op, e, 40, 41);
    } else {
        fail("函数头解析失败");
    }
    let first_p: u32 = ctx_get(a, C_NP);
    let count: u32 = 0;
    let q: u32 = skip_sp(a, cp, pe);
    while q < pe {
        let qe: u32 = seg_end(a, q, pe);
        let ts: u64 = ty_span(a, q, qe);
        let ns: u32 = skip_sp(a, hi32(ts) + lo32(ts), qe);
        let ne: u32 = word_end(a, ns, qe);
        if ctx_get(a, C_NP) >= MAX_PARAMS {
            fail("形参表满了");
        }
        w2(a, P_OFF, ctx_get(a, C_NP) * 4, hi32(ts), lo32(ts));
        w2(a, P_OFF, ctx_get(a, C_NP) * 4 + 2, ns, ne - ns);
        ctx_set(a, C_NP, ctx_get(a, C_NP) + 1);
        count = count + 1;
        q = seg_next(a, qe, pe);
    }
    let first_b: u32 = ctx_get(a, C_NB);
    let first_i: u32 = ctx_get(a, C_NI);
    w2(a, F_OFF, nf * 8, hi32(nt), lo32(nt));
    w2(a, F_OFF, nf * 8 + 2, hi32(rt), lo32(rt));
    wr(a, F_OFF, nf * 8 + 4, count);
    wr(a, F_OFF, nf * 8 + 5, first_p);
    wr(a, F_OFF, nf * 8 + 6, first_b);
    wr(a, F_OFF, nf * 8 + 7, 0);
    ctx_set(a, C_NF, nf + 1);

    // ---- 函数体：一行一行走，`}` 收尾
    let cur: u32 = NONE;
    let i: u32 = i0;
    let go: u32 = 1;
    while go == 1 {
        if i >= n {
            go = 0;
        } else {
            let e2: u32 = line_end(a, i, n);
            let s2: u32 = skip_sp(a, i, e2);
            i = e2 + 1;
            if s2 < e2 {
                let c0: u32 = load8(a, s2);
                if c0 == 59 || c0 == 33 {
                    // 注释 / 元数据
                } else if e2 - s2 == 1 && c0 == 125 {
                    go = 0;
                } else {
                    // 指令可能跨行（括号没配平）—— 并到配平为止
                    let e3: u32 = e2;
                    let ok: u32 = 1;
                    while ok == 1 {
                        if unbalanced(a, s2, e3) == false {
                            ok = 0;
                        } else if e3 + 1 >= n {
                            ok = 0;
                        } else {
                            e3 = line_end(a, e3 + 1, n);
                            i = e3 + 1;
                        }
                    }
                    if body_line(a, s2, e3, nf, cur) == 1 {
                        cur = ctx_get(a, C_NB) - 1;
                    }
                }
            }
        }
    }
    // 回填各块的指令条数
    let nb: u32 = ctx_get(a, C_NB) - first_b;
    let k: u32 = 0;
    while k < nb {
        let f: u32 = rd(a, B_OFF, (first_b + k) * 5 + 2);
        let nx: u32 = first_i;
        if k + 1 < nb {
            nx = rd(a, B_OFF, (first_b + k + 1) * 5 + 2);
        } else {
            nx = ctx_get(a, C_NI);
        }
        wr(a, B_OFF, (first_b + k) * 5 + 3, nx - f);
        k = k + 1;
    }
    wr(a, F_OFF, nf * 8 + 7, nb);
    resolve_brs(a, nf, first_i, ctx_get(a, C_NI));
    return i;
}

/// 函数体里的一行：块标签还是指令？返回 1 = 新块。
fn body_line(a: ptr, s: u32, e: u32, nf: u32, cur: u32) -> u32 {
    let last: u32 = e - 1;
    if load8(a, last) == 58 && has_byte(a, s, e, 61) == false {
        // `名称:` —— 块标签
        let lo: u32 = s;
        let ll: u32 = last - s;
        let b: u32 = add_block(a, lo, ll);
        wr(a, B_OFF, b * 5 + 2, ctx_get(a, C_NI));
        return 1;
    }
    let do_: u32 = NONE;
    let dl: u32 = 0;
    let to: u32 = s;
    let tl: u32 = e - s;
    if load8(a, s) == 37 {
        let nt: u64 = wspan(a, s, e);                    // %dest
        do_ = hi32(nt);
        dl = lo32(nt);
        let eq: u32 = index_of(a, do_ + dl, e, 61);      // '='
        to = skip_sp(a, eq + 1, e);
        tl = e - to;
    }
    let k: u64 = kind_at(a, to, e);
    put_instr(a, do_, dl, to, tl, hi32(k), lo32(k));
    return 0;
}

fn parse_all(a: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        let e: u32 = line_end(a, i, n);
        let s: u32 = skip_sp(a, i, e);
        if s < e {
            let c: u32 = load8(a, s);
            if c == 64 {
                parse_global(a, s, e);
                i = e + 1;
            } else if c != 59 && c != 33 && has_at(a, s, e, "define ") {
                i = parse_func(a, s, e, e + 1, n);
            } else {
                i = e + 1;
            }
        } else {
            i = e + 1;
        }
    }
}

// ---------------------------------------------------------------- 全局摆放
//
// 全局初值直接**写进 VM 内存**（不存原始字节），地址记在全局表里 —— 于是 `@name`
// 求值就是一次查表。摆法与参考实现 `_parse_init` 同一套规则（含"值文本前面可能还带着
// 类型"那条：LLVM 的数组元素里就这么印）。

fn init_bytes(a: ptr, m: ptr, s: u32, e: u32, va: u32) {
    let i: u32 = s + 2;                                  // 跳过 `c"`
    let k: u32 = va;
    while i < e && load8(a, i) != 34 {
        let hi: u32 = hexv(load8(a, i + 1));
        let lo: u32 = hexv(load8(a, i + 2));
        store8(m, k, (hi * 16 + lo) as u8);
        i = i + 3;
        k = k + 1;
    }
}

fn init_write(a: ptr, m: ptr, off: u32, len: u32, tyo: u32, tyl: u32, va: u32) -> u32 {
    let e: u32 = off + len;
    let s: u32 = skip_sp(a, off, e);
    if e - s >= 2 && load8(a, s) == 99 && load8(a, s + 1) == 34 {
        init_bytes(a, m, s, e, va);
        return 0;
    }
    if has_at(a, s, e, "zeroinitializer") {
        return 0;                                        // 调用方先清过零
    }
    // 值文本可能还带着类型前缀（数组元素 / 结构体字段常见）
    let vo: u32 = s;
    let ve: u32 = e;
    if e - s >= tyl && same(a, s, a, tyo, tyl) {
        vo = skip_sp(a, s + tyl, e);
    }
    let c: u32 = load8(a, tyo);
    if c == 105 || c == 112 {
        let sz: u32 = ty_size(a, tyo, tyl);
        let v: u64 = dec_u64(a, vo, ve);
        mw(m, va, sz, v);
        return 0;
    }
    let bo: u32 = skip_sp(a, vo, ve);
    let be: u64 = trim_span(a, bo, ve);
    let inner_s: u32 = hi32(be) + 1;
    let inner_e: u32 = hi32(be) + lo32(be) - 1;
    let k: u32 = 0;
    let p: u32 = skip_sp(a, inner_s, inner_e);
    if c == 91 {
        let n: u32 = arr_count(a, tyo, tyl);
        let et: u64 = arr_elem(a, tyo, tyl);
        let esz: u32 = ty_size(a, hi32(et), lo32(et));
        while p < inner_e && k < n {
            let q: u32 = seg_end(a, p, inner_e);
            init_write(a, m, p, q - p, hi32(et), lo32(et), va + k * esz);
            k = k + 1;
            p = seg_next(a, q, inner_e);
        }
        return 0;
    }
    if c == 123 {
        let nf: u32 = fld_count(a, tyo, tyl);
        while p < inner_e && k < nf {
            let q: u32 = seg_end(a, p, inner_e);
            let f: u64 = fld_ty(a, tyo, tyl, k);
            let fo: u32 = fld_off(a, tyo, tyl, k);
            init_write(a, m, p, q - p, hi32(f), lo32(f), va + fo);
            k = k + 1;
            p = seg_next(a, q, inner_e);
        }
        return 0;
    }
    return fail("全局初值 T0 不支持");
}

fn place_globals(a: ptr, m: ptr) {
    let ng: u32 = ctx_get(a, C_NG);
    let i: u32 = 0;
    while i < ng {
        let ts: u64 = r2(a, G_OFF, i * 6 + 2);
        let is: u64 = r2(a, G_OFF, i * 6 + 4);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let al: u32 = 8;
        if sz < 8 {
            al = sz;
        }
        if al < 1 {
            al = 1;
        }
        let va: u32 = vm_alloc(a, sz, al);
        mz(m, va, sz);
        init_write(a, m, hi32(is), lo32(is), hi32(ts), lo32(ts), va);
        wr(a, G_OFF, i * 6 + 4, va);                     // 这一格改存**地址**
        i = i + 1;
    }
}

// ---------------------------------------------------------------- 求值
//
// 值有两种，**用不着标记**：每个使用点的指令文本里写着类型，调用方知道自己要的是哪种。
//   标量 -> 值本身（u64，低位；按宽度截断归 `mask_bits`）
//   聚合 -> 一段**可读地址**（VM 地址），字节就在那儿

fn operand(a: ptr, m: ptr, fr: u32, tyo: u32, tyl: u32, vo: u32, vl: u32) -> u64 {
    if ctx_get(a, C_EXEC) == 1 { ctx_set(a, C_MISS, ctx_get(a, C_MISS) + 1); }
    if vl == 0 {
        wstr(2, "lvm: 操作数缺失 @");
        write_num(a, 2, vo);
        wstr(2, " vl="); write_num(a, 2, vl);
        wstr(2, " 指令: [");
        write_all(2, ptr_add(a, ctx_get(a, 84)), ctx_get(a, 88) as u64);
        wstr(2, "] 前: [");
        write_all(2, ptr_add(a, vo - 24), 24);
        wstr(2, "][");
        write_all(2, ptr_add(a, vo), 24);
        wstr(2, "]
");
        return die(2) as u64;
    }
    let c: u32 = load8(a, vo);
    if c == 37 {                                         // %name
        let i: u32 = vfind(a, m, fr, vo, vl);
        if i == NONE {
            return fail_tok(a, "读未定义的值", vo, vl) as u64;
        }
        return vget(m, fr, i);
    }
    if c == 64 {                                         // @global
        return gaddr(a, vo, vl) as u64;
    }
    if c == 117 || c == 110 {                            // undef / null
        if is_agg(a, tyo, tyl) {
            if ty_size(a, tyo, tyl) > ZERO_CAP {
                return fail_tok(a, "undef 聚合比零页还大:", vo, vl) as u64;
            }
            return ZERO_ADDR as u64;
        }
        return 0;
    }
    if c == 116 {                                        // true
        return 1;
    }
    if c == 102 {                                        // false
        return 0;
    }
    return dec_u64(a, vo, vo + vl);
}

/// 求一段 **`<类型> <值>`** 文本。类型的取舍与 `lomelf.parse_operand` 一致。
fn operand_text(a: ptr, m: ptr, fr: u32, off: u32, n: u32) -> u64 {
    let ts: u64 = ty_span(a, off, n);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), n);
    let vs: u64 = trim_span(a, vo, seg_end(a, vo, n));
    return operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
}

fn bits_of(a: ptr, tyo: u32, tyl: u32) -> u32 {
    return ty_size(a, tyo, tyl) * 8;
}

/// `sdiv`/`udiv`/`srem`/`urem`。**取余要减回去** —— 参考实现第一版只给 `srem` 减了、
/// `urem` 直接返回**商**，症状是"程序跑得完、退出码也对，只是每一位数都是商"。
fn divop(a: ptr, m: ptr, fr: u32, io: u32, il: u32, k: u32) -> u64 {
    let e: u32 = io + il;
    let w: u64 = wspan(a, io, e);
    let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let a1: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p, q)), lo32(trim_span(a, p, q)));
    let p2: u32 = seg_next(a, q, e);
    let a2: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p2, e)), lo32(trim_span(a, p2, e)));
    let bits: u32 = bits_of(a, hi32(ts), lo32(ts));
    let sgn: u32 = 0;
    if k == K_SDIV || k == K_SREM {
        sgn = 1;
    }
    let na: u64 = a1;
    let nb: u64 = a2;
    // ⚠ 这里**不能写 `bool != bool`** —— 自举侧把它的结果发成 `i64`（参考实现发 `i1`），
    // clang 直接拒（`'%t' defined with type 'i1' but expected 'i64'`）。用两个 u32 记符号
    // 就绕开了。**这是自举侧独有的**：参考实现这里发的是 `i1`。见 issue #316。
    let nga: u32 = 0;
    let ngb: u32 = 0;
    if sgn == 1 {
        if (a1 as i64) < 0 {
            na = (0 as u64) - a1;
            nga = 1;
        }
        if (a2 as i64) < 0 {
            nb = (0 as u64) - a2;
            ngb = 1;
        }
    }
    if nb == 0 {
        fail("除以零");
    }
    let qv: u64 = na / nb;
    if sgn == 1 && nga != ngb {
        return mask_bits_for(k, a1, a2, (0 as u64) - qv, bits);
    }
    return mask_bits_for(k, a1, a2, qv, bits);
}

fn mask_bits_for(k: u32, a1: u64, a2: u64, qv: u64, bits: u32) -> u64 {
    if k == K_SREM || k == K_UREM {
        return mask_bits(a1 - (a2 * qv), bits);
    }
    return mask_bits(qv, bits);
}

/// 算术/位运算。`shl`/`lshr`/`ashr` 的移位量 ≥ 位宽时按参考实现的口径收尾
/// （Python 那边是"先移位再截断"，位移 ≥64 得 0 或全 1）。
fn arith(a: ptr, m: ptr, fr: u32, io: u32, il: u32, k: u32) -> u64 {
    let e: u32 = io + il;
    let w: u64 = wspan(a, io, e);
    let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let a1: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p, q)), lo32(trim_span(a, p, q)));
    let p2: u32 = seg_next(a, q, e);
    let a2: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p2, e)), lo32(trim_span(a, p2, e)));
    let bits: u32 = bits_of(a, hi32(ts), lo32(ts));
    // issue #717：移位量按**指令上写的宽度**读成有符号数 —— 负数不是值，是一个错。
    // 参考实现那边抛 `LvmError("移位量是负数")`；这里报同一句话（`fail` 退 2）。
    // 以前 `-1` 在这里是 u64 的最大值，于是静默返回一个值（`ashr` 走符号位那支），
    // 而参考实现抛一条 Python traceback —— 三种实现三种答案。
    if k == K_SHL || k == K_LSHR || k == K_ASHR {
        if (a2 & ((1 as u64) << ((bits - 1) as u64))) != 0 {
            return fail("移位量是负数") as u64;
        }
    }
    if k == K_ASHR {
        return mask_bits(ashr64(a1, a2, bits), bits);
    }
    if (k == K_SHL || k == K_LSHR) && a2 >= 64 {
        return 0;
    }
    let v: u64 = 0;
    if k == K_ADD {
        v = a1 + a2;
    } else if k == K_SUB {
        v = a1 - a2;
    } else if k == K_MUL {
        v = a1 * a2;
    } else if k == K_AND {
        v = a1 & a2;
    } else if k == K_OR {
        v = a1 | a2;
    } else if k == K_XOR {
        v = a1 ^ a2;
    } else if k == K_SHL {
        v = a1 << a2;
    } else {
        v = a1 >> a2;
    }
    return mask_bits(v, bits);
}

fn ashr64(a1: u64, a2: u64, bits: u32) -> u64 {
    let sign: u64 = a1 & (((1 as u64) << ((bits - 1) as u64)));
    if a2 >= 64 {
        if sign != 0 {
            return (0 as u64) - 1;
        }
        return 0;
    }
    let v: u64 = a1 >> a2;
    if sign == 0 {
        return v;
    }
    if a2 == 0 {
        return v;
    }
    if a2 >= (bits as u64) {
        return ((1 as u64) << (bits as u64)) - 1;
    }
    return v | ((((1 as u64) << a2) - 1) << (((bits as u64) - a2)));
}

/// 比较。有符号那四个走"翻符号位再按无符号比"——等价且不用做符号扩展。
fn icmp(a: ptr, m: ptr, fr: u32, io: u32, il: u32, sub: u32) -> u64 {
    let e: u32 = io + il;
    // ⚠ `icmp` 的谓词夹在算子和类型**中间**（`icmp ult i32 %a, %b`）—— 少跳这一格，
    // 类型就读成了 `ult`（`ty_size` 认不出，回落到 8 字节），而**操作数的跨度从
    // `i32 %a` 那个 `i` 起**，于是 `dec_u64` 读出 0：两边都成了常量，循环条件永远为真。
    let w: u64 = wspan(a, io, e);                                  // icmp
    let pd: u64 = wspan(a, hi32(w) + lo32(w), e);                  // 谓词
    let ts: u64 = ty_span(a, hi32(pd) + lo32(pd), e);              // 类型
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let a1: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p, q)), lo32(trim_span(a, p, q)));
    let p2: u32 = seg_next(a, q, e);
    let a2: u64 = operand(a, m, fr, hi32(ts), lo32(ts),
                          hi32(trim_span(a, p2, e)), lo32(trim_span(a, p2, e)));
    let bits: u32 = bits_of(a, hi32(ts), lo32(ts));
    let sm: u64 = (1 as u64) << ((bits - 1) as u64);
    let x: u64 = a1 ^ sm;
    let y: u64 = a2 ^ sm;
    let r: u32 = 0;
    if sub == P_EQ {
        if a1 == a2 {
            r = 1;
        }
    } else if sub == P_NE {
        if a1 != a2 {
            r = 1;
        }
    } else if sub == P_UGT {
        if a1 > a2 {
            r = 1;
        }
    } else if sub == P_UGE {
        if a1 >= a2 {
            r = 1;
        }
    } else if sub == P_ULT {
        if a1 < a2 {
            r = 1;
        }
    } else if sub == P_ULE {
        if a1 <= a2 {
            r = 1;
        }
    } else if sub == P_SGT {
        if x > y {
            r = 1;
        }
    } else if sub == P_SGE {
        if x >= y {
            r = 1;
        }
    } else if sub == P_SLT {
        if x < y {
            r = 1;
        }
    } else if sub == P_SLE {
        if x <= y {
            r = 1;
        }
    }
    return r as u64;
}

fn cast_op(a: ptr, m: ptr, fr: u32, io: u32, il: u32, k: u32) -> u64 {
    let e: u32 = io + il;
    let w: u64 = wspan(a, io, e);                        // 算子（已经知道，跳过）
    let fts: u64 = ty_span(a, hi32(w) + lo32(w), e);
    let p: u32 = skip_sp(a, hi32(fts) + lo32(fts), e);
    // 转型的值后面跟的是 ` to <类型>`，**不是逗号** —— 值记号到空白为止
    // （参考实现的正则是 `(\w+) (\S+) to (\w+)`，`\S+` 就是这个意思）。
    let vs: u64 = trim_span(a, p, word_end(a, p, e));
    let a1: u64 = operand(a, m, fr, hi32(fts), lo32(fts), hi32(vs), lo32(vs));
    if k == K_PTRTOINT || k == K_INTTOPTR {
        return a1;
    }
    if k == K_TRUNC {
        let tw: u64 = wspan(a, index_of(a, hi32(vs) + lo32(vs), e, 116) + 2, e);
        return mask_bits(a1, bits_of(a, hi32(tw), lo32(tw)));
    }
    let fbits: u32 = bits_of(a, hi32(fts), lo32(fts));
    if k == K_ZEXT {
        return mask_bits(a1, fbits);
    }
    // sext：先按源位宽取有符号值，再截到目标位宽
    let tw: u64 = wspan(a, index_of(a, hi32(vs) + lo32(vs), e, 116) + 2, e);
    let tbits: u32 = bits_of(a, hi32(tw), lo32(tw));
    let sv: u64 = a1;
    if fbits < 64 {
        let hi: u64 = sv & (((1 as u64) << ((fbits - 1) as u64)));
        if hi != 0 {
            sv = sv | (((0 as u64) - 1) - ((((1 as u64) << (fbits as u64))) - 1));
        }
    }
    return mask_bits(sv, tbits);
}

/// `getelementptr`。索引的走法与 `lvm.py._gep` **逐条同**：第 0 步是"把指针挪过
/// 整个基类型"，之后数组脱一层、结构体按**字段偏移**（只认常量下标）。
fn gep(a: ptr, m: ptr, fr: u32, io: u32, il: u32) -> u64 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    if has_at(a, p, e, "inbounds") {
        p = skip_sp(a, p + 8, e);
    }
    let ts: u64 = ty_span(a, p, e);
    let cur_o: u32 = hi32(ts);
    let cur_l: u32 = lo32(ts);
    let op: u32 = seg_next(a, cur_o + cur_l, e);
    let base: u64 = operand_text(a, m, fr, op, seg_end(a, op, e));
    let co_o: u32 = cur_o;
    let co_l: u32 = cur_l;
    let acc: u32 = 0;
    let k: u32 = 0;
    let q: u32 = seg_next(a, seg_end(a, op, e), e);
    while q < e {
        let qe: u32 = seg_end(a, q, e);
        let idx: u64 = operand_text(a, m, fr, q, qe);
        if k == 0 {
            acc = acc + (idx as u32) * ty_size(a, co_o, co_l);
        } else if load8(a, co_o) == 91 {
            let et: u64 = arr_elem(a, co_o, co_l);
            co_o = hi32(et);
            co_l = lo32(et);
            acc = acc + (idx as u32) * ty_size(a, co_o, co_l);
        } else if load8(a, co_o) == 123 {
            let f: u64 = fld_ty(a, co_o, co_l, idx as u32);
            acc = acc + fld_off(a, co_o, co_l, idx as u32);
            co_o = hi32(f);
            co_l = lo32(f);
        } else {
            return fail_tok(a, "GEP 的这一步 T0 没实现:", io, il) as u64;
        }
        k = k + 1;
        q = seg_next(a, qe, e);
    }
    return base + (acc as u64);
}

fn extractvalue(a: ptr, m: ptr, fr: u32, io: u32, il: u32, do_: u32, dl: u32) -> u64 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let vs: u64 = trim_span(a, p, q);
    let agg: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
    let p2: u32 = seg_next(a, q, e);
    let idx: u32 = dec_u64(a, p2, seg_end(a, p2, e)) as u32;
    let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
    let fo: u32 = fld_off(a, hi32(ts), lo32(ts), idx);
    let fsz: u32 = ty_size(a, hi32(f), lo32(f));
    if is_agg(a, hi32(f), lo32(f)) {
        let d: u32 = fr_agg(a, m, fr, do_, dl, fsz);
        mc(m, d, (agg as u32) + fo, fsz);
        return (d as u64) | (((fsz as u64)) << 32);
    }
    return mr(m, (agg as u32) + fo, fsz);
}

fn insertvalue(a: ptr, m: ptr, fr: u32, io: u32, il: u32, do_: u32, dl: u32) -> u64 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let bs: u64 = trim_span(a, p, q);
    let base: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(bs), lo32(bs));
    let p2: u32 = seg_next(a, q, e);
    let q2: u32 = seg_end(a, p2, e);
    let val: u64 = operand_text(a, m, fr, p2, q2);
    let p3: u32 = seg_next(a, q2, e);
    let idx: u32 = dec_u64(a, p3, seg_end(a, p3, e)) as u32;
    let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
    let fo: u32 = fld_off(a, hi32(ts), lo32(ts), idx);
    let fsz: u32 = ty_size(a, hi32(f), lo32(f));
    let d: u32 = fr_agg(a, m, fr, do_, dl, sz);
    mc(m, d, base as u32, sz);
    if is_agg(a, hi32(f), lo32(f)) {
        mc(m, d + fo, val as u32, fsz);
    } else {
        mw(m, d + fo, fsz, val);
    }
    return (d as u64) | (((sz as u64)) << 32);
}

/// 被解释程序唯一能出去的门（`docs/243` §3.4）。表里没有的**点名拒**。
/// `openat` 的那个路径**恰好**是 `/proc/self/cmdline` 吗（末尾的 NUL 也要对上）。
fn lit_is_cmdline(m: ptr, p: u32) -> bool {
    if load8(m, p + str_len("/proc/self/cmdline")) != 0 {
        return false;
    }
    return same(m, p, str_ptr("/proc/self/cmdline"), 0, str_len("/proc/self/cmdline"));
}

fn vm_syscall(a: ptr, m: ptr, nr: u64, x1: u64, x2: u64, x3: u64) -> u64 {
    if nr == 0 {                                         // read(fd, buf, count)
        // 解释器**没有真的文件描述符** —— 只认识 257 开的那个合成文件（`docs/243` §3.4）。
        // 别的 fd **点名拒**：VM 里没有文件系统，装作有就是给错答案。
        if x1 != VFD {
            fail("系统调用 read：这个 fd 不是 VM 合成的那一个");
        }
        if ctx_get(a, C_VFD_OPEN) == 0 {
            fail("系统调用 read：合成文件还没打开");
        }
        let rp: u32 = x2 as u32;
        let rw: u32 = x3 as u32;
        let ro: u32 = ctx_get(a, C_ARG0);
        let rk: u32 = ctx_get(a, C_VFD_POS);
        let rl: u32 = ctx_get(a, C_ARG0N) - rk;
        if rw < rl {
            rl = rw;
        }
        if rp + rl > MEM_SIZE {
            fail("系统调用 read：越界");
        }
        let ab: ptr = ptr_add(a, ARGV_OFF);
        let ri: u32 = 0;
        while ri < rl {
            store8(m, rp + ri, load8(ab, ro + rk + ri) as u8);
            ri = ri + 1;
        }
        ctx_set(a, C_VFD_POS, rk + rl);
        return rl as u64;
    }
    if nr == 3 {                                         // close(fd)
        if x1 != VFD {
            fail("系统调用 close：这个 fd 不是 VM 合成的那一个");
        }
        ctx_set(a, C_VFD_OPEN, 0);
        return 0;
    }
    if nr == 1 {                                         // write(fd, buf, count)
        let fd: u64 = x1;
        let buf: u32 = x2 as u32;
        let n: u32 = x3 as u32;
        if buf + n > MEM_SIZE {
            fail("write 越界");
        }
        if fd == 1 || fd == 2 {
            write_all(1, ptr_add(m, buf), n as u64);
        }
        return n as u64;
    }
    if nr == 12 {                                        // brk(addr)
        let want: u32 = x1 as u32;
        let h: u32 = ctx_get(a, C_HEAP);
        if want != 0 && h <= want && want < STACK_LIMIT {
            ctx_set(a, C_HEAP, want);
        }
        return ctx_get(a, C_HEAP) as u64;
    }
    if nr == 39 {                                        // getpid
        // 如实转出去：这是**这台机器的事实**。
        return syscall4(39, 0, 0, 0) as u64;
    }
    if nr == 63 {                                        // uname(struct utsname *p)
        // ⚠ **合成，不转宿主** —— 它描述的是**目标平台**（`docs/243` §3.4）：
        // 宿主是什么都不影响，这里给的就是 `Linux`，判据 A 才有意义。
        let up: u32 = x1 as u32;
        if up + 390 > MEM_SIZE {
            fail("uname 越界");
        }
        mz(m, up, 390);
        store8(m, up, 76 as u8);          // L
        store8(m, up + 1, 105 as u8);     // i
        store8(m, up + 2, 110 as u8);     // n
        store8(m, up + 3, 117 as u8);     // u
        store8(m, up + 4, 120 as u8);     // x
        return 0;
    }
    if nr == 201 {                                       // time(NULL)
        return syscall4(201, 0, 0, 0) as u64;
    }
    // ⚠ 317 在这里**不实现** —— 它在 Linux 上是 `seccomp` 不是 `getrandom`
    // （见 `tools/lvm.py` 同一处的注释，那是判据 A 纠出来的）。
    if nr == 257 {                                       // openat(dirfd, path, flags)
        // **只认识 `/proc/self/cmdline`**，而且给它的是**被解释程序自己的**命令行，
        // 不是解释器的（下面 `run` 里那段）。别的路径**点名拒**（`docs/243` §3.4）。
        if lit_is_cmdline(m, x2 as u32) {
            ctx_set(a, C_VFD_OPEN, 1);
            ctx_set(a, C_VFD_POS, 0);
            return VFD;
        }
        wstr(2, "lvm: openat 只认识 /proc/self/cmdline（被解释程序自己的命令行）\n");
        return die(2) as u64;
    }
    if nr == 60 {                                        // exit(code)
        // ⚠ **退出前先把剖面落盘**。参考那侧靠异常把栈弹干净、由 `run_ir` 收尾再写；
        // 这一侧没有异常 —— 而语料里几乎每一份都是 `_start` 里直接 `exit`，
        // 于是"在 `run` 结尾写"那条路**一次都不会走到**（第一版就是这么空的文件）。
        let pfd: u32 = ctx_get(a, C_PROF_FD);
        if pfd != 0 {
            dump_profile(a, pfd as u64);
        }
        dump_stats(a);
        syscall4(60, x1 & 255, 0, 0);
        return 0;
    }
    wstr(2, "lvm: 系统调用表里没有 ");
    write_num(a, 2, nr as u32);
    wstr(2, "（docs/243 §3.4）
");
    return die(2) as u64;
}

fn do_asm(a: ptr, m: ptr, fr: u32, io: u32, il: u32) -> u64 {
    let e: u32 = io + il;
    let lp: u32 = last_byte(a, io, e, 40);               // 最后一个 '('
    let rp: u32 = last_byte(a, io, e, 41);               // 最后一个 ')'
    if lp == NONE || rp == NONE {
        fail("内联汇编解析不了");
    }
    let p: u32 = skip_sp(a, lp + 1, rp);
    if p >= rp {
        fail("系统调用没有号");
    }
    let q: u32 = seg_end(a, p, rp);
    let nr: u64 = operand_text(a, m, fr, p, q);
    let x1: u64 = 0;
    let x2: u64 = 0;
    let x3: u64 = 0;
    let c1: u32 = seg_next(a, q, rp);
    if c1 < rp {
        let d1: u32 = seg_end(a, c1, rp);
        x1 = operand_text(a, m, fr, c1, d1);
        let c2: u32 = seg_next(a, d1, rp);
        if c2 < rp {
            let d2: u32 = seg_end(a, c2, rp);
            x2 = operand_text(a, m, fr, c2, d2);
            let c3: u32 = seg_next(a, d2, rp);
            if c3 < rp {
                let d3: u32 = seg_end(a, c3, rp);
                x3 = operand_text(a, m, fr, c3, d3);
            }
        }
    }
    return vm_syscall(a, m, nr, x1, x2, x3);
}

/// 一个指令的求值（控制流那五条在 `exec_body` 里就地处理，不走这儿）。
fn eval_instr(a: ptr, m: ptr, fr: u32, cfr: u32, io: u32, il: u32, k: u32, sub: u32,
               do_: u32, dl: u32) -> u64 {
    if k == K_ALLOCA {
        let ts: u64 = ty_span(a, after_op(a, io, io + il), io + il);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let s2: u32 = sz;
        if s2 < 8 {
            return fr_alloc(a, m, fr, 8, 8) as u64;  // 与参考实现的 max(SLOT, size) 同
        }
        return fr_alloc(a, m, fr, sz, 8) as u64;
    }
    if k == K_LOAD {
        let e: u32 = io + il;
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let addr: u64 = operand_text(a, m, fr, p, e);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        if is_agg(a, hi32(ts), lo32(ts)) {
            let d: u32 = fr_agg(a, m, fr, do_, dl, sz);
            mc(m, d, addr as u32, sz);
            return (d as u64) | (((sz as u64)) << 32);
        }
        let lv: u64 = mr(m, addr as u32, sz);
        return lv;
    }
    if k == K_STORE {
        let e: u32 = io + il;
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let vs: u64 = trim_span(a, p, q);
        let val: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let addr: u64 = operand_text(a, m, fr, seg_next(a, q, e), e);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        if is_agg(a, hi32(ts), lo32(ts)) {
            mc(m, addr as u32, val as u32, sz);
        } else {
            mw(m, addr as u32, sz, val);
        }
        return 0;
    }
    if k == K_GEP {
        return gep(a, m, fr, io, il);
    }
    if k == K_EXTRV {
        return extractvalue(a, m, fr, io, il, do_, dl);
    }
    if k == K_INSV {
        return insertvalue(a, m, fr, io, il, do_, dl);
    }
    if k == K_ICMP {
        return icmp(a, m, fr, io, il, sub);
    }
    if k == K_SDIV || k == K_UDIV || k == K_SREM || k == K_UREM {
        return divop(a, m, fr, io, il, k);
    }
    if k >= K_ADD && k <= K_ASHR {
        return arith(a, m, fr, io, il, k);
    }
    if k >= K_TRUNC && k <= K_INTTOPTR {
        return cast_op(a, m, fr, io, il, k);
    }
    if k == K_CALL {
        return do_call(a, m, io, il, fr, do_, dl);
    }
    if k == K_ASMCALL {
        return do_asm(a, m, fr, io, il);
    }
    if k == K_UNREACH {
        fail("执行到 unreachable");
    }
    return fail_tok(a, "这个指令 T0 没实现:", io, il) as u64;
}

fn do_call(a: ptr, m: ptr, io: u32, il: u32, caller: u32, do_: u32, dl: u32) -> u64 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    let p2: u32 = 0;
    if has_at(a, p, e, "void") {
        p2 = skip_sp(a, p + 4, e);
    } else {
        let ts: u64 = ty_span(a, p, e);
        p2 = skip_sp(a, hi32(ts) + lo32(ts), e);
    }
    let nt: u64 = wspan(a, p2, e);                       // @name
    let lp: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    if lp >= e || load8(a, lp) != 40 {
        fail("只认直接调用（间接调用 T0 不支持）");
    }
    let rp: u32 = match_close(a, lp, e, 40, 41);
    let fi: u32 = fn_find(a, hi32(nt), lo32(nt));
    if fi == NONE {
        fail("没有这个函数（extern 不接 FFI —— docs/243 §5）");
    }
    let npar: u32 = rd(a, F_OFF, fi * 8 + 4);
    let fp: u32 = rd(a, F_OFF, fi * 8 + 5);
    let d: u32 = ctx_get(a, C_DEPTH) + 1;
    if d > MAX_DEPTH {
        fail("调用太深");
    }
    ctx_set(a, C_DEPTH, d);
    let fr: u32 = MEM_SIZE - d * FRAME_SIZE;
    wr(m, fr, 0, 0);
    wr(m, fr, 1, FR_SLOTS);
    let ap: u32 = skip_sp(a, lp + 1, rp);
    let k: u32 = 0;
    while k < npar {
        if ap >= rp {
            // issue #716：实参个数与形参不符**是错**，三种实现用同一句话拒。
            fail("实参个数与形参不符");
        }
        let ae: u32 = seg_end(a, ap, rp);
        let pnm: u64 = pspan(a, fp + k, 2);
        let av: u64 = operand_text(a, m, caller, ap, ae);
        vput(a, m, fr, hi32(pnm), lo32(pnm), av);
        ap = seg_next(a, ae, rp);
        k = k + 1;
    }
    // 多出来的实参同样是错（以前这里只是**不读**它们 —— 与参考实现的 `zip` 一样静默）。
    if ap < rp {
        fail("实参个数与形参不符");
    }
    let r: u64 = exec_body(a, m, fi, fr, caller, do_, dl);
    ctx_set(a, C_DEPTH, d - 1);
    return r;
}

/// phi：取**前驱块**那一支。`prev` 是刚跳出来的那一块的块号。
fn phi_of(a: ptr, m: ptr, fr: u32, io: u32, il: u32, prev: u32) -> u64 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let po: u32 = rd(a, B_OFF, prev * 5);
    let pl: u32 = rd(a, B_OFF, prev * 5 + 1);
    let p: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
    let hit: u64 = 0;
    let found: u32 = 0;
    while p < e {
        let pe: u32 = match_close(a, p, e, 91, 93);      // '['
        let co: u32 = last_byte(a, p + 1, pe, 44);       // 里面最后一个逗号
        let lab: u64 = trim_span(a, co + 1, pe);         // `%entry`（**带 %**）
        // ⚠ 块标签表里存的是 `entry`（不带 %），而这里的记号是 `%entry` ——
        // 长度要减掉那一个 `%` 才对得上。第一版直接拿 `lo32(lab) == pl` 比，
        // 永远不等，于是每一个有 phi 的程序都报"没有来自前驱块的入边"。
        if lo32(lab) == pl + 1 && lo32(lab) > 1 {
            if same(a, hi32(lab) + 1, a, po, pl) {
                let vs: u64 = trim_span(a, p + 1, co);
                hit = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
                found = 1;
            }
        }
        p = seg_next(a, pe + 1, e);      // ⚠ 给的是 `]` 的位置，得先跨过它
    }
    if found == 0 {
        fail("phi 没有来自前驱块的入边");
    }
    return hit;
}

/// `switch <ty> <v>, label %d [ <ty> <n>, label %l … ]`。热路径上没有它 ——
/// 目标块用**线性找**（`blk_of`）就够了，语料里一共 3 条。
fn switch_of(a: ptr, m: ptr, fr: u32, io: u32, il: u32, fi: u32) -> u32 {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let vs: u64 = trim_span(a, p, q);
    let v: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
    let bo: u32 = index_of(a, q, e, 91);                 // '['
    let be: u32 = match_close(a, bo, e, 91, 93);
    let dw: u64 = wspan(a, lab_after(a, q + 1, bo), bo);
    let dflt: u32 = blk_of(a, fi, hi32(dw), lo32(dw));
    let cp: u32 = skip_sp(a, bo + 1, be);
    // T1：**default 是最后一条边** —— 边号 = case 的条数（与解析期 `edge_alloc` 给的
    // `nedges = count_label + 1` 对得上）。第一版这里填的是 255 占位，于是 default 那一步
    // 的边号超界、被 `bump_edge` 静默跳过 —— 症状是**少一行**（`score entry 5 1 1`），
    // 而那正是孪生判据逐字节比出来的。
    // ⚠ 计数器**不能叫 `ce`** —— 循环体里已经有一个 `let ce` 是"这一条 case 的结束偏移"，
    // 而这一门**没有块作用域**（`docs/228`）：内层 `let` 会**静默遮住**外层同名变量，
    // 于是 `| ce` 用的是偏移（一个大数），边号超界被 `bump_edge` 跳过 —— 症状是镜像那边
    // **少一行**，而两边的 stdout 一字不差。这一处是孪生判据逐字节比出来的。
    let hit: u32 = (dflt << 16) | count_label(a, bo + 1, be);
    let ek: u32 = 0;
    while cp < be {
        let cty: u64 = ty_span(a, cp, be);
        let cvs: u64 = trim_span(a, hi32(cty) + lo32(cty), seg_end(a, hi32(cty) + lo32(cty), be));
        let ce: u32 = seg_end(a, cp, be);
        let lp: u32 = lab_after(a, ce + 1, be);
        let lw: u64 = wspan(a, lp, be);
        let cv: u64 = dec_u64(a, hi32(cvs), hi32(cvs) + lo32(cvs));
        if mask_bits(v, bits_of(a, hi32(cty), lo32(cty))) == cv {
            hit = (blk_of(a, fi, hi32(lw), lo32(lw)) << 16) | ek;
        }
        ek = ek + 1;
        cp = seg_next(a, lp + lo32(lw), be);
    }
    return hit;
}

/// 跑一个函数体。`fr` = 本帧基址（VM 地址），`cfr` = **调用者**的帧基址（NONE = 没有）。
/// `cfr` 是给聚合返回值用的：被调者的帧下一句就作废，值必须落到调用者那边。
/// 记一次块进入。**关着就一个字节都不写**（`docs/247` 判据 D）。
fn bump_block(a: ptr, bi: u32) {
    if ctx_get(a, C_PROF_FD) != 0 {
        wr(a, B_OFF, bi * 5 + 4, rd(a, B_OFF, bi * 5 + 4) + 1);
    }
}

/// 记一条边。边号由调用点给（`br` 无条件 0 / 条件 0真1假 / `switch` = case 次序，default 在最后）。
fn bump_edge(a: ptr, ii: u32, e: u32) {
    if ctx_get(a, C_PROF_FD) != 0 {
        let fe: u32 = rd(a, I_OFF, ii * 8 + 6);
        let ne: u32 = rd(a, I_OFF, ii * 8 + 7);
        if e < ne {
            wr(a, E_OFF, fe + e, rd(a, E_OFF, fe + e) + 1);
        }
    }
}

fn exec_body(a: ptr, m: ptr, fi: u32, fr: u32, cfr: u32, ro: u32, rl: u32) -> u64 {
    let bi: u32 = rd(a, F_OFF, fi * 8 + 6);
    let prev: u32 = NONE;
    let go: u32 = 1;
    while go == 1 {
        let here: u32 = bi;
        bump_block(a, bi);
        let io: u32 = rd(a, B_OFF, bi * 5 + 2);
        let ni: u32 = rd(a, B_OFF, bi * 5 + 3);
        let j: u32 = 0;
        let jumped: u32 = 0;
        while j < ni && jumped == 0 {
            let ii: u32 = io + j;
            let k: u32 = rd(a, I_OFF, ii * 8 + 4);
            let sub: u32 = rd(a, I_OFF, ii * 8 + 5);
            let to: u32 = rd(a, I_OFF, ii * 8 + 2);
            let tl: u32 = rd(a, I_OFF, ii * 8 + 3);
            let do_: u32 = rd(a, I_OFF, ii * 8);
            let dl: u32 = rd(a, I_OFF, ii * 8 + 1);
            ctx_set(a, 84, to);
            ctx_set(a, 88, tl);
            let ns: u32 = ctx_get(a, C_STEPS) + 1;
            if ns > STEP_CAP {
                wstr(2, "lvm: 执行超过 "); write_num(a, 2, STEP_CAP);
                wstr(2, " 条指令，卡在 ");
                let fno: u32 = rd(a, F_OFF, fi * 8);
                write_all(2, ptr_add(a, fno), rd(a, F_OFF, fi * 8 + 1) as u64);
                wstr(2, " 的 [");
                write_all(2, ptr_add(a, to), tl as u64);
                wstr(2, "]
");
                return die(2) as u64;
            }
            ctx_set(a, C_STEPS, ns);
            if k == K_BR_UNCOND {
                bump_edge(a, ii, 0);
                prev = here;
                bi = sub;
                jumped = 1;
            } else if k == K_BR_COND {
                let e: u32 = to + tl;
                let ts: u64 = ty_span(a, after_op(a, to, e), e);
                let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
                let vs: u64 = trim_span(a, p, seg_end(a, p, e));
                let c: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
                prev = here;
                if c != 0 {
                    bump_edge(a, ii, 0);
                    bi = sub >> 16;
                } else {
                    bump_edge(a, ii, 1);
                    bi = sub & 65535;
                }
                jumped = 1;
            } else if k == K_SWITCH {
                let sv: u32 = switch_of(a, m, fr, to, tl, fi);
                bump_edge(a, ii, sv & 65535);
                prev = here;
                bi = sv >> 16;
                jumped = 1;
            } else if k == K_RET {
                return do_ret(a, m, fr, cfr, to, tl, ro, rl);
            } else if k == K_PHI {
                if dl > 0 {
                    let v: u64 = phi_of(a, m, fr, to, tl, prev);
                    let ex: u32 = vfind(a, m, fr, do_, dl);
                    if ex == NONE {
                        vput(a, m, fr, do_, dl, v);
                    } else {
                        vset(a, m, fr, ex, v);
                    }
                }
            } else {
                let v: u64 = eval_instr(a, m, fr, cfr, to, tl, k, sub, do_, dl);
                if dl > 0 {
                    let ex: u32 = vfind(a, m, fr, do_, dl);
                    if ex == NONE {
                        vput(a, m, fr, do_, dl, v);
                    } else {
                        vset(a, m, fr, ex, v);
                    }
                }
            }
            j = j + 1;
        }
        if jumped == 0 {
            fail("块没有终结指令");
        }
    }
    return 0;
}

fn do_ret(a: ptr, m: ptr, fr: u32, cfr: u32, to: u32, tl: u32, ro: u32, rl: u32) -> u64 {
    let e: u32 = to + tl;
    let p: u32 = after_op(a, to, e);
    if p >= e {
        return 0;                                        // 裸 `ret`
    }
    if has_at(a, p, e, "void") {
        return 0;
    }
    let ts: u64 = ty_span(a, p, e);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
    let vs: u64 = trim_span(a, vo, e);
    if is_agg(a, hi32(ts), lo32(ts)) {
        if cfr == NONE {
            fail("没有调用者的聚合返回值");
        }
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let v: u64 = operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let d: u32 = fr_agg(a, m, cfr, ro, rl, sz);
        mc(m, d, v as u32, sz);
        return (d as u64) | (((sz as u64)) << 32);
    }
    return operand(a, m, fr, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
}

// ---------------------------------------------------------------- T1：剖面（`docs/247`）

fn wlit(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

/// 把输入文本里的一段直接写出去 —— 剖面里的名字/标签就是那一段，不拷贝。
fn wspan_out(fd: u64, a: ptr, off: u32, len: u32) {
    if len > 0 {
        let n: u64 = write_all(fd, ptr_add(a, off), len as u64);
        let _x: u64 = n;
    }
}

/// 调用指令里的被调名（**去掉 `@`**，与参考那侧 `f.name` 同形）。
fn callee_span(a: ptr, to: u32, tl: u32) -> u64 {
    let e: u32 = to + tl;
    let i: u32 = index_of(a, to, e, 64);
    if i == NONE {
        return 0;
    }
    let j: u32 = word_end(a, i + 1, e);
    return (((i + 1) as u64) << 32) | ((j - i - 1) as u64);
}

/// 三个段各走一遍表。**顺序 = 解析顺序**（函数 → 块 → 指令）—— 参考那侧也改成按它走，
/// 两边的产物才逐字节比得了（`docs/247` §4 记了为什么不是按名字排序）。
fn dump_stats(a: ptr) {
    let fd: u32 = ctx_get(a, C_STATS_FD);
    if fd != 0 {
        write_num(a, fd as u64, ctx_get(a, C_MISS));
        wstr(fd as u64, "
");
        syscall4(3, fd as u64, 0, 0);
        ctx_set(a, C_STATS_FD, 0);
    }
}

fn dump_profile(a: ptr, fd: u64) {
    wlit(fd, "# lvm profile v1
");
    wlit(fd, "# site = (function, block, instruction-index-in-block); a block is (function, block)
");
    wlit(fd, "# order = IR parse order (function -> block -> instruction), not sorted by name
");
    wlit(fd, "[blocks]
");
    let fi: u32 = 0;
    while fi < ctx_get(a, C_NF) {
        let no: u32 = rd(a, F_OFF, fi * 8);
        let nl: u32 = rd(a, F_OFF, fi * 8 + 1);
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let b: u32 = 0;
        while b < nb {
            let cnt: u32 = rd(a, B_OFF, (fb + b) * 5 + 4);
            if cnt > 0 {
                wspan_out(fd, a, no + 1, nl - 1);
                wlit(fd, "	");
                wspan_out(fd, a, rd(a, B_OFF, (fb + b) * 5), rd(a, B_OFF, (fb + b) * 5 + 1));
                wlit(fd, "	");
                write_num(a, fd, cnt);
                wlit(fd, "
");
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
    wlit(fd, "[edges]
");
    fi = 0;
    while fi < ctx_get(a, C_NF) {
        let no: u32 = rd(a, F_OFF, fi * 8);
        let nl: u32 = rd(a, F_OFF, fi * 8 + 1);
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let b: u32 = 0;
        while b < nb {
            let bo: u32 = rd(a, B_OFF, (fb + b) * 5);
            let bl: u32 = rd(a, B_OFF, (fb + b) * 5 + 1);
            let io: u32 = rd(a, B_OFF, (fb + b) * 5 + 2);
            let ni: u32 = rd(a, B_OFF, (fb + b) * 5 + 3);
            let j: u32 = 0;
            while j < ni {
                let fe: u32 = rd(a, I_OFF, (io + j) * 8 + 6);
                let ne: u32 = rd(a, I_OFF, (io + j) * 8 + 7);
                let e2: u32 = 0;
                while e2 < ne {
                    let c: u32 = rd(a, E_OFF, fe + e2);
                    if c > 0 {
                        wspan_out(fd, a, no + 1, nl - 1);
                        wlit(fd, "	");
                        wspan_out(fd, a, bo, bl);
                        wlit(fd, "	");
                        write_num(a, fd, j);
                        wlit(fd, "	");
                        write_num(a, fd, e2);
                        wlit(fd, "	");
                        write_num(a, fd, c);
                        wlit(fd, "
");
                    }
                    e2 = e2 + 1;
                }
                j = j + 1;
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
    wlit(fd, "[calls]
");
    fi = 0;
    while fi < ctx_get(a, C_NF) {
        let no: u32 = rd(a, F_OFF, fi * 8);
        let nl: u32 = rd(a, F_OFF, fi * 8 + 1);
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let b: u32 = 0;
        while b < nb {
            let cnt: u32 = rd(a, B_OFF, (fb + b) * 5 + 4);
            if cnt > 0 {
                let bo: u32 = rd(a, B_OFF, (fb + b) * 5);
                let bl: u32 = rd(a, B_OFF, (fb + b) * 5 + 1);
                let io: u32 = rd(a, B_OFF, (fb + b) * 5 + 2);
                let ni: u32 = rd(a, B_OFF, (fb + b) * 5 + 3);
                let j: u32 = 0;
                while j < ni {
                    if rd(a, I_OFF, (io + j) * 8 + 4) == K_CALL {
                        // 一个调用点的次数 = 它所在块的次数（块里每条指令都跟着块走一次）。
                        let cs: u64 = callee_span(a, rd(a, I_OFF, (io + j) * 8 + 2),
                                                  rd(a, I_OFF, (io + j) * 8 + 3));
                        if lo32(cs) > 0 {
                            wspan_out(fd, a, no + 1, nl - 1);
                            wlit(fd, "	");
                            wspan_out(fd, a, bo, bl);
                            wlit(fd, "	");
                            write_num(a, fd, j);
                            wlit(fd, "	");
                            wspan_out(fd, a, hi32(cs), lo32(cs));
                            wlit(fd, "	");
                            write_num(a, fd, cnt);
                            wlit(fd, "
");
                        }
                    }
                    j = j + 1;
                }
            }
            b = b + 1;
        }
        fi = fi + 1;
    }
}

// ---------------------------------------------------------------- 前门

fn write_num(a: ptr, fd: u64, v: u32) -> u64 {
    if v >= 10 {
        write_num(a, fd, v / 10);
    }
    let b: ptr = ptr_add(a, CTX_OFF + 240);
    store8(b, 0, (48 + (v % 10)) as u8);
    return write_all(fd, b, 1);
}

// ---------------------------------------------------------------- T2（docs/259 §7，#586）
//
// 镜像的 T0 在**执行期**重解操作数与类型文本：每个 SSA 操作数一次线性 `vfind`、
// 每指令若干次 `ty_span`/`seg_end`/`seg_next`/`ty_size` 扫描。T2 把这一次解码
// **搬到执行之前**：解析完、全局落位之后，把每条指令的操作数/类型/目标块折成
// 一张编译表，执行期只读表。
//
// **不进紧凑形** —— 镜像是直接吃文本 IR 的，表在每次启动时重建；表只由 IR 决定。

//: 编译表（追加在旧 arena 之后）
//: `const` 只吃字面量（本语言没有常量表达式）—— 下面的算式写在注释里。
const T2_OFF: u32 = 9935104;                   // 旧 ARENA 的末尾
const CC_OFF: u32 = 9935104;                   // T2_OFF；每指令 12 个 u32（48 B）
const COP_OFF: u32 = 11507968;                 // CC_OFF + 32768*48；操作数描述符 4 u32
const CX_OFF: u32 = 13605120;                  // COP_OFF + 131072*16；附加池
const CSL_OFF: u32 = 13867264;                 // CX_OFF + 65536*4；槽名表 2 u32
const FS2_OFF: u32 = 14129408;                 // CSL_OFF + 32768*8；每函数 4 u32
const ARENA_T2: u64 = 14137600;                // FS2_OFF + 512*16

//: 编译记录 12 格
const CR_KIND: u32 = 0;
const CR_SUB: u32 = 1;
const CR_DEST: u32 = 2;                        // 槽号；NONE = 无
const CR_NOPS: u32 = 3;
const CR_OPS: u32 = 4;                         // 操作数池下标
const CR_BITS: u32 = 5;
const CR_SIZE: u32 = 6;
const CR_AUX: u32 = 7;
const CR_AUX2: u32 = 8;
const CR_XB: u32 = 9;                          // 附加池下标
const CR_XN: u32 = 10;
const CR_FLAGS: u32 = 11;                      // 1 = 聚合结果

//: 操作数描述符种类
const CO_SLOT: u32 = 0;                        // a=槽号 b=name_off c=name_len
const CO_IMM: u32 = 1;                         // a=lo b=hi
const CO_ZAGG: u32 = 2;                        // a=size
const CO_GADDR: u32 = 3;                       // a=addr
const K_CERR: u32 = 34;                        // 编译期解不了，执行到才报

//: 格区里 T2 用的几格
const C_TIER: u32 = 128;                       // 1 = T2
const C_CII: u32 = 132;                        // 当前指令下标（编译/执行期）
const C_CFI: u32 = 136;                        // 当前函数下标（编译期）
const C_COMPILE: u32 = 140;                    // 1 = 正在建表
const C_MISS: u32 = 144;                       // 执行期仍发生的文本解码次数
const C_NSLOT: u32 = 148;                      // 槽表已用
const C_NCOP: u32 = 152;                       // 操作数池已用
const C_NCX: u32 = 156;                        // 附加池已用
const C_EXEC: u32 = 160;                       // 1 = 正在执行（计数器只在这段里加）
const C_STATS_FD: u32 = 164;                   // 解码计数写到哪个 fd（0 = 不写）

// ---------------------------------------------------------------- T2：编译表
//
// 表都在 arena 里（`T2_OFF` 之后）。建表在 `place_globals` 之后 —— `@global` 的地址
// 那时才有值（同 `docs/259` §4.3）。

fn t2_cr(a: ptr, ii: u32, f: u32) -> u32 {
    return rd(a, CC_OFF, ii * 12 + f);
}

fn t2_crw(a: ptr, ii: u32, f: u32, v: u32) {
    store32(a, CC_OFF + ii * 48 + f * 4, v);
}

fn t2_copr(a: ptr, i: u32, f: u32) -> u32 {
    return rd(a, COP_OFF, i * 4 + f);
}

fn t2_copw(a: ptr, i: u32, f: u32, v: u32) {
    store32(a, COP_OFF + i * 16 + f * 4, v);
}

fn t2_xr(a: ptr, i: u32) -> u32 {
    return rd(a, CX_OFF, i);
}

fn t2_xw(a: ptr, i: u32, v: u32) {
    store32(a, CX_OFF + i * 4, v);
}

fn t2_fs(a: ptr, fi: u32, f: u32) -> u32 {
    return rd(a, FS2_OFF, fi * 4 + f);
}

fn t2_fsw(a: ptr, fi: u32, f: u32, v: u32) {
    store32(a, FS2_OFF + fi * 16 + f * 4, v);
}

fn t2_slotr(a: ptr, i: u32, f: u32) -> u32 {
    return rd(a, CSL_OFF, i * 2 + f);
}

fn t2_slotw(a: ptr, i: u32, f: u32, v: u32) {
    store32(a, CSL_OFF + i * 8 + f * 4, v);
}

/// 一个函数里按名字找槽；没有就加。**名字是 SSA 名（不带 `%`）**。
fn t2_slot_add(a: ptr, fi: u32, no: u32, nl: u32) -> u32 {
    let s0: u32 = t2_fs(a, fi, 0);
    let n: u32 = t2_fs(a, fi, 1);
    let i: u32 = 0;
    while i < n {
        let idx: u32 = s0 + i;
        let o: u32 = t2_slotr(a, idx, 0);
        let l: u32 = t2_slotr(a, idx, 1);
        if l == nl {
            if same(a, no, a, o, nl) {
                return idx - s0;
            }
        }
        i = i + 1;
    }
    let idx: u32 = ctx_get(a, C_NSLOT);
    if idx >= 32768 {
        fail("T2 槽表满了");
    }
    t2_slotw(a, idx, 0, no);
    t2_slotw(a, idx, 1, nl);
    ctx_set(a, C_NSLOT, idx + 1);
    t2_fsw(a, fi, 1, n + 1);
    return idx - s0;
}

fn t2_slot_find(a: ptr, fi: u32, no: u32, nl: u32) -> u32 {
    let s0: u32 = t2_fs(a, fi, 0);
    let n: u32 = t2_fs(a, fi, 1);
    let i: u32 = 0;
    while i < n {
        let idx: u32 = s0 + i;
        if t2_slotr(a, idx, 1) == nl {
            if same(a, no, a, t2_slotr(a, idx, 0), nl) {
                return idx - s0;
            }
        }
        i = i + 1;
    }
    return NONE;
}

fn t2_cop_add(a: ptr, kind: u32, x: u32, y: u32, z: u32) -> u32 {
    let i: u32 = ctx_get(a, C_NCOP);
    if i >= 131072 {
        fail("T2 操作数池满了");
    }
    t2_copw(a, i, 0, kind);
    t2_copw(a, i, 1, x);
    t2_copw(a, i, 2, y);
    t2_copw(a, i, 3, z);
    ctx_set(a, C_NCOP, i + 1);
    return i;
}

fn t2_x_add(a: ptr, v: u32) -> u32 {
    let i: u32 = ctx_get(a, C_NCX);
    if i >= 65536 {
        fail("T2 附加池满了");
    }
    t2_xw(a, i, v);
    ctx_set(a, C_NCX, i + 1);
    return i;
}

/// 一条 **`<类型> <值>`** 操作数 -> 描述符下标。**编译期做，执行期只读表。**
fn t2_coperand(a: ptr, fi: u32, tyo: u32, tyl: u32, vo: u32, vl: u32) -> u32 {
    if vl == 0 {
        return t2_cop_add(a, CO_IMM, 0, 0, 0);
    }
    let c: u32 = load8(a, vo);
    if c == 37 {                                          // %name
        let s: u32 = t2_slot_add(a, fi, vo, vl);
        return t2_cop_add(a, CO_SLOT, s, vo, vl);
    }
    if c == 64 {                                          // @global
        return t2_cop_add(a, CO_GADDR, gaddr(a, vo, vl), 0, 0);
    }
    if c == 117 || c == 110 {                             // undef / null
        if is_agg(a, tyo, tyl) {
            return t2_cop_add(a, CO_ZAGG, ty_size(a, tyo, tyl), 0, 0);
        }
        return t2_cop_add(a, CO_IMM, 0, 0, 0);
    }
    if c == 116 {                                         // true
        return t2_cop_add(a, CO_IMM, 1, 0, 0);
    }
    if c == 102 {                                         // false
        return t2_cop_add(a, CO_IMM, 0, 0, 0);
    }
    let v: u64 = dec_u64(a, vo, vo + vl);
    return t2_cop_add(a, CO_IMM, lo32(v), hi32(v), 0);
}

fn t2_coperand_text(a: ptr, fi: u32, off: u32, n: u32) -> u32 {
    let ts: u64 = ty_span(a, off, n);
    let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), n);
    let vs: u64 = trim_span(a, vo, seg_end(a, vo, n));
    return t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
}

/// 目标值（`do_/dl`）-> 槽号；没有目标返回 NONE。
fn t2_dest(a: ptr, fi: u32, do_: u32, dl: u32) -> u32 {
    if dl == 0 {
        return NONE;
    }
    return t2_slot_add(a, fi, do_, dl);
}

/// 把一条指令折成编译记录。**解不出来的指令记成 K_CERR**，执行到才报 ——
/// 与 T0 的接受集合保持一致（不可达的坏指令不是错，`docs/259` §4.4）。
fn t2_compile_instr(a: ptr, fi: u32, ii: u32) -> u32 {
    let io: u32 = rd(a, I_OFF, ii * 8 + 2);
    let il: u32 = rd(a, I_OFF, ii * 8 + 3);
    let k: u32 = rd(a, I_OFF, ii * 8 + 4);
    let sub: u32 = rd(a, I_OFF, ii * 8 + 5);
    let do_: u32 = rd(a, I_OFF, ii * 8);
    let dl: u32 = rd(a, I_OFF, ii * 8 + 1);
    let e: u32 = io + il;
    t2_crw(a, ii, CR_KIND, k);
    t2_crw(a, ii, CR_SUB, sub);
    t2_crw(a, ii, CR_DEST, t2_dest(a, fi, do_, dl));
    t2_crw(a, ii, CR_NOPS, 0);
    t2_crw(a, ii, CR_OPS, 0);
    t2_crw(a, ii, CR_BITS, 0);
    t2_crw(a, ii, CR_SIZE, 0);
    t2_crw(a, ii, CR_AUX, 0);
    t2_crw(a, ii, CR_AUX2, 0);
    t2_crw(a, ii, CR_XB, 0);
    t2_crw(a, ii, CR_XN, 0);
    t2_crw(a, ii, CR_FLAGS, 0);

    if k == K_ALLOCA {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        return 0;
    }
    if k == K_LOAD {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        t2_crw(a, ii, CR_OPS, t2_coperand_text(a, fi, p, e));
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        if is_agg(a, hi32(ts), lo32(ts)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    if k == K_STORE {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let vs: u64 = trim_span(a, p, q);
        let vop: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let aop: u32 = t2_coperand_text(a, fi, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, vop);
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_AUX, aop);                       // 第二个操作数（地址）
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        if is_agg(a, hi32(ts), lo32(ts)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    if k == K_GEP {
        t2_compile_gep(a, fi, ii, io, il);
        return 0;
    }
    if k == K_EXTRV {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let vs: u64 = trim_span(a, p, q);
        let op: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let p2: u32 = seg_next(a, q, e);
        let idx: u32 = dec_u64(a, p2, seg_end(a, p2, e)) as u32;
        let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
        t2_crw(a, ii, CR_OPS, op);
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_AUX, fld_off(a, hi32(ts), lo32(ts), idx));
        t2_crw(a, ii, CR_AUX2, ty_size(a, hi32(f), lo32(f)));
        if is_agg(a, hi32(f), lo32(f)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    if k == K_INSV {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let sz: u32 = ty_size(a, hi32(ts), lo32(ts));
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let bs: u64 = trim_span(a, p, q);
        let bop: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(bs), lo32(bs));
        let p2: u32 = seg_next(a, q, e);
        let q2: u32 = seg_end(a, p2, e);
        let vop: u32 = t2_coperand_text(a, fi, p2, q2);
        let p3: u32 = seg_next(a, q2, e);
        let idx: u32 = dec_u64(a, p3, seg_end(a, p3, e)) as u32;
        let f: u64 = fld_ty(a, hi32(ts), lo32(ts), idx);
        t2_crw(a, ii, CR_OPS, bop);
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_SIZE, sz);
        t2_crw(a, ii, CR_AUX, fld_off(a, hi32(ts), lo32(ts), idx));
        t2_crw(a, ii, CR_AUX2, ty_size(a, hi32(f), lo32(f)));
        if is_agg(a, hi32(f), lo32(f)) {
            t2_crw(a, ii, CR_FLAGS, 2);
        }
        return 0;
    }
    if k == K_ICMP {
        let w: u64 = wspan(a, io, e);
        let pd: u64 = wspan(a, hi32(w) + lo32(w), e);
        let ts: u64 = ty_span(a, hi32(pd) + lo32(pd), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let a1: u64 = trim_span(a, p, q);
        let a2: u64 = trim_span(a, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a1), lo32(a1)));
        t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a2), lo32(a2));
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(ts), lo32(ts)) * 8);
        return 0;
    }
    if k == K_SDIV || k == K_UDIV || k == K_SREM || k == K_UREM {
        let w: u64 = wspan(a, io, e);
        let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let a1: u64 = trim_span(a, p, q);
        let a2: u64 = trim_span(a, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a1), lo32(a1)));
        t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a2), lo32(a2));
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(ts), lo32(ts)) * 8);
        return 0;
    }
    if k >= K_ADD && k <= K_ASHR {
        let w: u64 = wspan(a, io, e);
        let ts: u64 = ty_span(a, hi32(w) + lo32(w), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let q: u32 = seg_end(a, p, e);
        let a1: u64 = trim_span(a, p, q);
        let a2: u64 = trim_span(a, seg_next(a, q, e), e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a1), lo32(a1)));
        t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(a2), lo32(a2));
        t2_crw(a, ii, CR_NOPS, 2);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(ts), lo32(ts)) * 8);
        return 0;
    }
    if k >= K_TRUNC && k <= K_INTTOPTR {
        let w: u64 = wspan(a, io, e);
        let fts: u64 = ty_span(a, hi32(w) + lo32(w), e);
        let p: u32 = skip_sp(a, hi32(fts) + lo32(fts), e);
        let vs: u64 = trim_span(a, p, word_end(a, p, e));
        t2_crw(a, ii, CR_OPS, t2_coperand(a, fi, hi32(fts), lo32(fts),
                                          hi32(vs), lo32(vs)));
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_BITS, ty_size(a, hi32(fts), lo32(fts)) * 8);
        if k == K_TRUNC || k == K_SEXT {
            let tw: u64 = wspan(a, index_of(a, hi32(vs) + lo32(vs), e, 116) + 2, e);
            t2_crw(a, ii, CR_AUX, ty_size(a, hi32(tw), lo32(tw)) * 8);
        }
        return 0;
    }
    if k == K_CALL {
        t2_compile_call(a, fi, ii, io, il);
        return 0;
    }
    if k == K_ASMCALL {
        t2_compile_asm(a, fi, ii, io, il);
        return 0;
    }
    if k == K_PHI {
        t2_compile_phi(a, fi, ii, io, il);
        return 0;
    }
    if k == K_BR_COND || k == K_SWITCH || k == K_RET {
        t2_compile_ctrl(a, ii, io, il);
        return 0;
    }
    if k == K_BR_UNCOND || k == K_UNREACH {
        return 0;
    }
    return 0;
}

fn t2_compile_gep(a: ptr, fi: u32, ii: u32, io: u32, il: u32) -> u32 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    if has_at(a, p, e, "inbounds") {
        p = skip_sp(a, p + 8, e);
    }
    let ts: u64 = ty_span(a, p, e);
    let cur_o: u32 = hi32(ts);
    let cur_l: u32 = lo32(ts);
    let op: u32 = seg_next(a, cur_o + cur_l, e);
    let base: u32 = t2_coperand_text(a, fi, op, seg_end(a, op, e));
    t2_crw(a, ii, CR_OPS, base);
    let n: u32 = 1;
    let xb: u32 = ctx_get(a, C_NCX);
    let q: u32 = seg_next(a, seg_end(a, op, e), e);
    let k: u32 = 0;
    while q < e {
        let qe: u32 = seg_end(a, q, e);
        let iop: u32 = t2_coperand_text(a, fi, q, qe);
        if k == 0 {
            t2_x_add(a, 1);
            t2_x_add(a, ty_size(a, cur_o, cur_l));
        } else if load8(a, cur_o) == 91 {
            let et: u64 = arr_elem(a, cur_o, cur_l);
            cur_o = hi32(et);
            cur_l = lo32(et);
            t2_x_add(a, 1);
            t2_x_add(a, ty_size(a, cur_o, cur_l));
        } else if load8(a, cur_o) == 123 {
            let idx: u64 = t2_imm(a, iop);
            if t2_copr(a, iop, 0) != CO_IMM {
                t2_cerr(a, ii, 4, io, il);
                return 0;
            }
            t2_x_add(a, 0);
            t2_x_add(a, fld_off(a, cur_o, cur_l, idx as u32));
            let f: u64 = fld_ty(a, cur_o, cur_l, idx as u32);
            cur_o = hi32(f);
            cur_l = lo32(f);
        } else {
            t2_cerr(a, ii, 4, io, il);
            return 0;
        }
        k = k + 1;
        q = seg_next(a, qe, e);
    }
    t2_crw(a, ii, CR_NOPS, n + k);
    t2_crw(a, ii, CR_XB, xb);
    t2_crw(a, ii, CR_XN, k * 2);
    return 0;
}

fn t2_cerr(a: ptr, ii: u32, code: u32, io: u32, il: u32) {
    t2_crw(a, ii, CR_KIND, 34);                            // K_CERR
    t2_crw(a, ii, CR_AUX, code);
    t2_crw(a, ii, CR_AUX2, io);
    t2_crw(a, ii, CR_SUB, il);
    t2_crw(a, ii, CR_DEST, NONE);
    t2_crw(a, ii, CR_NOPS, 0);
}

fn t2_compile_call(a: ptr, fi: u32, ii: u32, io: u32, il: u32) -> u32 {
    let e: u32 = io + il;
    let p: u32 = after_op(a, io, e);
    let p2: u32 = 0;
    if has_at(a, p, e, "void") {
        p2 = skip_sp(a, p + 4, e);
    } else {
        let ts: u64 = ty_span(a, p, e);
        p2 = skip_sp(a, hi32(ts) + lo32(ts), e);
    }
    let nt: u64 = wspan(a, p2, e);
    let lp: u32 = skip_sp(a, hi32(nt) + lo32(nt), e);
    if lp >= e || load8(a, lp) != 40 {
        t2_cerr(a, ii, 3, io, il);
        return 0;
    }
    let rp: u32 = match_close(a, lp, e, 40, 41);
    let callee: u32 = fn_find(a, hi32(nt), lo32(nt));
    if callee == NONE {
        t2_cerr(a, ii, 2, io, il);
        return 0;
    }
    let npar: u32 = rd(a, F_OFF, callee * 8 + 4);
    let first_op: u32 = ctx_get(a, C_NCOP);
    let ap: u32 = skip_sp(a, lp + 1, rp);
    let n: u32 = 0;
    while ap < rp {
        let ae: u32 = seg_end(a, ap, rp);
        t2_coperand_text(a, fi, ap, ae);
        ap = seg_next(a, ae, rp);
        n = n + 1;
    }
    if n != npar {
        t2_cerr(a, ii, 1, io, il);
        return 0;
    }
    t2_crw(a, ii, CR_OPS, first_op);
    t2_crw(a, ii, CR_NOPS, n);
    t2_crw(a, ii, CR_AUX, npar);
    t2_crw(a, ii, CR_AUX2, callee);
    return 0;
}

fn t2_compile_asm(a: ptr, fi: u32, ii: u32, io: u32, il: u32) -> u32 {
    let e: u32 = io + il;
    let lp: u32 = last_byte(a, io, e, 40);
    let rp: u32 = last_byte(a, io, e, 41);
    if lp == NONE || rp == NONE {
        t2_cerr(a, ii, 7, io, il);
        return 0;
    }
    let p: u32 = skip_sp(a, lp + 1, rp);
    if p >= rp {
        t2_cerr(a, ii, 8, io, il);
        return 0;
    }
    let first_op: u32 = ctx_get(a, C_NCOP);
    let q: u32 = seg_end(a, p, rp);
    t2_coperand_text(a, fi, p, q);
    let n: u32 = 1;
    let c1: u32 = seg_next(a, q, rp);
    if c1 < rp {
        let d1: u32 = seg_end(a, c1, rp);
        t2_coperand_text(a, fi, c1, d1);
        n = n + 1;
        let c2: u32 = seg_next(a, d1, rp);
        if c2 < rp {
            let d2: u32 = seg_end(a, c2, rp);
            t2_coperand_text(a, fi, c2, d2);
            n = n + 1;
            let c3: u32 = seg_next(a, d2, rp);
            if c3 < rp {
                let d3: u32 = seg_end(a, c3, rp);
                t2_coperand_text(a, fi, c3, d3);
                n = n + 1;
            }
        }
    }
    t2_crw(a, ii, CR_OPS, first_op);
    t2_crw(a, ii, CR_NOPS, n);
    return 0;
}

fn t2_compile_phi(a: ptr, fi: u32, ii: u32, io: u32, il: u32) {
    let e: u32 = io + il;
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
    let xb: u32 = ctx_get(a, C_NCX);
    let n: u32 = 0;
    while p < e {
        let pe: u32 = match_close(a, p, e, 91, 93);
        let co: u32 = last_byte(a, p + 1, pe, 44);
        let lab: u64 = trim_span(a, co + 1, pe);
        let vs: u64 = trim_span(a, p + 1, co);
        let op: u32 = t2_coperand(a, fi, hi32(ts), lo32(ts), hi32(vs), lo32(vs));
        let bi: u32 = blk_of(a, fi, hi32(lab) + 1, lo32(lab) - 1);
        t2_x_add(a, bi);
        t2_x_add(a, op);
        n = n + 1;
        p = seg_next(a, pe + 1, e);
    }
    t2_crw(a, ii, CR_XB, xb);
    t2_crw(a, ii, CR_XN, n * 2);
}

fn t2_compile_ctrl(a: ptr, ii: u32, io: u32, il: u32) -> u32 {
    let k: u32 = rd(a, I_OFF, ii * 8 + 4);
    let e: u32 = io + il;
    if k == K_BR_COND {
        let ts: u64 = ty_span(a, after_op(a, io, e), e);
        let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
        let vs: u64 = trim_span(a, p, seg_end(a, p, e));
        // 条件操作数单独存一个池下标：`sub` 里已经有两个块号，放不下。
        t2_crw(a, ii, CR_OPS, t2_coperand(a, ctx_get(a, C_CFI), hi32(ts), lo32(ts),
                                          hi32(vs), lo32(vs)));
        t2_crw(a, ii, CR_NOPS, 1);
        return 0;
    }
    if k == K_RET {
        let p: u32 = after_op(a, io, e);
        if p >= e || has_at(a, p, e, "void") {
            return 0;
        }
        let ts: u64 = ty_span(a, p, e);
        let vo: u32 = skip_sp(a, hi32(ts) + lo32(ts), e);
        let vs: u64 = trim_span(a, vo, e);
        t2_crw(a, ii, CR_OPS, t2_coperand(a, ctx_get(a, C_CFI), hi32(ts), lo32(ts),
                                          hi32(vs), lo32(vs)));
        t2_crw(a, ii, CR_NOPS, 1);
        t2_crw(a, ii, CR_SIZE, ty_size(a, hi32(ts), lo32(ts)));
        if is_agg(a, hi32(ts), lo32(ts)) {
            t2_crw(a, ii, CR_FLAGS, 1);
        }
        return 0;
    }
    // switch
    let ts: u64 = ty_span(a, after_op(a, io, e), e);
    let p: u32 = seg_next(a, hi32(ts) + lo32(ts), e);
    let q: u32 = seg_end(a, p, e);
    let vs: u64 = trim_span(a, p, q);
    t2_crw(a, ii, CR_AUX, t2_coperand(a, ctx_get(a, C_CFI), hi32(ts), lo32(ts),
                                      hi32(vs), lo32(vs)));
    let bo: u32 = index_of(a, q, e, 91);
    let be: u32 = match_close(a, bo, e, 91, 93);
    let dw: u64 = wspan(a, lab_after(a, q + 1, bo), bo);
    let dflt: u32 = blk_of(a, ctx_get(a, C_CFI), hi32(dw), lo32(dw));
    let xb: u32 = ctx_get(a, C_NCX);
    let cp: u32 = skip_sp(a, bo + 1, be);
    let n: u32 = 0;
    while cp < be {
        let cty: u64 = ty_span(a, cp, be);
        let cvs: u64 = trim_span(a, hi32(cty) + lo32(cty),
                                 seg_end(a, hi32(cty) + lo32(cty), be));
        let ce: u32 = seg_end(a, cp, be);
        let lp: u32 = lab_after(a, ce + 1, be);
        let lw: u64 = wspan(a, lp, be);
        let cv: u64 = dec_u64(a, hi32(cvs), hi32(cvs) + lo32(cvs));
        t2_x_add(a, lo32(cv));
        t2_x_add(a, hi32(cv));
        t2_x_add(a, blk_of(a, ctx_get(a, C_CFI), hi32(lw), lo32(lw)));
        t2_x_add(a, ty_size(a, hi32(cty), lo32(cty)) * 8);
        n = n + 1;
        cp = seg_next(a, lp + lo32(lw), be);
    }
    t2_crw(a, ii, CR_XB, xb);
    t2_crw(a, ii, CR_XN, n * 4);
    t2_crw(a, ii, CR_AUX2, dflt);
    return 0;
}

/// 整份程序建表。**必须在 `place_globals` 之后**（`@global` 的地址那时才有）。
fn t2_compile_all(a: ptr) {
    ctx_set(a, C_COMPILE, 1);
    ctx_set(a, C_NSLOT, 0);
    ctx_set(a, C_NCOP, 0);
    ctx_set(a, C_NCX, 0);
    let nf: u32 = ctx_get(a, C_NF);
    let fi: u32 = 0;
    while fi < nf {
        t2_fsw(a, fi, 0, ctx_get(a, C_NSLOT));
        t2_fsw(a, fi, 1, 0);
        ctx_set(a, C_CFI, fi);
        let np: u32 = rd(a, F_OFF, fi * 8 + 4);
        let fp: u32 = rd(a, F_OFF, fi * 8 + 5);
        let k: u32 = 0;
        while k < np {
            let pnm: u64 = pspan(a, fp + k, 2);
            t2_slot_add(a, fi, hi32(pnm), lo32(pnm));
            k = k + 1;
        }
        let fb: u32 = rd(a, F_OFF, fi * 8 + 6);
        let nb: u32 = rd(a, F_OFF, fi * 8 + 7);
        let bi: u32 = 0;
        while bi < nb {
            let ii0: u32 = rd(a, B_OFF, (fb + bi) * 5 + 2);
            let ni: u32 = rd(a, B_OFF, (fb + bi) * 5 + 3);
            let j: u32 = 0;
            while j < ni {
                ctx_set(a, C_CII, ii0 + j);
                t2_compile_instr(a, fi, ii0 + j);
                j = j + 1;
            }
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    ctx_set(a, C_COMPILE, 0);
}

// ---------------------------------------------------------------- T2：执行
//
// 读编译表，**不再读任何操作数/类型文本**。语义与 `exec_body` 逐条对齐；错的时机
// 与错的句子也一样（不可达代码里的坏指令只在执行到时报）。

fn t2_initd(m: ptr, fr: u32, slot: u32) -> bool {
    let b: u32 = load8(m, fr + FR_INIT + slot / 8);
    return (b & ((1 as u32) << (slot % 8))) != 0;
}

fn t2_mark(m: ptr, fr: u32, slot: u32) {
    let p: u32 = fr + FR_INIT + slot / 8;
    let b: u32 = load8(m, p);
    store8(m, p, (b | ((1 as u32) << (slot % 8))) as u8);
}

fn t2_frame_init(a: ptr, m: ptr, fr: u32, fi: u32) {
    let s0: u32 = t2_fs(a, fi, 0);
    let n: u32 = t2_fs(a, fi, 1);
    wr(m, fr, 0, n);
    wr(m, fr, 1, FR_SLOTS);
    mz(m, fr + FR_INIT, 128);
    let i: u32 = 0;
    while i < n {
        let idx: u32 = s0 + i;
        store32(m, fr + FR_VALS + i * VAL_REC, t2_slotr(a, idx, 0));
        store32(m, fr + FR_VALS + i * VAL_REC + 4, t2_slotr(a, idx, 1));
        store32(m, fr + FR_VALS + i * VAL_REC + 8, 0);
        store32(m, fr + FR_VALS + i * VAL_REC + 12, 0);
        i = i + 1;
    }
}

fn t2_setd(a: ptr, m: ptr, fr: u32, slot: u32, v: u64) {
    if slot != NONE {
        vset(a, m, fr, slot, v);
        t2_mark(m, fr, slot);
    }
}

fn t2_imm(a: ptr, i: u32) -> u64 {
    return (t2_copr(a, i, 1) as u64) | ((t2_copr(a, i, 2) as u64) << 32);
}

fn t2_getop(a: ptr, m: ptr, fr: u32, i: u32) -> u64 {
    let kind: u32 = t2_copr(a, i, 0);
    if kind == CO_SLOT {
        let s: u32 = t2_copr(a, i, 1);
        if t2_initd(m, fr, s) == false {
            return fail_tok(a, "读未定义的值", t2_copr(a, i, 2), t2_copr(a, i, 3)) as u64;
        }
        return vget(m, fr, s);
    }
    if kind == CO_IMM {
        return (t2_copr(a, i, 1) as u64) | ((t2_copr(a, i, 2) as u64) << 32);
    }
    if kind == CO_ZAGG {
        return ZERO_ADDR as u64;
    }
    return t2_copr(a, i, 1) as u64;                        // CO_GADDR
}

/// 一个聚合值在**当前帧**里的暂存格（按槽缓存）。与 `fr_agg` 同一套理由：
/// 同名多次执行复用同一格，不是每轮吃一格。
fn t2_fr_agg(a: ptr, m: ptr, fr: u32, slot: u32, size: u32) -> u32 {
    if slot != NONE && t2_initd(m, fr, slot) {
        let v: u64 = vget(m, fr, slot);
        if hi32(v) >= size {
            return lo32(v);
        }
    }
    let d: u32 = fr_alloc(a, m, fr, size, 8);
    t2_setd(a, m, fr, slot, (d as u64) | (((size as u64)) << 32));
    return d;
}

fn t2_arith(k: u32, a1: u64, a2: u64, bits: u32) -> u64 {
    if k == K_SHL || k == K_LSHR || k == K_ASHR {
        if (a2 & ((1 as u64) << ((bits - 1) as u64))) != 0 {
            return fail("移位量是负数") as u64;
        }
    }
    if k == K_ASHR {
        return mask_bits(ashr64(a1, a2, bits), bits);
    }
    if (k == K_SHL || k == K_LSHR) && a2 >= 64 {
        return 0;
    }
    let v: u64 = 0;
    if k == K_ADD {
        v = a1 + a2;
    } else if k == K_SUB {
        v = a1 - a2;
    } else if k == K_MUL {
        v = a1 * a2;
    } else if k == K_AND {
        v = a1 & a2;
    } else if k == K_OR {
        v = a1 | a2;
    } else if k == K_XOR {
        v = a1 ^ a2;
    } else if k == K_SHL {
        v = a1 << a2;
    } else {
        v = a1 >> a2;
    }
    return mask_bits(v, bits);
}

fn t2_div(a: ptr, k: u32, a1: u64, a2: u64, bits: u32) -> u64 {
    let sgn: u32 = 0;
    if k == K_SDIV || k == K_SREM {
        sgn = 1;
    }
    let na: u64 = a1;
    let nb: u64 = a2;
    let nga: u32 = 0;
    let ngb: u32 = 0;
    if sgn == 1 {
        if (a1 as i64) < 0 {
            na = (0 as u64) - a1;
            nga = 1;
        }
        if (a2 as i64) < 0 {
            nb = (0 as u64) - a2;
            ngb = 1;
        }
    }
    if nb == 0 {
        fail("除以零");
    }
    let qv: u64 = na / nb;
    if sgn == 1 && nga != ngb {
        return mask_bits_for(k, a1, a2, (0 as u64) - qv, bits);
    }
    return mask_bits_for(k, a1, a2, qv, bits);
}

fn t2_icmp(sub: u32, a1: u64, a2: u64, bits: u32) -> u64 {
    let sm: u64 = (1 as u64) << ((bits - 1) as u64);
    let x: u64 = a1 ^ sm;
    let y: u64 = a2 ^ sm;
    let r: u32 = 0;
    if sub == P_EQ {
        if a1 == a2 {
            r = 1;
        }
    } else if sub == P_NE {
        if a1 != a2 {
            r = 1;
        }
    } else if sub == P_UGT {
        if a1 > a2 {
            r = 1;
        }
    } else if sub == P_UGE {
        if a1 >= a2 {
            r = 1;
        }
    } else if sub == P_ULT {
        if a1 < a2 {
            r = 1;
        }
    } else if sub == P_ULE {
        if a1 <= a2 {
            r = 1;
        }
    } else if sub == P_SGT {
        if x > y {
            r = 1;
        }
    } else if sub == P_SGE {
        if x >= y {
            r = 1;
        }
    } else if sub == P_SLT {
        if x < y {
            r = 1;
        }
    } else if sub == P_SLE {
        if x <= y {
            r = 1;
        }
    }
    return r as u64;
}

fn t2_cast(k: u32, a1: u64, fbits: u32, tbits: u32) -> u64 {
    if k == K_PTRTOINT || k == K_INTTOPTR {
        return a1;
    }
    if k == K_TRUNC {
        return mask_bits(a1, tbits);
    }
    if k == K_ZEXT {
        return mask_bits(a1, fbits);
    }
    let sv: u64 = a1;
    if fbits < 64 {
        let hi: u64 = sv & (((1 as u64) << ((fbits - 1) as u64)));
        if hi != 0 {
            sv = sv | (((0 as u64) - 1) - ((((1 as u64) << (fbits as u64))) - 1));
        }
    }
    return mask_bits(sv, tbits);
}

fn t2_cerr_msg(a: ptr, code: u32, io: u32, il: u32) -> u64 {
    if code == 1 {
        fail("实参个数与形参不符");
    }
    if code == 2 {
        fail("没有这个函数（extern 不接 FFI —— docs/243 §5）");
    }
    if code == 3 {
        fail("只认直接调用（间接调用 T0 不支持）");
    }
    if code == 4 {
        return fail_tok(a, "GEP 的这一步 T0 没实现:", io, il) as u64;
    }
    if code == 7 {
        fail("内联汇编解析不了");
    }
    if code == 8 {
        fail("系统调用没有号");
    }
    return fail_tok(a, "这个指令 T0 没实现:", io, il) as u64;
}

fn t2_insv(a: ptr, m: ptr, fr: u32, ii: u32, dest: u32, ops: u32) -> u64 {
    let base: u64 = t2_getop(a, m, fr, ops);
    let val: u64 = t2_getop(a, m, fr, ops + 1);
    let sz: u32 = t2_cr(a, ii, CR_SIZE);
    let fo: u32 = t2_cr(a, ii, CR_AUX);
    let fsz: u32 = t2_cr(a, ii, CR_AUX2);
    let d: u32 = t2_fr_agg(a, m, fr, dest, sz);
    mc(m, d, base as u32, sz);
    if (t2_cr(a, ii, CR_FLAGS) & 2) != 0 {
        mc(m, d + fo, val as u32, fsz);
    } else {
        mw(m, d + fo, fsz, val);
    }
    return (d as u64) | (((sz as u64)) << 32);
}

fn t2_eval(a: ptr, m: ptr, fr: u32, cfr: u32, ii: u32) -> u64 {
    let k: u32 = t2_cr(a, ii, CR_KIND);
    let ops: u32 = t2_cr(a, ii, CR_OPS);
    let dest: u32 = t2_cr(a, ii, CR_DEST);
    if k == K_CERR {
        return t2_cerr_msg(a, t2_cr(a, ii, CR_AUX), t2_cr(a, ii, CR_AUX2),
                           t2_cr(a, ii, CR_SUB));
    }
    if k == K_ALLOCA {
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        if sz < 8 {
            return fr_alloc(a, m, fr, 8, 8) as u64;
        }
        return fr_alloc(a, m, fr, sz, 8) as u64;
    }
    if k == K_LOAD {
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        let addr: u64 = t2_getop(a, m, fr, ops);
        if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
            let d: u32 = t2_fr_agg(a, m, fr, dest, sz);
            mc(m, d, addr as u32, sz);
            return (d as u64) | (((sz as u64)) << 32);
        }
        return mr(m, addr as u32, sz);
    }
    if k == K_STORE {
        let v: u64 = t2_getop(a, m, fr, ops);
        let addr: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_AUX));
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
            mc(m, addr as u32, v as u32, sz);
        } else {
            mw(m, addr as u32, sz, v);
        }
        return 0;
    }
    if k == K_GEP {
        let base: u64 = t2_getop(a, m, fr, ops);
        let xb: u32 = t2_cr(a, ii, CR_XB);
        let xn: u32 = t2_cr(a, ii, CR_XN);
        let acc: u32 = 0;
        let s: u32 = 0;
        while s < xn {
            let kind: u32 = t2_xr(a, xb + s);
            let val: u32 = t2_xr(a, xb + s + 1);
            if kind == 1 {
                let idx: u64 = t2_getop(a, m, fr, ops + 1 + s / 2);
                acc = acc + (idx as u32) * val;
            } else {
                acc = acc + val;
            }
            s = s + 2;
        }
        return base + (acc as u64);
    }
    if k == K_EXTRV {
        let agg: u64 = t2_getop(a, m, fr, ops);
        let fo: u32 = t2_cr(a, ii, CR_AUX);
        let fsz: u32 = t2_cr(a, ii, CR_AUX2);
        if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
            let d: u32 = t2_fr_agg(a, m, fr, dest, fsz);
            mc(m, d, (agg as u32) + fo, fsz);
            return (d as u64) | (((fsz as u64)) << 32);
        }
        return mr(m, (agg as u32) + fo, fsz);
    }
    if k == K_INSV {
        return t2_insv(a, m, fr, ii, dest, ops);
    }
    if k == K_ICMP {
        let a1: u64 = t2_getop(a, m, fr, ops);
        let a2: u64 = t2_getop(a, m, fr, ops + 1);
        return t2_icmp(t2_cr(a, ii, CR_SUB), a1, a2, t2_cr(a, ii, CR_BITS));
    }
    if k == K_SDIV || k == K_UDIV || k == K_SREM || k == K_UREM {
        let a1: u64 = t2_getop(a, m, fr, ops);
        let a2: u64 = t2_getop(a, m, fr, ops + 1);
        return t2_div(a, k, a1, a2, t2_cr(a, ii, CR_BITS));
    }
    if k >= K_ADD && k <= K_ASHR {
        let a1: u64 = t2_getop(a, m, fr, ops);
        let a2: u64 = t2_getop(a, m, fr, ops + 1);
        return t2_arith(k, a1, a2, t2_cr(a, ii, CR_BITS));
    }
    if k >= K_TRUNC && k <= K_INTTOPTR {
        let a1: u64 = t2_getop(a, m, fr, ops);
        return t2_cast(k, a1, t2_cr(a, ii, CR_BITS), t2_cr(a, ii, CR_AUX));
    }
    if k == K_CALL {
        return t2_call(a, m, fr, ii);
    }
    if k == K_ASMCALL {
        let n: u32 = t2_cr(a, ii, CR_NOPS);
        let nr: u64 = t2_getop(a, m, fr, ops);
        let x1: u64 = 0;
        let x2: u64 = 0;
        let x3: u64 = 0;
        if n > 1 {
            x1 = t2_getop(a, m, fr, ops + 1);
        }
        if n > 2 {
            x2 = t2_getop(a, m, fr, ops + 2);
        }
        if n > 3 {
            x3 = t2_getop(a, m, fr, ops + 3);
        }
        return vm_syscall(a, m, nr, x1, x2, x3);
    }
    if k == K_UNREACH {
        fail("执行到 unreachable");
    }
    return fail_tok(a, "这个指令 T0 没实现:", rd(a, I_OFF, ii * 8 + 2),
                    rd(a, I_OFF, ii * 8 + 3)) as u64;
}

fn t2_call(a: ptr, m: ptr, fr: u32, ii: u32) -> u64 {
    let callee: u32 = t2_cr(a, ii, CR_AUX2);
    let npar: u32 = t2_cr(a, ii, CR_AUX);
    let ops: u32 = t2_cr(a, ii, CR_OPS);
    let d: u32 = ctx_get(a, C_DEPTH) + 1;
    if d > MAX_DEPTH {
        fail("调用太深");
    }
    ctx_set(a, C_DEPTH, d);
    let nfr: u32 = MEM_SIZE - d * FRAME_SIZE;
    t2_frame_init(a, m, nfr, callee);
    let k: u32 = 0;
    while k < npar {
        let v: u64 = t2_getop(a, m, fr, ops + k);
        if k < t2_fs(a, callee, 1) {
            vset(a, m, nfr, k, v);
            t2_mark(m, nfr, k);
        }
        k = k + 1;
    }
    let r: u64 = t2_exec(a, m, callee, nfr, fr, t2_cr(a, ii, CR_DEST),
                         ctx_get(a, C_CII));
    ctx_set(a, C_DEPTH, d - 1);
    return r;
}

fn t2_ret(a: ptr, m: ptr, fr: u32, cfr: u32, ii: u32, ro: u32, rl: u32) -> u64 {
    let n: u32 = t2_cr(a, ii, CR_NOPS);
    if n == 0 {
        return 0;
    }
    let v: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_OPS));
    if (t2_cr(a, ii, CR_FLAGS) & 1) != 0 {
        if cfr == NONE {
            fail("没有调用者的聚合返回值");
        }
        let sz: u32 = t2_cr(a, ii, CR_SIZE);
        let d: u32 = t2_fr_agg(a, m, cfr, ro, sz);
        mc(m, d, v as u32, sz);
        return (d as u64) | (((sz as u64)) << 32);
    }
    return v;
}

fn t2_exec(a: ptr, m: ptr, fi: u32, fr: u32, cfr: u32, ro: u32, rl: u32) -> u64 {
    let bi: u32 = rd(a, F_OFF, fi * 8 + 6);
    let prev: u32 = NONE;
    let go: u32 = 1;
    while go == 1 {
        let here: u32 = bi;
        bump_block(a, bi);
        let io: u32 = rd(a, B_OFF, bi * 5 + 2);
        let ni: u32 = rd(a, B_OFF, bi * 5 + 3);
        let j: u32 = 0;
        let jumped: u32 = 0;
        while j < ni && jumped == 0 {
            let ii: u32 = io + j;
            ctx_set(a, C_CII, ii);
            let ns: u32 = ctx_get(a, C_STEPS) + 1;
            if ns > STEP_CAP {
                wstr(2, "lvm: 执行超过 "); write_num(a, 2, STEP_CAP);
                wstr(2, " 条指令，卡在 ");
                let fno: u32 = rd(a, F_OFF, fi * 8);
                write_all(2, ptr_add(a, fno), rd(a, F_OFF, fi * 8 + 1) as u64);
                wstr(2, " 的 [");
                let to: u32 = rd(a, I_OFF, ii * 8 + 2);
                write_all(2, ptr_add(a, to), rd(a, I_OFF, ii * 8 + 3) as u64);
                wstr(2, "]\n");
                return die(2) as u64;
            }
            ctx_set(a, C_STEPS, ns);
            let k: u32 = t2_cr(a, ii, CR_KIND);
            if k == K_BR_UNCOND {
                bump_edge(a, ii, 0);
                prev = here;
                bi = t2_cr(a, ii, CR_SUB);
                jumped = 1;
            } else if k == K_BR_COND {
                let c: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_OPS));
                let sub: u32 = t2_cr(a, ii, CR_SUB);
                prev = here;
                if c != 0 {
                    bump_edge(a, ii, 0);
                    bi = sub >> 16;
                } else {
                    bump_edge(a, ii, 1);
                    bi = sub & 65535;
                }
                jumped = 1;
            } else if k == K_SWITCH {
                let v: u64 = t2_getop(a, m, fr, t2_cr(a, ii, CR_AUX));
                let xb: u32 = t2_cr(a, ii, CR_XB);
                let xn: u32 = t2_cr(a, ii, CR_XN);
                let tgt: u32 = t2_cr(a, ii, CR_AUX2);
                let e: u32 = xn / 4;
                let s: u32 = 0;
                while s < xn {
                    let cv: u64 = (t2_xr(a, xb + s) as u64) |
                                  ((t2_xr(a, xb + s + 1) as u64) << 32);
                    let bits: u32 = t2_xr(a, xb + s + 3);
                    if mask_bits(v, bits) == cv {
                        tgt = t2_xr(a, xb + s + 2);
                        e = s / 4;
                        s = xn;
                    } else {
                        s = s + 4;
                    }
                }
                bump_edge(a, ii, e);
                prev = here;
                bi = tgt;
                jumped = 1;
            } else if k == K_RET {
                return t2_ret(a, m, fr, cfr, ii, ro, rl);
            } else if k == K_PHI {
                let xb: u32 = t2_cr(a, ii, CR_XB);
                let xn: u32 = t2_cr(a, ii, CR_XN);
                let s: u32 = 0;
                let hit: u32 = 0;
                let found: u32 = 0;
                while s < xn {
                    if t2_xr(a, xb + s) == prev {
                        hit = t2_xr(a, xb + s + 1);
                        found = 1;
                        s = xn;
                    } else {
                        s = s + 2;
                    }
                }
                if found == 0 {
                    fail("phi 没有来自前驱块的入边");
                }
                t2_setd(a, m, fr, t2_cr(a, ii, CR_DEST), t2_getop(a, m, fr, hit));
            } else {
                let v: u64 = t2_eval(a, m, fr, cfr, ii);
                t2_setd(a, m, fr, t2_cr(a, ii, CR_DEST), v);
            }
            j = j + 1;
        }
        if jumped == 0 {
            fail("块没有终结指令");
        }
    }
    return 0;
}

fn run(a: ptr) -> u32 {
    let m: ptr = ptr_add(a, MEM_OFF);
    let ab: ptr = ptr_add(a, ARGV_OFF);
    let f1: u64 = argv_n(ab, 8192, 1);
    if lo32(f1) == 0 {
        wstr(2, "用法: lvm IN.ll\n");
        return 2;
    }
    // VM 合成的 `/proc/self/cmdline`（`docs/243` §3.4）：**被解释程序自己的**命令行 ——
    // 就是上面那个输入路径，原样。它已经躺在 ARGV 区里了，只要把"起点 + 连同末尾 NUL 的
    // 长度"记下来；末尾那个 NUL 补写一次，好让 `read` 出去的字节数不取决于命令行怎么结尾。
    store8(ab, hi32(f1) + lo32(f1), 0 as u8);
    ctx_set(a, C_ARG0, hi32(f1));
    ctx_set(a, C_ARG0N, lo32(f1) + 1);
    // 路径就在 argv 缓冲里（NUL 结尾），而那个缓冲在输入区**之外** —— 直接用它。
    let n: u64 = read_file(ptr_add(ab, hi32(f1)), a, SRCCAP as u64);
    if n == 0 {
        return fail("读不了输入");
    }
    // T1（`docs/247`）：第二个实参（有的话）= 剖面写到哪个文件。**不给就不记**。
    let f2: u64 = argv_n(ab, 8192, 2);
    if lo32(f2) != 0 {
        // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577，mode 0644 = 420
        let pfd: i64 = syscall4(2, ptr_add(ab, hi32(f2)) as u64, 577, 420);
        if pfd < 0 {
            return fail("写不了剖面文件");
        }
        ctx_set(a, C_PROF_FD, pfd as u32);
    }
    ctx_set(a, C_NSRC, n as u32);
    ctx_set(a, C_HEAP, GLOBAL_BASE);
    ctx_set(a, C_DEPTH, 0);
    parse_all(a, n as u32);
    place_globals(a, m);
    // T2（`docs/259` §7，#586）：第三个实参写 `t2` 就先把操作数/类型折成表再跑。
    let f4: u64 = argv_n(ab, 8192, 4);                   // 可选：把解码计数写到这个文件
    let f3: u64 = argv_n(ab, 8192, 3);
    if lo32(f4) > 0 {
        let sfd: i64 = syscall4(2, ptr_add(ab, hi32(f4)) as u64, 577, 420);
        if sfd >= 0 {
            ctx_set(a, C_STATS_FD, sfd as u32);
        }
    }
    if lo32(f3) > 0 && eqw(ab, hi32(f3), lo32(f3), "t2") {
        ctx_set(a, C_TIER, 1);
        t2_compile_all(a);
    }
    let fi: u32 = fn_find_lit(a, "@_start");
    if fi == NONE {
        return fail("这份 IR 里没有 `_start`");
    }
    ctx_set(a, C_DEPTH, 1);
    ctx_set(a, C_MISS, 0);
    ctx_set(a, C_EXEC, 1);
    let fr: u32 = MEM_SIZE - FRAME_SIZE;
    if ctx_get(a, C_TIER) == 1 {
        t2_frame_init(a, m, fr, fi);
        t2_exec(a, m, fi, fr, NONE, NONE, 0);
    } else {
        wr(m, fr, 0, 0);
        wr(m, fr, 1, FR_SLOTS);
        exec_body(a, m, fi, fr, NONE, 0, 0);
    }
    ctx_set(a, C_EXEC, 0);
    dump_stats(a);
    let pfd2: u32 = ctx_get(a, C_PROF_FD);
    if pfd2 != 0 {
        dump_profile(a, pfd2 as u64);
        syscall4(3, pfd2 as u64, 0, 0);
    }
    return 0;
}

fn _start() -> u32 {
    let a: ptr = sys_alloc(ARENA_T2) as ptr;
    if a as u64 == 0 {
        return fail("oom (brk 失败)");
    }
    return die(run(a) as u64);
}
