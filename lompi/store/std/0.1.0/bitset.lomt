// std/bitset.lomt — 位图 (调用方持有字节缓冲)
//
// 为什么要它: 自举侧的表全是位图与槽表 (docs/158 §7.2 提到"槽表 2048 → 32,768") ——
// 而位运算在那边是手写的。这是它的正式版。
//
// 位序: **最低位在前** —— 位 i 落在字节 i/8 的第 (i%8) 位。与 x86 的 `bt` 指令、
// 以及"从左到右数"的直觉都不同, 所以写死在注释里: 下标 0 是首字节的最低位。
//
// `bitset_or` / `bitset_and` 是按**整字节**做的: n 不是 8 的倍数时, 末字节里
// 超出 n 的那几位也会被一起算上。缓冲本来就按字节分配, 所以这不越界;
// 但调用方不该指望末字节的高位有意义。
//
// 命名: 公开一律 bitset_*, 内部一律 bse_*。自检 test_bitset_*。

module bitset

/// 找不到的哨兵。
pub const BITSET_NONE: u32 = 4294967295;

/// n 位需要多少字节。
pub fn bitset_bytes(n: u32) -> u32 {
    return (n + 7) / 8;
}

/// 清空 (把需要的字节全置 0)。
pub fn bitset_clear(base: ptr, n: u32) {
    let nb: u32 = bitset_bytes(n);
    let i: u32 = 0;
    while i < nb {
        store8(base, i, 0 as u8);
        i = i + 1;
    }
}

pub fn bitset_set(base: ptr, i: u32) {
    let byte: u32 = i / 8;
    let b: u32 = load8(base, byte);
    store8(base, byte, (b | (1 << (i % 8))) as u8);
}

pub fn bitset_clr(base: ptr, i: u32) {
    let byte: u32 = i / 8;
    let b: u32 = load8(base, byte);
    store8(base, byte, (b & (255 - (1 << (i % 8)))) as u8);
}

pub fn bitset_get(base: ptr, i: u32) -> bool {
    let byte: u32 = i / 8;
    return (load8(base, byte) & (1 << (i % 8))) != 0;
}

/// 置位个数。
pub fn bitset_count(base: ptr, n: u32) -> u32 {
    let c: u32 = 0;
    let i: u32 = 0;
    while i < n {
        if bitset_get(base, i) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

/// 第一个置位的下标; 没有返回 BITSET_NONE。
pub fn bitset_first(base: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if bitset_get(base, i) {
            return i;
        }
        i = i + 1;
    }
    return BITSET_NONE;
}

/// 第一个**未**置位的下标 (分配空位用); 全满返回 BITSET_NONE。
pub fn bitset_first_zero(base: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        if bitset_get(base, i) == false {
            return i;
        }
        i = i + 1;
    }
    return BITSET_NONE;
}

/// 把 [lo, lo+cnt) 全置位。
pub fn bitset_set_range(base: ptr, lo: u32, cnt: u32) {
    let i: u32 = 0;
    while i < cnt {
        bitset_set(base, lo + i);
        i = i + 1;
    }
}

/// 清掉 [lo, lo+cnt)。
pub fn bitset_clr_range(base: ptr, lo: u32, cnt: u32) {
    let i: u32 = 0;
    while i < cnt {
        bitset_clr(base, lo + i);
        i = i + 1;
    }
}

/// dst |= src (按字节, 共 n 位所需的字节数)。
pub fn bitset_or(dst: ptr, src: ptr, n: u32) {
    let nb: u32 = bitset_bytes(n);
    let i: u32 = 0;
    while i < nb {
        store8(dst, i, (load8(dst, i) | load8(src, i)) as u8);
        i = i + 1;
    }
}

/// dst &= src (按字节)。
pub fn bitset_and(dst: ptr, src: ptr, n: u32) {
    let nb: u32 = bitset_bytes(n);
    let i: u32 = 0;
    while i < nb {
        store8(dst, i, (load8(dst, i) & load8(src, i)) as u8);
        i = i + 1;
    }
}

/// 两个位图是否完全相同 (按字节)。
pub fn bitset_eq(a: ptr, b: ptr, n: u32) -> bool {
    let nb: u32 = bitset_bytes(n);
    let i: u32 = 0;
    while i < nb {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------- 自检

fn test_bitset_bytes() -> bool {
    return bitset_bytes(0) == 0 && bitset_bytes(1) == 1 && bitset_bytes(8) == 1
        && bitset_bytes(9) == 2 && bitset_bytes(64) == 8;
}

fn test_bitset_set_get() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set(b, 3);
    return bitset_get(b, 3) && !bitset_get(b, 2) && !bitset_get(b, 4);
}

fn test_bitset_bit_order_low_first() -> bool {
    // 下标 0 是首字节的**最低位** —— 这条把位序钉死。
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set(b, 0);
    return load8(b, 0) == 1 && bitset_get(b, 0);
}

fn test_bitset_byte_boundary() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set(b, 7);
    bitset_set(b, 8);
    return load8(b, 0) == 128 && load8(b, 1) == 1 && bitset_get(b, 7) && bitset_get(b, 8);
}

fn test_bitset_clr() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set(b, 5);
    bitset_clr(b, 5);
    return !bitset_get(b, 5) && load8(b, 0) == 0;
}

fn test_bitset_count() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set(b, 1);
    bitset_set(b, 9);
    bitset_set(b, 15);
    return bitset_count(b, 16) == 3 && bitset_count(b, 1) == 0;
}

fn test_bitset_first_and_first_zero() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set(b, 2);
    bitset_set(b, 6);
    return bitset_first(b, 16) == 2 && bitset_first_zero(b, 16) == 0;
}

fn test_bitset_first_none_when_empty() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    return bitset_first(b, 16) == BITSET_NONE;
}

fn test_bitset_first_zero_none_when_full() -> bool {
    let b: ptr = alloc(16);
    bitset_set_range(b, 0, 8);
    return bitset_first_zero(b, 8) == BITSET_NONE && bitset_first_zero(b, 16) == 8;
}

fn test_bitset_set_range_and_clr_range() -> bool {
    let b: ptr = alloc(16);
    bitset_clear(b, 16);
    bitset_set_range(b, 4, 3);
    let ok: bool = bitset_count(b, 16) == 3 && bitset_get(b, 4) && bitset_get(b, 6);
    bitset_clr_range(b, 4, 3);
    return ok && bitset_count(b, 16) == 0;
}

fn test_bitset_or_and() -> bool {
    let a: ptr = alloc(16);
    let c: ptr = alloc(16);
    bitset_clear(a, 8);
    bitset_clear(c, 8);
    bitset_set(a, 0);
    bitset_set(c, 1);
    bitset_or(a, c, 8);
    let or_ok: bool = bitset_get(a, 0) && bitset_get(a, 1) && bitset_count(a, 8) == 2;
    bitset_clr(c, 1);
    bitset_clr(c, 0);
    bitset_set(c, 0);
    bitset_and(a, c, 8);
    let and_ok: bool = bitset_get(a, 0) && !bitset_get(a, 1) && bitset_count(a, 8) == 1;
    return or_ok && and_ok;
}

fn test_bitset_eq() -> bool {
    let a: ptr = alloc(16);
    let c: ptr = alloc(16);
    bitset_clear(a, 8);
    bitset_clear(c, 8);
    let same: bool = bitset_eq(a, c, 8);
    bitset_set(c, 2);
    return same && !bitset_eq(a, c, 8);
}

fn test_bitset_tracks_arena_slots() -> bool {
    // 典型用法: 在一段槽位里找第一个空槽 (自举侧的表就是这个形状)。
    let b: ptr = alloc(16);
    bitset_clear(b, 32);
    bitset_set(b, 0);
    bitset_set(b, 1);
    let slot: u32 = bitset_first_zero(b, 32);
    bitset_set(b, slot);
    return slot == 2 && bitset_count(b, 32) == 3;
}
