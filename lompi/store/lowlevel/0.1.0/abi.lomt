// lowlevel/abi.lomt — C ABI：类型大小/对齐、结构体布局、SysV x86-64 参数寄存器
//
// 为什么标准库要有它: 写 FFI、生成目标文件、读调试信息时，"这个类型几个字节、
// 下一个字段从哪儿开始"是最常查、最容易记错的一组数（LP64 下 `long` 是 8，
// Windows LLP64 下是 4；`long double` 是 16 且对齐 16）。把口径写死在一处，
// 好过每个调用点自己记。
//
// 口径: **Linux x86-64（LP64）**。Windows 的 LLP64 只差 `long`/`unsigned long`
// （那里是 4）；本模块给的是 Linux 那一套，文件里明确写出来，不猜平台。
//
// 不做的: 位域、packed 属性、联合体、C++ 的 Itanium ABI（虚表/异常）—— 那些是
// 编译器前端的事；这一层是"普通 C 结构体"的布局。
//
// 命名: 公开 abi_*, 内部 ab_*。自检 test_abi_*。

module abi
choose runtime

use mem

pub const ABI_ERR: u32 = 4294967295;

/// 常见 C 类型的大小（LP64）。
pub fn abi_size_of(name: str) -> u32 {
    if str_eq(name, "char") || str_eq(name, "signed char") || str_eq(name, "unsigned char") {
        return 1;
    }
    if str_eq(name, "short") || str_eq(name, "unsigned short") || str_eq(name, "short int") {
        return 2;
    }
    if str_eq(name, "int") || str_eq(name, "unsigned int") || str_eq(name, "unsigned") {
        return 4;
    }
    if str_eq(name, "long") || str_eq(name, "unsigned long")
        || str_eq(name, "long long") || str_eq(name, "unsigned long long")
        || str_eq(name, "long int") || str_eq(name, "size_t") || str_eq(name, "ssize_t")
        || str_eq(name, "intptr_t") || str_eq(name, "uintptr_t") || str_eq(name, "ptrdiff_t")
        || str_eq(name, "void*") || str_eq(name, "char*") || str_eq(name, "int*") {
        return 8;
    }
    if str_eq(name, "float") { return 4; }
    if str_eq(name, "double") { return 8; }
    if str_eq(name, "long double") { return 16; }
    if str_eq(name, "int8_t") || str_eq(name, "uint8_t") { return 1; }
    if str_eq(name, "int16_t") || str_eq(name, "uint16_t") { return 2; }
    if str_eq(name, "int32_t") || str_eq(name, "uint32_t") { return 4; }
    if str_eq(name, "int64_t") || str_eq(name, "uint64_t") { return 8; }
    return ABI_ERR;
}

/// 对齐（对普通标量，等于大小；`long double` 是 16）。
pub fn abi_align_of(name: str) -> u32 {
    let s: u32 = abi_size_of(name);
    return s;
}

pub fn abi_align_up(n: u32, align: u32) -> u32 {
    if align == 0 {
        return n;
    }
    let r: u32 = n % align;
    if r == 0 {
        return n;
    }
    return n + (align - r);
}

/// 按 C 规则排布 n 个字段：`sizes`/`aligns` 是 n 个 u32，`offsets` 收到 n 个 u32。
/// 返回结构体总大小（含尾部 padding）。
pub fn abi_layout(sizes: ptr, aligns: ptr, n: u32, offsets: ptr) -> u32 {
    let cur: u32 = 0;
    let maxa: u32 = 1;
    let i: u32 = 0;
    while i < n {
        let a: u32 = mem_load32(aligns, i * 4);
        let s: u32 = mem_load32(sizes, i * 4);
        let aa: u32 = 1;
        if a > 0 {
            aa = a;
        }
        cur = abi_align_up(cur, aa);
        mem_store32(offsets, i * 4, cur);
        cur = cur + s;
        if aa > maxa {
            maxa = aa;
        }
        i = i + 1;
    }
    return abi_align_up(cur, maxa);
}

/// SysV x86-64 第 i 个**整数**参数用的寄存器编号：0 rdi、1 rsi、2 rdx、3 rcx、
/// 4 r8、5 r9；超出返回 ABI_ERR（走栈）。
pub fn abi_sysv_int_reg(i: u32) -> u32 {
    if i < 6 {
        return i;
    }
    return ABI_ERR;
}

/// 第 i 个**浮点**参数用的寄存器编号（0..7 = xmm0..xmm7）；超出返回 ABI_ERR。
pub fn abi_sysv_float_reg(i: u32) -> u32 {
    if i < 8 {
        return i;
    }
    return ABI_ERR;
}

/// 整数参数溢出到栈之后的偏移（第 7 个起，从 8(%rsp) 开始，每 8 字节一格）。
pub fn abi_stack_arg_offset(i: u32) -> u32 {
    if i < 6 {
        return ABI_ERR;
    }
    return 8 + (i - 6) * 8;
}

// ---------------------------------------------------------------- 自检

fn test_abi_sizes() -> bool {
    return abi_size_of("char") == 1 && abi_size_of("int") == 4
        && abi_size_of("long") == 8 && abi_size_of("double") == 8
        && abi_size_of("long double") == 16 && abi_size_of("void*") == 8
        && abi_size_of("nope") == ABI_ERR;
}

fn test_abi_layout() -> bool {
    // struct { char a; int b; double c; } -> offsets 0,4,8; size 16
    let sizes: ptr = alloc(12);
    let aligns: ptr = alloc(12);
    let offs: ptr = alloc(12);
    mem_store32(sizes, 0, 1);
    mem_store32(sizes, 4, 4);
    mem_store32(sizes, 8, 8);
    mem_store32(aligns, 0, 1);
    mem_store32(aligns, 4, 4);
    mem_store32(aligns, 8, 8);
    let sz: u32 = abi_layout(sizes, aligns, 3, offs);
    return sz == 16 && mem_load32(offs, 0) == 0
        && mem_load32(offs, 4) == 4 && mem_load32(offs, 8) == 8;
}

fn test_abi_regs() -> bool {
    return abi_sysv_int_reg(0) == 0 && abi_sysv_int_reg(5) == 5
        && abi_sysv_int_reg(6) == ABI_ERR && abi_sysv_float_reg(7) == 7
        && abi_stack_arg_offset(6) == 8 && abi_stack_arg_offset(7) == 16;
}
