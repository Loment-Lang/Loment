            let c1: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let c2: u32 = arg1(s, out, src, toks, c1, lvl + 1);
            emit_str(s, out, "  ");
            let ap: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0\n  ");
            let al: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 1\n  ");
            let bp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0\n  ");
            let bl: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1\n  ");
            let nn: u32 = new_temp(s, out);
            emit_str(s, out, " = add i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ", %t");
            emit_dec(s, out, bl);
            emit_str(s, out, "\n  ");
            let nu: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i64 %t");
            emit_dec(s, out, nn);
            emit_str(s, out, " to i32\n");
            set_temp_val(s, lvl + 2, nu);          // 堆计数是 u32
            let cp: u32 = emit_alloc_seq(s, out, src, toks, lvl + 2, lvl, j);
            emit_str(s, out, "  call void @__loment_memcpy(ptr %t");
            emit_dec(s, out, cp);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, ap);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ")\n  ");
            let cg: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i8, ptr %t");
            emit_dec(s, out, cp);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, "\n  call void @__loment_memcpy(ptr %t");
            emit_dec(s, out, cg);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, bp);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, bl);
            emit_str(s, out, ")\n  ");
            let cv1: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
            emit_dec(s, out, cp);
            emit_str(s, out, ", 0\n  ");
            let cv2: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue { ptr, i64 } %t");
            emit_dec(s, out, cv1);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, nn);
            emit_str(s, out, ", 1\n");
            set_temp_val(s, lvl, cv2);
            if tok_is(src, toks, c2 + 1, "as") {
                apply_cast(s, out, src, toks, 0, c2 + 2, lvl);
                return c2 + 3;
            }
            return c2 + 1;
        }
        if tok_is(src, toks, j, "str_eq") {   // 先比长度再 memcmp (bool + phi)
            let k15: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let k16: u32 = arg1(s, out, src, toks, k15, lvl + 1);
            let ap: u32 = alloc_temp(s);
            let al: u32 = alloc_temp(s);
            let bp: u32 = alloc_temp(s);
            let bl: u32 = alloc_temp(s);
            let le: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, ap);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 0
  %t");
            emit_dec(s, out, al);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", 1
  %t");
            emit_dec(s, out, bp);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0
  %t");
            emit_dec(s, out, bl);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1
  %t");
            emit_dec(s, out, le);
            emit_str(s, out, " = icmp eq i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ", %t");
            emit_dec(s, out, bl);
            emit_str(s, out, "
");
            let wq: u32 = load32(s, 480) + 1;
            store32(s, 480, wq + 2);
            emit_str(s, out, "  br i1 %t");
            emit_dec(s, out, le);
            emit_str(s, out, ", label ");
            lab_ref(s, out, wq, "seq");
            emit_str(s, out, ", label ");
            lab_ref(s, out, wq + 1, "sneq");
            emit_str(s, out, "
");
            store32(s, 476, 1);
            lab_def(s, out, wq, "seq");
            let mc: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, mc);
            emit_str(s, out, " = call i32 @__loment_memcmp(ptr %t");
            emit_dec(s, out, ap);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, bp);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, al);
            emit_str(s, out, ")
");
            let zq: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, zq);
            emit_str(s, out, " = icmp eq i32 %t");
            emit_dec(s, out, mc);
            emit_str(s, out, ", 0
");
            jump(s, out, wq + 2, "send");
            lab_def(s, out, wq + 1, "sneq");
            jump(s, out, wq + 2, "send");
            lab_def(s, out, wq + 2, "send");
            let rq: u32 = alloc_temp(s);
            emit_str(s, out, "  %t");
            emit_dec(s, out, rq);
            emit_str(s, out, " = phi i1 [ %t");
            emit_dec(s, out, zq);
            emit_str(s, out, ", ");
            lab_ref(s, out, wq, "seq");
            emit_str(s, out, " ], [ false, ");
            lab_ref(s, out, wq + 1, "sneq");
            emit_str(s, out, " ]
");
            set_temp_val(s, lvl, rq);
            if tok_is(src, toks, k16 + 1, "as") {
                apply_cast_b(s, out, src, toks, 6, 0, k16 + 2, lvl);
                return k16 + 3;
            }
            return k16 + 1;
        }
        if tok_is(src, toks, j, "thread_spawn") {   // M84: 真线程 (docs/245)
            // **入口名不当表达式求值**: 它是编译期的名字, 参考实现也只取字面量正文
            // (`e.args[0].value`)。走 `arg1` 的话会顺手发一个字符串全局 —— 而这个实参
            // 在产物里根本不出现。所以直接跳过 `thread_spawn` `(` 字面量 `,` 这四个 token,
            // 从第 2 个实参 (j + 4) 开始求值。
            // 求值序是**从左到右** (栈顶, 再实参) —— 参考侧同序, 临时值编号才对得上。
            let k2: u32 = arg1(s, out, src, toks, j + 4, lvl + 2);   // 栈顶
            let k3: u32 = arg1(s, out, src, toks, k2, lvl + 3);      // 子线程实参
            let k4: u32 = arg1(s, out, src, toks, k3, lvl + 4);      // 完成通知地址
            // `#778`：在 `clone` 之前把"这台进程起过线程"记下来（参考侧同一顺序）。
            emit_str(s, out, "  store i32 1, ptr @__loment_rt_threads\n");
            emit_str(s, out, "  ");
            let sc: u32 = new_temp(s, out);
            emit_str(s, out, " = call i64 asm sideeffect \"thread_spawn @");
            emit_mem(s, out, src, load32(toks, (j + 2) * 20 + 4) + 1,
                     load32(toks, (j + 2) * 20 + 8) - 2);
            emit_str(s, out, "\", \"={ax},{si},{r9},{r12},~{di},~{dx},~{r10},~{r8},~{cx},~{r11},~{memory}\"(");
            emit_str(s, out, "i64 ");
            emit_val(s, out, lvl + 2);
            emit_str(s, out, ", i64 ");
            emit_val(s, out, lvl + 3);
            emit_str(s, out, ", i64 ");
            emit_val(s, out, lvl + 4);
            emit_str(s, out, ")
");
            set_temp_val(s, lvl, sc);
            return k4;
        }
        if tok_is(src, toks, j, "syscall4") || tok_is(src, toks, j, "syscall6")
            || tok_is(src, toks, j, "syscall7") {   // M67/M72/M72+
            let n6: u32 = tok_is(src, toks, j, "syscall6") as u32;
            let n7: u32 = tok_is(src, toks, j, "syscall7") as u32;
            let na: u32 = 4;
            if n6 == 1 {
                na = 6;
            }
            if n7 == 1 {
                na = 7;
            }
            let ka: u32 = j + 2;
            let a0: u32 = 0;
            while a0 < na {
                ka = arg1(s, out, src, toks, ka, lvl + 1 + a0);
                a0 = a0 + 1;
            }
            emit_str(s, out, "  ");
            let sc: u32 = new_temp(s, out);
            emit_str(s, out, " = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx}");
            if n6 == 1 {
                emit_str(s, out, ",{r10},{r8}");
            }
            if n7 == 1 {
                emit_str(s, out, ",{r10},{r8},{r9}");
            }
            emit_str(s, out, ",~{cx},~{r11},~{memory}\"(");
            let b0: u32 = 0;
            while b0 < na {
                if b0 > 0 {
                    emit_str(s, out, ", ");
                }
                emit_str(s, out, "i64 ");
                emit_val(s, out, lvl + 1 + b0);
                b0 = b0 + 1;
            }
            emit_str(s, out, ")
");
            set_temp_val(s, lvl, sc);
            // `syscall4(...) as u32` 的后缀：结果的类型是 **i64**（内核返回值），
            // 原来这里直接返回，把 `as u32` 整段跳过 —— 参考实现发 `trunc i64 … to i32`，
            // 自举侧发 `ret i32 %t`（操作数是 i64），两个实现分叉且 IR 非法 (#679)。
            if tok_is(src, toks, ka + 1, "as") {
                apply_cast_b(s, out, src, toks, 4, 1, ka + 2, lvl);
                return ka + 2;
            }
            return ka;
        }
        if tok_is(src, toks, j, "slice_len") {   // M3: 切片取长度 (数组用字面量长度)
            let k18: u32 = arg1(s, out, src, toks, j + 2, lvl);
            let at: u32 = expr_type(s, src, toks, j + 2);
            emit_str(s, out, "  ");
            if is_slice_tok(src, toks, at) == 1 {
                let exs: u32 = new_temp(s, out);
                emit_str(s, out, " = extractvalue { ptr, i64 } ");
                emit_val(s, out, lvl);
                emit_str(s, out, ", 1\n  ");
                let trs: u32 = new_temp(s, out);
                emit_str(s, out, " = trunc i64 %t");
                emit_dec(s, out, exs);
                emit_str(s, out, " to i32\n");
                set_temp_val(s, lvl, trs);
            } else {
                let tra: u32 = new_temp(s, out);
                emit_str(s, out, " = trunc i64 ");
                emit_dec(s, out, array_len_of(src, toks, at));
                emit_str(s, out, " to i32\n");
                set_temp_val(s, lvl, tra);
            }
            if tok_is(src, toks, k18 + 1, "as") {
                apply_cast_b(s, out, src, toks, 3, 0, k18 + 2, lvl);
                return k18 + 3;
            }
            return k18 + 1;
        }
        // 调用: 先算每个实参 (值落到更深的层), 再写 call 行
        let fi: u32 = find_fn(s, src, toks, j);
        let ret: u32 = 0;
        if fi != 4294967295 {
            ret = fn_ret(s, fi);
        }
        let gen: u32 = is_generic_fn(s, src, toks, fi);
        let gent: u32 = 0;
        let gsub: u32 = 0;
        if gen == 1 {
            // 类型实参由第一个实参的类型推出 (与 lomentc 的 scope 推导同义)
            let it1: u32 = expr_type(s, src, toks, j + 2);
            gent = inst_add(s, src, toks, load32(s, CG_FN + fi * 12) - 1, it1, 0);
            let gp1: u32 = decl_tparam(src, toks, load32(s, CG_FN + fi * 12), 0);
            if gp1 != 0 {
                sub_push(s, gp1, load32(s, 72 + gent * 12 + 4));
                gsub = 1;
            }
        }
        let k: u32 = j + 2;
        let a: u32 = 0;
        while !tok_is(src, toks, k, ")") && tok_kind(toks, k) != 4 && a < 20 {
            // 实参按"形参类型"强制 (与 lomentc 的 expr(a, p.type) 同序同型)
            let ft: u32 = 0;
            if fi != 4294967295 {
                ft = load32(s, CG_PARAM + fi * 160 + a * 8 + 4);
            }
            let at: u32 = ft;
            let ae: u32 = expr_bin(s, out, src, toks, k, 1, lvl + 1 + a, at);
            // 实参类型槽按**值栈层**索引: 嵌套调用的实参不能覆盖外层已记好的槽
            store32(s, 720 + (lvl + 1 + a) * 4, at);
            k = ae;
            if tok_is(src, toks, k, ",") {
                k = k + 1;
            }
            a = a + 1;
        }
        // 上限 10 是**实参类型槽列表**的宽度 (形参表步长 80 = 10 槽 x 8 字节, 见
        // 参数表注释: 加宽会撞上 40960 的枚举表)。超了就**响亮地失败**: 以前这里只是
        // 循环退出 -> 后面 11 个实参里最后一个被静默丢掉 (IR 少一个实参), 参考实现却
        // 照发 —— 逐字节判据把它抓成"两个编译器不一致", 但定位成本高。M85 后半天抓到。
        //
        // `#775`：原先这里 `panic(20)` —— 进程被 ILL 打死，stderr 与 `--diag-out`
        // 一个字都没有。现在走发射器自己的诊断通道：检查器收下这份源（它没有"实参
        // 最多 20 个"这条语言规则），发射器报"降不下去"，用户拿到一条 E023。
        // 规则**只在这里**，不再抄进检查器 —— 那正是 `#775` 要闭的那条边。
        if a == 20 && !tok_is(src, toks, k, ")") {
            let _cf: u32 = cg_fail(s, 1, j);
            return k + 1;
        }
        emit_str(s, out, "  ");
        let unit: u32 = is_unit_tok(src, toks, ret);   // unit 返回: 不占寄存器
        let n: u32 = 0;
        if unit == 0 {
            n = new_temp(s, out);
            emit_str(s, out, " = ");
        }
        emit_str(s, out, "call ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " @");
        if gen == 1 {
            emit_inst_name(s, out, src, toks, gent);
        } else {
            emit_tok(s, out, src, toks, j);
        }
        emit_str(s, out, "(");
        let b: u32 = 0;
        while b < a {
            if b > 0 {
                emit_str(s, out, ", ");
            }
            let at2: u32 = load32(s, 720 + (lvl + 1 + b) * 4);
            emit_ty(s, out, src, toks, at2);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1 + b);
            b = b + 1;
        }
        emit_str(s, out, ")\n");
        if unit == 1 {
            store32(s, blen(s, lvl), 0);   // () 类型的值为空串
        } else {
            set_temp_val(s, lvl, n);
        }
        pop_subst(s, gsub);
        let ec: u32 = k + 1;
        if tok_is(src, toks, ec, "as") {   // 调用结果上的 as
            apply_cast(s, out, src, toks, ret, ec + 1, lvl);
            return ec + 2;
        }
        return ec;
    }
    // 布尔字面量: 值就是字面量 1 / 0 (不是变量 load)
    if tok_kind(toks, j) == 0 && (tok_is(src, toks, j, "true") || tok_is(src, toks, j, "false")) {
        if tok_is(src, toks, j, "true") {
            store8(s, btxt(s, lvl), 49 as u8);
        } else {
            store8(s, btxt(s, lvl), 48 as u8);
        }
        store32(s, blen(s, lvl), 1);
        return j + 1;
    }
    // 枚举路径 / 构造: E::V 与 E::V(expr)  (M25)
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, ":")
            && tok_is(src, toks, j + 2, ":") {
        let ei: u32 = find_enum(s, src, toks, j);
        let vi: u32 = 4294967295;
        let pt: u32 = 0;
        if ei != 4294967295 {
            vi = enum_variant_index(s, src, toks, ei, j + 3);
            if vi != 4294967295 {
                pt = enum_payload_type(s, src, toks, ei, vi);
            }
        }
        if pt == 0 || !tok_is(src, toks, j + 4, "(") {
            // 无载荷变体: 无载荷枚举 -> 字面量下标; 带载荷枚举 -> 只写 tag
            if load32(s, enum_base(ei) + 8) == 0 {
                set_dec_val(s, lvl, vi);
                return j + 4;
            }
            emit_str(s, out, "  ");
            let a0: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue ");
            emit_enum_ty(s, out, ei);
            emit_str(s, out, " undef, i32 ");
            emit_dec(s, out, vi);
            emit_str(s, out, ", 0\n");
            set_temp_val(s, lvl, a0);
            return j + 4;
        }
        // 带载荷构造: 求值实参 -> insertvalue tag -> (必要时 sext/zext) -> insertvalue 载荷
        let av: u32 = expr_bin(s, out, src, toks, j + 5, 1, lvl + 1, pt);
        emit_str(s, out, "  ");
        let a1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue ");
        emit_enum_ty(s, out, ei);
        emit_str(s, out, " undef, i32 ");
        emit_dec(s, out, vi);
        emit_str(s, out, ", 0\n");
        if bit_width(pt, src, toks) >= 64 {
            emit_str(s, out, "  ");
            let b1: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue ");
            emit_enum_ty(s, out, ei);
            emit_str(s, out, " %t");
            emit_dec(s, out, a1);
            emit_str(s, out, ", i64 ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 1\n");
            set_temp_val(s, lvl, b1);
        } else {
            emit_str(s, out, "  ");
            let c1: u32 = new_temp(s, out);
            emit_str(s, out, " = ");
            if is_signed(src, toks, pt) == 1 {
                emit_str(s, out, "sext ");
            } else {
                emit_str(s, out, "zext ");
            }
            emit_ty(s, out, src, toks, pt);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, " to i64\n  ");
            let b2: u32 = new_temp(s, out);
            emit_str(s, out, " = insertvalue ");
            emit_enum_ty(s, out, ei);
            emit_str(s, out, " %t");
            emit_dec(s, out, a1);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, c1);
            emit_str(s, out, ", 1\n");
            set_temp_val(s, lvl, b2);
        }
        let ev: u32 = av + 1;
        if tok_is(src, toks, ev, "as") {
            apply_cast(s, out, src, toks, 0, ev + 1, lvl);
            return ev + 2;
        }
        return ev;
    }
    // 模块级常量: 生成期内联成十进制字面量 (优先于变量查找, 与 lomentc 同序)
    let cvt: u32 = find_const(s, src, toks, j);
    if cvt != 0 {
        // 常量按**它自己的声明类型**环绕 (find_const 返回值 token; `const N : T = V`
        // 的 token 次序是 const N : T = V, 所以 `cvt - 2` 是 T) —— 与参考实现
        // `self.consts[name]` 带类型内联同序。
        set_int_lit(s, lvl, src, toks, cvt, cvt - 2);
        let ce: u32 = j + 1;
        if tok_is(src, toks, ce, "as") {
            apply_cast(s, out, src, toks, 0, ce + 1, lvl);
            return ce + 2;
        }
        return ce;
    }
    // 变量 (参数或局部): load
    let ty: u32 = var_type(s, src, toks, j);
    // `r[i]` / `r.f` 的**形状**类型：借用自动解一层（`docs/299` §3.4）。声明类型 `ty`
    // 仍用于取值本身（`&[T]` 的 `emit_ty` 是 `{ ptr, i64 }`，和切片一样）。
    let sty: u32 = deref_tok(src, toks, ty);
    let dot: u32 = j + 1;
    if tok_is(src, toks, dot, "[") && is_slice_tok(src, toks, sty) == 1 {
        // M3: 切片下标 xs[i] -> extractvalue 0 + GEP(元素) + load
        let et: u32 = elem_tok(src, toks, sty);
        load_var(s, out, src, toks, j, lvl);
        emit_str(s, out, "  ");
        let sp: u32 = new_temp(s, out);
        emit_str(s, out, " = extractvalue { ptr, i64 } ");
        emit_val(s, out, lvl);
        emit_str(s, out, ", 0\n");
        let itx: u32 = expr_type(s, src, toks, dot + 1);   // 下标**自己的类型**（不写死 i32）
        let iv: u32 = expr_bin(s, out, src, toks, dot + 1, 1, lvl + 1, 0);
        let _g1: u32 = dom_auto_guard(s, out, src, toks, j, dot + 1, itx, lvl + 1);   // docs/314
        emit_str(s, out, "  ");
        let g: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, sp);
        emit_str(s, out, ", ");
        emit_ty(s, out, src, toks, itx);
        emit_str(s, out, " ");
        emit_val(s, out, lvl + 1);
        emit_str(s, out, "\n  ");
        let rl: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, g);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rl);
        let ie: u32 = iv + 1;   // ']' 之后
        if tok_is(src, toks, ie, "as") {
            apply_cast(s, out, src, toks, et, ie + 1, lvl);
            return ie + 2;
        }
        return ie;
    }
    if tok_is(src, toks, dot, "[") && is_array_tok(src, toks, sty) == 1 {
        // M24: 数组下标 a[i] -> GEP(数组, 0, i) + load
        let et2: u32 = elem_tok(src, toks, sty);
        let itx2: u32 = expr_type(s, src, toks, dot + 1);   // 下标**自己的类型**
        let iv2: u32 = expr_bin(s, out, src, toks, dot + 1, 1, lvl, 0);
        let _g2: u32 = dom_auto_guard(s, out, src, toks, j, dot + 1, itx2, lvl);   // docs/314
        // `r: &[T; N]` 的 `r[i]`：先取指针（与参考实现 `_addr_of` 自动解一层同序）。
        let aref: u32 = 4294967295;
        if is_ref_tok(src, toks, ty) == 1 {
            emit_str(s, out, "  ");
            let ap0: u32 = new_temp(s, out);
            emit_str(s, out, " = load ptr, ptr %");
            emit_name_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr\n");
            aref = ap0;
        }
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, sty);
        emit_str(s, out, ", ptr ");
        if aref == 4294967295 {
            emit_str(s, out, "%");
            emit_name_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr");
        } else {
            emit_str(s, out, "%t");
            emit_dec(s, out, aref);
        }
        emit_str(s, out, ", i32 0, ");
        emit_ty(s, out, src, toks, itx2);
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        emit_str(s, out, "\n  ");
        let rl2: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et2);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rl2);
        let ie2: u32 = iv2 + 1;
        if tok_is(src, toks, ie2, "as") {
            apply_cast(s, out, src, toks, et2, ie2 + 1, lvl);
            return ie2 + 2;
        }
        return ie2;
    }
    if tok_kind(toks, j) == 0 && tok_is(src, toks, dot, ".") && tok_is(src, toks, dot + 2, "(") {
        // M8: 方法调用 x.m(args) -> 编译期解析为 <接收者类型>_m(x, args)
        let mfi: u32 = find_method(s, src, toks, ty, dot + 1);
        load_var(s, out, src, toks, j, lvl);   // 接收者按第一形参类型求值
        let km: u32 = dot + 3;
        let am: u32 = 0;
        while !tok_is(src, toks, km, ")") && tok_kind(toks, km) != 4 && am < 9 {
            let ft2: u32 = load32(s, CG_PARAM + mfi * 160 + (am + 1) * 8 + 4);
            let ae2: u32 = expr_bin(s, out, src, toks, km, 1, lvl + 1 + am, ft2);
            store32(s, 720 + (lvl + 1 + am) * 4, ft2);
            km = ae2;
            if tok_is(src, toks, km, ",") {
                km = km + 1;
            }
            am = am + 1;
        }
        emit_str(s, out, "  ");
        let rm: u32 = new_temp(s, out);
        emit_str(s, out, " = call ");
        emit_ty(s, out, src, toks, fn_ret(s, mfi));
        emit_str(s, out, " @");
        emit_method_name(s, out, src, toks, mfi);
        emit_str(s, out, "(");
        emit_ty(s, out, src, toks, load32(s, CG_PARAM + mfi * 160 + 4));
        emit_str(s, out, " ");
        emit_val(s, out, lvl);
        let bm: u32 = 0;
        while bm < am {
            emit_str(s, out, ", ");
            emit_ty(s, out, src, toks, load32(s, 720 + (lvl + 1 + bm) * 4));
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1 + bm);
            bm = bm + 1;
        }
        emit_str(s, out, ")\n");
        set_temp_val(s, lvl, rm);
        let me: u32 = km + 1;
        if tok_is(src, toks, me, "as") {
            apply_cast(s, out, src, toks, fn_ret(s, mfi), me + 1, lvl);
            return me + 2;
        }
        return me;
    }
    if tok_is(src, toks, dot, ".") {   // M23: 字段访问 p.a -> GEP + load
        // `r.field`：`r: &S` 自动解一层（`docs/299` §3.4）—— 先取指针，再 GEP。
        let sty: u32 = deref_tok(src, toks, ty);
        let si: u32 = find_struct(s, src, toks, sty);
        let fi: u32 = field_index(s, src, toks, si, dot + 1);
        let ft: u32 = field_type(s, src, toks, si, fi);
        let bref: u32 = 4294967295;
        if is_ref_tok(src, toks, ty) == 1 {
            emit_str(s, out, "  ");
            let bp: u32 = new_temp(s, out);
            emit_str(s, out, " = load ptr, ptr %");
            emit_name_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr\n");
            bref = bp;
        }
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, sty);
        emit_str(s, out, ", ptr ");
        if bref == 4294967295 {
            emit_str(s, out, "%");
            emit_name_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr");
        } else {
            emit_str(s, out, "%t");
            emit_dec(s, out, bref);
        }
        emit_str(s, out, ", i32 0, i32 ");
        emit_dec(s, out, fi);
        emit_str(s, out, "\n  ");
        let rv: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, ft);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, rv);
        let fe: u32 = dot + 2;
        if tok_is(src, toks, fe, "as") {
            apply_cast(s, out, src, toks, ft, fe + 1, lvl);
            return fe + 2;
        }
        return fe;
    }
    emit_str(s, out, "  ");
    let n2: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, j);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n2);
    let e9: u32 = j + 1;
    if tok_is(src, toks, e9, "as") {
        apply_cast(s, out, src, toks, ty, e9 + 1, lvl);
        return e9 + 2;
    }
    return e9;
}

/// 一元: -x (sub ty 0, v) / !b (xor i1 v, true) / &a / &mut a (数组 -> 切片)
fn expr_unary(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, lvl: u32, want: u32) -> u32 {
    // `*r` 解引用一层（`docs/299` §3.8）。只在**操作数开头**认 `*`：二元乘法走
    // `expr_bin` 的优先级那一支，到不了这里。
    if tok_is(src, toks, j, "*") {
        let it: u32 = expr_type(s, src, toks, j + 1);
        let e: u32 = expr_unary(s, out, src, toks, j + 1, lvl, 0);
        let et: u32 = deref_tok(src, toks, it);
        if tok_is(src, toks, et, "ptr") {
            et = CG_TY_U8;             // 裸 `ptr` 的 `*` 按字节读（与参考实现同一条）
        }
        emit_str(s, out, "  ");
        let r: u32 = new_temp(s, out);
        emit_str(s, out, " = load ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, ", ptr ");
        emit_val(s, out, lvl);
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, r);
        return e;
    }
    if tok_is(src, toks, j, "&") {   // M3/M4: 数组 -> 切片 (元素指针 + 个数)
        let nm: u32 = j + 1;
        if tok_is(src, toks, nm, "mut") {
            nm = nm + 1;
        }
        let ty: u32 = var_type(s, src, toks, nm);
        // 非数组的借用（`docs/299`）：值就是那块地方的地址，不额外落临时。
        if is_array_tok(src, toks, ty) != 1 {
            let _a: u32 = set_addr_val(s, src, toks, lvl, nm);
            return nm + 1;
        }
        emit_str(s, out, "  ");
        let p0: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, nm);
        emit_str(s, out, ".addr, i32 0, i32 0\n  ");
        let v1: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } undef, ptr %t");
        emit_dec(s, out, p0);
        emit_str(s, out, ", 0\n  ");
        let v2: u32 = new_temp(s, out);
        emit_str(s, out, " = insertvalue { ptr, i64 } %t");
        emit_dec(s, out, v1);
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, array_len_of(src, toks, ty));
        emit_str(s, out, ", 1\n");
        set_temp_val(s, lvl, v2);
        return nm + 1;
    }
    if tok_is(src, toks, j, "-") || tok_is(src, toks, j, "!") {
        let neg: u32 = tok_is(src, toks, j, "-") as u32;
        let inner: u32 = expr_unary(s, out, src, toks, j + 1, lvl, want);
        let tt: u32 = expr_type(s, src, toks, j + 1);
        // 参考实现的 `Un` 把 `want` 交给内层表达式；内层是**整数字面量**时，
        // 它的类型就是 want（`sock_retry(-11)` 的参数是 i64 ⇒ `sub i64 0, 11`）。
        // 自举侧原来只看字面量的缺省类型（i32），于是同一个实参发成 `sub i32`。
        // 只对字面量这么做：标识符的类型来自它自己，不是调用点的期望。
        if neg == 1 && want != 0 && tok_kind(toks, j + 1) == 1
                && want_is_int(src, toks, want) == 1 {
            tt = want;
        }
        emit_str(s, out, "  ");
        let n: u32 = new_temp(s, out);
        if neg == 1 {
            emit_str(s, out, " = sub ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " 0, ");
            emit_val(s, out, lvl);
        } else {
            emit_str(s, out, " = xor i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", true");
        }
        emit_str(s, out, "\n");
        set_temp_val(s, lvl, n);
        return inner;
    }
    return expr_atom(s, out, src, toks, j, lvl, want);
}

/// `want` 是**整数类型**吗? 只有整数才当二元运算的定宽期望。
///
/// 参考实现的 `binop` 取 `ty = lt or rt or want or "u32"`, `want` **不看类型** —— 于是
/// bool 上下文里的常量算术会落成 1 位运算: `WS_NAMES + WS_NAMES_CAP <= WS_ENTS` 发成
/// `add i1` / `icmp ule i1` (lompi 的 `pkg_ws` 自检当场算出垃圾值而红, 2026-10-10 撞到)。
/// 那是参考侧的缺陷: 把一个非整数的期望类型套到整型算术上本来就说不通。自举侧只在
/// `want` 是整数时才用它 —— 本任务要修的那个 (`let av: u64 = 0 * SYS_SCALE + 6`, 期望
/// 类型是 u64) 照常落 i64, 而 bool/ptr/str/切片/结构这些非整数落回 i32 缺省。
/// 0 (无 want) 按整数处理。
fn want_is_int(src: ptr, toks: ptr, want: u32) -> u32 {
    if want == 0 || want == CG_WANT_U32 {
        return 1;
    }
    if tok_is(src, toks, want, "u8") || tok_is(src, toks, want, "i8") {
        return 1;
    }
    if tok_is(src, toks, want, "u16") || tok_is(src, toks, want, "i16") {
        return 1;
    }
    if tok_is(src, toks, want, "u32") || tok_is(src, toks, want, "i32") {
        return 1;
    }
    if tok_is(src, toks, want, "u64") || tok_is(src, toks, want, "i64") {
        return 1;
    }
    return 0;
}

/// 二元 (优先级爬升): 结果落到第 lvl 层。
/// `want` 是**期望类型** (token 下标, 0 = 无): 两个操作数都没有类型时按它定宽 ——
/// 镜像参考实现 `binop` 的 `ty = common(lt, rt) or lt or rt or want or "u32"`。
/// 少了这一步, `let av: u64 = 0 * 4294967296 + 6` 会发成 `mul i32` 而 alloca 是 i64
/// (非法 IR)。
///
/// **结果宽度是两侧的公共类型, 不是左操作数**(`#133`)。`cur` 是**已经算完的那一段**
/// (第 lvl 层那个值) 的类型: 进循环前是第一个操作数的类型, 每过一个运算符就换成那个
/// 运算符的 `tt` —— 参考实现那条左结合链 (`expr_type(Bin) = _common_type(lt, rt)`)
/// 展开出来就是这个。窄的一侧按 `emit_upcast` 抬到 `tt`, 顺序与参考实现一致:
/// 先抬左、再发右、再抬右、最后出指令。
/// 操作数**实际发出来的类型**: 静态类型未知 (0) 且它是个名字时, 按模块级常量的
/// **声明类型**算。参考实现的 `expr(Ident)` 对常量返回 `self.consts[name]` 的类型,
/// 而 binop 的静态 `expr_type` 看不到常量 —— 两套类型在参考那边分工, 这里照抄:
/// 发的宽度看静态类型, 抬的类型看实际操作数。少了这一半, `DIR_O_DIRECTORY(u64) ==
/// 65536` 就少了参考那边的 `zext i64 65536 to i32` (#679 shape 2)。
fn operand_ty(s: ptr, src: ptr, toks: ptr, k: u32, fallback: u32) -> u32 {
    if fallback != 0 {
        return fallback;
    }
    if tok_kind(toks, k) != 0 {      // 字面量没有"声明类型", 不必找
        return 0;
    }
    let cvt: u32 = find_const(s, src, toks, k);
    if cvt != 0 {
        return cvt - 2;
    }
    return 0;
}

fn expr_bin(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, minp: u32, lvl: u32, want: u32) -> u32 {
    // `defer` 重放（`docs/296` §2.3）：这个 token 是某个捕获实参的起点 -> 用捕获的值。
    if load32(s, CG_DFR_PLAY) == 1 {
        let ck: u32 = dfr_cap_find(s, j);
        if ck != 4294967295 {
            return dfr_restore(s, ck, lvl);
        }
    }
    let w: u32 = 0;
    if want_is_int(src, toks, want) == 1 {
        w = want;
    }
    // **字面量本身**按声明类型环绕 (bool 也算): `let v: bool = 300;` 的字面量要印成 0。
    // 二元运算的定宽仍然只用 `w` (整数) —— 把 bool 灌进算术正是 want_is_int 那条注释
    // 记的旧缺陷 (`add i1`)。这里只在**单字面量**时把原始 want 递下去。
    let aw: u32 = w;
    if tok_kind(toks, j) == 1 {
        aw = want;
    }
    let cur: u32 = sub_expr_type(s, src, toks, j);
    let e: u32 = expr_unary(s, out, src, toks, j, lvl, aw);
    let i: u32 = e;
    // **链式转型**（#719）：atom 只吃**第一环**，余下的在这里补上 —— 每一环的 from
    // 就是上一环的目标。参考实现是嵌套的 `Cast` 节点，所以链可以任意长；自举侧按
    // token 走，`0 as u64 as ptr` 原来只发 `zext`、没有 `inttoptr`，`x as i32 as i64`
    // 少一条 `sext`（发成 `store i64 %i32值`，非法 IR）。
    if tok_is(src, toks, i, "as") {
        let f: u32 = cast_src_type(s, src, toks, j);
        if i >= 2 {
            if tok_is(src, toks, i - 2, "as") {
                f = i - 1;               // atom 吃过一环：当前值的类型就是那一环的目标
            }
        }
        while tok_is(src, toks, i, "as") {
            apply_cast(s, out, src, toks, f, i + 1, lvl);
            f = i + 1;
            i = i + 2;
        }
        cur = f;
    }
    let go: u32 = 1;
    while go == 1 {
        let c: u32 = op_code(src, toks, i);
        if c == 0 || op_prec(c) < minp {
            go = 0;
        } else if c == 1 || c == 2 {
            // 短路 (phi): 左值已在第 lvl 层; 右操作数只在需要时求值
            let b2: u32 = load32(s, 480) + 1;
            store32(s, 480, b2 + 2);
            emit_str(s, out, "  br i1 ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", label ");
            if c == 2 {                    // &&
                lab_ref(s, out, b2, "sc_rhs");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2 + 1, "sc_short");
            } else {                       // ||
                lab_ref(s, out, b2 + 1, "sc_short");
                emit_str(s, out, ", label ");
                lab_ref(s, out, b2, "sc_rhs");
            }
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, b2, "sc_rhs");
            let r2: u32 = expr_bin(s, out, src, toks, i + 2, op_prec(c) + 1, lvl + 1, w);
            store32(s, 500, load32(s, 488));   // 右操作数结束时的块 = phi 前驱
            store32(s, 504, load32(s, 496));
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 1, "sc_short");
            jump(s, out, b2 + 2, "sc_end");
            lab_def(s, out, b2 + 2, "sc_end");
            emit_str(s, out, "  ");
            let n2: u32 = new_temp(s, out);
            emit_str(s, out, " = phi i1 [ ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", ");
            ref_from(s, out, load32(s, 500), load32(s, 504));
            emit_str(s, out, " ], [ ");
            if c == 2 {
                emit_str(s, out, "false");
            } else {
                emit_str(s, out, "true");
            }
            emit_str(s, out, ", ");
            lab_ref(s, out, b2 + 1, "sc_short");
            emit_str(s, out, " ]\n");
            set_temp_val(s, lvl, n2);
            // `&&` / `||` 出 bool: 公共类型在这条路上不适用 (bool 不是整型), 所以
            // 「已算完那一段」的类型按 `lt or rt or want` 走 —— 与参考实现同一个式子。
            let rt2: u32 = sub_expr_type(s, src, toks, i + 2);
            let tt2: u32 = bin_common(src, toks, cur, rt2);
            if tt2 == 0 {
                tt2 = cur;
            }
            if tt2 == 0 {
                tt2 = rt2;
            }
            if tt2 == 0 {
                tt2 = w;
            }
            cur = tt2;
            i = r2;
        } else if c == 14 || c == 15 {
            // 除法/取模: 除零 = 运行时 trap (M18); 同时点亮运行时文本块
            let lt3: u32 = cur;
            let rt3: u32 = sub_expr_type(s, src, toks, i + 1);
            let tt3: u32 = bin_common(src, toks, lt3, rt3);
            if tt3 == 0 {
                tt3 = lt3;
            }
            if tt3 == 0 {
                tt3 = rt3;
            }
            if tt3 == 0 {
                tt3 = w;         // 两个操作数都没有类型 -> 落期望类型
            }
            let sgn3: u32 = 0;
            if tt3 == 0 && (neg_lit_at(src, toks, j) == 1 || neg_lit_at(src, toks, i + 1) == 1) {
                sgn3 = 1;        // 无类型 + 负字面量 -> 有符号 (#237)
            }
            if tt3 == 0 && sgn3 == 0 {
                tt3 = CG_WANT_U32;   // 两侧都无类型且无负字面量 -> 参考实现落 u32
            }
            emit_upcast(s, out, src, toks, lvl, operand_ty(s, src, toks, j, lt3), tt3);
            let r3: u32 = expr_bin(s, out, src, toks, i + 1, op_prec(c) + 1, lvl + 1, tt3);
            emit_upcast(s, out, src, toks, lvl + 1,
                        operand_ty(s, src, toks, i + 1, rt3), tt3);
            let n3: u32 = alloc_temp(s);   // lomentc 先占 r 再占 z
            let z3: u32 = alloc_temp(s);
            let w3: u32 = load32(s, 480) + 1;
            store32(s, 480, w3 + 2);
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, z3);
            emit_str(s, out, " = icmp eq ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, ", 0\n  br i1 %t");
            emit_dec(s, out, z3);
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3 + 1, "dtrap");
            emit_str(s, out, ", label ");
            lab_ref(s, out, w3, "dok");
            emit_str(s, out, "\n");
            store32(s, 476, 1);
            lab_def(s, out, w3 + 1, "dtrap");
            emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
            store32(s, 476, 1);
            lab_def(s, out, w3, "dok");
            emit_str(s, out, "  ");
            emit_temp_ref(s, out, n3);
            emit_str(s, out, " = ");
            emit_div_mnemonic(s, out, src, toks, c, tt3, sgn3);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt3);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            jump(s, out, w3 + 2, "dend");
            lab_def(s, out, w3 + 2, "dend");
            set_temp_val(s, lvl, n3);
            cur = tt3;
            i = r3;
        } else {
            let np: u32 = op_prec(c) + 1;
            let lt: u32 = cur;
            let rt: u32 = sub_expr_type(s, src, toks, i + op_toks(c));
            let tt: u32 = 0;
            if op_shift(c) == 0 {
                tt = bin_common(src, toks, lt, rt);
            }
            if tt == 0 {
                tt = lt;
            }
            if tt == 0 {
                tt = rt;
            }
            if tt == 0 {
                tt = w;          // 两个操作数都没有类型 -> 落期望类型
            }
            let sgn: u32 = 0;
            if tt == 0 && (neg_lit_at(src, toks, j) == 1
                    || neg_lit_at(src, toks, i + op_toks(c)) == 1) {
                sgn = 1;         // 无类型 + 负字面量 -> 有符号 (#237)
            }
            if tt == 0 && sgn == 0 {
                tt = CG_WANT_U32;    // 两侧都无类型且无负字面量 -> 参考实现落 u32
            }
            emit_upcast(s, out, src, toks, lvl, operand_ty(s, src, toks, j, lt), tt);
            let r: u32 = expr_bin(s, out, src, toks, i + op_toks(c), np, lvl + 1, tt);
            emit_upcast(s, out, src, toks, lvl + 1,
                        operand_ty(s, src, toks, i + op_toks(c), rt), tt);
            emit_str(s, out, "  ");
            let n: u32 = new_temp(s, out);
            emit_str(s, out, " = ");
            emit_mnemonic(s, out, src, toks, c, tt, sgn);
            emit_str(s, out, " ");
            emit_ty(s, out, src, toks, tt);
            emit_str(s, out, " ");
            emit_val(s, out, lvl);
            emit_str(s, out, ", ");
            emit_val(s, out, lvl + 1);
            emit_str(s, out, "\n");
            set_temp_val(s, lvl, n);
            cur = tt;
            i = r;
        }
    }
    return i;
}

// ---------------------------------------------------------------- 函数与模块

fn find_body(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j + 1;
}

fn find_paren(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "(") && !tok_is(src, toks, j, "{") {
        j = j + 1;
    }
    return j;
}

fn skip_parens(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") {
            d = d - 1;
            if d == 0 {
                return j;
            }
        }
        j = j + 1;
    }
    return j;
}

/// 返回类型 token: 需要 `-` `>` 才算有显式返回类型, 否则为 UNIT (哨兵 0xFFFFFFFF)。
fn fn_ret_tok(src: ptr, toks: ptr, rp: u32) -> u32 {
    if tok_is(src, toks, rp + 1, "-") && tok_is(src, toks, rp + 2, ">") {
        return rp + 3;
    }
    return 4294967295;
}

/// 是否 unit 返回 (`-> ()` 或省略返回类型)。
fn is_unit_tok(src: ptr, toks: ptr, tt: u32) -> u32 {
    if tt == 4294967295 {
        return 1;
    }
    return tok_is(src, toks, tt, "(") as u32;
}

fn emit_fn(s: ptr, out: ptr, src: ptr, toks: ptr, base: u32) -> u32 {
    let lp: u32 = find_paren(src, toks, base + 2);
    let rp: u32 = skip_parens(src, toks, lp);
    let ret: u32 = fn_ret_tok(src, toks, rp);
    let fkind: u32 = load32(s, fk_base(load32(s, 472)));   // 0=普通 1=trait 声明 2=impl 方法
    let k: u32 = 0;
    let i: u32 = lp + 1;
    while i < rp && k < 16 {
        store32(s, CG_CUR + k * 8, i);
        store32(s, CG_CUR + k * 8 + 4, i + 2);
        if fkind == 2 && k == 0 {   // impl 的 self: 类型 = 接收者类型
            store32(s, CG_CUR + k * 8 + 4, load32(s, fk_base(load32(s, 472)) + 4));
        }
        k = k + 1;
        i = skip_type(src, toks, i + 2);   // 类型可能是 [T] / [T; N]
        if tok_is(src, toks, i, ",") {
            i = i + 1;
        }
    }
    store32(s, 12, k);
    // docs/314：空间表与域栈按函数清零；形参的 `in SPACE` 登记进来
    store32(s, CG_VSP_N, 0);
    store32(s, CG_DOM_N, 0);
    let psp: u32 = 0;
    while psp < k {
        let pe: u32 = skip_type(src, toks, load32(s, CG_CUR + psp * 8 + 4));
        if tok_is(src, toks, pe - 2, "in") && tok_kind(toks, pe - 1) == 0 {
            let _ds0: u32 = dsp_set(s, src, toks, load32(s, CG_CUR + psp * 8), pe - 1);
        }
        psp = psp + 1;
    }
    store32(s, 528, base + 1);   // 当前函数名 token (字符串全局命名用)
    store32(s, 552, ret);        // 当前函数返回类型 token (match 臂体里 return 用)
    store32(s, 524, 0);          // 字符串全局序号随函数复位
    let body_at: u32 = find_body(src, toks, lp);
    let body_end: u32 = skip_block(src, toks, body_at - 1);
    store32(s, 564, body_at);   // L0 分析要函数体的 token 跨度 (两处前导段与 stmt 都用)
    store32(s, CG_BODY0, body_at);   // for-in 的合成下标按函数内词法顺序编号
    // `defer` 的书账按**函数**清零（docs/296 §2.3）：上一函数的站点/帧不能漏过来。
    store32(s, CG_DFR_N, 0);
    store32(s, CG_DFR_D, 0);
    // 联动 / 体的图边按**函数**扫（`docs/315` §5）：另一帧里的块域在这里没有活的状态。
    store32(s, CG_CPN, 0);
    store32(s, CG_ALN, 0);
    let _dgs: u32 = dom_graph_scan(s, src, toks, body_at, body_end);
    store32(s, CG_DFR_PLAY, 0);
    // `lgc` 的窗口编号与打开栈同样按**函数**清零（`docs/309`）：上一函数的窗口不能漏过来。
    store32(s, CG_LGC_N, 0);
    store32(s, CG_LGC_D, 0);
    store32(s, 568, body_end);
    let nl: u32 = collect_locals(s, src, toks, body_at, body_end);
    let has05: u32 = l05_plan(s, src, toks, nl);   // L0.5：本函数开不开区
    let nlgc: u32 = lgc_windows(src, toks, body_at, body_end);   // 本函数的窗口数（入口块开槽）
    let nsite: u32 = alloc_sites(src, toks, body_at, body_end);  // 分配站点数（spill 槽）
    store32(s, CG_GCDIRTY, 0);   // spill 槽的脏标记按**函数**清零（`#1465`）
    if tok_is(src, toks, base - 1, "interrupt") {   // M33: x86_intrcc 需要中断帧指针, 无参数
        emit_str(s, out, "; ");
        emit_tok(s, out, src, toks, base + 1);
        emit_str(s, out, " -> interrupt (x86_intrcc)\n");
        emit_str(s, out, "define x86_intrcc void @");
        emit_tok(s, out, src, toks, base + 1);
        emit_str(s, out, "(ptr byval([8 x i8]) %__frame) {\nentry:\n");
        let bi: u32 = 0;
        while bi < nl {
            emit_str(s, out, "  %");
            emit_local_name(s, out, src, toks, load32(s, CG_LOCAL + bi * 8));
            emit_str(s, out, ".addr = alloca ");
            if load32(s, CG_LOCAL + bi * 8 + 4) == SYN_U32 {
                emit_str(s, out, "i32");
            } else {
                emit_ty(s, out, src, toks, load32(s, CG_LOCAL + bi * 8 + 4));
            }
            emit_str(s, out, "\n");
            emit_l0_buf(s, out, src, toks, load32(s, CG_LOCAL + bi * 8));
            bi = bi + 1;
        }
        if has05 == 1 {   // L0.5：整函数一块栈区（在局部 `.buf` 之后、根登记之前）
            emit_str(s, out, "  %l05.buf = alloca [");
            emit_dec(s, out, load32(s, CG_L05_CAP) / 8);
            emit_str(s, out, " x i64]
");
        }
        if load32(s, CG_LGC) == 1 {
            // `lgc` 的窗口在入口块各开两个槽（与参考实现 `locals_prologue` 同序）。
            emit_lgc_slots(s, out, nlgc);
        }
        if gc_hook(s) == 1 {   // 分配站点的 spill 槽（`#1465`，与参考实现同序）
            emit_gc_slots(s, out, nsite);
        }
        if gc_hook(s) == 1 {   // `gc_auto`：中断函数**没有形参**，只有局部
            roots_push(s, out, src, toks, 0, nl);
        }
        let jj: u32 = find_body(src, toks, lp);
        let fdfr: u32 = dfr_push(s);   // 函数体 = 最外那层语句表（docs/296 §2.3）
        while tok_kind(toks, jj) != 4 {
            if tok_is(src, toks, jj, "}") {
                if load32(s, 476) == 0 {
                    let _de: u32 = dfr_end(s, out, src, toks, fdfr, ret);
                    lgc_restore_all(s, out);   // `lgc`：还开着的窗口按逆序恢复（docs/309）
                    emit_l1(s, out, src, toks, 0, 0, 0);   // L1：函数末尾
                    if gc_hook(s) == 1 {
                        roots_pop(s, out);
                    }
                    emit_str(s, out, "  ret void\n");
                }
                emit_str(s, out, "}\n");
                return jj + 1;
            }
            jj = stmt(s, out, src, toks, jj, ret);
        }
        return jj;
    }
    emit_str(s, out, "; ");
    if load32(s, 60) != 4294967295 {          // 泛型实例: 名字 = 基名_实参
        emit_inst_name(s, out, src, toks, load32(s, 60));
    } else if fkind == 2 {                    // impl 方法: 注释也用 mangled 名
        emit_method_name(s, out, src, toks, load32(s, 472));
    } else {
        emit_tok(s, out, src, toks, base + 1);
    }
    emit_str(s, out, " -> ");
    emitted_name(s, out, src, toks, ret);   // 注释用 Loment 类型名
    emit_str(s, out, "\n");
    emit_str(s, out, "define ");
    emit_ty(s, out, src, toks, ret);
    emit_str(s, out, " @");
    if load32(s, 60) != 4294967295 {          // 泛型实例
        emit_inst_name(s, out, src, toks, load32(s, 60));
    } else if fkind == 2 {                    // impl 方法: 名字 = <接收者类型>_<方法>
        emit_method_name(s, out, src, toks, load32(s, 472));
    } else {
        emit_tok(s, out, src, toks, base + 1);
    }
    emit_str(s, out, "(");
    let a: u32 = 0;
    while a < k {
        if a > 0 {
            emit_str(s, out, ", ");
        }
        let sa: u32 = push_ty_subst(s, src, toks, load32(s, CG_CUR + a * 8 + 4));
        emit_ty(s, out, src, toks, load32(s, CG_CUR + a * 8 + 4));
        pop_subst(s, sa);
        emit_str(s, out, " %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + a * 8));
        a = a + 1;
    }
    emit_str(s, out, ")");
    // 程序入口要 `stackrealign`：进程入口不是一次 `call`，内核给的 rsp 比 SysV 的函数入口
    // 约定**少 8**（16 对齐 vs `%16 == 8`）。不声明它，`_start` 与它下面每一帧整体偏 8 ——
    // `lomelf` 那台栈机不碰对齐所以一直看不出来，clang `-O1/-O2` 把局部数组的清零写成
    // `movaps` 就 `#GP`（`docs/212` §5.2）。参考实现同一行在 `tools/lomentc.py` 的
    // `ENTRY_FN` / `ENTRY_ATTR`，两处必须逐字节同。
    // 判据与参考实现同一条：只看**发射出来的名字** —— 泛型实例与 impl 方法的名字都被改写过，
    // 不可能等于 `_start`，所以它们那两条分支不算。
    if load32(s, 60) == 4294967295 && fkind != 2 && tok_is(src, toks, base + 1, "_start") == 1 {
        emit_str(s, out, " \"stackrealign\"");
    }
    emit_str(s, out, " {\nentry:\n");
    let b: u32 = 0;
    while b < k {
        emit_str(s, out, "  %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + b * 8));
        emit_str(s, out, ".addr = alloca ");
        let sb: u32 = push_ty_subst(s, src, toks, load32(s, CG_CUR + b * 8 + 4));
        emit_ty(s, out, src, toks, load32(s, CG_CUR + b * 8 + 4));
        pop_subst(s, sb);
        emit_str(s, out, "\n");
        b = b + 1;
    }
    let bl: u32 = 0;   // 局部变量 alloca (紧随参数之后)
    while bl < nl {
        emit_str(s, out, "  %");
        emit_local_name(s, out, src, toks, load32(s, CG_LOCAL + bl * 8));
        emit_str(s, out, ".addr = alloca ");
        if load32(s, CG_LOCAL + bl * 8 + 4) == SYN_U32 {
            emit_str(s, out, "i32");
        } else {
            let sl: u32 = push_ty_subst(s, src, toks, load32(s, CG_LOCAL + bl * 8 + 4));
            emit_ty(s, out, src, toks, load32(s, CG_LOCAL + bl * 8 + 4));
            pop_subst(s, sl);
        }
        emit_str(s, out, "\n");
        emit_l0_buf(s, out, src, toks, load32(s, CG_LOCAL + bl * 8));
        bl = bl + 1;
    }
    if has05 == 1 {   // L0.5：整函数一块栈区（与 `lomentc.locals_prologue` 同序）
        emit_str(s, out, "  %l05.buf = alloca [");
        emit_dec(s, out, load32(s, CG_L05_CAP) / 8);
        emit_str(s, out, " x i64]
");
    }
    if load32(s, CG_LGC) == 1 {
        // `lgc` 的窗口在入口块各开两个槽 —— 位置对着参考实现的 `locals_prologue`：
        // 局部/`.buf`/`l05.buf` 之后、形参 store 之前。
        emit_lgc_slots(s, out, nlgc);
    }
    if gc_hook(s) == 1 {   // 分配站点的 spill 槽（`#1465`，位置与参考实现同序）
        emit_gc_slots(s, out, nsite);
    }
    let c: u32 = 0;
    while c < k {
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, load32(s, CG_CUR + c * 8 + 4));
        emit_str(s, out, " %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + c * 8));
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, load32(s, CG_CUR + c * 8));
        emit_str(s, out, ".addr\n");
        c = c + 1;
    }
    if gc_hook(s) == 1 {   // `gc_auto`：本帧的指针槽登记进根表
        roots_push(s, out, src, toks, k, nl);
    }
    let j: u32 = find_body(src, toks, lp);
    let fdfr2: u32 = dfr_push(s);   // 函数体 = 最外那层语句表（docs/296 §2.3）
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "}") {
            if load32(s, 476) == 0 {   // 块未终止: unit 函数补 ret void, 其余补 unreachable
                let _de2: u32 = dfr_end(s, out, src, toks, fdfr2, ret);
                lgc_restore_all(s, out);   // `lgc`：函数末尾还开着的窗口按逆序恢复
                emit_l1(s, out, src, toks, 0, 0, 0);   // L1：函数末尾（档位门在 emit_l1 里）
                if is_unit_tok(src, toks, ret) == 1 {
                    if gc_hook(s) == 1 {   // `gc_auto`：函数末尾那条隐式 return
                        roots_pop(s, out);
                    }
                    emit_str(s, out, "  ret void\n");
                } else {
                    emit_str(s, out, "  unreachable\n");
                }
            }
            emit_str(s, out, "}\n");
            return j + 1;
        }
        j = stmt(s, out, src, toks, j, ret);
    }
    return j;
}

// ---------------------------------------------------------------- 语句

/// `for x in xs` 的下标自增。**体尾与 `continue` 共用这一份**（`docs/296` §2.5）：
/// 参考实现把它放在反糖出的 `While.step` 里，`continue` 先跑它再回条件 —— 分叉写两份
/// 必然有一份漂。`fi` = 合成下标编号（`__tur2_i.N` 的 N）。
/// 表达式是不是**单个字面量**（可带负号/括号）—— `print_num` 的无类型实参靠它分
/// i32（字面量）与 u32（其余）。与参考实现 `expr(IntLit, None)` 那条分界同义。
fn nat_is_literal(src: ptr, toks: ptr, j: u32) -> u32 {
    let k: u32 = j;
    while tok_is(src, toks, k, "(") {
        k = k + 1;
    }
    if tok_is(src, toks, k, "-") {
        k = k + 1;
    }
    if tok_kind(toks, k) != 1 {
        return 0;
    }
    k = k + 1;
    while tok_is(src, toks, k, ")") {
        k = k + 1;
    }
    if tok_is(src, toks, k, ",") || tok_is(src, toks, k, ")") || tok_is(src, toks, k, ";")
            || tok_kind(toks, k) == 4 {
        return 1;
    }
    return 0;
}

fn fi_step(s: ptr, out: ptr, fi: u32) -> u32 {
    emit_str(s, out, "  ");
    let iv: u32 = new_temp(s, out);
    emit_str(s, out, " = load i32, ptr %__tur2_i.");
    emit_dec(s, out, fi);
    emit_str(s, out, ".addr\n  ");
    let nv: u32 = new_temp(s, out);
    emit_str(s, out, " = add i32 %t");
    emit_dec(s, out, iv);
    emit_str(s, out, ", 1\n  store i32 %t");
    emit_dec(s, out, nv);
    emit_str(s, out, ", ptr %__tur2_i.");
    emit_dec(s, out, fi);
    return emit_str(s, out, ".addr\n");
}

/// range-for 的步进（镜像 `lomentc._for_step`）：load + add 1 + store。
fn for_step(s: ptr, out: ptr, src: ptr, toks: ptr, var_tok: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, var_tok);
    load_var(s, out, src, toks, var_tok, 0);
    emit_str(s, out, "  ");
    let nx: u32 = new_temp(s, out);
    emit_str(s, out, " = add ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, " ");
    emit_val(s, out, 0);
    emit_str(s, out, ", 1\n  store ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, " %t");
    emit_dec(s, out, nx);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, var_tok);
    return emit_str(s, out, ".addr\n");
}

fn lab_def(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    store32(s, 476, 0);           // terminated = false
    store32(s, 488, n);           // 当前标签 (phi 前驱用)
    store32(s, 496, tag_id(tag));
    emit_str(s, out, "L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    emit_str(s, out, tag);
    return emit_str(s, out, ":\n");
}

fn tag_id(tag: str) -> u32 {
    if str_eq(tag, "then") {
        return 1;
    }
    if str_eq(tag, "else") {
        return 2;
    }
    if str_eq(tag, "end") {
        return 3;
    }
    if str_eq(tag, "wcond") {
        return 4;
    }
    if str_eq(tag, "wbody") {
        return 5;
    }
    if str_eq(tag, "wend") {
        return 6;
    }
    if str_eq(tag, "sc_rhs") {
        return 7;
    }
    if str_eq(tag, "sc_short") {
        return 8;
    }
    if str_eq(tag, "fcond") {
        return 10;
    }
    if str_eq(tag, "fbody") {
        return 11;
    }
    if str_eq(tag, "fend") {
        return 12;
    }
    if str_eq(tag, "dok") {
        return 13;
    }
    if str_eq(tag, "dtrap") {
        return 14;
    }
    if str_eq(tag, "dend") {
        return 15;
    }
    if str_eq(tag, "aok") {
        return 16;
    }
    if str_eq(tag, "aovf") {
        return 17;
    }
    if str_eq(tag, "dead") {
        return 18;
    }
    if str_eq(tag, "gok") {
        return 22;
    }
    if str_eq(tag, "gtrap") {
        return 23;
    }
    if str_eq(tag, "seq") {      // str_eq 的三块 (M2 才发现: 它们也会当 phi 前驱)
        return 19;
    }
    if str_eq(tag, "sneq") {
        return 20;
    }
    if str_eq(tag, "send") {
        return 21;
    }
    if str_eq(tag, "mend") {     // match 的两块 (同理: `&&` 的右操作数里可以是 match)
        return 24;
    }
    if str_eq(tag, "mwild") {
        return 25;
    }
    // LMS 的 g1 三块（`docs/253` §5.3–§5.5）：phi 里要**按名字**指回它们，
    // 所以必须在表里 —— 落回 9 会让 `%L12_lmsjoin` 印成 `%L12_sc_end`
    // （`bootprobe.lomt` 那一格就是这么红的：两个实现的字节差 1）。
    if str_eq(tag, "lmsok") {
        return 26;
    }
    if str_eq(tag, "lmsbad") {
        return 27;
    }
    if str_eq(tag, "lmsjoin") {
        return 28;
    }
    return 9;   // sc_end
}

fn tag_name(id: u32) -> str {
    if id == 1 {
        return "then";
    }
    if id == 2 {
        return "else";
    }
    if id == 3 {
        return "end";
    }
    if id == 4 {
        return "wcond";
    }
    if id == 5 {
        return "wbody";
    }
    if id == 6 {
        return "wend";
    }
    if id == 7 {
        return "sc_rhs";
    }
    if id == 8 {
        return "sc_short";
    }
    if id == 10 {
        return "fcond";
    }
    if id == 11 {
        return "fbody";
    }
    if id == 12 {
        return "fend";
    }
    if id == 13 {
        return "dok";
    }
    if id == 14 {
        return "dtrap";
    }
    if id == 15 {
        return "dend";
    }
    if id == 16 {
        return "aok";
    }
    if id == 17 {
        return "aovf";
    }
    if id == 18 {
        return "dead";
    }
    if id == 22 {
        return "gok";
    }
    if id == 23 {
        return "gtrap";
    }
    if id == 19 {
        return "seq";
    }
    if id == 20 {
        return "sneq";
    }
    if id == 21 {
        return "send";
    }
    if id == 24 {
        return "mend";
    }
    if id == 25 {
        return "mwild";
    }
    if id == 26 {
        return "lmsok";
    }
    if id == 27 {
        return "lmsbad";
    }
    if id == 28 {
        return "lmsjoin";
    }
    return "sc_end";
}

/// 保存/还原当前标签 (phi 前驱)。
fn ref_from(s: ptr, out: ptr, n: u32, id: u32) -> u32 {
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag_name(id));
}

/// 当前标签引用: 0 = entry (隐式首块), 否则 %L{n}_{当前 tag 由调用方传入}
fn cur_ref(s: ptr, out: ptr, tag: str) -> u32 {
    let n: u32 = load32(s, 488);
    if n == 0 {
        return emit_str(s, out, "entry");
    }
    return lab_ref(s, out, n, tag);
}

fn lab_ref(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    emit_str(s, out, "%L");
    emit_dec(s, out, n);
    emit_str(s, out, "_");
    return emit_str(s, out, tag);
}

/// 未终止才写 br; 随后置 terminated。
fn jump(s: ptr, out: ptr, n: u32, tag: str) -> u32 {
    let r: u32 = 0;
    if load32(s, 476) == 0 {
        emit_str(s, out, "  br label ");
        r = lab_ref(s, out, n, tag);
        emit_str(s, out, "\n");
    }
    store32(s, 476, 1);
    return r;
}

/// 变量类型: 参数 -> 局部; 0 = 未知。
fn var_type(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let t: u32 = param_type(s, src, toks, name_tok);
    if t != 0 {
        return t;
    }
    let i: u32 = 0;
    while i < load32(s, 484) {
        let nt: u32 = load32(s, CG_LOCAL + i * 8);
        // nt 可能是合成名 (位 31 置位), 那种槽位不能当下标去读 token 缓冲
        if nt < 2147483648 && load32(toks, nt * 20 + 8) == load32(toks, name_tok * 20 + 8) {
            let k: u32 = 0;
            let ok: u32 = 1;
            while k < load32(toks, name_tok * 20 + 8) {
                if load8(src, load32(toks, nt * 20 + 4) + k)
                        != load8(src, load32(toks, name_tok * 20 + 4) + k) {
                    ok = 0;
                }
                k = k + 1;
            }
            if ok == 1 {
                return subst_tok(s, src, toks, load32(s, CG_LOCAL + i * 8 + 4));
            }
        }
        i = i + 1;
    }
    return 0;
}

/// 变量值加载到第 lvl 层 (load <ty>, ptr %name.addr)。
fn load_var(s: ptr, out: ptr, src: ptr, toks: ptr, name_tok: u32, lvl: u32) -> u32 {
    let ty: u32 = var_type(s, src, toks, name_tok);
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name_tok);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n);
    return n;
}

/// 读一个合成局部（`__tur2_s.N`，`docs/334`）。类型不在 token 表里，由调用方给。
fn load_syn_var(s: ptr, out: ptr, src: ptr, toks: ptr, ty: u32, fi: u32, lvl: u32) -> u32 {
    emit_str(s, out, "  ");
    let n: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, ", ptr %__tur2_s.");
    emit_dec(s, out, fi);
    emit_str(s, out, ".addr\n");
    set_temp_val(s, lvl, n);
    return n;
}

/// `let x: T = e?;` 的发射 —— 等价于 lomentc._desugar_try 的反糖产物:
///   let __t{line}: <rt> = e;   let x: T;
///   match __t{line} { Ok(__v{line}) => { x = __v{line}; }  Err(__e{line}) => { return Err(__e{line}); } }
/// 标签与临时编号都按同一顺序占号, 所以直发即可 (不重建 AST)。
/// `x orelse d` / `x catch d` 里那个词的下标（深度 0，遇 `;` `,` `)` `}` 停），没有回 0。
fn fb_tok(s: ptr, src: ptr, toks: ptr, at: u32) -> u32 {
    let d: u32 = 0;
    let k: u32 = at;
    while tok_kind(toks, k) != 4 {
        if tok_is(src, toks, k, "(") || tok_is(src, toks, k, "[")
                || tok_is(src, toks, k, "{") {
            d = d + 1;
        } else if tok_is(src, toks, k, ")") || tok_is(src, toks, k, "]")
                || tok_is(src, toks, k, "}") || tok_is(src, toks, k, ";")
                || tok_is(src, toks, k, ",") {
            if d == 0 {
                return 0;
            }
            d = d - 1;
        } else if d == 0 && tok_kind(toks, k) == 0
                && (tok_is(src, toks, k, "orelse") || tok_is(src, toks, k, "catch")) {
            return k;
        }
        k = k + 1;
    }
    return 0;
}

/// `let x: T = v orelse d;` / `x = v orelse d;`（`docs/296` §2.4）。
///
/// 与参考实现 `_fallback_expr` **同序**：先求枚举值 → `extractvalue` 取 tag → `switch`
/// （默认落兜底块、`i32 0` 落成功块）→ 成功块取载荷并按需 `trunc` → 兜底块求 `d` →
/// 合流块 `phi` → `store`。成功变体是枚举的**第一个**变体（预置 Option/Result 都是这个
/// 形状）。返回 `;` 之后的下标。
fn emit_fallback(s: ptr, out: ptr, src: ptr, toks: ptr, name_tok: u32, val_at: u32,
                 fb_at: u32) -> u32 {
    let sty: u32 = expr_type(s, src, toks, val_at);
    // 泛型实例（`Option<u32>`）的载荷类型靠**类型实参替换**解出来 —— 与 `let x: P<u32>`
    // 那条同一个机制（`push_ty_subst` 读类型名后面的 `<…>`）。
    let ssub: u32 = push_ty_subst(s, src, toks, sty);
    let ei: u32 = find_enum(s, src, toks, sty);
    let pty: u32 = 0;
    if ei != 4294967295 {
        pty = enum_payload_type(s, src, toks, ei, 0);
    }
    pop_subst(s, ssub);
    if pty == 0 {
        let _cf: u32 = cg_fail(s, 2, fb_at);
        return fb_at + 1;
    }
    let lv: u32 = 0;
    let _vend: u32 = expr_bin(s, out, src, toks, val_at, 1, lv, 0);
    emit_str(s, out, "  ");
    let tag: u32 = new_temp(s, out);
    emit_str(s, out, " = extractvalue { i32, i64 } ");
    emit_val(s, out, lv);
    emit_str(s, out, ", 0\n");
    let su: u32 = load32(s, 480) + 1;
    store32(s, 480, su + 2);
    emit_str(s, out, "  switch i32 %t");
    emit_dec(s, out, tag);
    emit_str(s, out, ", label ");
    lab_ref(s, out, su + 1, "fbbad");
    emit_str(s, out, " [\n      i32 0, label ");
    lab_ref(s, out, su, "fbok");
    emit_str(s, out, "\n    ]\n");
    store32(s, 476, 1);
    lab_def(s, out, su, "fbok");
    emit_str(s, out, "  ");
    let raw: u32 = new_temp(s, out);
    emit_str(s, out, " = extractvalue { i32, i64 } ");
    emit_val(s, out, lv);
    emit_str(s, out, ", 1\n");
    if ty_bits(src, toks, pty) >= 64 {
        set_temp_val(s, lv, raw);
    } else {
        emit_str(s, out, "  ");
        let tr: u32 = new_temp(s, out);
        emit_str(s, out, " = trunc i64 %t");
        emit_dec(s, out, raw);
        emit_str(s, out, " to ");
        emit_ty(s, out, src, toks, pty);
        emit_str(s, out, "\n");
        set_temp_val(s, lv, tr);
    }
    jump(s, out, su + 2, "fbend");
    lab_def(s, out, su + 1, "fbbad");
    let semi: u32 = operand_end(s, src, toks, fb_at + 1);
    let _dv: u32 = expr_bin(s, out, src, toks, fb_at + 1, 1, lv + 1, pty);
    jump(s, out, su + 2, "fbend");
    lab_def(s, out, su + 2, "fbend");
    emit_str(s, out, "  ");
    let r: u32 = new_temp(s, out);
    emit_str(s, out, " = phi ");
    emit_ty(s, out, src, toks, pty);
    emit_str(s, out, " [ ");
    emit_val(s, out, lv);
    emit_str(s, out, ", ");
    lab_ref(s, out, su, "fbok");
    emit_str(s, out, " ], [ ");
    emit_val(s, out, lv + 1);
    emit_str(s, out, ", ");
    lab_ref(s, out, su + 1, "fbbad");
    emit_str(s, out, " ]\n");
    emit_str(s, out, "  store ");
    emit_ty(s, out, src, toks, pty);
    emit_str(s, out, " %t");
    emit_dec(s, out, r);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name_tok);
    emit_str(s, out, ".addr\n");
    return semi + 1;
}

fn emit_try_let(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, eq: u32, lt: u32) -> u32 {
    let ln: u32 = load32(toks, lt * 20 + 12);
    let rtt: u32 = expr_type(s, src, toks, eq + 1);
    let rsub: u32 = push_ty_subst(s, src, toks, rtt);
    let e2: u32 = expr_bin(s, out, src, toks, eq + 1, 1, 0, rtt);
    emit_str(s, out, "  store ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, " ");
    emit_val(s, out, 0);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 0, ln);
    emit_str(s, out, ".addr\n");
    emit_str(s, out, "  ");
    let sv: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 0, ln);
    emit_str(s, out, ".addr\n");
    let ei: u32 = find_enum(s, src, toks, rtt);
    let mend: u32 = load32(s, 480) + 1;
    store32(s, 480, mend);
    let lok: u32 = load32(s, 480) + 1;
    store32(s, 480, lok);
    let lerr: u32 = load32(s, 480) + 1;
    store32(s, 480, lerr);
    emit_str(s, out, "  ");
    let tag: u32 = new_temp(s, out);
    emit_str(s, out, " = extractvalue { i32, i64 } %t");
    emit_dec(s, out, sv);
    emit_str(s, out, ", 0\n");
    emit_str(s, out, "  switch i32 %t");
    emit_dec(s, out, tag);
    emit_str(s, out, ", label %L");
    emit_dec(s, out, mend);
    emit_str(s, out, "_mend [\n      i32 0, label %L");
    emit_dec(s, out, lok);
    emit_str(s, out, "_mOk\n      i32 1, label %L");
    emit_dec(s, out, lerr);
    emit_str(s, out, "_mErr\n    ]\n");
    store32(s, 476, 1);
    // Ok 臂: 绑定载荷到 __v{line}, 臂体是 `x = __v{line}`
    store32(s, 476, 0);
    store32(s, 488, lok);
    store32(s, 496, 0);
    emit_str(s, out, "L");
    emit_dec(s, out, lok);
    emit_str(s, out, "_mOk:\n");
    let psub: u32 = push_ty_subst(s, src, toks, rtt);
    let okp: u32 = enum_payload_type(s, src, toks, ei, 0);
    let raw: u32 = alloc_temp(s);
    emit_str(s, out, "  %t");
    emit_dec(s, out, raw);
    emit_str(s, out, " = extractvalue { i32, i64 } %t");
    emit_dec(s, out, sv);
    emit_str(s, out, ", 1\n");
    if bit_width(okp, src, toks) >= 64 {
        emit_str(s, out, "  store i64 %t");
        emit_dec(s, out, raw);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 1, ln);
        emit_str(s, out, ".addr\n");
    } else {
        let cv: u32 = alloc_temp(s);
        emit_str(s, out, "  %t");
        emit_dec(s, out, cv);
        emit_str(s, out, " = trunc i64 %t");
        emit_dec(s, out, raw);
        emit_str(s, out, " to ");
        emit_ty(s, out, src, toks, okp);
        emit_str(s, out, "\n  store ");
        emit_ty(s, out, src, toks, okp);
        emit_str(s, out, " %t");
        emit_dec(s, out, cv);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 1, ln);
        emit_str(s, out, ".addr\n");
    }
    pop_subst(s, psub);
    emit_str(s, out, "  ");
    let lv: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, okp);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 1, ln);
    emit_str(s, out, ".addr\n  store ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, " %t");
    emit_dec(s, out, lv);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name);
    emit_str(s, out, ".addr\n");
    jump(s, out, mend, "mend");
    // Err 臂: 绑定载荷到 __e{line}, 臂体是 `return Err(__e{line})`
    store32(s, 476, 0);
    store32(s, 488, lerr);
    store32(s, 496, 0);
    emit_str(s, out, "L");
    emit_dec(s, out, lerr);
    emit_str(s, out, "_mErr:\n");
    let esub: u32 = push_ty_subst(s, src, toks, rtt);
    let errp: u32 = enum_payload_type(s, src, toks, ei, 1);
    let eraw: u32 = alloc_temp(s);
    emit_str(s, out, "  %t");
    emit_dec(s, out, eraw);
    emit_str(s, out, " = extractvalue { i32, i64 } %t");
    emit_dec(s, out, sv);
    emit_str(s, out, ", 1\n");
    if bit_width(errp, src, toks) >= 64 {
        emit_str(s, out, "  store i64 %t");
        emit_dec(s, out, eraw);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 2, ln);
        emit_str(s, out, ".addr\n");
    } else {
        let ecv: u32 = alloc_temp(s);
        emit_str(s, out, "  %t");
        emit_dec(s, out, ecv);
        emit_str(s, out, " = trunc i64 %t");
        emit_dec(s, out, eraw);
        emit_str(s, out, " to ");
        emit_ty(s, out, src, toks, errp);
        emit_str(s, out, "\n  store ");
        emit_ty(s, out, src, toks, errp);
        emit_str(s, out, " %t");
        emit_dec(s, out, ecv);
        emit_str(s, out, ", ptr %");
        emit_syn(s, out, 2, ln);
        emit_str(s, out, ".addr\n");
    }
    pop_subst(s, esub);
    emit_str(s, out, "  ");
    let elv: u32 = new_temp(s, out);
    emit_str(s, out, " = load ");
    emit_ty(s, out, src, toks, errp);
    emit_str(s, out, ", ptr %");
    emit_syn(s, out, 2, ln);
    emit_str(s, out, ".addr\n  ");
    let a1: u32 = new_temp(s, out);
    emit_str(s, out, " = insertvalue ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, " undef, i32 1, 0\n  ");
    let c1: u32 = new_temp(s, out);
    emit_str(s, out, " = ");
    if is_signed(src, toks, errp) == 1 {
        emit_str(s, out, "sext ");
    } else {
        emit_str(s, out, "zext ");
    }
    emit_ty(s, out, src, toks, errp);
    emit_str(s, out, " %t");
    emit_dec(s, out, elv);
    emit_str(s, out, " to i64\n  ");
    let b1: u32 = new_temp(s, out);
    emit_str(s, out, " = insertvalue ");
    emit_ty(s, out, src, toks, rtt);
    emit_str(s, out, " %t");
    emit_dec(s, out, a1);
    emit_str(s, out, ", i64 %t");
    emit_dec(s, out, c1);
    emit_str(s, out, ", 1\n");
    // `?` 的早退也是一条 `return`（docs/296 §2.3）：defer 在 ret 之前跑
    let _dfrq: u32 = dfr_run(s, out, src, toks, 0, load32(s, 552));
    emit_str(s, out, "  ret ");
    emit_ty(s, out, src, toks, load32(s, 552));
    emit_str(s, out, " %t");
    emit_dec(s, out, b1);
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    jump(s, out, mend, "mend");
    lab_def(s, out, mend, "mend");
    pop_subst(s, rsub);
    return eq;
}

/// `for x in xs` 的合成下标序号：本函数体内按词法顺序数，第几个 for-in 就从 1 起。
/// 参考实现的反糖按同一顺序编号（`__tur2_i.N`），两边必须一致。
fn fi_ord(s: ptr, src: ptr, toks: ptr, at: u32) -> u32 {
    let i: u32 = load32(s, CG_BODY0);
    let n: u32 = 0;
    while i < at {
        if tok_is(src, toks, i, "for") {
            if (tok_is(src, toks, i + 2, "in") && load32(toks, (i + 3) * 20) == 0
                    && tok_is(src, toks, i + 4, "{"))
                    || (load32(s, CG_PROF) >= 2 && load32(toks, (i + 1) * 20) == 0
                        && tok_is(src, toks, i + 2, ",") && load32(toks, (i + 3) * 20) == 0
                        && tok_is(src, toks, i + 4, "in") && load32(toks, (i + 5) * 20) == 0
                        && tok_is(src, toks, i + 6, "{"))
                    || (load32(s, CG_PROF) >= 2 && load32(toks, (i + 1) * 20) == 0
                        && tok_is(src, toks, i + 2, "in") && load32(toks, (i + 3) * 20) == 0
                        && tok_is(src, toks, i + 4, "(")
                        && tok_is(src, toks, skip_parens(src, toks, i + 4) + 1, "{")) {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n + 1;
}

/// `[T; N]` 里 **N 的 token**（`[T]` / 不是数组返回 0）。元素类型可以嵌套。
fn array_len_tok(src: ptr, toks: ptr, ty: u32) -> u32 {
    let i: u32 = ty + 1;
    let d: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "[") {
            d = d + 1;
        }
        if tok_is(src, toks, i, "]") {
            if d == 0 {
                return 0;
            }
            d = d - 1;
        }
        if d == 0 && tok_is(src, toks, i, ";") {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

/// `if` / `else if` 链的发射。`cond` = **条件第一个 token**（不是 `if` 本身）——
/// Tur 2 的隐式 elif（`else <条件> {`，`docs/296` §2.1）从 `else` 之后直接进来，
/// 与 `else if` 走同一条路，标签编号因此与参考实现逐字节一致。
/// `let x: T = if c { a } else { b };` 的发射（2026.3，`docs/335`）。
/// 与参考实现反糖后的 `let x: T;` + `If` 同形：条件、L1_then / L2_else / L3_end
/// 三个标签、两支各一条 `store <T> …, ptr %x.addr`。
fn let_ifexpr(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, name: u32,
              ty: u32, eq: u32) -> u32 {
    let _e3: u32 = expr_bin(s, out, src, toks, eq + 2, 1, 0, 0);
    let base_l: u32 = load32(s, 480) + 1;
    store32(s, 480, base_l + 2);
    emit_str(s, out, "  br i1 ");
    emit_val(s, out, 0);
    emit_str(s, out, ", label ");
    lab_ref(s, out, base_l, "then");
    emit_str(s, out, ", label ");
    lab_ref(s, out, base_l + 1, "else");
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    lab_def(s, out, base_l, "then");
    // `{` 在 _e3；then 的表达式是 _e3 + 1 那一段，结束于 `}`。
    let _tv: u32 = expr_bin(s, out, src, toks, _e3 + 1, 1, 0, ty);
    emit_str(s, out, "  store ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, " ");
    emit_val(s, out, 0);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name);
    emit_str(s, out, ".addr\n");
    jump(s, out, base_l + 2, "end");
    lab_def(s, out, base_l + 1, "else");
    // `}` `else` `{` —— else 的表达式从 `_tv` 之后第 3 个 token 起。
    let _ev: u32 = expr_bin(s, out, src, toks, _tv + 3, 1, 0, ty);
    emit_str(s, out, "  store ");
    emit_ty(s, out, src, toks, ty);
    emit_str(s, out, " ");
    emit_val(s, out, 0);
    emit_str(s, out, ", ptr %");
    emit_name_tok(s, out, src, toks, name);
    emit_str(s, out, ".addr\n");
    jump(s, out, base_l + 2, "end");
    lab_def(s, out, base_l + 2, "end");
    return _ev + 2;   // 跳过 `}` 与 `;`
}

fn emit_if_at(s: ptr, out: ptr, src: ptr, toks: ptr, cond: u32, ret: u32) -> u32 {
    // 先算条件再占标签: 条件里的 `&&`/除法会自己占标签 (与 lomentc 的 If 同序)
    let e3: u32 = expr_bin(s, out, src, toks, cond, 1, 0, 0);
    let base_l: u32 = load32(s, 480) + 1;   // lomentc 从 L1 起编号
    store32(s, 480, base_l + 2);
    emit_str(s, out, "  br i1 ");
    emit_val(s, out, 0);
    emit_str(s, out, ", label ");
    lab_ref(s, out, base_l, "then");
    emit_str(s, out, ", label ");
    lab_ref(s, out, base_l + 1, "else");
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    lab_def(s, out, base_l, "then");
    let k: u32 = e3 + 1;   // '{' 之后的第一条语句
    // **L2 也认 `if` 的两支**（`docs/210` §7 点名的"只认 while/for 的体"）：两支各是一个
    // 块，规则与循环体同一条（`epoch_open` 内部的 `l2_ok` 就是用这一支的跨度判的）。
    // `else if` 链**不在这儿开** —— 那是一条语句，它自己那两支会各自开（参考侧同形）。
    let tdfr: u32 = dfr_push(s);   // 分支体是一层语句表（docs/296 §2.3）
    let tv: u32 = epoch_open(s, out, src, toks, e3 + 1, skip_block(src, toks, e3) - 1);
    while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
        k = stmt(s, out, src, toks, k, ret);
    }
    let _tde: u32 = dfr_end(s, out, src, toks, tdfr, ret);
    epoch_close(s, out, tv);
    k = k + 1;
    jump(s, out, base_l + 2, "end");
    lab_def(s, out, base_l + 1, "else");
    if tok_is(src, toks, k, "else") {
        k = k + 1;
        if tok_is(src, toks, k, "if") {
            k = stmt(s, out, src, toks, k, ret);
        } else if load32(s, CG_PROF) != 0 && !tok_is(src, toks, k, "{") {
            // Tur 2：`else <条件> {` —— 隐式 elif，直接发下一层（与 `else if` 同形）。
            k = emit_if_at(s, out, src, toks, k, ret);
        } else {
            let edfr: u32 = dfr_push(s);
            let ev: u32 = epoch_open(s, out, src, toks, k + 1, skip_block(src, toks, k) - 1);
            k = k + 1;   // '{'
            while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
                k = stmt(s, out, src, toks, k, ret);
            }
            let _ede: u32 = dfr_end(s, out, src, toks, edfr, ret);
            epoch_close(s, out, ev);
            k = k + 1;
        }
    }
    jump(s, out, base_l + 2, "end");
    lab_def(s, out, base_l + 2, "end");
    return k;
}


// ---------------------------------------------------------------- defer（docs/296 §2.3）

/// 进一层语句表：记下进帧前的站点数，帧深 +1。
fn dfr_push(s: ptr) -> u32 {
    let d: u32 = load32(s, CG_DFR_D);
    if d >= CG_MAXDFRAMES {
        let _cf: u32 = cg_fail(s, 5, 0);   // 嵌套太深：点亮出来（见 driver 的 5 号消息）
        return d;
    }
    store32(s, CG_DFR_FRAMES + d * 4, load32(s, CG_DFR_N));
    store32(s, CG_DFR_D, d + 1);
    return d;
}

/// 出一层语句表：**正常走到块尾**时按帧内 LIFO 跑完；已经终结（`return`/`break`/
/// `continue`）时那一支自己跑过（见 `stmt`），这里只把帧收掉。
fn dfr_end(s: ptr, out: ptr, src: ptr, toks: ptr, base: u32, ret: u32) -> u32 {
    if load32(s, 476) == 0 {
        dfr_run(s, out, src, toks, base, ret);
    }
    store32(s, CG_DFR_N, load32(s, CG_DFR_FRAMES + base * 4));
    store32(s, CG_DFR_D, base);
    return 0;
}

/// 从最内层帧一路跑到 `base`（含）：帧内逆序，帧间由内向外。**只发指令、不动书账** ——
/// 一条 `return`/`break` 只是**一条**出口；同一个块尾在别的路径上还要再发一次
/// （参考实现同一条：`_run_defers` 只读不弹）。书账由 `dfr_end` 在块尾收。
fn dfr_run(s: ptr, out: ptr, src: ptr, toks: ptr, base: u32, ret: u32) -> u32 {
    let d: u32 = load32(s, CG_DFR_D);
    while d > base {
        let dd: u32 = d - 1;
        let b: u32 = load32(s, CG_DFR_FRAMES + dd * 4);
        let n: u32 = load32(s, CG_DFR_N);
        while n > b {
            let nn: u32 = n - 1;
            let site: u32 = load32(s, CG_DFR_SITES + nn * 4);
            store32(s, CG_DFR_ACT, nn);
            store32(s, CG_DFR_PLAY, 1);
            let _e: u32 = stmt(s, out, src, toks, site, ret);
            store32(s, CG_DFR_PLAY, 0);
            n = nn;
        }
        d = dd;
    }
    return 0;
}

fn dfr_cap_slot(s: ptr, n: u32, k: u32) -> u32 {
    return CG_DFR_CAP + (n * CG_MAXDFARGS + k) * CG_DFR_STRIDE;
}

/// 把第 k 个实参的方案 (start, end) 与**值文本**存进捕获表（值在 0 层）。
fn dfr_cap_store(s: ptr, n: u32, k: u32, start: u32, end: u32) -> u32 {
    let off: u32 = dfr_cap_slot(s, n, k);
    let mut_ln: u32 = load32(s, blen(s, 0));
    if mut_ln > 68 {
        mut_ln = 68;
    }
    store32(s, off, start);
    store32(s, off + 4, end);
    store32(s, off + 8, mut_ln);
    let i: u32 = 0;
    while i < mut_ln {
        store8(s, off + 16 + i, load8(s, btxt(s, 0) + i) as u8);
        i = i + 1;
    }
    return 0;
}

/// 正在重放的站点里，`j` 是不是某个捕获实参的起点；是 -> 实参序号，不是 -> 4294967295。
fn dfr_cap_find(s: ptr, j: u32) -> u32 {
    let n: u32 = load32(s, CG_DFR_ACT);
    let k: u32 = 0;
    while k < CG_MAXDFARGS {
        let off: u32 = dfr_cap_slot(s, n, k);
        if load32(s, off + 8) != 0 && load32(s, off) == j {
            return k;
        }
        k = k + 1;
    }
    return 4294967295;
}

/// 把捕获的值放回第 lvl 层，返回那条实参**之后**的 token（调用方据此继续）。
fn dfr_restore(s: ptr, k: u32, lvl: u32) -> u32 {
    let off: u32 = dfr_cap_slot(s, load32(s, CG_DFR_ACT), k);
    let ln: u32 = load32(s, off + 8);
    let i: u32 = 0;
    while i < ln {
        store8(s, btxt(s, lvl) + i, load8(s, off + 16 + i) as u8);
        i = i + 1;
    }
    store32(s, blen(s, lvl), ln);
    return load32(s, off + 4);
}

/// 延迟调用的第 k 个实参按什么类型求值：用户函数用**形参类型**（与参考实现同一条），
/// 其余（内建 / 泛型 / 未知）按自然类型。
fn dfr_want(s: ptr, src: ptr, toks: ptr, name_tok: u32, k: u32) -> u32 {
    let fi: u32 = find_fn(s, src, toks, name_tok);
    if fi == 4294967295 {
        return 0;
    }
    if is_generic_fn(s, src, toks, fi) == 1 {
        return 0;
    }
    return load32(s, CG_PARAM + fi * 160 + k * 8 + 4);
}

/// `defer CALL;` 本身：**不执行**，只把站点与捕获登记进当前帧；`PLAY` 时为重放，
/// 跳过关键字让调用照常发出去。
fn dfr_stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    if load32(s, CG_DFR_PLAY) == 1 {
        return stmt(s, out, src, toks, j + 1, ret);
    }
    let n: u32 = load32(s, CG_DFR_N);
    if n >= CG_MAXDFR {
        return cg_fail(s, 4, j);   // 一个函数里 defer 太多（捕获表放不下）
    }
    store32(s, CG_DFR_SITES + n * 4, j);
    store32(s, CG_DFR_N, n + 1);
    let k: u32 = 0;
    while k < CG_MAXDFARGS {
        store32(s, dfr_cap_slot(s, n, k), 0);
        store32(s, dfr_cap_slot(s, n, k) + 8, 0);
        k = k + 1;
    }
    // 实参：`defer NAME ( a, b ) ;` —— j+1 = NAME、j+2 = '('
    let p: u32 = j + 3;
    let a: u32 = 0;
    while !tok_is(src, toks, p, ")") && tok_kind(toks, p) != 4 && a < CG_MAXDFARGS {
        let w: u32 = dfr_want(s, src, toks, j + 1, a);
        let at: u32 = expr_bin(s, out, src, toks, p, 1, 0, w);
        let _s: u32 = dfr_cap_store(s, n, a, p, at);
        p = at;
        if tok_is(src, toks, p, ",") {
            p = p + 1;
        }
        a = a + 1;
    }
    if a >= CG_MAXDFARGS && !tok_is(src, toks, p, ")") {
        let _cf: u32 = cg_fail(s, 3, j);   // 多于 4 个实参：说出来，别静默截断
    }
    let semi: u32 = operand_end(s, src, toks, p);
    return semi + 1;
}

/// 撤销一条（块域目标，`docs/306` §6.1 C2）。`pos == 1` = 只撤一个位置。
fn revoke_blk(s: ptr, out: ptr, pos: u32, v64: u32, k: u32) -> u32 {
    if load32(s, dom_at(k - 1, 9)) == 0 {
        return cg_fail(s, 2, load32(s, dom_at(k - 1, 8)));
    }
    emit_str(s, out, "  call void @__loment_revoke(ptr ");
    let _r: u32 = dom_rev_ref(s, out, k);
    emit_str(s, out, ", i64 ");
    if pos == 1 {
        emit_str(s, out, "%t");
        emit_dec(s, out, v64);
        emit_str(s, out, ", i64 0)
");
    } else {
        emit_str(s, out, "0, i64 1)
");
    }
    return 0;
}

/// 撤销一条（能力目标）。
fn revoke_cap(s: ptr, out: ptr, pos: u32, v64: u32, c: u32) -> u32 {
    if load32(s, cap_base(c) + 16) == 0 {
        return cg_fail(s, 2, load32(s, cap_base(c)));
    }
    let rv: u32 = cap_rev_tmp(s, out, c);
    emit_str(s, out, "  call void @__loment_revoke(ptr ");
    if rv != 0 {
        emit_str(s, out, "%t");
        emit_dec(s, out, rv);
    } else {
        emit_str(s, out, "@__loment_revfree");
    }
    emit_str(s, out, ", i64 ");
    if pos == 1 {
        emit_str(s, out, "%t");
        emit_dec(s, out, v64);
        emit_str(s, out, ", i64 0)
");
    } else {
        emit_str(s, out, "0, i64 1)
");
    }
    return 0;
}

/// 体的名字 -> 根成员（`docs/315` §5.2）；找不到返回 0。
fn cp_alias(s: ptr, src: ptr, toks: ptr, name_tok: u32) -> u32 {
    let n: u32 = load32(s, CG_ALN);
    let i: u32 = 0;
    while i < n {
        if tok_eq(src, toks, load32(s, CG_ALS + i * 8), name_tok) {
            return load32(s, CG_ALS + i * 8 + 4);
        }
        i = i + 1;
    }
    return 0;
}

/// 扫一个函数体里的 `couple` / `solid`：联动对 + 体的别名（`docs/315` §5）。
fn dom_graph_scan(s: ptr, src: ptr, toks: ptr, b: u32, e: u32) -> u32 {
    let cq: u32 = b;
    while cq < e && tok_kind(toks, cq) != 4 {
        if tok_is(src, toks, cq, "solid") && tok_kind(toks, cq + 1) == 0
                && tok_is(src, toks, cq + 2, ":") {
            if load32(s, CG_ALN) >= CG_ALS_MAX {
                return cg_fail(s, 2, cq);
            }
            let an: u32 = load32(s, CG_ALN);
            let q: u32 = cq + 3;
            if tok_kind(toks, q) != 0 {
                return cg_fail(s, 2, cq);
            }
            store32(s, CG_ALS + an * 8, cq + 1);
            store32(s, CG_ALS + an * 8 + 4, q);
            store32(s, CG_ALN, an + 1);
            let prev: u32 = q;
            while q < e && tok_kind(toks, q) != 4 && !tok_is(src, toks, q, ";") {
                if tok_kind(toks, q) == 0 && q != prev {
                    if load32(s, CG_CPN) >= CG_CPP_MAX {
                        return cg_fail(s, 2, cq);
                    }
                    let cn3: u32 = load32(s, CG_CPN);
                    store32(s, CG_CPP + cn3 * 8, prev);
                    store32(s, CG_CPP + cn3 * 8 + 4, q);
                    store32(s, CG_CPN, cn3 + 1);
                    prev = q;
                }
                q = q + 1;
            }
            cq = q;
        } else if tok_is(src, toks, cq, "couple") && tok_kind(toks, cq + 1) == 0
                && (tok_is(src, toks, cq + 2, ",") || tok_is(src, toks, cq + 2, ";")) {
            let q: u32 = cq + 1;
            let prev: u32 = q;
            while q < e && tok_kind(toks, q) != 4 && !tok_is(src, toks, q, ";") {
                if tok_kind(toks, q) == 0 && q != prev {
                    if load32(s, CG_CPN) >= CG_CPP_MAX {
                        return cg_fail(s, 2, cq);
                    }
                    let cn3: u32 = load32(s, CG_CPN);
                    store32(s, CG_CPP + cn3 * 8, prev);
                    store32(s, CG_CPP + cn3 * 8 + 4, q);
                    store32(s, CG_CPN, cn3 + 1);
                    prev = q;
                }
                q = q + 1;
            }
            cq = q;
        }
        cq = cq + 1;
    }
    return 0;
}

/// 联动组里从 `a` 能不能走到 `b`（深度 8 的递归；表最多 32 条边）。
fn cp_conn(s: ptr, src: ptr, toks: ptr, a: u32, b: u32, depth: u32) -> u32 {
    if tok_eq(src, toks, a, b) {
        return 1;
    }
    if depth == 0 {
        return 0;
    }
    let n: u32 = load32(s, CG_CPN);
    let i: u32 = 0;
    while i < n {
        let x: u32 = load32(s, CG_CPP + i * 8);
        let y: u32 = load32(s, CG_CPP + i * 8 + 4);
        if tok_eq(src, toks, a, x) || tok_eq(src, toks, a, y) {
            let o: u32 = y;
            if tok_eq(src, toks, a, y) {
                o = x;
            }
            if cp_conn(s, src, toks, o, b, depth - 1) == 1 {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn dom_partner_cap(s: ptr, out: ptr, c: u32, v64: u32, has_aux: u32,
                   a64: u32, own_state: u32) -> u32 {
    let pk: u32 = load32(s, cap_base(c) + 20);
    let ck: u32 = pk & 15;
    let stg: u32 = 0;
    if own_state == 1 && (ck == 7 || ck == 12 || ck == 14 || ck == 15) {
        emit_str(s, out, "  ");
        stg = new_temp(s, out);
        emit_str(s, out, " = getelementptr [64 x i64], ptr ");
        if ck == 7 { emit_str(s, out, "@__loment_used"); }
        if ck == 12 { emit_str(s, out, "@__loment_wit"); }
        if ck == 14 { emit_str(s, out, "@__loment_obl"); }
        if ck == 15 { emit_str(s, out, "@__loment_gen"); }
        emit_str(s, out, ", i64 ");
        emit_dec(s, out, c);
        emit_str(s, out, "
");
    } else if own_state == 1 && ck == 10 {
        emit_str(s, out, "  ");
        stg = new_temp(s, out);
        emit_str(s, out, " = getelementptr i64, ptr @__loment_qual, i64 ");
        emit_dec(s, out, c);
        emit_str(s, out, "
");
    }
    let rv: u32 = cap_rev_tmp(s, out, c);
    emit_str(s, out, "  call void @__loment_guard2(ptr ");
    if stg != 0 {
        emit_str(s, out, "%t");
        emit_dec(s, out, stg);
    } else {
        emit_str(s, out, "@__loment_qual");
    }
    emit_str(s, out, ", i64 ");
    emit_dec(s, out, c);
    emit_str(s, out, ", i64 %t");
    emit_dec(s, out, v64);
    emit_str(s, out, ", i64 ");
    if has_aux == 1 {
        emit_str(s, out, "%t");
        emit_dec(s, out, a64);
    } else {
        emit_str(s, out, "0");
    }
    emit_str(s, out, ", i64 ");
    emit_dec(s, out, load32(s, cap_base(c) + 8));
    emit_str(s, out, ", i64 ");
    emit_dec(s, out, load32(s, cap_base(c) + 12));
    emit_str(s, out, ", i64 ");
    emit_dec(s, out, ck + 128);
    emit_str(s, out, ", i64 ");
    emit_dec(s, out, pk >> 8);
    emit_str(s, out, ", i64 ");
    emit_dec(s, out, (pk >> 4) & 3);
    emit_str(s, out, ", ptr ");
    if rv != 0 {
        emit_str(s, out, "%t");
        emit_dec(s, out, rv);
    } else {
        emit_str(s, out, "@__loment_revfree");
    }
    emit_str(s, out, ")
");
    return 0;
}

/// 能力型目标的联动伙伴（`docs/315` §5）：块在前、能力在后 —— 与参考实现同序。
fn cap_partners(s: ptr, out: ptr, src: ptr, toks: ptr, ci: u32,
                v64: u32, has_aux: u32, a64: u32) -> u32 {
    if ci == 4294967295 || load32(s, CG_CPN) == 0 {
        return 0;
    }
    let nm: u32 = load32(s, cap_base(ci));
    let n: u32 = load32(s, CG_DOM_N);
    let k: u32 = 1;
    while k <= n {
        let kn: u32 = load32(s, dom_at(k - 1, 8));
        if kn != 0 && cp_conn(s, src, toks, nm, kn, 8) == 1 {
            let _r: u32 = dom_one(s, out, k, v64, has_aux, a64, 1, 1);
        }
        k = k + 1;
    }
    let nc: u32 = load32(s, 536);
    let c: u32 = 0;
    while c < nc {
        if c != ci && cp_conn(s, src, toks, nm, load32(s, cap_base(c)), 8) == 1 {
            let _r2: u32 = dom_partner_cap(s, out, c, v64, has_aux, a64, 1);
        }
        c = c + 1;
    }
    return 0;
}

/// 质量写到整组（`docs/315` §5.2）：只给 **adaptive** 成员写，块在前、能力在后。
fn dom_qual_partners(s: ptr, out: ptr, src: ptr, toks: ptr, nm: u32,
                     dw: u32, tci: u32, q64: u32) -> u32 {
    if nm == 0 || load32(s, CG_CPN) == 0 {
        return 0;
    }
    let n: u32 = load32(s, CG_DOM_N);
    let k: u32 = 1;
    while k <= n {
        if k != dw && load32(s, dom_at(k - 1, 4)) == 10
                && cp_conn(s, src, toks, nm, load32(s, dom_at(k - 1, 8)), 8) == 1 {
            emit_str(s, out, "  call void @__loment_qual_store(ptr ");
            let stt: u32 = load32(s, dom_at(k - 1, 7));
            if stt != 0 {
                emit_str(s, out, "%t");
                emit_dec(s, out, stt);
            } else {
                emit_str(s, out, "@__loment_qual");
            }
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, q64);
            emit_str(s, out, ")
");
        }
        k = k + 1;
    }
    let nc: u32 = load32(s, 536);
    let c: u32 = 0;
    while c < nc {
        let pk: u32 = load32(s, cap_base(c) + 20);
        if c != tci && (pk & 15) == 10
                && cp_conn(s, src, toks, nm, load32(s, cap_base(c)), 8) == 1 {
            emit_str(s, out, "  ");
            let pg: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr i64, ptr @__loment_qual, i64 ");
            emit_dec(s, out, c);
            emit_str(s, out, "
");
            emit_str(s, out, "  call void @__loment_qual_store(ptr %t");
            emit_dec(s, out, pg);
            emit_str(s, out, ", i64 %t");
            emit_dec(s, out, q64);
            emit_str(s, out, ")
");
        }
        c = c + 1;
    }
    return 0;
}

/// 目标域 `top` 的联动伙伴（块的按声明序、能力的按表序 —— 与参考实现的排序一致）。
fn dom_partners(s: ptr, out: ptr, src: ptr, toks: ptr, top: u32,
                v64: u32, has_aux: u32, a64: u32, own_state: u32) -> u32 {
    let nm: u32 = load32(s, dom_at(top - 1, 8));
    if nm == 0 || load32(s, CG_CPN) == 0 {
        return 0;
    }
    let sp: u32 = load32(s, dom_at(top - 1, 1));
    let n: u32 = load32(s, CG_DOM_N);
    let k: u32 = 1;
    while k <= n {
        let same_chain: u32 = 0;
        if k <= top && tok_eq(src, toks, load32(s, dom_at(k - 1, 1)), sp) {
            same_chain = 1;
        }
        let kn: u32 = load32(s, dom_at(k - 1, 8));
        if k != top && kn != 0 && same_chain == 0
                && cp_conn(s, src, toks, nm, kn, 8) == 1 {
            let _r: u32 = dom_one(s, out, k, v64, has_aux, a64, 1, own_state);
        }
        k = k + 1;
    }
    let nc: u32 = load32(s, 536);
    let c: u32 = 0;
    while c < nc {
        let cn2: u32 = load32(s, cap_base(c));
        if cp_conn(s, src, toks, nm, cn2, 8) == 1 {
            let _r2: u32 = dom_partner_cap(s, out, c, v64, has_aux, a64, own_state);
        }
        c = c + 1;
    }
    return 0;
}

/// 显式 `guard NAME(x)` 的**整条链**（外→内；只有被点名的那层记账 / 转移，
/// `docs/315` §4.1）。祖先带 silent 位 —— 与自动守卫 `dom_auto_guard` 同一条规则。
fn dom_chain(s: ptr, out: ptr, src: ptr, toks: ptr, top: u32,
             v64: u32, has_aux: u32, a64: u32) -> u32 {
    let sp: u32 = load32(s, dom_at(top - 1, 1));
    let d: u32 = 1;
    while d <= top {
        if tok_eq(src, toks, load32(s, dom_at(d - 1, 1)), sp) {
            let silent: u32 = 1;
            if d == top {
                silent = 0;
            }
            let _r: u32 = dom_one(s, out, d, v64, has_aux, a64, silent, 1);
        }
        d = d + 1;
    }
    // 联动伙伴跟在被点名的那层之后（参考实现的顺序：链 → 伙伴）。
    let _p: u32 = dom_partners(s, out, src, toks, top, v64, has_aux, a64, 1);
    return 0;
}

fn df_nvars(src: ptr, toks: ptr, j: u32) -> u32 {
    let n: u32 = 1;
    let q: u32 = j + 4;
    while tok_is(src, toks, q, ",") {
        n = n + 1;
        q = q + 2;
    }
    return n;
}

/// 域名列表的起点（0 = 没有 `in`，用最内层那个域）。
fn df_dstart(src: ptr, toks: ptr, j: u32) -> u32 {
    // 变量列表之后的那个 token：首个变量在 j+3，每多一个占 2 格（`,` + 名字）。
    let q: u32 = j + 2 + df_nvars(src, toks, j) * 2;
    if tok_is(src, toks, q, "in") {
        return q + 1;
    }
    return 0;
}

fn df_ndoms(src: ptr, toks: ptr, j: u32) -> u32 {
    let d: u32 = df_dstart(src, toks, j);
    if d == 0 {
        return 1;
    }
    let n: u32 = 1;
    let q: u32 = d + 1;
    while tok_is(src, toks, q, ",") {
        n = n + 1;
        q = q + 2;
    }
    return n;
}

fn dom_for(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    let nv: u32 = df_nvars(src, toks, j);
    let ds: u32 = df_dstart(src, toks, j);
    let nd: u32 = df_ndoms(src, toks, j);
    if nd != nv {
        return cg_fail(s, 2, j);
    }
    let after: u32 = 0;
    if ds != 0 {
        after = ds + nd * 2 - 1;
    } else {
        after = j + 2 + nv * 2;
    }
    let rev: u32 = 0;
    let stp: u32 = 1;
    let k: u32 = after;
    if tok_is(src, toks, k, "step") {
        k = k + 1;
        if tok_is(src, toks, k, "-") {
            rev = 1;
            k = k + 1;
        }
        stp = tok_int(src, toks, k);
        k = k + 1;
    }
    // 目标域 + 跨度一致
    let dw0: u32 = 0;
    if ds != 0 {
        dw0 = dom_by_name(s, src, toks, ds);
    } else {
        dw0 = load32(s, CG_DOM_N);
    }
    if dw0 == 0 {
        return cg_fail(s, 2, j);
    }
    let span0: u32 = load32(s, dom_at(dw0 - 1, 3)) - load32(s, dom_at(dw0 - 1, 2));
    let i: u32 = 1;
    while i < nv {
        let dwi: u32 = dom_by_name(s, src, toks, ds + i * 2);
        if dwi == 0 {
            return cg_fail(s, 2, j);
        }
        if load32(s, dom_at(dwi - 1, 3)) - load32(s, dom_at(dwi - 1, 2)) != span0 {
            return cg_fail(s, 2, j);
        }
        i = i + 1;
    }
    // let VAR: u32 = 起点（反向从 hi 开始）
    i = 0;
    while i < nv {
        let dwi: u32 = dw0;
        if i != 0 {
            dwi = dom_by_name(s, src, toks, ds + i * 2);
        }
        emit_str(s, out, "  store i32 ");
        if rev == 1 {
            emit_dec(s, out, load32(s, dom_at(dwi - 1, 3)));
        } else {
            emit_dec(s, out, load32(s, dom_at(dwi - 1, 2)));
        }
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, j + 3 + i * 2);
        emit_str(s, out, ".addr\n");
        i = i + 1;
    }
    let w: u32 = load32(s, 480) + 1;
    store32(s, 480, w + 2);
    jump(s, out, w, "wcond");
    lab_def(s, out, w, "wcond");
    let _lv: u32 = load_var(s, out, src, toks, j + 3, 0);
    emit_str(s, out, "  ");
    let cn: u32 = new_temp(s, out);
    if rev == 1 {
        emit_str(s, out, " = icmp uge i32 ");
    } else {
        emit_str(s, out, " = icmp ule i32 ");
    }
    emit_val(s, out, 0);
    emit_str(s, out, ", ");
    if rev == 1 {
        emit_dec(s, out, load32(s, dom_at(dw0 - 1, 2)));
    } else {
        emit_dec(s, out, load32(s, dom_at(dw0 - 1, 3)));
    }
    emit_str(s, out, "\n  br i1 %t");
    emit_dec(s, out, cn);
    emit_str(s, out, ", label ");
    lab_ref(s, out, w + 1, "wbody");
    emit_str(s, out, ", label ");
    lab_ref(s, out, w + 2, "wend");
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    lab_def(s, out, w + 1, "wbody");
    // 循环头已证的位置入表（并行的每对都记），离开时按计数还原
    let opn: u32 = load32(s, CG_DPN);
    if opn + nv > CG_DPT_MAX {
        return cg_fail(s, 2, j);
    }
    i = 0;
    while i < nv {
        let dwi: u32 = dw0;
        if i != 0 {
            dwi = dom_by_name(s, src, toks, ds + i * 2);
        }
        if opn + i < CG_DPT_MAX {
            store32(s, CG_DPT + (opn + i) * 12, j + 3 + i * 2);
            store32(s, CG_DPT + (opn + i) * 12 + 4, load32(s, dom_at(dwi - 1, 1)));
            store32(s, CG_DPT + (opn + i) * 12 + 8, load32(s, dom_at(dwi - 1, 0)));
        }
        i = i + 1;
    }
    store32(s, CG_DPN, opn + nv);
    // 头守卫：每对一条整链（外→内，只有被点名的那层记账）
    i = 0;
    while i < nv {
        let dwi: u32 = dw0;
        if i != 0 {
            dwi = dom_by_name(s, src, toks, ds + i * 2);
        }
        let _gv: u32 = load_var(s, out, src, toks, j + 3 + i * 2, 0);
        emit_str(s, out, "  ");
        let g64: u32 = new_temp(s, out);
        emit_str(s, out, " = zext i32 ");
        emit_val(s, out, 0);
        emit_str(s, out, " to i64\n");
        let _ch: u32 = dom_chain(s, out, src, toks, dwi, g64, 0, 0);
        i = i + 1;
    }
    let ob: u32 = load32(s, CG_LBRK);
    let ocd: u32 = load32(s, CG_LCOND);
    let okd: u32 = load32(s, CG_LKIND);
    let osv: u32 = load32(s, CG_LSV);
    let oax: u32 = load32(s, CG_LAUX);
    store32(s, CG_LBRK, w + 2);
    store32(s, CG_LCOND, w);
    store32(s, CG_LKIND, 0);
    store32(s, CG_LAUX, 0);
    let odep: u32 = load32(s, CG_LDEPTH);
    let dfr: u32 = dfr_push(s);
    store32(s, CG_LDEPTH, dfr);
    let b: u32 = k + 1;                        // '{' 之后
    while !tok_is(src, toks, b, "}") && tok_kind(toks, b) != 4 {
        b = stmt(s, out, src, toks, b, ret);
    }
    let _de: u32 = dfr_end(s, out, src, toks, dfr, ret);
    // VAR = VAR ± N
    i = 0;
    while i < nv {
        let _sv: u32 = load_var(s, out, src, toks, j + 3 + i * 2, 0);
        emit_str(s, out, "  ");
        let an: u32 = new_temp(s, out);
        emit_str(s, out, " = add i32 ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ");
        if rev == 1 {
            // 参考实现把负步长按 **u32 回绕**印出来（`-2` -> `4294967294`）——
            // 两边逐字节比，所以这里也印回绕后的值。
            emit_dec(s, out, 0 - stp);
        } else {
            emit_dec(s, out, stp);
        }
        emit_str(s, out, "\n  store i32 %t");
        emit_dec(s, out, an);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, j + 3 + i * 2);
        emit_str(s, out, ".addr\n");
        i = i + 1;
    }
    if load32(s, 476) == 0 {
        let _t: u32 = emit_tick(s, out);       // docs/315：回边即 tick
    }
    jump(s, out, w, "wcond");
    lab_def(s, out, w + 2, "wend");
    store32(s, CG_LBRK, ob);
    store32(s, CG_LCOND, ocd);
    store32(s, CG_LKIND, okd);
    store32(s, CG_LSV, osv);
    store32(s, CG_LAUX, oax);
    store32(s, CG_LDEPTH, odep);
    store32(s, CG_DPN, opn);
    return b + 1;
}


/// 一条语句; 返回下一个待处理 token 下标。
/// `docs/314` §2：域块。单独一支函数 —— 它自己的局部变量不该压进 `stmt` 的栈帧
/// （PE 默认栈 1 MB；放进 `stmt` 会把大单元推过界，实测 ansi/tui）。
fn dom_stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
        let k: u32 = j + 1;
        let nm: u32 = 0;
        if tok_kind(toks, k) == 0 && tok_is(src, toks, k + 1, ":") {
            nm = k;
            k = k + 2;
        }
        let sp: u32 = k;
        // `docs/318`：五种**区域形状**（borrow / borrow_mut / window / split / cursor）。
        // 形状是区域不是位置 —— 参考实现那边它们是 `kind=regular`、只发体，这里同样
        // 跳过形状直接跑到 `{`，收尾与普通域块同一段。
        if tok_kind(toks, sp) == 0 && is_region_shape(src, toks, sp) == 1
                && tok_is(src, toks, sp + 1, "(") {
            let lb: u32 = sp + 1;
            while tok_kind(toks, lb) != 4 && !tok_is(src, toks, lb, "{") {
                lb = lb + 1;
            }
            return dom_body(s, out, src, toks, lb, ret);
        }
        // `domain e : epoch { … }`（期 3）：形状是"本块"，块与普通块同形。
        if tok_kind(toks, sp) == 0 && tok_is(src, toks, sp, "epoch")
                && tok_is(src, toks, sp + 1, "{") {
            return dom_body(s, out, src, toks, sp + 1, ret);
        }
        let q: u32 = sp + 2;
        let lof: u32 = 0;
        let lo: u32 = 0;
        if tok_is(src, toks, q, "(") {
            lof = 1;
            q = q + 2;
        } else {
            lo = tok_int(src, toks, q);
            q = q + 1;
        }
        q = q + 2;
        let hif: u32 = 0;
        let hi: u32 = 0;
        if tok_is(src, toks, q, "(") {
            hif = 1;
            q = q + 2;
        } else {
            hi = tok_int(src, toks, q);
            q = q + 1;
        }
        q = q + 1;
        let kind: u32 = 0;
        let param: u32 = 0;
        if tok_is(src, toks, q, "danger") || tok_is(src, toks, q, "adaptive")
                || tok_is(src, toks, q, "flow") {
            if tok_is(src, toks, q, "danger") { kind = 1; }
            if tok_is(src, toks, q, "adaptive") { kind = 10; }
            if tok_is(src, toks, q, "flow") { kind = 13; }
            q = q + 1;
        } else if tok_is(src, toks, q, "epoch") || tok_is(src, toks, q, "far")
                || tok_is(src, toks, q, "sliding") || tok_is(src, toks, q, "decaying")
                || tok_is(src, toks, q, "growing") || tok_is(src, toks, q, "consumed")
                || tok_is(src, toks, q, "cyclic") || tok_is(src, toks, q, "generational")
                || tok_is(src, toks, q, "subject") || tok_is(src, toks, q, "witnessed")
                || tok_is(src, toks, q, "reachable") {
            if tok_is(src, toks, q, "epoch") { kind = 2; }
            if tok_is(src, toks, q, "far") { kind = 3; }
            if tok_is(src, toks, q, "sliding") { kind = 4; }
            if tok_is(src, toks, q, "decaying") { kind = 5; }
            if tok_is(src, toks, q, "growing") { kind = 6; }
            if tok_is(src, toks, q, "consumed") { kind = 7; }
            if tok_is(src, toks, q, "cyclic") { kind = 8; }
            if tok_is(src, toks, q, "generational") { kind = 9; }
            if tok_is(src, toks, q, "subject") { kind = 11; }
            if tok_is(src, toks, q, "witnessed") { kind = 12; }
            if tok_is(src, toks, q, "reachable") { kind = 14; }
            param = tok_int(src, toks, q + 2);
            q = q + 4;
        }
        let rv: u32 = 0;
        if tok_is(src, toks, q, "revocable") {
            rv = 1;
            q = q + 1;
        }
        while tok_kind(toks, q) != 4 && !tok_is(src, toks, q, "{") {
            q = q + 1;
        }
        let d: u32 = load32(s, CG_DOM_N);
        if d >= CG_DOM_MAX {
            return cg_fail(s, 2, j);
        }
        let id: u32 = load32(s, CG_DOM_ID);
        store32(s, CG_DOM_ID, id + 1);
        store32(s, dom_at(d, 0), id);
        store32(s, dom_at(d, 1), sp);
        store32(s, dom_at(d, 2), lo);
        store32(s, dom_at(d, 3), hi);
        store32(s, dom_at(d, 4), kind);
        store32(s, dom_at(d, 5), param);
        store32(s, dom_at(d, 6), lof | (hif << 1));
        store32(s, dom_at(d, 7), 0);
        store32(s, dom_at(d, 8), nm);
        store32(s, dom_at(d, 9), 0);
        // 撤销位对（`docs/306` §6.1 C2）：块入口清零 = **新实例**；位置在状态块之前，
        // 与参考实现的发射顺序一致（孪生判据逐字节核）。
        if rv == 1 {
            emit_str(s, out, "  ");
            let rvt: u32 = new_temp(s, out);
            emit_str(s, out, " = alloca [2 x i64]
  store i64 0, ptr %t");
            emit_dec(s, out, rvt);
            emit_str(s, out, "
  ");
            let rmt: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr [2 x i64], ptr %t");
            emit_dec(s, out, rvt);
            emit_str(s, out, ", i64 0, i64 1
  store i64 0, ptr %t");
            emit_dec(s, out, rmt);
            emit_str(s, out, "
");
            store32(s, dom_at(d, 9), rvt);
        }
        if kind == 7 || kind == 10 || kind == 12 || kind == 14 {
            emit_str(s, out, "  ");
            let pt: u32 = new_temp(s, out);
            emit_str(s, out, " = alloca [64 x i64]
  ");
            let ct: u32 = new_temp(s, out);
            emit_str(s, out, " = alloca i64
  store i64 0, ptr %t");
            emit_dec(s, out, ct);
            emit_str(s, out, "
");
            let l1: u32 = load32(s, 480) + 1;
            store32(s, 480, l1 + 2);
            jump(s, out, l1, "dzc");
            lab_def(s, out, l1, "dzc");
            emit_str(s, out, "  ");
            let vt: u32 = new_temp(s, out);
            emit_str(s, out, " = load i64, ptr %t");
            emit_dec(s, out, ct);
            emit_str(s, out, "
  ");
            let cmpt: u32 = new_temp(s, out);
            emit_str(s, out, " = icmp ult i64 %t");
            emit_dec(s, out, vt);
            emit_str(s, out, ", 64
  br i1 %t");
            emit_dec(s, out, cmpt);
            emit_str(s, out, ", label ");
            lab_ref(s, out, l1 + 1, "dzb");
            emit_str(s, out, ", label ");
            lab_ref(s, out, l1 + 2, "dzd");
            emit_str(s, out, "
");
            lab_def(s, out, l1 + 1, "dzb");
            emit_str(s, out, "  ");
            let gt: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr [64 x i64], ptr %t");
            emit_dec(s, out, pt);
            emit_str(s, out, ", i64 0, i64 %t");
            emit_dec(s, out, vt);
            emit_str(s, out, "
  store i64 0, ptr %t");
            emit_dec(s, out, gt);
            emit_str(s, out, "
  ");
            let vt1: u32 = new_temp(s, out);
            emit_str(s, out, " = add i64 %t");
            emit_dec(s, out, vt);
            emit_str(s, out, ", 1
  store i64 %t");
            emit_dec(s, out, vt1);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, ct);
            emit_str(s, out, "
");
            jump(s, out, l1, "dzc");
            lab_def(s, out, l1 + 2, "dzd");
            if kind == 10 {
                emit_str(s, out, "  store i64 255, ptr %t");
                emit_dec(s, out, pt);
                emit_str(s, out, "
");
            }
            store32(s, dom_at(d, 7), pt);
        }
        store32(s, CG_DOM_N, d + 1);
        let r: u32 = dom_body(s, out, src, toks, q, ret);
        store32(s, CG_DOM_N, d);
        return r;
}

/// 域块的收尾：块体是一层语句表，体内的 `defer` 在块尾按 LIFO 跑（与参考的
/// `self.block` 同序）。`lb` 是 `{` 的位置。普通域块与区域形状（`docs/318`）共用。
fn dom_body(s: ptr, out: ptr, src: ptr, toks: ptr, lb: u32, ret: u32) -> u32 {
    let dfr: u32 = dfr_push(s);
    let k2: u32 = lb + 1;
    while !tok_is(src, toks, k2, "}") && tok_kind(toks, k2) != 4 {
        k2 = stmt(s, out, src, toks, k2, ret);
    }
    let _de: u32 = dfr_end(s, out, src, toks, dfr, ret);
    return k2 + 1;
}

/// 臂体结束位置。普通臂是块（`skip_block`）；表达式臂是单表达式 —— 返回深度 0 的
/// `,` 或 match 的收尾 `}`（`docs/336`，`let` 初值里的 match 表达式）。
fn m_arm_end(s: ptr, src: ptr, toks: ptr, start: u32, stop: u32, exprm: u32) -> u32 {
    if exprm == 0 {
        return skip_block(src, toks, start);
    }
    let d: u32 = 0;
    let k: u32 = start;
    while k < stop && tok_kind(toks, k) != 4 {
        if tok_is(src, toks, k, "(") || tok_is(src, toks, k, "[")
                || tok_is(src, toks, k, "{") {
            d = d + 1;
        } else if tok_is(src, toks, k, ")") || tok_is(src, toks, k, "]") {
            d = d - 1;
        } else if tok_is(src, toks, k, "}") {
            if d == 0 {
                return k;
            }
            d = d - 1;
        } else if d == 0 && tok_is(src, toks, k, ",") {
            return k;
        }
        k = k + 1;
    }
    return k;
}

fn emit_match_at(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32,
                  mtgt: u32, mty: u32) -> u32 {
    let exprm: u32 = 0;
    if mtgt != 0 {
        exprm = 1;
    }
    let st: u32 = expr_type(s, src, toks, j + 1);
    let ei: u32 = find_enum(s, src, toks, st);
    let mend: u32 = load32(s, 480) + 1;
    store32(s, 480, mend);
    let md: u32 = load32(s, 548);
    store32(s, 548, md + 1);
    let slvl: u32 = 30 + md * 2;      // 主体值的稳定槽 (嵌套 match 不互相踩)
    expr_bin(s, out, src, toks, j + 1, 1, 0, 0);
    move_val(s, slvl, 0);
    let pay: u32 = load32(s, enum_base(ei) + 8);
    let tagt: u32 = 0;
    if pay == 1 {
        emit_str(s, out, "  ");
        tagt = new_temp(s, out);
        emit_str(s, out, " = extractvalue { i32, i64 } ");
        emit_val(s, out, slvl);
        emit_str(s, out, ", 0\n");
    }
    let stop: u32 = skip_block(src, toks, j + 2);
    // 第一遍: 按臂序占标签 (通配臂占号时机与 lomentc 一致), 记在 560+i*4
    let wild: u32 = mend;
    let arms: u32 = 0;
    let k: u32 = j + 3;   // '{' 之后才是第一个臂头
    while k < stop && !tok_is(src, toks, k, "}") && arms < 12 {
        let p: u32 = k;
        let iswild: u32 = 1;
        while p < stop && !(tok_is(src, toks, p, "=") && tok_is(src, toks, p + 1, ">")) {
            if tok_is(src, toks, p, ":") && tok_is(src, toks, p + 1, ":") {
                iswild = 0;
            }
            p = p + 1;
        }
        let lb: u32 = load32(s, 480) + 1;
        store32(s, 480, lb);
        store32(s, CG_ARM + arms * 4, lb);
        if iswild == 1 {
            wild = lb;
        }
        k = m_arm_end(s, src, toks, p + 2, stop, exprm);   // '=>' 后的臂体
        if exprm == 1 && tok_is(src, toks, k, ",") {
            k = k + 1;
        }
        arms = arms + 1;
    }
    // 发 switch
    emit_str(s, out, "  switch i32 ");
    if pay == 1 {
        emit_str(s, out, "%t");
        emit_dec(s, out, tagt);
    } else {
        emit_val(s, out, slvl);
    }
    emit_str(s, out, ", label %L");
    emit_dec(s, out, wild);
    // 默认目标的**名字**必须跟号一致: 没有通配臂时 wild == mend, 该写 `_mend`。
    // 原先无条件拼 `_mwild`, 于是"覆盖全部变体且不写 `_`"的 match 会发一个
    // 引用**未定义标签**的 switch —— 到链接期才炸, 两个后端都收不了。
    if wild == mend {
        emit_str(s, out, "_mend [\n");
    } else {
        emit_str(s, out, "_mwild [\n");
    }
    let a2: u32 = 0;
    let k2: u32 = j + 3;
    while k2 < stop && !tok_is(src, toks, k2, "}") && a2 < 12 {
        let p2: u32 = k2;
        let isw2: u32 = 1;
        while p2 < stop && !(tok_is(src, toks, p2, "=") && tok_is(src, toks, p2 + 1, ">")) {
            if tok_is(src, toks, p2, ":") && tok_is(src, toks, p2 + 1, ":") {
                isw2 = 0;
            }
            p2 = p2 + 1;
        }
        let body2: u32 = m_arm_end(s, src, toks, p2 + 2, stop, exprm);
        if isw2 == 0 {
            let vi2: u32 = enum_variant_index(s, src, toks, ei, k2 + 3);
            emit_str(s, out, "      i32 ");
            emit_dec(s, out, vi2);
            emit_str(s, out, ", label %L");
            emit_dec(s, out, load32(s, CG_ARM + a2 * 4));
            emit_str(s, out, "_m");
            emit_tok(s, out, src, toks, k2 + 3);
            emit_str(s, out, "\n");
        }
        k2 = body2;
        if exprm == 1 && tok_is(src, toks, k2, ",") {
            k2 = k2 + 1;
        }
        a2 = a2 + 1;
    }
    emit_str(s, out, "    ]\n");
    store32(s, 476, 1);
    // 第二遍: 逐臂发标签/绑定/臂体/跳转
    let a3: u32 = 0;
    let k3: u32 = j + 3;
    while k3 < stop && !tok_is(src, toks, k3, "}") && a3 < 12 {
        let p3: u32 = k3;
        let isw3: u32 = 1;
        while p3 < stop && !(tok_is(src, toks, p3, "=") && tok_is(src, toks, p3 + 1, ">")) {
            if tok_is(src, toks, p3, ":") && tok_is(src, toks, p3 + 1, ":") {
                isw3 = 0;
            }
            p3 = p3 + 1;
        }
        let lab3: u32 = load32(s, CG_ARM + a3 * 4);
        let be3: u32 = m_arm_end(s, src, toks, p3 + 2, stop, exprm);   // 臂体范围 (两个分支共用)
        if isw3 == 1 {
            store32(s, 476, 0);
            store32(s, 488, lab3);
            store32(s, 496, 0);
            emit_str(s, out, "L");
            emit_dec(s, out, lab3);
            emit_str(s, out, "_mwild:\n");
            if exprm == 1 {
                let _wv: u32 = expr_bin(s, out, src, toks, p3 + 2, 1, 0, mty);
                emit_str(s, out, "  store ");
                emit_ty(s, out, src, toks, mty);
                emit_str(s, out, " ");
                emit_val(s, out, 0);
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, mtgt);
                emit_str(s, out, ".addr\n");
            } else {
                let s4: u32 = p3 + 3;
                let wadfr: u32 = dfr_push(s);   // 臂体是一层语句表（docs/296 §2.3）
                while s4 < be3 - 1 && !tok_is(src, toks, s4, "}") && tok_kind(toks, s4) != 4 {
                    s4 = stmt(s, out, src, toks, s4, load32(s, 552));
                }
                let _wae: u32 = dfr_end(s, out, src, toks, wadfr, load32(s, 552));
            }
        } else {
            store32(s, 476, 0);
            store32(s, 488, lab3);
            store32(s, 496, 0);
            emit_str(s, out, "L");
            emit_dec(s, out, lab3);
            emit_str(s, out, "_m");
            emit_tok(s, out, src, toks, k3 + 3);
            emit_str(s, out, ":\n");
            if tok_is(src, toks, k3 + 4, "(") {   // 载荷绑定
                let vt3: u32 = enum_variant_index(s, src, toks, ei, k3 + 3);
                let pstub: u32 = push_ty_subst(s, src, toks, st);   // 主体的实例化
                let pt3: u32 = enum_payload_type(s, src, toks, ei, vt3);
                let raw: u32 = alloc_temp(s);   // new_temp 会自己写 %tN, 这里手写
                emit_str(s, out, "  %t");
                emit_dec(s, out, raw);
                emit_str(s, out, " = extractvalue { i32, i64 } ");
                emit_val(s, out, slvl);
                emit_str(s, out, ", 1\n");
                if bit_width(pt3, src, toks) >= 64 {
                    emit_str(s, out, "  store i64 %t");
                    emit_dec(s, out, raw);
                    emit_str(s, out, ", ptr %");
                    emit_name_tok(s, out, src, toks, k3 + 5);
                    emit_str(s, out, ".addr\n");
                } else {
                    let cv: u32 = alloc_temp(s);
                    emit_str(s, out, "  %t");
                    emit_dec(s, out, cv);
                    emit_str(s, out, " = trunc i64 %t");
                    emit_dec(s, out, raw);
                    emit_str(s, out, " to ");
                    emit_ty(s, out, src, toks, pt3);
                    emit_str(s, out, "\n  store ");
                    emit_ty(s, out, src, toks, pt3);
                    emit_str(s, out, " %t");
                    emit_dec(s, out, cv);
                    emit_str(s, out, ", ptr %");
                    emit_name_tok(s, out, src, toks, k3 + 5);
                    emit_str(s, out, ".addr\n");
                }
                pop_subst(s, pstub);
            }
            if exprm == 1 {
                let _vv: u32 = expr_bin(s, out, src, toks, p3 + 2, 1, 0, mty);
                emit_str(s, out, "  store ");
                emit_ty(s, out, src, toks, mty);
                emit_str(s, out, " ");
                emit_val(s, out, 0);
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, mtgt);
                emit_str(s, out, ".addr\n");
            } else {
                let be: u32 = be3;
                let s3: u32 = p3 + 3;   // '{' 之后
                let nadfr: u32 = dfr_push(s);   // 臂体是一层语句表（docs/296 §2.3）
                while s3 < be - 1 && !tok_is(src, toks, s3, "}") && tok_kind(toks, s3) != 4 {
                    s3 = stmt(s, out, src, toks, s3, load32(s, 552));
                }
                let _nae: u32 = dfr_end(s, out, src, toks, nadfr, load32(s, 552));
            }
        }
        jump(s, out, mend, "mend");
        k3 = be3;
        if exprm == 1 && tok_is(src, toks, k3, ",") {
            k3 = k3 + 1;
        }
        a3 = a3 + 1;
    }
    store32(s, 476, 0);
    lab_def(s, out, mend, "mend");
    store32(s, 548, md);
    return stop;
}

fn stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    // **语句边界清 spill 槽**（`#1465`）：分配结果只活到本条语句结束，不活到帧尾。
    if load32(s, 476) == 0 && gc_hook(s) == 1 {
        gc_flush(s, out);
    }
    if load32(s, CG_PROF) == 2 && tok_kind(toks, j) == 0 && tok_is(src, toks, j, "lgc") {
        // `lgc` 的时间控制（`docs/309`）：只在 Tur 2026.3 是关键字。
        return lgc_stmt(s, out, src, toks, j, ret);
    }
    if load32(s, CG_PROF) != 0 && tok_kind(toks, j) == 0 && tok_is(src, toks, j, "defer") {
        return dfr_stmt(s, out, src, toks, j, ret);
    }
    if load32(s, CG_PROF) != 0 && tok_kind(toks, j) == 0
            && (tok_is(src, toks, j, "break") || tok_is(src, toks, j, "continue")) {
        // Tur 2 的循环控制（`docs/296` §2.5）。顺序与参考实现一致：`continue` 先跑续步
        // （for-in 的下标 / range-for 的变量 —— 与体尾同一份指令），再关纪元，最后跳。
        let lb: u32 = load32(s, CG_LBRK);
        if lb == 0 {                       // 检查器已经拒了；走到这里是发射器的错
            return cg_fail(s, 2, j);
        }
        // 离开循环体那一块：体内帧的 `defer` 先跑（docs/296 §2.3），再走续步/跳转
        let _dfr: u32 = dfr_run(s, out, src, toks, load32(s, CG_LDEPTH), ret);
        let cont: u32 = 0;
        let kd: u32 = load32(s, CG_LKIND);
        if tok_is(src, toks, j, "continue") {
            cont = 1;
            if kd == 1 {
                fi_step(s, out, load32(s, CG_LAUX));
            }
            if kd == 2 {
                for_step(s, out, src, toks, load32(s, CG_LAUX));
            }
            let _tk3: u32 = emit_tick(s, out);   // docs/315：continue 也是回边
        }
        epoch_close(s, out, load32(s, CG_LSV));
        if cont == 1 {
            if kd == 2 {
                jump(s, out, load32(s, CG_LCOND), "fcond");
            } else {
                jump(s, out, load32(s, CG_LCOND), "wcond");
            }
        } else {
            if kd == 2 {
                jump(s, out, lb, "fend");
            } else {
                jump(s, out, lb, "wend");
            }
        }
        return j + 2;                      // 跳过 `;`
    }
    if load32(s, CG_PROF) != 0 && tok_is(src, toks, j, "return")
            && tok_is(src, toks, j + 1, ";") {
        // 裸 `return;`（`docs/296` §2.6）：函数没有返回类型（检查器已经核过）。退出路径与
        // 带值那条同序 —— L1 该还的还、`gc_auto` 的根表该退的退 —— 只是 `ret void`。
        let _dfr0: u32 = dfr_run(s, out, src, toks, 0, ret);
        lgc_restore_all(s, out);   // `lgc`：提前离开函数 = 离开所有窗口（docs/309）
        emit_l1(s, out, src, toks, 1, j, ret_end(src, toks, j, load32(s, 568)));
        if gc_hook(s) == 1 {
            roots_pop(s, out);
        }
        emit_str(s, out, "  ret void\n");
        store32(s, 476, 1);
        return j + 2;
    }
    if tok_is(src, toks, j, "return") {
        // `return Result::Ok(v)` 里的枚举名是**泛型基名**, 实例要靠函数返回类型解析
        // (镜像 lomentc._fix_generic_literals 对 Return 分支做的 e.expr.enum = f.ret)。
        // 非泛型返回类型时 push_ty_subst 直接返回 0 —— 无副作用。
        let rsub: u32 = push_ty_subst(s, src, toks, ret);
        let e: u32 = expr_bin(s, out, src, toks, j + 1, 1, 0, ret);
        pop_subst(s, rsub);
        // 返回值先挪到**第 38 层**：`defer` 重放用第 0 层，实参落在 1..N 层，不挪的话
        // `ret` 印出来的是被 defer 覆盖后的值（实测：`ret i32 %t2` / `ret ... 7`）。
        move_val(s, 38, 0);
        // `defer`（`docs/296` §2.3）：离开函数 = 离开所有块，由内向外跑完再 ret
        let _dfr: u32 = dfr_run(s, out, src, toks, 0, ret);
        lgc_restore_all(s, out);   // `lgc`：提前离开函数 = 离开所有窗口（docs/309）
        // L1 定活：返回值**已经读出来**了，现在可以还那块（档位门在 `emit_l1` 里面）
        emit_l1(s, out, src, toks, 1, j, ret_end(src, toks, j, load32(s, 568)));
        if gc_hook(s) == 1 {   // `gc_auto`：离开本帧前退根表（在求值之后、ret 之前）
            roots_pop(s, out);
        }
        emit_str(s, out, "  ret ");
        emit_ty(s, out, src, toks, ret);
        emit_str(s, out, " ");
        // 返回 ptr 而表达式就是字面量 0 时, lomentc 写 `null` (expr 的 want="ptr")
        if tok_is(src, toks, ret, "ptr") && tok_kind(toks, j + 1) == 1
                && tok_int(src, toks, j + 1) == 0 && e == j + 2 {
            emit_str(s, out, "null");
        } else {
            emit_val(s, out, 38);
        }
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        return e + 1;
    }
    if tok_is(src, toks, j, "let") {
        let name: u32 = j + 1;
        // **L0**（`docs/210` §2 / `gc_auto_alpha`）：这条 `alloc` 已经提到入口块的栈上了 ——
        // 不调分配器，只把缓冲地址存进局部槽（镜像 `lomentc._Ir.stmt` 的 `Let` 分支）。
        // 形状由 `l0_size` 认死（10 个 token），所以返回 1 时整条语句正好到 `j + 9`。
        if l0_store(s, out, src, toks, j) == 1 {
            return j + 10;
        }
        let ty: u32 = j + 3;
        let eq: u32 = skip_type(src, toks, ty);   // '=' 的位置 (类型可能是 [T; N] / [T])
        if load32(s, CG_PROF) >= 2 && tok_is(src, toks, eq + 1, "if") {
            // 2026.3 `let x: T = if c { a } else { b };`（`docs/335`）：参考实现把它
            // 降成 `let x: T;` + 一条 If，两支各 `x = …`。
            return let_ifexpr(s, out, src, toks, j, name, ty, eq);
        }
        if load32(s, CG_PROF) >= 2 && tok_is(src, toks, eq + 1, "match") {
            // 2026.3 `let x: T = match e { … };`（`docs/336`）：同一条路 ——
            // 参考实现降成 `let x: T;` + Match，每臂的表达式变成 `x = …`。
            return emit_match_at(s, out, src, toks, eq + 1, name, ty);
        }
        // M9: `let x: T = e?;` -> 临时绑定 + match (Err 早退); 替换表由 emit_try_let 自己管
        let qp: u32 = find_try_q(src, toks, eq + 1);
        if qp != 0 {
            emit_try_let(s, out, src, toks, name, ty, eq, j);
            return qp + 2;
        }
        // `let x: T = v orelse d;` / `... catch d;`（`docs/296` §2.4）
        if load32(s, CG_PROF) != 0 {
            let fbk: u32 = fb_tok(s, src, toks, eq + 1);
            if fbk != 0 {
                return emit_fallback(s, out, src, toks, name, eq + 1, fbk);
            }
        }
        // `let p: Pair<u32>` 的类型实参: 先推入替换, 再处理右侧 (字面量分支也要在表内)
        let lsub: u32 = push_ty_subst(s, src, toks, ty);
        if is_array_tok(src, toks, ty) == 1 && tok_is(src, toks, eq + 1, "[") {
            let arr_e: u32 = let_array_lit(s, out, src, toks, name, ty, eq + 1);
            pop_subst(s, lsub);
            return arr_e;
        }
        if tok_eq(src, toks, eq + 1, ty) && tok_is(src, toks, eq + 2, "{") {   // struct 字面量
            let st_e: u32 = let_struct_lit(s, out, src, toks, name, ty, eq + 2);
            pop_subst(s, lsub);
            return st_e;
        }
        let e2: u32 = expr_bin(s, out, src, toks, eq + 1, 1, 0, ty);
        pop_subst(s, lsub);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr\n");
        // **块内精确**（`docs/210` §2.9）：命中掩码的站点，把块头的借出标记从 `-1`
        // 改写成 `-(mask + 2)` —— 收集器于是只扫掩码里置了位的那些字（`-1` = 保守）。
        // **位置对着参考实现**：在那条 `store ... .addr` **之后**，与 `lomentc.stmt`
        // 的 `Let` 分支同序（先落局部槽，再改块头）。
        // 掩码不进任何表 —— 它就是这个 32 位字本身，所以这里**不需要**第二趟 token 走法
        // （早先那版为此要按 token 次序给站点编号，还得当心别把 `CG_CUR` 那张
        // **当前函数形参替换表** 踩掉 —— 实测：踩掉之后同一个单元里的枚举 `load` 会从
        // `{ i32, i64 }` 变成 `i32`，m88 当场红）。
        if load32(s, 572) == 1
                && tok_is(src, toks, ty, "ptr") && tok_is(src, toks, eq + 1, "alloc")
                && tok_is(src, toks, eq + 2, "(") {
            let k: u32 = slot_mask_at(src, toks, j + 1, load32(s, 564), load32(s, 568),
                                      load32(s, 12), ptr_add(s, CG_CUR), ptr_add(s, CG_SAFE));
            if k != 4294967295 {
                // **头在 `v - 4`，但不走 `getelementptr ... i32 -4`** —— 包内镜像链接器
                // 把 `i32` 立即数**零扩展**进 64 位再相加，`-4` 于是变成 +4294967292，
                // 产物直接段错误（clang 路没事，正是这条差别暴露的）。那条"指令子集"
                // 是硬约束（`docs/210` §8），所以这里绕开负立即数：三步走
                // `ptrtoint` / `sub i64` / `inttoptr`。与参考实现 `lomentc` 同序。
                emit_str(s, out, "  ");
                let h32: u32 = new_temp(s, out);
                emit_str(s, out, " = ptrtoint ptr ");
                emit_val(s, out, 0);
                emit_str(s, out, " to i64\n  ");
                let hs: u32 = new_temp(s, out);
                emit_str(s, out, " = sub i64 %t");
                emit_dec(s, out, h32);
                emit_str(s, out, ", 4\n  ");
                let h: u32 = new_temp(s, out);
                emit_str(s, out, " = inttoptr i64 %t");
                emit_dec(s, out, hs);
                emit_str(s, out, " to ptr\n");
                emit_str(s, out, "  store i32 -");
                emit_dec(s, out, k + 2);
                emit_str(s, out, ", ptr %t");
                emit_dec(s, out, h);
                emit_str(s, out, "\n");
            }
        }
        return e2 + 1;
    }
    if tok_is(src, toks, j, "if") && tok_is(src, toks, j + 1, "let") {
        // M10: `if let Enum::V(bind) = e { then } else { other }`。
        // lomentc 在 parser 里就把它反糖成 `Match(e, [(V(bind), then), (None, other)])`,
        // 这里等价地直发那份 Match 的 IR: 标签序 = mend, 命中臂, 通配臂。
        let iv: u32 = j + 5;
        let ib: u32 = j + 7;
        let subj: u32 = j + 10;
        let st: u32 = expr_type(s, src, toks, subj);
        let ei: u32 = find_enum(s, src, toks, st);
        let mend: u32 = load32(s, 480) + 1;
        store32(s, 480, mend);
        let md: u32 = load32(s, 548);
        store32(s, 548, md + 1);
        let slvl: u32 = 30 + md * 2;
        expr_bin(s, out, src, toks, subj, 1, 0, 0);
        move_val(s, slvl, 0);
        let pay: u32 = load32(s, enum_base(ei) + 8);
        let tagt: u32 = 0;
        if pay == 1 {
            emit_str(s, out, "  ");
            tagt = new_temp(s, out);
            emit_str(s, out, " = extractvalue { i32, i64 } ");
            emit_val(s, out, slvl);
            emit_str(s, out, ", 0\n");
        }
        let lok: u32 = load32(s, 480) + 1;
        store32(s, 480, lok);
        let lwd: u32 = load32(s, 480) + 1;
        store32(s, 480, lwd);
        let vi: u32 = enum_variant_index(s, src, toks, ei, iv);
        emit_str(s, out, "  switch i32 ");
        if pay == 1 {
            emit_str(s, out, "%t");
            emit_dec(s, out, tagt);
        } else {
            emit_val(s, out, slvl);
        }
        emit_str(s, out, ", label %L");
        emit_dec(s, out, lwd);
        emit_str(s, out, "_mwild [\n      i32 ");
        emit_dec(s, out, vi);
        emit_str(s, out, ", label %L");
        emit_dec(s, out, lok);
        emit_str(s, out, "_m");
        emit_tok(s, out, src, toks, iv);
        emit_str(s, out, "\n    ]\n");
        store32(s, 476, 1);
        // 命中臂
        store32(s, 476, 0);
        store32(s, 488, lok);
        store32(s, 496, 0);
        emit_str(s, out, "L");
        emit_dec(s, out, lok);
        emit_str(s, out, "_m");
        emit_tok(s, out, src, toks, iv);
        emit_str(s, out, ":\n");
        if tok_is(src, toks, j + 6, "(") {   // 载荷绑定
            let pstub: u32 = push_ty_subst(s, src, toks, st);
            let pt3: u32 = enum_payload_type(s, src, toks, ei, vi);
            let raw: u32 = alloc_temp(s);   // new_temp 会自己写 %tN, 这里手写
            emit_str(s, out, "  %t");
            emit_dec(s, out, raw);
            emit_str(s, out, " = extractvalue { i32, i64 } ");
            emit_val(s, out, slvl);
            emit_str(s, out, ", 1\n");
            if bit_width(pt3, src, toks) >= 64 {
                emit_str(s, out, "  store i64 %t");
                emit_dec(s, out, raw);
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, ib);
                emit_str(s, out, ".addr\n");
            } else {
                let cv: u32 = alloc_temp(s);
                emit_str(s, out, "  %t");
                emit_dec(s, out, cv);
                emit_str(s, out, " = trunc i64 %t");
                emit_dec(s, out, raw);
                emit_str(s, out, " to ");
                emit_ty(s, out, src, toks, pt3);
                emit_str(s, out, "\n  store ");
                emit_ty(s, out, src, toks, pt3);
                emit_str(s, out, " %t");
                emit_dec(s, out, cv);
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, ib);
                emit_str(s, out, ".addr\n");
            }
            pop_subst(s, pstub);
        }
        let tend: u32 = skip_block(src, toks, find_body(src, toks, subj) - 1);
        let k3: u32 = find_body(src, toks, subj);
        let hdfr: u32 = dfr_push(s);   // 命中臂是一层语句表（docs/296 §2.3）
        while k3 < tend - 1 && !tok_is(src, toks, k3, "}") && tok_kind(toks, k3) != 4 {
            k3 = stmt(s, out, src, toks, k3, load32(s, 552));
        }
        let _hde: u32 = dfr_end(s, out, src, toks, hdfr, load32(s, 552));
        jump(s, out, mend, "mend");
        lab_def(s, out, lwd, "mwild");
        let nxt: u32 = tend;
        if tok_is(src, toks, nxt, "else") {
            let ebody: u32 = find_body(src, toks, nxt + 1);
            let eend: u32 = skip_block(src, toks, ebody - 1);
            let k4: u32 = ebody;
            let edfr2: u32 = dfr_push(s);
            while k4 < eend - 1 && !tok_is(src, toks, k4, "}") && tok_kind(toks, k4) != 4 {
                k4 = stmt(s, out, src, toks, k4, load32(s, 552));
            }
            let _ede2: u32 = dfr_end(s, out, src, toks, edfr2, load32(s, 552));
            nxt = eend;
        }
        jump(s, out, mend, "mend");
        lab_def(s, out, mend, "mend");
        store32(s, 548, md);
        return nxt;
    }
    if tok_is(src, toks, j, "if") {
        return emit_if_at(s, out, src, toks, j + 1, ret);
    }
    let fi_new: u32 = 0;
    let fi_st: u32 = j + 3;
    let fi_vtok: u32 = j + 1;
    let fi_body: u32 = j + 5;
    if load32(s, CG_PROF) >= 2 && tok_is(src, toks, j, "for")
            && load32(toks, (j + 1) * 20) == 0 && tok_is(src, toks, j + 2, ",")
            && load32(toks, (j + 3) * 20) == 0 && tok_is(src, toks, j + 4, "in")
            && load32(toks, (j + 5) * 20) == 0 && tok_is(src, toks, j + 6, "{") {
        fi_new = 1;
        fi_st = j + 5;
        fi_vtok = j + 3;
        fi_body = j + 7;
    }
    let fi_expr: u32 = 0;
    if load32(s, CG_PROF) >= 2 && tok_is(src, toks, j, "for")
            && load32(toks, (j + 1) * 20) == 0 && tok_is(src, toks, j + 2, "in")
            && load32(toks, (j + 3) * 20) == 0 && tok_is(src, toks, j + 4, "(") {
        let cp: u32 = skip_parens(src, toks, j + 4);
        if tok_is(src, toks, cp + 1, "{") {
            fi_expr = 1;
            fi_st = j + 3;
            fi_body = cp + 2;
        }
    }
    if load32(s, CG_PROF) != 0 && tok_is(src, toks, j, "for")
            && (fi_new == 1 || fi_expr == 1
                || (tok_is(src, toks, j + 2, "in") && load32(toks, (j + 3) * 20) == 0
                    && tok_is(src, toks, j + 4, "{"))) {
        // Tur 2 的 `for x in xs` / Tur 2026.3 的 `for i, x in xs`（`docs/296` §2.2、
        // `docs/332` §5）。参考实现把它反糖成
        // `let __tur2_i.N = 0; while … { let i = __tur2_i.N; let x = xs[i]; 体; i = i+1 }`
        // —— 这里逐条照着发，指令顺序与临时编号才对得上。
        let st: u32 = fi_st;
        let sty: u32 = var_type(s, src, toks, st);
        if fi_expr == 1 {
            sty = expr_type(s, src, toks, j + 3);
        }
        let et: u32 = elem_tok(src, toks, sty);
        let is_sl: u32 = is_slice_tok(src, toks, sty);
        let fi: u32 = fi_ord(s, src, toks, j);
        if et == 0 || (is_sl == 0 && is_array_tok(src, toks, sty) == 0) {
            return cg_fail(s, 2, j);
        }
        if fi_expr == 1 {
            // `let __tur2_s.N: <ret> = <call>;` —— 调用只求值一次（`docs/334`）。
            let ssub: u32 = push_ty_subst(s, src, toks, sty);
            let _e0: u32 = expr_bin(s, out, src, toks, j + 3, 1, 0, sty);
            pop_subst(s, ssub);
            emit_str(s, out, "  store ");
            emit_ty(s, out, src, toks, sty);
            emit_str(s, out, " ");
            emit_val(s, out, 0);
            emit_str(s, out, ", ptr %__tur2_s.");
            emit_dec(s, out, fi);
            emit_str(s, out, ".addr\n");
        }
        // `let __tur2_i.N: u32 = 0;`
        emit_str(s, out, "  store i32 0, ptr %__tur2_i.");
        emit_dec(s, out, fi);
        emit_str(s, out, ".addr\n");
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "wcond");
        lab_def(s, out, w, "wcond");
        // 条件: load idx; 数组取常量 N / 切片取 slice_len(xs)
        emit_str(s, out, "  ");
        let iv: u32 = new_temp(s, out);
        emit_str(s, out, " = load i32, ptr %__tur2_i.");
        emit_dec(s, out, fi);
        emit_str(s, out, ".addr\n");
        let cv: u32 = 0;
        if is_sl == 1 {
            if fi_expr == 1 {
                load_syn_var(s, out, src, toks, sty, fi, 0);
            } else {
                load_var(s, out, src, toks, st, 0);
            }
            emit_str(s, out, "  ");
            let lv: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, 0);
            emit_str(s, out, ", 1\n  ");
            let l32: u32 = new_temp(s, out);
            emit_str(s, out, " = trunc i64 %t");
            emit_dec(s, out, lv);
            emit_str(s, out, " to i32\n  ");
            cv = new_temp(s, out);
            emit_str(s, out, " = icmp ult i32 %t");
            emit_dec(s, out, iv);
            emit_str(s, out, ", %t");
            emit_dec(s, out, l32);
            emit_str(s, out, "\n");
        } else {
            let nt: u32 = array_len_tok(src, toks, sty);
            emit_str(s, out, "  ");
            cv = new_temp(s, out);
            emit_str(s, out, " = icmp ult i32 %t");
            emit_dec(s, out, iv);
            emit_str(s, out, ", ");
            emit_tok(s, out, src, toks, nt);
            emit_str(s, out, "\n");
        }
        emit_str(s, out, "  br i1 %t");
        emit_dec(s, out, cv);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "wbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "wend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
        lab_def(s, out, w + 1, "wbody");
        if fi_new == 1 {
            // `let i: u32 = __tur2_i.N;` —— 下标副本，体内改它不影响循环推进。
            // 与参考反糖的局部顺序一致：`i` 在 `x` 之前。
            emit_str(s, out, "  ");
            let itv: u32 = new_temp(s, out);
            emit_str(s, out, " = load i32, ptr %__tur2_i.");
            emit_dec(s, out, fi);
            emit_str(s, out, ".addr\n  store i32 %t");
            emit_dec(s, out, itv);
            emit_str(s, out, ", ptr %");
            emit_name_tok(s, out, src, toks, j + 1);
            emit_str(s, out, ".addr\n");
        }
        // `let x = xs[idx];`
        let ev: u32 = 0;
        if is_sl == 1 {
            if fi_expr == 1 {
                load_syn_var(s, out, src, toks, sty, fi, 0);
            } else {
                load_var(s, out, src, toks, st, 0);
            }
            emit_str(s, out, "  ");
            let sp: u32 = new_temp(s, out);
            emit_str(s, out, " = extractvalue { ptr, i64 } ");
            emit_val(s, out, 0);
            emit_str(s, out, ", 0\n  ");
            let iv3: u32 = new_temp(s, out);
            emit_str(s, out, " = load i32, ptr %__tur2_i.");
            emit_dec(s, out, fi);
            emit_str(s, out, ".addr\n  ");
            let gp: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds ");
            emit_ty(s, out, src, toks, et);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, sp);
            emit_str(s, out, ", i32 %t");
            emit_dec(s, out, iv3);
            emit_str(s, out, "\n  ");
            ev = new_temp(s, out);
            emit_str(s, out, " = load ");
            emit_ty(s, out, src, toks, et);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, gp);
            emit_str(s, out, "\n");
        } else {
            emit_str(s, out, "  ");
            let iv4: u32 = new_temp(s, out);
            emit_str(s, out, " = load i32, ptr %__tur2_i.");
            emit_dec(s, out, fi);
            emit_str(s, out, ".addr\n  ");
            let gp2: u32 = new_temp(s, out);
            emit_str(s, out, " = getelementptr inbounds ");
            emit_ty(s, out, src, toks, sty);
            if fi_expr == 1 {
                emit_str(s, out, ", ptr %__tur2_s.");
                emit_dec(s, out, fi);
            } else {
                emit_str(s, out, ", ptr %");
                emit_name_tok(s, out, src, toks, st);
            }
            emit_str(s, out, ".addr, i32 0, i32 %t");
            emit_dec(s, out, iv4);
            emit_str(s, out, "\n  ");
            ev = new_temp(s, out);
            emit_str(s, out, " = load ");
            emit_ty(s, out, src, toks, et);
            emit_str(s, out, ", ptr %t");
            emit_dec(s, out, gp2);
            emit_str(s, out, "\n");
        }
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, " %t");
        emit_dec(s, out, ev);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, fi_vtok);
        emit_str(s, out, ".addr\n");
        // 体
        let ob: u32 = load32(s, CG_LBRK);
        let ocd: u32 = load32(s, CG_LCOND);
        let okd: u32 = load32(s, CG_LKIND);
        let osv: u32 = load32(s, CG_LSV);
        let oax: u32 = load32(s, CG_LAUX);
        store32(s, CG_LBRK, w + 2);
        store32(s, CG_LCOND, w);
        store32(s, CG_LKIND, 1);
        store32(s, CG_LAUX, fi);
        let odep: u32 = load32(s, CG_LDEPTH);
        let k: u32 = fi_body;
        let fidf: u32 = dfr_push(s);   // 循环体是一层语句表（docs/296 §2.3）
        store32(s, CG_LDEPTH, fidf);
        let tv: u32 = epoch_open(s, out, src, toks, k, skip_block(src, toks, j + 4) - 1);
        store32(s, CG_LSV, tv);
        while !tok_is(src, toks, k, "}") && tok_kind(toks, k) != 4 {
            k = stmt(s, out, src, toks, k, ret);
        }
        let _fde: u32 = dfr_end(s, out, src, toks, fidf, ret);
        epoch_close(s, out, tv);
        k = k + 1;
        // `__tur2_i.N = __tur2_i.N + 1;` —— 体以 `break`/`continue`/`return` 收尾时
        // 那之后已经是一条终结指令, 再发自增就是**终结符之后还有指令**（非法 IR）。
        if load32(s, 476) == 0 {
            fi_step(s, out, fi);
        }
        jump(s, out, w, "wcond");
        lab_def(s, out, w + 2, "wend");
        store32(s, CG_LBRK, ob);
        store32(s, CG_LCOND, ocd);
        store32(s, CG_LKIND, okd);
        store32(s, CG_LSV, osv);
        store32(s, CG_LAUX, oax);
        store32(s, CG_LDEPTH, odep);
        return k;
    }
    if tok_is(src, toks, j, "domain") && is_dom_for(src, toks, j) == 1 {   // docs/315
        return dom_for(s, out, src, toks, j, ret);
    }
    if tok_is(src, toks, j, "solid") && tok_kind(toks, j + 1) == 0
            && tok_is(src, toks, j + 2, ":") {
        let sk: u32 = j + 3;
        while tok_kind(toks, sk) != 4 && !tok_is(src, toks, sk, ";") {
            sk = sk + 1;
        }
        return sk + 1;
    }
    if (tok_is(src, toks, j, "couple") || tok_is(src, toks, j, "mutex"))
            && tok_kind(toks, j + 1) == 0
            && (tok_is(src, toks, j + 2, ",") || tok_is(src, toks, j + 2, ";")) {
        // 图边（`docs/315` §5）：声明，不产生指令；判决点长在 guard 里。
        let ck2: u32 = j + 3;
        while tok_kind(toks, ck2) != 4 && !tok_is(src, toks, ck2, ";") {
            ck2 = ck2 + 1;
        }
        return ck2 + 1;
    }
    if tok_is(src, toks, j, "for") {   // for i in lo..hi { ... }
        let var_tok: u32 = j + 1;
        let le: u32 = j + 3;                       // lo 起始 (跳过 'for' 变量 'in')
        let ty: u32 = var_type(s, src, toks, var_tok);
        let loe: u32 = expr_bin(s, out, src, toks, le, 1, 0, ty);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, var_tok);
        emit_str(s, out, ".addr\n");
        let hi_start: u32 = loe + 2;               // 跳过 '..'
        let w: u32 = load32(s, 480) + 1;
        store32(s, 480, w + 2);
        jump(s, out, w, "fcond");
        lab_def(s, out, w, "fcond");
        load_var(s, out, src, toks, var_tok, 0);
        let he: u32 = expr_bin(s, out, src, toks, hi_start, 1, 1, ty);
        emit_str(s, out, "  ");
        let cn: u32 = new_temp(s, out);
        emit_str(s, out, " = icmp ");
        if is_signed(src, toks, ty) == 1 {
            emit_str(s, out, "slt ");
        } else {
            emit_str(s, out, "ult ");
        }
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ");
        emit_val(s, out, 1);
        emit_str(s, out, "\n  br i1 %t");
        emit_dec(s, out, cn);
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 1, "fbody");
        emit_str(s, out, ", label ");
        lab_ref(s, out, w + 2, "fend");
        emit_str(s, out, "\n");
        store32(s, 476, 1);
