// surface_data.lomt — 由 `tools/loment_diag.py --dump-surface` 生成，别手改。
//
// **它只剩派生数据**（2026-11-18 起）：码表 / 说明卡 / 语言卡 / 分类规则的真源是
// `loment/tools/errdata.lomt`（自举侧，下面 `use errdata`）。这里生成的是：
//   * `potato_from.GRAMMAR_ALIASES` / `GRAMMAR_DECL_WORDS`（语法声明的别名与词序）
//   * `loment_release.LOMENTERR`（报错器版本）
//
// 这几样仍然生成，是因为它们的真源在别处（前端 / 发行）；手抄进 errdata 就是
// 「同一份清单抄第二遍」。

module surface_data

use errdata

pub fn decl_word_count() -> u32 { return 3; }

/// 声明的第 `i` 个词（`choose` / `write` / `grammar`）—— 词序是两边共享的契约。
pub fn decl_word(i: u32) -> str {
    if i == 0 { return "choose"; }
    if i == 1 { return "write"; }
    if i == 2 { return "grammar"; }
    return "";
}

pub fn alias_count() -> u32 { return 30; }

/// 第 `i` 个语法别名（报错器按**小写**比 —— 作者写 `C#` 还是 `c#` 都该认）。
pub fn alias_word(i: u32) -> str {
    if i == 0 { return "2027.1alpha"; }
    if i == 1 { return "2027.1alpha"; }
    if i == 2 { return "c"; }
    if i == 3 { return "c#"; }
    if i == 4 { return "c++"; }
    if i == 5 { return "cc"; }
    if i == 6 { return "cpp"; }
    if i == 7 { return "cs"; }
    if i == 8 { return "csharp"; }
    if i == 9 { return "cxx"; }
    if i == 10 { return "go"; }
    if i == 11 { return "golang"; }
    if i == 12 { return "java"; }
    if i == 13 { return "loment"; }
    if i == 14 { return "lument"; }
    if i == 15 { return "natural"; }
    if i == 16 { return "nl"; }
    if i == 17 { return "py"; }
    if i == 18 { return "python"; }
    if i == 19 { return "rs"; }
    if i == 20 { return "rust"; }
    if i == 21 { return "tur"; }
    if i == 22 { return "tur1"; }
    if i == 23 { return "tur2"; }
    if i == 24 { return "tur2026.1"; }
    if i == 25 { return "tur2026.2"; }
    if i == 26 { return "tur2026.3"; }
    if i == 27 { return "tur2027.1alpha"; }
    if i == 28 { return "tur2027.1alpha"; }
    if i == 29 { return "tur3"; }
    return "";
}

/// 该别名对应的语言（= `LANG_CARDS` 的键 / `potato_from.LANGS` 的键）。
pub fn alias_lang(i: u32) -> str {
    if i == 0 { return "tur2027.1Alpha"; }
    if i == 1 { return "tur2027.1Alpha"; }
    if i == 2 { return "c"; }
    if i == 3 { return "csharp"; }
    if i == 4 { return "cpp"; }
    if i == 5 { return "cpp"; }
    if i == 6 { return "cpp"; }
    if i == 7 { return "csharp"; }
    if i == 8 { return "csharp"; }
    if i == 9 { return "cpp"; }
    if i == 10 { return "go"; }
    if i == 11 { return "go"; }
    if i == 12 { return "java"; }
    if i == 13 { return "loment"; }
    if i == 14 { return "natural"; }
    if i == 15 { return "natural"; }
    if i == 16 { return "natural"; }
    if i == 17 { return "python"; }
    if i == 18 { return "python"; }
    if i == 19 { return "rust"; }
    if i == 20 { return "rust"; }
    if i == 21 { return "tur2026.1"; }
    if i == 22 { return "tur2026.1"; }
    if i == 23 { return "tur2026.2"; }
    if i == 24 { return "tur2026.1"; }
    if i == 25 { return "tur2026.2"; }
    if i == 26 { return "tur2026.3"; }
    if i == 27 { return "tur2027.1Alpha"; }
    if i == 28 { return "tur2027.1Alpha"; }
    if i == 29 { return "tur2026.3"; }
    return "";
}

/// 报错器自己的版本（`lomenterr version` 打的就是它）。真源：`tools/loment_release.py`。
pub fn lomenterr_version() -> str { return "0.1.3"; }
