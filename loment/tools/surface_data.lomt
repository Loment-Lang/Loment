    if k == 378 { return "`no_gc` promises \"the artifact has no collector\", while every `lgc` statement controls when that collector runs. The two cannot both be true."; }
    if k == 379 { return "`no_gc` 的承诺是「产物不带收集器」，而 `lgc` 的每一条语句都在控制收集器何时跑。这两句话不能同时为真：要么开一个有收集器的档，要么不要写 `lgc`。"; }
    if k == 380 { return "LSPE's promise is not \"no bugs\"; it is \"no silent allow\". The default tier only records the site as `undecided` in the ledger. Only `--lspe-mode=strict` turns it into an error."; }
    if k == 381 { return "LSPE 的承诺不是“没有漏洞”，是“没有未被标注的放行”。默认档只把它记进台账的 `undecided`；只有 `--lspe-mode=strict` 才会把它变成一条错误。"; }
    if k == 382 { return "This is the auditor's own inconsistency, not a defect in the user's code. It is in the same family as E036 (an unrecorded question): the auditor must audit itself."; }
