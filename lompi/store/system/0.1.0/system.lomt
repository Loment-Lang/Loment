// system/system.lomt — 包入口（门面）。
//
// 领域库各自成包，`std` 只留可移植核心。按模块取用 `use <module>`（包内模块按名字
// 可达，docs/199 §2）；这个门面只给"我确实全都要"的场合，会把整包拉进同一个单元。
module system
choose runtime

use "caps.lomt"
use "seccomp.lomt"
use "ns.lomt"
use "errno.lomt"
use "syscalls.lomt"
use "fcntl.lomt"
use "mmap.lomt"
use "poll.lomt"
use "resource.lomt"
use "procfs.lomt"
use "ioctl.lomt"
