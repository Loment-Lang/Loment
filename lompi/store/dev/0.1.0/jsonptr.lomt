// dev/jsonptr.lomt — RFC 6901 JSON Pointer 的求值
//
// 为什么开发者工具需要它: 配置覆盖、CI 参数、调试里"只改这一个字段"，
// 表达方式就是 `/a/b/0` 这样的指针。它看起来像路径，但有两个转义（`~0`=`~`、
// `~1`=`/`）与数组下标的严格规则（不认前导零、不认负号）。
//
// 形状: 在**原文**上走 `jsn` 的游标 API，返回目标值的字节下标；不建树、不复制。
// 请求的是标量时，再由 `jp_get_*` 取出。
//
// 不做的: JSON Patch（增删改）与相对指针（`-`、`#` 片段）—— 前者要重写文本，
// 后者是 URI fragment 的另一种编码。
//
// 命名: 公开 jp_*, 内部 jp_*。自检 test_jsonptr_*。

module jsonptr

use mem
use jsn

pub const JP_NO: u32 = 4294967294;

fn jp_ws(d: ptr, i0: u32, n: u32) -> u32 {
    let i: u32 = i0;
    while i < n {
        let c: u32 = load8(d, i);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1;
        } else {
            return i;
        }
    }
    return n;
}

fn jp_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

/// 解析数组下标；非数字、前导零、溢出都返回 JP_NO。
fn jp_index(tok: ptr, ln: u32) -> u32 {
    if ln == 0 {
        return JP_NO;
    }
    if ln > 1 && load8(tok, 0) == 48 {
        return JP_NO;
    }
    let v: u32 = 0;
    let i: u32 = 0;
    while i < ln {
        let c: u32 = load8(tok, i);
        if !jp_digit(c) {
            return JP_NO;
        }
        if v > 429496729 {
            return JP_NO;
        }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

/// 求值。返回值的下标；路径不存在返回 JP_NO。
pub fn jp_resolve(d: ptr, n: u32, pointer: str) -> u32 {
    let cur: u32 = jp_ws(d, 0, n);
    let pn: u32 = str_len(pointer);
    if pn == 0 {
        return cur;
    }
    if str_byte(pointer, 0) != 47 { // '/'
        return JP_NO;
    }
    let tok: ptr = alloc(256);
    let keybuf: ptr = alloc(4 + 256);
    let i: u32 = 0;
    while i < pn {
        if str_byte(pointer, i) != 47 {
            return JP_NO;
        }
        i = i + 1;
        // 解码一段（~0 / ~1）
        let tl: u32 = 0;
        while i < pn && str_byte(pointer, i) != 47 {
            let c: u32 = str_byte(pointer, i);
            if c == 126 { // '~'
                if i + 1 >= pn {
                    return JP_NO;
                }
                let e: u32 = str_byte(pointer, i + 1);
                let d2: u32 = 0;
                if e == 48 {
                    d2 = 126;
                } else if e == 49 {
                    d2 = 47;
                } else {
                    return JP_NO;
                }
                if tl >= 256 {
                    return JP_NO;
                }
                store8(tok, tl, d2 as u8);
                tl = tl + 1;
                i = i + 2;
            } else {
                if tl >= 256 {
                    return JP_NO;
                }
                store8(tok, tl, c as u8);
                tl = tl + 1;
                i = i + 1;
            }
        }
        let t: u32 = jsn_type_at(d, 0, n, cur);
        if t == JSN_OBJ {
            let nxt: u32 = jsn_obj_get(d, 0, n, cur, tok, tl, keybuf);
            if nxt == JSN_NO || nxt == JSN_ERR {
                return JP_NO;
            }
            cur = nxt;
        } else if t == JSN_ARR {
            let idx: u32 = jp_index(tok, tl);
            if idx == JP_NO {
                return JP_NO;
            }
            let nxt2: u32 = jsn_arr_at(d, 0, n, cur, idx);
            if nxt2 == JSN_NO || nxt2 == JSN_ERR {
                return JP_NO;
            }
            cur = nxt2;
        } else {
            return JP_NO;
        }
    }
    return cur;
}

/// 取整数。`ok_out` 写 1/0。
pub fn jp_get_u64(d: ptr, n: u32, pointer: str, ok_out: ptr) -> u64 {
    mem_store32(ok_out, 0, 0);
    let at: u32 = jp_resolve(d, n, pointer);
    if at == JP_NO {
        return 0 as u64;
    }
    return jsn_u64(d, 0, n, at, ok_out);
}

/// 取字符串写进 out，返回长度；路径不存在返回 JP_NO。
pub fn jp_get_str(d: ptr, n: u32, pointer: str, out: ptr, cap: u32) -> u32 {
    let at: u32 = jp_resolve(d, n, pointer);
    if at == JP_NO {
        return JP_NO;
    }
    let need: u32 = jsn_str_len(d, 0, n, at);
    if need == JSN_ERR {
        return JP_NO;
    }
    if need > cap {
        return need; // 不写半截：调用方看到长度大于 cap 就是"缓冲不够"
    }
    let m: u32 = jsn_str(d, 0, n, at, out, 0);
    if m == JSN_ERR {
        return JP_NO;
    }
    return m;
}

// ---------------------------------------------------------------- 自检

fn test_jsonptr_root() -> bool {
    let s: str = " {\"a\":1} ";
    let at: u32 = jp_resolve(str_ptr(s), str_len(s), "");
    return at != JP_NO && jsn_type_at(str_ptr(s), 0, str_len(s), at) == JSN_OBJ;
}

fn test_jsonptr_paths() -> bool {
    let s: str = "{\"a\":{\"b\":[10,20]},\"x~y\":1,\"p/q\":2}";
    let ok: ptr = alloc(4);
    let v1: u64 = jp_get_u64(str_ptr(s), str_len(s), "/a/b/1", ok);
    let v2: u64 = jp_get_u64(str_ptr(s), str_len(s), "/x~0y", ok);
    let v3: u64 = jp_get_u64(str_ptr(s), str_len(s), "/p~1q", ok);
    return v1 == 20 && v2 == 1 && v3 == 2 && mem_load32(ok, 0) == 1;
}

fn test_jsonptr_missing() -> bool {
    let s: str = "{\"a\":1}";
    return jp_resolve(str_ptr(s), str_len(s), "/a/0") == JP_NO
        && jp_resolve(str_ptr(s), str_len(s), "/b") == JP_NO
        && jp_resolve(str_ptr(s), str_len(s), "a") == JP_NO;
}
