// system/prctl.lomt — prctl(2) 的选项表、名字与进程名那对一进一出
//
// 为什么系统工具需要它: 守护进程、沙箱、容器里跑的服务，几乎每个都要调 `prctl`：
// 让父进程死了自己也被杀掉（`PR_SET_PDEATHSIG`）、改进程名让 `ps` 看得懂
// （`PR_SET_NAME`）、关掉 core dump（`PR_SET_DUMPABLE`）、给子进程装
// `PR_SET_NO_NEW_PRIVS`。选项号是**平铺的二十几个整数**，`PR_SET_NAME` 是 15 而
// `PR_SET_TIMERSLACK` 是 29 —— 没有头文件时没人记得住，写错那个数就是静默地
// 改了另一件事（把 15 写成 22 就从"改名"变成"装 seccomp"）。
//
// 覆盖: Linux 通用选项（x86-64 / AArch64 一致）。
//
// 不做的: `PR_SET_SECCOMP` 的策略构造（见 `system/seccomp`）、`PR_SET_MM` 需要
// CAP_SYS_RESOURCE 的那些子项、capability 的保留集语义（见 `system/caps`）。
//
// 命名: 公开 prc_*, 内部 prq_*。自检 test_prctl_*。

module prctl

pub const PRC_SET_PDEATHSIG: u32 = 1;
pub const PRC_GET_PDEATHSIG: u32 = 2;
pub const PRC_GET_DUMPABLE: u32 = 3;
pub const PRC_SET_DUMPABLE: u32 = 4;
pub const PRC_GET_KEEPCAPS: u32 = 7;
pub const PRC_SET_KEEPCAPS: u32 = 8;
pub const PRC_GET_FPEMU: u32 = 9;
pub const PRC_SET_FPEMU: u32 = 10;
pub const PRC_SET_NAME: u32 = 15;
pub const PRC_GET_NAME: u32 = 16;
pub const PRC_SET_SECCOMP: u32 = 22;
pub const PRC_CAPBSET_READ: u32 = 23;
pub const PRC_CAPBSET_DROP: u32 = 24;
pub const PRC_GET_SECUREBITS: u32 = 27;
pub const PRC_SET_TIMERSLACK: u32 = 29;
pub const PRC_GET_TIMERSLACK: u32 = 30;
pub const PRC_SET_MM: u32 = 35;
pub const PRC_GET_MM: u32 = 34;
pub const PRC_SET_CHILD_SUBREAPER: u32 = 36;
pub const PRC_GET_CHILD_SUBREAPER: u32 = 37;
pub const PRC_SET_NO_NEW_PRIVS: u32 = 38;
pub const PRC_GET_NO_NEW_PRIVS: u32 = 39;

/// `PR_SET_NAME` / `PR_GET_NAME` 的缓冲区大小（内核写满 16 字节，含结尾 NUL）。
pub const PRC_NAME_BYTES: u32 = 16;

/// 线程名的实际上限（15 个字节 + NUL）—— 截断时用它，别用 16。
pub const PRC_NAME_MAX: u32 = 15;

const PRQ_SYS_PRCTL: u64 = 157;

fn prq_put(out: ptr, cap: u32, s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        if i < cap {
            store8(out, i, str_byte(s, i) as u8);
        }
        i = i + 1;
    }
    return n;
}

/// 选项号 -> 名字。未知返回 `"PR_UNKNOWN"`。
pub fn prc_option_name(opt: u32, out: ptr, cap: u32) -> u32 {
    if opt == PRC_SET_PDEATHSIG { return prq_put(out, cap, "PR_SET_PDEATHSIG"); }
    if opt == PRC_GET_PDEATHSIG { return prq_put(out, cap, "PR_GET_PDEATHSIG"); }
    if opt == PRC_GET_DUMPABLE { return prq_put(out, cap, "PR_GET_DUMPABLE"); }
    if opt == PRC_SET_DUMPABLE { return prq_put(out, cap, "PR_SET_DUMPABLE"); }
    if opt == PRC_GET_KEEPCAPS { return prq_put(out, cap, "PR_GET_KEEPCAPS"); }
    if opt == PRC_SET_KEEPCAPS { return prq_put(out, cap, "PR_SET_KEEPCAPS"); }
    if opt == PRC_GET_FPEMU { return prq_put(out, cap, "PR_GET_FPEMU"); }
    if opt == PRC_SET_FPEMU { return prq_put(out, cap, "PR_SET_FPEMU"); }
    if opt == PRC_SET_NAME { return prq_put(out, cap, "PR_SET_NAME"); }
    if opt == PRC_GET_NAME { return prq_put(out, cap, "PR_GET_NAME"); }
    if opt == PRC_SET_SECCOMP { return prq_put(out, cap, "PR_SET_SECCOMP"); }
    if opt == PRC_CAPBSET_READ { return prq_put(out, cap, "PR_CAPBSET_READ"); }
    if opt == PRC_CAPBSET_DROP { return prq_put(out, cap, "PR_CAPBSET_DROP"); }
    if opt == PRC_GET_SECUREBITS { return prq_put(out, cap, "PR_GET_SECUREBITS"); }
    if opt == PRC_SET_TIMERSLACK { return prq_put(out, cap, "PR_SET_TIMERSLACK"); }
    if opt == PRC_GET_TIMERSLACK { return prq_put(out, cap, "PR_GET_TIMERSLACK"); }
    if opt == PRC_SET_MM { return prq_put(out, cap, "PR_SET_MM"); }
    if opt == PRC_GET_MM { return prq_put(out, cap, "PR_GET_MM"); }
    if opt == PRC_SET_CHILD_SUBREAPER { return prq_put(out, cap, "PR_SET_CHILD_SUBREAPER"); }
    if opt == PRC_GET_CHILD_SUBREAPER { return prq_put(out, cap, "PR_GET_CHILD_SUBREAPER"); }
    if opt == PRC_SET_NO_NEW_PRIVS { return prq_put(out, cap, "PR_SET_NO_NEW_PRIVS"); }
    if opt == PRC_GET_NO_NEW_PRIVS { return prq_put(out, cap, "PR_GET_NO_NEW_PRIVS"); }
    return prq_put(out, cap, "PR_UNKNOWN");
}

/// 名字 -> 选项号。未知返回 -1。
pub fn prc_lookup(name: str) -> i64 {
    if str_eq(name, "PR_SET_PDEATHSIG") { return 1 as i64; }
    if str_eq(name, "PR_SET_DUMPABLE") { return 4 as i64; }
    if str_eq(name, "PR_SET_NAME") { return 15 as i64; }
    if str_eq(name, "PR_GET_NAME") { return 16 as i64; }
    if str_eq(name, "PR_SET_SECCOMP") { return 22 as i64; }
    if str_eq(name, "PR_CAPBSET_READ") { return 23 as i64; }
    if str_eq(name, "PR_CAPBSET_DROP") { return 24 as i64; }
    if str_eq(name, "PR_SET_TIMERSLACK") { return 29 as i64; }
    if str_eq(name, "PR_SET_NO_NEW_PRIVS") { return 38 as i64; }
    if str_eq(name, "PR_GET_NO_NEW_PRIVS") { return 39 as i64; }
    return 0 as i64 - 1;
}

/// `prctl(option, a2, a3, a4, a5)` —— 五个参数全是 u64，语义随选项。
pub fn prc_prctl(opt: u32, a2: u64, a3: u64, a4: u64, a5: u64) -> i64 {
    return syscall6(PRQ_SYS_PRCTL, opt as u64, a2, a3, a4, a5);
}

/// `prc_set_name("worker")` —— 把最多 `PRC_NAME_MAX` 字节拷进 16 字节缓冲并设名。
/// 超长部分**截断**（内核也是这么做的），返回值就是系统调用结果。
pub fn prc_set_name(name: str) -> i64 {
    let b: ptr = alloc(PRC_NAME_BYTES);
    let n: u32 = str_len(name);
    let i: u32 = 0;
    while i < PRC_NAME_MAX {
        if i < n {
            store8(b, i, str_byte(name, i) as u8);
        } else {
            store8(b, i, 0 as u8);
        }
        i = i + 1;
    }
    store8(b, PRC_NAME_MAX, 0 as u8);
    return prc_prctl(PRC_SET_NAME, b as u64, 0, 0, 0);
}

/// `prc_get_name(buf, cap)` —— 把当前线程名写进 `buf`，返回**实际长度**（不含 NUL）。
/// 缓冲区至少要 16 字节；系统调用失败返回 0。
pub fn prc_get_name(buf: ptr, cap: u32) -> u32 {
    if cap < PRC_NAME_BYTES {
        return 0;
    }
    let r: i64 = prc_prctl(PRC_GET_NAME, buf as u64, 0, 0, 0);
    if r < 0 {
        return 0;
    }
    let n: u32 = 0;
    while n < PRC_NAME_MAX && load8(buf, n) != 0 {
        n = n + 1;
    }
    return n;
}

/// 让本进程在父进程死掉时收到这个信号（0 = 关掉）。
pub fn prc_set_pdeathsig(sig: u32) -> i64 {
    return prc_prctl(PRC_SET_PDEATHSIG, sig as u64, 0, 0, 0);
}

/// 装 `PR_SET_NO_NEW_PRIVS`：此后 `execve` 不能给进程添新权限（沙箱的第一道）。
pub fn prc_no_new_privs() -> i64 {
    return prc_prctl(PRC_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
}

// ---------------------------------------------------------------- 自检

fn test_prctl_option_names() -> bool {
    let b: ptr = alloc(32);
    let n: u32 = prc_option_name(PRC_SET_NAME, b, 32);
    let want: str = "PR_SET_NAME";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(b, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_prctl_lookup() -> bool {
    if prc_lookup("PR_SET_SECCOMP") != 22 as i64 {
        return false;
    }
    if prc_lookup("PR_GET_NO_NEW_PRIVS") != 39 as i64 {
        return false;
    }
    if prc_lookup("NOPE") != 0 as i64 - 1 {
        return false;
    }
    return true;
}

fn test_prctl_name_bounds() -> bool {
    if PRC_NAME_BYTES != 16 {
        return false;
    }
    if PRC_NAME_MAX != 15 {
        return false;
    }
    return true;
}
