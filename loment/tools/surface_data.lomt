    if k == 374 { return "a level needs runtime state but the program declares `no_runtime`"; }
    if k == 375 { return "要运行期状态，但程序声明了 `no_runtime`"; }
    if k == 376 { return "a library uses a runtime construct without declaring the requirement"; }
    if k == 377 { return "库用了运行期构造却没声明需求"; }
    if k == 378 { return "`lgc` needs a collector but the unit chose `no_gc`"; }
    if k == 379 { return "`lgc` 需要收集器，但单元声明了 `no_gc`"; }
    if k == 380 { return "an LSPE allow with no source"; }
    if k == 381 { return "LSPE 说不出来源的放行"; }
    if k == 382 { return "the ledger has an unregistered site kind"; }
    if k == 383 { return "LSPE 台账里有未登记的站点种类"; }
    if k == 384 { return "no region annotations under `lifetime_auto`"; }
    if k == 385 { return "自动档不许写区域标记"; }
    if k == 386 { return "the region annotation names a parameter that does not exist"; }
    if k == 387 { return "区域标记指向不存在的形参"; }
    if k == 388 { return "the region annotation does not name a reference parameter"; }
    if k == 389 { return "区域标记指向的不是引用形参"; }
    if k == 390 { return "freed while still borrowed"; }
    if k == 391 { return "还在被借用时释放了它"; }
    if k == 392 { return "returns a borrow without a reference parameter"; }
    if k == 393 { return "返回借用但没有引用形参"; }
    if k == 394 { return "a borrow domain is read-only"; }
    if k == 395 { return "borrow 域里只能读"; }
    if k == 396 { return "cannot free while the domain still borrows it"; }
    if k == 397 { return "域里还在借用时不能 `free`"; }
    if k == 398 { return "no second borrow inside an exclusive domain"; }
    if k == 399 { return "独占域里不能再借"; }
    if k == 400 { return "no mutable borrow inside a shared domain"; }
    if k == 401 { return "共享域里不能再借可变引用"; }
    if k == 402 { return "a cursor domain cannot store an element borrow"; }
    if k == 403 { return "游标域里不能存元素借用"; }
    if k == 404 { return "a value lent to a domain cannot be used again inside the block"; }
    if k == 405 { return "已经借给域的值不能再用"; }
    if k == 406 { return "a borrow cannot leave an epoch domain"; }
    if k == 407 { return "epoch 域里的借用不能带出"; }
    if k == 408 { return "a session domain hands over once"; }
    if k == 409 { return "session 域里只能移交一次"; }
    if k == 410 { return "ownership left with the session domain"; }
    if k == 411 { return "所有权已经随 session 域走了"; }
    if k == 412 { return "outside a seal domain it cannot be handed out"; }
    if k == 413 { return "封印域之外不能把它交给外部"; }
    if k == 414 { return "the two halves of a split domain overlap"; }
    if k == 415 { return "split 域的两半重叠了"; }
    if k == 416 { return "`no_runtime` declared, but the unit uses a runtime construct"; }
    if k == 417 { return "声明了 `no_runtime`，但用了会拖运行期的构造"; }
    if k == 418 { return "`str_num` takes an integer"; }
    if k == 419 { return "`str_num` 只收整型"; }
    if k == 420 { return "using a function value needs `choose fp`"; }
    if k == 421 { return "使用函数值需要 `choose fp`"; }
    if k == 422 { return "an `extern fn` is not a function value"; }
    if k == 423 { return "`extern fn` 不能当函数值"; }
    if k == 424 { return "this closure capture type is not supported yet"; }
    if k == 425 { return "闭包按值捕获的类型还不支持"; }
    if k == 426 { return "the closure parameter types cannot be inferred"; }
    if k == 427 { return "闭包形参类型推不出来"; }
    if k == 428 { return "a closure that borrows its captures cannot be returned"; }
    if k == 429 { return "带按借捕获的闭包不能返回"; }
    if k == 430 { return "the type annotation on a closure parameter is unknown"; }
    if k == 431 { return "闭包形参的类型未知"; }
    if k == 1800 { return "the tool died without reporting (internal)"; }
    if k == 1801 { return "工具链进程死了，没留下诊断"; }
    if k == 1998 { return "unclassified (please report)"; }
    if k == 1999 { return "未分类（请报告）"; }
    return "";
}

pub fn code_what(c: u32, lang: u32) -> str {
    let k: u32 = c * 2 + lang;
    if k == 2 { return "Two types do not line up - the return value against the declaration, an argument against a parameter, a payload against its variant, a builtin argument, or the two sides of an assignment."; }
    if k == 3 { return "两处类型对不上 —— 返回值与声明、实参与形参、载荷与变体、内建实参、赋值两侧。"; }
    if k == 4 { return "A name was used without being declared - a variable, a function, a type or a constant."; }
    if k == 5 { return "用了一个没有声明的名字 —— 变量、函数、类型、常量都算。"; }
    if k == 6 { return "The number of arguments at the call site does not match the function signature."; }
    if k == 7 { return "调用时给的实参个数与函数签名对不上。"; }
    if k == 8 { return "The capability domain itself is wrong - `guard` on something undeclared, a bad `[lo..hi]` range, or one name declared twice."; }
    if k == 9 { return "能力域本身有问题 —— 没声明就 `guard`、`[lo..hi]` 的边界不对、同名重复声明。"; }
    if k == 10 { return "A space that an `excluded` declaration **put out of bounds** was used."; }
    if k == 11 { return "用了一个被 `excluded` 声明**排除在外**的空间。"; }
    if k == 12 { return "A value was **moved** to someone else and then used again."; }
    if k == 13 { return "一个值被**移动**给别人之后，又用它了。"; }
    if k == 14 { return "In one call, the same variable is borrowed mutably and also borrowed, or borrowed mutably twice."; }
    if k == 15 { return "同一个变量在同一次调用里，既被可变借用又被借用，或者被可变借用两次。"; }
    if k == 16 { return "A `match` or an enum is used wrongly: not exhaustive, a duplicate pattern, a bad payload binding, a subject that is not an enum, or an arm written as an expression."; }
    if k == 17 { return "`match` 或枚举的用法有问题：不穷尽、模式重复、载荷绑定不对、主体不是枚举、臂体写成了表达式。"; }
    if k == 18 { return "A type name collides with a base type, or an **empty** `struct`/`enum` was declared."; }
    if k == 19 { return "类型名与基类型重名，或者声明了一个**空**的 `struct`/`enum`。"; }
    if k == 20 { return "`?` was used where the function does not return `Result`/`Option`, or somewhere other than the binding position of a `let`."; }
    if k == 21 { return "`?` 用在了不返回 `Result`/`Option` 的地方，或者不在 `let` 的绑定位置。"; }
    if k == 22 { return "Writing into a **read-only** slice, or a parameter that was not declared `mut`."; }
    if k == 23 { return "往一个**只读**切片里写，或者形参没声明 `mut`。"; }
    if k == 24 { return "A reference to a **local variable** was returned."; }
    if k == 25 { return "返回了一个指向**局部变量**的引用。"; }
    if k == 26 { return "The same name appears twice in one scope - a function, a type, a constant, a field, a variant or a parameter."; }
    if k == 27 { return "同一作用域里同一个名字出现了两次 —— 函数、类型、常量、字段、变体、参数都算。"; }
    if k == 28 { return "The left-hand side of an assignment is not a place that can hold something (it is not an lvalue)."; }
    if k == 29 { return "赋值左边不是一个能放东西的位置（不是左值）。"; }
    if k == 30 { return "A field or an index is used wrongly - no such field, a missing field, a duplicate initializer, a field taken off a non-struct, an index applied to a non-array."; }
    if k == 31 { return "字段或下标用错了 —— 没有这个字段、缺字段、重复初始化、对非结构体取字段、对非数组取下标。"; }
    if k == 32 { return "An array literal is wrong - it is empty, its element types differ, or its count does not match the declared length."; }
    if k == 33 { return "数组字面量有问题 —— 是空的、元素类型不一致、或者个数与声明长度不符。"; }
    if k == 34 { return "The target type of `as` is wrong, or this direction cannot be converted at all."; }
    if k == 35 { return "`as` 的目标类型不对，或者这个方向转不过去。"; }
    if k == 36 { return "`use <name>` does not resolve - either nothing was found, or more than one thing matched and there is no way to tell which was meant."; }
    if k == 37 { return "`use <名字>` 解析不出来 —— 要么找不到，要么命中多处不知道用哪个。"; }
    if k == 38 { return "This line does not read as Loment syntax - the lexer or the parser stopped here."; }
    if k == 39 { return "这一行按 Loment 的语法读不通 —— 词法期或解析期就停了。"; }
    if k == 40 { return "One file has more than **300** `use` statements."; }
    if k == 41 { return "一个文件里的 `use` 超过了 **300 条**。"; }
    if k == 42 { return "An `extern fn` signature goes beyond what FFI stage 1 accepts."; }
    if k == 43 { return "`extern fn` 的签名超出了 FFI 第 1 阶段收的那几种。"; }
    if k == 44 { return "`choose` / `addin` is written wrongly - either a dimension of the **core mode**, or a **switch**."; }
    if k == 45 { return "`choose` / `addin` 的写法不对 —— 可能是**核心模式**的某一维，也可能是**开关**。"; }
    if k == 46 { return "What you wrote is syntactically and semantically right - **this version of the compiler backend just does not do that yet**."; }
    if k == 47 { return "你写的东西语法和语义都对 —— 是**这一版的编译器后端还没做这块**。"; }
    if k == 48 { return "The **declaration** that registers a `loment` command in the source is wrong - its shape, its name, or where it appears."; }
    if k == 49 { return "在源码里注册一条 `loment` 命令的**声明**写错了（名字、形状，或者它出现的地方）。"; }
    if k == 50 { return "One program with two **process entries**: `_start` and `command_main`."; }
    if k == 51 { return "同一个程序里有两个**进程入口**：`_start` 和 `command_main`。"; }
    if k == 52 { return "A command declaration and `command_main` do not match: one of them is missing, or the signature is not the one the entry needs."; }
    if k == 53 { return "命令声明与 `command_main` 对不上：少了一个，或者签名不是入口要求的那个。"; }
    if k == 54 { return "A function that **declares a return type** has a path that reaches the end of its body without a `return`."; }
    if k == 55 { return "一个**声明了返回值**的函数，存在一条路径走到末尾却没 `return`。"; }
    if k == 56 { return "A literal index runs past the end of a **fixed-size array** (declared `[u32; 4]`, written `a[10]`)."; }
    if k == 57 { return "一个字面量下标越过了**定长数组**的界（声明是 `[u32; 4]`，却写了 `a[10]`）。"; }
    if k == 58 { return "A variable points at a block that **was already passed to `free`**, and is used again afterwards."; }
    if k == 59 { return "一个变量指向的块**已经被 `free`**，之后又用到了它。"; }
    if k == 60 { return "A **type position** names a type this language does not have - a `let` annotation, a parameter, a return type, a struct field, an enum payload, or an array/slice element."; }
    if k == 61 { return "一个**类型位置**上写了这门语言没有的类型（`let x: f64`、形参、返回类型、结构体字段、枚举载荷、数组/切片元素都算）。"; }
    if k == 62 { return "The compiler did not get the source file it was told to read. **Not one character of the source has been looked at** - so this one has no line number."; }
    if k == 63 { return "编译器要读的那份源文件没拿到。**还没有看源码一个字符** —— 所以这条没有行号。"; }
    if k == 64 { return "The linker failed to write the artifact to the `-o` path you gave it."; }
    if k == 65 { return "链接器把产物写到你给的 `-o` 路径上时失败了。"; }
    if k == 66 { return "This unit outgrew the compiler's **fixed-capacity** tables (the lexer buffer, the symbol table, the codegen table, the backfill table)."; }
    if k == 67 { return "这个单元超出了这套编译器**固定容量**的那几张表（词法缓冲 / 符号表 / codegen 表 / 回填表）。"; }
    if k == 68 { return "LSPE allowed an access but cannot name a source: no capability domain, no guard, no type, and no assumption supplied by a person."; }
    if k == 69 { return "LSPE 放行了一次访问，却说不出来源 —— 没有能力域、没有 guard、没有类型、也没有人标的假设。"; }
    if k == 70 { return "The LSPE site census produced a kind the ledger does not know."; }
    if k == 71 { return "LSPE 的站点普查枚举出一个种类，而台账不认识它。"; }
    if k == 72 { return "LSPE's self-audit found the ledger and the sites disagree."; }
    if k == 73 { return "审计器自检发现台账与站点对不上。"; }
    if k == 74 { return "A policy lock does not match this artifact."; }
    if k == 75 { return "策略层要求的锁与这份产物不符。"; }
    if k == 76 { return "An `lspe pass` block has no reason, or only whitespace."; }
    if k == 77 { return "`lspe pass` 后面缺一句理由（或者理由全是空白）。"; }
    if k == 78 { return "This unit uses `lgc` (GC timing control) but declares `no_gc` - the artifact carries no collector at all."; }
    if k == 79 { return "这份单元写了 `lgc`（GC 时间控制），却又声明了 `no_gc` —— 产物里根本没有收集器。"; }
    if k == 80 { return "This source does not pin its reading to the current edition, yet it declares a name that a **newer edition treats as syntax** - the old reading sees an identifier, the default reading sees a keyword."; }
    if k == 81 { return "这份源没有把读法钉在生效版次上，却把一个**新版次的关键字**当名字声明了 —— 旧读法会把它当标识符，默认读法会把它当语法。"; }
    if k == 82 { return "A borrow's **region** does not hold: it would outlive its source, or its source cannot be named."; }
    if k == 83 { return "一个借用值的**区域**不成立：它想活得比来源长，或者它的来源说不清。"; }
    if k == 84 { return "`generation cap(x)` takes the revision number as an integer; `x` is not one."; }
    if k == 85 { return "`generation cap(x)` 里的 `x` 是 revision 域的版本号，必须是整型；这里拿到的是别的类型。"; }
    if k == 86 { return "`orelse` / `catch` expects the shape `Option` / `Result` has; the left side is not an enum (or its type could not be determined)."; }
    if k == 87 { return "`orelse` / `catch` 要的是 `Option` / `Result` 那种形状；这里左边的类型不是枚举（或者类型还没定出来）。"; }
    if k == 88 { return "The left side is an enum, but not \"exactly two variants, the first with a payload\" - which is the only shape `orelse` / `catch` accepts."; }
    if k == 89 { return "左边是枚举，但它的变体不是「恰好两个、第一个带载荷」—— `orelse` / `catch` 只认这个形状。"; }
    if k == 90 { return "The fallback in `orelse 0` / `catch e` does not have the payload's type."; }
    if k == 91 { return "`orelse 0` / `catch e` 里的兜底值，类型与枚举载荷的类型不一样。"; }
    if k == 92 { return "The value put into a payload-carrying variant is not the type that variant declares."; }
    if k == 93 { return "构造带载荷的变体时，装进去的值与这个变体声明的载荷类型不一致。"; }
    if k == 94 { return "The argument to `slice_len` is neither an array nor a slice; it measures a sequence."; }
    if k == 95 { return "`slice_len` 的实参既不是数组也不是切片 —— 它量的是「这一串有多长」，标量没有长度。"; }
    if k == 96 { return "The argument to `print_num` is not an integer; it has no string or boolean form."; }
    if k == 97 { return "`print_num` 的实参不是整型 —— 它没有字符串或布尔的重载。"; }
    if k == 98 { return "This builtin parameter needs a concrete type, but it got a bare integer literal whose type cannot be determined."; }
    if k == 99 { return "内建函数的这个实参位置要一个具体类型，而给的是一个裸整型字面量 —— 字面量自己带着类型信息，定不出来就不放行。"; }
    if k == 100 { return "This builtin argument's type does not match what the builtin requires."; }
    if k == 101 { return "内建函数的这个实参类型与它要求的类型不一致。"; }
    if k == 102 { return "The entry name must be known at compile time - it becomes a direct call edge in the artifact - so only a literal written there is accepted."; }
    if k == 103 { return "`thread_spawn` 的入口名在编译期就要定下来（产物里是一条直接调用边），所以只收**写在那里的字符串字面量**。"; }
    if k == 104 { return "A literal was given, but it is not a legal function name and cannot name a symbol."; }
    if k == 105 { return "字面量是给了，但那个字符串不是合法的函数名 —— 它拼不出一个能调用的符号。"; }
    if k == 106 { return "A function parameter needs a concrete type, but the call passed a bare integer literal."; }
    if k == 107 { return "调用某个函数时，这个实参位置要一个具体类型，而给的是裸整型字面量。"; }
    if k == 108 { return "The argument type does not match the declared parameter type; Loment never converts implicitly."; }
    if k == 109 { return "函数调用的实参类型与形参声明的类型不一致 —— Loment 不做隐式转换。"; }
    if k == 110 { return "The index into an array or slice is not an integer."; }
    if k == 111 { return "数组/切片的下标不是整型。"; }
    if k == 112 { return "Two values must become one, but their types are incompatible; neither contains the other."; }
    if k == 113 { return "两个值要合成一个，但它们的类型互不兼容 —— 谁都不是谁的子集。"; }
    if k == 114 { return "A `const` initialiser must be an integer literal; expressions and other types are out of scope."; }
    if k == 115 { return "`const` 的初值只能是整数字面量 —— 不接受表达式，也不接受别的类型。"; }
    if k == 116 { return "In `let x: T = e;` the expression `e` is not of the declared type `T`."; }
    if k == 117 { return "`let x: T = e;` 里 `e` 的类型与声明的 `T` 不一致。"; }
    if k == 118 { return "The right-hand side's type differs from the type the variable was declared with."; }
    if k == 119 { return "赋值号右边的类型与左边变量声明时的类型不一致。"; }
    if k == 120 { return "The `if` condition is not a `bool`; integers are never treated as truth values."; }
