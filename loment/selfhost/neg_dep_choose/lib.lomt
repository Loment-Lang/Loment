module lib

// 跨文件负例（依赖侧）：依赖用了**会拖运行期的构造**（除法）却**什么都没声明**。
//
// 2026-10-10 之前这里测的是"库不许写 `choose`"——那条规则**已经不存在了**（`docs/227` §4）：
// 依赖现在**可以**声明它的需求，根必须满足它。于是负例换成新规则下真正违法的形状。
//
// **为什么这条两个实现都判得住**（这很重要——负例只能在两边都成立的形状上做）：
//   * 参考实现：`check()` 的**依赖义务**那条（`docs/227` §4 第 2 条）——依赖有运行期
//     站点却没声明 ⇒ 报；
//   * 自举侧：它把**所有单元拼成一整块 token** 再查，于是依赖里那个 `/` 就在眼前，
//     而根的取值是 `no_runtime` ⇒ 那条 E031 当场拒。
//
// 装载器**不再**管依赖写的 `choose`（它只把那些行抹成空白——见 `load_file` 里的注解）。

pub fn dep_div(x: u32) -> u32 {
    return x / 2;
}
