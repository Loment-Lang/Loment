// world/isbn.lomt — ISBN-10 / ISBN-13 的校验与互转
//
// 为什么现实世界需要它: 书号是**带校验位的数字串**，而人写的时候会带连字符、
// 空格、大写 X。直接按字符串比较会把同一个号当成两个；不校验就会把扫错的
// 一位数字存进数据库，直到发货才发现。
//
// 规则:
//   * ISBN-10: 10 位，(10-i)*d 之和 ≡ 0 (mod 11)，最后一位可以是 X(=10)；
//   * ISBN-13: 13 位，权重 1,3 交替，和 ≡ 0 (mod 10)；
//   * ISBN-10 -> 13 加前缀 978，重算校验位。
//
// 命名: 公开 isbn_*, 内部 ic_*。自检 test_isbn_*。

module isbn

fn ic_val(c: u32) -> i32 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i32;
    }
    if c == 88 || c == 120 { // X / x
        return 10 as i32;
    }
    return 0 as i32 - 1 as i32;
}

fn ic_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn ic_count(s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let k: u32 = 0;
    while i < n {
        let c: u32 = str_byte(s, i);
        if ic_digit(c) || c == 88 || c == 120 {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

/// ISBN-10 校验。输入可含 `-` 与空格。
pub fn isbn10_valid(s: str) -> bool {
    if ic_count(s) != 10 {
        return false;
    }
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let k: u32 = 0;
    let sum: i32 = 0;
    while i < n {
        let c: u32 = str_byte(s, i);
        if ic_digit(c) || c == 88 || c == 120 {
            let v: i32 = ic_val(c);
            if v < 0 as i32 {
                return false;
            }
            if (c == 88 || c == 120) && k != 9 {
                return false;
            }
            sum = sum + ((10 - k) as i32) * v;
            k = k + 1;
        }
        i = i + 1;
    }
    return sum % (11 as i32) == 0 as i32;
}

/// ISBN-13 校验（也接受 ISBN-10 以外的 13 位书号）。
pub fn isbn13_valid(s: str) -> bool {
    if ic_count(s) != 13 {
        return false;
    }
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let k: u32 = 0;
    let sum: i32 = 0;
    while i < n {
        let c: u32 = str_byte(s, i);
        if ic_digit(c) {
            let v: i32 = (c - 48) as i32;
            if k % 2 == 0 {
                sum = sum + v;
            } else {
                sum = sum + v * (3 as i32);
            }
            k = k + 1;
        } else if c != 45 && c != 32 {
            return false;
        }
        i = i + 1;
    }
    return k == 13 && sum % (10 as i32) == 0 as i32;
}

/// 按长度分派。
pub fn isbn_valid(s: str) -> bool {
    let k: u32 = ic_count(s);
    if k == 10 {
        return isbn10_valid(s);
    }
    if k == 13 {
        return isbn13_valid(s);
    }
    return false;
}

/// ISBN-10 -> ISBN-13（13 位数字，无连字符）。返回 13。
pub fn isbn10_to_13(s: str, out: ptr, cap: u32) -> u32 {
    if !isbn10_valid(s) {
        return 0;
    }
    if cap < 13 {
        return 13;
    }
    store8(out, 0, 57 as u8);
    store8(out, 1, 55 as u8);
    store8(out, 2, 56 as u8);
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let k: u32 = 3;
    let sum: u32 = 38; // 9*1 + 7*3 + 8*1
    while i < n && k < 12 {
        let c: u32 = str_byte(s, i);
        if ic_digit(c) {
            store8(out, k, c as u8);
            if k % 2 == 0 {
                sum = sum + (c - 48);
            } else {
                sum = sum + (c - 48) * 3;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    let chk: u32 = (10 - (sum % 10)) % 10;
    store8(out, 12, (48 + chk) as u8);
    return 13;
}

// ---------------------------------------------------------------- 自检

fn test_isbn_valid() -> bool {
    return isbn_valid("0-306-40615-2")
        && isbn_valid("978-0-306-40615-7")
        && !isbn_valid("0-306-40615-3")
        && !isbn_valid("978-0-306-40615-8");
}

fn test_isbn_convert() -> bool {
    let o: ptr = alloc(16);
    if isbn10_to_13("0306406152", o, 16) != 13 {
        return false;
    }
    let want: str = "9780306406157";
    let i: u32 = 0;
    while i < 13 {
        if load8(o, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
