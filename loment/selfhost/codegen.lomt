        if fref == 4294967295 {
            emit_str(s, out, "%");
            emit_name_tok(s, out, src, toks, j);
            emit_str(s, out, ".addr");
        } else {
            emit_str(s, out, "%t");
            emit_dec(s, out, fref);
        }
        emit_str(s, out, ", i32 0, i32 ");
        emit_dec(s, out, ffi);
        emit_str(s, out, "\n");
        let fe5: u32 = expr_bin(s, out, src, toks, j + 4, 1, 0, fft);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, fft);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, fgp);
        emit_str(s, out, "\n");
        return fe5 + 1;
    }
    // 写穿解引用: `* NAME = EXPR ;`（`docs/299` §3.8）
    if tok_is(src, toks, j, "*") && tok_kind(toks, j + 1) == 0
            && tok_is(src, toks, j + 2, "=") {
        let dty2: u32 = var_type(s, src, toks, j + 1);
        let ety2: u32 = deref_tok(src, toks, dty2);
        emit_str(s, out, "  ");
        let pv: u32 = new_temp(s, out);
        emit_str(s, out, " = load ptr, ptr %");
        emit_name_tok(s, out, src, toks, j + 1);
        emit_str(s, out, ".addr\n");
        let de5: u32 = expr_bin(s, out, src, toks, j + 3, 1, 0, ety2);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ety2);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, pv);
        emit_str(s, out, "\n");
        return de5 + 1;
    }
    // 赋值: NAME = EXPR ;
    if tok_kind(toks, j) == 0 && tok_is(src, toks, j + 1, "=") {
        // `x = v orelse d;` / `... catch d;`（`docs/296` §2.4）
        if load32(s, CG_PROF) != 0 {
            let fbk: u32 = fb_tok(s, src, toks, j + 2);
            if fbk != 0 {
                return emit_fallback(s, out, src, toks, j, j + 2, fbk);
            }
        }
        let ty2: u32 = var_type(s, src, toks, j);
        let e5: u32 = expr_bin(s, out, src, toks, j + 2, 1, 0, ty2);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ty2);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, j);
        emit_str(s, out, ".addr\n");
        return e5 + 1;
    }
    return j + 1;
}

/// 数组字面量绑定: `let a: [T; N] = [e0, e1, …];` —— 逐元素 GEP + 求值 + store。
/// `i` 指向 `[`; 返回其后的 token 下标。
fn let_array_lit(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, i: u32) -> u32 {
    let et: u32 = elem_tok(src, toks, ty);
    let k: u32 = i + 1;
    let idx: u32 = 0;
    while !tok_is(src, toks, k, "]") && tok_kind(toks, k) != 4 {
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, idx);
        emit_str(s, out, "\n");
        let ev: u32 = expr_bin(s, out, src, toks, k, 1, 0, et);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, et);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        k = ev;
        if tok_is(src, toks, k, ",") {
            k = k + 1;
        }
        idx = idx + 1;
    }
    return k + 1;
}

/// 两个 token 的文本是否相同 (逐字节)。
fn tok_eq(src: ptr, toks: ptr, a: u32, b: u32) -> bool {
    if a >= 2147483648 || b >= 2147483648 {
        return false;
    }
    if load32(toks, a * 20 + 8) != load32(toks, b * 20 + 8) {
        return false;
    }
    let k: u32 = 0;
    while k < load32(toks, a * 20 + 8) {
        if load8(src, load32(toks, a * 20 + 4) + k) != load8(src, load32(toks, b * 20 + 4) + k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// struct 字面量绑定: `let b: Blk = Blk { off: 3, len: 5 };` (M23)。
/// 字段按**声明序**逐个 GEP + 求值 + store; 值按字段名在字面量里查。
/// 结构体字面量里一个字段的结尾：深度 0 的 `,` 或 `}`（不含）。`be` 是 `}` 之后。
/// 值表达式里的逗号（`f(1, a, 2)`）在括号里，深度不为 0，不当作字段分隔。
fn struct_field_end(src: ptr, toks: ptr, j: u32, be: u32) -> u32 {
    let d: u32 = 0;
    let k: u32 = j;
    while k < be && tok_kind(toks, k) != 4 {
        if tok_is(src, toks, k, "(") || tok_is(src, toks, k, "[") || tok_is(src, toks, k, "{") {
            d = d + 1;
        } else if tok_is(src, toks, k, ")") || tok_is(src, toks, k, "]")
                || tok_is(src, toks, k, "}") {
            if d == 0 {
                return k;
            }
            d = d - 1;
        } else if d == 0 && tok_is(src, toks, k, ",") {
            return k;
        }
        k = k + 1;
    }
    return k;
}

fn let_struct_lit(s: ptr, out: ptr, src: ptr, toks: ptr, name: u32, ty: u32, i: u32) -> u32 {
    let si: u32 = find_struct(s, src, toks, ty);
    let nf: u32 = load32(s, struct_base(si) + 4);
    let be: u32 = skip_block(src, toks, i);
    let k: u32 = 0;
    while k < nf {
        let fnm: u32 = load32(s, struct_base(si) + 8 + k * 8);
        let ftp: u32 = load32(s, struct_base(si) + 8 + k * 8 + 4);
        let p: u32 = i + 1;
        let vst: u32 = i + 2;
        while p < be && tok_kind(toks, p) != 4 && !tok_is(src, toks, p, "}") {
            // **按字段走，不按 token 走**：值表达式里的 `f(1, a, 2)` 也有"逗号 + 标识符"，
            // 逐 token 找会把那个 `a` 当成字段名（显式字段只认 `:` 时不会）。
            if tok_eq(src, toks, p, fnm) {
                if tok_is(src, toks, p + 1, ":") {
                    vst = p + 2;
                    p = struct_field_end(src, toks, p + 2, be);
                } else if load32(s, CG_PROF) >= 2
                        && (tok_is(src, toks, p + 1, ",") || tok_is(src, toks, p + 1, "}")) {
                    // 2026.3 字段简写（`docs/296` §5）：值就是同名的那个标识符。
                    // 只在 2026.3+ 收；旧版次里它是语法错，检查器已经先拒了。
                    vst = p;
                    p = p + 1;
                } else {
                    p = struct_field_end(src, toks, p + 1, be);
                }
            } else {
                p = struct_field_end(src, toks, p + 1, be);
            }
            if tok_is(src, toks, p, ",") {
                p = p + 1;
            }
        }
        emit_str(s, out, "  ");
        let gp: u32 = new_temp(s, out);
        emit_str(s, out, " = getelementptr inbounds ");
        emit_ty(s, out, src, toks, ty);
        emit_str(s, out, ", ptr %");
        emit_name_tok(s, out, src, toks, name);
        emit_str(s, out, ".addr, i32 0, i32 ");
        emit_dec(s, out, k);
        emit_str(s, out, "\n");
        expr_bin(s, out, src, toks, vst, 1, 0, ftp);
        emit_str(s, out, "  store ");
        emit_ty(s, out, src, toks, ftp);
        emit_str(s, out, " ");
        emit_val(s, out, 0);
        emit_str(s, out, ", ptr %t");
        emit_dec(s, out, gp);
        emit_str(s, out, "\n");
        k = k + 1;
    }
    return be;
}

/// 匹配的 '}' 之后的下标 (i 指向 '{')。
///
/// **`pub` 是必需的**：`potato.lomt` 也用它（它读 token 流，不重新解析）——
/// 而跨模块调用只认 `pub`（M12）。原先这里漏了 `pub`，`potato.lomt` 那两处调用
/// 一直是"调用未定义的函数"，只是**从来没有人把 potato 当入口查过**才没暴露
/// （`#149` 那条：依赖的正文不查 —— 参考实现补上之后，driver 的依赖检查立刻报出来）。
pub fn skip_block(src: ptr, toks: ptr, i: u32) -> u32 {
    let d: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "{") {
            d = d + 1;
        }
        if tok_is(src, toks, j, "}") {
            d = d - 1;
            if d == 0 {
                return j + 1;
            }
        }
        j = j + 1;
    }
    return j;
}

/// `let x: T = <expr>?;` 里的 `?` token 下标 (0 = 不是 ? 形式)。
/// `?` 只以"语句尾"形式出现 (lomentc 的 Try 反糖只认 Let 的右值), 所以判定条件是
/// `?` 紧跟 `;`; 遇到 `{`/`}` 就说明这一句已经越过, 直接放弃。
fn find_try_q(src: ptr, toks: ptr, i: u32) -> u32 {
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && !tok_is(src, toks, j, "{") && !tok_is(src, toks, j, "}") {
        if tok_is(src, toks, j, "?") && tok_is(src, toks, j + 1, ";") {
            return j;
        }
        j = j + 1;
    }
    return 0;
}

/// 追加一个局部 (按名字去重), 返回新的局部数。
/// 名字槽是"token 下标 / 合成名"两种编码共用的 (见 syn_name), 文本比对只在两者
/// 都是真实 token 时才有意义 —— 否则会按合成值当下标去读 token 缓冲 (越界)。
fn add_local(s: ptr, src: ptr, toks: ptr, n: u32, name: u32, ty: u32) -> u32 {
    let dup: u32 = 0;
    let k: u32 = 0;
    while k < n {
        let ex: u32 = load32(s, CG_LOCAL + k * 8);
        if ex == name {
            dup = 1;
        }
        if ex < 2147483648 && name < 2147483648
                && load32(toks, ex * 20 + 8) == load32(toks, name * 20 + 8) {
            let q: u32 = 0;
            let ok: u32 = 1;
            while q < load32(toks, name * 20 + 8) {
                if load8(src, load32(toks, ex * 20 + 4) + q)
                        != load8(src, load32(toks, name * 20 + 4) + q) {
                    ok = 0;
                }
                q = q + 1;
            }
            if ok == 1 {
                dup = 1;
            }
        }
        k = k + 1;
    }
    if dup == 1 {
        return n;
    }
    store32(s, CG_LOCAL + n * 8, name);
    store32(s, CG_LOCAL + n * 8 + 4, ty);
    return n + 1;
}

/// 按序收集局部变量 (let), 去重 —— 镜像 lomentc._collect_locals 的子集 (限于本函数体)。
fn collect_locals(s: ptr, src: ptr, toks: ptr, i: u32, end: u32) -> u32 {
    let n: u32 = 0;
    let fic: u32 = 0;
    let j: u32 = i;
    while tok_kind(toks, j) != 4 && j < end {
        if tok_is(src, toks, j, "domain") && is_dom_for(src, toks, j) == 1 {
            // `docs/315`：循环变量由反糖产生（参考实现写 `let VAR: u32`）——
            // 类型是**没有 token 的 u32**，用哨兵。并行的每对都要登记。
            let vn: u32 = df_nvars(src, toks, j);
            let vi: u32 = 0;
            while vi < vn {
                n = add_local(s, src, toks, n, j + 3 + vi * 2, CG_TY_U64);
                vi = vi + 1;
            }
            j = j + 3;                       // 跳过 `domain : for`
        }
        if tok_is(src, toks, j, "match") {   // M26: match 载荷绑定也要 alloca
            let st: u32 = expr_type(s, src, toks, j + 1);
            let mei: u32 = find_enum(s, src, toks, st);
            if mei != 4294967295 {
                let mstop: u32 = skip_block(src, toks, j + 2);
                let mp: u32 = j + 3;
                while mp < mstop {
                    if tok_is(src, toks, mp, ":") && tok_is(src, toks, mp + 1, ":")
                            && tok_is(src, toks, mp + 3, "(") {
                        let mvt: u32 = enum_variant_index(s, src, toks, mei, mp + 2);
                        let mstub: u32 = push_ty_subst(s, src, toks, st);   // `match a` 的 a: Opt<u32>
                        let mpt: u32 = enum_payload_type(s, src, toks, mei, mvt);
                        pop_subst(s, mstub);
                        let mbn: u32 = mp + 4;
                        if mpt != 0 && mbn < mstop {
                            n = add_local(s, src, toks, n, mbn, mpt);
                        }
                    }
                    mp = mp + 1;
                }
            }
        }
        if load32(s, CG_PROF) >= 2 && tok_is(src, toks, j, "for")
                && load32(toks, (j + 1) * 20) == 0 && tok_is(src, toks, j + 2, "in")
                && load32(toks, (j + 3) * 20) == 0 && tok_is(src, toks, j + 4, "(")
                && tok_is(src, toks, skip_parens(src, toks, j + 4) + 1, "{") {
            // 2026.3 `for x in <call>`（`docs/334`）：局部顺序 = `__tur2_s.N`、
            // `__tur2_i.N`、`x`。源临时后登记，先于循环；类型取调用返回类型 token。
            let sty: u32 = expr_type(s, src, toks, j + 3);
            let et: u32 = elem_tok(src, toks, sty);
            fic = fic + 1;
            n = add_local(s, src, toks, n, syn_name(4, fic), sty);
            n = add_local(s, src, toks, n, syn_name(3, fic), SYN_U32);
            if et != 0 {
                n = add_local(s, src, toks, n, j + 1, et);
            }
            store32(s, 484, n);
        } else if load32(s, CG_PROF) >= 2 && tok_is(src, toks, j, "for")
                && load32(toks, (j + 1) * 20) == 0 && tok_is(src, toks, j + 2, ",")
                && load32(toks, (j + 3) * 20) == 0 && tok_is(src, toks, j + 4, "in")
                && load32(toks, (j + 5) * 20) == 0 && tok_is(src, toks, j + 6, "{") {
            // 2026.3 `for i, x in xs`（`docs/332` §5）：局部顺序 = `__tur2_i.N`、`i`、`x`。
            let st: u32 = j + 5;
            store32(s, 484, n);
            let sty: u32 = var_type(s, src, toks, st);
            let et: u32 = elem_tok(src, toks, sty);
            fic = fic + 1;
            n = add_local(s, src, toks, n, syn_name(3, fic), SYN_U32);
            // 用户下标用 `CG_TY_U64`（无 token 的 u32 哨兵）。`SYN_U32` 与 UNIT 同值，
            // `emit_ty` 会把它印成 `void`，用户下标就成了 `load void`。
            n = add_local(s, src, toks, n, j + 1, CG_TY_U64);
            if et != 0 {
                n = add_local(s, src, toks, n, j + 3, et);
            }
            store32(s, 484, n);
        } else if tok_is(src, toks, j, "for") && load32(toks, (j + 3) * 20) == 0
                && tok_is(src, toks, j + 2, "in") && tok_is(src, toks, j + 4, "{") {
            // Tur 2 的 for-in（`docs/296` §2.2）：**下标在前、循环变量在后** —— 与参考
            // 实现反糖后的局部顺序一致（`let __tur2_i.N` 在 while 之前，`let x` 在体开头）。
            let st: u32 = j + 3;
            // `var_type` 按 `load32(s, 484)` 走局部表 —— 这一趟本身就在填它，所以先把
            // 当前条数写回去，才看得见前面那些 `let`（末尾还会再写一次最终的 n）。
            store32(s, 484, n);
            let sty: u32 = var_type(s, src, toks, st);
            let et: u32 = elem_tok(src, toks, sty);
            fic = fic + 1;
            n = add_local(s, src, toks, n, syn_name(3, fic), SYN_U32);
            if et != 0 {
                n = add_local(s, src, toks, n, j + 1, et);
            }
            store32(s, 484, n);
        } else if tok_is(src, toks, j, "for") {   // range for 变量也需 alloca
            let name: u32 = j + 1;
            // 与 lomentc 同规则: 类型 = expr_type(lo) or expr_type(hi) or u32(0)
            let vt: u32 = expr_type(s, src, toks, j + 3);
            if vt == 0 {
                let d: u32 = j + 3;
                while tok_kind(toks, d) != 4 && !tok_is(src, toks, d, "{") {
                    if tok_is(src, toks, d, ".") && tok_is(src, toks, d + 1, ".") {
                        vt = expr_type(s, src, toks, d + 2);
                    }
                    d = d + 1;
                }
            }
            let dup0: u32 = 0;
            let kk: u32 = 0;
            while kk < n {
                if load32(s, CG_LOCAL + kk * 8) == name {
                    dup0 = 1;
                }
                kk = kk + 1;
            }
            if dup0 == 0 {
                store32(s, CG_LOCAL + n * 8, name);
                store32(s, CG_LOCAL + n * 8 + 4, vt);
                n = n + 1;
            }
        }
        if tok_is(src, toks, j, "let") && !tok_is(src, toks, j - 1, "if") {   // `if let` 走下一分支
            let name: u32 = j + 1;
            let ty: u32 = j + 3;
            let eq2: u32 = skip_type(src, toks, ty);
            if tok_is(src, toks, eq2 - 2, "in") && tok_kind(toks, eq2 - 1) == 0 {
                let _ds1: u32 = dsp_set(s, src, toks, name, eq2 - 1);   // docs/314
            }
            let qs: u32 = find_try_q(src, toks, eq2 + 1);
            if qs != 0 {
                // M9: `let x: T = e?;` 反糖成 `let __t{line} / let x / match { Ok=>x=v; Err=>return Err(e) }`
                // —— 局部表按反糖后的顺序收 (镜像 _collect_locals 走的那棵 AST)
                let ln2: u32 = load32(toks, j * 20 + 12);
                let rt2: u32 = expr_type(s, src, toks, eq2 + 1);
                n = add_local(s, src, toks, n, syn_name(0, ln2), rt2);
                n = add_local(s, src, toks, n, name, ty);
                let ei2: u32 = find_enum(s, src, toks, rt2);
                if ei2 != 4294967295 {
                    // 变体序写死 0/1: Result 是预置的 `{ Ok(T), Err(E) }`, _desugar_try 也写死这两个名字
                    let sb2: u32 = push_ty_subst(s, src, toks, rt2);
                    let okp: u32 = enum_payload_type(s, src, toks, ei2, 0);
                    let errp: u32 = enum_payload_type(s, src, toks, ei2, 1);
                    pop_subst(s, sb2);
                    n = add_local(s, src, toks, n, syn_name(1, ln2), okp);
                    n = add_local(s, src, toks, n, syn_name(2, ln2), errp);
                }
            } else {
                n = add_local(s, src, toks, n, name, ty);
            }
            if load32(s, CG_PROF) >= 2 && tok_is(src, toks, eq2 + 1, "match") {
                // 2026.3 `let x: T = match e { … };`（`docs/336`）：反糖后的局部顺序是
                // `x` 在前、各臂的载荷绑定在后 —— 与普通 match 语句的那一趟同一个走法。
                let mst: u32 = expr_type(s, src, toks, eq2 + 2);
                let mei: u32 = find_enum(s, src, toks, mst);
                if mei != 4294967295 {
                    let mstop: u32 = skip_block(src, toks, eq2 + 3);
                    let mp: u32 = eq2 + 4;
                    while mp < mstop {
                        if tok_is(src, toks, mp, ":") && tok_is(src, toks, mp + 1, ":")
                                && tok_is(src, toks, mp + 3, "(") {
                            let mvt: u32 = enum_variant_index(s, src, toks, mei, mp + 2);
                            let mstub: u32 = push_ty_subst(s, src, toks, mst);
                            let mpt: u32 = enum_payload_type(s, src, toks, mei, mvt);
                            pop_subst(s, mstub);
                            let mbn: u32 = mp + 4;
                            if mpt != 0 && mbn < mstop {
                                n = add_local(s, src, toks, n, mbn, mpt);
                            }
                        }
                        mp = mp + 1;
                    }
                }
            }
        }
        if tok_is(src, toks, j, "if") && tok_is(src, toks, j + 1, "let") {
            // M10: `if let Enum::V(bind) = e` 在 parser 里就反糖成 Match —— 绑定也要 alloca。
            // 形状: `if` `let` Enum `:` `:` V `(` bind `)` `=` <主体>
            let iv2: u32 = j + 5;
            let ib2: u32 = j + 7;
            if tok_is(src, toks, j + 6, "(") {
                let ist: u32 = expr_type(s, src, toks, j + 10);
                let mei2: u32 = find_enum(s, src, toks, ist);
                if mei2 != 4294967295 {
                    let isub: u32 = push_ty_subst(s, src, toks, ist);
                    let mvt2: u32 = enum_variant_index(s, src, toks, mei2, iv2);
                    let mpt2: u32 = enum_payload_type(s, src, toks, mei2, mvt2);
                    pop_subst(s, isub);
                    if mpt2 != 0 {
                        n = add_local(s, src, toks, n, ib2, mpt2);
                    }
                }
            }
        }
        j = j + 1;
    }
    store32(s, 484, n);
    return n;
}

fn count_args(src: ptr, toks: ptr, lp: u32) -> u32 {
    let d: u32 = 0;
    let argc: u32 = 0;
    let any: u32 = 0;
    let j: u32 = lp + 1;
    while !(tok_is(src, toks, j, ")") && d == 0) && tok_kind(toks, j) != 4 {
        if tok_is(src, toks, j, "(") || tok_is(src, toks, j, "[") {
            d = d + 1;
        }
        if tok_is(src, toks, j, ")") || tok_is(src, toks, j, "]") {
            d = d - 1;
        }
        if tok_is(src, toks, j, ",") && d == 0 {
            argc = argc + 1;
        }
        any = 1;
        j = j + 1;
    }
    if any == 0 {
        return 0;
    }
    return argc + 1;
}

/// freestanding 运行时文本块 (镜像 lomentc._IR_RUNTIME), 仅当出现过 `/` `%` 时写出。
/// 位置同 lomentc: 横幅之后、第一个函数之前 (尾部一个空行)。
/// **分配器**（`docs/175` §3.4 的 `gc_manual`）—— 与它的**全局**同进同出。
///
/// 单独一个函数、单独一处 `emit_str`，因为它**有自己的全局**
/// （`@__loment_heap` / `@__loment_off` / `@__loment_freehead`）。而
/// 「发运行期」与「发全局」若是两个独立门，就会有一个程序发出 `__loment_alloc`
/// 却没有任何全局可引用 —— **实测**：一份只用整数除法（于是 `@__loment_` 出现、
/// 运行期被发出）而不用 `alloc` 的单元，编译期直接报
/// `use of undefined value '@__loment_freehead'`。文本与 `lomentc._IR_HEAP` 同序。
fn emit_heap(s: ptr, out: ptr, lms: u32, ctl: u32) -> u32 {
    // **LMS 第 3 级入口 A**（`docs/253` §5.3）：`lms` 开着时，`alloc` 分配不出**先收一次
    // 再试**，还不行才 abort。这段文本与 `lomentc._IR_HEAP_LMS` **逐字节同源** ——
    // 四处增量与参考那一侧的四处改写一一对应：
    //   ① 入口处的 `%lmsretry = alloca i1`（**本帧的**，不是全局 —— 默认满档之后
    //      `docs/253` §13.2 那条"默认产物不带 `@__loment_` 符号"必须仍然成立，
    //      而全局标记还会在重入时串味）；② `floop` 的 phi 多一条入边；
    //   ③ `boom` 换成 `rescue`/`dead`；④ **两条成功返回前**各清一次重试标记。
    // ⚠ **④ 不能省**：不清的话"这一次"用掉的唯一一次重试会**留给下一次分配** ——
    // 那是**假的能力**（第二次真耗尽时它不救了）。
    // ⚠ 上面那句"脚本从它生成"是**旧注释**：树里**没有**那个脚本，这一段是手维护的。
    let o: u32 = 0;
    o = emit_str(s, out, "; ---- 分配器（docs/175 §3.4 的 `gc_manual`）------------------------------------
;
; 这里以前是**纯 bump**（`@__loment_off` 只涨不落），而 `free` 是个**占位** ——
; 写它编得过、跑起来什么都不发生。`docs/175` §3.4 把那种形状点名叫「**允诺却不兑现**」，
; 所以这一版把它兑现：**bump + 地址序空闲链表**。
;
; 块的形状（8 字节头，**载荷 16 字节对齐**）：
;   +0  i32  size   —— 这一块的**总长**（含头），永远是 16 的倍数
;   +4  i32  next   —— 下一块**空闲**块的偏移；0 = 链尾（所以偏移 0 永远不是块）
;                    **负数 = 这块正借在外面**（`alloc` 发的）—— `free` 看**符号**挡双重释放。
;                    值是 `-(mask + 2)`，`mask` 是**块内槽掩码**（`docs/210` §2.9）：
;                    `-1`（恰好是原先那个数）⇒ 块内**整块保守扫**；`≤ -2` ⇒ 块内精确。
;                    掩码**不进任何表** —— 它就是这个字本身。
; 载荷从 +8 开始。整个 arena 是 `@__loment_heap`，偏移从 0 起算。
; **头仍是 8 字节，但 `%need` 按 16 向上取整**：块起点恒为 8 (mod 16)，载荷（+8）因此
; 落在 16 的倍数上。C 的 `malloc` 契约要求 `max_align_t` (16) 对齐，`-mavx2` 的
; `vmovdqa` 直接依赖它（`#620`）。
;
; 三条规则，各有它要挡的东西：
;   * **第一次适配 + 拆分**：空闲块大到有余（余量 ≥ 16）就切一块出来，余下的还回链上。
;     不拆的话一次大分配会把整个链表吃光。**记录尺寸永远等于这块的实际跨度** ——
;     不拆的时候**不把 size 改小**（余量不足 16 字节，改小它换不来可用空间，
;     只让按 size 走的遍历掉进块内部，`FujoJTOP/loment#368`）。
;   * **地址序**：链表按地址升序，`free` 线性找插入点。顺序让「前沿回退」可判。
;   * **前沿回退**：释放的那一块**正好顶到 bump 前沿**时，直接把前沿退回去。
;     这是 LIFO（分配—释放—再分配）不涨内存的原因；没有它，`free` 只是把块挂起来，
;     bump 前沿照样一路涨到 OOM。
;
;   * **`free` 先验所有权**（2026-10-13）：越界 / 未对齐 / 头不合常理 / **已经释放过**的，
;     一律**惰性返回**（不 abort，也绝不挂链）。双重释放会把同一块**同时**放在前沿与空闲
;     链表上，于是两次 `alloc` 拿到同一段内存 —— 那是这个分配器唯一能真正毁掉程序的形状。
;     残余边界（对齐得正好、后面那个字又恰好是**负数**的派生指针）写在 `docs/210` §2.8。
;
; **还没做的**（下一层）：物理相邻的两块不合并（coalesce）。非 LIFO 的碎片化因此还在，
; 而且它是收集器那一层的活（`docs/175` §3.4 的 `gc_auto`）。
define internal ptr @__loment_alloc(i32 %size) {
entry:
");
    if lms == 1 {
        o = emit_str(s, out, "  %lmsretry = alloca i1
  store i1 false, ptr %lmsretry
");
    }
    o = emit_str(s, out, "  %need0 = add i32 %size, 23
  %need = and i32 %need0, -16
  %head = load i32, ptr @__loment_freehead
  br label %floop
floop:
");
    if lms == 1 {
        o = emit_str(s, out, "  %cur = phi i32 [ %head, %entry ], [ %nxt, %fnext ], [ %head2, %rescue ]
  %prev = phi i32 [ 0, %entry ], [ %cur, %fnext ], [ 0, %rescue ]
");
    } else {
        o = emit_str(s, out, "  %cur = phi i32 [ %head, %entry ], [ %nxt, %fnext ]
  %prev = phi i32 [ 0, %entry ], [ %cur, %fnext ]
");
    }
    o = emit_str(s, out, "  %fend = icmp eq i32 %cur, 0
  br i1 %fend, label %bump, label %fit
fit:
  %hp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %cur
  %bsz = load i32, ptr %hp
  %big = icmp uge i32 %bsz, %need
  br i1 %big, label %take, label %fnext
fnext:
  %n4 = add i32 %cur, 4
  %npp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %n4
  %nxt = load i32, ptr %npp
  br label %floop
take:
  %slack = sub i32 %bsz, %need
  %cansplit = icmp uge i32 %slack, 16
  %t4 = add i32 %cur, 4
  %tpp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %t4
  %rest = load i32, ptr %tpp
  br i1 %cansplit, label %split, label %nosplit
split:
  ; **块的记录尺寸只在「真拆了」的时候才改小**（`FujoJTOP/loment#368`）——
  ; 原来这句在 `taken:` 里无条件执行，于是**不拆分**那条路（余量 < 16 字节，
  ; 块还是那么大，只是没切）也会把 size 改成 `need`。后果有两层：
  ;   * 按 `size` 往前走的每一趟（`__loment_alloc` 的首次适配、`__loment_sweep`、
  ;     `__loment_propagate`、以及收集器的两步）都会从 `cur + need` 继续，
  ;     而那已经不是下一块了 —— 它掉进**块的内部**，把载荷当尺寸读；
  ;   * 载荷里的字节多半是 0 ⇒ `i += 0` ⇒ **死循环**（实测：2 分钟不返回）。
  ; 判据：`loment_elf_test::test_a_reused_block_keeps_its_recorded_extent`。
  %so = add i32 %cur, %need
  %spp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %so
  store i32 %slack, ptr %spp
  %so4 = add i32 %so, 4
  %spp4 = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %so4
  store i32 %rest, ptr %spp4
  store i32 %need, ptr %hp
  br label %relink
nosplit:
  ; 不拆：**尺寸原样留着**（就是 `%bsz`）—— 那几十字节的余量仍然在块里，
  ; 只是不足以另立一块。改小它不会让那点余量变得可用，只会让遍历失步。
  br label %relink
relink:
  %newhead = phi i32 [ %so, %split ], [ %rest, %nosplit ]
  %ishead = icmp eq i32 %prev, 0
  br i1 %ishead, label %sethead, label %setprev
sethead:
  store i32 %newhead, ptr @__loment_freehead
  br label %taken
setprev:
  %p4 = add i32 %prev, 4
  %ppp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %p4
  store i32 %newhead, ptr %ppp
  br label %taken
taken:
  %t4b = add i32 %cur, 4
  %tppb = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %t4b
  store i32 -1, ptr %tppb
  %ko = add i32 %cur, 8
  %kp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %ko
");
    if lms == 1 {
        o = emit_str(s, out, "  store i1 false, ptr %lmsretry
");
    }
    o = emit_str(s, out, "  ret ptr %kp
bump:
  %off = load i32, ptr @__loment_off
  %nxtoff = add i32 %off, %need
  %fits = icmp ule i32 %nxtoff, 65536
  br i1 %fits, label %bok, label %boom
boom:
");
    if lms == 1 {
        o = emit_str(s, out, "  ; ---- LMS 第 3 级入口 A（docs/253 §5.3）：先拉回，拉不回来才死 ----
  %lmsdone = load i1, ptr %lmsretry
  br i1 %lmsdone, label %dead, label %rescue
rescue:
  store i1 true, ptr %lmsretry
");
        if ctl == 1 {
            // `lgc` 档（`docs/309`）：**OOM 也要过同一道闸** —— 拿 `collect_now` 而不是
            // `collect`，否则一次分配失败会绕过暂停（参考实现里这是实打实的一个 bug）。
            o = emit_str(s, out, "  call void @__loment_collect_now()
");
        } else {
            o = emit_str(s, out, "  call void @__loment_collect()
");
        }
        o = emit_str(s, out, "  %head2 = load i32, ptr @__loment_freehead
  br label %floop
dead:
  call void @__loment_abort()
  unreachable
");
    } else {
        o = emit_str(s, out, "  call void @__loment_abort()
  unreachable
");
    }
    o = emit_str(s, out, "bok:
  store i32 %nxtoff, ptr @__loment_off
  %wp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %off
  store i32 %need, ptr %wp
  %w4 = add i32 %off, 4
  %wp4 = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %w4
  store i32 -1, ptr %wp4
  %bo = add i32 %off, 8
  %bp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %bo
");
    if lms == 1 {
        o = emit_str(s, out, "  store i1 false, ptr %lmsretry
");
    }
    o = emit_str(s, out, "  ret ptr %bp
}

define internal void @__loment_free(ptr %p) {
entry:
  %base = ptrtoint ptr @__loment_heap to i64
  %pi = ptrtoint ptr %p to i64
  %d64 = sub i64 %pi, %base
  %d32 = trunc i64 %d64 to i32
  %alo = icmp uge i32 %d32, 16
  br i1 %alo, label %inrange, label %out
inrange:
  %offa = load i32, ptr @__loment_off
  %ahi = icmp ule i32 %d32, %offa
  br i1 %ahi, label %align, label %out
align:
  %m7 = and i32 %d32, 7
  %aok = icmp eq i32 %m7, 0
  br i1 %aok, label %hdr, label %out
hdr:
  %hi = sub i32 %d32, 8
  %hp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %hi
  %sz = load i32, ptr %hp
  %h4 = add i32 %hi, 4
  %hpp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %h4
  %nx = load i32, ptr %hpp
  %onloan = icmp slt i32 %nx, 0
  br i1 %onloan, label %sane, label %out
sane:
  %szok = icmp uge i32 %sz, 8
  %hend = add i32 %hi, %sz
  %endok = icmp ule i32 %hend, %offa
  %hok = and i1 %szok, %endok
  br i1 %hok, label %check, label %out
check:
  ; ---- 擦除载荷（#789）------------------------------------------------------------
  ; `free` 之后这块随时会被下一次 `alloc` 原样交出去。不擦的话，新主人读到的是
  ; 上一任留下的字节 —— 分配的是 `cap`、只填了 `n`、把 `cap` 发出去的程序因此静默
  ; 泄密（Heartbleed 形状，CWE-200/457）。arena 的 `zeroinitializer` 只覆盖**第一次**
  ; 分配，覆盖不到复用。代价是一次按块长的 `memset`（这里展开成逐字节循环）。
  ; 范围是 `[hi+8, hend)`：`hend = hi + sz` 是这块的**记录总长**，擦的正是下一个
  ; 主人能合法看到的那段载荷。
  %zstart = add i32 %hi, 8
  br label %zloop
zloop:
  %zi = phi i32 [ %zstart, %check ], [ %znext, %zbody ]
  %zdone = icmp uge i32 %zi, %hend
  br i1 %zdone, label %zend, label %zbody
zbody:
  %zpp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %zi
  store i8 0, ptr %zpp
  %znext = add i32 %zi, 1
  br label %zloop
zend:
  %off = load i32, ptr @__loment_off
  %istail = icmp eq i32 %hend, %off
  br i1 %istail, label %rewind, label %link
out:
  ret void
rewind:
  store i32 %hi, ptr @__loment_off
  ret void
link:
  %head = load i32, ptr @__loment_freehead
  br label %lloop
lloop:
  %cur = phi i32 [ %head, %link ], [ %nxt, %lcont ]
  %prev = phi i32 [ 0, %link ], [ %cur, %lcont ]
  %lend = icmp eq i32 %cur, 0
  %after = icmp ugt i32 %cur, %hi
  %stop = or i1 %lend, %after
  br i1 %stop, label %ins, label %lcont
lcont:
  %l4 = add i32 %cur, 4
  %lpp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %l4
  %nxt = load i32, ptr %lpp
  br label %lloop
ins:
  %i4 = add i32 %hi, 4
  %ipp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %i4
  store i32 %cur, ptr %ipp
  %ishead2 = icmp eq i32 %prev, 0
  br i1 %ishead2, label %sethead, label %setprev
sethead:
  store i32 %hi, ptr @__loment_freehead
  ret void
setprev:
  %q4 = add i32 %prev, 4
  %qpp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %q4
  store i32 %hi, ptr %qpp
  ret void
}

@__loment_heap = internal global [65536 x i8] zeroinitializer
@__loment_off = internal global i32 8
@__loment_freehead = internal global i32 0

");
    return o;
}

/// **线程标志**（`#778`）—— 与 `lomentc._IR_RT_THREADS` 逐字节同源。
/// `1` = 这台进程起过线程；`maybe_collect` 见到它就整个不跑。
fn emit_rt_threads(s: ptr, out: ptr) -> u32 {
    return emit_str(s, out, "@__loment_rt_threads = internal global i32 0

");
}

/// **运行期锁**（`#778`）—— 与 `lomentc._IR_RT_LOCK` 逐字节同源。
///
/// 一条全局取号锁：`atomic_add` 取号、`@__loment_rt_own` 记持有者 tid 做重入。
/// 只有真起线程的产物才发（`s + 556`）；`alloc` / `free` / 根表游标在 thread 程序里
/// 各拿一次。**收集器不在任何线程活着的时候跑** —— 见 `maybe_collect` 里的线程标志。
fn emit_rt_lock(s: ptr, out: ptr) -> u32 {
    return emit_str(s, out, "; ---- 运行期锁（`FujoJTOP/loment#778`）----------------------------------------
;
; **模型**（`docs/245` §10）：一条全局取号锁串行化 `alloc` / `free` / 根表游标；
; 自动收集在**有线程活着**时**整个不跑**（`@__loment_rt_threads != 0` 时 `maybe_collect`
; 直接返回）。于是收集器只在「起过线程之前」运行 —— 它不去停
; 任何一个 mutator，也不需要停。线程之间真正并发；`atomic_add` 是 seq_cst。
;
; 重入靠 `@__loment_rt_own`（持有者的 tid；`tid` 永远 > 0，0 = 没人持有）。
@__loment_rt_next = internal global i32 0
@__loment_rt_serving = internal global i32 0
@__loment_rt_own = internal global i32 0
@__loment_rt_depth = internal global i32 0

define internal i32 @__loment_rt_tid() {
entry:
  %t = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 186, i64 0, i64 0, i64 0)
  %r = trunc i64 %t to i32
  ret i32 %r
}

define internal void @__loment_rt_acquire() {
entry:
  %ti = call i32 @__loment_rt_tid()
  %o = atomicrmw add ptr @__loment_rt_own, i32 0 seq_cst
  %mine = icmp eq i32 %o, %ti
  br i1 %mine, label %reenter, label %wait
reenter:
  %d0 = load i32, ptr @__loment_rt_depth
  %d1 = add i32 %d0, 1
  store i32 %d1, ptr @__loment_rt_depth
  ret void
wait:
  %tkt = atomicrmw add ptr @__loment_rt_next, i32 1 seq_cst
  br label %spin
spin:
  %srv = atomicrmw add ptr @__loment_rt_serving, i32 0 seq_cst
  %ours = icmp eq i32 %srv, %tkt
  br i1 %ours, label %got, label %spin
got:
  %own = atomicrmw add ptr @__loment_rt_own, i32 %ti seq_cst
  store i32 1, ptr @__loment_rt_depth
  ret void
}

define internal void @__loment_rt_release() {
entry:
  %d0 = load i32, ptr @__loment_rt_depth
  %d1 = sub i32 %d0, 1
  store i32 %d1, ptr @__loment_rt_depth
  %z = icmp eq i32 %d1, 0
  br i1 %z, label %drop, label %done
drop:
  %o = atomicrmw add ptr @__loment_rt_own, i32 0 seq_cst
  %neg = sub i32 0, %o
  %clr = atomicrmw add ptr @__loment_rt_own, i32 %neg seq_cst
  %rel = atomicrmw add ptr @__loment_rt_serving, i32 1 seq_cst
  br label %done
done:
  ret void
}


");
}

/// **`hosted` 那一份分配器**（`docs/228` 的 A = `docs/219` §8b 的 **S1e**）——
/// 下面这几段字面量与 `lomentc._IR_HEAP_HOSTED` **逐字节同源**（脚本从它切的，不手抄）。
///
/// 与 `emit_heap` **同序、同一条空闲链表**，只换两件事：arena 从**外面**来
/// （`@__loment_arena()` 惰性地 `malloc` 一块，拿不到就 `__loment_abort`），
/// 于是寻址全走 `%hb`（基址）。块的形状、地址序、首次适配 + 拆分、前沿回退一个字节没动。
///
/// **切成三段**：`HEAD`（注释）/ `@__loment_arena()` / `BODY`（分配器本体 + 全局）。
/// 切在那儿是因为 arena 那一段有**两个版本**（宿主给的、封在产物里给的）——
/// 换的就是那一段，另外两段一个字都不动 —— 所以是**一个**函数带标志，不是两个。
///
/// **`sealed` 走不到这一段**（`docs/228` §2）—— 闸门是 `choose hosted`，所以现存每一份
/// sealed 产物的字节不变。**`gc_any` 档也走不到**：收集器的标记表按 arena 偏移索引、
/// 行数 = arena/8，换 arena 要同时换表的口径，那是收集器的活（`docs/228` §4 的 B1）。
/// **`extern fn` 那一份分配器**（`docs/219` §8b 的 **S2**，2026-10-15）——
/// 与 `emit_heap_hosted` **只差 arena 那一段**：宿主那一版问 `malloc`，这一版是
/// **产物里那块静态数组**（`@__loment_arena_block`）。真 C 库（zlib 的 `deflateInit`）
/// 要 256–512 KiB，`emit_heap` 那 64 KiB 装不下 —— 而 `sealed` 的定义是"底下没有东西"，
/// 没有宿主的 `malloc` 可问（`docs/228` §2）。
///
/// **代价明写**：`[1048576 x i8]` 是 `.bss`，而本仓的链接器把 `.bss` 按零字节摆进
/// 数据段（S1f 的取舍）⇒ 产物文件大 1 MiB。"向外面要"（`mmap`/`brk` = S1e B）不在
/// 这条路上。
///
/// **谁走这一版**：根开了运行期、声明了 `extern fn`、且**不是** `hosted` 的单元。
/// 产物自己说出来：`; loment-heap: ffi 1048576`。
/// **`gc_auto_alpha` 除外**（那一档的收集器是直接寻址 arena 的，见 `emit_llvm`）——
/// 它留在 64 KiB 并说出 `; loment-heap: static 65536`。
///
/// **LMS 第 3 级入口 A**（`docs/253` §5.3）：`lms` 开着**且**这份产物里有收集器时，
/// `alloc` 分配不出**先收一次再试**，还不行才 `__loment_abort`。文本与参考实现那一侧的
/// `_heap_with_lms_rescue(_IR_HEAP_HOSTED)` / `(_IR_HEAP_FFI)` **逐字节同源** ——
/// 那一侧是**同一个变换**套在这两条 IR 上的，所以这里两版（`statik` 0/1）也要一样地套。
/// ⚠ 四处增量与 `emit_heap` 那四处一一对应：全局声明 / `floop` 的 phi 多一条入边 /
/// `boom` 换成 `rescue`·`dead` / **两条成功返回前**各清一次重试标记。
fn emit_heap_indirect(s: ptr, out: ptr, statik: u32, lms: u32, ctl: u32) -> u32 {
    let d: u32 = 0;
    d = d + emit_str(s, out, "; ---- 分配器（`docs/228`：arena 从**外面**来的那一份；`docs/175` §3.4）--------------------
;
; 与 `_IR_HEAP` 同序、同一条空闲链表，只换两件事：arena 从**外面**来
; （**谁给**写在下面那段 `@__loment_arena()` 里：宿主给的、或产物里那块静态的）、
; 寻址走 `%hb`（基址）。
;
; **`free` 的所有权校验与 `_IR_HEAP` 是同一套**（借出标记是负数 + 四条廉价检查；2026-10-13 起
; 标记由原先那个 `-1` 放宽成 `-(掩码 + 2)`，好让块头带上**块内槽掩码**，见 `docs/210` §2.9），
; 残余边界同样写在 `docs/210` §2.8。
; 块的形状、地址序、首次适配 + 拆分、前沿回退一个字节没动 —— 因为 arena 仍是**一段
; 连续内存**（偏移是 i32；多段才是重写分配器，见 `docs/228` §4 的 B2）。
;
; 一次要 `1048576` 字节，惰性（第一次 `alloc` 才要）；要不到就 `__loment_abort`。

");
    if statik == 1 {
        d = d + emit_str(s, out, "@__loment_arena_block = internal global [1048592 x i8] zeroinitializer

define internal ptr @__loment_arena() {
entry:
  ; **按 16 向上取整**（`#620`）：块的载荷在 `基址 + 8`，基址 16 对齐之后 `malloc`
  ; 才满足 C 的 `max_align_t`。多出的 16 字节保证取整后的尾端仍在数组内。
  %i = ptrtoint ptr @__loment_arena_block to i64
  %ia = add i64 %i, 15
  %im = and i64 %ia, -16
  %r = inttoptr i64 %im to ptr
  ret ptr %r
}

");
    } else {
        d = d + emit_str(s, out, "; **宿主版**：向宿主要一块（`malloc`），惰性（第一次 `alloc` 才要）。
define internal ptr @__loment_arena() {
entry:
  %h = load ptr, ptr @__loment_heap
  %nul = icmp eq ptr %h, null
  br i1 %nul, label %ask, label %have
ask:
  %m = call ptr @malloc(i64 1048592)
  %bad = icmp eq ptr %m, null
  br i1 %bad, label %oom, label %set
oom:
  call void @__loment_abort()
  unreachable
set:
  store ptr %m, ptr @__loment_heap
  br label %have
have:
  %r = phi ptr [ %h, %entry ], [ %m, %set ]
  %ri = ptrtoint ptr %r to i64
  %ra = add i64 %ri, 15
  %rm = and i64 %ra, -16
  %al = inttoptr i64 %rm to ptr
  ret ptr %al
}

");
    }
    d = d + emit_str(s, out, "define internal ptr @__loment_alloc(i32 %size) {
entry:
");
    if lms == 1 {
        d = d + emit_str(s, out, "  %lmsretry = alloca i1
  store i1 false, ptr %lmsretry
");
    }
    d = d + emit_str(s, out, "  %hb = call ptr @__loment_arena()
  %need0 = add i32 %size, 23
  %need = and i32 %need0, -16
  %head = load i32, ptr @__loment_freehead
  br label %floop
floop:
");
    if lms == 1 {
        d = d + emit_str(s, out, "  %cur = phi i32 [ %head, %entry ], [ %nxt, %fnext ], [ %head2, %rescue ]
  %prev = phi i32 [ 0, %entry ], [ %cur, %fnext ], [ 0, %rescue ]
");
    } else {
        d = d + emit_str(s, out, "  %cur = phi i32 [ %head, %entry ], [ %nxt, %fnext ]
  %prev = phi i32 [ 0, %entry ], [ %cur, %fnext ]
");
    }
    d = d + emit_str(s, out, "  %fend = icmp eq i32 %cur, 0
  br i1 %fend, label %bump, label %fit
fit:
  %hp = getelementptr i8, ptr %hb, i32 %cur
  %bsz = load i32, ptr %hp
  %big = icmp uge i32 %bsz, %need
  br i1 %big, label %take, label %fnext
fnext:
  %n4 = add i32 %cur, 4
  %npp = getelementptr i8, ptr %hb, i32 %n4
  %nxt = load i32, ptr %npp
  br label %floop
take:
  %slack = sub i32 %bsz, %need
  %cansplit = icmp uge i32 %slack, 16
  %t4 = add i32 %cur, 4
  %tpp = getelementptr i8, ptr %hb, i32 %t4
  %rest = load i32, ptr %tpp
  br i1 %cansplit, label %split, label %nosplit
split:
  ; **块的记录尺寸只在「真拆了」的时候才改小**（`FujoJTOP/loment#368`）—— 理由见
  ; `_IR_HEAP` 同一条（这段与那一份逐字同源，只换 arena 的来处与寻址）。
  %so = add i32 %cur, %need
  %spp = getelementptr i8, ptr %hb, i32 %so
  store i32 %slack, ptr %spp
  %so4 = add i32 %so, 4
  %spp4 = getelementptr i8, ptr %hb, i32 %so4
  store i32 %rest, ptr %spp4
  store i32 %need, ptr %hp
  br label %relink
nosplit:
  ; 不拆：**尺寸原样留着**（就是 `%bsz`）。
  br label %relink
relink:
  %newhead = phi i32 [ %so, %split ], [ %rest, %nosplit ]
  %ishead = icmp eq i32 %prev, 0
  br i1 %ishead, label %sethead, label %setprev
sethead:
  store i32 %newhead, ptr @__loment_freehead
  br label %taken
setprev:
  %p4 = add i32 %prev, 4
  %ppp = getelementptr i8, ptr %hb, i32 %p4
  store i32 %newhead, ptr %ppp
  br label %taken
taken:
  %t4b = add i32 %cur, 4
  %tppb = getelementptr i8, ptr %hb, i32 %t4b
  store i32 -1, ptr %tppb
  %ko = add i32 %cur, 8
  %kp = getelementptr i8, ptr %hb, i32 %ko
");
    if lms == 1 {
        d = d + emit_str(s, out, "  store i1 false, ptr %lmsretry
");
    }
    d = d + emit_str(s, out, "  ret ptr %kp
bump:
  %off = load i32, ptr @__loment_off
  %nxtoff = add i32 %off, %need
  %fits = icmp ule i32 %nxtoff, 1048576
  br i1 %fits, label %bok, label %boom
boom:
");
    if lms == 1 {
        d = d + emit_str(s, out, "  ; ---- LMS 第 3 级入口 A（docs/253 §5.3）：先拉回，拉不回来才死 ----
  %lmsdone = load i1, ptr %lmsretry
  br i1 %lmsdone, label %dead, label %rescue
rescue:
  store i1 true, ptr %lmsretry
");
        if ctl == 1 {
            // `lgc` 档（`docs/309`）：同 `emit_heap` —— OOM 也要过同一道闸。
            d = d + emit_str(s, out, "  call void @__loment_collect_now()
");
        } else {
            d = d + emit_str(s, out, "  call void @__loment_collect()
");
        }
        d = d + emit_str(s, out, "  %head2 = load i32, ptr @__loment_freehead
  br label %floop
dead:
  call void @__loment_abort()
  unreachable
");
    } else {
        d = d + emit_str(s, out, "  call void @__loment_abort()
  unreachable
");
    }
    d = d + emit_str(s, out, "bok:
  store i32 %nxtoff, ptr @__loment_off
  %wp = getelementptr i8, ptr %hb, i32 %off
  store i32 %need, ptr %wp
  %w4 = add i32 %off, 4
  %wp4 = getelementptr i8, ptr %hb, i32 %w4
  store i32 -1, ptr %wp4
  %bo = add i32 %off, 8
  %bp = getelementptr i8, ptr %hb, i32 %bo
");
    if lms == 1 {
        d = d + emit_str(s, out, "  store i1 false, ptr %lmsretry
");
    }
    d = d + emit_str(s, out, "  ret ptr %bp
}

define internal void @__loment_free(ptr %p) {
entry:
  %hb = call ptr @__loment_arena()
  %base = ptrtoint ptr %hb to i64
  %pi = ptrtoint ptr %p to i64
  %d64 = sub i64 %pi, %base
  %d32 = trunc i64 %d64 to i32
  %alo = icmp uge i32 %d32, 16
  br i1 %alo, label %inrange, label %out
inrange:
  %offa = load i32, ptr @__loment_off
  %ahi = icmp ule i32 %d32, %offa
  br i1 %ahi, label %align, label %out
align:
  %m7 = and i32 %d32, 7
  %aok = icmp eq i32 %m7, 0
  br i1 %aok, label %hdr, label %out
hdr:
  %hi = sub i32 %d32, 8
  %hp = getelementptr i8, ptr %hb, i32 %hi
  %sz = load i32, ptr %hp
  %h4 = add i32 %hi, 4
  %hpp = getelementptr i8, ptr %hb, i32 %h4
  %nx = load i32, ptr %hpp
  %onloan = icmp slt i32 %nx, 0
  br i1 %onloan, label %sane, label %out
sane:
  %szok = icmp uge i32 %sz, 8
  %hend = add i32 %hi, %sz
  %endok = icmp ule i32 %hend, %offa
  %hok = and i1 %szok, %endok
  br i1 %hok, label %check, label %out
check:
  ; ---- 擦除载荷（#789）------------------------------------------------------------
  ; 与 `_IR_HEAP` 同一条：`free` 之后这块随时会被下一次 `alloc` 原样交出去，不擦就是
  ; 上一任的字节泄给新主人（CWE-200/457）。arena 来自宿主 `malloc`，**更没有**零初
  ; 保证 —— 第一次分配就可能看到别的进程/旧分配留下的内容，所以这条在这里更要紧。
  %zstart = add i32 %hi, 8
  br label %zloop
zloop:
  %zi = phi i32 [ %zstart, %check ], [ %znext, %zbody ]
  %zdone = icmp uge i32 %zi, %hend
  br i1 %zdone, label %zend, label %zbody
zbody:
  %zpp = getelementptr i8, ptr %hb, i32 %zi
  store i8 0, ptr %zpp
  %znext = add i32 %zi, 1
  br label %zloop
zend:
  %off = load i32, ptr @__loment_off
  %istail = icmp eq i32 %hend, %off
  br i1 %istail, label %rewind, label %link
out:
  ret void
rewind:
  store i32 %hi, ptr @__loment_off
  ret void
link:
  %head = load i32, ptr @__loment_freehead
  br label %lloop
lloop:
  %cur = phi i32 [ %head, %link ], [ %nxt, %lcont ]
  %prev = phi i32 [ 0, %link ], [ %cur, %lcont ]
  %lend = icmp eq i32 %cur, 0
  %after = icmp ugt i32 %cur, %hi
  %stop = or i1 %lend, %after
  br i1 %stop, label %ins, label %lcont
lcont:
  %l4 = add i32 %cur, 4
  %lpp = getelementptr i8, ptr %hb, i32 %l4
  %nxt = load i32, ptr %lpp
  br label %lloop
ins:
  %i4 = add i32 %hi, 4
  %ipp = getelementptr i8, ptr %hb, i32 %i4
  store i32 %cur, ptr %ipp
  %ishead2 = icmp eq i32 %prev, 0
  br i1 %ishead2, label %sethead, label %setprev
sethead:
  store i32 %hi, ptr @__loment_freehead
  ret void
setprev:
  %q4 = add i32 %prev, 4
  %qpp = getelementptr i8, ptr %hb, i32 %q4
  store i32 %hi, ptr %qpp
  ret void
}

@__loment_heap = internal global ptr zeroinitializer
@__loment_off = internal global i32 8
@__loment_freehead = internal global i32 0
");
    // **末尾那一个换行不是排版**：参考实现是把各段 `"\n".join(...)` 拼出来的，而堆是其中
    // **一段** —— 于是它后面**必然**跟着一个分隔符换行。自举这边是逐字节写的，得自己补。
    // 丢掉的症状很隐蔽：`loment_p8_test` 报 `ir_hosted 首个差异 @6885`，差的就是这一个
    // 字节（实测；而**链接出来的产物**看不出来 —— 链接器不在乎空行，所以 elf 那套镜像判据
    // 一直是绿的）。
    d = d + emit_str(s, out, "\n");
    return d;
}






/// **自动回收**（`choose gc_auto`）—— 文本与 `lomentc._IR_GC` **逐字节同源**
/// （下面的字面量是脚本从 `_IR_GC` 切的，不手抄）。
///
/// 它必须**排在 `emit_heap` 之后**：收集器引用 `@__loment_heap` / `@__loment_off` /
/// `@__loment_free` / `@__loment_freehead`，而那几个全局在堆那一段里。
/// 只在 `gc_auto` 档追加（槽 576），另外两档的产物因此逐字节不变。
///
/// **为什么要切成 6 段**：一整条（5.2 KB）的字符串字面量会让自举侧编出来的产物
/// **在运行期段错误**（0xC0000005，实测；堆那一条 4.6 KB 是好的）。
///
/// **Loment 的多行字面量不吞任何字符**：它的值就是引号之间的内容原样（量法：写一条
/// 收尾换行的字面量，看发出来的全局长度）。所以段与段之间**不带**换行，只有最后
/// 一段多带一个 —— 那是参考实现把各段 `join` 起来时 `_IR_GC` 之后那个分隔符，
/// 与 `emit_heap` 尾巴上那一个同一个道理。
/// **自动回收**（`choose gc_auto`）—— 文本与 `lomentc._IR_GC` **逐字节同源**
/// （下面的字面量是脚本从 `_IR_GC` 生成的，不手抄）。
///
/// 它必须**排在 `emit_heap` 之后**：收集器引用 `@__loment_heap` / `@__loment_off` /
/// `@__loment_free` / `@__loment_freehead`，而那几个全局在堆那一段里。
/// 只在 `gc_auto` 档追加（槽 576），另外两档的产物因此逐字节不变。
///
/// 尾部多一个换行：Loment 的多行字面量**不吞**任何字符（值就是引号之间原样），
/// 而这一个换行是参考实现把各段 `join` 起来时 `_IR_GC` 之后那个分隔符 ——
/// 与 `emit_heap` 尾巴上那一个同一个道理。
/// 本单元要不要**收集器与根表**（`docs/210` §2.1）：`gc_auto`（576）**或** `gc_auto_alpha`
/// （572）。此前只有 `gc_auto` —— alpha 的 L3 残差没人收（只有分配器）；这一步给 alpha
/// 也配上收集器（它的触发是自适应那支，见 `emit_gc_trigger`）。
/// `lms` **第 3 级（保障器）**开着吗（`docs/253`）—— **入口 A** 的开关。
///
/// **2026-10-18 起它读档**：默认 `lms_full` ⇒ 开着；`lms_forensic_admin` /
/// `lms_daily_admin` 也开着第 3 级；`lms_manage_only_admin` 关掉它。
/// 显式写的 `choose lms_guard` / `choose close lms_guard` **覆盖档**
/// （§11.4 叠加规则）—— 与参考实现 `_lms_level` 同一张表。
///
/// ⚠ **它只是这个开关的一半** —— 另一半是"**这份产物里真的有收集器**"
/// （`gc_any(s)`）。两个条件缺一不可：`gc_manual` 下没有东西可收，
/// "拉回"在那里是一句空话（`docs/253` §5.3 明写的边界）。
fn lms_mask(src: ptr, toks: ptr) -> u32 {
    // 档铺初值（与参考实现 `LMS_TIERS` 同一张表）：满档 127 / 法医 15 / 日常 13 / 只要管理器 2。
    let m: u32 = 127;
    let d: u32 = 0;
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        let k: u32 = tok_kind(toks, i);
        if k == 3 {
            let c: u32 = load8(src, load32(toks, i * 20 + 4)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && tok_is(src, toks, i, "choose") {
            if tok_is(src, toks, i + 1, "lms_forensic_admin") {
                m = 15;
            }
            if tok_is(src, toks, i + 1, "lms_daily_admin") {
                m = 13;
            }
            if tok_is(src, toks, i + 1, "lms_manage_only_admin") {
                m = 2;
            }
        }
        i = i + 1;
    }
    // 显式开关**覆盖**档（`docs/253` §11.4 叠加规则）。位序 = 七级的次序：
    // check=1 manage=2 guard=4 reject=8 crash=16 restart=32 seed=64。
    d = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        let k: u32 = tok_kind(toks, i);
        if k == 3 {
            let c: u32 = load8(src, load32(toks, i * 20 + 4)) as u32;
            if c == 123 || c == 40 || c == 91 {
                d = d + 1;
            }
            if (c == 125 || c == 41 || c == 93) && d > 0 {
                d = d - 1;
            }
        } else if d == 0 && tok_is(src, toks, i, "choose") {
            let isdef: u32 = 0;
            if i > 0 {
                if tok_is(src, toks, i - 1, "set") {
                    isdef = 1;
                }
            }
            if isdef == 0 {
                let neg: u32 = 0;
                let j: u32 = i + 1;
                if tok_is(src, toks, i + 1, "close") {
                    neg = 1;
                    j = i + 2;
                }
                let bit: u32 = 0;
                if tok_is(src, toks, j, "lms_check") {
                    bit = 1;
                }
                if tok_is(src, toks, j, "lms_manage") {
                    bit = 2;
                }
                if tok_is(src, toks, j, "lms_guard") {
                    bit = 4;
                }
                if tok_is(src, toks, j, "lms_reject") {
                    bit = 8;
                }
                if tok_is(src, toks, j, "lms_crash") {
                    bit = 16;
                }
                if tok_is(src, toks, j, "lms_restart") {
                    bit = 32;
                }
                if tok_is(src, toks, j, "lms_seed") {
                    bit = 64;
                }
                if bit != 0 {
                    if neg == 1 {
                        m = m & (127 - bit);
                    } else {
                        m = m | bit;
                    }
                }
            }
        }
        i = i + 1;
    }
    return m;
}

/// `let NAME: ptr = alloc(<常量>)` 的**载荷字节数**；0 = 不认（于是那条访存不发检查）。
///
/// 与参考实现 `_Ir.lms_size` **同一条规则**：按发射顺序往回找**最近一次**同名声明；
/// 中间出现一次 `<NAME> = …` 就作废。只认**编译期常量**的界（g1 格，`docs/253` §5.3）。
/// ⚠ 保守：`ptr_add` / 切片 / 结构体字段派生的指针这里查不到 —— **不发**检查，
/// 比把块里的数据当块长读安全（§5.3 入口 B 的准备 ③）。
fn lms_alloc_size(s: ptr, src: ptr, toks: ptr, name: u32) -> u32 {
    let lo: u32 = load32(s, 564);
    let k: u32 = name;
    while k > lo {
        k = k - 1;
        if tok_kind(toks, k) == 0 && tok_eq(src, toks, k, name) && tok_is(src, toks, k + 1, "=") {
            return 0;
        }
        if tok_is(src, toks, k, "let") && k > 0 {
            if !tok_is(src, toks, k - 1, "if")
                    && tok_kind(toks, k + 1) == 0 && tok_eq(src, toks, k + 1, name)
                    && tok_is(src, toks, k + 2, ":") && tok_is(src, toks, k + 3, "ptr")
                    && tok_is(src, toks, k + 4, "=") && tok_is(src, toks, k + 5, "alloc")
                    && tok_is(src, toks, k + 6, "(") && tok_is(src, toks, k + 8, ")") {
                if tok_kind(toks, k + 7) == 1 {
                    return tok_int(src, toks, k + 7);
                }
                if tok_kind(toks, k + 7) == 0 {
                    let vt: u32 = find_const(s, src, toks, k + 7);
                    if vt != 0 && tok_kind(toks, vt) == 1 {
                        return tok_int(src, toks, vt);
                    }
                }
                return 0;
            }
        }
    }
    return 0;
}






/// **自动回收**（`choose gc_auto`）—— 文本与 `lomentc._IR_GC` **逐字节同源**
/// （下面的字面量是脚本从 `_IR_GC` 切的，不手抄）。
///
/// 它必须**排在 `emit_heap` 之后**：收集器引用 `@__loment_heap` / `@__loment_off` /
/// `@__loment_free` / `@__loment_freehead`，而那几个全局在堆那一段里。
/// 只在 `gc_auto` 档追加（槽 576），另外两档的产物因此逐字节不变。
///
/// **为什么要切成 6 段**：一整条（5.2 KB）的字符串字面量会让自举侧编出来的产物
/// **在运行期段错误**（0xC0000005，实测；堆那一条 4.6 KB 是好的）。
///
/// **Loment 的多行字面量不吞任何字符**：它的值就是引号之间的内容原样（量法：写一条
/// 收尾换行的字面量，看发出来的全局长度）。所以段与段之间**不带**换行，只有最后
/// 一段多带一个 —— 那是参考实现把各段 `join` 起来时 `_IR_GC` 之后那个分隔符，
/// 与 `emit_heap` 尾巴上那一个同一个道理。
/// **自动回收**（`choose gc_auto`）—— 文本与 `lomentc._IR_GC` **逐字节同源**
/// （下面的字面量是脚本从 `_IR_GC` 生成的，不手抄）。
///
/// 它必须**排在 `emit_heap` 之后**：收集器引用 `@__loment_heap` / `@__loment_off` /
/// `@__loment_free` / `@__loment_freehead`，而那几个全局在堆那一段里。
/// 只在 `gc_auto` 档追加（槽 576），另外两档的产物因此逐字节不变。
///
/// 尾部多一个换行：Loment 的多行字面量**不吞**任何字符（值就是引号之间原样），
/// 而这一个换行是参考实现把各段 `join` 起来时 `_IR_GC` 之后那个分隔符 ——
/// 与 `emit_heap` 尾巴上那一个同一个道理。
/// 本单元要不要**收集器与根表**（`docs/210` §2.1）：`gc_auto`（576）**或** `gc_auto_alpha`
/// （572）。此前只有 `gc_auto` —— alpha 的 L3 残差没人收（只有分配器）；这一步给 alpha
/// 也配上收集器（它的触发是自适应那支，见 `emit_gc_trigger`）。
fn gc_any(s: ptr) -> u32 {
    if load32(s, 576) == 1 {
        return 1;
    }
    if load32(s, 572) == 1 {
        return 1;
    }
    return 0;
}

/// **要不要根表 / 收集器钩子**（镜像参考实现的 `self.gc_hook`）：`gc_auto`、
/// `gc_auto_alpha`，**或**源里出现 `lgc`（`docs/309`）。后者让 `gc_manual` 也能开窗
/// 收集 —— 默认开关是关的，只有窗口里才收，`gc_manual` 的承诺因此不变。
fn gc_hook(s: ptr) -> u32 {
    if gc_any(s) == 1 {
        return 1;
    }
    return load32(s, CG_LGC);
}

/// **根表那两个全局** —— 与收集器**分开一段**（见参考实现 `lomentc._IR_ROOTS`）：`gc_any` 档
/// 只要函数里有指针槽就往根表写，而**根表的定义必须在** —— "有根没堆"的单元（alpha 把 `alloc`
/// 全 L0 提走、只剩指针局部那种）否则会发出**引用未定义全局**的产物。
fn emit_roots(s: ptr, out: ptr) -> u32 {
    return emit_str(s, out, "; ---- 自动回收（`choose gc_auto`）---------------------------------------------------
@__loment_roots = internal global [1024 x i64] zeroinitializer
@__loment_rootn = internal global i32 0
");
}

fn emit_gc(s: ptr, out: ptr) -> u32 {
    let _r: u32 = emit_str(s, out, "@__loment_gcbytes = internal global i32 0
@__loment_mark = internal global [1024 x i8] zeroinitializer

; **四个遍历一律从偏移 8 起** —— `@__loment_off` 的初值就是 8，偏移 0..7 不是块
; （分配器那句注释：偏移 0 永远不是块）。从 0 起会读到 size=0，`i += 0` 就是死循环
; —— 实测：那次 40000 圈的探针直接跑到超时，成因就在这一行。
define internal i32 @__loment_markp(i32 %p) {
entry:
  %o0 = load i32, ptr @__loment_off
  %lo = icmp ult i32 %p, 8
  %hi = icmp uge i32 %p, %o0
  %bad = or i1 %lo, %hi
  br i1 %bad, label %no, label %scan
scan:
  %i = phi i32 [ 8, %entry ], [ %ex, %cont ]
  %o1 = load i32, ptr @__loment_off
  %done = icmp uge i32 %i, %o1
  br i1 %done, label %no, label %blk
blk:
  %szp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %i
  %sz = load i32, ptr %szp
  %ex = add i32 %i, %sz
  %ge = icmp uge i32 %p, %i
  %lt = icmp ult i32 %p, %ex
  %hit = and i1 %ge, %lt
  br i1 %hit, label %found, label %cont
cont:
  br label %scan
found:
  %midx = lshr i32 %i, 3
  %mby = lshr i32 %midx, 3
  %mp = getelementptr [1024 x i8], ptr @__loment_mark, i32 0, i32 %mby
  %mcur = load i8, ptr %mp
  %mbit = and i32 %midx, 7
  %msh = shl i32 1, %mbit
  %mmsk = trunc i32 %msh to i8
  %mold = and i8 %mcur, %mmsk
  %was = icmp ne i8 %mold, 0
  %mnew = or i8 %mcur, %mmsk
  store i8 %mnew, ptr %mp
  br i1 %was, label %no, label %yes
yes:
  ret i32 1
no:
  ret i32 0
}

; **根那一趟单独成函数** —— 分代那一档的「小回收」要**同一趟**（§2.7），抽出来比复制一份好。
; 代价是 `gc_auto` 的产物里这一段从内联变成一次调用；两个实现同时变，逐字节判据照旧守着。
define internal void @__loment_markroots() {
entry:
  br label %rl
rl:
  %rk = phi i32 [ 0, %entry ], [ %rk2, %rlc ]
  %rn = load i32, ptr @__loment_rootn
  %rd = icmp uge i32 %rk, %rn
  br i1 %rd, label %done, label %rb
rb:
  %rs = getelementptr [1024 x i64], ptr @__loment_roots, i32 0, i32 %rk
  %rsv = load i64, ptr %rs
  %rsp = inttoptr i64 %rsv to ptr
  %rval = load i64, ptr %rsp
  %rbase = ptrtoint ptr @__loment_heap to i64
  %rdo = sub i64 %rval, %rbase
  %rin = icmp ult i64 %rdo, 65536
  br i1 %rin, label %rmk, label %rlc
rmk:
  %rd32 = trunc i64 %rdo to i32
  %rr = call i32 @__loment_markp(i32 %rd32)
  br label %rlc
rlc:
  %rk2 = add i32 %rk, 1
  br label %rl
done:
  ret void
}

; **传播**：从 `%from` 起扫块，把块里**长得像堆内地址**的字递归标记上，直到不动点。
; 起点参数化是给分代那一档用的（小回收只扫年轻代）—— 全量那一趟传 8。
;
; **块内精确**（`docs/210` §2.9）：借出块头上那个字**就是掩码本身** —— 精确站点写
; `-(mask + 2)`，保守（以及空闲块）留在 `-1`。于是这里算出来：`1` ⇒ **整块扫**
; （也就是这一层加进来之前的行为），`≥ 2` ⇒ 掩码 = 那个数减 2，**只扫置了位的那些字**
; （位 0 = 载荷第一个 8 字节）。掩码由编译器在**分配站点**上推出来，规则与 L0/L1/L2 同一条
; 纪律（非逃逸 + 直接定偏移写，见 §2.9）。
; **没有槽表**：早先的稿子把掩码放在一张 per-program 的表里、头上只存下标 —— 那是多余的，
; 掩码本来就是**每个站点一个常数**，头上那个字有 32 位，装得下（`_SLOT_WORDS` 因此是 30）。
; 少一张表就少一处两套实现要同时改的东西。
; **空闲块一律保守**：`next ≥ 0` 说明它挂在空闲链表上（或 0 = 链尾）。那种块本来不该被扫，
; 但既然有指针指进来了就照老样子扫一遍 —— **宁可多留，不可漏**。
define internal void @__loment_propagate(i32 %from) {
entry:
  br label %pl
pl:
  %ch = phi i32 [ 1, %entry ], [ %acc, %pw ]
  %zero = icmp eq i32 %ch, 0
  br i1 %zero, label %done, label %pw
pw:
  %wi = phi i32 [ %from, %pl ], [ %we, %wlc ]
  %acc = phi i32 [ 0, %pl ], [ %acc2, %wlc ]
  %wo = load i32, ptr @__loment_off
  %wd = icmp uge i32 %wi, %wo
  br i1 %wd, label %pl, label %wb
wb:
  %wp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %wi
  %wsz = load i32, ptr %wp
  %widx = lshr i32 %wi, 3
  %wby = lshr i32 %widx, 3
  %wmp = getelementptr [1024 x i8], ptr @__loment_mark, i32 0, i32 %wby
  %wmk = load i8, ptr %wmp
  %wbit = and i32 %widx, 7
  %wsh = shl i32 1, %wbit
  %wmsk = trunc i32 %wsh to i8
  %wold = and i8 %wmk, %wmsk
  %wsm = icmp ne i8 %wold, 0
  br i1 %wsm, label %ws, label %wn2
ws:
  %wsstart = add i32 %wi, 8
  %wsend = add i32 %wi, %wsz
  %w4 = add i32 %wi, 4
  %w4p = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %w4
  %wnx = load i32, ptr %w4p
  %wlv = icmp slt i32 %wnx, 0
  br i1 %wlv, label %wk, label %wall
wk:
  %wneg = sub i32 0, %wnx
  %wz0 = icmp ule i32 %wneg, 1
  br i1 %wz0, label %wall, label %wm
wm:
  %wsub = sub i32 %wneg, 2
  %wm64 = zext i32 %wsub to i64
  br label %wl0
wall:
  br label %wl0
wl0:
  %wmask = phi i64 [ -1, %wall ], [ %wm64, %wm ]
  br label %wl
wl:
  %wj = phi i32 [ %wsstart, %wl0 ], [ %wj2, %wlc2 ]
  %wacc = phi i32 [ %acc, %wl0 ], [ %wacc2, %wlc2 ]
  %wjd = icmp uge i32 %wj, %wsend
  br i1 %wjd, label %wn, label %wx
wx:
  %wdif = sub i32 %wj, %wsstart
  %wshr = lshr i32 %wdif, 3
  %wsh64 = zext i32 %wshr to i64
  %wone = shl i64 1, %wsh64
  %wbs = and i64 %wmask, %wone
  %wnzs = icmp ne i64 %wbs, 0
  br i1 %wnzs, label %wscan, label %wlc2
wscan:
  %wjp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %wj
  %wv = load i64, ptr %wjp
  %wb2 = ptrtoint ptr @__loment_heap to i64
  %wdo = sub i64 %wv, %wb2
  %win = icmp ult i64 %wdo, 65536
  br i1 %win, label %wmk2, label %wlc2
wmk2:
  %wd32 = trunc i64 %wdo to i32
  %wr = call i32 @__loment_markp(i32 %wd32)
  ; **累加器只增不减**（`#1444`）：`markp` 对**已标记**的块回 0，直接把它当这一趟的结果
  ; 会把同一趟里先前找到的新标记**抹掉** —— 于是「这一趟没有新东西」误报，不动点提前停，
  ; 更深的可达链被当成垃圾扫掉（use-after-free）。
  %wacc3 = or i32 %wacc, %wr
  br label %wlc2
wlc2:
  %wacc2 = phi i32 [ %wacc, %wx ], [ %wacc, %wscan ], [ %wacc3, %wmk2 ]
  %wj2 = add i32 %wj, 8
  br label %wl
wn:
  %wex = add i32 %wi, %wsz
  br label %wlc
wn2:
  %wey = add i32 %wi, %wsz
  br label %wlc
wlc:
  %we = phi i32 [ %wex, %wn ], [ %wey, %wn2 ]
  %acc2 = phi i32 [ %wacc, %wn ], [ %acc, %wn2 ]
  br label %pw
done:
  ret void
}

; **清扫**：从 `%from` 起把没标记的块**交回分配器**。**起点参数化**同 `propagate`
; （小回收只清扫年轻代）。
; **这里不重置空闲链表**（`@__loment_freehead`）—— 全量那一趟由**调用方**在进这里之前重置。
; 理由见 `__loment_collect` 里那段：重置是「防止同一块被挂两次」的手段，而**小回收不能重置**
; —— 老年代里那些**已经挂在链上的空闲块**不属于这次清扫的范围，重置一次就把它们从链上
; 丢了（不是不安全，是白漏内存）。
define internal void @__loment_sweep(i32 %from) {
entry:
  br label %sl
sl:
  %si = phi i32 [ %from, %entry ], [ %sex, %slc ]
  %so = load i32, ptr @__loment_off
  %sd = icmp uge i32 %si, %so
  br i1 %sd, label %done, label %sb
sb:
  %sszp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %si
  %ssz = load i32, ptr %sszp
  %sidx = lshr i32 %si, 3
  %sby = lshr i32 %sidx, 3
  %smp = getelementptr [1024 x i8], ptr @__loment_mark, i32 0, i32 %sby
  %smk = load i8, ptr %smp
  %sbit = and i32 %sidx, 7
  %ssh = shl i32 1, %sbit
  %smsk = trunc i32 %ssh to i8
  %sold = and i8 %smk, %smsk
  %smsm = icmp ne i8 %sold, 0
  br i1 %smsm, label %keep, label %kill
keep:
  br label %slc
kill:
  ; **这里的「清标记」什么都不做**（曾经写的是 `store i32 0, ptr %smp`）—— 那不是清一格，
  ; 是**越界清**：`%smp` 指向位图里的**一格字节**（`@__loment_mark` 每 8 字节堆一位），
  ; `store i32` 一次抹掉 **4 格 = 256 字节堆里的全部块**；就算写成 `store i8 0`，也照样
  ; 抹掉同一 64 字节里另外 7 个块的位。被顺带抹掉的块**可能是活的**，而**分代那一档的
  ; 旧块标记一旦被抹就再也标不回来**（`propagate` 只从 `oldtop` 起走，整个老年代不扫）
  ; —— 于是它们在同一趟清扫里被当垃圾交回分配器，程序随后读到的是复用后的字节。
  ; 而清零**本来就不需要**：走到这一格的**前提**就是「这一位是 0」（`%smsm` 为假）。
  ; 判据：`loment_elf_test::test_sweep_*` 两条同形语料（同源只差 `choose` 档位）。
  %k8 = add i32 %si, 8
  %kp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %k8
  call void @__loment_free(ptr %kp)
  br label %slc
slc:
  %sex = add i32 %si, %ssz
  br label %sl
done:
  ret void
}

; **全量回收的四趟**：清标记 → 扫根 → 传播到定点 → 清扫，一趟不少（`docs/210` §2.4）。
define internal void @__loment_collect() {
entry:
  br label %cl
cl:
  %ci = phi i32 [ 8, %entry ], [ %cex, %clc ]
  %co = load i32, ptr @__loment_off
  %cd = icmp uge i32 %ci, %co
  br i1 %cd, label %roots, label %clb
clb:
  %cidx = lshr i32 %ci, 3
  %cby = lshr i32 %cidx, 3
  %cmp = getelementptr [1024 x i8], ptr @__loment_mark, i32 0, i32 %cby
  store i8 0, ptr %cmp
  %csp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %ci
  %csz = load i32, ptr %csp
  %cex = add i32 %ci, %csz
  br label %clc
clc:
  br label %cl
roots:
  call void @__loment_markroots()
  call void @__loment_propagate(i32 8)
  ; **清扫前**不清空**空闲链表**（`#366`）—— 原先这里有一行 `store i32 0, ptr
  ; @__loment_freehead`，理由是「本来就在链上的块会被再 free 一次（双重插入，链就毁了）」。
  ; 那条理由站在 `#164` **之前**：当时 `free` 不验所有权，谁调都往里挂。
  ; `#164` 之后 `__loment_free` 只认**借出中**的块（`next == -1`），已在链上的块**惰性返回**
  ; —— 于是重置不再防住什么，却把**当前所有空闲块**从分配器手里**永久**丢掉：
  ; 清扫撞上它们时那道守卫拒绝重挂，而清扫**不会**把它们放回去。字节还在 arena 里、
  ; 还在前沿之下，`alloc` 再也摸不到。判据见 `loment_elf_test::test_a_collection_keeps_the_free_list`。
  call void @__loment_sweep(i32 8)
  ret void
}

");
    return emit_gc_trigger(s, out);
}

/// **`hosted` 那一份收集器本体**（`docs/230`，= `docs/228` §4 的 B1）——
/// 下面这段字面量与 `lomentc._IR_GC_SHARED_HOSTED` **逐字节同源**（脚本从它生成，不手抄）。
///
/// 与 `emit_gc` 只差**三件事**：基址走 `%hb`、标记表的行数换成 `arena/8`（那本来就是它的
/// 口径，`docs/228` §1 第四行）、两处根扫边界跟着换。**触发那一段共用** ——
/// `emit_gc_trigger` 的固定那一支按**字节数**触发（32768），不看 arena 大小。
/// `gc_auto_alpha` 不需要第二份 hosted：`hosted` 与它**定义上冲突**，走不到这儿。
fn emit_gc_hosted(s: ptr, out: ptr) -> u32 {
    let _r: u32 = emit_str(s, out, "@__loment_gcbytes = internal global i32 0
@__loment_mark = internal global [16384 x i8] zeroinitializer

; **四个遍历一律从偏移 8 起** —— `@__loment_off` 的初值就是 8，偏移 0..7 不是块
; （分配器那句注释：偏移 0 永远不是块）。从 0 起会读到 size=0，`i += 0` 就是死循环
; —— 实测：那次 40000 圈的探针直接跑到超时，成因就在这一行。
define internal i32 @__loment_markp(i32 %p) {
entry:
  %hb = call ptr @__loment_arena()
  %o0 = load i32, ptr @__loment_off
  %lo = icmp ult i32 %p, 8
  %hi = icmp uge i32 %p, %o0
  %bad = or i1 %lo, %hi
  br i1 %bad, label %no, label %scan
scan:
  %i = phi i32 [ 8, %entry ], [ %ex, %cont ]
  %o1 = load i32, ptr @__loment_off
  %done = icmp uge i32 %i, %o1
  br i1 %done, label %no, label %blk
blk:
  %szp = getelementptr i8, ptr %hb, i32 %i
  %sz = load i32, ptr %szp
  %ex = add i32 %i, %sz
  %ge = icmp uge i32 %p, %i
  %lt = icmp ult i32 %p, %ex
  %hit = and i1 %ge, %lt
  br i1 %hit, label %found, label %cont
cont:
  br label %scan
found:
  %midx = lshr i32 %i, 3
  %mby = lshr i32 %midx, 3
  %mp = getelementptr [16384 x i8], ptr @__loment_mark, i32 0, i32 %mby
  %mcur = load i8, ptr %mp
  %mbit = and i32 %midx, 7
  %msh = shl i32 1, %mbit
  %mmsk = trunc i32 %msh to i8
  %mold = and i8 %mcur, %mmsk
  %was = icmp ne i8 %mold, 0
  %mnew = or i8 %mcur, %mmsk
  store i8 %mnew, ptr %mp
  br i1 %was, label %no, label %yes
yes:
  ret i32 1
no:
  ret i32 0
}

; **根那一趟单独成函数** —— 分代那一档的「小回收」要**同一趟**（§2.7），抽出来比复制一份好。
; 代价是 `gc_auto` 的产物里这一段从内联变成一次调用；两个实现同时变，逐字节判据照旧守着。
define internal void @__loment_markroots() {
entry:
  %hb = call ptr @__loment_arena()
  br label %rl
rl:
  %rk = phi i32 [ 0, %entry ], [ %rk2, %rlc ]
  %rn = load i32, ptr @__loment_rootn
  %rd = icmp uge i32 %rk, %rn
  br i1 %rd, label %done, label %rb
rb:
  %rs = getelementptr [1024 x i64], ptr @__loment_roots, i32 0, i32 %rk
  %rsv = load i64, ptr %rs
  %rsp = inttoptr i64 %rsv to ptr
  %rval = load i64, ptr %rsp
  %rbase = ptrtoint ptr %hb to i64
  %rdo = sub i64 %rval, %rbase
  %rin = icmp ult i64 %rdo, 1048576
  br i1 %rin, label %rmk, label %rlc
rmk:
  %rd32 = trunc i64 %rdo to i32
  %rr = call i32 @__loment_markp(i32 %rd32)
  br label %rlc
rlc:
  %rk2 = add i32 %rk, 1
  br label %rl
done:
  ret void
}

; **传播**：从 `%from` 起扫块，把块里**长得像堆内地址**的字递归标记上，直到不动点。
; 起点参数化是给分代那一档用的（小回收只扫年轻代）—— 全量那一趟传 8。
;
; **块内精确**（`docs/210` §2.9）：借出块头上那个字**就是掩码本身** —— 精确站点写
; `-(mask + 2)`，保守（以及空闲块）留在 `-1`。于是这里算出来：`1` ⇒ **整块扫**
; （也就是这一层加进来之前的行为），`≥ 2` ⇒ 掩码 = 那个数减 2，**只扫置了位的那些字**
; （位 0 = 载荷第一个 8 字节）。掩码由编译器在**分配站点**上推出来，规则与 L0/L1/L2 同一条
; 纪律（非逃逸 + 直接定偏移写，见 §2.9）。
; **没有槽表**：早先的稿子把掩码放在一张 per-program 的表里、头上只存下标 —— 那是多余的，
; 掩码本来就是**每个站点一个常数**，头上那个字有 32 位，装得下（`_SLOT_WORDS` 因此是 30）。
; 少一张表就少一处两套实现要同时改的东西。
; **空闲块一律保守**：`next ≥ 0` 说明它挂在空闲链表上（或 0 = 链尾）。那种块本来不该被扫，
; 但既然有指针指进来了就照老样子扫一遍 —— **宁可多留，不可漏**。
define internal void @__loment_propagate(i32 %from) {
entry:
  %hb = call ptr @__loment_arena()
  br label %pl
pl:
  %ch = phi i32 [ 1, %entry ], [ %acc, %pw ]
  %zero = icmp eq i32 %ch, 0
  br i1 %zero, label %done, label %pw
pw:
  %wi = phi i32 [ %from, %pl ], [ %we, %wlc ]
  %acc = phi i32 [ 0, %pl ], [ %acc2, %wlc ]
  %wo = load i32, ptr @__loment_off
  %wd = icmp uge i32 %wi, %wo
  br i1 %wd, label %pl, label %wb
wb:
  %wp = getelementptr i8, ptr %hb, i32 %wi
  %wsz = load i32, ptr %wp
  %widx = lshr i32 %wi, 3
  %wby = lshr i32 %widx, 3
  %wmp = getelementptr [16384 x i8], ptr @__loment_mark, i32 0, i32 %wby
  %wmk = load i8, ptr %wmp
  %wbit = and i32 %widx, 7
  %wsh = shl i32 1, %wbit
  %wmsk = trunc i32 %wsh to i8
  %wold = and i8 %wmk, %wmsk
  %wsm = icmp ne i8 %wold, 0
  br i1 %wsm, label %ws, label %wn2
ws:
  %wsstart = add i32 %wi, 8
  %wsend = add i32 %wi, %wsz
  %w4 = add i32 %wi, 4
  %w4p = getelementptr i8, ptr %hb, i32 %w4
  %wnx = load i32, ptr %w4p
  %wlv = icmp slt i32 %wnx, 0
  br i1 %wlv, label %wk, label %wall
wk:
  %wneg = sub i32 0, %wnx
  %wz0 = icmp ule i32 %wneg, 1
  br i1 %wz0, label %wall, label %wm
wm:
  %wsub = sub i32 %wneg, 2
  %wm64 = zext i32 %wsub to i64
  br label %wl0
wall:
  br label %wl0
wl0:
  %wmask = phi i64 [ -1, %wall ], [ %wm64, %wm ]
  br label %wl
wl:
  %wj = phi i32 [ %wsstart, %wl0 ], [ %wj2, %wlc2 ]
  %wacc = phi i32 [ %acc, %wl0 ], [ %wacc2, %wlc2 ]
  %wjd = icmp uge i32 %wj, %wsend
  br i1 %wjd, label %wn, label %wx
wx:
  %wdif = sub i32 %wj, %wsstart
  %wshr = lshr i32 %wdif, 3
  %wsh64 = zext i32 %wshr to i64
  %wone = shl i64 1, %wsh64
  %wbs = and i64 %wmask, %wone
  %wnzs = icmp ne i64 %wbs, 0
  br i1 %wnzs, label %wscan, label %wlc2
wscan:
  %wjp = getelementptr i8, ptr %hb, i32 %wj
  %wv = load i64, ptr %wjp
  %wb2 = ptrtoint ptr %hb to i64
  %wdo = sub i64 %wv, %wb2
  %win = icmp ult i64 %wdo, 1048576
  br i1 %win, label %wmk2, label %wlc2
wmk2:
  %wd32 = trunc i64 %wdo to i32
  %wr = call i32 @__loment_markp(i32 %wd32)
  ; **累加器只增不减**（`#1444`）：`markp` 对**已标记**的块回 0，直接把它当这一趟的结果
  ; 会把同一趟里先前找到的新标记**抹掉** —— 于是「这一趟没有新东西」误报，不动点提前停，
  ; 更深的可达链被当成垃圾扫掉（use-after-free）。
  %wacc3 = or i32 %wacc, %wr
  br label %wlc2
wlc2:
  %wacc2 = phi i32 [ %wacc, %wx ], [ %wacc, %wscan ], [ %wacc3, %wmk2 ]
  %wj2 = add i32 %wj, 8
  br label %wl
wn:
  %wex = add i32 %wi, %wsz
  br label %wlc
wn2:
  %wey = add i32 %wi, %wsz
  br label %wlc
wlc:
  %we = phi i32 [ %wex, %wn ], [ %wey, %wn2 ]
  %acc2 = phi i32 [ %wacc, %wn ], [ %acc, %wn2 ]
  br label %pw
done:
  ret void
}

; **清扫**：从 `%from` 起把没标记的块**交回分配器**。**起点参数化**同 `propagate`
; （小回收只清扫年轻代）。
; **这里不重置空闲链表**（`@__loment_freehead`）—— 全量那一趟由**调用方**在进这里之前重置。
; 理由见 `__loment_collect` 里那段：重置是「防止同一块被挂两次」的手段，而**小回收不能重置**
; —— 老年代里那些**已经挂在链上的空闲块**不属于这次清扫的范围，重置一次就把它们从链上
; 丢了（不是不安全，是白漏内存）。
define internal void @__loment_sweep(i32 %from) {
entry:
  %hb = call ptr @__loment_arena()
  br label %sl
sl:
  %si = phi i32 [ %from, %entry ], [ %sex, %slc ]
  %so = load i32, ptr @__loment_off
  %sd = icmp uge i32 %si, %so
  br i1 %sd, label %done, label %sb
sb:
  %sszp = getelementptr i8, ptr %hb, i32 %si
  %ssz = load i32, ptr %sszp
  %sidx = lshr i32 %si, 3
  %sby = lshr i32 %sidx, 3
  %smp = getelementptr [16384 x i8], ptr @__loment_mark, i32 0, i32 %sby
  %smk = load i8, ptr %smp
  %sbit = and i32 %sidx, 7
  %ssh = shl i32 1, %sbit
  %smsk = trunc i32 %ssh to i8
  %sold = and i8 %smk, %smsk
  %smsm = icmp ne i8 %sold, 0
  br i1 %smsm, label %keep, label %kill
keep:
  br label %slc
kill:
  ; **这里的「清标记」什么都不做**（曾经写的是 `store i32 0, ptr %smp`）—— 那不是清一格，
  ; 是**越界清**：`%smp` 指向位图里的**一格字节**（`@__loment_mark` 每 8 字节堆一位），
  ; `store i32` 一次抹掉 **4 格 = 256 字节堆里的全部块**；就算写成 `store i8 0`，也照样
  ; 抹掉同一 64 字节里另外 7 个块的位。被顺带抹掉的块**可能是活的**，而**分代那一档的
  ; 旧块标记一旦被抹就再也标不回来**（`propagate` 只从 `oldtop` 起走，整个老年代不扫）
  ; —— 于是它们在同一趟清扫里被当垃圾交回分配器，程序随后读到的是复用后的字节。
  ; 而清零**本来就不需要**：走到这一格的**前提**就是「这一位是 0」（`%smsm` 为假）。
  ; 判据：`loment_elf_test::test_sweep_*` 两条同形语料（同源只差 `choose` 档位）。
  %k8 = add i32 %si, 8
  %kp = getelementptr i8, ptr %hb, i32 %k8
  call void @__loment_free(ptr %kp)
  br label %slc
slc:
  %sex = add i32 %si, %ssz
  br label %sl
done:
  ret void
}

; **全量回收的四趟**：清标记 → 扫根 → 传播到定点 → 清扫，一趟不少（`docs/210` §2.4）。
define internal void @__loment_collect() {
entry:
  %hb = call ptr @__loment_arena()
  br label %cl
cl:
  %ci = phi i32 [ 8, %entry ], [ %cex, %clc ]
  %co = load i32, ptr @__loment_off
  %cd = icmp uge i32 %ci, %co
  br i1 %cd, label %roots, label %clb
clb:
  %cidx = lshr i32 %ci, 3
  %cby = lshr i32 %cidx, 3
  %cmp = getelementptr [16384 x i8], ptr @__loment_mark, i32 0, i32 %cby
  store i8 0, ptr %cmp
  %csp = getelementptr i8, ptr %hb, i32 %ci
  %csz = load i32, ptr %csp
  %cex = add i32 %ci, %csz
  br label %clc
clc:
  br label %cl
roots:
  call void @__loment_markroots()
  call void @__loment_propagate(i32 8)
  ; **清扫前**不清空**空闲链表**（`#366`）—— 原先这里有一行 `store i32 0, ptr
  ; @__loment_freehead`，理由是「本来就在链上的块会被再 free 一次（双重插入，链就毁了）」。
  ; 那条理由站在 `#164` **之前**：当时 `free` 不验所有权，谁调都往里挂。
  ; `#164` 之后 `__loment_free` 只认**借出中**的块（`next == -1`），已在链上的块**惰性返回**
  ; —— 于是重置不再防住什么，却把**当前所有空闲块**从分配器手里**永久**丢掉：
  ; 清扫撞上它们时那道守卫拒绝重挂，而清扫**不会**把它们放回去。字节还在 arena 里、
  ; 还在前沿之下，`alloc` 再也摸不到。判据见 `loment_elf_test::test_a_collection_keeps_the_free_list`。
  call void @__loment_sweep(i32 8)
  ret void
}

");
    return emit_gc_trigger(s, out);
}


/// **GC 时间控制那一段**（`docs/309`，Tur 2026.3 的 `lgc`）。**只在源里出现 `lgc` 时发**
/// —— 没写的程序产物一个字节都不变。
///
/// 文本与参考实现的 `_IR_GC_CTL_GLOBALS` + `_IR_LGC_NOW` **逐字节同源**：
///   * `@__loment_gc_on` —— 收集器总开关。`gc_manual` 初值 **0**（手动档的承诺不变：
///     只有显式开窗才收集），`gc_auto` / `gc_auto_alpha` 初值 **1**（`lgc end` 才是暂停）；
///   * `@__loment_gc_deadline` —— 窗口的协作式预算（单调时钟纳秒，0 = 不限时）；
///   * `__loment_now_ns` —— Linux x86-64 的 `clock_gettime(CLOCK_MONOTONIC)`；
///   * `__loment_gc_allow` / `__loment_collect_now` / `__loment_maybe_collect_ctl`。
///
/// 开头那个换行、段与段之间的空行都不是排版：参考实现是把各段 `"\n".join(...)` 拼出来的，
/// 每个元素自带首尾换行 —— 自举这边逐字节写，得自己补齐（同 `emit_heap` 尾巴那条）。
fn emit_lgc_runtime(s: ptr, out: ptr) -> u32 {
    let d: u32 = 0;
    d = d + emit_str(s, out, "
@__loment_gc_on = internal global i32 ");
    if gc_any(s) == 1 {
        d = d + emit_str(s, out, "1");
    } else {
        d = d + emit_str(s, out, "0");
    }
    d = d + emit_str(s, out, "
@__loment_gc_deadline = internal global i64 0


define internal i64 @__loment_now_ns() {
entry:
  %ts = alloca [2 x i64]
  %tp = ptrtoint ptr %ts to i64
  %r = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 228, i64 1, i64 %tp, i64 0)
  %bad = icmp slt i64 %r, 0
  br i1 %bad, label %fail, label %ok
fail:
  ret i64 0
ok:
  %sp = getelementptr [2 x i64], ptr %ts, i32 0, i32 0
  %s = load i64, ptr %sp
  %np = getelementptr [2 x i64], ptr %ts, i32 0, i32 1
  %n = load i64, ptr %np
  %m = mul i64 %s, 1000000000
  %v = add i64 %m, %n
  ret i64 %v
}

define internal i1 @__loment_gc_allow() {
entry:
  %on = load i32, ptr @__loment_gc_on
  %off = icmp eq i32 %on, 0
  br i1 %off, label %no, label %chk
chk:
  %dl = load i64, ptr @__loment_gc_deadline
  %timed = icmp ne i64 %dl, 0
  br i1 %timed, label %time, label %yes
time:
  %now = call i64 @__loment_now_ns()
  %late = icmp uge i64 %now, %dl
  br i1 %late, label %no, label %yes
no:
  ret i1 false
yes:
  ret i1 true
}

define internal void @__loment_collect_now() {
entry:
  %ok = call i1 @__loment_gc_allow()
  br i1 %ok, label %go, label %out
go:
  call void @__loment_collect()
  br label %out
out:
  ret void
}

define internal void @__loment_maybe_collect_ctl(i32 %sz) {
entry:
  %ok = call i1 @__loment_gc_allow()
  br i1 %ok, label %go, label %out
go:
  call void @__loment_maybe_collect(i32 %sz)
  br label %out
out:
  ret void
}

");
    return d;
}

/// 收集器的**触发**那一段，按档选一支（`docs/210` §2.4）：
///   * `gc_auto`（576）—— **固定**：累计请求量过 32 KiB 收一次；
///   * `gc_auto_alpha`（572）—— **自适应**：阈值跟着活集走（`活集 × 2`，下限 32 KiB）+
///     **空间触发**（前沿 + 本次 + 头 > 65536 − 余量）。正对着 `gc_auto` 那条"活集 ≳ 32 KB
///     必耗尽"的上限 —— 空间触发把它抬到"活集接近整个 arena"。
/// 两段文本与参考实现的 `_IR_GC_TRIGGER_FIXED` / `_IR_GC_TRIGGER_ADAPT` **逐字节同**。
/// **不用 `select`**（下限那一格走分支）—— 自举镜像链接器没有 `select`。
fn emit_gc_trigger(s: ptr, out: ptr) -> u32 {
    if load32(s, 572) == 1 {
        return emit_str(s, out, "@__loment_thresh = internal global i32 32768
@__loment_oldtop = internal global i32 8
@__loment_cards = internal global [1024 x i32] zeroinitializer

; **写屏障**：地址落在老年代 ⇒ 它所在的卡置脏。落在堆外（栈、只读段）或年轻代 ⇒ 什么都不做。
; 堆外那一条靠 `ptrtoint` 相减：栈地址与堆基址的差是一个**巨大的无符号数**，`ult 65536` 自然为假。
define internal void @__loment_wb(ptr %g) {
entry:
  %a64 = ptrtoint ptr %g to i64
  %b64 = ptrtoint ptr @__loment_heap to i64
  %d = sub i64 %a64, %b64
  %in = icmp ult i64 %d, 65536
  br i1 %in, label %heap, label %out
heap:
  %a = trunc i64 %d to i32
  %ge8 = icmp uge i32 %a, 8
  %ot = load i32, ptr @__loment_oldtop
  %lt = icmp ult i32 %a, %ot
  %yes = and i1 %ge8, %lt
  br i1 %yes, label %mark, label %out
mark:
  %ci = lshr i32 %a, 6
  %cp = getelementptr [1024 x i32], ptr @__loment_cards, i32 0, i32 %ci
  store i32 1, ptr %cp
  br label %out
out:
  ret void
}

; **小回收**：只动年轻代（地址 ≥ `@__loment_oldtop`）。五步 ——
;   ① 清**年轻代**的标记位（老年代的标记位不动：它们不参与这次清扫）；
;   ② 扫根（与全量同一趟）；
;   ③ 扫**脏卡**：老年代里被写过的那 64 B 块，逐个 8 字节窗口找落在堆里的值，标记其所在块；
;   ④ **只传播年轻代**（起点 `oldtop`）—— 年轻代内部互相指的那些；老→年轻由③兜住；
;   ⑤ **只清扫年轻代**（起点 `oldtop`），**不重置空闲链表**（理由见 `__loment_sweep`）。
define internal void @__loment_minor() {
entry:
  %ot = load i32, ptr @__loment_oldtop
  br label %cl
cl:
  %ci = phi i32 [ %ot, %entry ], [ %cex, %clc ]
  %co = load i32, ptr @__loment_off
  %cd = icmp uge i32 %ci, %co
  br i1 %cd, label %roots, label %clb
clb:
  ; **只清这一格自己的那一位** —— 这里曾经写 `store i8 0`（清**一整格字节**），而
  ; `@__loment_mark` 是**每 8 字节堆一位**的位图：一格字节覆盖**连续的 64 字节堆**，
  ; 里面很可能挤着 2~3 个块。本趟从 `%ot`（`oldtop`）起走，而 `oldtop` **不保证 64 字节
  ; 对齐** —— 于是第一趟就把 `oldtop` **下面**那几个**旧块**的位一起抹掉；而 `propagate`
  ; 只从 `oldtop` 起走、旧块整段不扫，抹掉就**再也标不回来** ⇒ 它们在同一趟清扫里被当
  ; 垃圾交回分配器，程序随后读到的是复用后的字节。
  ; **这一半没有最小复现**：它是读代码读出来的，改动方向是**单向**的（新写法清的是旧写法
  ; 所清位的一个子集），只会**少收**、不会多收。
  %cidx = lshr i32 %ci, 3
  %cby = lshr i32 %cidx, 3
  %cmp = getelementptr [1024 x i8], ptr @__loment_mark, i32 0, i32 %cby
  %cmk = load i8, ptr %cmp
  %cbit = and i32 %cidx, 7
  %csh = shl i32 1, %cbit
  %cmsk = trunc i32 %csh to i8
  %cclr = xor i8 %cmsk, -1
  %cnew = and i8 %cmk, %cclr
  store i8 %cnew, ptr %cmp
  %csp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %ci
  %csz = load i32, ptr %csp
  %cex = add i32 %ci, %csz
  br label %clc
clc:
  br label %cl
roots:
  call void @__loment_markroots()
  br label %cr
cr:
  %ri = phi i32 [ 0, %roots ], [ %ri2, %rc ]
  %rcd = icmp uge i32 %ri, 1024
  br i1 %rcd, label %prop, label %rcb
rcb:
  %rcp = getelementptr [1024 x i32], ptr @__loment_cards, i32 0, i32 %ri
  %rcv = load i32, ptr %rcp
  %rset = icmp eq i32 %rcv, 1
  br i1 %rset, label %cscan, label %rc
cscan:
  %rbase = ptrtoint ptr @__loment_heap to i64
  %cstart = shl i32 %ri, 6
  %cend = add i32 %cstart, 64
  br label %cs
cs:
  %sj = phi i32 [ %cstart, %cscan ], [ %sj2, %csc ]
  %sjd = icmp uge i32 %sj, %cend
  br i1 %sjd, label %cdone, label %csb
csb:
  %sp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %sj
  %sv = load i64, ptr %sp
  %sdo = sub i64 %sv, %rbase
  %sin = icmp ult i64 %sdo, 65536
  br i1 %sin, label %smk, label %csc
smk:
  %sd32 = trunc i64 %sdo to i32
  %sr = call i32 @__loment_markp(i32 %sd32)
  br label %csc
csc:
  %sj2 = add i32 %sj, 8
  br label %cs
cdone:
  store i32 0, ptr %rcp
  br label %rc
rc:
  %ri2 = add i32 %ri, 1
  br label %cr
prop:
  call void @__loment_propagate(i32 %ot)
  ; **清扫整堆，但不清空空闲链表**（`#366`，与 `__loment_collect` 同一条）。
  ; 原先这里也有那一行，理由两条（① 双重插入、② 既然重置就得能重复跑）；**两条都站在
  ; `#164` 之前**：今天 `__loment_free` 只认借出中的块，已在链上的一律**惰性返回**，
  ; 所以「同一块被挂两次」不会发生，而重置只会把那些**已经挂在链上**的空闲块
  ; （`docs/210` §2.7 自己点名的「不是不安全，是白漏内存」）永久丢掉。不做。
  call void @__loment_sweep(i32 8)
  ; **晋升**（不搬移的那一种）：这次小回收的**幸存者从此算老的** —— 把切成处推到前沿。
  ; 少了这一条，「年轻代」就永远是整个堆（`oldtop` 只有全量才动，而全量在小回收够用的
  ; 时候根本不会跑）—— 那样小回收 ≡ 全量、卡表永不生效。**实测**：少了这一条，
  ; `loment_elf_test` 那条分代判据在「拆掉卡扫描」之后照样通过（判据失去证伪力）。
  ; `off` 可能已经**退回**到 `oldtop` 之下（前沿回退），那就不动它（`max`，走分支不用 `select`）。
  %o2 = load i32, ptr @__loment_off
  %up = icmp ugt i32 %o2, %ot
  br i1 %up, label %prom, label %out
prom:
  store i32 %o2, ptr @__loment_oldtop
  br label %out
out:
  ret void
}

; **全量**：`__loment_collect` 那一套，外加「这一刀切在这儿」——把 `oldtop` 推到前沿、
; 把卡表清空（老年代整个换了一遍，旧卡不再代表任何东西）。
define internal void @__loment_major() {
entry:
  call void @__loment_collect()
  %o = load i32, ptr @__loment_off
  store i32 %o, ptr @__loment_oldtop
  br label %cc
cc:
  %i = phi i32 [ 0, %entry ], [ %i2, %ccc ]
  %cd = icmp uge i32 %i, 1024
  br i1 %cd, label %out, label %ccb
ccb:
  %cp = getelementptr [1024 x i32], ptr @__loment_cards, i32 0, i32 %i
  store i32 0, ptr %cp
  br label %ccc
ccc:
  %i2 = add i32 %i, 1
  br label %cc
out:
  ret void
}

; **策略选择**：该收的时候**先小回收**；小回收之后前沿**还是顶在装满那一档**就跟一次
; **全量**兜底 —— 于是「要么收够、要么确实装不下」，不留「收了但没用」那条路。
; **不做「年轻代太大就直接全量」那种优化**：前沿能不能退回去才是「这次小回收有没有用」的
; 判据（退回去了就说明死块都在顶端，正是小回收该干的事），而年轻代的**大小**不是。
define internal void @__loment_maybe_collect(i32 %sz) {
entry:
  ; **有线程活着就不收** —— 与固定档同一条（`FujoJTOP/loment#778`，见那边整段理由）。
  %lv = load i32, ptr @__loment_rt_threads
  %defer = icmp ne i32 %lv, 0
  br i1 %defer, label %out, label %count
count:
  ; **时钟 = 分配器真正吃掉多少字节**（`(sz + 23) & -16`），不是载荷请求 —— 与固定档同一条
  ; 理由（见 `_IR_GC_TRIGGER_FIXED`）。空间触发那一格原先写成 `off + sz + 8`：**多算了那
  ; 个 8**（块头早被 `& -16` 那条并进去了），于是它报的「下一块落在哪儿」比实际偏后。
  %r0 = add i32 %sz, 23
  %need = and i32 %r0, -16
  %b = load i32, ptr @__loment_gcbytes
  %b2 = add i32 %b, %need
  store i32 %b2, ptr @__loment_gcbytes
  %t = load i32, ptr @__loment_thresh
  %big = icmp ugt i32 %b2, %t
  %off = load i32, ptr @__loment_off
  %n1 = add i32 %off, %need
  %near = icmp ugt i32 %n1, 64512
  %go = or i1 %big, %near
  br i1 %go, label %do, label %out
do:
  store i32 0, ptr @__loment_gcbytes
  call void @__loment_minor()
  %of2 = load i32, ptr @__loment_off
  %m1 = add i32 %of2, %need
  %still = icmp ugt i32 %m1, 64512
  br i1 %still, label %maj, label %tune
maj:
  call void @__loment_major()
  br label %tune
tune:
  %live = call i32 @__loment_livebytes()
  %dbl = mul i32 %live, 2
  %lo = icmp ult i32 %dbl, 32768
  br i1 %lo, label %floor, label %set
floor:
  store i32 32768, ptr @__loment_thresh
  br label %out
set:
  store i32 %dbl, ptr @__loment_thresh
  br label %out
out:
  ret void
}

define internal i32 @__loment_livebytes() {
entry:
  br label %l
l:
  %li = phi i32 [ 8, %entry ], [ %lex, %lc ]
  %acc = phi i32 [ 0, %entry ], [ %acc2, %lc ]
  %lof = load i32, ptr @__loment_off
  %ld = icmp uge i32 %li, %lof
  br i1 %ld, label %done, label %b
b:
  %idx = lshr i32 %li, 3
  %bby = lshr i32 %idx, 3
  %mp = getelementptr [1024 x i8], ptr @__loment_mark, i32 0, i32 %bby
  %mk = load i8, ptr %mp
  %bbit = and i32 %idx, 7
  %bsh = shl i32 1, %bbit
  %bmsk = trunc i32 %bsh to i8
  %band = and i8 %mk, %bmsk
  %sm = icmp ne i8 %band, 0
  %sp = getelementptr [65536 x i8], ptr @__loment_heap, i32 0, i32 %li
  %sz = load i32, ptr %sp
  br i1 %sm, label %hit, label %miss
hit:
  %acc1 = add i32 %acc, %sz
  br label %lc
miss:
  br label %lc
lc:
  %acc2 = phi i32 [ %acc1, %hit ], [ %acc, %miss ]
  %lex = add i32 %li, %sz
  br label %l
done:
  ret i32 %acc
}

");
    }
    return emit_str(s, out, "define internal void @__loment_maybe_collect(i32 %sz) {
entry:
  ; **有线程活着就不收**（`FujoJTOP/loment#778`）：收集器今天没有 stop-the-world
  ; 协议 —— 它会去扫别的线程的根槽，而那要求全世界的 mutator 都停在安全点上。
  ; 本版把这一条**换成推迟**：`@__loment_rt_threads` 是「这台进程起过线程」的标志
  ; （`thread_spawn` 的调用点在 `clone` 之前把它置 1），非零时直接返回。于是收集只在
  ; 起过线程之前发生 —— 不需要停任何人，也就不会与任何人交错。
  %lv = load i32, ptr @__loment_rt_threads
  %defer = icmp ne i32 %lv, 0
  br i1 %defer, label %out, label %count
count:
  ; **时钟 = 分配器真正吃掉多少字节**（`__loment_alloc` 自己那两行 `(sz + 23) & -16`），
  ; 不是「载荷请求多少」—— 少了块头那 8 字节，小块程序的时钟就比消耗慢：8 字节载荷的
  ; 块消耗 32、时钟只走 8，慢一倍 ⇒ 计数越过阈值的那一刻，arena 已经装满了（实测：
  ; 纯拼接 3000 轮、计数 24000 < 32768，**一次都没收**，到 4096 轮 arena 满而 abort）。
  ; （16 而不是 8：载荷要 16 对齐，见 `#620` —— 这块时钟必须跟着分配器的步长走。）
  %r0 = add i32 %sz, 23
  %need = and i32 %r0, -16
  %b = load i32, ptr @__loment_gcbytes
  %b2 = add i32 %b, %need
  store i32 %b2, ptr @__loment_gcbytes
  %big = icmp ugt i32 %b2, 32768
  br i1 %big, label %go, label %out
go:
  store i32 0, ptr @__loment_gcbytes
  call void @__loment_collect()
  br label %out
out:
  ret void
}

");
}


/// `gc_auto` / `gc_auto_alpha`：本帧有几个"持有指针的槽" —— 形参在前、局部按声明序。
///
/// **与 `lomentc._Ir.roots_push` 同序**（那是逐字节判据的一部分）。参考侧的 `_root_ty` 认
/// **`ptr` / `str`（`{ptr,i64}`）/ 切片**；这边按**类型 token** 认同样四样 —— `ptr`/`str`/
/// `[`（切片）/ `mut`（`mut [T]`）。**此前只认 `ptr`**（旧注释说"孪生编不了 str/切片"，
/// 与事实不符：`str` 那一格它编得了），于是"有 str 局部"的帧两边数出的根数**不一样**
/// —— 此前只有 `gc_auto` 会 push、而那种源不在语料里，所以没暴露。
fn root_count(s: ptr, src: ptr, toks: ptr, k: u32, nl: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = 0;
    while i < k {
        if root_ty_tok(src, toks, load32(s, CG_CUR + i * 8 + 4)) == 1 {
            n = n + 1;
        }
        i = i + 1;
    }
    let j: u32 = 0;
    while j < nl {
        if root_ty_tok(src, toks, load32(s, CG_LOCAL + j * 8 + 4)) == 1 {
            n = n + root_slots(s, src, toks, load32(s, CG_LOCAL + j * 8));
        }
        j = j + 1;
    }
    return n + load32(s, CG_L05_CAP) / 8;
}

/// 一个**类型 token** 是不是"槽里有指针"那种（`lomentc._Ir._root_ty` 的 token 版）。
fn root_ty_tok(src: ptr, toks: ptr, ty: u32) -> u32 {
    if tok_is(src, toks, ty, "ptr") || tok_is(src, toks, ty, "str")
            || tok_is(src, toks, ty, "[") || tok_is(src, toks, ty, "mut") {
        return 1;
    }
    return 0;
}

/// 登记一格：`add` / `getelementptr` / `ptrtoint` 三条 temp（**先后与参考侧一致**），
/// 外加那条 `store`。`param == 1` 时名字走形参的发射器（两者对同一个名字未必等价）。
fn emit_root_slot(s: ptr, out: ptr, src: ptr, toks: ptr, n0: u32, c: u32,
                  nm: u32, param: u32) -> u32 {
    let idx: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, idx);
    emit_str(s, out, " = add i32 ");
    emit_temp_ref(s, out, n0);
    emit_str(s, out, ", ");
    emit_dec(s, out, c);
    emit_str(s, out, "\n");
    let gp: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, gp);
    emit_str(s, out, " = getelementptr [1024 x i64], ptr @__loment_roots, i32 0, i32 ");
    emit_temp_ref(s, out, idx);
    emit_str(s, out, "\n");
    let v: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, v);
    emit_str(s, out, " = ptrtoint ptr %");
    if param == 1 {
        emit_name_tok(s, out, src, toks, nm);
    } else {
        emit_local_name(s, out, src, toks, nm);
    }
    emit_str(s, out, ".addr to i64\n  store i64 ");
    emit_temp_ref(s, out, v);
    emit_str(s, out, ", ptr ");
    emit_temp_ref(s, out, gp);
    return emit_str(s, out, "\n");
}

/// 登记分配站点的 spill 槽 `%gc.sp.<j>`（`#1465`）：四条 temp 的次序与
/// `emit_root_slot` 一致（`idx` / `gp` / `v` + `store`），名字不带 `.addr`。
fn emit_root_gcsp(s: ptr, out: ptr, n0: u32, c: u32, j: u32) -> u32 {
    let idx: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, idx);
    emit_str(s, out, " = add i32 ");
    emit_temp_ref(s, out, n0);
    emit_str(s, out, ", ");
    emit_dec(s, out, c);
    emit_str(s, out, "\n");
    let gp: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, gp);
    emit_str(s, out, " = getelementptr [1024 x i64], ptr @__loment_roots, i32 0, i32 ");
    emit_temp_ref(s, out, idx);
    emit_str(s, out, "\n");
    let v: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, v);
    emit_str(s, out, " = ptrtoint ptr %gc.sp.");
    emit_dec(s, out, j);
    emit_str(s, out, " to i64\n  store i64 ");
    emit_temp_ref(s, out, v);
    emit_str(s, out, ", ptr ");
    emit_temp_ref(s, out, gp);
    return emit_str(s, out, "\n");
}

/// 这个名字是不是"L0 提升过"的：是就回它的**字节数**，不是回 0。
///
/// **两道闸与 `emit_l0_buf` 同一份**：非 alpha 档（槽 572 为 0）L0 表根本不建 —— 而
/// `l0_size` 自己不看旗标，所以这里必须看；合成的名字（≥ 2^31）也不是提升对象。
fn l0_bytes(s: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    if load32(s, 572) == 0 || nm >= 2147483648 {
        return 0;
    }
    return l0_size(s, src, toks, nm);
}

/// 这个名字占几格根表：**L0 提升过的缓冲按它的字数算**（`FujoJTOP/loment#362`），其余一格。
fn root_slots(s: ptr, src: ptr, toks: ptr, nm: u32) -> u32 {
    let n: u32 = l0_bytes(s, src, toks, nm);
    if n == 0 || l05_off(s, nm) != 0 {
        return 1;                                  // L0.5 的区整块另记（见 `roots_push`）
    }
    return (n + 7) / 8;
}

/// 登记 L0 缓冲里的**一个字**（`FujoJTOP/loment#362`）：那一格存的是**栈**地址
/// （`%NAME.buf + 8j` 的地址），根扫读它就知道缓冲里那个字像不像堆内地址。
/// 三条 temp 的次序与 `emit_root_slot` 一致（`idx` / `gp` / `bp` / `v`）。
fn emit_root_word(s: ptr, out: ptr, src: ptr, toks: ptr, n0: u32, c: u32,
                  nm: u32, j: u32, kw: u32) -> u32 {
    let idx: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, idx);
    emit_str(s, out, " = add i32 ");
    emit_temp_ref(s, out, n0);
    emit_str(s, out, ", ");
    emit_dec(s, out, c);
    emit_str(s, out, "\n");
    let gp: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, gp);
    emit_str(s, out, " = getelementptr [1024 x i64], ptr @__loment_roots, i32 0, i32 ");
    emit_temp_ref(s, out, idx);
    emit_str(s, out, "\n");
    let bp: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, bp);
    emit_str(s, out, " = getelementptr [");
    emit_dec(s, out, kw);
    emit_str(s, out, " x i64], ptr %");
    emit_local_name(s, out, src, toks, nm);
    emit_str(s, out, ".buf, i32 0, i32 ");
    emit_dec(s, out, j);
    emit_str(s, out, "\n");
    let v: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, v);
    emit_str(s, out, " = ptrtoint ptr ");
    emit_temp_ref(s, out, bp);
    emit_str(s, out, " to i64\n  store i64 ");
    emit_temp_ref(s, out, v);
    emit_str(s, out, ", ptr ");
    emit_temp_ref(s, out, gp);
    return emit_str(s, out, "\n");
}

/// `gc_auto`：把本帧"持有指针的槽"登记进根表（`docs/210` §4.2）。表满
/// （1024 格，递归深了才可能）**点名拒**，不静默写穿 —— 溢出分支与参考侧同形。
///
/// 槽 580 存**本帧**的 `rootk`：它必须**每次都写**（哪怕是 0），否则上一个函数留下的
/// 旧值会让 `roots_pop` 发一条无主的退表。
fn roots_push(s: ptr, out: ptr, src: ptr, toks: ptr, k: u32, nl: u32) -> u32 {
    //: 分配站点的 spill 槽也占根表（`#1465`）：一格一个槽的地址，与具名槽同口径，
    //: 放在最后 —— 次序必须与参考实现一致（逐字节判据）。
    let ns: u32 = alloc_sites(src, toks, load32(s, 564), load32(s, 568));
    let n: u32 = root_count(s, src, toks, k, nl) + ns;
    store32(s, 580, n);
    if n == 0 {
        return 0;
    }
    // `#778`：根表的游标与槽是线程间共享的 —— push 这一段整体是一段短临界区。
    if load32(s, 556) == 1 {
        emit_str(s, out, "  call void @__loment_rt_acquire()\n");
    }
    let n0: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, n0);
    emit_str(s, out, " = load i32, ptr @__loment_rootn\n");
    let c: u32 = 0;
    let i: u32 = 0;
    while i < k {
        if root_ty_tok(src, toks, load32(s, CG_CUR + i * 8 + 4)) == 1 {
            emit_root_slot(s, out, src, toks, n0, c, load32(s, CG_CUR + i * 8), 1);
            c = c + 1;
        }
        i = i + 1;
    }
    let j: u32 = 0;
    while j < nl {
        if root_ty_tok(src, toks, load32(s, CG_LOCAL + j * 8 + 4)) == 1 {
            let lnm: u32 = load32(s, CG_LOCAL + j * 8);
            let lsz: u32 = l0_bytes(s, src, toks, lnm);
            if lsz == 0 || l05_off(s, lnm) != 0 {
                emit_root_slot(s, out, src, toks, n0, c, lnm, 0);
                c = c + 1;
            } else {
                // **L0 提升的缓冲：一个字一格**（`FujoJTOP/loment#362`）。槽里存的是栈地址，
                // 根扫拿它减堆基址得到巨大的无符号数 ⇒ 整块缓冲从来没人扫。
                let kw: u32 = (lsz + 7) / 8;
                let w: u32 = 0;
                while w < kw {
                    emit_root_word(s, out, src, toks, n0, c, lnm, w, kw);
                    c = c + 1;
                    w = w + 1;
                }
            }
        }
        j = j + 1;
    }
    // **L0.5 的区**：整块每个 8 字节字各占一格 —— 与 L0 缓冲同口径（#362）。
    // 少了这一段，`rootn` 会跨过一批**从未初始化**的槽。
    let kw05: u32 = load32(s, CG_L05_CAP) / 8;
    let w05: u32 = 0;
    while w05 < kw05 {
        let i05: u32 = alloc_temp(s);
        emit_str(s, out, "  ");
        emit_temp_ref(s, out, i05);
        emit_str(s, out, " = add i32 ");
        emit_temp_ref(s, out, n0);
        emit_str(s, out, ", ");
        emit_dec(s, out, c);
        emit_str(s, out, "
");
        let g05: u32 = alloc_temp(s);
        emit_str(s, out, "  ");
        emit_temp_ref(s, out, g05);
        emit_str(s, out, " = getelementptr [1024 x i64], ptr @__loment_roots, i32 0, i32 ");
        emit_temp_ref(s, out, i05);
        emit_str(s, out, "
");
        let b05: u32 = alloc_temp(s);
        emit_str(s, out, "  ");
        emit_temp_ref(s, out, b05);
        emit_str(s, out, " = getelementptr [");
        emit_dec(s, out, kw05);
        emit_str(s, out, " x i64], ptr %l05.buf, i32 0, i32 ");
        emit_dec(s, out, w05);
        emit_str(s, out, "
");
        let v05: u32 = alloc_temp(s);
        emit_str(s, out, "  ");
        emit_temp_ref(s, out, v05);
        emit_str(s, out, " = ptrtoint ptr ");
        emit_temp_ref(s, out, b05);
        emit_str(s, out, " to i64
  store i64 ");
        emit_temp_ref(s, out, v05);
        emit_str(s, out, ", ptr ");
        emit_temp_ref(s, out, g05);
        emit_str(s, out, "
");
        c = c + 1;
        w05 = w05 + 1;
    }
    // **分配站点的 spill 槽**（`#1465`）：一格一个槽的地址，与具名槽同形。
    let qs: u32 = 0;
    while qs < ns {
        emit_root_gcsp(s, out, n0, c, qs);
        c = c + 1;
        qs = qs + 1;
    }
    let n1: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, n1);
    emit_str(s, out, " = add i32 ");
    emit_temp_ref(s, out, n0);
    emit_str(s, out, ", ");
    emit_dec(s, out, n);
    emit_str(s, out, "\n  store i32 ");
    emit_temp_ref(s, out, n1);
    emit_str(s, out, ", ptr @__loment_rootn\n");
    let ov: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, ov);
    emit_str(s, out, " = icmp ugt i32 ");
    emit_temp_ref(s, out, n1);
    emit_str(s, out, ", 1024\n  br i1 ");
    emit_temp_ref(s, out, ov);
    let ok: u32 = load32(s, 480) + 1;   // 参考侧先 `l("rok")` 再 `l("rovf")` -> ok 在前
    store32(s, 480, ok + 1);
    emit_str(s, out, ", label ");
    lab_ref(s, out, ok + 1, "rovf");
    emit_str(s, out, ", label ");
    lab_ref(s, out, ok, "rok");
    emit_str(s, out, "\n");
    store32(s, 476, 1);
    lab_def(s, out, ok + 1, "rovf");
    emit_str(s, out, "  call void @__loment_abort()\n  unreachable\n");
    store32(s, 476, 1);
    lab_def(s, out, ok, "rok");
    if load32(s, 556) == 1 {
        emit_str(s, out, "  call void @__loment_rt_release()\n");
    }
    return 0;
}

/// `gc_auto`：离开本帧前把根表游标退回去（与 `roots_push` 成对）。
fn roots_pop(s: ptr, out: ptr) -> u32 {
    let n: u32 = load32(s, 580);
    if n == 0 {
        return 0;
    }
    // `#778`：与 `roots_push` 同一把锁、同一段短临界区。
    if load32(s, 556) == 1 {
        emit_str(s, out, "  call void @__loment_rt_acquire()\n");
    }
    let a: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, a);
    emit_str(s, out, " = load i32, ptr @__loment_rootn\n");
    let b: u32 = alloc_temp(s);
    emit_str(s, out, "  ");
    emit_temp_ref(s, out, b);
    emit_str(s, out, " = sub i32 ");
    emit_temp_ref(s, out, a);
    emit_str(s, out, ", ");
    emit_dec(s, out, n);
    emit_str(s, out, "\n  store i32 ");
    emit_temp_ref(s, out, b);
    emit_str(s, out, ", ptr @__loment_rootn\n");
    if load32(s, 556) == 1 {
        emit_str(s, out, "  call void @__loment_rt_release()\n");
    }
    return 0;
}

// ---------------------------------------------------------------- `lgc`（docs/309）

/// 预算字面量 -> u64（`0x`/`0X` 前缀十六进制，否则十进制）。与参考实现 `_int_lit`
/// 同一张表；**自然环绕**（与那边 `v & 2^64-1` 同义）。
fn lgc_lit(src: ptr, toks: ptr, i: u32) -> u64 {
    let st: u32 = load32(toks, i * 20 + 4);
    let n: u32 = load32(toks, i * 20 + 8);
    let r: u64 = 0;
    let k: u32 = 0;
    if n >= 2 && load8(src, st) == 48 && (load8(src, st + 1) == 120 || load8(src, st + 1) == 88) {
        k = 2;
        while k < n {
            let c: u32 = load8(src, st + k);
            let d: u32 = 0;
            if c >= 48 && c <= 57 {
                d = c - 48;
            } else if c >= 97 && c <= 102 {
                d = c - 87;
            } else if c >= 65 && c <= 70 {
                d = c - 55;
            }
            r = r * (16 as u64) + (d as u64);
            k = k + 1;
        }
        return r;
    }
    while k < n {
        r = r * (10 as u64) + ((load8(src, st + k) - 48) as u64);
        k = k + 1;
    }
    return r;
}

/// `lgc` 的单位 -> 纳秒倍数（与参考实现 `LGC_UNITS` 同一张表；裸数字按纳秒收）。
fn lgc_unit(src: ptr, toks: ptr, i: u32) -> u64 {
    if tok_is(src, toks, i, "us") {
        return 1000 as u64;
    }
    if tok_is(src, toks, i, "ms") {
        return 1000000 as u64;
    }
    if tok_is(src, toks, i, "s") {
        return 1000000000 as u64;
    }
    if tok_is(src, toks, i, "m") {
        return 60000000000 as u64;
    }
    return 1 as u64;                    // `ns` / 裸数字
}

/// 入口块的窗口槽：每个窗口一对（`%lgc.on.N` i32 / `%lgc.dl.N` i64），编号按源码序。
/// 与参考实现 `locals_prologue` 里那两行同序、同文本。
fn emit_lgc_slots(s: ptr, out: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        emit_str(s, out, "  %lgc.on.");
        emit_dec(s, out, i);
        emit_str(s, out, " = alloca i32\n  %lgc.dl.");
        emit_dec(s, out, i);
        emit_str(s, out, " = alloca i64\n");
        i = i + 1;
    }
    return 0;
}

/// `lgc end { … }` 的入口：与 `lgc_begin` 同形（保存 on/deadline、压栈），
/// 但块内置 **0**、不设预算（`docs/309`）。
fn lgc_begin_off(s: ptr, out: ptr) -> u32 {
    if load32(s, 476) != 0 {
        return 0;
    }
    let idx: u32 = load32(s, CG_LGC_N);
    store32(s, CG_LGC_N, idx + 1);
    let d: u32 = load32(s, CG_LGC_D);
    store32(s, CG_LGC_STK + d * 4, idx);
    store32(s, CG_LGC_D, d + 1);
    emit_str(s, out, "  ");
    let on: u32 = new_temp(s, out);
    emit_str(s, out, " = load i32, ptr @__loment_gc_on\n  store i32 %t");
    emit_dec(s, out, on);
    emit_str(s, out, ", ptr %lgc.on.");
    emit_dec(s, out, idx);
    emit_str(s, out, "\n  ");
    let dl: u32 = new_temp(s, out);
    emit_str(s, out, " = load i64, ptr @__loment_gc_deadline\n  store i64 %t");
    emit_dec(s, out, dl);
    emit_str(s, out, ", ptr %lgc.dl.");
    emit_dec(s, out, idx);
    emit_str(s, out, "\n  store i32 0, ptr @__loment_gc_on\n");
    return 0;
}

/// 打开一个窗口：存下进入前的 on / deadline，置 on=1，按需写预算。
/// 与参考实现 `_Ir._lgc_stmt` 的 `begin` 分支同序、同 temp 号。
fn lgc_begin(s: ptr, out: ptr, hasb: u32, bval: u64) -> u32 {
    if load32(s, 476) != 0 {           // 块已终结：参考实现直接返回（不占号、不压栈）
        return 0;
    }
    let idx: u32 = load32(s, CG_LGC_N);
    store32(s, CG_LGC_N, idx + 1);
    let d: u32 = load32(s, CG_LGC_D);
    store32(s, CG_LGC_STK + d * 4, idx);
    store32(s, CG_LGC_D, d + 1);
    emit_str(s, out, "  ");
    let on: u32 = new_temp(s, out);
    emit_str(s, out, " = load i32, ptr @__loment_gc_on\n  store i32 %t");
    emit_dec(s, out, on);
    emit_str(s, out, ", ptr %lgc.on.");
    emit_dec(s, out, idx);
    emit_str(s, out, "\n  ");
    let dl: u32 = new_temp(s, out);
    emit_str(s, out, " = load i64, ptr @__loment_gc_deadline\n  store i64 %t");
    emit_dec(s, out, dl);
    emit_str(s, out, ", ptr %lgc.dl.");
    emit_dec(s, out, idx);
    emit_str(s, out, "\n  store i32 1, ptr @__loment_gc_on\n");
    if hasb == 1 {
        if bval == 0 as u64 {
            // 0 = 不限时：不读时钟，也不留预算。
            emit_str(s, out, "  store i64 0, ptr @__loment_gc_deadline\n");
        } else {
            emit_str(s, out, "  ");
            let now: u32 = new_temp(s, out);
            emit_str(s, out, " = call i64 @__loment_now_ns()\n  ");
            let add: u32 = new_temp(s, out);
            emit_str(s, out, " = add i64 %t");
            emit_dec(s, out, now);
            emit_str(s, out, ", ");
            let _dv: u32 = set_dec_val64(s, 0, bval);
            emit_val(s, out, 0);
            emit_str(s, out, "\n  store i64 %t");
            emit_dec(s, out, add);
            emit_str(s, out, ", ptr @__loment_gc_deadline\n");
        }
    }
    return 0;
}

/// 恢复**一个**窗口（按编号）：把进入前存的 on / deadline 写回去。
fn lgc_restore_one(s: ptr, out: ptr, idx: u32) -> u32 {
    emit_str(s, out, "  ");
    let on: u32 = new_temp(s, out);
    emit_str(s, out, " = load i32, ptr %lgc.on.");
    emit_dec(s, out, idx);
    emit_str(s, out, "\n  store i32 %t");
    emit_dec(s, out, on);
    emit_str(s, out, ", ptr @__loment_gc_on\n  ");
    let dl: u32 = new_temp(s, out);
    emit_str(s, out, " = load i64, ptr %lgc.dl.");
    emit_dec(s, out, idx);
    emit_str(s, out, "\n  store i64 %t");
    emit_dec(s, out, dl);
    return emit_str(s, out, ", ptr @__loment_gc_deadline\n");
}

/// `lgc` 的 `close`（窗口体之后那条兄弟语句）：恢复正常就走恢复，块已终结就**只跳过**
/// （参考实现 `if not self.terminated and self.lgc_open:` —— 终结时连栈都不弹）。
fn lgc_close(s: ptr, out: ptr) -> u32 {
    let d: u32 = load32(s, CG_LGC_D);
    if load32(s, 476) != 0 || d == 0 {
        return 0;
    }
    let idx: u32 = load32(s, CG_LGC_STK + (d - 1) * 4);
    store32(s, CG_LGC_D, d - 1);
    return lgc_restore_one(s, out, idx);
}

/// `return` / 函数末尾：所有**还开着**的窗口按逆序恢复（`docs/309`）。
fn lgc_restore_all(s: ptr, out: ptr) -> u32 {
    let d: u32 = load32(s, CG_LGC_D);
    while d > 0 {
        let idx: u32 = load32(s, CG_LGC_STK + (d - 1) * 4);
        lgc_restore_one(s, out, idx);
        d = d - 1;
        store32(s, CG_LGC_D, d);
    }
    return 0;
}

/// 一条 `lgc` 语句（`docs/309`）：`end` / `start` / `start { … }` / `start(预算) { … }`。
///
/// 窗口体在这里**就地当一个块发**（`while !}` 那条循环，和 if/while 的体同一份做法）——
/// 参考实现是把体摊平成兄弟语句，两者对**发射出的指令序列**是同一件事。
/// 返回下一条语句的 token 下标。
fn lgc_stmt(s: ptr, out: ptr, src: ptr, toks: ptr, j: u32, ret: u32) -> u32 {
    let act: u32 = j + 1;
    if tok_is(src, toks, act, "end") {
        if tok_is(src, toks, act + 1, "{") {
            // `lgc end { … }`：短暂暂停窗口（`docs/309`）。
            lgc_begin_off(s, out);
            let m: u32 = act + 2;
            while !tok_is(src, toks, m, "}") && tok_kind(toks, m) != 4 {
                m = stmt(s, out, src, toks, m, ret);
            }
            lgc_close(s, out);
            return m + 1;
        }
        if load32(s, 476) == 0 {
            emit_str(s, out, "  store i32 0, ptr @__loment_gc_on\n");
        }
        return act + 2;                       // 跳过 `;`
    }
    let k: u32 = act + 1;
    let hb: u32 = 0;
    let bv: u64 = 0 as u64;
    if tok_is(src, toks, k, "(") {
        // `lgc start(10ms)`：**编译期**字面量 + 可选单位（ns/us/ms/s/m，裸数字按 ns）。
        let ni: u32 = k + 1;
        let un: u32 = ni + 1;
        let mm: u64 = 1 as u64;
        if tok_kind(toks, un) == 0 {
            mm = lgc_unit(src, toks, un);
            un = un + 1;
        }
        hb = 1;
        bv = lgc_lit(src, toks, ni) * mm;
        k = un;
        if tok_is(src, toks, k, ")") {
            k = k + 1;                    // 跳过预算的 `)`
        }
    }
    if tok_is(src, toks, k, "{") {
        lgc_begin(s, out, hb, bv);
        let m: u32 = k + 1;
        while !tok_is(src, toks, m, "}") && tok_kind(toks, m) != 4 {
            m = stmt(s, out, src, toks, m, ret);
        }
        lgc_close(s, out);
        return m + 1;                         // 跳过 `}`
    }
    // `lgc start;`：恢复收集器（运行期状态，不做词法恢复）。
    if load32(s, 476) == 0 {
        emit_str(s, out, "  store i32 1, ptr @__loment_gc_on\n");
    }
    return k + 1;                             // 跳过 `;`
}

/// 这份单元真的用了 `guard` / `tick;` 吗（参考实现的文本判据
/// `"@__loment_guard2" in text_all or "@__loment_tick" in text_all` 的位置版）。
fn guard_rt_needed(s: ptr, src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "guard") && tok_kind(toks, i + 1) == 0 {
            return 1;
        }
        if tok_is(src, toks, i, "tick") && tok_is(src, toks, i + 1, ";") {
            return 1;
        }
        if tok_is(src, toks, i, "quality") && tok_kind(toks, i + 1) == 0 {
            return 1;
        }
        if tok_is(src, toks, i, "revoke") && tok_kind(toks, i + 1) == 0
                && (tok_is(src, toks, i + 2, ";") || tok_is(src, toks, i + 2, "(")) {
            return 1;
        }
        if tok_is(src, toks, i, "domain") && is_dom_block(src, toks, i) == 1 {
            return 1;
        }
        if tok_is(src, toks, i, "discharge") && tok_kind(toks, i + 1) == 0 {
            return 1;
        }
        if (tok_is(src, toks, i, "generation") || tok_is(src, toks, i, "retire"))
                && tok_kind(toks, i + 1) == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 能力域运行时（`docs/306`–`docs/308`）：虚拟钟 + 十种域。
/// **与 `tools/lomentc.py` 的 `_IR_GUARD_RUNTIME` 逐字相同**（孪生判据）。
fn emit_guard_runtime(s: ptr, out: ptr) -> u32 {
    emit_str(s, out, "; ---- 能力域运行时 (docs/306-308, 313): 虚拟钟 + 块级域 ----
@__loment_now = internal global i64 0
@__loment_used = internal global [16 x [64 x i64]] zeroinitializer
@__loment_wit = internal global [16 x [64 x i64]] zeroinitializer
@__loment_obl = internal global [16 x [64 x i64]] zeroinitializer
@__loment_gen = internal global [16 x [64 x i64]] zeroinitializer
@__loment_rev = internal global [64 x [2 x i64]] zeroinitializer
@__loment_revfree = internal global [2 x i64] zeroinitializer
@__loment_qual = internal global [16 x i64] [i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255, i64 255]

define internal void @__loment_tick() {
entry:
  %n = load i64, ptr @__loment_now
  %n1 = add i64 %n, 1
  store i64 %n1, ptr @__loment_now
  ret void
}

define internal void @__loment_revoke(ptr %rv, i64 %idx, i64 %all) {
entry:
  %isf = icmp ne i64 %all, 0
  br i1 %isf, label %whole, label %pos
whole:
  store i64 1, ptr %rv
  ret void
pos:
  %mp = getelementptr i64, ptr %rv, i64 1
  %m = load i64, ptr %mp
  %s = and i64 %idx, 63
  %b = shl i64 1, %s
  %m1 = or i64 %m, %b
  store i64 %m1, ptr %mp
  ret void
}

");
    emit_str(s, out, "define internal void @__loment_qual_store(ptr %st, i64 %v) {
entry:
  %big = icmp ugt i64 %v, 255
  %zb = zext i1 %big to i64
  %keep = sub i64 %zb, 1
  %okv = and i64 %v, %keep
  %sel = sub i64 0, %zb
  %fif = and i64 %sel, 255
  %q = or i64 %okv, %fif
  store i64 %q, ptr %st
  ret void
}

define internal void @__loment_discharge(ptr %st, i64 %cap, i64 %idx) {
entry:
  %now = load i64, ptr @__loment_now
  %slot = and i64 %idx, 63
  %p = getelementptr [64 x i64], ptr %st, i64 0, i64 %slot
  %v = load i64, ptr %p
  %have = icmp ne i64 %v, 0
  %late = icmp ugt i64 %now, %v
  %none = xor i1 %have, true
  %bad = or i1 %none, %late
  br i1 %bad, label %fail, label %ok
fail:
  call void @__loment_abort()
  unreachable
ok:
  store i64 0, ptr %p
  ret void
}

define internal i64 @__loment_gen_read(ptr %st, i64 %idx, i64 %lo, i64 %hi, i64 %flags) {
entry:
  %fl = and i64 %flags, 1
  %linf = icmp ne i64 %fl, 0
  %fh = and i64 %flags, 2
  %hinf = icmp ne i64 %fh, 0
  %ge = icmp uge i64 %idx, %lo
  %lob = or i1 %linf, %ge
  %le = icmp ule i64 %idx, %hi
  %hib = or i1 %hinf, %le
  %bound = and i1 %lob, %hib
  br i1 %bound, label %ok, label %bad
bad:
  call void @__loment_abort()
  unreachable
");
    emit_str(s, out, "ok:
  %off0 = sub i64 %idx, %lo
  %big = icmp uge i64 %off0, 64
  %zb = zext i1 %big to i64
  %mbo = sub i64 %zb, 1
  %off = and i64 %off0, %mbo
  %p = getelementptr [64 x i64], ptr %st, i64 0, i64 %off
  %v = load i64, ptr %p
  ret i64 %v
}

define internal void @__loment_gen_bump(ptr %st, i64 %idx, i64 %lo, i64 %hi, i64 %flags) {
entry:
  %fl = and i64 %flags, 1
  %linf = icmp ne i64 %fl, 0
  %fh = and i64 %flags, 2
  %hinf = icmp ne i64 %fh, 0
  %ge = icmp uge i64 %idx, %lo
  %lob = or i1 %linf, %ge
  %le = icmp ule i64 %idx, %hi
  %hib = or i1 %hinf, %le
  %bound = and i1 %lob, %hib
  br i1 %bound, label %ok, label %bad
bad:
  call void @__loment_abort()
  unreachable
ok:
  %off0 = sub i64 %idx, %lo
  %big = icmp uge i64 %off0, 64
  %zb = zext i1 %big to i64
  %mbo = sub i64 %zb, 1
  %off = and i64 %off0, %mbo
  %p = getelementptr [64 x i64], ptr %st, i64 0, i64 %off
  %v = load i64, ptr %p
  %v1 = add i64 %v, 1
  store i64 %v1, ptr %p
  ret void
}

define internal void @__loment_guard2(ptr %st, i64 %cap, i64 %idx, i64 %aux, i64 %lo, i64 %hi, i64 %kind, i64 %param, i64 %flags, ptr %rv) {
entry:
  %now = load i64, ptr @__loment_now
  %pm0 = icmp eq i64 %param, 0
");
    emit_str(s, out, "  %pmz = zext i1 %pm0 to i64
  %pm = or i64 %param, %pmz
  %fl = and i64 %flags, 1
  %linf = icmp ne i64 %fl, 0
  %fh = and i64 %flags, 2
  %hinf = icmp ne i64 %fh, 0
  %ge = icmp uge i64 %idx, %lo
  %lob = or i1 %linf, %ge
  %le = icmp ule i64 %idx, %hi
  %hib = or i1 %hinf, %le
  %bound = and i1 %lob, %hib
  %nb = xor i1 %bound, true
  %ks = and i64 %kind, 127
  %sil = and i64 %kind, 128
  %sn = icmp ne i64 %sil, 0
  %k1 = icmp eq i64 %ks, 1
  %nk1 = xor i1 %k1, true
  %p1a = and i1 %nb, %k1
  %p1b = and i1 %bound, %nk1
  %a1 = or i1 %p1a, %p1b
  %k2 = icmp eq i64 %ks, 2
  %et = icmp ult i64 %now, %pm
  %e = and i1 %et, %bound
  %nk2 = xor i1 %k2, true
  %p2a = and i1 %e, %k2
  %p2b = and i1 %a1, %nk2
  %a2 = or i1 %p2a, %p2b
  %k3 = icmp eq i64 %ks, 3
  %seg = udiv i64 %now, %pm
  %sego = mul i64 %seg, %pm
  %org = add i64 %lo, %sego
  %end = add i64 %org, %pm
  %o1 = icmp uge i64 %idx, %org
  %o2 = icmp ult i64 %idx, %end
  %ow = and i1 %o1, %o2
  %o = and i1 %ow, %bound
  %nk3 = xor i1 %k3, true
  %p3a = and i1 %o, %k3
  %p3b = and i1 %a2, %nk3
  %a3 = or i1 %p3a, %p3b
  %k4 = icmp eq i64 %ks, 4
  %slt = icmp ult i64 %now, %pm
  %slo = sub i64 %now, %pm
");
    emit_str(s, out, "  %zs = zext i1 %slt to i64
  %ms = sub i64 %zs, 1
  %slo2 = and i64 %slo, %ms
  %s1 = icmp uge i64 %idx, %slo2
  %s2 = icmp ule i64 %idx, %now
  %s = and i1 %s1, %s2
  %nk4 = xor i1 %k4, true
  %p4a = and i1 %s, %k4
  %p4b = and i1 %a3, %nk4
  %a4 = or i1 %p4a, %p4b
  %k5 = icmp eq i64 %ks, 5
  %dt = icmp ule i64 %now, %pm
  %d = and i1 %dt, %bound
  %nk5 = xor i1 %k5, true
  %p5a = and i1 %d, %k5
  %p5b = and i1 %a4, %nk5
  %a5 = or i1 %p5a, %p5b
  %k6 = icmp eq i64 %ks, 6
  %gr = mul i64 %now, %pm
  %gend = add i64 %lo, %gr
  %g1 = icmp ule i64 %idx, %gend
  %g = and i1 %g1, %bound
  %nk6 = xor i1 %k6, true
  %p6a = and i1 %g, %k6
  %p6b = and i1 %a5, %nk6
  %a6 = or i1 %p6a, %p6b
  %off0 = sub i64 %idx, %lo
  %big = icmp uge i64 %off0, 64
  %zb = zext i1 %big to i64
  %mbo = sub i64 %zb, 1
  %off = and i64 %off0, %mbo
  %up = getelementptr [64 x i64], ptr %st, i64 0, i64 %off
  %uv = load i64, ptr %up
  %uc = icmp ult i64 %uv, %pm
  %k7 = icmp eq i64 %ks, 7
  %c = and i1 %uc, %bound
  %nk7 = xor i1 %k7, true
  %p7a = and i1 %c, %k7
  %p7b = and i1 %a6, %nk7
  %a7 = or i1 %p7a, %p7b
  %k8 = icmp eq i64 %ks, 8
  %c8w = urem i64 %idx, %pm
  %c8a = icmp uge i64 %c8w, %lo
");
    emit_str(s, out, "  %c8b = icmp ule i64 %c8w, %hi
  %c8n = and i1 %c8a, %c8b
  %nk8 = xor i1 %k8, true
  %p8a = and i1 %c8n, %k8
  %p8b = and i1 %a7, %nk8
  %a8 = or i1 %p8a, %p8b
  %k9 = icmp eq i64 %ks, 9
  %g9s = udiv i64 %now, %pm
  %g9o = and i64 %g9s, 1
  %g9i = icmp ne i64 %g9o, 0
  %g9n = xor i1 %bound, %g9i
  %nk9 = xor i1 %k9, true
  %p9a = and i1 %g9n, %k9
  %p9b = and i1 %a8, %nk9
  %a9 = or i1 %p9a, %p9b
  %k10 = icmp eq i64 %ks, 10
  %adw = sub i64 %hi, %lo
  %adq = load i64, ptr %st
  %adm = mul i64 %adw, %adq
  %adr = udiv i64 %adm, 255
  %adh = add i64 %lo, %adr
  %adb1 = icmp uge i64 %idx, %lo
  %adb2 = icmp ule i64 %idx, %adh
  %adn = and i1 %adb1, %adb2
  %nk10 = xor i1 %k10, true
  %p10a = and i1 %adn, %k10
  %p10b = and i1 %a9, %nk10
  %a10 = or i1 %p10a, %p10b
  %k11 = icmp eq i64 %ks, 11
  %sb11 = and i64 %aux, 63
  %sb11s = lshr i64 %param, %sb11
  %sb11b = and i64 %sb11s, 1
  %sb11n = icmp ne i64 %sb11b, 0
  %sb11p = and i1 %sb11n, %bound
  %nk11 = xor i1 %k11, true
  %p11a = and i1 %sb11p, %k11
  %p11b = and i1 %a10, %nk11
  %a11 = or i1 %p11a, %p11b
  %k12 = icmp eq i64 %ks, 12
  %w12s = and i64 %aux, 63
  %w12p = getelementptr [64 x i64], ptr %st, i64 0, i64 %w12s
");
    emit_str(s, out, "  %w12v = load i64, ptr %w12p
  %w12c = icmp ult i64 %w12v, %pm
  %w12n = and i1 %w12c, %bound
  %w12v1 = add i64 %w12v, 1
  %nk12 = xor i1 %k12, true
  %p12a = and i1 %w12n, %k12
  %p12b = and i1 %a11, %nk12
  %a12 = or i1 %p12a, %p12b
  %k13 = icmp eq i64 %ks, 13
  %f13d = and i64 %aux, 65535
  %f13s = shl i64 %idx, 16
  %f13k = or i64 %f13s, %f13d
  %f13a = icmp uge i64 %f13k, %lo
  %f13b = icmp ule i64 %f13k, %hi
  %f13n = and i1 %f13a, %f13b
  %nk13 = xor i1 %k13, true
  %p13a = and i1 %f13n, %k13
  %p13b = and i1 %a12, %nk13
  %a13 = or i1 %p13a, %p13b
  %k14 = icmp eq i64 %ks, 14
  %o14s = and i64 %idx, 63
  %o14p = getelementptr [64 x i64], ptr %st, i64 0, i64 %o14s
  %o14v = load i64, ptr %o14p
  %o14f = icmp eq i64 %o14v, 0
  %o14n = and i1 %o14f, %bound
  %nk14 = xor i1 %k14, true
  %p14a = and i1 %o14n, %k14
  %p14b = and i1 %a13, %nk14
  %a14 = or i1 %p14a, %p14b
  %k15 = icmp eq i64 %ks, 15
  %g15o0 = sub i64 %idx, %lo
  %g15b = icmp uge i64 %g15o0, 64
  %g15z = zext i1 %g15b to i64
  %g15m = sub i64 %g15z, 1
  %g15o = and i64 %g15o0, %g15m
  %g15p = getelementptr [64 x i64], ptr %st, i64 0, i64 %g15o
  %g15v = load i64, ptr %g15p
  %g15e = icmp eq i64 %g15v, %aux
");
    emit_str(s, out, "  %g15n = and i1 %g15e, %bound
  %nk15 = xor i1 %k15, true
  %p15a = and i1 %g15n, %k15
  %p15b = and i1 %a14, %nk15
  %a15 = or i1 %p15a, %p15b
  %rvf = load i64, ptr %rv
  %rvmp = getelementptr i64, ptr %rv, i64 1
  %rvm = load i64, ptr %rvmp
  %rvs = and i64 %idx, 63
  %rvsh = lshr i64 %rvm, %rvs
  %rvb = and i64 %rvsh, 1
  %rvany = or i64 %rvf, %rvb
  %rvz = icmp eq i64 %rvany, 0
  %ok = and i1 %a15, %rvz
  br i1 %ok, label %pass, label %fail
fail:
  call void @__loment_abort()
  unreachable
pass:
  br i1 %sn, label %done, label %aaudit
aaudit:
  %ap = getelementptr i64, ptr @__loment_audit, i64 %cap
  %av = load i64, ptr %ap
  %av1 = add i64 %av, 1
  store i64 %av1, ptr %ap
  br i1 %k7, label %consume, label %wcheck
wcheck:
  br i1 %k12, label %witness, label %ocheck
witness:
  store i64 %w12v1, ptr %w12p
  br label %ocheck
ocheck:
  br i1 %k14, label %oblige, label %done
oblige:
  %odl = add i64 %now, %pm
  store i64 %odl, ptr %o14p
  br label %done
consume:
  %cv = load i64, ptr %up
  %cv1 = add i64 %cv, 1
  store i64 %cv1, ptr %up
  br label %done
done:
  ret void
}
");
    return emit_str(s, out, "
");
}
fn emit_runtime(s: ptr, out: ptr) -> u32 {
    emit_str(s, out, "\n; ---- Loment freestanding 运行时 (M31: 无 libc) ----\ndefine internal i32 @__loment_memcmp(ptr %a, ptr %b, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %cont ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %eq, label %body\nbody:\n  %pa = getelementptr i8, ptr %a, i64 %i\n  %pb = getelementptr i8, ptr %b, i64 %i\n  %ca = load i8, ptr %pa\n  %cb = load i8, ptr %pb\n  %ne = icmp ne i8 %ca, %cb\n  br i1 %ne, label %diff, label %cont\ncont:\n  %i1 = add i64 %i, 1\n  br label %loop\ndiff:\n  %da = zext i8 %ca to i32\n  %db = zext i8 %cb to i32\n  %r = sub i32 %da, %db\n  ret i32 %r\neq:\n  ret i32 0\n}\n\n");
    emit_str(s, out, "define internal void @__loment_memset(ptr %p, i8 %v, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %end, label %body\nbody:\n  %q = getelementptr i8, ptr %p, i64 %i\n  store i8 %v, ptr %q\n  %i1 = add i64 %i, 1\n  br label %loop\nend:\n  ret void\n}\n\n");
    emit_str(s, out, "define internal void @__loment_memcpy(ptr %d, ptr %s, i64 %n) {\nentry:\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %done = icmp uge i64 %i, %n\n  br i1 %done, label %end, label %body\nbody:\n  %sp = getelementptr i8, ptr %s, i64 %i\n  %b = load i8, ptr %sp\n  %dp = getelementptr i8, ptr %d, i64 %i\n  store i8 %b, ptr %dp\n  %i1 = add i64 %i, 1\n  br label %loop\nend:\n  ret void\n}\n\n");
    emit_str(s, out, "define internal void @__loment_abort() {\n  call void @llvm.trap()\n  unreachable\n}\n\ndeclare void @llvm.trap()\n\n");
    return 0;
}

/// 这份单元**调用**了 `print_num` 吗（`docs/296` §2.7）：它的实现带一句 x86 的
/// `syscall` asm，不能并进目标无关的运行期块（aarch64 交叉编译会当非法汇编拒掉），
/// 所以单独发。判据与参考实现 `"@__loment_print_num" in text_all` 同义 —— 只有真调用
/// 才会产生那条 `call`；`fn print_num(` 是声明，不算。
fn uses_print_num(s: ptr, src: ptr, toks: ptr) -> u32 {
    if load32(s, CG_PROF) == 0 {
        return 0;
    }
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "print_num") && tok_is(src, toks, i + 1, "(") {
            if !(i > 0 && tok_is(src, toks, i - 1, "fn")) {
                return 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

/// `print_num` 的实现（`docs/296` §2.7）：24 字节栈缓冲、一次 `write`。
/// **单独发**（不在 `emit_runtime` 里）：它带一句 x86 的 `syscall` asm，目标无关的
/// 运行期块收不下它（aarch64 交叉编译会当非法汇编拒掉）。
fn emit_print_num(s: ptr, out: ptr) -> u32 {
    return emit_str(s, out, "define internal i32 @__loment_print_num(i64 %v) {\nentry:\n  %buf = alloca [24 x i8]\n  %neg = icmp slt i64 %v, 0\n  br i1 %neg, label %negp, label %pos\nnegp:\n  %m0 = sub i64 0, %v\n  br label %conv\npos:\n  br label %conv\nconv:\n  %m = phi i64 [ %m0, %negp ], [ %v, %pos ]\n  %end0 = getelementptr inbounds [24 x i8], ptr %buf, i64 0, i64 24\n  br label %loop\nloop:\n  %p = phi ptr [ %end0, %conv ], [ %p2, %loop ]\n  %x = phi i64 [ %m, %conv ], [ %q, %loop ]\n  %d = urem i64 %x, 10\n  %q = udiv i64 %x, 10\n  %c = trunc i64 %d to i8\n  %c2 = add i8 %c, 48\n  %pi = ptrtoint ptr %p to i64\n  %pj = sub i64 %pi, 1\n  %p2 = inttoptr i64 %pj to ptr\n  store i8 %c2, ptr %p2\n  %done = icmp eq i64 %q, 0\n  br i1 %done, label %after, label %loop\nafter:\n  br i1 %neg, label %sign, label %wr\nsign:\n  %si = ptrtoint ptr %p2 to i64\n  %sj = sub i64 %si, 1\n  %p3 = inttoptr i64 %sj to ptr\n  store i8 45, ptr %p3\n  br label %wr\nwr:\n  %st = phi ptr [ %p2, %after ], [ %p3, %sign ]\n  %sp = ptrtoint ptr %st to i64\n  %ep = ptrtoint ptr %end0 to i64\n  %ln = sub i64 %ep, %sp\n  %r = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 1, i64 1, i64 %sp, i64 %ln)\n  %t = trunc i64 %r to i32\n  ret i32 %t\n}\n\n");
}

/// 预扫描: 源码里出现过 `/` `%` 运算符 (kind=3 且文本为单字符), 或 `alloc` / `panic`
/// (它们引用 `@__loment_*`) 时需运行时文本块。
/// 输出是顺序写的, 而运行时块要落在横幅之后、函数之前, 所以必须先判定再写横幅。
/// 语义等价于 lomentc 的 `"@__loment_" in text_all` —— 本 codegen 目前只有这三个来源会引用它。
/// 全文 (含 import 拼接进来的依赖) 是否出现过某个标识符。
fn contains_ident(src: ptr, toks: ptr, text: str) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, text) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 单元里**声明**过这个外部符号吗（`docs/228` §3.2）。运行期自己那份 `declare` 必须
/// **让给用户的**：LLVM 对同一条 `declare` 重复出现报 `invalid redefinition of
/// function`（实测），签名不同更糟。与参考实现的 `seen_ext` 同义。
fn extern_named(s: ptr, src: ptr, toks: ptr, text: str) -> u32 {
    let dx: u32 = 0;
    while dx < load32(s, 640) {
        if load32(s, fk_base(dx)) == 3 && tok_is(src, toks, load32(s, CG_FN + dx * 12), text) == 1 {
            return 1;
        }
        dx = dx + 1;
    }
    return 0;
}

fn runtime_needed(s: ptr, src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 3 && (tok_is(src, toks, i, "/") || tok_is(src, toks, i, "%")) {
            return 1;
        }
        let hit: u32 = 0;
        if tok_kind(toks, i) == 0 && (tok_is(src, toks, i, "alloc") || tok_is(src, toks, i, "panic")
                || tok_is(src, toks, i, "str_eq") || tok_is(src, toks, i, "str_concat")
                || tok_is(src, toks, i, "free")
                || tok_is(src, toks, i, "guard")
                || tok_is(src, toks, i, "tick")) {
            hit = 1;
        }
        // `print_num` **只在 Tur 2 是内建**（`docs/296` §2.7）：Tur 1 里同名的用户函数
        // 不引用运行期，带上它就是多一份块、与参考实现分叉。
        if load32(s, CG_PROF) != 0 && tok_kind(toks, i) == 0
                && tok_is(src, toks, i, "print_num") {
            hit = 1;
        }
        if hit == 1 && tok_is(src, toks, i, "alloc") && alloc_is_promoted(s, src, toks, i) == 1 {
            hit = 0;   // L0 把它提到栈上了: 这条 alloc 不引用运行期
        }
        if hit == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 预扫描: `alloc` 用到 bump 堆全局 (`@__loment_heap`/`@__loment_off`)。
///
/// **被 L0 提升掉的那条不算** —— 参考实现是按**发射出来的文本**判的
/// （`"@__loment_alloc" in text_all`），提到栈上的 `alloc` 不产生任何对分配器的引用；
/// 少判这一步，孪生会在全提升的程序上多带一份运行期 + 分配器（实测：逐字节判据立刻红）。
fn heap_needed(s: ptr, src: ptr, toks: ptr, rt_on: u32) -> u32 {
    // **外源库也要那块 arena**（`docs/219` S2 / `FujoJTOP/loment#359`，2026-10-15）：
    // 根开了运行期、而这份单元声明了 `extern fn` ⇒ 发堆。真 C 库总要 `malloc`（zlib 的
    // `zutil.o` 就要），而收编面那两条薄壳**只在堆在时才发** —— 堆不在，链接期就是
    // "引用了未定义的符号 malloc"。与参考实现 `_declares_extern` 同一条规则。
    // **`no_runtime` 不跟**：那一维是保证（`docs/217`），产物里不带运行期。
    // **不另写一个函数**：这一层加函数真的会慢下去（`docs/231` §2.2 量过 +4.7s）。
    // 顺带把"声明了 `extern fn`"这件事记进槽 544 —— `emit_llvm` 那一步要拿它挑 arena
    // （`docs/219` §8b 的 S2：外源库那一档要 256–512 KiB，64 KiB 装不下）。同一趟扫描的
    // 副产品，不另写第二遍（`docs/231` §2.2 那笔账）。
    if rt_on == 1 {
        let j: u32 = 0;
        while tok_kind(toks, j) != 4 {
            if tok_kind(toks, j) == 0 && tok_is(src, toks, j, "extern") == 1 {
                if tok_kind(toks, j + 1) == 0 && tok_is(src, toks, j + 1, "fn") == 1 {
                    store32(s, 544, 1);
                    return 1;
                }
            }
            j = j + 1;
        }
    }
    // `lgc` 那一档**必然带堆**（参考实现 `_needs_heap` 里那个 `or _gc_ctl`）：
    // 收集器的正文引用 `@__loment_heap` / `@__loment_off` / `@__loment_free`，
    // 而窗口要能收集 —— 哪怕这份程序一个 `alloc` 都没写。
    if load32(s, CG_LGC) == 1 {
        return 1;
    }
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        let hit: u32 = 0;
        // `thread_spawn`（`#778`）：线程要带上运行期锁与 `@__loment_rt_threads` ——
        // 它们与分配器同一段文本，所以起线程就发堆（见参考实现 `_heap_needed`）。
        if tok_kind(toks, i) == 0 && (tok_is(src, toks, i, "alloc")
                || tok_is(src, toks, i, "str_concat")     // str_concat 也拼到堆上
                || tok_is(src, toks, i, "free")           // 回收也要读那份状态
                || tok_is(src, toks, i, "thread_spawn")) {
            hit = 1;
        }
        if hit == 1 && tok_is(src, toks, i, "alloc") && alloc_is_promoted(s, src, toks, i) == 1 {
            hit = 0;
        }
        if hit == 1 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 签名里的形参名是否等于 `nm`（**前 16 个** —— 与 `emit_fn` 填 `CG_CUR` 的口径一致，
/// 于是与 `l0_size` 的形参判定同宽）。循环形状照抄 `emit_fn` 开头那一段。
fn param_named(src: ptr, toks: ptr, lp: u32, rp: u32, nm: u32) -> bool {
    let i: u32 = lp + 1;
    let k: u32 = 0;
    while i < rp && k < 16 {
        if tok_eq(src, toks, i, nm) {
            return true;
        }
        k = k + 1;
        i = skip_type(src, toks, i + 2);
        if tok_is(src, toks, i, ",") {
            i = i + 1;
        }
    }
    return false;
}

/// 预扫描里那条问题：**这个 `alloc` 是不是被 L0 提到栈上的那一条**。
///
/// 它比 `l0_size` 多要一样东西 —— **外层函数的体跨度**（预扫描时 `emit_fn` 还没跑过，
/// 564/568 还不是当前函数的值）。所以要往回找最近的那个 `fn`：函数体里不可能再出现 `fn`
/// 记号（`trait`/`extern` 只有签名、不成体；字符串与 raw token 都不算记号），
/// 所以最近的那个就是外层。找不到、或它的体不含这个 `alloc` 时**保守当"没提升"** ——
/// 那个方向只会多带分配器，不会少带。
fn alloc_is_promoted(s: ptr, src: ptr, toks: ptr, a: u32) -> u32 {
    if load32(s, 572) == 0 || a < 4 {
        return 0;
    }
    let f: u32 = 0;
    let t: u32 = a;
    while f == 0 && t > 0 {
        if tok_is(src, toks, t, "fn") {
            f = t;
        }
        t = t - 1;
    }
    if f == 0 {
        return 0;
    }
    let lp: u32 = find_paren(src, toks, f + 2);
    let at: u32 = find_body(src, toks, lp);
    let end: u32 = skip_block(src, toks, at - 1);
    if !(at <= a && a < end) {
        return 0;
    }
    let nm: u32 = a - 4;                       // `let NAME : ptr = alloc` -> NAME 在 alloc 前 4 格
    if param_named(src, toks, lp, skip_parens(src, toks, lp), nm) {
        return 0;
    }
    store32(s, 564, at);
    store32(s, 568, end);
    if l0_size(s, src, toks, nm) == 0 {
        return 0;
    }
    return 1;
}

/// 状态块要多大 —— 驱动器按这个数从 `brk` 开一块传进来 (`emit_module` 的第 4 个参数)。
/// **不再从语言自带的 64 KiB bump 堆开**: 那几张表按单元规模定, 放大后远超 64 KiB。
pub fn cg_arena_bytes() -> u32 {
    return CG_BYTES;
}

/// 本单元是不是 `gc_auto_alpha` 档（`docs/210` §2）。
///
/// **codegen 不知道档位** —— 档位是检查器的活。但 `emit_module` 手上有整条 token 流，
/// 而核心模式只由**根单元**声明，所以扫那一行就够了。非根单元声明核心模式会被检查器拒 ——
/// 那是前提，不是这里的假设（真正的驱动在 `emit_module` 之前就跑过检查器）。
fn gc_alpha_tier(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "choose") && tok_is(src, toks, i + 1, "gc_auto_alpha") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 本单元是不是 `gc_auto` 档（`docs/210` §2.1 的"自动"那一档）。
///
/// **整词相等** —— `tok_is` 比的是整个 token，所以这边不会撞上 `gc_auto_alpha`
/// （那是一个 token）。两档互斥，各自的挂点不会打架。
fn gc_auto_tier(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "choose") && tok_is(src, toks, i + 1, "gc_auto") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 本单元出现过 `lgc` 吗（`docs/309`，Tur 2026.3）。`prof` 必须是 2 —— 旧版次里
/// `lgc` 是**普通标识符**（`lgc end;` 在老版次里只是一个未声明的名字），不拖任何运行期。
///
/// 认法与参考实现的 `_lgc_sites` 同义：**一条 `lgc start` / `lgc end` 语句**。
/// 只看 token 形状（ident `lgc` + ident `start`/`end`），不依赖 AST。
fn has_lgc(src: ptr, toks: ptr, prof: u32) -> u32 {
    if prof != 2 {
        return 0;
    }
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, "lgc")
                && tok_kind(toks, i + 1) == 0
                && (tok_is(src, toks, i + 1, "start") || tok_is(src, toks, i + 1, "end")) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 一个函数体 `[b, e)` 里有多少个**分配站点**（入口块按它开 spill 槽，`#1465`）。
///
/// 站点 = 标识符 `alloc` / `str_concat` **紧跟** `(`，且前面不是 `.`（方法调用在参考
/// 实现那边是 `MethodCall`，不是 `Call`）。与参考实现的 `_alloc_site_count` 同值：
/// 两边都按**发射序**编号，所以只要求数量相等。
fn alloc_sites(src: ptr, toks: ptr, b: u32, e: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = b;
    while i < e && tok_kind(toks, i) != 4 {
        let hit: u32 = 0;
        if tok_kind(toks, i) == 0 {
            if tok_is(src, toks, i, "alloc") || tok_is(src, toks, i, "str_concat") {
                if tok_is(src, toks, i + 1, "(") {
                    hit = 1;
                }
            }
        }
        if hit == 1 && i > b && tok_is(src, toks, i - 1, ".") {
            hit = 0;
        }
        n = n + hit;
        i = i + 1;
    }
    return n;
}

/// 语句边界：把本语句用过的 spill 槽写回 `null`（`#1465`）。只清 `0 .. CG_GCDIRTY-1`，
/// 与参考实现的 `_Ir._gc_flush` 同序、同文本。
fn gc_flush(s: ptr, out: ptr) -> u32 {
    let n: u32 = load32(s, CG_GCDIRTY);
    if n == 0 {
        return 0;
    }
    let i: u32 = 0;
    while i < n {
        emit_str(s, out, "  store ptr null, ptr %gc.sp.");
        emit_dec(s, out, i);
        emit_str(s, out, "\n");
        i = i + 1;
    }
    store32(s, CG_GCDIRTY, 0);
    return 0;
}

/// 入口块里的 spill 槽（`#1465`）：一个站点一格，**入口清零**。
///
/// 清零是必需的 —— 根扫把槽里的字当候选指针读，栈上的旧值必须是个"不像指针"的值。
fn emit_gc_slots(s: ptr, out: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    while i < n {
        emit_str(s, out, "  %gc.sp.");
        emit_dec(s, out, i);
        emit_str(s, out, " = alloca ptr\n  store ptr null, ptr %gc.sp.");
        emit_dec(s, out, i);
        emit_str(s, out, "\n");
        i = i + 1;
    }
    return 0;
}

/// 一个函数体 `[b, e)` 里有多少个 `lgc start { … }` **窗口**（入口块按它开槽）。
///
/// 与参考实现的 `_count_lgc_windows` 同值：那边数 AST 里的 `begin` 节点，这边数
/// token 里的 `lgc start` + 可选的 `(预算)` + `{`。窗口体已经摊平成兄弟语句，
/// 所以扫平 token 流就够 —— 不需要进任何块。
fn lgc_windows(src: ptr, toks: ptr, b: u32, e: u32) -> u32 {
    let n: u32 = 0;
    let i: u32 = b;
    while i < e && tok_kind(toks, i) != 4 {
        // `lgc end { … }` 也是窗口（短暂暂停），入口块同样要两个槽（`docs/309`）。
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, "lgc")
                && tok_is(src, toks, i + 1, "end") && tok_is(src, toks, i + 2, "{") {
            n = n + 1;
        }
        if tok_kind(toks, i) == 0 && tok_is(src, toks, i, "lgc")
                && tok_is(src, toks, i + 1, "start") {
            let k: u32 = i + 2;
            if tok_is(src, toks, k, "(") {
                while k < e && !tok_is(src, toks, k, ")") && tok_kind(toks, k) != 4 {
                    k = k + 1;
                }
                k = k + 1;
            }
            if tok_is(src, toks, k, "{") {
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

/// 本单元声明了 `choose runtime` 吗（`docs/217`）—— 那是**强制带**那一半。
///
/// 与 `gc_alpha_tier` 同形：codegen 不知道档位，但整条 token 流在手，而核心模式只由
/// **根单元**声明，扫那一行就够。`no_runtime` 那一半（"一定不带"）**不在这里** ——
/// 它在检查器里拒（`checker.lomt` 的 E031），发射器只管"带"。
fn rt_tier(src: ptr, toks: ptr) -> u32 {
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "choose") && tok_is(src, toks, i + 1, "runtime") {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// 主入口: 写完整 IR (子集), 返回长度; **返回 0 = 单元的规模超过表容量** (驱动器据此报错)。
// ---------------------------------------------------------------- 命令入口 (docs/223)

/// 这个单元要不要发命令入口：**声明了命令、名字取出来了、又没有 `_start`**。
///
/// 三种"半截"状态（形状不对 / 双入口 / 没声明却写了 `command_main`）在 checker 那一趟
/// 就报掉了，走到这里必然干净；这里再判一次只是不让 codegen 单独被调用时发出畸形 IR。
fn cmd_entry_needed(src: ptr, toks: ptr) -> u32 {
    let pk: u64 = lex_cmd_find(src, toks);
    if (pk / 4294967296) == 0 || (pk % 4294967296) == 0 {
        return 0;
    }
    let i: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if i >= 1 && tok_is(src, toks, i, "_start") && tok_is(src, toks, i - 1, "fn") {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

/// 命令入口的路径常量。**与参考实现逐字节同源**（`tools/lomentc.py` 的
/// `_cmd_entry_ir`）：`/proc/self/cmdline` 每个字节按 `\XX` 十六进制写，**末尾那个 0
/// 也写出来**（19 字节）—— 别处的字符串字面量不带 NUL，而 `openat` 要的是 NUL 结尾的
/// 路径；别处能跑是因为 `.rodata` 里后面恰好还有零字节，那不是一条能靠的规矩。
fn emit_cmd_globals(s: ptr, out: ptr) -> u32 {
    emit_str(s, out, "@.lc.cmdline = private unnamed_addr constant [19 x i8] c\"");
    let p: str = "/proc/self/cmdline";
    let q: u32 = 0;
    while q < str_len(p) {
        emit_hex_byte(s, out, str_byte(p, q));
        q = q + 1;
    }
    emit_hex_byte(s, out, 0);
    return emit_str(s, out, "\"
");
}

/// 工具链生成的进程入口。**这段文本与 `tools/lomentc.py` 的 `_IR_CMD_ENTRY` 完全一样**
/// —— `loment_p8_test` 那道闸要求两个实现发出的 IR 逐字节相同。
/// 局部名一律 `%lc.*` 前缀，与单元自己生成的 `%tN` 不会撞。
fn emit_cmd_entry(s: ptr, out: ptr) -> u32 {
    return emit_str(s, out, "; ---- 命令入口 (docs/223: 工具链生成, 不是用户写的) ----
define void @_start() {
entry:
  %lc.o = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 12, i64 0, i64 0, i64 0)
  %lc.w = add i64 %lc.o, 65536
  %lc.g = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 12, i64 %lc.w, i64 0, i64 0)
  %lc.b = inttoptr i64 %lc.o to ptr
  %lc.p = getelementptr inbounds [19 x i8], ptr @.lc.cmdline, i64 0, i64 0
  %lc.pi = ptrtoint ptr %lc.p to i64
  %lc.fd = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 257, i64 18446744073709551516, i64 %lc.pi, i64 0)
  %lc.bi = ptrtoint ptr %lc.b to i64
  %lc.n = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 0, i64 %lc.fd, i64 %lc.bi, i64 65536)
  %lc.c = call i32 @.lc.argc(ptr %lc.b, i64 %lc.n)
  %lc.r = call i32 @command_main(ptr %lc.b, i32 %lc.c)
  %lc.re = zext i32 %lc.r to i64
  %lc.x = call i64 asm sideeffect \"syscall\", \"={ax},{ax},{di},{si},{dx},~{cx},~{r11},~{memory}\"(i64 60, i64 %lc.re, i64 0, i64 0)
  ret void
}

define internal i32 @.lc.argc(ptr %b, i64 %n) {
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %cont ]
  %f = phi i64 [ 0, %entry ], [ %f1, %cont ]
  %done = icmp uge i64 %i, %n
  br i1 %done, label %out, label %body
body:
  %bp = getelementptr i8, ptr %b, i64 %i
  %bc = load i8, ptr %bp
  %bz = icmp eq i8 %bc, 0
  br i1 %bz, label %zero, label %cont
zero:
  %f0 = add i64 %f, 1
  br label %cont
cont:
  %f1 = phi i64 [ %f, %body ], [ %f0, %zero ]
  %i1 = add i64 %i, 1
  br label %loop
out:
  %r = trunc i64 %f to i32
  ret i32 %r
}
");
}

pub fn emit_module(src: ptr, toks: ptr, out: ptr, s: ptr, prof: u32, tickx: u32) -> u32 {
    store32(s, 0, 0);
    store32(s, 4, 0);
    store32(s, 12, 0);
    // 发射器的诊断通道（`#775`）：粘性失败标记与它的 token。**必须在这里清** ——
    // 状态块来自 `brk` 时是零，但夹具里的 `malloc` 会给脏页（见下面替换表那条）。
    store32(s, CG_ERR, 0);
    store32(s, CG_ERRTOK, 0);
    store32(s, CG_PROF, prof);
    // `docs/315`：单元用不用虚拟钟 + 用户有没有关掉"回边即 tick"。
    store32(s, CG_CLOCK, clock_sites(src, toks));
    store32(s, CG_TICKX, tickx);
    // **替换表的计数必须显式清零**：`sub_clear` 没人调用，这个格原来靠"调用方给的内存
    // 是零"成立 —— brk（真驱动）是零，而夹具里的 `malloc` 在 900 KB 这一档会拿到**脏页**
    // （`loment_p8_test` 的 C 夹具实测：`subst_tok` 读出一个 11 万多的表长，按 `i*8`
    // 走出状态块，0xC0000005）。发射器自己的初始化不该依赖分配器给什么。
    store32(s, 16, 0);
    store32(s, 640, 0);   // 函数个数
    store32(s, 476, 0);   // terminated
    store32(s, CG_LBRK, 0);   // 不在循环里
    store32(s, 480, 0);   // label 计数
    store32(s, 484, 0);   // 局部数
    store32(s, 572, gc_alpha_tier(src, toks));   // L0 只在 `gc_auto_alpha` 档上跑
    store32(s, 576, gc_auto_tier(src, toks));    // 自动收集只在 `gc_auto` 档上跑
    // `lgc` 的时间控制（`docs/309`）：只在 Tur 2026.3 且源里真写了 `lgc` 才发那一段。
    // **在任何预扫描之前定** —— `runtime_needed` / `heap_needed` 都要读它。
    store32(s, CG_LGC, has_lgc(src, toks, prof));
    // **LMS 七级开关的实际集合**（`docs/253` §11.4，2026-10-18）：档铺初值 + 显式覆盖。
    // 位序 = 七级的次序（check=1 manage=2 guard=4 reject=8 crash=16 restart=32 seed=64）。
    // 与参考实现 `_lms_level` 同一个来源，判据是产物的字节。
    store32(s, 588, lms_mask(src, toks));
    // 这两个预扫描要读 572 —— **顺序不能反** (它们在 alpha 档要跳过被提升的 alloc)
    store32(s, 512, runtime_needed(s, src, toks));
    if load32(s, CG_LGC) == 1 {
        // `lgc` 的语句引用 `@__loment_gc_on` / `@__loment_gc_deadline` —— 参考实现按
        // `"@__loment_" in text_all` 判，于是这一段**一定**被发出。缺了它产物引用
        // `@__loment_abort` 却没有定义（`__loment_maybe_collect_ctl` 的调用者仍然需要运行时）。
        store32(s, 512, 1);
    }
    // `choose runtime` = **强制带**（`docs/217`）：用不到也发 `_IR_RUNTIME`。
    // 参考实现那一半是 `if rt_on or "@__loment_" in text_all:` —— 同一个或。
    let rt_on: u32 = rt_tier(src, toks);
    if rt_on == 1 {
        store32(s, 512, 1);
    }
    store32(s, 544, 0);   // "声明了 `extern fn`"——由 heap_needed 那一趟扫描顺带写下
    store32(s, 516, heap_needed(s, src, toks, rt_on));
    // `#778`：这份产物起不起线程（合并后的 token 流里出现过 `thread_spawn`）。
    // 只在这一个地方定：它决定发不发运行期锁、以及 alloc/free/根表站点加不加锁。
    store32(s, 556, contains_ident(src, toks, "thread_spawn"));
    store32(s, 532, strings_needed(src, toks));
    // 符号表: 登记函数。同时识别 trait 声明 (方法只声明不发射) 与 impl 块 (方法名 = <类型>_<方法>)
    let i: u32 = 0;
    let n: u32 = 0;
    let depth: u32 = 0;
    let impl_depth: u32 = 0;
    let impl_recv: u32 = 0;
    let trait_depth: u32 = 0;
    let pend_impl: u32 = 0;
    store32(s, 456, 0);
    store32(s, 460, 0);
    store32(s, 464, 0);
    store32(s, 468, 0);
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "impl") {   // 接收者 = `for` 之后那个 token
            let fp: u32 = i + 1;
            while tok_kind(toks, fp) != 4 && !tok_is(src, toks, fp, "for") && !tok_is(src, toks, fp, "{") {
                fp = fp + 1;
            }
            pend_impl = fp + 1;
        }
        if tok_is(src, toks, i, "{") {
            depth = depth + 1;
            if pend_impl != 0 && impl_depth == 0 {
                impl_depth = depth;
                impl_recv = pend_impl;
                pend_impl = 0;
            }
        }
        if tok_is(src, toks, i, "}") {
            if impl_depth != 0 && depth == impl_depth {
                impl_depth = 0;
                impl_recv = 0;
            }
            if trait_depth != 0 && depth == trait_depth {
                trait_depth = 0;
            }
            if depth > 0 {
                depth = depth - 1;
            }
        }
        if tok_is(src, toks, i, "trait") {   // trait 声明块: 里面的 fn 只有签名
            let tb: u32 = i + 1;
            while tok_kind(toks, tb) != 4 && !tok_is(src, toks, tb, "{") {
                tb = tb + 1;
            }
            trait_depth = depth + 1;
        }
        if tok_is(src, toks, i, "fn") {
            // 容量守卫: 写穿这张表的下场是**静默改名**(fk 格被后面的表盖掉, fkind 变成 2),
            // 判据只会报"两个编译器不一致"。超了返回 0, 驱动器据此报错退出。
            if n >= CG_MAXFN {
                return 0;
            }
            let lp: u32 = find_paren(src, toks, i + 2);
            let rp: u32 = skip_parens(src, toks, lp);
            store32(s, CG_FN + n * 12, i + 1);
            store32(s, CG_FN + n * 12 + 4, fn_ret_tok(src, toks, rp));
            store32(s, CG_FN + n * 12 + 8, count_args(src, toks, lp));
            // 附加信息: 0=普通 1=trait 声明里的方法 2=impl 方法 (名字 <recv>_<方法>)
            store32(s, fk_base(n), 0);
            store32(s, fk_base(n) + 4, 0);
            // 外部函数 (docs/173): 第三种"只声明不发射"的类型。判**前一个 token** 是不是
            // `extern` —— 比挂一个粘性标志稳（`extern` 后面必须紧跟 `fn`, 看前一个 token 就
            // 精确等价, 也不会被后面的 `fn` 误吃）。
            if i > 0 && tok_is(src, toks, i - 1, "extern") {
                store32(s, fk_base(n), 3);
            } else if trait_depth != 0 && depth == trait_depth {
                store32(s, fk_base(n), 1);
            } else if impl_depth != 0 && depth == impl_depth {
                store32(s, fk_base(n), 2);
                store32(s, fk_base(n) + 4, impl_recv);
            }
            // 形参类型表: 调用点按形参类型强制实参 (与 lomentc 的 expr(a, p.type) 同义)。
            // 步长 160 (= **20 个槽**) —— `#265`: 原先 10 槽, 第 11 个形参写进下一条记录,
            // 于是 11 个形参的函数编出来的产物在运行期 SIGILL。20 是量出来的: 调用点那一侧
            // 的实参类型槽 (`720 + (层 + i) * 4`) 到 8192 还有很大余量, 而这个表在
            // `CG_PARAM` 之后到 `CG_SAFE` 之间自成一段, 加宽只多吃 brk 上的用户态内存
            // (`cg_arena_bytes()` 会跟着报大), 不碰语言自带的 64 KiB 堆。
            let pi: u32 = lp + 1;
            let pk: u32 = 0;
            while pi < rp && pk < 20 {
                store32(s, CG_PARAM + n * 160 + pk * 8, pi);
                store32(s, CG_PARAM + n * 160 + pk * 8 + 4, pi + 2);
                if load32(s, fk_base(n)) == 2 && pk == 0 {   // impl 的 self: 类型 = 接收者类型
                    store32(s, CG_PARAM + n * 160 + pk * 8 + 4, load32(s, fk_base(n) + 4));
                }
                pk = pk + 1;
                pi = skip_type(src, toks, pi + 2);
                if tok_is(src, toks, pi, ",") {
                    pi = pi + 1;
                }
            }
            n = n + 1;
        }
        i = i + 1;
    }
    store32(s, 640, n);
    // 常量表（`#719`）：一趟扫完，`find_const` 别再扫全单元。
    let kn: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "const") && tok_kind(toks, i + 1) == 0
                && tok_is(src, toks, i + 2, ":") {
            if kn >= CG_MAXCONST {
                return 0;            // 与函数表同一个口径：超了**报错**，不写穿
            }
            store32(s, CG_CONST + kn * 8, i + 1);
            store32(s, CG_CONST + kn * 8 + 4, i + 3);
            kn = kn + 1;
        }
        i = i + 1;
    }
    store32(s, 644, kn);
    // **跨函数 deref-only 安全表**（`docs/210` §7）：函数表登记完就能算 —— 它只读 token 流。
    // 放在这里（不是发射前逐个）：`l0_safe_callee` 在发射**每个** `alloc` 候选时都要查它。
    let _sft: u32 = compute_safe(src, toks, ptr_add(s, CG_SAFE));
    // struct 表: name_tok | nfields | 8 × (field_tok, type_tok) —— 字段仅标量类型
    let sn: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "struct") && sn < 64 {
            store32(s, struct_base(sn), i + 1);
            let sbrace: u32 = i + 2;
            while tok_kind(toks, sbrace) != 4 && !tok_is(src, toks, sbrace, "{") {
                sbrace = sbrace + 1;   // 跳过 `struct Pair<T>` 的 `<T>`
            }
            let fld: u32 = sbrace + 1;
            let nf: u32 = 0;
            while !tok_is(src, toks, fld, "}") && tok_kind(toks, fld) != 4 && nf < 8 {
                store32(s, struct_base(sn) + 8 + nf * 8, fld);
                store32(s, struct_base(sn) + 8 + nf * 8 + 4, fld + 2);
                nf = nf + 1;
                // 步长按**类型自己有多长**算（`skip_type`）：`&T` / `[T; N]` / `Pair<u32>`
                // 都不是一个 token。原来写死 `fld + 3`，字段写成 `data: &u32,` 时
                // 会落在 `u32` 上，把它当成下一个字段名（`docs/299` 落地时撞到）。
                // `#11`：**末字段可以没有尾逗号** —— 没有逗号时 `skip_type` 停在 `}`，
                // 循环条件当场结束（不会越过 `}` 读成字段）。
                let fend: u32 = skip_type(src, toks, fld + 2);
                if tok_is(src, toks, fend, ",") {
                    fld = fend + 1;
                } else {
                    fld = fend;
                }
            }
            store32(s, struct_base(sn) + 4, nf);
            store32(s, struct_base(sn) + 72, 0);   // 类型形参 (声明处) <T> / <T, U>
            store32(s, struct_base(sn) + 76, 0);
            if tok_is(src, toks, i + 2, "<") {
                store32(s, struct_base(sn) + 72, i + 3);
                if tok_is(src, toks, i + 4, ",") {
                    store32(s, struct_base(sn) + 76, i + 5);
                }
            }
            sn = sn + 1;
        }
        i = i + 1;
    }
    store32(s, 520, sn);
    // 能力域表: name_tok | space_tok | lo | hi | revocable | packed
    // packed = kind(4 位) | flags(2 位) | param(24 位)，见 docs/306 §2/§5。
    let cn: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "capability") && cn < 64 {
            store32(s, cap_base(cn), i + 1);
            store32(s, cap_base(cn) + 4, i + 3);
            let j: u32 = i + 5;
            let lof: u32 = 0;
            let lo: u32 = 0;
            if tok_is(src, toks, j, "(") {
                lof = 1;
                j = j + 2;
            } else {
                lo = tok_int(src, toks, j);
                j = j + 1;
            }
            j = j + 2;                                // '..'
            let hif: u32 = 0;
            let hi: u32 = 0;
            if tok_is(src, toks, j, "(") {
                hif = 1;
                j = j + 2;
            } else {
                hi = tok_int(src, toks, j);
                j = j + 1;
            }
            j = j + 1;                                // ']'
            store32(s, cap_base(cn) + 8, lo);
            store32(s, cap_base(cn) + 12, hi);
            let kind: u32 = 0;
            let param: u32 = 0;
            if tok_is(src, toks, j, "danger") || tok_is(src, toks, j, "adaptive")
                    || tok_is(src, toks, j, "flow") || tok_is(src, toks, j, "revision") {
                if tok_is(src, toks, j, "danger") { kind = 1; }
                if tok_is(src, toks, j, "adaptive") { kind = 10; }
                if tok_is(src, toks, j, "flow") { kind = 13; }
                if tok_is(src, toks, j, "revision") { kind = 15; }
                j = j + 1;
            } else if tok_is(src, toks, j, "epoch") || tok_is(src, toks, j, "far")
                    || tok_is(src, toks, j, "sliding") || tok_is(src, toks, j, "decaying")
                    || tok_is(src, toks, j, "growing") || tok_is(src, toks, j, "consumed")
                    || tok_is(src, toks, j, "cyclic") || tok_is(src, toks, j, "generational")
                    || tok_is(src, toks, j, "subject") || tok_is(src, toks, j, "witnessed")
                    || tok_is(src, toks, j, "reachable") {
                if tok_is(src, toks, j, "epoch") { kind = 2; }
                if tok_is(src, toks, j, "far") { kind = 3; }
                if tok_is(src, toks, j, "sliding") { kind = 4; }
                if tok_is(src, toks, j, "decaying") { kind = 5; }
                if tok_is(src, toks, j, "growing") { kind = 6; }
                if tok_is(src, toks, j, "consumed") { kind = 7; }
                if tok_is(src, toks, j, "cyclic") { kind = 8; }
                if tok_is(src, toks, j, "generational") { kind = 9; }
                if tok_is(src, toks, j, "subject") { kind = 11; }
                if tok_is(src, toks, j, "witnessed") { kind = 12; }
                if tok_is(src, toks, j, "reachable") { kind = 14; }
                param = tok_int(src, toks, j + 2);
                j = j + 4;                            // LAW ( N )
            }
            store32(s, cap_base(cn) + 16, 0);
            if tok_is(src, toks, j, "revocable") {
                store32(s, cap_base(cn) + 16, 1);
            }
            store32(s, cap_base(cn) + 20, kind | ((lof | (hif << 1)) << 4) | (param << 8));
            cn = cn + 1;
        }
        i = i + 1;
    }
    store32(s, 536, cn);
    // 联动 / 体的表按**函数**清零并重扫（见 `emit_fn`）—— 跨函数的伙伴会引用悬空槽。
    store32(s, CG_CPN, 0);
    store32(s, CG_ALN, 0);
    store32(s, CG_DOM_ID, cn);   // docs/314：块级域的审计槽号接在能力之后
    // 枚举表: name_tok | nvariants | has_payload | pad | 8 × (variant_tok, payload_tok)
    let en: u32 = 0;
    i = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "enum") {
            // 原先守卫是 `en < 64`, 而枚举表只有 19 格 —— 20..64 会**写进后面的局部表**。
            // 现在表是 CG_MAXENUM 格, 守卫与表同源, 超了返回 0。
            if en >= CG_MAXENUM {
                return 0;
            }
            store32(s, enum_base(en), i + 1);
            let ebrace: u32 = i + 2;
            while tok_kind(toks, ebrace) != 4 && !tok_is(src, toks, ebrace, "{") {
                ebrace = ebrace + 1;   // 跳过 `enum Opt<T>` 的 `<T>`
            }
            let vt: u32 = ebrace + 1;
            let nv: u32 = 0;
            let hasp: u32 = 0;
            while !tok_is(src, toks, vt, "}") && tok_kind(toks, vt) != 4 && nv < 8 {
                store32(s, enum_base(en) + 16 + nv * 8, vt);
                store32(s, enum_base(en) + 16 + nv * 8 + 4, 0);
                let nxt: u32 = vt + 2;
                if tok_is(src, toks, vt + 1, "(") {
                    store32(s, enum_base(en) + 16 + nv * 8 + 4, vt + 2);
                    hasp = 1;
                    nxt = vt + 4;
                }
                if tok_is(src, toks, nxt, ",") {
                    nxt = nxt + 1;
                }
                vt = nxt;
                nv = nv + 1;
            }
            store32(s, enum_base(en) + 4, nv);
            store32(s, enum_base(en) + 8, hasp);
            store32(s, enum_base(en) + 72, 0);
            store32(s, enum_base(en) + 76, 0);
            if tok_is(src, toks, i + 2, "<") {
                store32(s, enum_base(en) + 72, i + 3);
                if tok_is(src, toks, i + 4, ",") {
                    store32(s, enum_base(en) + 76, i + 5);
                }
            }
            en = en + 1;
        }
        i = i + 1;
    }
    store32(s, 540, en);
    emit_str(s, out, "; 由 tools/lomentc.py 生成 (native: LLVM IR, docs/144/145)\n");
    emit_str(s, out, "; clang -O1 driver.c this.ll -o exe\n");
    // `choose hosted`（`docs/222` §4.4）：构建那一侧要知道这份产物是**对外**的 ——
    // 它决定链接交给谁（C 工具链还是自举 lomelf）。**只有 hosted 才多发这一行** ——
    // sealed 是默认档，于是现存每一份单元的 IR 一个字节都不变。
    // 认法是 `contains_ident`（同 `guard` 那条）：`hosted` 这个 ident 只可能出现在
    // `choose hosted` 的值位置，别处写它就是一个未定义名字、检查器早就拒了。
    if contains_ident(src, toks, "hosted") == 1 {
        emit_str(s, out, "; loment-port: hosted\n");
    }
    // `choose no_std`（`#941` / #539）：产物**自己声明**"只用核那一层"。与上面那行
    // 同一条认法；链接器核它没把宿主层拉进来（`; loment-port: hosted`）。
    if contains_ident(src, toks, "no_std") == 1 {
        emit_str(s, out, "; loment-mode: no_std\n");
    }
    // `choose no_gc`（`#538`）：产物**自己声明**"我不带收集器"。与上面那行同一条认法
    // （`contains_ident`：`no_gc` 只可能是核心模式的取值，别处写它早就是未定义名字）。
    // 链接器据此核 IR 里真的没有 `@__loment_collect` / `@__loment_roots`。
    if contains_ident(src, toks, "no_gc") == 1 {
        emit_str(s, out, "; loment-gc: no_gc\n");
    }
    emit_str(s, out, "\n");
    if load32(s, 512) == 1 {
        emit_runtime(s, out);
        // `print_num` 的实现**单独发**（`docs/296` §2.7）：那句 x86 的 `syscall` asm
        // 不能进目标无关的运行期块（aarch64 交叉编译会当非法汇编拒掉）。
        if uses_print_num(s, src, toks) == 1 {
            emit_print_num(s, out);
        }
    }
    if guard_rt_needed(s, src, toks) == 1 {   // docs/306-308: 十种域的判决点
        emit_guard_runtime(s, out);
    }
    if guard_rt_needed(s, src, toks) == 1 {   // P4/M38 / docs/314：审计计数全局
        // 槽数 = 顶层能力 + 块级域（与参考实现的 max(16, slots) 同一口径）
        let nd: u32 = 0;
        let ti: u32 = 0;
        while tok_kind(toks, ti) != 4 {
            // 只数**块**：`domain:for` 不占审计槽（它的判决落在外面那个域上，`docs/315`）。
            if tok_is(src, toks, ti, "domain") && is_dom_block(src, toks, ti) == 1 {
                nd = nd + 1;
            }
            ti = ti + 1;
        }
        let slots: u32 = load32(s, 536) + nd;
        if slots < 16 {
            slots = 16;
        }
        emit_str(s, out, "@__loment_audit = internal global [");
        emit_dec(s, out, slots);
        emit_str(s, out, " x i64] zeroinitializer\n\n");
    }
    if load32(s, 536) != 0 {   // P4/M35: 域描述表 (space 取 FNV-1a 32 位)
        emit_caps_table(s, out, src, toks);
        emit_str(s, out, "\n");
    }
    // **`hosted` 的堆从宿主来**（`docs/228` 的 A = `docs/219` §8b 的 **S1e**）。
    // 闸门与上面那行 `; loment-port: hosted` **同一个认法**（`contains_ident`），
    // 所以两侧说的一定是同一件事。**收集器那一档也在这支里**（`docs/230`，= B1）：
    // 标记表的行数就是 arena/8，所以换 arena 必须同时换表（见下面 `emit_gc_hosted`）。
    // `gc_auto_alpha` 不用管 —— `hosted` 与它定义上冲突，走不到这儿。
    //
    // **`extern fn` 那一支**（`docs/219` §8b 的 **S2**，2026-10-15）：声明了外部函数
    // （槽 544）而**不是** `hosted` 的单元，arena 换成**产物里那块静态的、给够 1 MiB 的**
    // 那一版（`emit_heap_ffi`）。真 C 库要 256–512 KiB，64 KiB 装不下。
    // **`gc_auto_alpha` 除外，而且是明写的边界**：那一档的收集器（`emit_gc`）是**直接寻址**
    // arena 的，换 arena 就得连它一起换、再抄一份那段文本；`hosted` 与 alpha 定义上冲突，
    // 仓库里没有"间接寻址的 alpha"这份先例。所以这一档留在 64 KiB —— 与改之前逐字节相同，
    // 并且**说出来**（`; loment-heap: static 65536`，"不静默"）。
    // 与参考实现 `_ffi_heap` / `_ffi_grown` 同一条规则。
    // **LMS 第 3 级入口 A**（`docs/253` §5.3）：两个条件缺一不可 —— `lms` 开着
    // **且** 这份产物里有收集器（`gc_any`，或 `lgc` —— manual 档也有收集器了，窗口里
    // 那句"开"就是它被允许收的时刻）。三支共用同一个判断，见 `lms_mask`。
    let lms_rescue: u32 = 0;
    if load32(s, 588) & 4 != 0 && (gc_any(s) == 1 || load32(s, CG_LGC) == 1) {
        lms_rescue = 1;
    }
    let indirect: u32 = 0;
    if load32(s, 516) == 1 {
        if contains_ident(src, toks, "hosted") == 1 {
            emit_str(s, out, "; loment-heap: platform 1048576\n");
            if extern_named(s, src, toks, "malloc") == 0 {
                emit_str(s, out, "declare ptr @malloc(i64)\n");
            }
            emit_heap_indirect(s, out, 0, lms_rescue, load32(s, CG_LGC));
            indirect = 1;
        } else if load32(s, 544) == 1 && load32(s, 572) != 1 {
            emit_str(s, out, "; loment-heap: ffi 1048576\n");
            emit_heap_indirect(s, out, 1, lms_rescue, load32(s, CG_LGC));
            indirect = 1;
        } else {
            if load32(s, 544) == 1 {
                emit_str(s, out, "; loment-heap: static 65536\n");
            }
            emit_heap(s, out, lms_rescue, load32(s, CG_LGC));
        }
    }
    // **线程标志**（`#778`）：收集器读它、`thread_spawn` 置它。参考实现的门槛是
    // `_has_threads or ((gc_auto or gc_alpha or _gc_ctl) and heap)` —— 这里同一条
    // （次序 HEAP→THREADS→LOCK→ROOTS）。
    if load32(s, 556) == 1 || (gc_hook(s) == 1 && load32(s, 516) == 1) {
        emit_rt_threads(s, out);
    }
    // **运行期锁**：只有真起线程的产物才发（非线程程序的产物逐字节不变）。
    if load32(s, 556) == 1 {
        emit_rt_lock(s, out);
    }
    if gc_hook(s) == 1 {
        // **根表跟着 `gc_hook` 发**（与参考实现同形）—— 函数里的指针槽会往它写，定义必须在；
        // 而收集器**跟着堆发**（下面那一层 `516` 门）。次序 HEAP→ROOTS→GC。
        emit_roots(s, out);
        if load32(s, 516) == 1 {
            // 一份不用 `alloc` 的单元（alpha 把 alloc 全 L0 提走那种）**不该带收集器** ——
            // 它引用的是堆那几个全局，带上了就是引用未定义符号。
            // `hosted` 那一份收集器要认的是**同一块 arena**（`docs/230`），所以 arena 换了它也换。
            // FFI 那一档**共用同一份**（`indirect` 两条都算）：表是 arena/8 行，而两个 arena
            // 数相等（都是 1 MiB ⇒ 16384 行）—— 那两个数是绑在一起的，见参考实现那条 assert。
            if indirect == 1 {
                emit_gc_hosted(s, out);
            } else {
                emit_gc(s, out);
            }
        }
    }
    if load32(s, CG_LGC) == 1 {
        // **只在源里出现 `lgc` 时发**（`docs/309`）：没写的程序产物一个字节都不变。
        // 手工档初值 0（默认不收集），自动两档初值 1（`lgc end` 才是暂停）。
        emit_lgc_runtime(s, out);
    }
    // 外部函数的 `declare` (docs/173): 每个外部符号一条, 按名字去重, **放在函数体之前**。
    // 位置对着参考实现排: `emit_llvm` 把它们追加进 `globals_`, 而 `globals_` = [declares] +
    // 每函数的 globals (字符串常量就在那一堆里), 之后统一补一个空行。所以这里插在**字符串
    // globals 之前**, 空行只在"后面没有字符串 globals"时自己补 —— 有的话那个块已经补过了。
    let dx: u32 = 0;
    let nd: u32 = 0;
    while dx < load32(s, 640) {
        if load32(s, fk_base(dx)) == 3 {
            nd = nd + 1;
            emit_str(s, out, "declare ");
            emit_ty(s, out, src, toks, load32(s, CG_FN + dx * 12 + 4));
            emit_str(s, out, " @");
            emit_tok(s, out, src, toks, load32(s, CG_FN + dx * 12));
            emit_str(s, out, "(");
            let dk: u32 = 0;
            let dc: u32 = load32(s, CG_FN + dx * 12 + 8);
            while dk < dc && dk < 10 {
                if dk > 0 {
                    emit_str(s, out, ", ");
                }
                emit_ty(s, out, src, toks, load32(s, CG_PARAM + dx * 80 + dk * 8 + 4));
                dk = dk + 1;
            }
            emit_str(s, out, ")\n");
        }
        dx = dx + 1;
    }
    // **这里不再补空行**：版次元数据永远跟在后面（见下面 `emit_tur_meta`），所以
    // 全局区永远不以 declare 结尾 —— 空行只在整段全局之后补一次。
    if load32(s, 532) == 1 {
        emit_str_globals(s, out, src, toks);
    }
    // 命令入口的路径常量**紧跟字符串常量之后、那个空行之前** —— 参考实现里它落在
    // `globals_` 的末尾（字符串常量也是追加进 `globals_` 的），于是产物里是
    // `[字符串][它][空行][函数]`。
    //
    // **它不在"有没有字符串常量"那个分支里**：形态 A（`register` 块）的单元可以
    // **一个字符串字面量都没有**（形态 B 一定有 —— 名字本身就是那个字符串）。原先
    // 挂在那个分支下，于是这类单元的产物里 `_start` 引用了一个**没定义**的全局，
    // 而参考实现有 —— 实测：`loment_p8_test` 报 `register_hello.lomt` 少 117 字节。
    let has_cmd: u32 = cmd_entry_needed(src, toks);
    if has_cmd == 1 {
        emit_cmd_globals(s, out);
    }
    // 版次元数据**永远发**（`docs/296` §1.1），所以空行也永远有 —— 与参考实现
    // `out += globals_; if globals_: out.append("")` 同一个形状。
    emit_tur_meta(s, out, prof);
    emit_str(s, out, "\n");
    store32(s, 64, 0);       // 实例表: 按"首次被用到"的顺序追加
    store32(s, 60, 4294967295);   // 当前正在发射的实例 (NONE = 不是实例)
    i = 0;
    let fnix: u32 = 0;
    while tok_kind(toks, i) != 4 {
        if tok_is(src, toks, i, "fn") {
            if is_generic_fn(s, src, toks, fnix) == 1 {   // 泛型声明本身不发射 (只发实例)
                let gb: u32 = find_body(src, toks, find_paren(src, toks, i + 2));
                i = skip_block(src, toks, gb - 1);
            } else if load32(s, fk_base(fnix)) == 1 {   // trait 声明里的方法: 只有签名, 整条跳过
                let trp: u32 = skip_parens(src, toks, find_paren(src, toks, i + 2));
                let tq: u32 = trp + 1;
                while tok_kind(toks, tq) != 4 && !tok_is(src, toks, tq, ";") {
                    tq = tq + 1;
                }
                i = tq + 1;
            } else if load32(s, fk_base(fnix)) == 3 {   // 外部函数: 同样只有签名, 整条跳过
                let erp: u32 = skip_parens(src, toks, find_paren(src, toks, i + 2));
                let eq: u32 = erp + 1;
                while tok_kind(toks, eq) != 4 && !tok_is(src, toks, eq, ";") {
                    eq = eq + 1;
                }
                i = eq + 1;
            } else {
                store32(s, 4, 0);    // temp 计数随函数重置
                store32(s, 480, 0);  // label 计数随函数重置
                store32(s, 476, 0);  // terminated = false
                store32(s, 472, fnix);   // 当前函数表下标 (impl 方法取名用)
                i = emit_fn(s, out, src, toks, i);
            }
            fnix = fnix + 1;
        } else {
            i = i + 1;
        }
    }
    // 实例发射: 按发现序, 每个实例推入自己的类型实参替换, 再当作普通函数发射一遍
    let ie: u32 = 0;
    let ic: u32 = load32(s, 64);
    while ie < ic {
        let eb: u32 = 72 + ie * 12;
        let efn: u32 = load32(s, eb);
        let e1: u32 = load32(s, eb + 4);
        let e2t: u32 = load32(s, eb + 8);
        let esub: u32 = 0;
        let ep1: u32 = decl_tparam(src, toks, efn + 1, 0);
        if ep1 != 0 && e1 != 0 {
            sub_push(s, ep1, e1);
            esub = 1;
        }
        let ep2: u32 = decl_tparam(src, toks, efn + 1, 1);
        if ep2 != 0 && e2t != 0 {
            sub_push(s, ep2, e2t);
            esub = esub + 1;
        }
        store32(s, 4, 0);
        store32(s, 480, 0);
        store32(s, 476, 0);
        store32(s, 472, 0);
        store32(s, 60, ie);
        i = emit_fn(s, out, src, toks, efn);
        store32(s, 60, 4294967295);
        pop_subst(s, esub);
        ic = load32(s, 64);   // 实例体内可能又发现新实例
        ie = ie + 1;
    }
    // 命令入口（`docs/223`）：**所有函数之后**发 —— 参考实现把它追加在 `text_all` 末尾。
    if cmd_entry_needed(src, toks) == 1 {
        emit_cmd_entry(s, out);
    }
    // 发射器报过"降不下去"（`#775`）：整份输出作废。**与容量溢出同一个返回约定**
    // （0 = 失败），但驱动器先看 `emit_error_code` —— 那一条有位置、有规则消息，
    // 不该被"表装不下"那句兜底吃掉。
    if load32(s, CG_ERR) != 0 {
        return 0;
    }
    return st_o(s);
}
