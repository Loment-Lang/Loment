// world/phone.lomt — E.164 电话号码的归一化与格式
//
// 为什么现实世界需要它: 用户写 `+1 (202) 555-0147`、`+1-202-555-0147`、
// `+12025550147`，是同一个号。E.164 只规定"最多 15 位数字、可带一个前导 `+`"；
// 剩下的空格、括号、连字符都是给人看的。
//
// 约定:
//   * `tel_parse` 只保留 `+` 与数字，去掉空格 `-` `(` `)` `.` `/`；
//   * 数字位数必须 7..15（ITU 的实际取值范围），否则 TEL_ERR；
//   * `tel_pretty` 只对 `+1` 北美号码分组（`+1 AAA BBB CCCC`），其余原样。
//
// 不做的: 各国号码长度表、运营商识别、短号。
//
// 命名: 公开 tel_*, 内部 tlc_*。自检 test_phone_*。

module phone
choose runtime

pub const TEL_ERR: u32 = 4294967295;

fn tlc_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn tlc_skip(c: u32) -> bool {
    return c == 32 || c == 45 || c == 40 || c == 41 || c == 46 || c == 47 || c == 9;
}

/// 归一化。返回长度；非法/位数不对返回 TEL_ERR。
pub fn tel_parse(s: str, out: ptr, cap: u32) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let pos: u32 = 0;
    let digits: u32 = 0;
    let plus: u32 = 0;
    while i < n {
        let c: u32 = str_byte(s, i);
        if c == 43 { // '+'
            if i != 0 || plus == 1 {
                return TEL_ERR;
            }
            plus = 1;
            if pos < cap {
                store8(out, pos, 43 as u8);
            }
            pos = pos + 1;
        } else if tlc_digit(c) {
            if pos < cap {
                store8(out, pos, c as u8);
            }
            pos = pos + 1;
            digits = digits + 1;
        } else if !tlc_skip(c) {
            return TEL_ERR;
        }
        i = i + 1;
    }
    if digits < 7 || digits > 15 {
        return TEL_ERR;
    }
    return pos;
}

/// 是否已经是合法 E.164（`+` 开头、7..15 位数字）。
pub fn tel_is_e164(s: str) -> bool {
    let n: u32 = str_len(s);
    if n < 8 || n > 16 {
        return false;
    }
    if str_byte(s, 0) != 43 {
        return false;
    }
    let i: u32 = 1;
    while i < n {
        if !tlc_digit(str_byte(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn tlc_body_len(s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 1;
    let d: u32 = 0;
    while i < n {
        if !tlc_digit(str_byte(s, i)) {
            return 0;
        }
        d = d + 1;
        i = i + 1;
    }
    return d;
}

fn tlc_put(out: ptr, cap: u32, pos: u32, c: u32) -> u32 {
    if pos < cap {
        store8(out, pos, c as u8);
    }
    return pos + 1;
}

/// 人看的格式。北美号码分组，其余原样。返回完整长度。
pub fn tel_pretty(s: str, out: ptr, cap: u32) -> u32 {
    let n: u32 = str_len(s);
    let body: u32 = tlc_body_len(s);
    if body == 11 && n == 12 && str_byte(s, 0) == 43 && str_byte(s, 1) == 49 {
        let pos: u32 = 0;
        let i: u32 = 0;
        while i < 2 {
            pos = tlc_put(out, cap, pos, str_byte(s, i));
            i = i + 1;
        }
        pos = tlc_put(out, cap, pos, 32);
        i = 2;
        while i < 12 {
            if i == 5 || i == 8 {
                pos = tlc_put(out, cap, pos, 32);
            }
            pos = tlc_put(out, cap, pos, str_byte(s, i));
            i = i + 1;
        }
        return pos;
    }
    let p: u32 = 0;
    let k: u32 = 0;
    while k < n {
        p = tlc_put(out, cap, p, str_byte(s, k));
        k = k + 1;
    }
    return p;
}

// ---------------------------------------------------------------- 自检

fn test_phone_parse() -> bool {
    let o: ptr = alloc(32);
    let n: u32 = tel_parse("+1 (202) 555-0147", o, 32);
    let want: str = "+12025550147";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(o, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return tel_is_e164("+12025550147");
}

fn test_phone_pretty() -> bool {
    let o: ptr = alloc(32);
    let n: u32 = tel_pretty("+12025550147", o, 32);
    let want: str = "+1 202 555 0147";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(o, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
