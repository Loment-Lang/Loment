// loment/tools/lomrel.lomt — Loment 版发布清单生成器 (无 Python, docs/167 Stage 3)
//
// 判据 (tools/loment_rel_test.py): 与 `tools/loment_release.py` 的 stdout / 落盘字节 / 退出码
// **逐字节相同** (--emit [PATH] / --checksums PATH / --check / 无参数)。
//
// 本文件按**能编译的最小骨架起步**逐档长 (docs/167 记的教训: 盲写大段 = 镜像第一版的下场)。
// 第一档只做: 参数解析 + 读一个文件 + 写一个文件。

module lomrel
choose runtime

use bytes
use sha256

// ---------------------------------------------------------------- 内存
const M_ARGV: u32 = 0;             // 8192
const M_TMP: u32 = 8192;           // 8192 暂存 (十进制 / 路径)
const M_DENT: u32 = 16384;         // 131072 getdents 缓冲
const M_NAMES: u32 = 147456;       // 131072 本目录命中的名字 (1024 x 128)
const M_NOFF: u32 = 278528;        // 8192   名字长度 (2048 x 4)
const M_POFF: u32 = 286720;        // 8192   路径在池里的偏移 (2048 x 4)
const M_PATHS: u32 = 294912;       // 512 KiB 相对路径池
const M_IN: u32 = 819200;          // 4 MiB 输入 (种子 selfhost_driver.ll 有 1.63 MB)
const M_OUT: u32 = 5013504;        // 1 MiB 输出
const M_SHA: u32 = 6062592;        // 1024 sha 状态
const M_DIG: u32 = 6063616;        // 32 摘要
const M_HEX: u32 = 6063648;        // 64 hex
// ---- 2026-09-20: 归一化副本从 2 MiB 抬到 4 MiB（`docs/200` §5）
//
// 起因与 `lomelf` 那两处**同一个病**: 自举种子长过了这一格。原先这里只给 2 MiB，
// 而清单里**有比它大的工件**（种子本身）—— 越界就写进紧挨着的 `M_CUR`（已装载的清单），
// 于是症状是"从种子那一条起后面全对不上"，指不到现场。
// 抬法: `NORM_CAP` 跟 `IN_CAP` **同值**（读得进来的就得归一化得了），`M_CUR` /
// `ARENA` 依次后移。
const M_NORM: u32 = 6063744;       // 4 MiB 归一化副本
const M_CUR: u32 = 10258048;       // 1 MiB 现有 manifest
const ARENA: u64 = 11534336;

const NORM_CAP: u32 = 4194304;
const CUR_CAP: u32 = 1048576;

const C_POOL: u32 = 4080;          // M_TMP 里的池游标格

const DENT_CAP: u32 = 131072;
const POOL_CAP: u32 = 524288;

const IN_CAP: u32 = 4194304;
const OUT_CAP: u32 = 1048576;

// ---------------------------------------------------------------- 系统调用

fn die(code: u64) -> u32 {
    syscall4(60, code, 0, 0);
    return 0;
}

fn sys_alloc(n: u64) -> u64 {
    let cur: i64 = syscall4(12, 0, 0, 0);
    if cur <= 0 {
        return 0;
    }
    let got: i64 = syscall4(12, (cur as u64) + n, 0, 0);
    if got < 0 {
        return 0;
    }
    return cur as u64;
}

fn read_all(fd: u64, buf: ptr, cap: u64) -> u64 {
    let off: u64 = 0;
    while off < cap {
        let got: i64 = syscall4(0, fd, (buf as u64) + off, cap - off);
        if got <= 0 {
            return off;
        }
        off = off + (got as u64);
    }
    return off;
}

fn write_all(fd: u64, p: ptr, n: u64) -> u64 {
    let off: u64 = 0;
    while off < n {
        let w: i64 = syscall4(1, fd, (p as u64) + off, n - off);
        if w <= 0 {
            return off;
        }
        off = off + (w as u64);
    }
    return off;
}

fn wstr(fd: u64, s: str) -> u64 {
    return write_all(fd, str_ptr(s), str_len(s) as u64);
}

fn cstr(dst: ptr, s: str) -> ptr {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(str_ptr(s), i) as u8);
        i = i + 1;
    }
    store8(dst, n, 0 as u8);
    return dst;
}

fn open_ro(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 0);
}

fn open_wo(path: ptr) -> i64 {
    return syscall6(257, (0 as u64) - 100, path as u64, 577, 420, 0);
}

fn open_dir(path: ptr) -> i64 {
    return syscall4(257, (0 as u64) - 100, path as u64, 65536);
}

fn close_fd(fd: i64) {
    syscall4(3, fd as u64, 0, 0);
}

/// 第 n 个 argv (0 = 程序名) 的 (起点 << 32) | 长度。
fn argv_n(buf: ptr, cap: u64, n: u32) -> u64 {
    let fd: i64 = syscall4(257, (0 as u64) - 100,
                           cstr(ptr_add(buf, 4096), "/proc/self/cmdline") as u64, 0);
    if fd < 0 {
        return 0;
    }
    let rn: i64 = syscall4(0, fd as u64, buf as u64, cap);
    syscall4(3, fd as u64, 0, 0);
    if rn <= 0 {
        return 0;
    }
    let m: u32 = rn as u32;
    let i: u32 = 0;
    let f: u32 = 0;
    let s: u32 = 0;
    let hit: u64 = 0;
    while i < m {
        if load8(buf, i) == 0 {
            if f == n {
                hit = (s as u64) * 4294967296 + ((i - s) as u64);
            }
            f = f + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    if f == n {
        hit = (s as u64) * 4294967296 + ((m - s) as u64);
    }
    return hit;
}

fn hi32(v: u64) -> u32 {
    return (v / 4294967296) as u32;
}

fn lo32(v: u64) -> u32 {
    return (v % 4294967296) as u32;
}


