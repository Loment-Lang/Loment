    if k == 182 { return "This is the one beginners hit most, and in Loment it is almost always the same thing: **there is no type inference** - `let x = 1;` is a syntax error and you must write `let x: u32 = 1;`. Next comes defining after use inside one module, and then a cross-module name that needs `pub` on the declaration and `use` at the call site."; }
