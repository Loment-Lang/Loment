  getresgid         = 120  { surface = "proc" }
  getpgid           = 121  { surface = "proc" }
  setfsuid          = 122  { surface = "proc" }
  setfsgid          = 123  { surface = "proc" }
  getsid            = 124  { surface = "proc" }
  utime             = 132  { surface = "file" }
  mknod             = 133  { surface = "file" }
  sync              = 162  { surface = "file" }
  gettid            = 186  { surface = "proc" }
  futex             = 202  { surface = "proc" }
  sched_setaffinity = 203  { surface = "proc" }
  sched_getaffinity = 204  { surface = "proc" }
  epoll_create      = 213  { surface = "net" }
  set_tid_address   = 218  { surface = "proc" }
  fadvise64         = 221  { surface = "file" }
  clock_getres      = 229  { surface = "proc" }
  clock_nanosleep   = 230  { surface = "proc" }
  exit_group        = 231  { surface = "proc" }
  utimes            = 235  { surface = "file" }
  ioprio_set        = 251  { surface = "proc" }
  ioprio_get        = 252  { surface = "proc" }
  mkdirat           = 258  { surface = "file" }
  mknodat           = 259  { surface = "file" }
  fchownat          = 260  { surface = "file" }
  futimesat         = 261  { surface = "file" }
  unlinkat          = 263  { surface = "file" }
  renameat          = 264  { surface = "file" }
  linkat            = 265  { surface = "file" }
  symlinkat         = 266  { surface = "file" }
  readlinkat        = 267  { surface = "file" }
  fchmodat          = 268  { surface = "file" }
  faccessat         = 269  { surface = "file" }
  pselect6          = 270  { surface = "net" }
  ppoll             = 271  { surface = "net" }
  sync_file_range   = 277  { surface = "file" }
