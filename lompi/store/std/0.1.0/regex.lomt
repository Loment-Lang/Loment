// std/regex.lomt — 正则表达式（POSIX ERE 的公共子集，回溯实现）
//
// 为什么要有它: `glob` 只会 `* ? [...]`，`search` 只会"找一段字面量"。而"取出日志里
// 的时间戳""校验一个标识符""按模式切字段"这类事每天都在发生，没有正则就只能手写
// 状态机 —— 每写一次就错一次。
//
// **支持的语法**（ERE 的公共子集，足够覆盖日常）:
//   `.`            任意字节（换行除外）
//   `^` `$`        串首 / 串尾（零宽；**不做多行模式**）
//   `[...]`        字符类，`^` 取反，`a-z` 范围，`]` 放第一位是字面量
//   `(...)`        分组（只分组，**不捕获** —— 见下）
//   `|`            或
//   `*` `+` `?`    重复（贪婪）
//   `{m}` `{m,}` `{m,n}`
//   `\d \D \w \W \s \S`  数字 / 词字符 / 空白 及其补集
//   `\n \r \t \f \v` 与 `\\ \. \* \+ \? \( \) \[ \] \{ \} \| \^ \$`  转义
//
// 不做的（如实列）:
//   * **不捕获**（没有 `$1`）：分组只用于优先级与重复。捕获要"把每次分组的位置记下来"，
//     而回溯会重写它们 —— 那是另一个数据结构（`caps` 栈），不是几行。
//   * 不做 `*?` / `+?` 非贪婪、后行断言、反向引用 —— ERE 本来也没有前两个。
//   * 不解析 UTF-8：这是**字节**正则（与 `search` / `glob` 同一层）。多字节字符按
//     字节匹配，`. ` 匹配一个字节。
//   * `^`/`$` 只认**整串**首尾，不认行首行尾（没有 multiline 开关）。
//
// 复杂度与护栏: 回溯引擎在最坏情况下是指数的。每次原子匹配都会从 `ctx` 里的**步数
// 预算**扣 1；预算用完就按"没匹配上"返回。默认预算 100 万步，重复次数上限 1024。
//
// 命名: 公开 re_*, 内部 rx_*。自检 test_regex_*。

module regex

use "mem.lomt"

/// 没有匹配（`const` 只吃字面量，所以用函数表达 -1）。
pub fn re_no() -> i64 {
    return 0 as i64 - 1;
}
/// 重复次数上限（防止 `a*` 配长串把栈/时间吃光）。
pub const RX_MAX_REP: u32 = 1024;
/// 默认步数预算。
pub const RX_BUDGET: u32 = 1000000;

const RX_BUD: u32 = 0;   // ctx[0] = 剩余步数
const RX_POS: u32 = 8;   // ctx[8..] = 重复匹配的位置表 (u32 * RX_MAX_REP)

/// `ctx` 至少要这么多字节。
pub fn re_ctx_bytes() -> u32 {
    return RX_POS + (RX_MAX_REP + 1) * 4;
}

fn rx_reset(ctx: ptr) {
    mem_store32(ctx, RX_BUD, RX_BUDGET);
}

fn rx_tick(ctx: ptr) -> bool {
    let b: u32 = mem_load32(ctx, RX_BUD);
    if b == 0 {
        return false;
    }
    mem_store32(ctx, RX_BUD, b - 1);
    return true;
}

fn rx_is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn rx_is_word(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn rx_is_space(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 12 || c == 11;
}

fn rx_is_class_escape(e: u32) -> bool {
    return e == 100 || e == 68 || e == 119 || e == 87 || e == 115 || e == 83;
}

/// 类转义 `\d \D \w \W \s \S` 对字节 `c` 的结论（调用方先确认是类转义）。
fn rx_class_match(e: u32, c: u32) -> bool {
    if e == 100 { return rx_is_digit(c); }   // \d
    if e == 68 { return !rx_is_digit(c); }   // \D
    if e == 119 { return rx_is_word(c); }    // \w
    if e == 87 { return !rx_is_word(c); }    // \W
    if e == 115 { return rx_is_space(c); }   // \s
    return !rx_is_space(c);                  // \S
}

/// 转义字符 -> 字面量字节；不是"字面量转义"返回 256。
fn rx_escape_literal(e: u32) -> u32 {
    if e == 110 { return 10; }  // \n
    if e == 114 { return 13; }  // \r
    if e == 116 { return 9; }   // \t
    if e == 102 { return 12; }  // \f
    if e == 118 { return 11; }  // \v
    return e;
}

// ---------------------------------------------------------------- 字符类

/// `[` 之后到 `]` 之前（`cs..ce`）是否匹配字节 `c`。
fn rx_class_ok(p: str, cs: u32, ce: u32, c: u32) -> bool {
    let i: u32 = cs;
    let neg: u32 = 0;
    if i < ce && str_byte(p, i) == 94 { // '^'
        neg = 1;
        i = i + 1;
    }
    let hit: u32 = 0;
    // 开头的 `]` 是字面量。
    let first: u32 = 1;
    while i < ce {
        let a: u32 = str_byte(p, i);
        if first == 1 && a == 93 { // ']'
            if c == 93 {
                hit = 1;
            }
            i = i + 1;
            first = 0;
        } else if a == 92 && i + 1 < ce {
            let e: u32 = str_byte(p, i + 1);
            if rx_is_class_escape(e) {
                if rx_class_match(e, c) {
                    hit = 1;
                }
                i = i + 2;
            } else {
                let lit: u32 = rx_escape_literal(e);
                if lit == c {
                    hit = 1;
                }
                i = i + 2;
            }
            first = 0;
        } else if i + 2 < ce && str_byte(p, i + 1) == 45 { // '-' 且后面还有字符
            let hi: u32 = str_byte(p, i + 2);
            if c >= a && c <= hi {
                hit = 1;
            }
            i = i + 3;
            first = 0;
        } else {
            if a == c {
                hit = 1;
            }
            i = i + 1;
            first = 0;
        }
    }
    if neg == 1 {
        return hit == 0;
    }
    return hit != 0;
}

/// 从 `[` 找到配对的 `]`（返回 `]` 的下标）。找不到返回 `RX_ERR_INDEX`。
const RX_ERR_INDEX: u32 = 4294967295;

fn rx_class_end(p: str, ps: u32, pe: u32) -> u32 {
    let i: u32 = ps + 1;
    if i < pe && str_byte(p, i) == 94 { // '^'
        i = i + 1;
    }
    // 开头的 `]` 是字面量，不能当结束。
    if i < pe && str_byte(p, i) == 93 {
        i = i + 1;
    }
    while i < pe {
        let c: u32 = str_byte(p, i);
        if c == 92 && i + 1 < pe {
            i = i + 2;
        } else if c == 93 {
            return i;
        } else {
            i = i + 1;
        }
    }
    return RX_ERR_INDEX;
}

/// 从 `(` 找到配对的 `)`（跳过嵌套、转义、字符类）。
fn rx_group_end(p: str, ps: u32, pe: u32) -> u32 {
    let depth: u32 = 1;
    let i: u32 = ps + 1;
    while i < pe {
        let c: u32 = str_byte(p, i);
        if c == 92 && i + 1 < pe {
            i = i + 2;
        } else if c == 91 { // '['
            let ce: u32 = rx_class_end(p, i, pe);
            if ce == RX_ERR_INDEX {
                return RX_ERR_INDEX;
            }
            i = ce + 1;
        } else if c == 40 { // '('
            depth = depth + 1;
            i = i + 1;
        } else if c == 41 { // ')'
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return RX_ERR_INDEX;
}

/// 从 `ps` 起找顶层的 `|`（跳过括号、转义、字符类）。
fn rx_alt_at(p: str, ps: u32, pe: u32) -> u32 {
    let depth: u32 = 0;
    let i: u32 = ps;
    while i < pe {
        let c: u32 = str_byte(p, i);
        if c == 92 && i + 1 < pe {
            i = i + 2;
        } else if c == 91 {
            let ce: u32 = rx_class_end(p, i, pe);
            if ce == RX_ERR_INDEX {
                return RX_ERR_INDEX;
            }
            i = ce + 1;
        } else if c == 40 {
            depth = depth + 1;
            i = i + 1;
        } else if c == 41 {
            if depth > 0 {
                depth = depth - 1;
            }
            i = i + 1;
        } else if c == 124 && depth == 0 { // '|'
            return i;
        } else {
            i = i + 1;
        }
    }
    return RX_ERR_INDEX;
}

// ---------------------------------------------------------------- 匹配

/// 一个原子的结束下标（不含）。
fn rx_atom_end(p: str, ps: u32, pe: u32) -> u32 {
    if ps >= pe {
        return RX_ERR_INDEX;
    }
    let c: u32 = str_byte(p, ps);
    if c == 40 { // '('
        let ge: u32 = rx_group_end(p, ps, pe);
        if ge == RX_ERR_INDEX {
            return RX_ERR_INDEX;
        }
        return ge + 1;
    }
    if c == 91 { // '['
        let ce: u32 = rx_class_end(p, ps, pe);
        if ce == RX_ERR_INDEX {
            return RX_ERR_INDEX;
        }
        return ce + 1;
    }
    if c == 92 { // '\\'
        if ps + 1 >= pe {
            return RX_ERR_INDEX;
        }
        return ps + 2;
    }
    return ps + 1;
}

/// 量词。返回 `[next:32][max:16][min:16]`；没有量词时 next == qs、min=max=1。
fn rx_quant(p: str, qs: u32, pe: u32) -> u64 {
    if qs >= pe {
        return ((qs as u64) << 32) | (1 as u64) | ((1 as u64) << 16);
    }
    let c: u32 = str_byte(p, qs);
    if c == 42 { // '*'
        return (((qs + 1) as u64) << 32) | ((65535 as u64) << 16);
    }
    if c == 43 { // '+'
        return (((qs + 1) as u64) << 32) | ((65535 as u64) << 16) | 1;
    }
    if c == 63 { // '?'
        return (((qs + 1) as u64) << 32) | ((1 as u64) << 16);
    }
    if c == 123 { // '{'
        // 解析 {m} / {m,} / {m,n}；畸形就当它是字面量（不是量词）。
        let i: u32 = qs + 1;
        let mn: u32 = 0;
        let nd: u32 = 0;
        while i < pe && rx_is_digit(str_byte(p, i)) {
            mn = mn * 10 + (str_byte(p, i) - 48);
            nd = nd + 1;
            i = i + 1;
        }
        if nd == 0 {
            return ((qs as u64) << 32) | (1 as u64) | ((1 as u64) << 16);
        }
        let mx: u32 = mn;
        if i < pe && str_byte(p, i) == 44 { // ','
            i = i + 1;
            if i < pe && str_byte(p, i) == 125 { // '}'
                mx = 65535;
            } else {
                mx = 0;
                let nd2: u32 = 0;
                while i < pe && rx_is_digit(str_byte(p, i)) {
                    mx = mx * 10 + (str_byte(p, i) - 48);
                    nd2 = nd2 + 1;
                    i = i + 1;
                }
                if nd2 == 0 {
                    return ((qs as u64) << 32) | (1 as u64) | ((1 as u64) << 16);
                }
            }
        }
        if i >= pe || str_byte(p, i) != 125 { // '}'
            return ((qs as u64) << 32) | (1 as u64) | ((1 as u64) << 16);
        }
        if mx < mn {
            return ((qs as u64) << 32) | (1 as u64) | ((1 as u64) << 16);
        }
        if mx > 65535 {
            mx = 65535;
        }
        return (((i + 1) as u64) << 32) | ((mx as u64) << 16) | (mn as u64);
    }
    return ((qs as u64) << 32) | (1 as u64) | ((1 as u64) << 16);
}

/// 匹配**一次**原子（`as_..ae` 是原子的范围）。
fn rx_atom(p: str, as_: u32, ae: u32, s: str, sn: u32, si: u32, ctx: ptr) -> i64 {
    if !rx_tick(ctx) {
        return re_no();
    }
    let c: u32 = str_byte(p, as_);
    if c == 40 { // '('
        let ge: u32 = rx_group_end(p, as_, ae);
        if ge == RX_ERR_INDEX {
            return re_no();
        }
        return rx_alt(p, as_ + 1, ge, s, sn, si, ctx);
    }
    if c == 46 { // '.'
        if si >= sn {
            return re_no();
        }
        if load8(str_ptr(s), si) == 10 {
            return re_no();
        }
        return (si + 1) as i64;
    }
    if c == 94 { // '^'
        if si == 0 {
            return si as i64;
        }
        return re_no();
    }
    if c == 36 { // '$'
        if si == sn {
            return si as i64;
        }
        return re_no();
    }
    if c == 91 { // '['
        let ce: u32 = rx_class_end(p, as_, ae);
        if ce == RX_ERR_INDEX || si >= sn {
            return re_no();
        }
        let b: u32 = load8(str_ptr(s), si);
        if rx_class_ok(p, as_ + 1, ce, b) {
            return (si + 1) as i64;
        }
        return re_no();
    }
    if c == 92 { // '\\'
        if as_ + 1 >= ae {
            return re_no();
        }
        let e: u32 = str_byte(p, as_ + 1);
        if rx_is_class_escape(e) {
            if si >= sn {
                return re_no();
            }
            let b: u32 = load8(str_ptr(s), si);
            if rx_class_match(e, b) {
                return (si + 1) as i64;
            }
            return re_no();
        }
        let lit: u32 = rx_escape_literal(e);
        if si < sn && load8(str_ptr(s), si) == lit {
            return (si + 1) as i64;
        }
        return re_no();
    }
    // 字面量
    if si < sn && load8(str_ptr(s), si) == c {
        return (si + 1) as i64;
    }
    return re_no();
}

fn rx_rep(p: str, as_: u32, ae: u32, rest: u32, pe: u32, s: str, sn: u32, si: u32,
          min: u32, max: u32, ctx: ptr) -> i64 {
    let mx: u32 = max;
    if mx > RX_MAX_REP {
        mx = RX_MAX_REP;
    }
    mem_store32(ctx, RX_POS, si);
    let count: u32 = 0;
    let cur: u32 = si;
    let going: u32 = 1;
    while going == 1 && count < mx {
        let ni: i64 = rx_atom(p, as_, ae, s, sn, cur, ctx);
        if ni < 0 {
            going = 0;
        } else {
            let n2: u32 = ni as u32;
            if n2 == cur {
                going = 0; // 零宽原子：别无限重复
            } else {
                count = count + 1;
                mem_store32(ctx, RX_POS + count * 4, n2);
                cur = n2;
            }
        }
    }
    // 贪婪：从最多往回试。
    let c: u32 = count;
    let scanning: u32 = 1;
    while scanning == 1 {
        if c >= min {
            let st: u32 = mem_load32(ctx, RX_POS + c * 4);
            let r: i64 = rx_seq(p, rest, pe, s, sn, st, ctx);
            if r >= 0 {
                return r;
            }
        }
        if c == 0 {
            scanning = 0;
        } else {
            c = c - 1;
        }
    }
    return re_no();
}

fn rx_seq(p: str, ps: u32, pe: u32, s: str, sn: u32, si: u32, ctx: ptr) -> i64 {
    if ps >= pe {
        return si as i64;
    }
    let ae: u32 = rx_atom_end(p, ps, pe);
    if ae == RX_ERR_INDEX || ae > pe {
        return re_no();
    }
    let q: u64 = rx_quant(p, ae, pe);
    let next: u32 = (q >> 32) as u32;
    let mx: u32 = ((q >> 16) & 65535) as u32;
    let mn: u32 = (q & 65535) as u32;
    if next == ae {
        let ni: i64 = rx_atom(p, ps, ae, s, sn, si, ctx);
        if ni < 0 {
            return re_no();
        }
        return rx_seq(p, ae, pe, s, sn, ni as u32, ctx);
    }
    let maxv: u32 = mx;
    return rx_rep(p, ps, ae, next, pe, s, sn, si, mn, maxv, ctx);
}

fn rx_alt(p: str, ps: u32, pe: u32, s: str, sn: u32, si: u32, ctx: ptr) -> i64 {
    if !rx_tick(ctx) {
        return re_no();
    }
    let start: u32 = ps;
    let scanning: u32 = 1;
    while scanning == 1 {
        let bar: u32 = rx_alt_at(p, start, pe);
        let end: u32 = pe;
        if bar != RX_ERR_INDEX {
            end = bar;
        }
        let r: i64 = rx_seq(p, start, end, s, sn, si, ctx);
        if r >= 0 {
            return r;
        }
        if bar == RX_ERR_INDEX {
            scanning = 0;
        } else {
            start = bar + 1;
        }
    }
    return re_no();
}

// ---------------------------------------------------------------- 对外

/// 从 `at` 起能不能匹配；返回匹配结束下标，没有返回 -1。
pub fn re_match_at(pat: str, s: str, at: u32, ctx: ptr) -> i64 {
    return re_match_at_budget(pat, s, at, ctx, RX_BUDGET);
}

pub fn re_match_at_budget(pat: str, s: str, at: u32, ctx: ptr, budget: u32) -> i64 {
    let pn: u32 = str_len(pat);
    let sn: u32 = str_len(s);
    if at > sn {
        return re_no();
    }
    mem_store32(ctx, RX_BUD, budget);
    return rx_alt(pat, 0, pn, s, sn, at, ctx);
}

/// 整个串必须匹配（`^...$` 的语义，不必自己写锚点）。
pub fn re_match(pat: str, s: str, ctx: ptr) -> bool {
    let sn: u32 = str_len(s);
    let r: i64 = re_match_at(pat, s, 0, ctx);
    return r >= 0 && (r as u32) == sn;
}

/// 从 `from` 起找第一个匹配的**起点**；没有返回 -1。
pub fn re_search_from(pat: str, s: str, from: u32, ctx: ptr) -> i64 {
    let sn: u32 = str_len(s);
    if from > sn {
        return re_no();
    }
    let i: u32 = from;
    while i <= sn {
        let r: i64 = re_match_at(pat, s, i, ctx);
        if r >= 0 {
            return i as i64;
        }
        i = i + 1;
    }
    return re_no();
}

pub fn re_search(pat: str, s: str, ctx: ptr) -> i64 {
    return re_search_from(pat, s, 0, ctx);
}

// ---------------------------------------------------------------- 自检

fn test_regex_literal() -> bool {
    let c: ptr = alloc(re_ctx_bytes());
    return re_match("abc", "abc", c) && !re_match("abc", "abd", c)
        && !re_match("abc", "xabc", c);
}

fn test_regex_classes() -> bool {
    let c: ptr = alloc(re_ctx_bytes());
    return re_match("[a-c]+", "abcabc", c) && !re_match("[a-c]+", "abcd", c)
        && re_match("[^0-9]+", "abc", c) && !re_match("[^0-9]+", "ab1", c)
        && re_match("\\d{3}", "123", c) && !re_match("\\d{3}", "12", c)
        && re_match("\\w+", "a_1", c) && re_match("\\s", " ", c);
}

fn test_regex_alternation_and_group() -> bool {
    let c: ptr = alloc(re_ctx_bytes());
    return re_match("(ab|cd)+", "abcdab", c) && !re_match("(ab|cd)+", "abcx", c)
        && re_match("a(b|c)*d", "abcbcd", c);
}

fn test_regex_quantifiers() -> bool {
    let c: ptr = alloc(re_ctx_bytes());
    return re_match("a*", "", c) && re_match("a+", "aaaa", c)
        && !re_match("a+", "", c) && re_match("ab?c", "ac", c)
        && re_match("a{2,4}", "aaa", c) && !re_match("a{2,4}", "a", c)
        && re_match("a{2,}", "aaaaaa", c);
}

fn test_regex_search_and_anchors() -> bool {
    let c: ptr = alloc(re_ctx_bytes());
    let s: str = "xx hello yy";
    let i: i64 = re_search("hello", s, c);
    return i == 3 && re_search("^hello", s, c) == re_no()
        && re_match("^xx.*yy$", s, c);
}
