    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "");
    a = fa_hex(t, a, "61787d2c7b64697d2c7b73697d2c7b64787d2c7e7b63787d2c7e7b7231317d2c7e7b6d656d6f72797d2228693634203233312c2069363420256164642c2069363420302c206936342030290a20207265742069363420300a7d0a0a646566696e6520766f696420405f5f6c6f6d5f7368696d2829207b0a656e7472793a0a202072657420766f69640a7d0a0a");
    return a;
}


fn fa_r64(p: ptr, off: u32) -> u64 {
    let lo: u64 = load32(p, off) as u64;
    let hi: u64 = load32(p, off + 4) as u64;
    return lo + hi * 4294967296;
}

fn fa_is_shim(t: ptr, ls: u32, le: u32) -> u32 {
    let nm: u64 = fa_span(t, ls, le);
    return fa_lit_eq(t, hi32(nm), hi32(nm) + lo32(nm), "__lom_shim");
}

fn fa_is_table_global(t: ptr, noff: u32, nlen: u32) -> u32 {
    if fa_lit_eq(t, noff, noff + nlen, "@__lom_sites") == 1 {
        return 1;
    }
    if fa_lit_eq(t, noff, noff + nlen, "@__lom_fns") == 1 {
        return 1;
    }
    if fa_lit_eq(t, noff, noff + nlen, "@__lom_blks") == 1 {
        return 1;
    }
    if fa_lit_eq(t, noff, noff + nlen, "@__lom_strs") == 1 {
        return 1;
    }
    return 0;
}

fn fa_prepare(tab: ptr, t: ptr, n: u32) -> u32 {
    let sp: ptr = fs(tab);
    store32(sp, FS_ON, 1);
    store32(sp, FS_UN, n);
    store32(sp, FS_NSITE, 0);
    store32(sp, FS_NFN, 0);
    store32(sp, FS_NBLK, 0);
    store32(sp, FS_POOLN, 0);
    store32(sp, FS_CUR, 0);
    store32(sp, FS_NEWN, 0);
    let rc: u32 = fa_scan(tab, t, n);
    if rc != 0 {
        return rc;
    }
    let ep: u64 = find_entry(t, n);
    if ep == 0 {
        let _f0: u32 = fail("the unit has no `_start` or `main` entry point -- declare `fn main()` or `fn _start()`");
        return 1;
    }
    store32(sp, FS_USERO, hi32(ep));
    store32(sp, FS_USERL, lo32(ep));
    let rp: u32 = fa_pool(t, sp);
    if rp != 0 {
        return rp;
    }
    let nn: u32 = fa_text(tab, t, n);
    if nn == 0 {
        return 1;
    }
    store32(sp, FS_NEWN, nn);
    return 0;
}

/// 名字池（链接器自己的名字，不是产物的名字池）：跨度写进状态块。
fn fa_names(tab: ptr, t: ptr) -> u32 {
    let sp: ptr = fs(tab);
    let c0: u32 = cell(tab, C_EXTN);
    store32(sp, FS_SITESO, c0);
    let c1: u32 = put_name(t, c0, "@__lom_sites");
    store32(sp, FS_SITESL, c1 - c0);
    store32(sp, FS_FNSO, c1);
    let c2: u32 = put_name(t, c1, "@__lom_fns");
    store32(sp, FS_FNSL, c2 - c1);
    store32(sp, FS_BLKSO, c2);
    let c3: u32 = put_name(t, c2, "@__lom_blks");
    store32(sp, FS_BLKSL, c3 - c2);
    store32(sp, FS_STRSO, c3);
    let c4: u32 = put_name(t, c3, "@__lom_strs");
    store32(sp, FS_STRSL, c4 - c3);
    store32(sp, FS_SIGO, c4);
    let c5: u32 = put_name(t, c4, "@__lom_sig");
    store32(sp, FS_SIGL, c5 - c4);
    store32(sp, FS_INFOO, c5);
    let c6: u32 = put_name(t, c5, "@__lom_info");
    store32(sp, FS_INFOL, c6 - c5);
    store32(sp, FS_UCTXO, c6);
    let c7: u32 = put_name(t, c6, "@__lom_uctx");
    store32(sp, FS_UCTXL, c7 - c6);
    store32(sp, FS_HANDO, c7);
    let c8: u32 = put_name(t, c7, "__lom_handler");
    store32(sp, FS_HANDL, c8 - c7);
    store32(sp, FS_SHIMO, c8);
    let c9: u32 = put_name(t, c8, "__lom_shim");
    store32(sp, FS_SHIML, c9 - c8);
    store32(sp, FS_ENTRYO, c9);
    let c10: u32 = put_name(t, c9, "__lom_entry");
    store32(sp, FS_ENTRYL, c10 - c9);
    store32(sp, FS_WRHEXO, c10);
    let c11: u32 = put_name(t, c10, "__wrhex");
    store32(sp, FS_WRHEXL, c11 - c10);
    setcell(tab, C_EXTN, c11);
    return 0;
}

/// 发射期：把每条站点指令的虚拟地址记进描述。
fn fa_site_hit(tab: ptr, t: ptr, line: u32, d: u32) {
    let sp: ptr = fs(tab);
    let cur: u32 = load32(sp, FS_CUR);
    if cur >= load32(sp, FS_NSITE) {
        return;
    }
    let se: u32 = FAULT_SITE - M_FAULT + cur * 32;
    if load32(sp, se + FT_LINE) != line {
        return;
    }
    w64(sp, se + FT_ADDR, (txt_base(tab) + d) as u64);
    store32(sp, FS_CUR, cur + 1);
}

/// 发射后：把这条站点展开出来的**机器码长度**记下来（报告只在 `[addr, addr+len)` 里认）。
fn fa_site_len(tab: ptr, d0: u32, d1: u32) {
    let sp: ptr = fs(tab);
    let cur: u32 = load32(sp, FS_CUR);
    if cur == 0 {
        return;
    }
    let se: u32 = FAULT_SITE - M_FAULT + (cur - 1) * 32;
    if fa_r64(sp, se + FT_ADDR) != (txt_base(tab) + d0) as u64 {
        return;
    }
    w32(sp, se + FT_LEN, d1 - d0);
}

/// 发射后：四张表写进 `.data`。地址与参考实现的 `_fault_patch_tables` 同一口径。
fn fa_fill(tab: ptr, t: ptr, gb: ptr) -> u32 {
    let sp: ptr = fs(tab);
    let ns: u32 = load32(sp, FS_NSITE);
    let nf: u32 = load32(sp, FS_NFN);
    let nb: u32 = load32(sp, FS_NBLK);
    let npo: u32 = load32(sp, FS_POOLN);
    let sa: u32 = lbl_addr(tab, t, load32(sp, FS_SITESO), load32(sp, FS_SITESL), 0, 0);
    let fa: u32 = lbl_addr(tab, t, load32(sp, FS_FNSO), load32(sp, FS_FNSL), 0, 0);
    let ba: u32 = lbl_addr(tab, t, load32(sp, FS_BLKSO), load32(sp, FS_BLKSL), 0, 0);
    let xa: u32 = lbl_addr(tab, t, load32(sp, FS_STRSO), load32(sp, FS_STRSL), 0, 0);
    if sa == NO || fa == NO || ba == NO || xa == NO {
        let _f1: u32 = fail("the fault-report tables were not placed in .data");
        return 1;
    }
    let so: u32 = sa - data_base(tab);
    w32(gb, so, ns);
    let i: u32 = 0;
    while i < ns {
        let se: u32 = FAULT_SITE - M_FAULT + i * 32;
        let p: u32 = so + 4 + i * 24;
        w64(gb, p, fa_r64(sp, se + FT_ADDR));
        w32(gb, p + 8, load32(sp, se + FT_FN));
        w32(gb, p + 12, load32(sp, se + FT_BLK));
        w32(gb, p + 16, load32(sp, se + FT_INS));
        w32(gb, p + 20, load32(sp, se + FT_LEN));
        i = i + 1;
    }
    let fo: u32 = fa - data_base(tab);
    w32(gb, fo, nf);
    let tail: u32 = lbl_addr(tab, t, load32(sp, FS_WRHEXO), load32(sp, FS_WRHEXL), 0, 0);
    i = 0;
    while i < nf {
        let fb: u32 = FAULT_FN - M_FAULT + i * 16;
        let no: u32 = load32(sp, fb + FF_NOFF);
        let nl: u32 = load32(sp, fb + FF_NLEN);
        let start: u32 = lbl_addr(tab, t, no, nl, 0, 0);
        let end: u32 = tail;
        if i + 1 < nf {
            let fb2: u32 = FAULT_FN - M_FAULT + (i + 1) * 16;
            end = lbl_addr(tab, t, load32(sp, fb2 + FF_NOFF), load32(sp, fb2 + FF_NLEN), 0, 0);
        }
        let p2: u32 = fo + 4 + i * 24;
        w64(gb, p2, start as u64);
        w64(gb, p2 + 8, end as u64);
        w32(gb, p2 + 16, load32(sp, fb + FF_POOL));
        w32(gb, p2 + 20, nl);
        i = i + 1;
    }
    let bo: u32 = ba - data_base(tab);
    w32(gb, bo, nb);
    i = 0;
    while i < nb {
        let bb: u32 = FAULT_BLK - M_FAULT + i * 12;
        w32(gb, bo + 4 + i * 8, load32(sp, bb + FB_POOL));
        w32(gb, bo + 4 + i * 8 + 4, load32(sp, bb + FB_NLEN));
        i = i + 1;
    }
    let xo: u32 = xa - data_base(tab);
    i = 0;
    while i < npo {
        store8(gb, xo + i, load8(sp, FAULT_POOL - M_FAULT + i) as u8);
        i = i + 1;
    }
    return 0;
}

/// 机器码 shim：内核按 SysV 传 rdi/rsi/rdx，栈机 handler 从全局读。
/// 三个全局的地址用 **abs32 回填（kind 2）** —— bss 的地址要等 `place_bss`，
/// 发射这一刻还定不下来。
fn fa_shim(tab: ptr, out: ptr, c: u32, t: ptr) -> u32 {
    let sp: ptr = fs(tab);
    let d: u32 = c;
    let d1: u32 = e1(out, d, 137);
    let d2: u32 = e1(out, d1, 60);
    let d3: u32 = e1(out, d2, 37);
    fix_add(tab, d3, 2, load32(sp, FS_SIGO), load32(sp, FS_SIGL), 0, 0);
    let d4: u32 = e4(out, d3, 0);
    let d5: u32 = e1(out, d4, 72);
    let d6: u32 = e1(out, d5, 137);
    let d7: u32 = e1(out, d6, 52);
    let d8: u32 = e1(out, d7, 37);
    fix_add(tab, d8, 2, load32(sp, FS_INFOO), load32(sp, FS_INFOL), 0, 0);
    let d9: u32 = e4(out, d8, 0);
    let d10: u32 = e1(out, d9, 72);
    let d11: u32 = e1(out, d10, 137);
    let d12: u32 = e1(out, d11, 20);
    let d13: u32 = e1(out, d12, 37);
    fix_add(tab, d13, 2, load32(sp, FS_UCTXO), load32(sp, FS_UCTXL), 0, 0);
    let d14: u32 = e4(out, d13, 0);
    let d15: u32 = e1(out, d14, 232);
    fix_add(tab, d15, 0, load32(sp, FS_HANDO), load32(sp, FS_HANDL), 0, 0);
    let d16: u32 = e4(out, d15, 0);
    // 处理器返回 1 = 已修复：补 `add rsp,8` 再 rt_sigreturn（见参考实现同一段）。
    let d17: u32 = e1(out, d16, 133);
    let d18: u32 = e1(out, d17, 192);
    let d19: u32 = e1(out, d18, 116);
    let d20: u32 = e1(out, d19, 11);
    let d21: u32 = e1(out, d20, 72);
    let d22: u32 = e1(out, d21, 131);
    let d23: u32 = e1(out, d22, 196);
    let d24: u32 = e1(out, d23, 8);
    let d25: u32 = e1(out, d24, 184);
    let d26: u32 = e1(out, d25, 15);
    let d27: u32 = e1(out, d26, 0);
    let d28: u32 = e1(out, d27, 0);
    let d29: u32 = e1(out, d28, 0);
    let d30: u32 = e1(out, d29, 15);
    let d31: u32 = e1(out, d30, 5);
    let d32: u32 = e1(out, d31, 15);
    let d33: u32 = e1(out, d32, 11);
    return d33;
}

// ---------------------------------------------------------------- 主程序

fn wdec(fd: u64, tmp: ptr, v: u32) -> u64 {
    let d: u32 = 0;
    let x: u32 = v;
    if x == 0 {
        store8(tmp, 0, 48 as u8);
        return write_all(fd, tmp, 1);
    }
    while x > 0 {
        let dg: u32 = x % 10;
        store8(tmp, d, (48 + dg) as u8);
        x = x / 10;
        d = d + 1;
    }
    let buf: ptr = ptr_add(tmp, 32);
    let q: u32 = 0;
    while q < d {
        store8(buf, q, load8(tmp, d - 1 - q) as u8);
        q = q + 1;
    }
    return write_all(fd, buf, d as u64);
}

fn _start() -> u32 {
    let mem: ptr = sys_alloc(ARENA) as ptr;
    if mem as u64 == 0 {
        return fail("out of memory (brk failed)");
    }
    let rc: u32 = run(mem);
    return die(rc as u64);
}

/// `--merge FILE`（`#1061`）：把其余 IR 接到输入文本后面，返回新的长度。
///
/// 单独成一个函数而不是塞进 `run()`：`run()` 已经贴着自举检查器的容量走，往里
/// 加二十来行会让**后面的**代码读不到内建函数（表面症状是 `ptr_add` 报 E1）。
fn merge_inputs(pbuf: ptr, inb: ptr, n0: u64, nmerge: u32, obase: u32) -> u64 {
    let n: u64 = n0;
    let mbase: u32 = obase + 32768;
    let mn: u32 = 0;
    while mn < nmerge {
        let moff: u32 = mbase + mn * 1024;
        let mp: ptr = ptr_add(pbuf, moff);
        let mfd: i64 = open_ro(mp);
        if mfd < 0 {
            let _fd: u32 = fail("cannot open a --merge input file");
            return n;
        }
        let sep: u32 = n as u32;
        store8(inb, sep, 10 as u8);
        let dstart: u32 = sep + 1;
        let room: u64 = (IN_CAP as u64) - (dstart as u64) - 2;
        let got: u64 = read_all(mfd as u64, ptr_add(inb, dstart), room);
        syscall4(3, mfd as u64, 0, 0);
        if got == 0 {
            let _fe: u32 = fail("a --merge input file is empty");
            return n;
        }
        if got >= room {
            let _ff: u32 = fail("the merged .ll does not fit in the input buffer (too large for this linker)");
            return n;
        }
        n = (dstart as u64) + got;
        mn = mn + 1;
    }
    return n;
}

fn run(mem: ptr) -> u32 {
    store32(ptr_add(mem, M_FAULT), FS_HEAL, 0);
    let ab: ptr = ptr_add(mem, M_ARGV);
    let mb: ptr = ptr_add(mem, M_META);
    let _m0: u32 = put_cstr(mb, 0, "lomhot 1\n");
    store32(hot_sc(mb), HS_MLEN, _m0);
    store32(hot_sc(mb), HS_CLEN, 0);
    store32(hot_sc(mb), HS_NORD, 0);
    store32(hot_sc(mb), HS_NHS, 0);
    store32(hot_sc(mb), HS_HRUN, 0);
    store32(hot_sc(mb), HS_META, 0);
    store32(hot_sc(mb), HS_HOTPN, 0);
    store32(hot_sc(mb), HS_ENTRY, 0);
    let a1: u64 = argv_n(ab, 8192, 1);
    let o1: u64 = argv_n(ab, 8192, 2);
    if a1 == 0 || o1 == 0 {
        wstr(2, "loment: usage: loment-lomelf IN.ll OUT [--diag-out PATH] [--link OBJ ...] (normally reached through `loment build`)\n");
        return die(2);
    }
    // 多出来的实参只可能是启动器透传的 `--link FILE.o` (docs/173 FFI)。**必须解析**:
    // 不看 argv[3..] 的话 `--link` 会被**静静忽略**, 然后在回填时报一句 "未定义的标签:
    // c_add" —— 用户看到的是"符号找不到"而不是"这个功能没实现", 方向完全错了。
    //
    // **必须先收完再读输入**: argv_n 每次都把 `/proc/self/cmdline` 重新读进 argv 缓冲,
    // 而它存放路径字符串的落点 (argv 缓冲 + 8192) **正是输入缓冲的起点** —— 读过输入之后
    // 再调 argv_n 会把输入的头 19 个字节踩掉。
    //
    // **判的是 lo32(长度) 不是整个返回值**: `/proc/self/cmdline` 以 NUL 结尾, 于是 argv_n
    // 的收尾那句 (`if f == n`) 会给出一个**长度 0 的命中** —— 打包值 `m * PHI` 非零。
    // 只判 `!= 0` 会把**每一次正常调用**都当成"多了个实参", 实测把 loment_elf_test 从 7/7
    // 打到 5/7 (两条都是"镜像退出 2")。
    let pbuf: ptr = ptr_add(mem, M_TXT);
    let nlink: u32 = 0;
    // `--merge FILE`（`#1061`）：再多读一份 IR，接到输入文本后面。镜像与参考的
    // 多输入语义都是**先合并再链接**，所以这里就是拼接；合并后的 `declare` 由
    // 已有的 `ext_drop_defined` 落到定义上。路径放在 `--link` 那串之后的一段。
    let nmerge: u32 = 0;
    // `--allow-ports`（`docs/222` §4 的端口门）：默认**不收**带未定义符号的外源对象。
    // 开发通道与判据显式写它；发行版启动器永不写（`tools/loment_dist.py`）。
    let ap: u32 = 0;
    // 启动器给的 `--diag-out` 路径（0 = 没给）。写不了产物时那一份结构化诊断就写到它里面。
    let dg: u32 = 0;
    // `--fault-report`（`docs/367` stage 2）：产物自己报段错误。
    let fr: u32 = 0;
    let obase: u32 = lo32(a1) + 8 + lo32(o1) + 8;   // 与下面的 pout 对齐
    let ok: u32 = 3;
    let go: u32 = 1;
    while go == 1 {
        let av: u64 = argv_n(ab, 8192, ok);
        if lo32(av) == 0 {
            go = 0;
        } else {
            // `--allow-ports`（`docs/222` §4 的端口门）：不带参数，只把门放开。**先认它**
            // —— 两条都不带参数、长度不同，判在 `--link` 之前免得将来有人把 `--link` 的
            // 名字判宽了、把这一条吞掉。
            if lo32(av) == 13 && lit_at(ab, hi32(av), hi32(av) + 13, "--allow-ports") == 1 {
                ap = 1;
                ok = ok + 1;
            } else if lo32(av) == 6 && lit_at(ab, hi32(av), hi32(av) + 6, "--link") == 1 {
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --link needs a file name\n");
                    return die(2);
                }
                let dst: u32 = obase + nlink * 1024;
                if dst + 1024 > DIAGB_OFF {
                    wstr(2, "loment: too many --link files\n");
                    return die(2);
                }
                let j: u32 = 0;
                while j < lo32(pv) {
                    store8(pbuf, dst + j, load8(ab, hi32(pv) + j) as u8);
                    j = j + 1;
                }
                store8(pbuf, dst + lo32(pv), 0 as u8);
                nlink = nlink + 1;
                ok = ok + 2;
            } else if lo32(av) == 7
                    && lit_at(ab, hi32(av), hi32(av) + 7, "--merge") == 1 {
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --merge needs a file name\n");
                    return die(2);
                }
                let mdst: u32 = obase + 32768 + nmerge * 1024;
                if mdst + 1024 > DIAGB_OFF {
                    wstr(2, "loment: too many --merge files\n");
                    return die(2);
                }
                let mj: u32 = 0;
                while mj < lo32(pv) {
                    store8(pbuf, mdst + mj, load8(ab, hi32(pv) + mj) as u8);
                    mj = mj + 1;
                }
                store8(pbuf, mdst + lo32(pv), 0 as u8);
                nmerge = nmerge + 1;
                ok = ok + 2;
            } else if lo32(av) == 10
                    && lit_at(ab, hi32(av), hi32(av) + 10, "--hot-meta") == 1 {
                // 热更新元数据（`#1149`）：路径拷进自己的缓冲区（argv 缓冲随后会被读入踩掉）。
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --hot-meta needs a file name\n");
                    return die(2);
                }
                let j1: u32 = 0;
                while j1 < lo32(pv) {
                    store8(ptr_add(mem, M_HOTPATH), j1, load8(ab, hi32(pv) + j1) as u8);
                    j1 = j1 + 1;
                }
                store8(ptr_add(mem, M_HOTPATH), lo32(pv), 0 as u8);
                store32(hot_sc(mb), HS_HOTPN, lo32(pv));
                store32(hot_sc(mb), HS_META, 1);
                ok = ok + 2;
            } else if lo32(av) == 9
                    && lit_at(ab, hi32(av), hi32(av) + 9, "--profile") == 1 {
                // 构建档（`#1150`）：今天只有 hotswap 一档。
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 7
                        && lit_at(ab, hi32(pv), hi32(pv) + 7, "hotswap") == 1 {
                    store32(hot_sc(mb), HS_HRUN, 1);
                } else {
                    wstr(2, "loment: unknown --profile (expected hotswap)\n");
                    return die(2);
                }
                ok = ok + 2;
            } else if lo32(av) == 10
                    && lit_at(ab, hi32(av), hi32(av) + 10, "--diag-out") == 1 {
                // 启动器给的那条诊断文件。**路径存在 pbuf 的最后 1 KiB**（`DIAGB_OFF`），
                // 与输入/输出/`--link` 那三个按 argv 长度算出来的落点不抢。
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --diag-out needs a file name\n");
                    return die(2);
                }
                let j0: u32 = 0;
                while j0 < lo32(pv) {
                    store8(pbuf, DIAGB_OFF + j0, load8(ab, hi32(pv) + j0) as u8);
                    j0 = j0 + 1;
                }
                store8(pbuf, DIAGB_OFF + lo32(pv), 0 as u8);
                dg = 1;
                ok = ok + 2;
            } else if lo32(av) == 14
                    && lit_at(ab, hi32(av), hi32(av) + 14, "--fault-report") == 1 {
                fr = 1;
                ok = ok + 1;
            } else if lo32(av) == 12
                    && lit_at(ab, hi32(av), hi32(av) + 12, "--fault-heal") == 1 {
                let pv: u64 = argv_n(ab, 8192, ok + 1);
                if lo32(pv) == 0 {
                    wstr(2, "loment: --fault-heal needs a count\n");
                    return die(2);
                }
                // 只收十进制非负整数 —— 与参考的 `int(arg, 10)` 同一条口径。
                let he: u32 = hi32(pv) + lo32(pv);
                let hd: u32 = skip_sp(ab, hi32(pv), he);
                let hok: u32 = 1;
                if hd >= he {
                    hok = 0;
                }
                let hk: u32 = hd;
                while hk < he {
                    let hc: u32 = load8(ab, hk);
                    if hc < 48 || hc > 57 {
                        hok = 0;
                    }
                    hk = hk + 1;
                }
                if hok == 0 {
                    wstr(2, "loment: --fault-heal needs a non-negative decimal count\n");
                    return die(2);
                }
                store32(ptr_add(mem, M_FAULT), FS_HEAL, num_at(ab, hd, he) as u32);
                fr = 1;
                ok = ok + 2;
            } else {
                wstr(2, "loment: unknown option ");
                write_all(2, ptr_add(ab, hi32(av)), lo32(av) as u64);
                wstr(2, "\n");
                return die(2);
            }
        }
    }
    let inb: ptr = ptr_add(mem, M_IN);
    let ino: u32 = hi32(a1);
    let inn: u32 = lo32(a1);
    let oo: u32 = hi32(o1);
    let ol: u32 = lo32(o1);
    // 先把两个路径拷到稳定缓冲 (argv 的 cmdline 缓冲在后面会被读入覆盖)
    let pin: u32 = 0;
    let i: u32 = 0;
    while i < inn {
        store8(pbuf, pin + i, load8(ab, ino + i) as u8);
        i = i + 1;
    }
    store8(pbuf, pin + inn, 0 as u8);
    let pout: u32 = inn + 8;
    i = 0;
    while i < ol {
        store8(pbuf, pout + i, load8(ab, oo + i) as u8);
        i = i + 1;
    }
    store8(pbuf, pout + ol, 0 as u8);
    let fd: i64 = open_ro(ptr_add(pbuf, pin));
    if fd < 0 {
        return fail("cannot open the input file");
    }
    let n: u64 = read_all(fd as u64, inb, IN_CAP as u64);
    syscall4(3, fd as u64, 0, 0);
    if n == 0 {
        return fail("the input file is empty");
    }
    // **读满上限 = 文件还有剩** —— `read_all` 读够 `cap` 就停，它不知道文件多长。
    // 不检查的后果不是"少几条指令"：`.ll` 是逐行语法，截断点之后的函数定义凭空消失，
    // 汇编出来的是一个**缺胳膊少腿、跑起来就段错误**的可执行文件。
    // 2026-09-18 实测（docs/192）：同一份 `.ll`，这边段错误、clang 汇编完全正常 ——
    // 责任就在这一行。与 `copy_name` 那条守卫、与驱动程序里 `MAX_USE` / `MAX_ADDIN`
    // 的注解是同一条纪律：**超限报错退出，绝不静默丢**。
    if n >= IN_CAP as u64 {
        return fail("the input .ll does not fit in the input buffer (it is too large for this linker)");
    }
    // `--merge`：把其余 IR 接在后面（中间留一个换行，免得两份的最后/第一行粘成一行）。
    n = merge_inputs(pbuf, inb, n, nmerge, obase);
    let tab: ptr = ptr_add(mem, M_TAB);
    let gb: ptr = ptr_add(mem, M_GB);
    let tlsbuf: ptr = ptr_add(mem, M_TLS);
    let txt: ptr = ptr_add(mem, M_TXT + 65536);
    let ob: ptr = ptr_add(mem, M_OUT);
    // 输出名以 `.exe` 结尾 = 出 PE（Windows），否则出 ELF。参考实现用 --target，
    // 镜像这边按后缀走 —— 发行包的启动器本来就按平台给不同的输出名。
    let pe: u32 = 0;
    if ol >= 4 {
        if load8(pbuf, pout + ol - 4) == 46 {
            if load8(pbuf, pout + ol - 3) == 101 {
                if load8(pbuf, pout + ol - 2) == 120 {
                    if load8(pbuf, pout + ol - 1) == 101 {
                        pe = 1;
                    }
                }
            }
        }
    }
    if nlink != 0 && pe == 1 {
        wstr(2, "loment: --link takes ELF objects only for now\n");
        return die(2);
    }
    setcell(tab, C_PE, pe);
    if pe == 1 && load32(hot_sc(mb), HS_HRUN) == 1 {
        wstr(2, "loment: --profile hotswap takes ELF output only\n");
        return die(2);
    }
    if pe == 1 && load32(hot_sc(mb), HS_META) == 1 {
        wstr(2, "loment: --hot-meta takes ELF output only\n");
        return die(2);
    }
    if fr == 1 {
        if pe == 1 {
            wstr(2, "loment: --fault-report takes ELF output only
");
            return die(2);
        }
        if load32(hot_sc(mb), HS_HRUN) == 1 {
            wstr(2, "loment: --fault-report and the hotswap entry gate do not combine (docs/367 stage 1)
");
            return die(2);
        }
        let rf: u32 = fa_prepare(tab, inb, n as u32);
        if rf != 0 {
            return die(1);
        }
        n = load32(fs(tab), FS_NEWN) as u64;
    }
    // 外部符号名池的游标: 从输入文本的**末尾**开始, 见 copy_name。
    setcell(tab, C_EXTN, n as u32);
    if fr == 1 {
        let _fn0: u32 = fa_names(tab, inb);
    }
    if load32(hot_sc(mb), HS_HRUN) == 1 {
        // 入口闸读的那个 epoch 字：名字先立起来，地址等 `place_bss` 再回填。
        let en: u32 = put_name(inb, cell(tab, C_EXTN), "__loment_hot_epoch");
        store32(hot_sc(mb), HS_EPOCHN, en);
        setcell(tab, C_EXTN, en + 18);
    }
    // **阶段 0（V2，`docs/183` §4）**：先扫一遍 `--link` 的文件里有没有共享对象。
    // 这一步必须**在入口桩之前**，因为"要不要自己装 TLS"取决于它：
    //   * 静态链外部 `.o` 时**要装**（`fs:0x28` 得落在一块可读写的 TLS 里）；
    //   * 动态链时**不能装** —— `fs` 归 `ld.so` 管，指向 glibc 的整块 TLS
    //     （`errno`/`tcache`/栈金丝雀都在里面）。再 `arch_prctl(ARCH_SET_FS)` 一次就把
    //     它顶掉了，症状是 zlib 一路调到 libc 的 `malloc` 时读到垃圾线程指针。
    let ndirect: u32 = 0;
    let nshared: u32 = 0;
    if nlink != 0 && pe == 0 {
        let s0: u32 = 0;
        while s0 < nlink {
            let p0: ptr = ptr_add(pbuf, obase + s0 * 1024);
            // 先只读 64 字节**分类**：`.so` 走映射、`.o` 走 4 MiB 暂存（`#597`）。
            if link_file_is_shared(p0, ptr_add(mem, M_OBJ)) == 1 {
                if nshared != 0 {
                    wstr(2, "loment: 一次只能链一个共享对象\n");
                    return die(1);
                }
                if ap == 0 {
                    wstr(2, "loment: 这份产物带了通向世界的端口（共享对象），链接器默认不收。\n");
                    wstr(2, "loment: 自己调链接器时要它得显式写 --allow-ports（启动器在两个渠道都传，docs/219 §8c）\n");
                    return die(1);
                }
                let mp: ptr = map_link_file(tab, p0);
                let _r: u32 = so_load(tab, inb, mp, cell(tab, C_SOLEN), p0);
                nshared = 1;
            } else {
                let ln0: u32 = read_link_file(p0, ptr_add(mem, M_OBJ), OBJ_CAP);
                if is_archive(ptr_add(mem, M_OBJ), ln0) == 0 {
                    ndirect = ndirect + 1;
                }
            }
            s0 = s0 + 1;
        }
        setcell(tab, C_NSHARED, nshared);
    }
    collect_globals(tab, inb, n as u32, gb);
    collect_externs(tab, inb, n as u32);
    // 拼接进来的库 IR 会把应用里的 `declare` 满足掉；那些名字必须从外部表里摘掉，
    // 否则调用点会走 C ABI（PE 上实参错位）。见 `ext_drop_defined`。
    ext_drop_defined(tab, inb, n as u32);
    place_globals(tab, inb);
    // 外部目标文件 (docs/173): 代码节接在我们自己的代码之后, **数据节接在数据段之后**,
    // 导出符号立标签。
    //
    // **归档必须在入口桩之前展开**（`#625`）：参考实现先展开归档、再按 `objects`
    // （直接对象 + 挑中的成员）决定 TLS 与收编面；镜像原先数的是 `--link` 文件的
    // 个数，于是"链了一份没人用的归档"也会凭空长出 TLS 块与整段 memcpy/memset。
    let tobj: ptr = ptr_add(mem, M_OBJ);
    let arb: ptr = ptr_add(mem, M_AR);
    let got: u32 = 0;
    if nlink != 0 {
        // ① **需要集**：这份 IR 里 `declare` 的外部符号 ∪ 直接给的 `.o` 的未定义符号
        //    —— 归档的定点选择要它（"我的 a.o 引用归档成员里的 b"正是靠这一条接上的）。
        need_from_externs(tab, inb);
        got = 0;
        while got < nlink {
            let p0: ptr = ptr_add(pbuf, obase + got * 1024);
            if link_file_is_shared(p0, tobj) == 0 {
                let ln0: u32 = read_link_file(p0, tobj, OBJ_CAP);
                if is_archive(tobj, ln0) == 0 {
                    check_obj(p0, tobj, ln0);      // 不是归档就得是能用的 `.o`（否则拒在这里）
                    let _u: u32 = obj_syms(tab, inb, tobj, 1);
                }
            }
            got = got + 1;
        }
        // ② **归档展开**：定点选成员，只登记（`TB_MEM` 带归档号）不摆 —— 摆要等
        //    代码缓冲的游标定下来（直接对象一律排在归档前面）。
        got = 0;
        let aridx0: u32 = 0;
        while got < nlink {
            let p0: ptr = ptr_add(pbuf, obase + got * 1024);
            if link_file_is_shared(p0, tobj) == 0 {
                let ln2: u32 = read_link_file(p0, tobj, OBJ_CAP);
                if is_archive(tobj, ln2) == 1 {
                    copy_n(arb, 0, tobj, 0, ln2);
                    let _s: u32 = select_archive(tab, inb, tobj, arb, ln2, aridx0);
                    aridx0 = aridx0 + 1;
                }
            }
            got = got + 1;
        }
    }
    // "到底有没有外部对象被摆下去" —— 直接对象 + 归档挑中的成员。TLS、收编面、
    // 入口桩的 prologue 全看它，而不是看 `--link` 写了几个文件（`#625`）。
    let nobj: u32 = ndirect + cell(tab, C_NMEM);
    // **TLS 的名字先写进名字池**：入口桩要用它（`arch_prctl` 的目标），而标签要等
    // TLS 块摆好（在对象之后）才立 —— 回填在最后一步，所以中间这段时间"有名无址"是对的。
    let tlsn: u32 = cell(tab, C_EXTN);
    let tls: u32 = 0;
    if nobj != 0 && nshared == 0 {
        setcell(tab, C_EXTN, put_name(inb, tlsn, "__loment_tls"));
        tls = 1;
    }
    // **`no_std` 的带牙检查**（`#941` / #539）：IR 声明"只用核那一层"，就不能带宿主层。
    if mem_has(inb, n as u32, "; loment-mode: no_std") == 1
        && mem_has(inb, n as u32, "; loment-port: hosted") == 1 {
        wstr(2, "loment: this IR declares `no_std` (the core layer alone) but carries the hosted layer (`; loment-port: hosted`) -- the two cannot both hold
");
        return die(1);
    }
    // **dismemory**（`docs/373`）：这份 IR 要 LVM 在没有地址的模型上跑；原生档有地址，
    // 链出来只会静默错编。与 `no_std` / `no_gc` 同一条纪律：点名拒。
    if mem_has(inb, n as u32, "; loment-memory: dismemory") == 1 {
        wstr(2, "loment: 这份 IR 要求 LVM 的 dismemory 档（内存里没有地址，docs/373）；原生档有地址，链不出来 
");
        return die(1);
    }
    // **`no_gc` 的带牙检查**（`#538`）：IR 自己声明"不带收集器"，那就核它真的没带。
    // 与参考实现 `tools/lomelf.py` 同一条判断、同一处失败（`docs/227` 判据 B 的镜像）。
    if mem_has(inb, n as u32, "; loment-gc: no_gc") == 1
        && (mem_has(inb, n as u32, "@__loment_collect") == 1
            || mem_has(inb, n as u32, "@__loment_roots") == 1) {
        wstr(2, "loment: this IR declares `no_gc` (the artifact carries no collector) but carries a collector (@__loment_collect / @__loment_roots) -- the two claims cannot both hold
");
        return die(1);
    }
    let tlen0: u32 = emit_all(tab, txt, 0, inb, n as u32, tlsn, tls, mb);
    if fr == 1 {
        let rf3: u32 = fa_fill(tab, inb, gb);
        if rf3 != 0 {
            return die(1);
        }
    }
    // **收编面**（`docs/219` §6）：链里带了**任何外部输入**（`.o` 或 `.so`），就把
    // "可闭合"那几个名字提供出来，于是它们不再是未定义符号 —— 从表上划掉。粒度与参考
    // 实现 `tools/lomelf.py` 的 `compile_ll` 同一处判断、同一段字节（`loment_elf_test`
    // 的自举镜像那格逐字节钉）。**顺序与那边一致**：我们的代码 -> 收编面 -> 外部对象。
    // `.so` 也要发（#631）：否则只链 `.so` 时 memcpy 一族只能落到导出表上，而 glibc
    // 把 memcpy 发成 IFUNC/非默认版本，一个都落不下。
    let tlen: u32 = tlen0;

    if nobj != 0 || nshared != 0 {
        tlen = emit_conscript(tab, txt, tlen, inb);
    }
    // ③ **摆直接对象**（按 `--link` 顺序），再 ④ **摆归档挑中的成员**（按归档顺序、
    //    每份内部按收下的次序）—— 参考实现那份是
    //    `flat = list(direct) + 各归档挑出来的成员`，直接对象一律排在归档前面。
    if nlink != 0 {
        got = 0;
        while got < nlink {
            let p0: ptr = ptr_add(pbuf, obase + got * 1024);
            if link_file_is_shared(p0, tobj) == 0 {
                let ln1: u32 = read_link_file(p0, tobj, OBJ_CAP);
                if is_archive(tobj, ln1) == 0 {
                    check_obj(p0, tobj, ln1);
                    tlen = link_object_mem(tab, inb, txt, gb, tlen, tobj, ap, tlsbuf);
                }
            }
            got = got + 1;
        }
        got = 0;
        let aridx1: u32 = 0;
        while got < nlink {
            let p0: ptr = ptr_add(pbuf, obase + got * 1024);
            if link_file_is_shared(p0, tobj) == 0 {
                let ln2: u32 = read_link_file(p0, tobj, OBJ_CAP);
                if is_archive(tobj, ln2) == 1 {
                    copy_n(arb, 0, tobj, 0, ln2);
                    tlen = lay_archive(tab, inb, txt, gb, tlen, tobj, arb, aridx1, ap, tlsbuf);
                    aridx1 = aridx1 + 1;
                }
            }
            got = got + 1;
        }
    }
    // **文本段满了就点名退出**（`docs/253`，2026-10-16）。数据段钉在 `TEXT_VADDR + OUT_CAP`，
    // 所以文本一旦超过 `OUT_CAP` 就会盖到数据段上 —— 而原先**盖上去不报错**：产物一启动
    // 就段错误（0 字节输出），看起来像编译器坏了。与 `TB_LBL_MAX` / `TB_FIX_MAX` / `IN_CAP`
    // 那几条守卫同一个纪律：**满了就说出来，不往下写**。参考实现 `tools/lomelf.py` 的
    // `compile_ll` 末尾同一条、同一个数（那边的常量叫 `TEXT_CAP`）。
    if tlen > OUT_CAP {
        let _f: u32 = fail("文本段满了 — 抬 OUT_CAP (loment/tools/lomelf.lomt) 与 tools/lomelf.py 的 TEXT_CAP/ELF_DATA_VADDR");
    }
    // **bss 的地址与标签必须等到这里**（`docs/219` §8b 第 1 条）—— 位置见 `place_bss`。
    //
    // **静态 GOT**（`#609`）与 **TLS 块**（`#610`）接在对象数据之后、bss 之前 ——
    // 与参考实现 `compile_ll` 同一处、同一个顺序（GOT -> TLS -> bss），产物因此逐字节相同。
    // GOT 的**内容**要等所有标签都立好才填得上，所以它与布局在同一趟里做完。
    let goff: u32 = layout_got(tab, inb, gb);
    // **`_GLOBAL_OFFSET_TABLE_` 是我们的符号**（`#617`）：静态 GOT 的基址。它常被 `-fPIC`
    // 对象报成 `GLOBAL UND`，不定义它，端口门会把一个自闭合的 PIC 对象当成"通向世界"。
    let gotn: u32 = cell(tab, C_EXTN);
    setcell(tab, C_EXTN, put_name(inb, gotn, "_GLOBAL_OFFSET_TABLE_"));
    lbl_add(tab, gotn, 21, 0, 0, data_base(tab) + goff);
    // **端口门在标签立好之后判**（`#615`）：这时"还剩什么解析不到"才是真正的端口。
    let pr: u32 = check_ports(tab, inb, ap, nshared);
    if pr != 0 {
        return pr;
    }
    if cell(tab, C_NTLS) != 0 && nshared != 0 {
        let _f: u32 = fail("TLS objects cannot be linked together with a shared object -- this version installs its own TLS block only in self-contained products (docs/219 S2)");
    }
    if nobj != 0 && nshared == 0 {
        layout_tls(tab, inb, gb, tlsbuf, tlsn);
    }
    place_bss(tab, inb);
    if load32(hot_sc(mb), HS_HRUN) == 1 {
        // epoch 字进 bss：地址 = 数据段尾 + 现有 bss，再把它算进 bss 大小。
        // 紧跟着的 8 字节是闸存下来的**调用者帧指针**（`#1152`）—— 固定核按 `epoch+8` 读，
        // 两者必须相邻，所以这里一次留 16 字节。
        let bss0: u32 = cell(tab, C_BSS);
        let ep: u32 = data_base(tab) + align_to(cell(tab, C_GB), 8) + bss0;
        lbl_add(tab, load32(hot_sc(mb), HS_EPOCHN), 18, 0, 0, ep);
        setcell(tab, C_BSS, bss0 + 16);
    }
    // 外部对象的重定位: **所有对象都摆好了**才应用 (docs/173 阶段 2)。
    let rr: u32 = apply_relocs(tab, inb, txt, gb);
    if rr != 0 {
        return rr;
    }
    // **导入**（V2）：所有标签都立好了才挑得出"谁还没定义"。每个导入立一个 PLT 桩的
    // 标签，于是 `resolve_fixups` 把它们指到桩上（而不是报"未定义的标签"）。
    if nshared != 0 {
        let _pa: u32 = collect_imports(tab, inb, tlen);
    }
    let r: u32 = resolve_fixups(tab, inb, txt);
    if r != 0 {
        return r;
    }
    if hot_on(mb) == 1 {
        let _mr: u32 = meta_relocs(mb, tab, txt);
    }
    let dlen: u32 = align_to(cell(tab, C_GB), 8);
    let total: u32 = 0;
    if nshared != 0 {
        tlen = emit_dyn_tail(tab, inb, txt, tlen, dlen, cell(tab, C_BSS));
        // **尾部那几张表也算进文本段**（上面那道 `OUT_CAP` 检查在它之前跑的）——
        // 数据段钉在 `TEXT_VADDR + OUT_CAP`，超了就会盖上去，而**盖上去不报错**。
        if tlen > OUT_CAP {
            let _f: u32 = fail("文本段+动态表超过 OUT_CAP — 抬 OUT_CAP (loment/tools/lomelf.lomt) 与 tools/lomelf.py 的 TEXT_CAP/ELF_DATA_VADDR");
        }
        total = build_elf_dynamic(tab, ob, txt, tlen, gb, dlen, cell(tab, C_BSS),
                                  TEXT_VADDR as u64 + load32(hot_sc(mb), HS_ENTRY) as u64);
    } else if pe == 1 {
        let idata: ptr = ptr_add(tab, TB_IDATA);
        let dd: u32 = 0;
        let rn: u32 = n_idata();
        let k: u32 = 0;
        while k < rn {
            dd = blob_copy(idata, dd, idata_part(k));
            k = k + 1;
        }
        total = build_pe(ob, txt, tlen, gb, dlen, idata, dd);
    } else {
        total = build_elf(tab, ob, txt, tlen, gb, dlen, cell(tab, C_BSS),
                          TEXT_VADDR as u64 + load32(hot_sc(mb), HS_ENTRY) as u64);
    }
    // **点名那个写不出去的文件**: 说"写不了输出"而不说是哪个, 读者手上唯一有用的
    // 那条信息(路径)就没了 —— 而这条最常撞上的起因正是"输出目录不存在", 一看路径就明白
    // (issue #8 的第二条评论)。
    let ofd: i64 = open_wo(ptr_add(pbuf, pout));
    if ofd < 0 {
        // 结构化那一份先落地（有 `--diag-out` 才写），再由 `failc` 打那一行给人看 ——
        // 两个受众都要，理由与驱动程序那边同一条。
        if dg == 1 {
            let _g: u64 = emit_wfail(ptr_add(pbuf, DIAGB_OFF), ptr_add(pbuf, pout), ol);
        }
        return failc("cannot write the output file: ", ptr_add(pbuf, pout));
    }
    write_all(ofd as u64, ob, total as u64);
    syscall4(3, ofd as u64, 0, 0);
    if load32(hot_sc(mb), HS_META) == 1 {
        let mfd: i64 = open_wo(ptr_add(mem, M_HOTPATH));
        if mfd < 0 {
            return fail("cannot write the hot-update metadata file");
        }
        let _mw: u64 = write_all(mfd as u64, mb, load32(hot_sc(mb), HS_MLEN) as u64);
        syscall4(3, mfd as u64, 0, 0);
    }
    return 0;
}
