// block_comment_col.lomt —— **块注释之后的列**（#708）。
//
// 这不是在演示语言特性 —— 它是一份**语料**，钉住两个词法器给出同一组列号。
//
// ## 它为什么存在
//
// 自举侧 `lexer.lomt` 跳过 `/* … */` 时把 `col` 只加了 2（注释的**定界符**），
// 参考侧 `lomc.lex` 干脆一格都不加。于是同一行里块注释之后的每个 token 列号都是错的，
// 而且**两边错得不一样** —— LSP 的 range、`lomenterr` 的 caret、`--short` 都吃这组数。
//
// 语料里从来没有一份源在**同一行**里先写块注释、再写 token，所以孪生判据一直是绿的。
//
// ## 纯 ASCII
//
// 列号在两个实现里的单位不同（参考侧按字符、自举侧按字节）；非 ASCII 会引入另一条
// 已知的差，把这一条要钉的形状淹掉。所以这份源只用 ASCII 字节。
module block_comment_col

/* one line */ fn a() -> u32 {
    /* abcdefgh */ let w: u32 = 0;
    let x: u32 = 1; /* two
lines */ let y: u32 = 2;
    return w + x + y;
}
