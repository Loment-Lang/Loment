    if k == 350 { return "`_start` and `command_main` cannot both exist"; }
    if k == 351 { return "`_start` 与 `command_main` 只能留一个"; }
    if k == 352 { return "a command is declared but `command_main` is missing"; }
    if k == 353 { return "声明了命令却没有 `command_main`"; }
    if k == 354 { return "`command_main` exists without a command declaration"; }
    if k == 355 { return "写了 `command_main` 却没有命令声明"; }
