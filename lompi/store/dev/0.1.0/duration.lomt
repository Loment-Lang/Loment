// dev/duration.lomt — 时长文本（Go 风格）与纳秒整数互转
//
// 为什么开发者工具需要它: 配置里的 `timeout = "1h30m"`、CLI 的 `--interval 250ms`、
// 日志里的 `elapsed 1.234ms` —— 全是"数字 + 单位"的人类文本。解析它的规则不长，
// 但单位前缀（ms / us / µs / ns）、小数、负号、以及"Go 的输出格式"每处都能写错。
//
// 口径: 内部一律 **i64 纳秒**；支持的组件是 `w d h m s ms us µs ns`，
// 可以连写（`1h30m`），可以带小数（`1.5s`），可以带符号。`0` 单独出现表示 0。
//
// 不做的: 月/年（长度不固定）、时区（`civil` 管日期）、ISO 8601 的 `P1DT2H`
// —— 那是另一种语法，需要时单独加。
//
// 命名: 公开 du_*, 内部 du_*。自检 test_duration_*。

module duration
choose runtime

use numfmt
use mem

fn du_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

/// 单位文本 -> 纳秒倍数；未知返回 0。
fn du_unit(s: str, st: u32, ln: u32) -> u64 {
    if ln == 2 && str_byte(s, st) == 110 && str_byte(s, st + 1) == 115 { return 1; }        // ns
    if ln == 2 && str_byte(s, st) == 117 && str_byte(s, st + 1) == 115 { return 1000; }     // us
    if ln == 2 && str_byte(s, st) == 109 && str_byte(s, st + 1) == 115 { return 1000000; }  // ms
    if ln == 2 && str_byte(s, st) == 194 && str_byte(s, st + 1) == 181 { return 1000; }     // µs
    if ln == 1 {
        let c: u32 = str_byte(s, st);
        if c == 115 { return 1000000000; }        // s
        if c == 109 { return 60000000000; }       // m
        if c == 104 { return 3600000000000; }     // h
        if c == 100 { return 86400000000000; }    // d
        if c == 119 { return 604800000000000; }   // w
    }
    return 0 as u64;
}

/// 解析时长。成功写 ok=1 并返回纳秒；失败 ok=0、返回 0。
pub fn du_parse(s: str, ok_out: ptr) -> i64 {
    mem_store32(ok_out, 0, 0);
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let neg: u32 = 0;
    if i < n {
        let c0: u32 = str_byte(s, i);
        if c0 == 45 {
            neg = 1;
            i = i + 1;
        } else if c0 == 43 {
            i = i + 1;
        }
    }
    if i >= n {
        return 0 as i64;
    }
    // 单独的 "0"
    if n - i == 1 && str_byte(s, i) == 48 {
        mem_store32(ok_out, 0, 1);
        return 0 as i64;
    }
    let total: u64 = 0 as u64;
    let any: u32 = 0;
    let going: u32 = 1;
    while going == 1 && i < n {
        if !du_digit(str_byte(s, i)) {
            going = 0;
        } else {
            let whole: u64 = 0 as u64;
            while i < n && du_digit(str_byte(s, i)) {
                whole = whole * (10 as u64) + ((str_byte(s, i) - 48) as u64);
                i = i + 1;
            }
            let frac: u64 = 0 as u64;
            let fd: u32 = 0;
            if i < n && str_byte(s, i) == 46 { // '.'
                i = i + 1;
                while i < n && du_digit(str_byte(s, i)) && fd < 9 {
                    frac = frac * (10 as u64) + ((str_byte(s, i) - 48) as u64);
                    fd = fd + 1;
                    i = i + 1;
                }
            }
            let ust: u32 = i;
            let scanning: u32 = 1;
            while scanning == 1 && i < n {
                let c: u32 = str_byte(s, i);
                if (c >= 97 && c <= 122) || c >= 128 {
                    i = i + 1;
                } else {
                    scanning = 0;
                }
            }
            let u: u64 = du_unit(s, ust, i - ust);
            if u == (0 as u64) {
                mem_store32(ok_out, 0, 0);
                return 0 as i64;
            }
            total = total + whole * u;
            if fd > 0 {
                let div: u64 = 1 as u64;
                let k: u32 = 0;
                while k < fd {
                    div = div * (10 as u64);
                    k = k + 1;
                }
                total = total + (frac * u) / div;
            }
            any = 1;
        }
    }
    if any == 0 || i != n {
        return 0 as i64;
    }
    mem_store32(ok_out, 0, 1);
    if neg == 1 {
        return 0 as i64 - (total as i64);
    }
    return total as i64;
}

fn du_put_u(out: ptr, pos: u32, v: u64) -> u32 {
    return pos + numfmt_dec_into(ptr_add(out, pos), v);
}

fn du_put_c(out: ptr, pos: u32, c: u32) -> u32 {
    store8(out, pos, c as u8);
    return pos + 1;
}

/// 小数部分：`rem` 是余数，`scale` 是该单位的一秒（纳秒倍数）；写 `.ddd` 并去掉尾零。
fn du_put_frac(out: ptr, pos: u32, rem: u64, scale: u64) -> u32 {
    if rem == 0 {
        return pos;
    }
    let p: u32 = du_put_c(out, pos, 46);
    let unit: u64 = scale / (10 as u64);
    let left: u64 = rem;
    let q: u32 = p;
    while unit > (0 as u64) {
        let d: u64 = left / unit;
        q = du_put_c(out, q, 48 + (d as u32));
        left = left % unit;
        unit = unit / (10 as u64);
    }
    // 去掉尾零（保留至少一位）
    let e: u32 = q;
    while e > p + 1 && load8(out, e - 1) == 48 {
        e = e - 1;
    }
    return e;
}

/// 纳秒 -> Go 风格文本（`1h30m0s` / `1.5s` / `250ms` / `1.234µs` / `42ns`）。
pub fn du_format(ns: i64, out: ptr, cap: u32) -> u32 {
    let tmp: ptr = alloc(64);
    let neg: bool = ns < (0 as i64);
    let a: u64 = 0;
    if neg {
        a = ((ns as u64) ^ 18446744073709551615) + 1;
    } else {
        a = ns as u64;
    }
    let pos: u32 = 0;
    if neg {
        pos = du_put_c(tmp, pos, 45);
    }
    if a >= 3600000000000 as u64 { // >= 1h
        pos = du_put_u(tmp, pos, a / 3600000000000);
        pos = du_put_c(tmp, pos, 104); // h
        let rem: u64 = a % 3600000000000;
        pos = du_put_u(tmp, pos, rem / 60000000000);
        pos = du_put_c(tmp, pos, 109); // m
        pos = du_put_u(tmp, pos, (rem % 60000000000) / 1000000000);
        pos = du_put_c(tmp, pos, 115); // s
    } else if a >= 60000000000 as u64 { // >= 1m
        pos = du_put_u(tmp, pos, a / 60000000000);
        pos = du_put_c(tmp, pos, 109);
        pos = du_put_u(tmp, pos, (a % 60000000000) / 1000000000);
        pos = du_put_c(tmp, pos, 115);
    } else if a >= 1000000000 as u64 { // >= 1s
        pos = du_put_u(tmp, pos, a / 1000000000);
        pos = du_put_frac(tmp, pos, a % 1000000000, 1000000000);
        pos = du_put_c(tmp, pos, 115);
    } else if a >= 1000000 as u64 { // ms
        pos = du_put_u(tmp, pos, a / 1000000);
        pos = du_put_frac(tmp, pos, a % 1000000, 1000000);
        pos = du_put_c(tmp, pos, 109);
        pos = du_put_c(tmp, pos, 115);
    } else if a >= 1000 as u64 { // µs
        pos = du_put_u(tmp, pos, a / 1000);
        pos = du_put_frac(tmp, pos, a % 1000, 1000);
        pos = du_put_c(tmp, pos, 194);
        pos = du_put_c(tmp, pos, 181);
        pos = du_put_c(tmp, pos, 115);
    } else {
        pos = du_put_u(tmp, pos, a);
        pos = du_put_c(tmp, pos, 110);
        pos = du_put_c(tmp, pos, 115);
    }
    if pos + 1 > cap {
        return 0;
    }
    mem_copy(out, 0, tmp, 0, pos);
    store8(out, pos, 0 as u8);
    return pos;
}

// ---------------------------------------------------------------- 自检

fn test_duration_parse() -> bool {
    let ok: ptr = alloc(4);
    let a: i64 = du_parse("1h30m", ok);
    let b: i64 = du_parse("250ms", ok);
    return a == 5400000000000 && b == 250000000 && mem_load32(ok, 0) == 1;
}

fn test_duration_parse_fraction() -> bool {
    let ok: ptr = alloc(4);
    return du_parse("1.5s", ok) == 1500000000 && du_parse("-2m", ok) == 0 as i64 - 120000000000;
}

fn test_duration_format() -> bool {
    let b: ptr = alloc(32);
    let n: u32 = du_format(5400000000000, b, 32);
    let want: str = "1h30m0s";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(b, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}
