// lowlevel/pkg.lomp — 库清单（给人看的两个标签；机器身份是内容哈希）。
module pkg

pub fn name() -> str {
    return "lowlevel";
}

pub fn version() -> str {
    return "0.1.0";
}

/// 这个包对**运行期**的需求（`docs/324`）。编译器读它来判断"`no_runtime` 的根能不能
/// 用这个包"；模块自己写的 `choose runtime` 优先。取值只有 `runtime` / `no_runtime`。

/// 这个包对**程序**的前置条件（`docs/325`）。
///
/// `choose()` 列出包里代码依赖的核心档；编译器装载时逐维注入（模块自己写的那一维
/// 优先），根不满足就**点名这个包**报错。`requires()` 列出包的真代码实际用到的构造，
/// 判据拿它和代码逐条对，漏写/多写都红。
pub fn choose() -> str {
    return "std runtime";
}

pub fn requires() -> str {
    return "alloc,str_eq";
}
