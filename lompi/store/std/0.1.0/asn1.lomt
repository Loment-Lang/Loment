// std/asn1.lomt — ASN.1 DER 读取 (游标式)
//
// 为什么是 **DER** 而不是 BER: ASN.1 有三种编码规则, BER 允许"同一件事多种写法"
// (长度可以短式也可以长式, 整数可以多带一个 0x00), CER 折中, 只有 **DER 要求唯一写法**。
// 而"唯一写法"正是**签名**需要的 —— 签名是对字节签的, 同样的结构两种编码就有两个签名,
// 那验证就没法做了。所以证书、CMS、时间戳全用 DER。
//
// 于是本层最要紧的不是"能解出来", 而是**在别人可能用 BER 蒙混的地方报错**:
//   - 长度: 必须定长 (不定长的 0x80 一律拒), 且能用短式就必须用短式
//     (5 个字节写成 `81 05` 是 BER 允许、DER 不允许的)
//   - 整数: 必须最短补码 —— 多一个前导 `00` (非负) 或 `FF` (负) 都拒
//   - 高位标签 (0x1F 起) **不支持**: X.509 / CMS / PKCS 里的标签全是单字节,
//     支持它要引入"标签号任意长"这条复杂度, 收益却是零
//
// 这是**读取层**: 它把 TLV 拆开给你, 不解释 OID 的含义、不验签、不管证书链。
// 那些在上面的层, 而它们都要先有这一层。
//
// 命名: 公开 der_*, 内部 a_*。自检 test_der_*。

module asn1

use "mem.lomt"

pub const DER_ERR: u32 = 4294967295;
pub const DER_NO: u32 = 4294967294;

// 通用标签号 (class=universal, 低 5 位)
pub const DER_BOOLEAN: u32 = 1;
pub const DER_INTEGER: u32 = 2;
pub const DER_BITSTRING: u32 = 3;
pub const DER_OCTETSTRING: u32 = 4;
pub const DER_NULL: u32 = 5;
pub const DER_OID: u32 = 6;
pub const DER_ENUMERATED: u32 = 10;
pub const DER_UTF8STRING: u32 = 12;
pub const DER_PRINTABLESTRING: u32 = 19;
pub const DER_IA5STRING: u32 = 22;
pub const DER_UTCTIME: u32 = 23;
pub const DER_GENERALIZEDTIME: u32 = 24;
pub const DER_SEQUENCE: u32 = 16;
pub const DER_SET: u32 = 17;

// 类别 (高 2 位)
pub const DER_CLASS_UNIVERSAL: u32 = 0;
pub const DER_CLASS_APPLICATION: u32 = 1;
pub const DER_CLASS_CONTEXT: u32 = 2;
pub const DER_CLASS_PRIVATE: u32 = 3;

/// 嵌套深度上限。
pub const DER_MAX_DEPTH: u32 = 64;

// ---------------------------------------------------------------- 标签

pub fn der_class(tag: u32) -> u32 {
    return tag >> 6;
}

pub fn der_is_constructed(tag: u32) -> bool {
    return (tag & 32) != 0;
}

/// 标签号 (低 5 位)。高位标签 (31) 本层不支持。
pub fn der_tag_num(tag: u32) -> u32 {
    return tag & 31;
}

/// 是不是"通用类别里的第 n 号类型"。
pub fn der_is_universal(tag: u32, num: u32) -> bool {
    return der_class(tag) == DER_CLASS_UNIVERSAL && der_tag_num(tag) == num;
}

/// i 处的标签字节; 越界或高位标签给 DER_ERR。
pub fn der_tag_at(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    if i >= n {
        return DER_ERR;
    }
    let t: u32 = load8(d, so + i);
    if der_tag_num(t) == 31 {
        return DER_ERR; // 高位标签: 不支持
    }
    return t;
}

// ---------------------------------------------------------------- 长度

fn a_hlen(v: u32) -> u32 {
    if v < 256 {
        return 1;
    }
    if v < 65536 {
        return 2;
    }
    if v < 16777216 {
        return 3;
    }
    return 4;
}

/// 长度字段占几字节; DER 严格判: 短式能装就必须短式, 不定长一律拒。
/// 返回 0 表示长度字段本身有问题 (调用方给 DER_ERR)。
fn a_lenfield(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    if i >= n {
        return 0;
    }
    let b: u32 = load8(d, so + i);
    if b < 128 {
        return 1; // 短式
    }
    if b == 128 {
        return 0; // 不定长: BER 才有, DER 不许
    }
    let cnt: u32 = b - 128;
    if cnt > 4 {
        return 0; // 长度超过 4 GiB 或非最短 —— 本层都拒
    }
    if i + cnt >= n {
        return 0;
    }
    // **最短形式**: 头一个字节不能是 0
    if load8(d, so + i + 1) == 0 {
        return 0;
    }
    // 能用短式却用了长式 -> 拒
    let v: u32 = a_read_len(d, so, i, cnt);
    if v < 128 {
        return 0;
    }
    return 1 + cnt;
}

fn a_read_len(d: ptr, so: u32, i: u32, cnt: u32) -> u32 {
    let v: u32 = 0;
    let k: u32 = 0;
    while k < cnt {
        v = (v << 8) | load8(d, so + i + 1 + k);
        k = k + 1;
    }
    return v;
}

/// 值的长度 (不含标签与长度字段本身)。
pub fn der_value_len(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    if der_tag_at(d, so, n, i) == DER_ERR {
        return DER_ERR;
    }
    let nf: u32 = a_lenfield(d, so, n, i + 1);
    if nf == 0 {
        return DER_ERR;
    }
    if nf == 1 {
        return load8(d, so + i + 1);
    }
    return a_read_len(d, so, i + 1, nf - 1);
}

/// 标签 + 长度字段一共几字节。
pub fn der_header_len(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    if der_tag_at(d, so, n, i) == DER_ERR {
        return DER_ERR;
    }
    let nf: u32 = a_lenfield(d, so, n, i + 1);
    if nf == 0 {
        return DER_ERR;
    }
    return 1 + nf;
}

/// 整个元素 (标签 + 长度 + 值) 的长度。
pub fn der_element_len(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    let h: u32 = der_header_len(d, so, n, i);
    if h == DER_ERR {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR {
        return DER_ERR;
    }
    return h + L;
}

/// 值的第一个字节的下标。
pub fn der_value_at(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    let h: u32 = der_header_len(d, so, n, i);
    if h == DER_ERR {
        return DER_ERR;
    }
    return i + h;
}

/// 跳过整个元素, 返回其后的位置。
pub fn der_skip(d: ptr, so: u32, n: u32, i0: u32) -> u32 {
    return a_skip(d, so, n, i0, 0);
}

/// 原始类型内容的 DER 合规检查。返回 false = 不是 DER 写法。
fn a_check_primitive(d: ptr, so: u32, n: u32, i: u32, t: u32, L: u32) -> bool {
    if der_class(t) != DER_CLASS_UNIVERSAL {
        return true; // 上下文/私有标签的内容由上层解释, 这里不越界去管
    }
    let num: u32 = der_tag_num(t);
    let p: u32 = der_value_at(d, so, n, i);
    if num == DER_NULL {
        return L == 0;
    }
    if num == DER_BOOLEAN {
        if L != 1 {
            return false;
        }
        let b: u32 = load8(d, so + p);
        return b == 0 || b == 255; // DER 只有 00 和 FF 两种
    }
    if num == DER_BITSTRING {
        if L == 0 {
            return false;
        }
        let unused: u32 = load8(d, so + p);
        if unused > 7 {
            return false;
        }
        if unused > 0 {
            let last: u32 = load8(d, so + p + L - 1);
            let mask: u32 = (1 << unused) - 1;
            if (last & mask) != 0 {
                return false; // 没用的位必须是 0
            }
        }
        return true;
    }
    if num == DER_INTEGER || num == DER_ENUMERATED {
        if L == 0 {
            return false;
        }
        if L >= 2 {
            let b0: u32 = load8(d, so + p);
            let b1: u32 = load8(d, so + p + 1);
            if b0 == 0 && b1 < 128 {
                return false; // 多带一个前导 00
            }
            if b0 == 255 && b1 >= 128 {
                return false; // 多带一个前导 FF
            }
        }
        return true;
    }
    return true;
}

fn a_skip(d: ptr, so: u32, n: u32, i: u32, depth: u32) -> u32 {
    if depth > DER_MAX_DEPTH {
        return DER_ERR;
    }
    let t: u32 = der_tag_at(d, so, n, i);
    if t == DER_ERR {
        return DER_ERR;
    }
    let h: u32 = der_header_len(d, so, n, i);
    if h == DER_ERR {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR {
        return DER_ERR;
    }
    let e: u32 = i + h + L;
    if e > n {
        return DER_ERR; // 值超出缓冲
    }
    // 原始类型: DER 对**内容**也有要求, 不查的话 `der_validate` 就只是"结构走得通",
    // 而 BER 的写法全都能走通 —— 那样这个函数名字就骗人了。
    if der_is_constructed(t) == false {
        if a_check_primitive(d, so, n, i, t, L) == false {
            return DER_ERR;
        }
        return e;
    }
    // 构造类型 (SEQUENCE/SET/显式标签): 里面装的是别的 TLV, 一个个走完
    if der_is_constructed(t) && (L > 0) {
        let p: u32 = i + h;
        let k: u32 = 0;
        while p < e {
            let q: u32 = a_skip(d, so, n, p, depth + 1);
            if q == DER_ERR || q <= p {
                return DER_ERR;
            }
            p = q;
            k = k + 1;
        }
        if p != e {
            return DER_ERR; // 里面的元素没正好填满, 说明长度写错了
        }
    } else if der_is_constructed(t) && L == 0 {
        // 空 SEQUENCE 是合法的 (0x30 0x00)
        return e;
    }
    return e;
}

/// 整段正好是一个 DER 元素。构造类型的内部也会逐个校验, 所以"能过"是有分量的。
pub fn der_validate(d: ptr, so: u32, n: u32) -> bool {
    let e: u32 = der_skip(d, so, n, 0);
    return e == n;
}

// ---------------------------------------------------------------- 取值

pub fn der_bool(d: ptr, so: u32, n: u32, i: u32, ok_out: ptr) -> bool {
    mem_store32(ok_out, 0, 0);
    if der_is_universal(der_tag_at(d, so, n, i), DER_BOOLEAN) == false {
        return false;
    }
    if der_value_len(d, so, n, i) != 1 {
        return false; // DER 规定 BOOLEAN 恰好 1 字节
    }
    mem_store32(ok_out, 0, 1);
    // DER 里 TRUE 只能是 0xFF (BER 允许任意非 0, DER 不许)
    return load8(d, so + der_value_at(d, so, n, i)) != 0;
}

pub fn der_is_null(d: ptr, so: u32, n: u32, i: u32) -> bool {
    if der_is_universal(der_tag_at(d, so, n, i), DER_NULL) == false {
        return false;
    }
    return der_value_len(d, so, n, i) == 0;
}

/// 整数 (或 ENUMERATED) 内容的长度, **含符号字节**。
pub fn der_int_len(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    let t: u32 = der_tag_at(d, so, n, i);
    if der_is_universal(t, DER_INTEGER) == false && der_is_universal(t, DER_ENUMERATED) == false {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR || L == 0 {
        return DER_ERR; // DER 里的整数至少要 1 个字节
    }
    // **最短补码**: 多一个前导 00 (非负) 或 FF (负) 就是 BER 写法, 拒掉
    let p: u32 = der_value_at(d, so, n, i);
    if p + L > n {
        return DER_ERR;
    }
    let b0: u32 = load8(d, so + p);
    if L >= 2 {
        let b1: u32 = load8(d, so + p + 1);
        if b0 == 0 && b1 < 128 {
            return DER_ERR;
        }
        if b0 == 255 && b1 >= 128 {
            return DER_ERR;
        }
    }
    return L;
}

pub fn der_int_is_negative(d: ptr, so: u32, n: u32, i: u32) -> bool {
    let L: u32 = der_int_len(d, so, n, i);
    if L == DER_ERR {
        return false;
    }
    let p: u32 = der_value_at(d, so, n, i);
    return load8(d, so + p) >= 128;
}

/// 非负整数取成 u64。负数、装不下、或不是整数都给 ok=0。
pub fn der_int_u64(d: ptr, so: u32, n: u32, i: u32, ok_out: ptr) -> u64 {
    mem_store32(ok_out, 0, 0);
    let L: u32 = der_int_len(d, so, n, i);
    if L == DER_ERR {
        return 0;
    }
    let p: u32 = der_value_at(d, so, n, i);
    if load8(d, so + p) >= 128 {
        return 0; // 负数
    }
    let v: u64 = 0;
    let k: u32 = 0;
    while k < L {
        if v > 72057594037927935 {
            return 0; // v << 8 会溢出
        }
        v = (v << 8) | (load8(d, so + p + k) as u64);
        k = k + 1;
    }
    mem_store32(ok_out, 0, 1);
    return v;
}

/// 有符号整数取成 i64 (含负数)。装不下给 ok=0。
pub fn der_int_i64(d: ptr, so: u32, n: u32, i: u32, ok_out: ptr) -> i64 {
    mem_store32(ok_out, 0, 0);
    let L: u32 = der_int_len(d, so, n, i);
    if L == DER_ERR || L > 8 {
        return 0;
    }
    let p: u32 = der_value_at(d, so, n, i);
    let neg: bool = load8(d, so + p) >= 128;
    // 先把整段当**无符号**读出来 (补码的位模式), 负数等下再减去 2^(8*L)
    let v: u64 = 0;
    let k: u32 = 0;
    while k < L {
        v = (v << 8) | (load8(d, so + p + k) as u64);
        k = k + 1;
    }
    mem_store32(ok_out, 0, 1);
    if !neg {
        if v > 9223372036854775807 {
            mem_store32(ok_out, 0, 0);
            return 0;
        }
        return v as i64;
    }
    // 负: 先按无符号读出来, 再减去 2^(8*L)
    let zero: i64 = 0;
    let w: i64 = v as i64;
    let span: u32 = 8 * L;
    // 2^(8*L) 当 L<8 时是一个可表示的正数; L==8 时它等于 2^64, 用零减就够了
    if span >= 64 {
        return w;
    }
    let pw: u64 = (1 as u64) << span;
    return w - (pw as i64);
}

/// OCTET STRING / BIT STRING 的内容 (BIT STRING 会**去掉**开头那个未用位数),
/// 写进 out, 返回长度。
pub fn der_bytes(d: ptr, so: u32, n: u32, i: u32, out: ptr, oo: u32) -> u32 {
    let t: u32 = der_tag_at(d, so, n, i);
    let is_oct: bool = der_is_universal(t, DER_OCTETSTRING);
    let is_bit: bool = der_is_universal(t, DER_BITSTRING);
    if is_oct == false && is_bit == false {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR {
        return DER_ERR;
    }
    let p: u32 = der_value_at(d, so, n, i);
    // **声明长度超出缓冲就得拒**: 不查的话会读到元素外面的字节 (还在缓冲里, 所以不崩,
    // 但拿到的是别的数据) —— 那比崩了还难查。
    if p + L > n {
        return DER_ERR;
    }
    if is_oct {
        mem_copy(out, oo, d, so + p, L);
        return L;
    }
    if L == 0 {
        return DER_ERR; // BIT STRING 至少要那个未用位数字节
    }
    let unused: u32 = load8(d, so + p);
    if unused > 7 {
        return DER_ERR;
    }
    // DER 规定: 没用的位必须是 0。最后那个字节的低 unused 位必须全 0。
    if unused > 0 {
        let last: u32 = load8(d, so + p + L - 1);
        let mask: u32 = (1 << unused) - 1;
        if (last & mask) != 0 {
            return DER_ERR;
        }
    }
    mem_copy(out, oo, d, so + p + 1, L - 1);
    return L - 1;
}

/// BIT STRING 开头那个"未用位数" (0..7); 不是 BIT STRING 给 DER_ERR。
pub fn der_bitstring_unused(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    if der_is_universal(der_tag_at(d, so, n, i), DER_BITSTRING) == false {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR || L == 0 {
        return DER_ERR;
    }
    let p: u32 = der_value_at(d, so, n, i);
    if p + L > n {
        return DER_ERR;
    }
    let u: u32 = load8(d, so + p);
    if u > 7 {
        return DER_ERR;
    }
    return u;
}

/// OID 写成点分十进制 (`1.2.840.113549.1.1.11`)。
///
/// 前两个数字挤在**第一个字节**里: `40 * a + b`, 所以 2.5 -> 85 ——
/// 反解时 a = min(首字节 / 40, 2), b = 首字节 - 40*a。这条 peg 了 ASN.1 的出生年代。
pub fn der_oid_text(d: ptr, so: u32, n: u32, i: u32, out: ptr, oo: u32) -> u32 {
    if der_is_universal(der_tag_at(d, so, n, i), DER_OID) == false {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR || L == 0 {
        return DER_ERR;
    }
    let p: u32 = der_value_at(d, so, n, i);
    if p + L > n {
        return DER_ERR;
    }
    let first: u32 = load8(d, so + p);
    // `if` 不是表达式 —— 只能先赋值再改
    let a: u32 = first / 40;
    if a > 2 {
        a = 2;
    }
    let b: u32 = first - 40 * a;
    let w: u32 = oo;
    w = w + der_dec(out, w, a);
    store8(out, w, 46 as u8); // '.'
    w = w + 1;
    w = w + der_dec(out, w, b);
    // 剩下的每个数都是 base-128, 最高位是"还有下一个"的标志
    let k: u32 = p + 1;
    let cur: u64 = 0;
    while k < p + L {
        let byte: u32 = load8(d, so + k);
        if cur > 72057594037927935 {
            return DER_ERR;
        }
        cur = (cur << 7) | ((byte & 127) as u64);
        if (byte & 128) == 0 {
            store8(out, w, 46 as u8);
            w = w + 1;
            w = w + der_dec64(out, w, cur);
            cur = 0;
        }
        k = k + 1;
    }
    // 最后一个数没有收尾字节 = 编码残缺
    if cur != 0 {
        return DER_ERR;
    }
    return w - oo;
}

fn der_dec(out: ptr, o: u32, v: u32) -> u32 {
    return der_dec64(out, o, v as u64);
}

fn der_dec64(out: ptr, o: u32, v0: u64) -> u32 {
    if v0 == 0 {
        store8(out, o, 48 as u8);
        return 1;
    }
    let tmp: ptr = alloc(24);
    let k: u32 = 0;
    let v: u64 = v0;
    while v > 0 {
        store8(tmp, k, (48 + (v % 10) as u32) as u8);
        v = v / 10;
        k = k + 1;
    }
    let j: u32 = 0;
    while j < k {
        store8(out, o + j, load8(tmp, k - 1 - j) as u8);
        j = j + 1;
    }
    return k;
}

// ---------------------------------------------------------------- 顺序遍历

/// 容器 (构造类型) 里第一个子元素的下标; 空的给 DER_NO。
pub fn der_seq_first(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    let t: u32 = der_tag_at(d, so, n, i);
    if t == DER_ERR {
        return DER_ERR;
    }
    if der_is_constructed(t) == false {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR {
        return DER_ERR;
    }
    if L == 0 {
        return DER_NO;
    }
    return der_value_at(d, so, n, i);
}

/// 从 cur 走到下一个兄弟元素; 容器到头给 DER_NO。
pub fn der_seq_next(d: ptr, so: u32, n: u32, i: u32, cur: u32) -> u32 {
    let e: u32 = der_element_len(d, so, n, cur);
    if e == DER_ERR {
        return DER_ERR;
    }
    let L: u32 = der_value_len(d, so, n, i);
    if L == DER_ERR {
        return DER_ERR;
    }
    let end: u32 = der_value_at(d, so, n, i) + L;
    let nxt: u32 = cur + e;
    if nxt >= end {
        return DER_NO;
    }
    return nxt;
}

/// 容器里数几个子元素。
pub fn der_seq_len(d: ptr, so: u32, n: u32, i: u32) -> u32 {
    let v: u32 = der_seq_first(d, so, n, i);
    let c: u32 = 0;
    while v != DER_NO && v != DER_ERR {
        c = c + 1;
        v = der_seq_next(d, so, n, i, v);
    }
    return c;
}

pub fn der_seq_at(d: ptr, so: u32, n: u32, i: u32, idx: u32) -> u32 {
    let v: u32 = der_seq_first(d, so, n, i);
    let c: u32 = 0;
    while v != DER_NO && v != DER_ERR && c < idx {
        v = der_seq_next(d, so, n, i, v);
        c = c + 1;
    }
    return v;
}

/// 在容器里找**第一个** 通用标签号为 tag_num 的子元素 (只看这一层)。
pub fn der_seq_find(d: ptr, so: u32, n: u32, i: u32, tag_num: u32) -> u32 {
    let v: u32 = der_seq_first(d, so, n, i);
    while v != DER_NO && v != DER_ERR {
        if der_is_universal(der_tag_at(d, so, n, v), tag_num) {
            return v;
        }
        v = der_seq_next(d, so, n, i, v);
    }
    return v;
}

// ---------------------------------------------------------------- 自检

fn a_hv(c: u32) -> u32 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return c - 55;
}

fn a_hx(out: ptr, s: str) -> u32 {
    let n: u32 = str_len(s);
    let k: u32 = 0;
    while k < n / 2 {
        let hi: u32 = a_hv(str_byte(s, k * 2));
        let lo: u32 = a_hv(str_byte(s, k * 2 + 1));
        store8(out, k, ((hi << 4) | lo) as u8);
        k = k + 1;
    }
    return n / 2;
}

fn test_der_integer_forms() -> bool {
    let ok: ptr = alloc(8);
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "020100"); // INTEGER 0
    let ok1: bool = der_int_u64(a, 0, na, 0, ok) == 0 && mem_load32(ok, 0) == 1
        && der_validate(a, 0, na);
    let b: ptr = alloc(16);
    let nb: u32 = a_hx(b, "02017f"); // 127
    let ok2: bool = der_int_u64(b, 0, nb, 0, ok) == 127;
    let c: ptr = alloc(16);
    let nc: u32 = a_hx(c, "02020080"); // 128 —— 必须补一个 00 才不会变成负数
    let ok3: bool = der_int_u64(c, 0, nc, 0, ok) == 128 && mem_load32(ok, 0) == 1;
    let e: ptr = alloc(16);
    let ne: u32 = a_hx(e, "020180"); // -128
    // **先取再判**: ok 是复用的一块内存, 上一次调用留下的 1 会骗过下一个断言
    let ev: u64 = der_int_u64(e, 0, ne, 0, ok);
    let ok4: bool = der_int_is_negative(e, 0, ne, 0) && mem_load32(ok, 0) == 0 && ev == 0;
    return ok1 && ok2 && ok3 && ok4;
}

fn test_der_integer_negative_roundtrip() -> bool {
    let ok: ptr = alloc(8);
    let zero: i64 = 0;
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "020180");
    let ok1: bool = der_int_i64(a, 0, na, 0, ok) == (zero - 128) && mem_load32(ok, 0) == 1;
    let b: ptr = alloc(16);
    let nb: u32 = a_hx(b, "0202ff7f"); // -129
    let ok2: bool = der_int_i64(b, 0, nb, 0, ok) == (zero - 129);
    let c: ptr = alloc(16);
    let nc: u32 = a_hx(c, "0201ff"); // -1
    let ok3: bool = der_int_i64(c, 0, nc, 0, ok) == (zero - 1);
    let e: ptr = alloc(16);
    let ne: u32 = a_hx(e, "0201fe"); // -2
    let ok4: bool = der_int_i64(e, 0, ne, 0, ok) == (zero - 2);
    return ok1 && ok2 && ok3 && ok4;
}

fn test_der_rejects_non_minimal_integer() -> bool {
    // 02 02 00 7F 是 BER 允许的 127 (多带了一个 00), DER 必须拒 ——
    // 不拒的话同一个数有两种编码, 签名就没意义了。
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "0202007f");
    let ok1: bool = der_int_len(a, 0, na, 0) == DER_ERR && der_validate(a, 0, na) == false;
    // 02 02 FF 80 是 -128 的多余写法
    let b: ptr = alloc(16);
    let nb: u32 = a_hx(b, "0202ff80");
    let ok2: bool = der_int_len(b, 0, nb, 0) == DER_ERR;
    return ok1 && ok2;
}

fn test_der_rejects_non_minimal_length() -> bool {
    // 04 81 05 ... : 5 个字节该用短式写, 用长式是 BER 写法, DER 拒。
    let a: ptr = alloc(32);
    let na: u32 = a_hx(a, "0481056162636465");
    let ok1: bool = der_value_len(a, 0, na, 0) == DER_ERR && der_validate(a, 0, na) == false;
    // 04 81 80 ... : 长度 128 用长式是对的, 要能过
    let b: ptr = alloc(256);
    let nb: u32 = a_hx(b, "048180");
    let k: u32 = 0;
    while k < 128 {
        store8(b, 3 + k, 170 as u8);
        k = k + 1;
    }
    let ok2: bool = der_validate(b, 0, 131) && der_value_len(b, 0, 131, 0) == 128;
    return ok1 && ok2;
}

fn test_der_rejects_indefinite_length() -> bool {
    // 30 80 ... 00 00 是 BER 的不定长 SEQUENCE, DER 一律拒。
    let a: ptr = alloc(32);
    let na: u32 = a_hx(a, "308002010000");
    return der_value_len(a, 0, na, 0) == DER_ERR && der_validate(a, 0, na) == false;
}

fn test_der_boolean_and_null() -> bool {
    let ok: ptr = alloc(8);
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "0101ff");
    let ok1: bool = der_bool(a, 0, na, 0, ok) && mem_load32(ok, 0) == 1;
    let b: ptr = alloc(16);
    let nb: u32 = a_hx(b, "010100");
    let ok2: bool = der_bool(b, 0, nb, 0, ok) == false && mem_load32(ok, 0) == 1;
    let c: ptr = alloc(16);
    let nc: u32 = a_hx(c, "0500");
    let ok3: bool = der_is_null(c, 0, nc, 0) && der_validate(c, 0, nc);
    // BOOLEAN 长度不是 1 就是非法的
    let e: ptr = alloc(16);
    let ne: u32 = a_hx(e, "0102ffff");
    let ok4: bool = der_bool(e, 0, ne, 0, ok) == false && mem_load32(ok, 0) == 0;
    return ok1 && ok2 && ok3 && ok4;
}

fn test_der_octet_string() -> bool {
    let out: ptr = alloc(32);
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "0403616263");
    let L: u32 = der_bytes(a, 0, na, 0, out, 0);
    let want: str = "abc";
    return L == 3 && mem_eq(out, 0, str_ptr(want), 0, 3) && der_validate(a, 0, na);
}

fn test_der_bitstring_unused_bits() -> bool {
    let o: ptr = alloc(16);
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "030200ff"); // 0 个未用位, 载荷 FF
    let ok1: bool = der_bitstring_unused(a, 0, na, 0) == 0 && der_validate(a, 0, na);
    // 7 个未用位, 载荷 0x80 —— 低 7 位确实是 0, 合法
    let b: ptr = alloc(16);
    let nb: u32 = a_hx(b, "03020780");
    let ok2: bool = der_bitstring_unused(b, 0, nb, 0) == 7 && der_validate(b, 0, nb);
    let bl: u32 = der_bytes(b, 0, nb, 0, o, 0);
    let ok3: bool = bl == 1 && load8(o, 0) == 128;
    // 低 unused 位非 0 -> DER 违规 (BER 允许, DER 不许)
    let c: ptr = alloc(16);
    let nc: u32 = a_hx(c, "030207ff");
    let ok4: bool = der_bytes(c, 0, nc, 0, o, 0) == DER_ERR && der_validate(c, 0, nc) == false;
    // 未用位数 > 7 是编码错
    let e: ptr = alloc(16);
    let ne: u32 = a_hx(e, "030208ff");
    let ok5: bool = der_bitstring_unused(e, 0, ne, 0) == DER_ERR;
    return ok1 && ok2 && ok3 && ok4 && ok5;
}

fn test_der_rejects_length_past_buffer() -> bool {
    // 声明长度比缓冲里实际的字节多 —— 必须拒, 而不是把后面的字节当成自己的内容读。
    let d: ptr = alloc(16);
    let o: ptr = alloc(16);
    store8(d, 0, 3 as u8);   // BIT STRING
    store8(d, 1, 3 as u8);   // 说好 3 个字节
    store8(d, 2, 7 as u8);   // 未用位 7
    store8(d, 3, 255 as u8); // 只有 1 个载荷字节
    // 后面再塞几个字节, 用来证明"没越界去读它们"
    store8(d, 4, 102 as u8);
    store8(d, 5, 102 as u8);
    let ok1: bool = der_bytes(d, 0, 4, 0, o, 0) == DER_ERR;
    let ok2: bool = der_validate(d, 0, 4) == false;
    // 整数同理
    let e: ptr = alloc(16);
    store8(e, 0, 2 as u8);
    store8(e, 1, 4 as u8);
    store8(e, 2, 1 as u8);
    store8(e, 3, 2 as u8);
    let ok3: bool = der_int_len(e, 0, 4, 0) == DER_ERR;
    return ok1 && ok2 && ok3;
}

fn test_der_sequence() -> bool {
    // SEQUENCE { INTEGER 1, BOOLEAN true } = 30 06 02 01 01 01 01 FF
    let d: ptr = alloc(16);
    let ok: ptr = alloc(8);
    let n: u32 = a_hx(d, "30060201010101ff");
    let ok1: bool = der_validate(d, 0, n) && der_seq_len(d, 0, n, 0) == 2;
    let e0: u32 = der_seq_at(d, 0, n, 0, 0);
    let ok2: bool = der_int_u64(d, 0, n, e0, ok) == 1;
    let e1: u32 = der_seq_at(d, 0, n, 0, 1);
    let ok3: bool = der_bool(d, 0, n, e1, ok) && mem_load32(ok, 0) == 1;
    // 空的 SEQUENCE 也合法
    let e: ptr = alloc(8);
    let ne: u32 = a_hx(e, "3000");
    return ok1 && ok2 && ok3 && der_validate(e, 0, ne) && der_seq_first(e, 0, ne, 0) == DER_NO;
}

fn test_der_sequence_find_by_tag() -> bool {
    // SEQUENCE { NULL, OCTET STRING "hi" } —— 按标签号找跳过 NULL
    let d: ptr = alloc(32);
    let n: u32 = a_hx(d, "3006050004026869");
    let ok1: bool = der_validate(d, 0, n) && der_seq_len(d, 0, n, 0) == 2;
    let oc: u32 = der_seq_find(d, 0, n, 0, DER_OCTETSTRING);
    let ok2: bool = der_is_universal(der_tag_at(d, 0, n, oc), DER_OCTETSTRING);
    let out: ptr = alloc(16);
    let L: u32 = der_bytes(d, 0, n, oc, out, 0);
    let want: str = "hi";
    return ok1 && ok2 && L == 2 && mem_eq(out, 0, str_ptr(want), 0, 2);
}

fn test_der_oid_sha256_with_rsa() -> bool {
    // 06 09 2A 86 48 86 F7 0D 01 01 0B = 1.2.840.113549.1.1.11
    let d: ptr = alloc(32);
    let out: ptr = alloc(64);
    let n: u32 = a_hx(d, "06092a864886f70d01010b");
    let L: u32 = der_oid_text(d, 0, n, 0, out, 0);
    let want: str = "1.2.840.113549.1.1.11"; // 21 个字符
    return der_validate(d, 0, n) && L == 21 && mem_eq(out, 0, str_ptr(want), 0, 21);
}

fn test_der_oid_two_digit_first_byte() -> bool {
    // 2.5.4.3 -> 06 03 55 04 03  (55 = 40*2 + 5)
    let d: ptr = alloc(16);
    let out: ptr = alloc(32);
    let n: u32 = a_hx(d, "0603550403");
    let L: u32 = der_oid_text(d, 0, n, 0, out, 0);
    let want: str = "2.5.4.3";
    return L == 7 && mem_eq(out, 0, str_ptr(want), 0, 7);
}

fn test_der_oid_common_name() -> bool {
    // 1.2.840.113549.1.9.1 (emailAddress)
    let d: ptr = alloc(32);
    let out: ptr = alloc(64);
    let n: u32 = a_hx(d, "06092a864886f70d010901");
    let L: u32 = der_oid_text(d, 0, n, 0, out, 0);
    let want: str = "1.2.840.113549.1.9.1";
    return L == 20 && mem_eq(out, 0, str_ptr(want), 0, 19);
}

fn test_der_oid_rejects_truncated_base128() -> bool {
    // 最后一个数没有收尾字节 (最高位一直是 1) —— 编码残缺
    let d: ptr = alloc(16);
    let out: ptr = alloc(32);
    let n: u32 = a_hx(d, "06032a86f7"); // 2a 86 f7: f7 的最高位是 1, 没有收尾
    return der_oid_text(d, 0, n, 0, out, 0) == DER_ERR;
}

fn test_der_nested_sequence() -> bool {
    // SEQUENCE { SEQUENCE { INTEGER 5 }, INTEGER 6 }
    let d: ptr = alloc(32);
    let ok: ptr = alloc(8);
    let n: u32 = a_hx(d, "30083003020105020106");
    let ok1: bool = der_validate(d, 0, n) && der_seq_len(d, 0, n, 0) == 2;
    let inner: u32 = der_seq_at(d, 0, n, 0, 0);
    let ok2: bool = der_seq_len(d, 0, n, inner) == 1;
    let i0: u32 = der_seq_first(d, 0, n, inner);
    let ok3: bool = der_int_u64(d, 0, n, i0, ok) == 5;
    let e1: u32 = der_seq_at(d, 0, n, 0, 1);
    let ok4: bool = der_int_u64(d, 0, n, e1, ok) == 6;
    return ok1 && ok2 && ok3 && ok4;
}

fn test_der_rejects_bad_inner_length() -> bool {
    // 30 07 02 01 01 : 说好里面 7 字节, 实际只有 3 —— 长度写错最典型的形态。
    // 这一条不能只看"外面的长度够不够", **必须真的走完里面那些 TLV** 才能发现。
    let d: ptr = alloc(16);
    let n: u32 = a_hx(d, "3007020101");
    return der_validate(d, 0, n) == false;
}

fn test_der_rejects_trailing_and_truncated() -> bool {
    // 元素后面多出字节
    let a: ptr = alloc(16);
    let na: u32 = a_hx(a, "05000500");
    let ok1: bool = der_validate(a, 0, na) == false;
    // 长度说 3 个字节, 只给了 2
    let b: ptr = alloc(16);
    let nb: u32 = a_hx(b, "04036162");
    let ok2: bool = der_validate(b, 0, nb) == false;
    // 空缓冲
    let c: ptr = alloc(8);
    let ok3: bool = der_validate(c, 0, 0) == false;
    return ok1 && ok2 && ok3;
}

fn test_der_rejects_high_tag() -> bool {
    // 1F 起的"高位标签"本层不支持 —— 要支持得引入任意长标签号, X.509 里用不到。
    let d: ptr = alloc(16);
    let n: u32 = a_hx(d, "1f8103ff0000");
    return der_tag_at(d, 0, n, 0) == DER_ERR && der_validate(d, 0, n) == false;
}

/// 造一个 depth 层嵌套的空 SEQUENCE 写进 out, 返回总长度。
/// 从最里层往外包, 每包一层长度就变; 长度 ≥128 时头自然变成 `30 81 xx`。
fn mk_nested(out: ptr, depth: u32, tmp: ptr) -> u32 {
    store8(out, 0, 48 as u8); // '0' = SEQUENCE
    store8(out, 1, 0 as u8);  // 空
    let len: u32 = 2;
    let i: u32 = 0;
    while i < depth {
        store8(tmp, 0, 48 as u8);
        let body: u32 = 0;
        if len < 128 {
            store8(tmp, 1, len as u8);
            body = 2;
        } else {
            store8(tmp, 1, 129 as u8);
            store8(tmp, 2, len as u8);
            body = 3;
        }
        mem_copy(tmp, body, out, 0, len);
        mem_copy(out, 0, tmp, 0, body + len);
        len = body + len;
        i = i + 1;
    }
    return len;
}

fn test_der_depth_guard() -> bool {
    // 每层包一层 SEQUENCE: 20 层要过, 100 层要被拒 —— 而不是把栈吃穿。
    let a: ptr = alloc(512);
    let ta: ptr = alloc(512);
    let la: u32 = mk_nested(a, 20, ta);
    let ok1: bool = der_validate(a, 0, la);
    let b: ptr = alloc(1024);
    let tb: ptr = alloc(1024);
    let lb: u32 = mk_nested(b, 100, tb);
    let ok2: bool = der_validate(b, 0, lb) == false;
    return ok1 && ok2;
}

fn test_der_realish_certificate_skeleton() -> bool {
    // 一段"很像证书"的最小骨架:
    //   30 14                                    -- 内容 20 = 5 + 13 + 2
    //     30 03 02 01 02                         -- 版本 2 (5 字节)
    //     30 0b 06 09 2a864886f70d01010b         -- OID 1.2.840.113549.1.1.11 (13 字节)
    //     30 00                                  -- 空参数 (2 字节)
    // 长度是**里面三块加起来**得出的。我第一次把内层的 0x0b 写成了总长 0x0d,
    // 于是它多吃了后面那个空 SEQUENCE —— 而那个字节流**仍然是合法 DER**,
    // 只是含义不一样。这种错 `der_validate` 抓不到, 只有数一遍子元素才发现。
    let d: ptr = alloc(64);
    let out: ptr = alloc(64);
    let ok: ptr = alloc(8);
    let n: u32 = a_hx(d, "30143003020102300b06092a864886f70d01010b3000");
    let ok1: bool = der_validate(d, 0, n) && der_seq_len(d, 0, n, 0) == 3;
    let alg: u32 = der_seq_at(d, 0, n, 0, 1);
    let oid: u32 = der_seq_first(d, 0, n, alg);
    let L: u32 = der_oid_text(d, 0, n, oid, out, 0);
    let want: str = "1.2.840.113549.1.1.11";
    let ver: u32 = der_seq_at(d, 0, n, 0, 0);
    let v: u64 = der_int_u64(d, 0, n, der_seq_first(d, 0, n, ver), ok);
    let params: u32 = der_seq_at(d, 0, n, 0, 2);
    return ok1 && L == 21 && mem_eq(out, 0, str_ptr(want), 0, 21)
        && v == 2 && mem_load32(ok, 0) == 1 && der_seq_first(d, 0, n, params) == DER_NO;
}
