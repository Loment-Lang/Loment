// std/semrange.lomt — SemVer 范围匹配（`^` `~` `>=` `<=` `<` `>` `=` 与 x 通配）
//
// 为什么单独一份: `semver` 只回答"两个版本谁大"；范围还要回答"**一组**版本里哪些算
// 满足"。而各家的范围语法在边界上并不一致（npm 的 `^0.2.3` 是 `<0.3.0`，不是 `<1.0.0`），
// 所以这一份把规则**写死在注释里**，不假装"和某个包管理器完全一样"。
//
// 支持的形状（逗号或空格分隔 = AND）:
//   `*` `1` `1.2` `1.2.3` `1.x` `1.2.x`
//   `=1.2.3` `>1.2.3` `>=1.2.3` `<1.2.3` `<=1.2.3`
//   `^1.2.3` `~1.2.3`
//
// 边界（写明，不猜）:
//   * `^1.2.3` -> >=1.2.3 <2.0.0；`^0.2.3` -> >=0.2.3 <0.3.0；`^0.0.3` -> >=0.0.3 <0.0.4；
//   * `~1.2.3` -> >=1.2.3 <1.3.0；`~1.2` -> >=1.2.0 <1.3.0；`~1` -> >=1.0.0 <2.0.0；
//   * 裸 `1.2` 等价于 `1.2.x`（>=1.2.0 <1.3.0），裸 `1` 等价于 `1.x`；
//   * `<=1.2` 按 `<=1.2.0` 处理（不会自动扩到 1.2.x）—— 要扩请写 `1.2.x`。
//
// 不做的: 预发布版本的"默认不匹配"规则、`||` 或、连字符范围 `1.2 - 1.4`。
//
// 命名: 公开 sr_*, 内部 sr_*。自检 test_semrange_*。

module semrange
choose runtime

use mem
use "semver.lomt"

pub const SR_OK: u32 = 0;
pub const SR_ERR: u32 = 4294967295;

fn sr_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn sr_x(c: u32) -> bool {
    return c == 120 || c == 88 || c == 42; // x X *
}

fn sr_space(c: u32) -> bool {
    return c == 32 || c == 9 || c == 44; // space / tab / comma
}

/// 解析一个部分版本 `1` / `1.2` / `1.2.3` / `1.x`。写 16 字节：
/// `[major, minor, patch, mask]`（mask 位 1/2/4 = 出现了哪几段）。
fn sr_pv(s: str, st: u32, ln: u32, out: ptr) -> u32 {
    mem_store32(out, 0, 0);
    mem_store32(out, 4, 0);
    mem_store32(out, 8, 0);
    mem_store32(out, 12, 0);
    let i: u32 = 0;
    let part: u32 = 0;
    let mask: u32 = 0;
    while i < ln {
        let c: u32 = str_byte(s, st + i);
        if c == 46 { // '.'
            part = part + 1;
            if part > 2 {
                return SR_ERR;
            }
            i = i + 1;
        } else if sr_x(c) {
            // 通配：本段与之后都算"没出现"
            while i < ln && str_byte(s, st + i) != 46 {
                i = i + 1;
            }
            if i < ln {
                i = i + 1;
            }
            // 跳过后续段
            while i < ln {
                i = i + 1;
            }
        } else if sr_digit(c) {
            let v: u32 = 0;
            while i < ln && sr_digit(str_byte(s, st + i)) {
                v = v * 10 + (str_byte(s, st + i) - 48);
                i = i + 1;
            }
            mem_store32(out, part * 4, v);
            if part == 0 { mask = mask | 1; }
            if part == 1 { mask = mask | 2; }
            if part == 2 { mask = mask | 4; }
        } else {
            return SR_ERR;
        }
    }
    mem_store32(out, 12, mask);
    if mask == 0 {
        return SR_ERR;
    }
    return SR_OK;
}

fn sr_vp(vp: ptr, i: u32) -> u32 {
    return mem_load32(vp, i * 4);
}

fn sr_mask(vp: ptr) -> u32 {
    return mem_load32(vp, 12);
}

/// 版本（已解析）与部分版本在**指定段**上比较。
fn sr_cmp_parts(vp: ptr, pv: ptr) -> i32 {
    let m: u32 = sr_mask(pv);
    let i: u32 = 0;
    while i < 3 {
        let bit: u32 = 1 << i;
        if (m & bit) != 0 {
            let a: u32 = sr_vp(vp, i);
            let b: u32 = sr_vp(pv, i);
            if a < b { return 0 as i32 - 1; }
            if a > b { return 1 as i32; }
        }
        i = i + 1;
    }
    return 0 as i32;
}

fn sr_full_cmp(vp: ptr, a: u32, b: u32, c: u32) -> i32 {
    if sr_vp(vp, 0) < a { return 0 as i32 - 1; }
    if sr_vp(vp, 0) > a { return 1 as i32; }
    if sr_vp(vp, 1) < b { return 0 as i32 - 1; }
    if sr_vp(vp, 1) > b { return 1 as i32; }
    if sr_vp(vp, 2) < c { return 0 as i32 - 1; }
    if sr_vp(vp, 2) > c { return 1 as i32; }
    return 0 as i32;
}

/// 一个范围项。`term` 是 `range[st, st+ln)`。
fn sr_term(vp: ptr, range: str, st: u32, ln: u32) -> bool {
    let i: u32 = 0;
    let op: u32 = 0; // 0 none, 1 '=', 2 '>', 3 '>=', 4 '<', 5 '<=', 6 '^', 7 '~'
    if i < ln {
        let c: u32 = str_byte(range, st + i);
        if c == 94 { op = 6; i = i + 1; }
        else if c == 126 { op = 7; i = i + 1; }
        else if c == 62 { // >
            op = 2;
            i = i + 1;
            if i < ln && str_byte(range, st + i) == 61 { op = 3; i = i + 1; }
        } else if c == 60 { // <
            op = 4;
            i = i + 1;
            if i < ln && str_byte(range, st + i) == 61 { op = 5; i = i + 1; }
        } else if c == 61 { op = 1; i = i + 1; }
    }
    if i >= ln {
        return false;
    }
    if sr_x(str_byte(range, st + i)) && ln - i == 1 {
        return true; // '*'
    }
    let pv: ptr = alloc(16);
    if sr_pv(range, st + i, ln - i, pv) != SR_OK {
        return false;
    }
    let m: u32 = sr_mask(pv);
    let ma: u32 = sr_vp(pv, 0);
    let mi: u32 = sr_vp(pv, 1);
    let pa: u32 = sr_vp(pv, 2);
    if op == 0 || op == 1 {
        // 精确/通配：按出现的段比。
        if m == 7 {
            return sr_cmp_parts(vp, pv) == (0 as i32);
        }
        if m == 1 {
            return sr_vp(vp, 0) == ma;
        }
        return sr_vp(vp, 0) == ma && sr_vp(vp, 1) == mi;
    }
    if op == 2 { return sr_full_cmp(vp, ma, mi, pa) > (0 as i32); }
    if op == 3 { return sr_full_cmp(vp, ma, mi, pa) >= (0 as i32); }
    if op == 4 { return sr_full_cmp(vp, ma, mi, pa) < (0 as i32); }
    if op == 5 { return sr_full_cmp(vp, ma, mi, pa) <= (0 as i32); }
    if op == 6 {
        // ^：下界，上界是最左非零段 +1
        if sr_full_cmp(vp, ma, mi, pa) < (0 as i32) {
            return false;
        }
        let ua: u32 = ma;
        let ub: u32 = mi;
        let uc: u32 = pa;
        if ma > 0 {
            ua = ma + 1; ub = 0; uc = 0;
        } else if mi > 0 {
            ua = 0; ub = mi + 1; uc = 0;
        } else {
            ua = 0; ub = 0; uc = pa + 1;
        }
        return sr_full_cmp(vp, ua, ub, uc) < (0 as i32);
    }
    // ~：下界，上界是次版本 +1（只给了大版本时是主版本 +1）
    if sr_full_cmp(vp, ma, mi, pa) < (0 as i32) {
        return false;
    }
    if m == 1 {
        return sr_vp(vp, 0) == ma;
    }
    return sr_vp(vp, 0) == ma && sr_vp(vp, 1) == mi;
}

/// 版本是否满足范围。版本非法直接 false。
pub fn sr_match(version: str, range: str) -> bool {
    let vp: ptr = alloc(32);
    if sv_parse(version, vp) != SV_OK {
        return false;
    }
    let n: u32 = str_len(range);
    let i: u32 = 0;
    let any: u32 = 0;
    let going: u32 = 1;
    while going == 1 && i < n {
        while i < n && sr_space(str_byte(range, i)) {
            i = i + 1;
        }
        if i >= n {
            going = 0;
        } else {
        let st: u32 = i;
        while i < n && !sr_space(str_byte(range, i)) {
            i = i + 1;
        }
        if !sr_term(vp, range, st, i - st) {
            return false;
        }
        any = 1;
        }
    }
    if any == 0 {
        return true; // 空范围 = 全匹配
    }
    return true;
}

// ---------------------------------------------------------------- 自检

fn test_semrange_exact() -> bool {
    return sr_match("1.2.3", "1.2.3") && !sr_match("1.2.4", "1.2.3")
        && sr_match("1.2.9", "1.2.x") && !sr_match("1.3.0", "1.2.x")
        && sr_match("1.9.9", "1") && !sr_match("2.0.0", "1");
}

fn test_semrange_caret() -> bool {
    return sr_match("1.5.0", "^1.2.3") && !sr_match("2.0.0", "^1.2.3")
        && sr_match("0.2.5", "^0.2.3") && !sr_match("0.3.0", "^0.2.3")
        && sr_match("0.0.3", "^0.0.3") && !sr_match("0.0.4", "^0.0.3");
}

fn test_semrange_tilde() -> bool {
    return sr_match("1.2.9", "~1.2.3") && !sr_match("1.3.0", "~1.2.3")
        && sr_match("1.2.0", "~1.2") && sr_match("1.9.0", "~1");
}

fn test_semrange_compare_ops() -> bool {
    return sr_match("1.2.3", ">=1.2.3") && !sr_match("1.2.2", ">=1.2.3")
        && sr_match("1.2.2", "<1.2.3") && sr_match("1.2.3", "<=1.2.3")
        && sr_match("1.3.0", ">1.2.3") && sr_match("1.2.3", "=1.2.3");
}

fn test_semrange_and() -> bool {
    return sr_match("1.5.0", ">=1.2.0 <1.6.0")
        && !sr_match("1.6.0", ">=1.2.0 <1.6.0");
}
