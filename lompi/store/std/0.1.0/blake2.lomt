// std/blake2.lomt — BLAKE2b 与 BLAKE2s（RFC 7693）
//
// 为什么除了 SHA-2/SHA-3 还要它: BLAKE2 是"为 64 位机器写的 SHA-3 决赛选手"，
// 在纯软件里通常比 SHA-2 快，而且**内置密钥模式**（`blake2b_init_key`）——
// 那正是 MAC 该用的形状（HMAC 是为"只有不带密钥的哈希"设计的补丁）。
//
// 两族不是同一个算法的两种摘要长度:
//   * **BLAKE2b**: 64 位字、128 字节块、12 轮、摘要 1..64 字节；
//   * **BLAKE2s**: 32 位字、64 字节块、10 轮、摘要 1..32 字节。
// 参数（摘要长度、密钥长度）在初始化时混进 h[0]，所以**不同参数是不同的函数**。
//
// 不做的（如实列）:
//   * 树哈希 / 并行模式（`fanout`、`depth`、`node_offset`）—— RFC 7693 的完整参数块
//     有 8 个字段，本模块只实现最常用的顺序模式（fanout=1, depth=1）；
//   * BLAKE2bp / BLAKE2sp（并行变体）—— 同上。
//
// 命名: 公开 blake2b_* / blake2s_*，内部 b2b_* / b2s_*。自检 test_blake2_*。

module blake2
choose runtime

use "mem.lomt"

/// BLAKE2b 上下文（调用方给这么多字节）。
/// 布局: [0..64) h[8] · [64..80) t[2] · [80..208) 块缓冲 · [208..212) 已用
///       · [212..216) 摘要长度 · [216..344) v[16]
pub const BLAKE2B_CTX: u32 = 344;
/// BLAKE2s 上下文。
/// 布局: [0..32) h[8] · [32..40) t[2] · [40..104) 块缓冲 · [104..108) 已用
///       · [108..112) 摘要长度 · [112..176) v[16]
pub const BLAKE2S_CTX: u32 = 176;

pub const BLAKE2B_BLOCK: u32 = 128;
pub const BLAKE2S_BLOCK: u32 = 64;

const B2B_H: u32 = 0;
const B2B_T: u32 = 64;
const B2B_BUF: u32 = 80;
const B2B_LEN: u32 = 208;
const B2B_OUT: u32 = 212;
const B2B_V: u32 = 216;

const B2S_H: u32 = 0;
const B2S_T: u32 = 32;
const B2S_BUF: u32 = 40;
const B2S_LEN: u32 = 104;
const B2S_OUT: u32 = 108;
const B2S_V: u32 = 112;

/// sigma 表：10 行 × 16 个 0..15 的值（两族共用；BLAKE2b 的第 11/12 轮重复第 1/2 轮）。
/// 每个值占两个十六进制字符。
fn b2_sigma(i0: u32) -> u32 {
    let t: str = "";
    let i: u32 = i0;
    if i >= 160 {
        // 第 11/12 轮 = 第 1/2 轮（从 0 数：10/11 -> 0/1）。
        i = i - 160;
    }
    let o: u32 = i * 2;
    let hi: u32 = load8(str_ptr(t), o);
    let lo: u32 = load8(str_ptr(t), o + 1);
    let a: u32 = 0;
    let b: u32 = 0;
    if hi >= 48 && hi <= 57 {
        a = hi - 48;
    } else {
        a = hi - 87;
    }
    if lo >= 48 && lo <= 57 {
        b = lo - 48;
    } else {
        b = lo - 87;
    }
    return (a << 4) | b;
}

fn b2b_iv(i: u32) -> u64 {
    if i == 0 { return 0x6a09e667f3bcc908; }
    if i == 1 { return 0xbb67ae8584caa73b; }
    if i == 2 { return 0x3c6ef372fe94f82b; }
    if i == 3 { return 0xa54ff53a5f1d36f1; }
    if i == 4 { return 0x510e527fade682d1; }
    if i == 5 { return 0x9b05688c2b3e6c1f; }
    if i == 6 { return 0x1f83d9abfb41bd6b; }
    return 0x5be0cd19137e2179;
}

fn b2s_iv(i: u32) -> u32 {
    if i == 0 { return 0x6a09e667; }
    if i == 1 { return 0xbb67ae85; }
    if i == 2 { return 0x3c6ef372; }
    if i == 3 { return 0xa54ff53a; }
    if i == 4 { return 0x510e527f; }
    if i == 5 { return 0x9b05688c; }
    if i == 6 { return 0x1f83d9ab; }
    return 0x5be0cd19;
}

fn b2b_rotr(x: u64, n: u32) -> u64 {
    return (x >> n) | (x << (64 - n));
}

fn b2s_rotr(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n));
}

fn b2b_g(ctx: ptr, a: u32, b: u32, c: u32, d: u32, x: u64, y: u64) {
    let va: u64 = mem_load64(ctx, B2B_V + a * 8);
    let vb: u64 = mem_load64(ctx, B2B_V + b * 8);
    let vc: u64 = mem_load64(ctx, B2B_V + c * 8);
    let vd: u64 = mem_load64(ctx, B2B_V + d * 8);
    va = va + vb + x;
    vd = b2b_rotr(vd ^ va, 32);
    vc = vc + vd;
    vb = b2b_rotr(vb ^ vc, 24);
    va = va + vb + y;
    vd = b2b_rotr(vd ^ va, 16);
    vc = vc + vd;
    vb = b2b_rotr(vb ^ vc, 63);
    mem_store64(ctx, B2B_V + a * 8, va);
    mem_store64(ctx, B2B_V + b * 8, vb);
    mem_store64(ctx, B2B_V + c * 8, vc);
    mem_store64(ctx, B2B_V + d * 8, vd);
}

fn b2s_g(ctx: ptr, a: u32, b: u32, c: u32, d: u32, x: u32, y: u32) {
    let va: u32 = mem_load32(ctx, B2S_V + a * 4);
    let vb: u32 = mem_load32(ctx, B2S_V + b * 4);
    let vc: u32 = mem_load32(ctx, B2S_V + c * 4);
    let vd: u32 = mem_load32(ctx, B2S_V + d * 4);
    va = va + vb + x;
    vd = b2s_rotr(vd ^ va, 16);
    vc = vc + vd;
    vb = b2s_rotr(vb ^ vc, 12);
    va = va + vb + y;
    vd = b2s_rotr(vd ^ va, 8);
    vc = vc + vd;
    vb = b2s_rotr(vb ^ vc, 7);
    mem_store32(ctx, B2S_V + a * 4, va);
    mem_store32(ctx, B2S_V + b * 4, vb);
    mem_store32(ctx, B2S_V + c * 4, vc);
    mem_store32(ctx, B2S_V + d * 4, vd);
}

fn b2b_compress(ctx: ptr, last: u32) {
    let i: u32 = 0;
    while i < 8 {
        mem_store64(ctx, B2B_V + i * 8, mem_load64(ctx, B2B_H + i * 8));
        mem_store64(ctx, B2B_V + (i + 8) * 8, b2b_iv(i));
        i = i + 1;
    }
    mem_store64(ctx, B2B_V + 12 * 8,
        mem_load64(ctx, B2B_V + 12 * 8) ^ mem_load64(ctx, B2B_T));
    mem_store64(ctx, B2B_V + 13 * 8,
        mem_load64(ctx, B2B_V + 13 * 8) ^ mem_load64(ctx, B2B_T + 8));
    if last == 1 {
        mem_store64(ctx, B2B_V + 14 * 8,
            mem_load64(ctx, B2B_V + 14 * 8) ^ 18446744073709551615);
    }
    let r: u32 = 0;
    while r < 12 {
        let s: u32 = r * 16;
        let m0: u64 = mem_load64(ctx, B2B_BUF + b2_sigma(s) * 8);
        let m1: u64 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 1) * 8);
        b2b_g(ctx, 0, 4, 8, 12, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 2) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 3) * 8);
        b2b_g(ctx, 1, 5, 9, 13, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 4) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 5) * 8);
        b2b_g(ctx, 2, 6, 10, 14, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 6) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 7) * 8);
        b2b_g(ctx, 3, 7, 11, 15, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 8) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 9) * 8);
        b2b_g(ctx, 0, 5, 10, 15, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 10) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 11) * 8);
        b2b_g(ctx, 1, 6, 11, 12, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 12) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 13) * 8);
        b2b_g(ctx, 2, 7, 8, 13, m0, m1);
        m0 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 14) * 8);
        m1 = mem_load64(ctx, B2B_BUF + b2_sigma(s + 15) * 8);
        b2b_g(ctx, 3, 4, 9, 14, m0, m1);
        r = r + 1;
    }
    i = 0;
    while i < 8 {
        let h: u64 = mem_load64(ctx, B2B_H + i * 8);
        let a: u64 = mem_load64(ctx, B2B_V + i * 8);
        let b: u64 = mem_load64(ctx, B2B_V + (i + 8) * 8);
        mem_store64(ctx, B2B_H + i * 8, h ^ a ^ b);
        i = i + 1;
    }
}

fn b2s_compress(ctx: ptr, last: u32) {
    let i: u32 = 0;
    while i < 8 {
        mem_store32(ctx, B2S_V + i * 4, mem_load32(ctx, B2S_H + i * 4));
        mem_store32(ctx, B2S_V + (i + 8) * 4, b2s_iv(i));
        i = i + 1;
    }
    mem_store32(ctx, B2S_V + 12 * 4,
        mem_load32(ctx, B2S_V + 12 * 4) ^ mem_load32(ctx, B2S_T));
    mem_store32(ctx, B2S_V + 13 * 4,
        mem_load32(ctx, B2S_V + 13 * 4) ^ mem_load32(ctx, B2S_T + 4));
    if last == 1 {
        mem_store32(ctx, B2S_V + 14 * 4,
            mem_load32(ctx, B2S_V + 14 * 4) ^ 4294967295);
    }
    let r: u32 = 0;
    while r < 10 {
        let s: u32 = r * 16;
        let m0: u32 = mem_load32(ctx, B2S_BUF + b2_sigma(s) * 4);
        let m1: u32 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 1) * 4);
        b2s_g(ctx, 0, 4, 8, 12, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 2) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 3) * 4);
        b2s_g(ctx, 1, 5, 9, 13, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 4) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 5) * 4);
        b2s_g(ctx, 2, 6, 10, 14, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 6) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 7) * 4);
        b2s_g(ctx, 3, 7, 11, 15, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 8) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 9) * 4);
        b2s_g(ctx, 0, 5, 10, 15, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 10) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 11) * 4);
        b2s_g(ctx, 1, 6, 11, 12, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 12) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 13) * 4);
        b2s_g(ctx, 2, 7, 8, 13, m0, m1);
        m0 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 14) * 4);
        m1 = mem_load32(ctx, B2S_BUF + b2_sigma(s + 15) * 4);
        b2s_g(ctx, 3, 4, 9, 14, m0, m1);
        r = r + 1;
    }
    i = 0;
    while i < 8 {
        let h: u32 = mem_load32(ctx, B2S_H + i * 4);
        let a: u32 = mem_load32(ctx, B2S_V + i * 4);
        let b: u32 = mem_load32(ctx, B2S_V + (i + 8) * 4);
        mem_store32(ctx, B2S_H + i * 4, h ^ a ^ b);
        i = i + 1;
    }
}

// ---------------------------------------------------------------- BLAKE2b

pub fn blake2b_init(ctx: ptr, outlen: u32) -> u32 {
    if outlen == 0 || outlen > 64 {
        return 0;
    }
    mem_fill(ctx, 0, BLAKE2B_CTX, 0);
    let i: u32 = 0;
    while i < 8 {
        mem_store64(ctx, B2B_H + i * 8, b2b_iv(i));
        i = i + 1;
    }
    // 参数块: digest_length | key_length<<8 | fanout<<16 | depth<<24
    let p: u64 = (outlen as u64) | (65536 as u64) | (16842752 as u64);
    mem_store64(ctx, B2B_H, mem_load64(ctx, B2B_H) ^ p);
    mem_store32(ctx, B2B_OUT, outlen);
    mem_store32(ctx, B2B_LEN, 0);
    return outlen;
}

/// 带密钥的初始化（MAC 用法）。`klen` 1..64。
pub fn blake2b_init_key(ctx: ptr, outlen: u32, key: ptr, klen: u32) -> u32 {
    if outlen == 0 || outlen > 64 || klen == 0 || klen > 64 {
        return 0;
    }
    mem_fill(ctx, 0, BLAKE2B_CTX, 0);
    let i: u32 = 0;
    while i < 8 {
        mem_store64(ctx, B2B_H + i * 8, b2b_iv(i));
        i = i + 1;
    }
    let kk: u64 = (klen as u64) << 8;
    let p: u64 = (outlen as u64) | kk | (65536 as u64) | (16842752 as u64);
    mem_store64(ctx, B2B_H, mem_load64(ctx, B2B_H) ^ p);
    mem_store32(ctx, B2B_OUT, outlen);
    // 密钥块本身作为第一块（全 128 字节，后面补零），先不压缩。
    mem_copy(ctx, B2B_BUF, key, 0, klen);
    mem_store32(ctx, B2B_LEN, BLAKE2B_BLOCK);
    return outlen;
}

pub fn blake2b_update(ctx: ptr, d: ptr, n: u32) {
    let used: u32 = mem_load32(ctx, B2B_LEN);
    let i: u32 = 0;
    while i < n {
        // 缓冲满 -> 压缩。带密钥时第一次就把密钥块压掉，这是规范要求的顺序。
        if used == BLAKE2B_BLOCK {
            let t0: u64 = mem_load64(ctx, B2B_T);
            let t1: u64 = mem_load64(ctx, B2B_T + 8);
            let n0: u64 = t0 + (BLAKE2B_BLOCK as u64);
            let n1: u64 = t1;
            if n0 < t0 {
                n1 = n1 + 1;
            }
            mem_store64(ctx, B2B_T, n0);
            mem_store64(ctx, B2B_T + 8, n1);
            b2b_compress(ctx, 0);
            used = 0;
        }
        let room: u32 = BLAKE2B_BLOCK - used;
        let take: u32 = n - i;
        let m: u32 = take;
        if m > room {
            m = room;
        }
        mem_copy(ctx, B2B_BUF + used, d, i, m);
        used = used + m;
        i = i + m;
    }
    mem_store32(ctx, B2B_LEN, used);
}

pub fn blake2b_final(ctx: ptr, out: ptr) -> u32 {
    let used: u32 = mem_load32(ctx, B2B_LEN);
    let outlen: u32 = mem_load32(ctx, B2B_OUT);
    if used < BLAKE2B_BLOCK {
        mem_fill(ctx, B2B_BUF + used, BLAKE2B_BLOCK - used, 0);
    }
    let t0: u64 = mem_load64(ctx, B2B_T);
    let n0: u64 = t0 + (used as u64);
    mem_store64(ctx, B2B_T, n0);
    if n0 < t0 {
        mem_store64(ctx, B2B_T + 8, mem_load64(ctx, B2B_T + 8) + 1);
    }
    b2b_compress(ctx, 1);
    let i: u32 = 0;
    while i < outlen {
        let lane: u64 = mem_load64(ctx, B2B_H + (i / 8) * 8);
        let shift: u32 = (i % 8) * 8;
        store8(out, i, ((lane >> shift) & 255) as u8);
        i = i + 1;
    }
    return outlen;
}

pub fn blake2b(d: ptr, n: u32, out: ptr, outlen: u32, ctx: ptr) -> u32 {
    let o: u32 = blake2b_init(ctx, outlen);
    if o == 0 {
        return 0;
    }
    blake2b_update(ctx, d, n);
    return blake2b_final(ctx, out);
}

pub fn blake2b_512(d: ptr, n: u32, out: ptr, ctx: ptr) -> u32 {
    return blake2b(d, n, out, 64, ctx);
}

pub fn blake2b_256(d: ptr, n: u32, out: ptr, ctx: ptr) -> u32 {
    return blake2b(d, n, out, 32, ctx);
}

// ---------------------------------------------------------------- BLAKE2s

pub fn blake2s_init(ctx: ptr, outlen: u32) -> u32 {
    if outlen == 0 || outlen > 32 {
        return 0;
    }
    mem_fill(ctx, 0, BLAKE2S_CTX, 0);
    let i: u32 = 0;
    while i < 8 {
        mem_store32(ctx, B2S_H + i * 4, b2s_iv(i));
        i = i + 1;
    }
    let p: u32 = outlen | 65536 | 16842752;
    mem_store32(ctx, B2S_H, mem_load32(ctx, B2S_H) ^ p);
    mem_store32(ctx, B2S_OUT, outlen);
    mem_store32(ctx, B2S_LEN, 0);
    return outlen;
}

pub fn blake2s_init_key(ctx: ptr, outlen: u32, key: ptr, klen: u32) -> u32 {
    if outlen == 0 || outlen > 32 || klen == 0 || klen > 32 {
        return 0;
    }
    mem_fill(ctx, 0, BLAKE2S_CTX, 0);
    let i: u32 = 0;
    while i < 8 {
        mem_store32(ctx, B2S_H + i * 4, b2s_iv(i));
        i = i + 1;
    }
    let p: u32 = outlen | (klen << 8) | 65536 | 16842752;
    mem_store32(ctx, B2S_H, mem_load32(ctx, B2S_H) ^ p);
    mem_store32(ctx, B2S_OUT, outlen);
    mem_copy(ctx, B2S_BUF, key, 0, klen);
    mem_store32(ctx, B2S_LEN, BLAKE2S_BLOCK);
    return outlen;
}

pub fn blake2s_update(ctx: ptr, d: ptr, n: u32) {
    let used: u32 = mem_load32(ctx, B2S_LEN);
    let i: u32 = 0;
    while i < n {
        if used == BLAKE2S_BLOCK {
            let t0: u32 = mem_load32(ctx, B2S_T);
            let t1: u32 = mem_load32(ctx, B2S_T + 4);
            let n0: u32 = t0 + BLAKE2S_BLOCK;
            let n1: u32 = t1;
            if n0 < t0 {
                n1 = n1 + 1;
            }
            mem_store32(ctx, B2S_T, n0);
            mem_store32(ctx, B2S_T + 4, n1);
            b2s_compress(ctx, 0);
            used = 0;
        }
        let room: u32 = BLAKE2S_BLOCK - used;
        let take: u32 = n - i;
        let m: u32 = take;
        if m > room {
            m = room;
        }
        mem_copy(ctx, B2S_BUF + used, d, i, m);
        used = used + m;
        i = i + m;
    }
    mem_store32(ctx, B2S_LEN, used);
}

pub fn blake2s_final(ctx: ptr, out: ptr) -> u32 {
    let used: u32 = mem_load32(ctx, B2S_LEN);
    let outlen: u32 = mem_load32(ctx, B2S_OUT);
    if used < BLAKE2S_BLOCK {
        mem_fill(ctx, B2S_BUF + used, BLAKE2S_BLOCK - used, 0);
    }
    let t0: u32 = mem_load32(ctx, B2S_T);
    let n0: u32 = t0 + used;
    mem_store32(ctx, B2S_T, n0);
    if n0 < t0 {
        mem_store32(ctx, B2S_T + 4, mem_load32(ctx, B2S_T + 4) + 1);
    }
    b2s_compress(ctx, 1);
    let i: u32 = 0;
    while i < outlen {
        let lane: u32 = mem_load32(ctx, B2S_H + (i / 4) * 4);
        let shift: u32 = (i % 4) * 8;
        store8(out, i, ((lane >> shift) & 255) as u8);
        i = i + 1;
    }
    return outlen;
}

pub fn blake2s(d: ptr, n: u32, out: ptr, outlen: u32, ctx: ptr) -> u32 {
    let o: u32 = blake2s_init(ctx, outlen);
    if o == 0 {
        return 0;
    }
    blake2s_update(ctx, d, n);
    return blake2s_final(ctx, out);
}

pub fn blake2s_256(d: ptr, n: u32, out: ptr, ctx: ptr) -> u32 {
    return blake2s(d, n, out, 32, ctx);
}

// ---------------------------------------------------------------- 自检

fn test_blake2_init_params() -> bool {
    let b: ptr = alloc(BLAKE2B_CTX);
    let s: ptr = alloc(BLAKE2S_CTX);
    return blake2b_init(b, 64) == 64 && blake2b_init(b, 65) == 0
        && blake2s_init(s, 32) == 32 && blake2s_init(s, 33) == 0;
}

fn test_blake2b_empty_first_byte() -> bool {
    // BLAKE2b-512("") 以 0x78 开头（完整向量在行为判据里与 Python 对跑）。
    let c: ptr = alloc(BLAKE2B_CTX);
    let o: ptr = alloc(64);
    let z: ptr = alloc(1);
    let n: u32 = blake2b_512(z, 0, o, c);
    return n == 64 && load8(o, 0) == 120;
}

fn test_blake2s_abc_first_byte() -> bool {
    // BLAKE2s-256("abc") 以 0x50 开头。
    let c: ptr = alloc(BLAKE2S_CTX);
    let o: ptr = alloc(32);
    let s: str = "abc";
    let n: u32 = blake2s_256(str_ptr(s), 3, o, c);
    return n == 32 && load8(o, 0) == 80;
}
