        // 撤销（`docs/306` §6.1 C2）。体名 = **全组成员**：块的按作用域由外到内、
        // 能力的按声明序 —— 与参考实现的展开顺序一致（孪生判据逐字节核）。
        let pos: u32 = 0;
        let v64: u32 = 0;
