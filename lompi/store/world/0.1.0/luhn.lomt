// world/luhn.lomt — 支付卡号：Luhn 校验与品牌识别
//
// 为什么现实世界需要它: 卡号不是银行给的随机数字 —— 最后一位是 Luhn 校验位，
// 它能让"输错一位"或"相邻两位写反"在本地就被拦下。品牌识别只看前缀，不需要
// 连任何服务。
//
// 规则: Luhn 从**右往左**，每隔一位乘 2，乘积大于 9 就减 9，总和 ≡ 0 (mod 10)。
//
// 注意: 校验通过只表示"这串数字自洽"，不表示卡存在、可用、有余额。
//
// 命名: 公开 luhn_*, 内部 lc2_*。自检 test_luhn_*。

module luhn

fn lc2_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn lc2_count(s: str) -> u32 {
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let k: u32 = 0;
    while i < n {
        if lc2_digit(str_byte(s, i)) {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

fn lc2_double(v: u32) -> u32 {
    let d: u32 = v * 2;
    if d > 9 {
        return d - 9;
    }
    return d;
}

/// 整串（含校验位）是否通过 Luhn。
pub fn luhn_ok(s: str) -> bool {
    let k: u32 = lc2_count(s);
    if k < 2 {
        return false;
    }
    let n: u32 = str_len(s);
    let i: u32 = 0;
    let seen: u32 = 0;
    let sum: u32 = 0;
    while i < n {
        let c: u32 = str_byte(s, i);
        if lc2_digit(c) {
            let v: u32 = c - 48;
            let from_right: u32 = k - 1 - seen;
            if from_right % 2 == 1 {
                sum = sum + lc2_double(v);
            } else {
                sum = sum + v;
            }
            seen = seen + 1;
        } else if c != 32 && c != 45 {
            return false;
        }
        i = i + 1;
    }
    return sum % 10 == 0;
}

/// 给"不含校验位"的前缀算校验位。
pub fn luhn_check_digit(prefix: str) -> u32 {
    let k: u32 = lc2_count(prefix);
    let n: u32 = str_len(prefix);
    let i: u32 = 0;
    let seen: u32 = 0;
    let sum: u32 = 0;
    while i < n {
        let c: u32 = str_byte(prefix, i);
        if lc2_digit(c) {
            let v: u32 = c - 48;
            // 加上校验位后总长 k+1；数据位从右数第 j 位（0 起）权重取决于 j+1
            let from_right: u32 = k - 1 - seen;
            if from_right % 2 == 0 {
                sum = sum + lc2_double(v);
            } else {
                sum = sum + v;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return (10 - (sum % 10)) % 10;
}

fn lc2_num(p: ptr, st: u32, ln: u32) -> u32 {
    let v: u32 = 0;
    let i: u32 = 0;
    while i < ln {
        v = v * 10 + (load8(p, st + i) - 48);
        i = i + 1;
    }
    return v;
}

/// 品牌名写进 out，返回长度；不认识返回 0。
pub fn luhn_brand(s: str, out: ptr, cap: u32) -> u32 {
    let b: ptr = alloc(24);
    let n: u32 = 0;
    let i: u32 = 0;
    let sl: u32 = str_len(s);
    while i < sl && n < 8 {
        let c: u32 = str_byte(s, i);
        if lc2_digit(c) {
            store8(b, n, c as u8);
            n = n + 1;
        }
        i = i + 1;
    }
    if n < 2 {
        return 0;
    }
    let name: str = "";
    if load8(b, 0) == 52 { // 4
        name = "visa";
    } else if n >= 2 && load8(b, 0) == 51 && load8(b, 1) == 52 { // 34
        name = "amex";
    } else if n >= 2 && load8(b, 0) == 51 && load8(b, 1) == 55 { // 37
        name = "amex";
    } else if n >= 2 && load8(b, 0) == 53 && load8(b, 1) == 54 { // 36
        name = "diners";
    } else if n >= 2 && load8(b, 0) == 51 && load8(b, 1) == 56 { // 38
        name = "diners";
    } else if n >= 2 && load8(b, 0) == 54 && load8(b, 1) == 50 { // 62
        name = "unionpay";
    } else if n >= 2 && load8(b, 0) == 54 && load8(b, 1) == 53 { // 65
        name = "discover";
    } else if n >= 4 && load8(b, 0) == 54 && load8(b, 1) == 48
        && load8(b, 2) == 49 && load8(b, 3) == 49 { // 6011
        name = "discover";
    } else if n >= 4 {
        let p2: u32 = lc2_num(b, 0, 2);
        let p4: u32 = lc2_num(b, 0, 4);
        if p2 >= 51 && p2 <= 55 {
            name = "mastercard";
        } else if p4 >= 2221 && p4 <= 2720 {
            name = "mastercard";
        } else if p4 >= 3528 && p4 <= 3589 {
            name = "jcb";
        }
    }
    if str_len(name) == 0 {
        return 0;
    }
    let m: u32 = str_len(name);
    let j: u32 = 0;
    while j < m {
        if j < cap {
            store8(out, j, str_byte(name, j) as u8);
        }
        j = j + 1;
    }
    return m;
}

// ---------------------------------------------------------------- 自检

fn test_luhn_ok() -> bool {
    return luhn_ok("4111 1111 1111 1111")
        && luhn_ok("5555555555554444")
        && !luhn_ok("4111 1111 1111 1112");
}

fn test_luhn_check_digit() -> bool {
    return luhn_check_digit("411111111111111") == 1
        && luhn_check_digit("7992739871") == 3;
}
