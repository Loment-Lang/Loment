pub fn lang_key(i: u32) -> str {
    if i == 0 { return "cpp"; }
    if i == 1 { return "c"; }
    if i == 2 { return "csharp"; }
    if i == 3 { return "java"; }
    if i == 4 { return "go"; }
    if i == 5 { return "rust"; }
    if i == 6 { return "python"; }
    if i == 7 { return "natural"; }
