// std/stdio.lomt — LibL 的 `<stdio.h>`：格式化输出（`printf` 族）
//
// **LibL 是什么**：这门语言的标准库的专有名词，形态照 libc —— 一个 libc 头对一个模块，
// 函数名、参数序、返回值语义都取 libc 的（docs/232）。这一份是 `<stdio.h>` 的**格式化那一半**。
//
// **`<stdio.h>` 的另一半（`FILE*`、`fopen`/`fread`/`fwrite`/`fclose`、`stdin`/`stdout`）不在
// 这里**：那一半要么是模块级可变全局（`stdin`/`stdout` 是 `FILE*` 常量 + 缓冲状态），
// 要么是**世界面**（文件系统、fd）。本语言没有模块级可变全局（lomentc.py:1626-1738），
// 而文件是 `docs/219` §4 表上的 `world` 类。要读写请用 `lompi/store/host` 那几个模块
// （`fd` / `syscall`）或内建 `syscall4` —— 那是同一件事的正确层。
//
// **没有变参，所以多一个参数**：libc 的 `snprintf(buf, cap, fmt, ...)` 靠**可变参数**；
// 本语言没有 `...`。所以这里多两个参数：
//
//     snprintf(buf, cap, fmt, args: ptr, nargs: u32)
//
// `args` 指向一个 **u64 数组**（第 k 个实参在偏移 `k * 8`），转换说明符**自己**说明
// 该实参怎么解释 —— 这一点与 libc 完全一样（`%d` 与 `%s` 的读法本来就由格式串决定）。
// 所以 `args` 里放的就是"按顺序的实参值"，只是它们来自一个**数组**而不是一个变参列表。
// `nargs` 是 libc **没有**的（它数不出来）：少给实参时 libc 读越界垃圾，这里**停止转换**
// 并把已产出的部分收尾 —— 这是**唯一一处签名上的偏离**，写在这里而不是藏着。
//
// **支持**：`%%` `%d` `%i` `%u` `%x` `%X` `%o` `%c` `%s` `%p` `%n`，标志 `-` 与 `0`，
// 宽度（十进制**或 `*`**）、精度（`.N` 或 `.*`），以及长度修饰符 `l` `h` `z` `j` `t`
// （**收下但不改行为** —— 本语言只有一个 64 位整数宽度）。
//
// 几条**照 libc 的边角**（判据里逐条与 glibc 对跑）：
//   * 精度的 `0` 标志**失效**，且 `%.0d` 配 0 输出**空串**（不是 "0"）；
//   * `*` 宽度为负 ⇒ 左对齐 + 取绝对值；`.*` 精度为负 ⇒ **当作没写**；
//   * `%p` 的 NULL 打 **`(nil)`**，其余打 `0x` + 小写十六进制（不补前导零）；
//   * `%n` **不产出字符**，把"到目前为止写了多少"写回实参指向的 `int`。
//
// **浮点（`%f` / `%e` / `%g`）自 2026-11-08 起支持**。上游 `#381`（混宽运算发出非法 IR）
// 已在 2026-10-17 关闭，`f64fmt` 那串模块现在能编、也能与 Python 的十进制展开对上。
// 三者的语义按 libc：
//   * `%f`：固定小数位，默认 6；精度是"小数点后几位"；
//   * `%e`：科学计数法，`d.dddde±XX`，精度是"小数点后几位"（有效数字 = 精度 + 1）；
//   * `%g`：精度是**有效数字**（默认 6），按指数选定点/科学，并去掉尾随零。
// 两处**如实列的偏离**：
//   1. 精度上限 512（临时区 1 KiB）；libc 没有上限。
//   2. `%g` 的"最短"是按**固定有效位数后去尾零**做的，不是 libc 的 `%.Pg` 全套舍入细节；
//      与 glibc 在常见值上一致，在"恰好半位"的边界上可能差一位。判据覆盖的是常见值。
//
// `%f/%e/%g` 需要 `f64fmt` 的 4352 字节临时区，所以多了一个带工作区的入口
// `snprintf_ws`；便利版 `snprintf` 每次调用自己 `alloc` 一块（bump 堆不回收，
// 循环里格式化大量浮点请自己开一块复用）。
//
// **返回值与截断照 libc**：返回"**本该写出**的字符数"（不含 NUL），即使被 `cap` 截断也一样；
// 而 `cap > 0` 时**总是**补 NUL。这一条最容易写错，判据里专门比它。
//
// 命名：平名字空间，公开一律 libc 名，内部一律 `sf_*`，自检 `test_stdio_*`。

module stdio

// 需求：这一族要用到运行期（除法/取模/`alloc`）—— 库里写 `choose` 是**声明需求**，
// 根单元要满足它（docs/227 §2.2）。包内 126 个模块已是同一个形状。

use "mem.lomt"
use "string.lomt"
use "stdlib.lomt"
use "f64fmt.lomt"

/// `-`：左对齐。
pub const SF_LEFT: u32 = 1;
/// `0`：补零（与 SF_LEFT 同时给时按 libc，`-` 赢）。
pub const SF_ZERO: u32 = 2;

/// `sprintf` 用的"没有上限"（`sprintf` 本来就是无界写，libc 同 —— 调用方自己保证够大）。
pub const SF_UNBOUNDED: u32 = 2147483647;

/// 写一个字符，返回**产出计数**（`total + 1`）。
///
/// 截断的规矩在这里：留最后一格给 NUL，所以只有 `total + 1 < cap` 时才真写。
fn sf_put(buf: ptr, cap: u32, total: u32, c: u32) -> u32 {
    let room: bool = cap > 0 && total + 1 < cap;
    if room {
        store8(buf, total, c as u8);
    }
    return total + 1;
}

/// v 在 base 进制下的位数（v == 0 算 1 位）。
fn sf_digits(v: u64, base: u32) -> u32 {
    let n: u32 = 1;
    let x: u64 = v;
    while x >= (base as u64) {
        x = x / (base as u64);
        n = n + 1;
    }
    return n;
}

/// 0..35 -> 字符。
fn sf_digit_char(d: u64, upper: bool) -> u32 {
    if d < (10 as u64) {
        return 48 + (d as u32);
    }
    if upper {
        return 55 + (d as u32);
    }
    return 87 + (d as u32);
}

/// 整数（含符号、宽度、补零、左右对齐）。
///
/// 逐位取高位：先算 `base^(nd-1)` 当除数，再一路除下来。**这样不需要暂存缓冲**——
/// 仓库里那套"倒着写进临时区再翻转"要求调用方多给一格余量，是个隐式约定
/// （`numfmt.lomt` 的头注专门为去掉它写过一段）。
fn sf_int(buf: ptr, cap: u32, total: u32, av: u64, flags: u32, width: u32,
          base: u32, upper: bool, signed: bool, prec: i64) -> u32 {
    let neg: bool = signed && (av as i64) < (0 as i64);
    let mag: u64 = av;
    if neg {
        mag = (0 as u64) - av;
    }
    let nd: u32 = sf_digits(mag, base);
    // **精度 = 最少位数**（libc 的规矩）：给了精度就按它补零，而 `0` 标志**失效**。
    // 精度 0 配值 0 ⇒ 一位都不打（`printf("%.0d", 0)` 输出空串，不是 "0"）。
    let hasp: bool = prec >= (0 as i64);
    let phas: u32 = prec as u32;
    let pad: u32 = 0;
    if hasp {
        if phas > nd {
            pad = phas - nd;
        }
    }
    let ndig: u32 = nd;
    if hasp && phas == 0 && mag == (0 as u64) {
        ndig = 0;
    }
    let nsign: u32 = 0;
    if neg {
        nsign = 1;
    }
    let ntot: u32 = pad + ndig + nsign;
    let left: bool = (flags & SF_LEFT) != 0;
    let zero: bool = (flags & SF_ZERO) != 0 && left == false && hasp == false;
    let cur: u32 = total;
    if width > ntot && zero {
        if neg {
            cur = sf_put(buf, cap, cur, 45);
        }
        let k: u32 = 0;
        while k < width - ntot {
            cur = sf_put(buf, cap, cur, 48);
            k = k + 1;
        }
    } else {
        if width > ntot && left == false {
            let k2: u32 = 0;
            while k2 < width - ntot {
                cur = sf_put(buf, cap, cur, 32);
                k2 = k2 + 1;
            }
        }
    }
    let done_sign: bool = zero && width > ntot;
    if neg && done_sign == false {
        cur = sf_put(buf, cap, cur, 45);
    }
    let div: u64 = 1 as u64;
    let k3: u32 = 0;
    while k3 < nd - 1 {
        div = div * (base as u64);
        k3 = k3 + 1;
    }
    // 精度补零在前、真数字在后（除数是按 nd 算的，所以必须分两段，不能让循环多跑）。
    let z: u32 = 0;
    while z < pad {
        cur = sf_put(buf, cap, cur, 48);
        z = z + 1;
    }
    let i: u32 = 0;
    while i < ndig {
        let d: u64 = (mag / div) % (base as u64);
        cur = sf_put(buf, cap, cur, sf_digit_char(d, upper));
        div = div / (base as u64);
        i = i + 1;
    }
    if width > ntot && left {
        let k4: u32 = 0;
        while k4 < width - ntot {
            cur = sf_put(buf, cap, cur, 32);
            k4 = k4 + 1;
        }
    }
    return cur;
}

/// 一个字节 + 宽度（`%c`）。**精度对 `%c` 无效**（libc 同），收下不用。
fn sf_char(buf: ptr, cap: u32, total: u32, c: u32, flags: u32, width: u32,
           prec: i64) -> u32 {
    let _p: i64 = prec;
    let left: bool = (flags & SF_LEFT) != 0;
    let cur: u32 = total;
    if width > 1 && left == false {
        let k: u32 = 0;
        while k < width - 1 {
            cur = sf_put(buf, cap, cur, 32);
            k = k + 1;
        }
    }
    cur = sf_put(buf, cap, cur, c & 255);
    if width > 1 && left {
        let k2: u32 = 0;
        while k2 < width - 1 {
            cur = sf_put(buf, cap, cur, 32);
            k2 = k2 + 1;
        }
    }
    return cur;
}

/// `n` 个字节 + 宽度（`%s` 与 `%p` 的 `(nil)` 共用）。**精度在这里截断**（libc：`%.3s` 最多 3 个字符）。
fn sf_str_n(buf: ptr, cap: u32, total: u32, p: ptr, n0: u32, flags: u32, width: u32,
            prec: i64) -> u32 {
    let n: u32 = n0;
    if prec >= (0 as i64) && (prec as u32) < n {
        n = prec as u32;
    }
    let left: bool = (flags & SF_LEFT) != 0;
    let cur: u32 = total;
    if width > n && left == false {
        let k: u32 = 0;
        while k < width - n {
            cur = sf_put(buf, cap, cur, 32);
            k = k + 1;
        }
    }
    let i: u32 = 0;
    while i < n {
        cur = sf_put(buf, cap, cur, load8(p, i));
        i = i + 1;
    }
    if width > n && left {
        let k2: u32 = 0;
        while k2 < width - n {
            cur = sf_put(buf, cap, cur, 32);
            k2 = k2 + 1;
        }
    }
    return cur;
}

/// NUL 结尾串 + 宽度（`%s`）。
fn sf_str(buf: ptr, cap: u32, total: u32, p: ptr, flags: u32, width: u32,
          prec: i64) -> u32 {
    return sf_str_n(buf, cap, total, p, strlen(p), flags, width, prec);
}

/// `%p` —— glibc 的规矩：**NULL 打 `(nil)`**，其余打 `0x` + 小写十六进制（不补前导零）。
///
/// 判据里比它**只比两个确定的用例**：NULL（两边都得 `(nil)`）与一个**给定的整数**当指针
/// （两边都得 `0xdeadbeef`）—— 真地址两边不同，逐字节比不了，这一点不装作能比。
fn sf_ptr(buf: ptr, cap: u32, total: u32, v: u64, flags: u32, width: u32) -> u32 {
    if v == (0 as u64) {
        return sf_str_n(buf, cap, total, str_ptr("(nil)"), 5, flags, width, 0 as i64 - 1);
    }
    let nd: u32 = sf_digits(v, 16);
    let ntot: u32 = nd + 2;
    let left: bool = (flags & SF_LEFT) != 0;
    let cur: u32 = total;
    if width > ntot && left == false {
        let k: u32 = 0;
        while k < width - ntot {
            cur = sf_put(buf, cap, cur, 32);
            k = k + 1;
        }
    }
    cur = sf_put(buf, cap, cur, 48);      // '0'
    cur = sf_put(buf, cap, cur, 120);     // 'x'
    let div: u64 = 1 as u64;
    let k2: u32 = 0;
    while k2 < nd - 1 {
        div = div * (16 as u64);
        k2 = k2 + 1;
    }
    let i: u32 = 0;
    while i < nd {
        let d: u64 = (v / div) % (16 as u64);
        cur = sf_put(buf, cap, cur, sf_digit_char(d, false));
        div = div / (16 as u64);
        i = i + 1;
    }
    if width > ntot && left {
        let k3: u32 = 0;
        while k3 < width - ntot {
            cur = sf_put(buf, cap, cur, 32);
            k3 = k3 + 1;
        }
    }
    return cur;
}

/// 把一段已生成的文本按宽度/对齐/补零写出去。`n` 是文本长度。
/// 补零遇到 `inf`/`nan` 要失效（libc 同：那不是数字，补零没有意义）。
fn sf_emit_text(buf: ptr, cap: u32, total: u32, tp: ptr, n: u32, flags: u32, width: u32) -> u32 {
    let left: bool = (flags & SF_LEFT) != 0;
    let zero: bool = (flags & SF_ZERO) != 0 && left == false;
    let sign: u32 = 0;
    if n > 0 && load8(tp, 0) == 45 {
        sign = 1;
    }
    let special: u32 = 0;
    if n > sign {
        let c0: u32 = load8(tp, sign);
        if c0 == 105 || c0 == 110 {
            special = 1;
        }
    }
    let z: bool = zero && special == 0;
    let cur: u32 = total;
    if width > n && left == false && z == false {
        let k: u32 = 0;
        while k < width - n {
            cur = sf_put(buf, cap, cur, 32);
            k = k + 1;
        }
    }
    if width > n && z {
        if sign == 1 {
            cur = sf_put(buf, cap, cur, 45);
        }
        let k2: u32 = 0;
        while k2 < width - n {
            cur = sf_put(buf, cap, cur, 48);
            k2 = k2 + 1;
        }
        let i: u32 = sign;
        while i < n {
            cur = sf_put(buf, cap, cur, load8(tp, i));
            i = i + 1;
        }
    } else {
        let i2: u32 = 0;
        while i2 < n {
            cur = sf_put(buf, cap, cur, load8(tp, i2));
            i2 = i2 + 1;
        }
        if width > n && left {
            let k3: u32 = 0;
            while k3 < width - n {
                cur = sf_put(buf, cap, cur, 32);
                k3 = k3 + 1;
            }
        }
    }
    return cur;
}

/// `%g`。精度是**有效数字**：先按科学计数法生成 `p` 位，读指数，再决定定点还是科学，
/// 最后去掉尾随零（只去小数点之后的零）。
fn sf_g(tp: ptr, x: u64, prec: i64, sc: ptr) -> u32 {
    if f64bits_is_zero(x) {
        return f64fmt_fixed(tp, 0, x, 0, sc); // "0"（glibc 的 %g 也打 "0"）
    }
    let p: u32 = 6;
    if prec >= (0 as i64) {
        p = prec as u32;
    }
    if p == 0 {
        p = 1;
    }
    if p > 512 {
        p = 512;
    }
    let n1: u32 = f64fmt_sci(tp, 0, x, p, sc);
    let epos: u32 = 4294967295;
    let i: u32 = 0;
    while i < n1 {
        if load8(tp, i) == 101 { // 'e'
            epos = i;
        }
        i = i + 1;
    }
    if epos == 4294967295 {
        return n1; // inf / nan
    }
    // 解析指数。
    let j: u32 = epos + 1;
    let eneg: u32 = 0;
    if load8(tp, j) == 45 {
        eneg = 1;
        j = j + 1;
    } else if load8(tp, j) == 43 {
        j = j + 1;
    }
    let ex: i64 = 0 as i64;
    while j < n1 {
        let d: u32 = load8(tp, j);
        if d >= 48 && d <= 57 {
            ex = ex * (10 as i64) + ((d - 48) as i64);
        }
        j = j + 1;
    }
    if eneg == 1 {
        ex = 0 as i64 - ex;
    }
    if ex < (0 as i64 - 4) || ex >= (p as i64) {
        // 科学计数法：去掉尾数的小数点后尾随零。
        let k: u32 = epos;
        let stop: u32 = 0;
        while stop == 0 && k > 0 {
            if load8(tp, k - 1) == 48 {
                k = k - 1;
            } else {
                stop = 1;
            }
        }
        if k > 0 && load8(tp, k - 1) == 46 {
            k = k - 1;
        }
        let rm: u32 = epos - k;
        let m: u32 = epos;
        while m < n1 {
            store8(tp, m - rm, load8(tp, m) as u8);
            m = m + 1;
        }
        return n1 - rm;
    }
    // 定点：after = p - 1 - ex。
    let after: u32 = (p as i64 - 1 - ex) as u32;
    let n2: u32 = f64fmt_fixed(tp, 0, x, after, sc);
    // 只去小数点之后的零。
    let dot: u32 = 4294967295;
    let i2: u32 = 0;
    while i2 < n2 {
        if load8(tp, i2) == 46 {
            dot = i2;
        }
        i2 = i2 + 1;
    }
    if dot == 4294967295 {
        return n2;
    }
    let k2: u32 = n2;
    let stop2: u32 = 0;
    while stop2 == 0 && k2 > dot + 1 {
        if load8(tp, k2 - 1) == 48 {
            k2 = k2 - 1;
        } else {
            stop2 = 1;
        }
    }
    if k2 == dot + 1 {
        k2 = dot; // 小数点后全被去掉了，连点一起去掉
    }
    return k2;
}

/// 浮点转换（`%f` / `%e` / `%g`）。`ws` 至少 `snprintf_ws_bytes()`。
fn sf_float(buf: ptr, cap: u32, total: u32, bits: u64, flags: u32, width: u32,
            prec: i64, spec: u32, ws: ptr) -> u32 {
    let tmp: ptr = ptr_add(ws, f64fmt_scratch_bytes());
    let n: u32 = 0;
    if spec == 102 { // 'f'
        let after: u32 = 6;
        if prec >= (0 as i64) {
            after = prec as u32;
        }
        if after > 512 {
            after = 512;
        }
        n = f64fmt_fixed(tmp, 0, bits, after, ws);
    } else if spec == 101 { // 'e'
        let sig: u32 = 7;
        if prec >= (0 as i64) {
            sig = (prec as u32) + 1;
        }
        if sig > 512 {
            sig = 512;
        }
        n = f64fmt_sci(tmp, 0, bits, sig, ws);
    } else { // 'g'
        n = sf_g(tmp, bits, prec, ws);
    }
    return sf_emit_text(buf, cap, total, tmp, n, flags, width);
}

/// 一个转换说明符 -> 输出。不认识的说明符**原样输出** `%` 与那个字符（不静默吞掉）。
fn sf_conv(buf: ptr, cap: u32, total: u32, spec: u32, av: u64, flags: u32, width: u32,
           prec: i64, ws: ptr) -> u32 {
    if spec == 100 || spec == 105 {              // d i
        return sf_int(buf, cap, total, av, flags, width, 10, false, true, prec);
    }
    if spec == 117 {                             // u
        return sf_int(buf, cap, total, av, flags, width, 10, false, false, prec);
    }
    if spec == 120 {                             // x
        return sf_int(buf, cap, total, av, flags, width, 16, false, false, prec);
    }
    if spec == 88 {                              // X
        return sf_int(buf, cap, total, av, flags, width, 16, true, false, prec);
    }
    if spec == 111 {                             // o
        return sf_int(buf, cap, total, av, flags, width, 8, false, false, prec);
    }
    if spec == 99 {                              // c
        return sf_char(buf, cap, total, av as u32, flags, width, prec);
    }
    if spec == 115 {                             // s
        return sf_str(buf, cap, total, av as ptr, flags, width, prec);
    }
    if spec == 112 {                             // p
        return sf_ptr(buf, cap, total, av, flags, width);
    }
    if spec == 102 || spec == 101 || spec == 103 { // f e g
        return sf_float(buf, cap, total, av, flags, width, prec, spec, ws);
    }
    if spec == 110 {                             // n —— **不产出**，把"到目前为止写了多少"写回实参
        let slot: ptr = av as ptr;
        if (slot as u64) != (0 as u64) {
            mem_store32(slot, 0, total);
        }
        return total;
    }
    let t2: u32 = sf_put(buf, cap, total, 37);
    return sf_put(buf, cap, t2, spec);
}

/// 收尾：`cap > 0` 时总是补 NUL（位置是 `min(已产出, cap-1)`）。
fn sf_finish(buf: ptr, cap: u32, total: u32) -> u32 {
    if cap > 0 {
        let end: u32 = total;
        if end > cap - 1 {
            end = cap - 1;
        }
        store8(buf, end, 0 as u8);
    }
    return total;
}

/// `snprintf` —— 见文件头（签名比 libc 多一个 `nargs`，理由在那里）。
///
/// `fmt` 是 **NUL 结尾**的格式串 —— 而本语言的字面量不带 NUL（`string.lomt` 的 `cstr_of`），
/// 所以通常要先用 `cstr_of` 把字面量落进一个缓冲。
pub fn snprintf_ws_bytes() -> u32 {
    return f64fmt_scratch_bytes() + 1024;
}

/// 格式串里有没有浮点说明符。只有需要时才开工作区 —— 整数/字符串路径**零分配**。
fn sf_needs_ws(fmt: ptr) -> bool {
    let i: u32 = 0;
    let go: bool = true;
    while go {
        let c: u32 = load8(fmt, i);
        if c == 0 {
            go = false;
        } else {
            if c == 102 || c == 101 || c == 103 { // f e g
                return true;
            }
            i = i + 1;
        }
    }
    return false;
}

pub fn snprintf(buf: ptr, cap: u32, fmt: ptr, args: ptr, nargs: u32) -> u32 {
    if sf_needs_ws(fmt) == false {
        return snprintf_ws(buf, cap, fmt, args, nargs, 0 as ptr);
    }
    let ws: ptr = alloc(snprintf_ws_bytes());
    return snprintf_ws(buf, cap, fmt, args, nargs, ws);
}

/// 带工作区的 `snprintf`。循环里格式化很多浮点时复用它（bump 堆不回收）。
pub fn snprintf_ws(buf: ptr, cap: u32, fmt: ptr, args: ptr, nargs: u32, ws: ptr) -> u32 {
    let total: u32 = 0;
    let fi: u32 = 0;
    let ai: u32 = 0;
    let go: bool = true;
    while go {
        let ch: u32 = load8(fmt, fi);
        if ch == 0 {
            go = false;
        } else {
            if ch != 37 {
                total = sf_put(buf, cap, total, ch);
                fi = fi + 1;
            } else {
                fi = fi + 1;
                if load8(fmt, fi) == 37 {
                    total = sf_put(buf, cap, total, 37);
                    fi = fi + 1;
                } else {
                    let flags: u32 = 0;
                    let moreflag: bool = true;
                    while moreflag {
                        let f2: u32 = load8(fmt, fi);
                        if f2 == 45 {
                            flags = flags | SF_LEFT;
                            fi = fi + 1;
                        } else {
                            if f2 == 48 {
                                flags = flags | SF_ZERO;
                                fi = fi + 1;
                            } else {
                                moreflag = false;
                            }
                        }
                    }
                    let width: u32 = 0;
                    if load8(fmt, fi) == 42 {
                        // `*`：宽度从**实参**里取。负宽度 = 左对齐 + 取绝对值（libc 的规矩）。
                        let wv: i64 = 0 as i64;
                        if ai < nargs {
                            wv = mem_load64(args, ai * 8) as i64;
                            ai = ai + 1;
                        }
                        if wv < (0 as i64) {
                            flags = flags | SF_LEFT;
                            width = (0 as i64 - wv) as u32;
                        } else {
                            width = wv as u32;
                        }
                        fi = fi + 1;
                    } else {
                        let morew: bool = true;
                        while morew {
                            let wc: u32 = load8(fmt, fi);
                            if wc >= 48 && wc <= 57 {
                                width = width * 10 + (wc - 48);
                                fi = fi + 1;
                            } else {
                                morew = false;
                            }
                        }
                    }
                    // 精度：`.` 后面接数字或 `*`。**负数精度当作没写**（libc 的规矩）。
                    let prec: i64 = 0 as i64 - 1;
                    if load8(fmt, fi) == 46 {
                        fi = fi + 1;
                        if load8(fmt, fi) == 42 {
                            let pv: i64 = 0 as i64;
                            if ai < nargs {
                                pv = mem_load64(args, ai * 8) as i64;
                                ai = ai + 1;
                            }
                            if pv >= (0 as i64) {
                                prec = pv;
                            }
                            fi = fi + 1;
                        } else {
                            let pv2: u32 = 0;
                            let morep: bool = true;
                            while morep {
                                let pc: u32 = load8(fmt, fi);
                                if pc >= 48 && pc <= 57 {
                                    pv2 = pv2 * 10 + (pc - 48);
                                    fi = fi + 1;
                                } else {
                                    morep = false;
                                }
                            }
                            prec = pv2 as i64;
                        }
                    }
                    let morelen: bool = true;
                    while morelen {
                        let lm: u32 = load8(fmt, fi);
                        if lm == 108 || lm == 104 || lm == 122 || lm == 106 || lm == 116 {
                            fi = fi + 1;
                        } else {
                            morelen = false;
                        }
                    }
                    let spec: u32 = load8(fmt, fi);
                    if ai < nargs {
                        let av: u64 = mem_load64(args, ai * 8);
                        ai = ai + 1;
                        total = sf_conv(buf, cap, total, spec, av, flags, width, prec, ws);
                    }
                    // 实参不够: **不做这个转换** —— libc 会读越界垃圾, 这里停 (文件头写明了)。
                    fi = fi + 1;
                }
            }
        }
    }
    return sf_finish(buf, cap, total);
}

/// `sprintf` —— 无界写。**调用方自己保证 `buf` 够大**（libc 同）。
pub fn sprintf(buf: ptr, fmt: ptr, args: ptr, nargs: u32) -> u32 {
    return snprintf(buf, SF_UNBOUNDED, fmt, args, nargs);
}
