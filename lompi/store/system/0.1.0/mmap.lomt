// system/mmap.lomt — 内存映射的 PROT_* / MAP_* 位名
//
// 为什么系统工具需要它: `mmap(0, len, 3, 34, fd, 0)` 里的 3 是"可读可写"，
// 34 是"私有 + 匿名"。这两个数字写错一个，行为就从"映射文件"变成"拿一块匿名内存"，
// 而且不报错。反查位名是排查这类问题的第一步。
//
// 覆盖: Linux 通用值（x86-64 / AArch64 一致）。
//
// 命名: 公开 mm_*, 内部 ma_*。自检 test_mmap_*。

module mmap

pub const MM_PROT_READ: u32 = 1;
pub const MM_PROT_WRITE: u32 = 2;
pub const MM_PROT_EXEC: u32 = 4;
pub const MM_MAP_SHARED: u32 = 1;
pub const MM_MAP_PRIVATE: u32 = 2;
pub const MM_MAP_FIXED: u32 = 16;
pub const MM_MAP_ANONYMOUS: u32 = 32;
pub const MM_MAP_GROWSDOWN: u32 = 256;
pub const MM_MAP_POPULATE: u32 = 32768;
pub const MM_MAP_STACK: u32 = 131072;

fn ma_put(out: ptr, cap: u32, pos: u32, s: str) -> u32 {
    let p: u32 = pos;
    let n: u32 = str_len(s);
    let i: u32 = 0;
    while i < n {
        if p < cap {
            store8(out, p, str_byte(s, i) as u8);
        }
        p = p + 1;
        i = i + 1;
    }
    return p;
}

fn ma_sep(out: ptr, cap: u32, pos: u32) -> u32 {
    if pos > 0 {
        return ma_put(out, cap, pos, "|");
    }
    return pos;
}

/// 保护位 -> 名字串。0 是 `PROT_NONE`。
pub fn mm_prot_text(mask: u32, out: ptr, cap: u32) -> u32 {
    if mask == 0 {
        return ma_put(out, cap, 0, "PROT_NONE");
    }
    let pos: u32 = 0;
    if (mask & MM_PROT_READ) != 0 {
        pos = ma_put(out, cap, pos, "PROT_READ");
    }
    if (mask & MM_PROT_WRITE) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "PROT_WRITE");
    }
    if (mask & MM_PROT_EXEC) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "PROT_EXEC");
    }
    return pos;
}

/// 映射标志 -> 名字串。0 返回 `"0"`。
pub fn mm_map_text(mask: u32, out: ptr, cap: u32) -> u32 {
    if mask == 0 {
        return ma_put(out, cap, 0, "0");
    }
    let pos: u32 = 0;
    if (mask & MM_MAP_SHARED) != 0 {
        pos = ma_put(out, cap, pos, "MAP_SHARED");
    }
    if (mask & MM_MAP_PRIVATE) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "MAP_PRIVATE");
    }
    if (mask & MM_MAP_FIXED) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "MAP_FIXED");
    }
    if (mask & MM_MAP_ANONYMOUS) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "MAP_ANONYMOUS");
    }
    if (mask & MM_MAP_GROWSDOWN) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "MAP_GROWSDOWN");
    }
    if (mask & MM_MAP_POPULATE) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "MAP_POPULATE");
    }
    if (mask & MM_MAP_STACK) != 0 {
        pos = ma_sep(out, cap, pos);
        pos = ma_put(out, cap, pos, "MAP_STACK");
    }
    return pos;
}

fn ma_eq(s: str, w: str) -> bool {
    if str_len(s) != str_len(w) {
        return false;
    }
    let i: u32 = 0;
    while i < str_len(s) {
        if str_byte(s, i) != str_byte(w, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// 名字 -> 值。未知返回 -1。
pub fn mm_lookup(name: str) -> i64 {
    if ma_eq(name, "PROT_NONE") { return 0 as i64; }
    if ma_eq(name, "PROT_READ") { return 1 as i64; }
    if ma_eq(name, "PROT_WRITE") { return 2 as i64; }
    if ma_eq(name, "PROT_EXEC") { return 4 as i64; }
    if ma_eq(name, "MAP_SHARED") { return 1 as i64; }
    if ma_eq(name, "MAP_PRIVATE") { return 2 as i64; }
    if ma_eq(name, "MAP_FIXED") { return 16 as i64; }
    if ma_eq(name, "MAP_ANONYMOUS") { return 32 as i64; }
    if ma_eq(name, "MAP_GROWSDOWN") { return 256 as i64; }
    if ma_eq(name, "MAP_POPULATE") { return 32768 as i64; }
    if ma_eq(name, "MAP_STACK") { return 131072 as i64; }
    return 0 as i64 - 1 as i64;
}

/// 常用组合：匿名私有可读写（`mmap` 最常见的那个 34 / 3）。
pub fn mm_anon_rw_mask() -> u32 {
    return MM_MAP_PRIVATE | MM_MAP_ANONYMOUS;
}

// ---------------------------------------------------------------- 自检

fn test_mmap_prot() -> bool {
    let o: ptr = alloc(64);
    let n: u32 = mm_prot_text(3, o, 64);
    let want: str = "PROT_READ|PROT_WRITE";
    if n != str_len(want) {
        return false;
    }
    let i: u32 = 0;
    while i < n {
        if load8(o, i) != str_byte(want, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn test_mmap_map() -> bool {
    let o: ptr = alloc(64);
    let n: u32 = mm_map_text(34, o, 64);
    let want: str = "MAP_PRIVATE|MAP_ANONYMOUS";
    return n == str_len(want) && load8(o, 0) == 77
        && mm_anon_rw_mask() == 34 && mm_lookup("MAP_FIXED") == (16 as i64);
}
